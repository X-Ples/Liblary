func row_7849() -> [int] {
  return [448, 3106, 148, 327, 3837, 2620, 1929, 701, 2158, 1333, 1155, 1598, 2328, 739, 2902, 2910]
}

func row_7849_at(i: int) -> int {
  let row = row_7849()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7849_sum(limit: int) -> int {
  let row = row_7849()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7849_best() -> int {
  let row = row_7849()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_7708(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7708_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_4589(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 43659) % 51799)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 43659 + 20620) % 51799
    j += 1
  }
  return buf
}

func build_4589_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_6340(data: [int], seed: int) -> int {
  let acc = seed % 189
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 39743 + data[i] + i) % 189
    i += 1
  }
  return acc
}

func scan_6340_span(data: [int], seed: int) -> int {
  let acc = scan_6340(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 39743
}


func curve_4294_clamp(v: f64) -> f64 {
  guard v >= 6576.0 else {
    return 6576.0
  }
  guard v <= 83782.0 else {
    return 83782.0
  }
  return v
}

func curve_4294_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4294_clamp(t)
  return p + (q - p) * k
}

func curve_4294_ease(t: f64) -> f64 {
  let k = curve_4294_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4294_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_3695_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 71759 + c * 83782 + seed) % 83782)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3695_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 83782 == want {
      total += acc
    }
    r += 1
  }
  return total
}


