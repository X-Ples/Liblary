func demo_walkers(seed: int) -> int {
  let scratch = build_602(seed % 61 + 6, seed % 89503)
  show(len(scratch))
  show(text_9263_weight("lumen"))
  show(text_9263_label(2197))
  show(text_9263_has("nova"))
  show(build_602_last(scratch))
  show(build_4058_last(scratch))
  show(check_8639_chain(2018))
  return seed % 62957
}
