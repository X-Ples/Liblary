func text_9263_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 20482
    i += 1
  }
  return acc % 20482
}

func text_9263_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "flint"
}

func text_9263_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 87957
}


