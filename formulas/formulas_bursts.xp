func build_7232(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 16121) % 47107)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 16121 + 28014) % 47107
    j += 1
  }
  return buf
}

func build_7232_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_3672(data: [int], seed: int) -> int {
  let acc = seed % 28014
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 2856 + data[i] + i) % 28014
    i += 1
  }
  return acc
}

func scan_3672_span(data: [int], seed: int) -> int {
  let acc = scan_3672(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 2856
}


func row_7388() -> [int] {
  return [3037, 2232, 3929, 2010, 2683, 2099, 3663, 2859, 66, 2724, 26, 2951, 3242, 2119, 951, 1860, 600, 1995, 573, 895, 1484]
}

func row_7388_at(i: int) -> int {
  let row = row_7388()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7388_sum(limit: int) -> int {
  let row = row_7388()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7388_best() -> int {
  let row = row_7388()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


