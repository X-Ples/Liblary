func check_854(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 59289 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 58094) % 24985
    i += 1
  }
  return Ok(acc)
}

func check_854_chain(n: int) -> int {
  let picked = check_854(n)?
  return picked % 24985
}


