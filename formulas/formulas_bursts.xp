func sweep_7347(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 28519
  for i in lo..hi {
    if i % 16121 == 0 {
      acc += i * 52347
    } else {
      acc -= i % 13069
    }
    if acc < 0 {
      acc += 20361
    }
    acc = acc % 20361
  }
  return acc
}


