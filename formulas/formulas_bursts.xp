func demo_bursts(seed: int) -> int {
  let scratch = build_7232(seed % 61 + 6, seed % 59289)
  show(len(scratch))
  show(build_7232_last(scratch))
  show(scan_3672(scratch, 742))
  show(scan_3672_span(scratch, 3245))
  show(row_7388_at(903))
  return seed % 47107
}
