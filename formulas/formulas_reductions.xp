func build_744(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 68589) % 29661)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 68589 + 89200) % 29661
    j += 1
  }
  return buf
}

func build_744_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_6044_clamp(v: f64) -> f64 {
  guard v >= 24276.0 else {
    return 24276.0
  }
  guard v <= 90045.0 else {
    return 90045.0
  }
  return v
}

func curve_6044_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6044_clamp(t)
  return p + (q - p) * k
}

func curve_6044_ease(t: f64) -> f64 {
  let k = curve_6044_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6044_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_4479() -> [int] {
  return [1194, 3236, 2846, 739, 2510, 2056, 1769, 3342, 1705, 847, 3824, 1378, 313, 3705, 1081, 2237, 1, 1483, 992, 1855]
}

func row_4479_at(i: int) -> int {
  let row = row_4479()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4479_sum(limit: int) -> int {
  let row = row_4479()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4479_best() -> int {
  let row = row_4479()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_966(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 29661 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 68589) % 15199
    i += 1
  }
  return Ok(acc)
}

func check_966_chain(n: int) -> int {
  let picked = check_966(n)?
  return picked % 15199
}


func sweep_5458(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 1883
  for i in lo..hi {
    if i % 1900 == 0 {
      acc += i * 14964
    } else {
      acc -= i % 19059
    }
    if acc < 0 {
      acc += 72484
    }
    acc = acc % 72484
  }
  return acc
}


func order_9562(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9562_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


