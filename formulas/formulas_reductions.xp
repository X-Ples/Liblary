    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 95955
    i += 1
  }
  return acc % 95955
}

func text_8304_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "mesa"
}

func text_8304_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 54837
}


