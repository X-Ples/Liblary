func text_5308_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 93944
    i += 1
  }
  return acc % 93944
}

func text_5308_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "kilo"
}

func text_5308_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 12040
}


func build_5309(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 25316) % 13008)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 25316 + 76627) % 13008
    j += 1
  }
  return buf
}

func build_5309_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_5891_clamp(v: f64) -> f64 {
  guard v >= 69349.0 else {
    return 69349.0
  }
  guard v <= 74955.0 else {
    return 74955.0
  }
  return v
}

func curve_5891_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5891_clamp(t)
  return p + (q - p) * k
}

func curve_5891_ease(t: f64) -> f64 {
  let k = curve_5891_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5891_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


