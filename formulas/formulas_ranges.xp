func check_7894(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 976 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 31762) % 976
    i += 1
  }
  return Ok(acc)
}

func check_7894_chain(n: int) -> int {
  let picked = check_7894(n)?
  return picked % 976
}


