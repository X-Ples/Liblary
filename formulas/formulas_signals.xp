func demo_signals(seed: int) -> int {
  let scratch = build_1804(seed % 61 + 6, seed % 97842)
  show(len(scratch))
  show(text_5052_weight("omega"))
  show(text_5052_label(2176))
  show(text_5052_has("bravo"))
