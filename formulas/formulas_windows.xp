func curve_1032_clamp(v: f64) -> f64 {
  guard v >= 6888.0 else {
    return 6888.0
  }
  guard v <= 38989.0 else {
    return 38989.0
  }
  return v
}

func curve_1032_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1032_clamp(t)
  return p + (q - p) * k
}

func curve_1032_ease(t: f64) -> f64 {
  let k = curve_1032_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1032_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_windows(seed: int) -> int {
  let scratch = build_5038(seed % 61 + 6, seed % 78454)
  show(len(scratch))
  show(build_5038_last(scratch))
  show(gate_6778(3079, 3206, 1400))
  show(gate_6778_score(3984, 320, 1988))
  return seed % 62503
}
