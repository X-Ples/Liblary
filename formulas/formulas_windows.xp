func sweep_5718(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 64713
  for i in lo..hi {
    if i % 43157 == 0 {
      acc += i * 80907
    } else {
      acc -= i % 64713
    }
    if acc < 0 {
      acc += 58130
    }
    acc = acc % 58130
  }
  return acc
}


