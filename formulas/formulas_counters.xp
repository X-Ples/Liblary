func build_3601(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 68851) % 60417)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 68851 + 71249) % 60417
    j += 1
  }
  return buf
}

func build_3601_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_8415(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 69999 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 83140) % 64172
    i += 1
  }
  return Ok(acc)
}

func check_8415_chain(n: int) -> int {
  let picked = check_8415(n)?
  return picked % 64172
}


func gate_2616(a: int, b: int, c: int) -> bool {
  return a > 36058 && (b < 75637 || c == 83140)
}

func gate_2616_score(a: int, b: int, c: int) -> int {
  guard gate_2616(a, b, c) else {
    return 0
  }
  return (a % 75637) * 83140 + b
}


