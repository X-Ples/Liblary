func demo_counters(seed: int) -> int {
  let scratch = build_3601(seed % 61 + 6, seed % 83140)
  show(len(scratch))
  show(build_3601_last(scratch))
  show(check_8415_chain(3754))
  show(gate_2616(2511, 3239, 1782))
  show(gate_2616_score(397, 278, 3187))
  return seed % 60417
}
