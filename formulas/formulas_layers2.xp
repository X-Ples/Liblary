func text_7804_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 12941
    i += 1
  }
  return acc % 12941
}

func text_7804_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "alpha"
}

func text_7804_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 7992
}


func sweep_646(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 96240
  for i in lo..hi {
    if i % 56226 == 0 {
      acc += i * 56226
    } else {
      acc -= i % 90729
    }
    if acc < 0 {
      acc += 70461
    }
    acc = acc % 70461
  }
  return acc
}


func build_9523(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 9541) % 71179)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 9541 + 54163) % 71179
    j += 1
  }
  return buf
}

func build_9523_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_8214(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8214_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


