func grid_1473_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 47535 + c * 71179 + seed) % 71179)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1473_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 71179 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_2923(a: int, b: int, c: int) -> bool {
  return a > 70461 && (b < 3842 || c == 7992)
}

func gate_2923_score(a: int, b: int, c: int) -> int {
  guard gate_2923(a, b, c) else {
    return 0
  }
  return (a % 3842) * 7992 + b
}


