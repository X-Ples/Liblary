func demo_kernels(seed: int) -> int {
  let scratch = build_721(seed % 61 + 6, seed % 88038)
  show(len(scratch))
  show(build_721_last(scratch))
  show(build_9335_last(scratch))
  show(text_8440_weight("nova"))
  show(text_8440_label(129))
  return seed % 19466
}
