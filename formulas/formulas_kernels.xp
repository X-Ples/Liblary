func sweep_326(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 89451
  for i in lo..hi {
    if i % 19466 == 0 {
      acc += i * 92687
    } else {
      acc -= i % 30360
    }
    if acc < 0 {
      acc += 26757
    }
    acc = acc % 26757
  }
  return acc
}


