func row_5526() -> [int] {
  return [1159, 3915, 3858, 1805, 837, 1141, 765, 3535, 3750, 3602, 414, 2988, 3137, 3685]
}

func row_5526_at(i: int) -> int {
  let row = row_5526()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5526_sum(limit: int) -> int {
  let row = row_5526()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5526_best() -> int {
  let row = row_5526()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_6616_clamp(v: f64) -> f64 {
  guard v >= 1546.0 else {
    return 1546.0
  }
  guard v <= 86281.0 else {
    return 86281.0
  }
  return v
}

func curve_6616_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6616_clamp(t)
  return p + (q - p) * k
}

func curve_6616_ease(t: f64) -> f64 {
  let k = curve_6616_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6616_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


