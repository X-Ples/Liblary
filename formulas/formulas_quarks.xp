func demo_quarks(seed: int) -> int {
  let scratch = build_5159(seed % 61 + 6, seed % 15372)
  show(len(scratch))
  show(build_5159_last(scratch))
  show(text_1491_weight("talus"))
  show(text_1491_label(3785))
  show(text_1491_has("mesa"))
  show(check_9556_chain(2089))
  return seed % 87504
}
