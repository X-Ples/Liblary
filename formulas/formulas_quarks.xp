func build_5159(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 98853) % 53811)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 98853 + 91088) % 53811
    j += 1
  }
  return buf
}

func build_5159_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_1491_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 27049
    i += 1
  }
  return acc % 27049
}

func text_1491_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "lumen"
}

func text_1491_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 16542
}


func check_9556(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 63985 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 22459) % 83609
    i += 1
  }
  return Ok(acc)
}

func check_9556_chain(n: int) -> int {
  let picked = check_9556(n)?
  return picked % 83609
}


func gate_7485(a: int, b: int, c: int) -> bool {
  return a > 643 && (b < 31937 || c == 77250)
}

func gate_7485_score(a: int, b: int, c: int) -> int {
  guard gate_7485(a, b, c) else {
    return 0
  }
  return (a % 31937) * 77250 + b
}


func sweep_556(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 78406
  for i in lo..hi {
    if i % 87504 == 0 {
      acc += i * 22459
    } else {
      acc -= i % 44435
    }
    if acc < 0 {
      acc += 44435
    }
    acc = acc % 44435
  }
  return acc
}


