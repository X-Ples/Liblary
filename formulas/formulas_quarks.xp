func grid_2102_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 91088 + c * 91088 + seed) % 91088)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2102_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 91088 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func row_515() -> [int] {
  return [3128, 3352, 440, 2208, 3463, 940, 614, 102, 3468, 3400, 1423]
}

func row_515_at(i: int) -> int {
  let row = row_515()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_515_sum(limit: int) -> int {
  let row = row_515()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_515_best() -> int {
  let row = row_515()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_2184_clamp(v: f64) -> f64 {
  guard v >= 22459.0 else {
    return 22459.0
  }
  guard v <= 27596.0 else {
    return 27596.0
  }
  return v
}

func curve_2184_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2184_clamp(t)
  return p + (q - p) * k
}

func curve_2184_ease(t: f64) -> f64 {
  let k = curve_2184_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2184_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


