func row_8866() -> [int] {
  return [735, 2784, 2908, 1507, 3225, 4009, 3869, 1875, 2008, 940, 2042, 174, 612, 597, 1140, 2869]
}

func row_8866_at(i: int) -> int {
  let row = row_8866()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8866_sum(limit: int) -> int {
  let row = row_8866()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8866_best() -> int {
  let row = row_8866()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_283(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 23976) % 19100)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 23976 + 78148) % 19100
    j += 1
  }
  return buf
}

func build_283_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


