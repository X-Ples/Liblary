func sweep_8778(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 29064
  for i in lo..hi {
    if i % 89199 == 0 {
      acc += i * 23976
    } else {
      acc -= i % 19100
    }
    if acc < 0 {
      acc += 19100
    }
    acc = acc % 19100
  }
  return acc
}


func grid_8128_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 20420 + c * 94394 + seed) % 94394)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8128_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
