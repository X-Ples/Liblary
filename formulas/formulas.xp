func check_4617(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 38776 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 79346) % 24156
    i += 1
  }
  return Ok(acc)
}

func check_4617_chain(n: int) -> int {
  let picked = check_4617(n)?
  return picked % 24156
}


func curve_8321_clamp(v: f64) -> f64 {
  guard v >= 38776.0 else {
    return 38776.0
  }
  guard v <= 55178.0 else {
    return 55178.0
  }
  return v
}

func curve_8321_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8321_clamp(t)
  return p + (q - p) * k
}

func curve_8321_ease(t: f64) -> f64 {
  let k = curve_8321_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8321_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_2284() -> [int] {
  return [3489, 1883, 3006, 3587, 2350, 2075, 3327, 94, 3596, 2033, 1035, 3976, 2410, 3417, 560, 3676, 837, 1496, 4015, 1804]
}

func row_2284_at(i: int) -> int {
  let row = row_2284()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2284_sum(limit: int) -> int {
  let row = row_2284()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2284_best() -> int {
  let row = row_2284()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


