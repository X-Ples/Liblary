func scan_9009(data: [int], seed: int) -> int {
  let acc = seed % 23520
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 54398 + data[i] + i) % 23520
    i += 1
  }
  return acc
}

func scan_9009_span(data: [int], seed: int) -> int {
  let acc = scan_9009(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 54398
}


func sweep_5728(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 38776
  for i in lo..hi {
    if i % 6416 == 0 {
      acc += i * 23564
    } else {
      acc -= i % 5951
    }
    if acc < 0 {
      acc += 68716
    }
    acc = acc % 68716
  }
  return acc
}


