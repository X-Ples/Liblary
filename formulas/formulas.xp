func build_6498(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 68716) % 38776)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 68716 + 78828) % 38776
    j += 1
  }
  return buf
}

func build_6498_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_1910_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 76836 + c * 23564 + seed) % 23564)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1910_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 23564 == want {
      total += acc
    }
    r += 1
  }
  return total
}


