func demo_blocks(seed: int) -> int {
  let scratch = build_5269(seed % 61 + 6, seed % 99956)
  show(len(scratch))
  show(build_5269_last(scratch))
  show(text_1240_weight("kilo"))
  show(text_1240_label(2211))
  show(text_1240_has("harbor"))
