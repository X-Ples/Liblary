func build_5269(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 37081) % 26365)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 37081 + 43591) % 26365
    j += 1
  }
  return buf
}

func build_5269_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_1240_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 11126
    i += 1
  }
  return acc % 11126
}

func text_1240_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "flint"
}

func text_1240_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 16193
}


func sweep_4414(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 6398
  for i in lo..hi {
    if i % 29562 == 0 {
      acc += i * 82321
    } else {
      acc -= i % 86458
    }
    if acc < 0 {
      acc += 43591
    }
    acc = acc % 43591
  }
  return acc
}


func order_3256(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3256_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


