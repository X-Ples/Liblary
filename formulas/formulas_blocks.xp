func check_6062(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 99956 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 16193) % 96913
    i += 1
  }
  return Ok(acc)
}

func check_6062_chain(n: int) -> int {
  let picked = check_6062(n)?
  return picked % 96913
}


