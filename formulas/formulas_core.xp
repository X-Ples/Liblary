func sweep_6392(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 17154
  for i in lo..hi {
    if i % 69454 == 0 {
      acc += i * 4127
    } else {
      acc -= i % 5879
    }
    if acc < 0 {
      acc += 50555
    }
    acc = acc % 50555
  }
  return acc
}


func grid_6535_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 29335 + c * 72926 + seed) % 72926)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6535_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 72926 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_2048(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 5879 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 16366) % 39155
    i += 1
  }
  return Ok(acc)
}

func check_2048_chain(n: int) -> int {
  let picked = check_2048(n)?
  return picked % 39155
}


