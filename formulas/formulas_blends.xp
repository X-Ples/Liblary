func text_6509_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 17522
    i += 1
  }
  return acc % 17522
}

func text_6509_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "ridge"
}

func text_6509_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 51192
}


