func sweep_8890(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 16524
  for i in lo..hi {
    if i % 39384 == 0 {
      acc += i * 48504
    } else {
      acc -= i % 39384
    }
    if acc < 0 {
      acc += 48504
    }
    acc = acc % 48504
  }
  return acc
}


