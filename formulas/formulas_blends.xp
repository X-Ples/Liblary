func demo_blends(seed: int) -> int {
  let scratch = build_540(seed % 61 + 6, seed % 91435)
  show(len(scratch))
  show(build_540_last(scratch))
  show(order_6912_find(scratch, 3930))
  show(row_8333_at(2274))
  show(row_8333_sum(2841))
  show(row_8333_best())
  return seed % 14738
}
