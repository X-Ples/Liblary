func check_1293(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 39384 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 56156) % 49919
    i += 1
  }
  return Ok(acc)
}

func check_1293_chain(n: int) -> int {
  let picked = check_1293(n)?
  return picked % 49919
}


