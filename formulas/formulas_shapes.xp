const K0 = 67216
const K1 = 41539
const K2 = 1545
const K3 = 18042
const K4 = 51549
const K5 = 12632
const K6 = 59017
const K7 = 20087

func order_648(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_648_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_4115(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 18992) % 31008)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 18992 + 85843) % 31008
    j += 1
  }
  return buf
}

func build_4115_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_7478(a: int, b: int, c: int) -> bool {
  return a > 15890 && (b < 37875 || c == 38230)
}

func gate_7478_score(a: int, b: int, c: int) -> int {
  guard gate_7478(a, b, c) else {
    return 0
  }
  return (a % 37875) * 38230 + b
}


func curve_3687_clamp(v: f64) -> f64 {
  guard v >= 37052.0 else {
    return 37052.0
  }
  guard v <= 41539.0 else {
    return 41539.0
  }
  return v
}

func curve_3687_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3687_clamp(t)
  return p + (q - p) * k
}

func curve_3687_ease(t: f64) -> f64 {
  let k = curve_3687_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3687_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_1482_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 59017
    i += 1
  }
  return acc % 59017
}

func text_1482_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "flint"
}

func text_1482_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 20087
}


func check_6645(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 15890 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 18042) % 1545
    i += 1
  }
  return Ok(acc)
}

func check_6645_chain(n: int) -> int {
  let picked = check_6645(n)?
  return picked % 1545
}


func row_1832() -> [int] {
  return [2652, 251, 1308, 4068, 655, 2189, 1539, 3246, 2484, 1657, 698, 2289, 2712, 35]
}

func row_1832_at(i: int) -> int {
  let row = row_1832()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1832_sum(limit: int) -> int {
  let row = row_1832()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1832_best() -> int {
  let row = row_1832()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_7090(data: [int], seed: int) -> int {
  let acc = seed % 38230
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 67570 + data[i] + i) % 38230
    i += 1
  }
  return acc
}

func scan_7090_span(data: [int], seed: int) -> int {
  let acc = scan_7090(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 67570
}


