func check_5475(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 97237 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 35589) % 41265
    i += 1
  }
  return Ok(acc)
}

func check_5475_chain(n: int) -> int {
  let picked = check_5475(n)?
  return picked % 41265
}


func row_6272() -> [int] {
  return [2202, 2260, 1882, 802, 1491, 1782, 86, 3080, 1734, 1667, 340, 2694, 4075]
}

func row_6272_at(i: int) -> int {
  let row = row_6272()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6272_sum(limit: int) -> int {
  let row = row_6272()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6272_best() -> int {
  let row = row_6272()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_3480(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 49046) % 67003)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 49046 + 67003) % 67003
    j += 1
  }
  return buf
}

func build_3480_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_1169(a: int, b: int, c: int) -> bool {
  return a > 1916 && (b < 33628 || c == 45374)
}

func gate_1169_score(a: int, b: int, c: int) -> int {
  guard gate_1169(a, b, c) else {
    return 0
  }
  return (a % 33628) * 45374 + b
}


func grid_1379_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 33628 + c * 74016 + seed) % 74016)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1379_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 74016 == want {
      total += acc
    }
    r += 1
  }
  return total
}


