func build_206(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 11688) % 82467)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 11688 + 22858) % 82467
    j += 1
  }
  return buf
}

func build_206_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_1894(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 42594
  for i in lo..hi {
    if i % 22858 == 0 {
      acc += i * 77184
    } else {
      acc -= i % 50796
    }
    if acc < 0 {
      acc += 44549
    }
    acc = acc % 44549
  }
  return acc
}


func curve_551_clamp(v: f64) -> f64 {
  guard v >= 12552.0 else {
    return 12552.0
  }
  guard v <= 36675.0 else {
    return 36675.0
  }
  return v
}

func curve_551_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_551_clamp(t)
  return p + (q - p) * k
}

func curve_551_ease(t: f64) -> f64 {
  let k = curve_551_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_551_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


