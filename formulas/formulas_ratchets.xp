func sweep_3688(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 49135
  for i in lo..hi {
    if i % 61124 == 0 {
      acc += i * 99730
    } else {
      acc -= i % 14592
    }
    if acc < 0 {
      acc += 14592
    }
    acc = acc % 14592
  }
  return acc
}


func build_9424(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 15608) % 99730)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 15608 + 31278) % 99730
    j += 1
  }
  return buf
}

func build_9424_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_3253_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 84705 + c * 25486 + seed) % 25486)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3253_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 25486 == want {
      total += acc
    }
    r += 1
  }
  return total
}


