func check_2548(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 98635 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 64206) % 6294
    i += 1
  }
  return Ok(acc)
}

func check_2548_chain(n: int) -> int {
  let picked = check_2548(n)?
  return picked % 6294
}


