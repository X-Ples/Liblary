func scan_3972(data: [int], seed: int) -> int {
  let acc = seed % 89275
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 6041 + data[i] + i) % 89275
    i += 1
  }
  return acc
}

func scan_3972_span(data: [int], seed: int) -> int {
  let acc = scan_3972(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 6041
}


