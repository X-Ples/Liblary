func demo_ops(seed: int) -> int {
  let scratch = build_3810(seed % 61 + 6, seed % 14002)
  show(len(scratch))
  show(build_3810_last(scratch))
  show(gate_953(3879, 3944, 362))
  show(gate_953_score(1745, 3460, 73))
  show(sweep_942(199, 2976))
  show(row_2594_at(94))
  return seed % 31709
}
