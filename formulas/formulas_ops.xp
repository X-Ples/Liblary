func build_3810(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 89275) % 6041)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 89275 + 32721) % 6041
    j += 1
  }
  return buf
}

func build_3810_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_953(a: int, b: int, c: int) -> bool {
  return a > 88070 && (b < 13969 || c == 13969)
}

func gate_953_score(a: int, b: int, c: int) -> int {
  guard gate_953(a, b, c) else {
    return 0
  }
  return (a % 13969) * 13969 + b
}


func sweep_942(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 13969
  for i in lo..hi {
    if i % 14855 == 0 {
      acc += i * 14855
    } else {
      acc -= i % 31709
    }
    if acc < 0 {
      acc += 8036
    }
    acc = acc % 8036
  }
  return acc
}


