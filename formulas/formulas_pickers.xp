func sweep_5796(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 97383
  for i in lo..hi {
    if i % 19322 == 0 {
      acc += i * 66375
    } else {
      acc -= i % 71287
    }
    if acc < 0 {
      acc += 79055
    }
    acc = acc % 79055
  }
  return acc
}


func demo_pickers(seed: int) -> int {
  let scratch = build_3745(seed % 61 + 6, seed % 98492)
  show(len(scratch))
  show(build_3745_last(scratch))
  show(order_7081_find(scratch, 1056))
  show(build_7138_last(scratch))
  show(row_5270_at(3089))
  show(row_5270_sum(2598))
  show(row_5270_best())
  return seed % 50129
}
