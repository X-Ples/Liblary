func check_5956(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 19322 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 2038) % 97383
    i += 1
  }
  return Ok(acc)
}

func check_5956_chain(n: int) -> int {
  let picked = check_5956(n)?
  return picked % 97383
}


func gate_3876(a: int, b: int, c: int) -> bool {
  return a > 9821 && (b < 5278 || c == 43771)
