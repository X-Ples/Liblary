func demo_bursts(seed: int) -> int {
  let scratch = build_2559(seed % 61 + 6, seed % 26702)
  show(len(scratch))
  show(grid_7551_rowsum(scratch, 1099, 1507, 1679))
  show(build_2559_last(scratch))
  show(check_5499_chain(544))
  show(grid_7902_rowsum(scratch, 147, 2077, 2458))
  show(gate_4832(1869, 2718, 2774))
  show(gate_4832_score(455, 989, 1929))
  return seed % 97739
}
