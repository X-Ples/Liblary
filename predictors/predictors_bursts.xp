func row_2294() -> [int] {
  return [3198, 429, 938, 2230, 2237, 2632, 2469, 1850, 2275, 1256, 607, 2584, 643, 1346]
}

func row_2294_at(i: int) -> int {
  let row = row_2294()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2294_sum(limit: int) -> int {
  let row = row_2294()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2294_best() -> int {
  let row = row_2294()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


