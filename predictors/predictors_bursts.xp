func text_6864_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "alpha"
}

func text_6864_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 9273
}


