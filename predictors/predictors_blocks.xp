func gate_3556(a: int, b: int, c: int) -> bool {
  return a > 14854 && (b < 67464 || c == 30966)
}

func gate_3556_score(a: int, b: int, c: int) -> int {
  guard gate_3556(a, b, c) else {
    return 0
  }
  return (a % 67464) * 30966 + b
}


func order_6990(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6990_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_8821_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 93742
    i += 1
  }
  return acc % 93742
}

func text_8821_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "flint"
}

func text_8821_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 21106
}


