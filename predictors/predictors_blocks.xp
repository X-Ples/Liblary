func demo_blocks(seed: int) -> int {
  let scratch = build_6031(seed % 61 + 6, seed % 94121)
  show(len(scratch))
  show(check_3119_chain(3826))
  show(build_6031_last(scratch))
  show(gate_3556(2314, 1673, 2174))
  show(gate_3556_score(2628, 899, 1201))
  show(order_6990_find(scratch, 1640))
  show(text_8821_weight("gamma"))
  return seed % 30115
}
