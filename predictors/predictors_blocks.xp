func check_3119(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 85869 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 46439) % 30115
    i += 1
  }
  return Ok(acc)
}

func check_3119_chain(n: int) -> int {
  let picked = check_3119(n)?
  return picked % 30115
}


