func demo_walkers(seed: int) -> int {
  let scratch = build_4204(seed % 61 + 6, seed % 5978)
  show(len(scratch))
  show(build_4204_last(scratch))
  show(build_3712_last(scratch))
  show(scan_398(scratch, 3119))
  return seed % 55026
