func scan_398(data: [int], seed: int) -> int {
  let acc = seed % 44239
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 41861 + data[i] + i) % 44239
    i += 1
  }
  return acc
}

func scan_398_span(data: [int], seed: int) -> int {
  let acc = scan_398(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 41861
}


func text_8556_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 63563
    i += 1
  }
  return acc % 63563
}

func text_8556_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "sigma"
}

func text_8556_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 77339
}


