func demo_ranges(seed: int) -> int {
  let scratch = build_6980(seed % 61 + 6, seed % 30326)
  show(len(scratch))
  show(build_6980_last(scratch))
  show(text_118_weight("lumen"))
  show(text_118_label(3049))
  show(text_118_has("ion"))
  show(grid_4233_rowsum(scratch, 3823, 3691, 1661))
  show(gate_4564(3121, 2576, 3459))
  return seed % 30326
}
