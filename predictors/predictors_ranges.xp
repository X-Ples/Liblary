func build_6980(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 51671) % 15232)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 51671 + 2505) % 15232
    j += 1
  }
  return buf
}

func build_6980_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_118_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 7648
    i += 1
  }
  return acc % 7648
}

func text_118_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "nova"
}

func text_118_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 7648
}


func curve_8754_clamp(v: f64) -> f64 {
  guard v >= 10945.0 else {
    return 10945.0
  }
  guard v <= 51671.0 else {
    return 51671.0
  }
  return v
}

func curve_8754_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8754_clamp(t)
  return p + (q - p) * k
}

func curve_8754_ease(t: f64) -> f64 {
  let k = curve_8754_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8754_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_4233_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 72234 + c * 19010 + seed) % 19010)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4233_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 19010 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_4564(a: int, b: int, c: int) -> bool {
  return a > 30326 && (b < 19010 || c == 7648)
}

func gate_4564_score(a: int, b: int, c: int) -> int {
  guard gate_4564(a, b, c) else {
    return 0
  }
  return (a % 19010) * 7648 + b
}


func order_7048(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7048_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


