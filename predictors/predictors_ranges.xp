func check_8258(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 99797 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 15232) % 95350
    i += 1
  }
  return Ok(acc)
}

func check_8258_chain(n: int) -> int {
  let picked = check_8258(n)?
  return picked % 95350
}


