func sweep_7376(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 28447
  for i in lo..hi {
    if i % 91786 == 0 {
      acc += i * 59530
    } else {
      acc -= i % 28447
    }
    if acc < 0 {
      acc += 90094
    }
    acc = acc % 90094
  }
  return acc
}


