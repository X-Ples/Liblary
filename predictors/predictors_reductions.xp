func check_6017(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 95047 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 80695) % 39368
    i += 1
  }
  return Ok(acc)
}

func check_6017_chain(n: int) -> int {
  let picked = check_6017(n)?
  return picked % 39368
}


