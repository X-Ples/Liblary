func text_4614_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 55055
    i += 1
  }
  return acc % 55055
}

func text_4614_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "harbor"
}

func text_4614_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 53491
}


func build_3817(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 53491) % 86918)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 53491 + 94011) % 86918
    j += 1
  }
  return buf
}

func build_3817_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_4125(data: [int], seed: int) -> int {
  let acc = seed % 53491
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 90094 + data[i] + i) % 53491
    i += 1
  }
  return acc
}

func scan_4125_span(data: [int], seed: int) -> int {
  let acc = scan_4125(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 90094
}


func curve_8769_clamp(v: f64) -> f64 {
  guard v >= 1408.0 else {
    return 1408.0
  }
  guard v <= 98863.0 else {
    return 98863.0
  }
  return v
}

func curve_8769_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8769_clamp(t)
  return p + (q - p) * k
}

func curve_8769_ease(t: f64) -> f64 {
  let k = curve_8769_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8769_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


