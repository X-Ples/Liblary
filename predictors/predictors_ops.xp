func demo_ops(seed: int) -> int {
  let scratch = build_6119(seed % 61 + 6, seed % 99782)
  show(len(scratch))
  show(sweep_5021(197, 479))
  show(check_5046_chain(2183))
  show(build_6119_last(scratch))
