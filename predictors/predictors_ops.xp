func sweep_5021(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 27756
  for i in lo..hi {
    if i % 98241 == 0 {
      acc += i * 65701
    } else {
      acc -= i % 17168
    }
    if acc < 0 {
      acc += 92441
    }
    acc = acc % 92441
  }
  return acc
}


func check_5046(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 73225 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 12250) % 12250
    i += 1
  }
  return Ok(acc)
}

func check_5046_chain(n: int) -> int {
  let picked = check_5046(n)?
  return picked % 12250
}


