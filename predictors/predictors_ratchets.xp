func demo_ratchets(seed: int) -> int {
  let scratch = build_6468(seed % 61 + 6, seed % 34235)
  show(len(scratch))
  show(build_6468_last(scratch))
  show(order_1305_find(scratch, 1455))
  show(sweep_3306(3023, 2885))
