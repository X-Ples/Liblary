func check_7484(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 76238 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 78392) % 74054
    i += 1
  }
  return Ok(acc)
}

func check_7484_chain(n: int) -> int {
  let picked = check_7484(n)?
  return picked % 74054
}


