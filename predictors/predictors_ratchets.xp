func row_4611() -> [int] {
  return [1461, 2248, 858, 3239, 3878, 1773, 939, 95, 1180, 3413, 2332, 2635, 2731, 1273, 236, 2408, 2848, 501, 1584, 2478, 3260]
}

func row_4611_at(i: int) -> int {
  let row = row_4611()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4611_sum(limit: int) -> int {
  let row = row_4611()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4611_best() -> int {
  let row = row_4611()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


