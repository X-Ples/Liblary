func demo_helpers(seed: int) -> int {
  let scratch = build_2715(seed % 61 + 6, seed % 33422)
  show(len(scratch))
  show(build_2715_last(scratch))
  show(text_6636_weight("kilo"))
  show(text_6636_label(1942))
  show(text_6636_has("ember"))
