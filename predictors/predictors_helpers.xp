func curve_7494_clamp(v: f64) -> f64 {
  guard v >= 33422.0 else {
    return 33422.0
  }
  guard v <= 57266.0 else {
    return 57266.0
  }
  return v
}

func curve_7494_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7494_clamp(t)
  return p + (q - p) * k
}

func curve_7494_ease(t: f64) -> f64 {
  let k = curve_7494_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7494_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_2715(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 35565) % 42555)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 35565 + 70804) % 42555
    j += 1
  }
  return buf
}

func build_2715_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_6636_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 31352
    i += 1
  }
  return acc % 31352
}

func text_6636_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "kilo"
}

func text_6636_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 20603
}


func sweep_487(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 11511
  for i in lo..hi {
    if i % 33422 == 0 {
      acc += i * 63304
    } else {
      acc -= i % 35565
    }
    if acc < 0 {
      acc += 2172
    }
    acc = acc % 2172
  }
  return acc
}


func check_9457(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 11511 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 70804) % 42555
    i += 1
  }
  return Ok(acc)
}

func check_9457_chain(n: int) -> int {
  let picked = check_9457(n)?
  return picked % 42555
}


func row_3092() -> [int] {
  return [3491, 1453, 1704, 275, 2541, 3865, 200, 244, 3951, 1193, 961, 3426, 1087, 738, 516]
}

func row_3092_at(i: int) -> int {
  let row = row_3092()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3092_sum(limit: int) -> int {
  let row = row_3092()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3092_best() -> int {
  let row = row_3092()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_2020(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2020_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


