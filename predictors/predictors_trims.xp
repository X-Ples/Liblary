func demo_trims(seed: int) -> int {
  let scratch = build_5275(seed % 61 + 6, seed % 49215)
  show(len(scratch))
  show(scan_2801(scratch, 1818))
  show(scan_2801_span(scratch, 470))
  show(order_6746_find(scratch, 106))
  show(scan_714(scratch, 3050))
  show(scan_714_span(scratch, 3376))
  return seed % 76908
}
