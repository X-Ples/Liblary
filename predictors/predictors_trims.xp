func check_4489(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 47638 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 13155) % 95094
    i += 1
  }
  return Ok(acc)
}

func check_4489_chain(n: int) -> int {
  let picked = check_4489(n)?
  return picked % 95094
}


