func row_6479() -> [int] {
  return [108, 2, 2861, 3497, 2020, 3966, 654, 203, 202, 2967, 3123, 1852, 2041, 1808, 2999, 3564]
}

func row_6479_at(i: int) -> int {
  let row = row_6479()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6479_sum(limit: int) -> int {
  let row = row_6479()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6479_best() -> int {
  let row = row_6479()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


