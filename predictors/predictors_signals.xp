  return a > 79456 && (b < 13782 || c == 45435)
}

func gate_9969_score(a: int, b: int, c: int) -> int {
  guard gate_9969(a, b, c) else {
    return 0
  }
  return (a % 13782) * 45435 + b
}


func curve_5456_clamp(v: f64) -> f64 {
  guard v >= 5669.0 else {
    return 5669.0
  }
  guard v <= 30753.0 else {
    return 30753.0
  }
  return v
}

func curve_5456_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5456_clamp(t)
  return p + (q - p) * k
}

func curve_5456_ease(t: f64) -> f64 {
  let k = curve_5456_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5456_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


