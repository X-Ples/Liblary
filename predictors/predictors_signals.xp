func build_4885(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 98785) % 30753)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 98785 + 79456) % 30753
    j += 1
  }
  return buf
}

func build_4885_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_6304(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 38959
  for i in lo..hi {
    if i % 4661 == 0 {
      acc += i * 45435
    } else {
      acc -= i % 33182
    }
    if acc < 0 {
      acc += 66758
    }
    acc = acc % 66758
  }
  return acc
}


