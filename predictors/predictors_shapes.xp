func demo_shapes(seed: int) -> int {
  let scratch = build_8509(seed % 61 + 6, seed % 29159)
  show(len(scratch))
  show(build_8509_last(scratch))
  show(text_6584_weight("harbor"))
  show(text_6584_label(1815))
  show(text_6584_has("quartz"))
  show(order_2190_find(scratch, 3169))
  return seed % 64308
}
