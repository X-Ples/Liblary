func build_7724(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 95547) % 92470)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 95547 + 92470) % 92470
    j += 1
  }
  return buf
}

func build_7724_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_8374_clamp(v: f64) -> f64 {
  guard v >= 75637.0 else {
    return 75637.0
  }
  guard v <= 92470.0 else {
    return 92470.0
  }
  return v
}

func curve_8374_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8374_clamp(t)
  return p + (q - p) * k
}

func curve_8374_ease(t: f64) -> f64 {
  let k = curve_8374_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8374_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_2020(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 75637
  for i in lo..hi {
    if i % 47808 == 0 {
      acc += i * 10933
    } else {
      acc -= i % 78850
    }
    if acc < 0 {
      acc += 29501
    }
    acc = acc % 29501
  }
  return acc
}


func text_5994_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 26204
    i += 1
  }
  return acc % 26204
}

func text_5994_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "cargo"
}

func text_5994_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 59706
}


