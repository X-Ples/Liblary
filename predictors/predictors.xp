func text_3115_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 20050
    i += 1
  }
  return acc % 20050
}

func text_3115_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "harbor"
}

func text_3115_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 38153
}


