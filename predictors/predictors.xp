func curve_6102_clamp(v: f64) -> f64 {
  guard v >= 38153.0 else {
    return 38153.0
  }
  guard v <= 96554.0 else {
    return 96554.0
  }
  return v
}

func curve_6102_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6102_clamp(t)
  return p + (q - p) * k
}

func curve_6102_ease(t: f64) -> f64 {
  let k = curve_6102_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6102_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_3877(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 5994) % 46218)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 5994 + 38153) % 46218
    j += 1
  }
  return buf
}

func build_3877_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_7427(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 2436 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 77) % 4586
    i += 1
  }
  return Ok(acc)
}

func check_7427_chain(n: int) -> int {
  let picked = check_7427(n)?
  return picked % 4586
}


