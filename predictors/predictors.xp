func sweep_3483(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 75997
  for i in lo..hi {
    if i % 81949 == 0 {
      acc += i * 87335
    } else {
      acc -= i % 33827
    }
    if acc < 0 {
      acc += 18165
    }
    acc = acc % 18165
  }
  return acc
}


