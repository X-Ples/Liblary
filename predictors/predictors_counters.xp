func curve_3900_clamp(v: f64) -> f64 {
  guard v >= 15567.0 else {
    return 15567.0
  }
  guard v <= 19486.0 else {
    return 19486.0
  }
  return v
}

func curve_3900_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3900_clamp(t)
  return p + (q - p) * k
}

func curve_3900_ease(t: f64) -> f64 {
  let k = curve_3900_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3900_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_8915(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 42595) % 36782)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 42595 + 69770) % 36782
    j += 1
  }
  return buf
}

func build_8915_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_2249(a: int, b: int, c: int) -> bool {
  return a > 53092 && (b < 13045 || c == 29191)
}

func gate_2249_score(a: int, b: int, c: int) -> int {
  guard gate_2249(a, b, c) else {
    return 0
  }
  return (a % 13045) * 29191 + b
}


func check_1632(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 4290 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 51090) % 48046
    i += 1
  }
  return Ok(acc)
}

func check_1632_chain(n: int) -> int {
  let picked = check_1632(n)?
  return picked % 48046
}


func text_5756_weight(tag: str) -> int {
