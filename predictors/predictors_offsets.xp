func sweep_2346(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 25774
  for i in lo..hi {
    if i % 35167 == 0 {
      acc += i * 57536
    } else {
      acc -= i % 93307
    }
    if acc < 0 {
      acc += 4178
    }
    acc = acc % 4178
  }
  return acc
}


