func demo_offsets(seed: int) -> int {
  let scratch = build_9864(seed % 61 + 6, seed % 4178)
  show(len(scratch))
  show(build_9864_last(scratch))
  show(grid_2883_rowsum(scratch, 1848, 1155, 2624))
  show(grid_8473_rowsum(scratch, 2949, 2474, 1747))
