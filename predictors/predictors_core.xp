func build_7193(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 14357) % 44990)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 14357 + 49502) % 44990
    j += 1
  }
  return buf
}

func build_7193_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_7039(data: [int], seed: int) -> int {
  let acc = seed % 57907
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 39459 + data[i] + i) % 57907
    i += 1
  }
  return acc
}

func scan_7039_span(data: [int], seed: int) -> int {
  let acc = scan_7039(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 39459
}


func order_8734(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8734_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func row_7234() -> [int] {
  return [3252, 2207, 2724, 877, 174, 3382, 1583, 2580, 132, 455, 104, 2746]
}

func row_7234_at(i: int) -> int {
  let row = row_7234()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7234_sum(limit: int) -> int {
  let row = row_7234()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7234_best() -> int {
  let row = row_7234()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_2319(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 57064
  for i in lo..hi {
    if i % 49502 == 0 {
      acc += i * 39459
    } else {
      acc -= i % 49502
    }
    if acc < 0 {
      acc += 57907
    }
    acc = acc % 57907
  }
  return acc
}


func check_1712(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 57907 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 37176) % 79915
    i += 1
  }
  return Ok(acc)
}

func check_1712_chain(n: int) -> int {
  let picked = check_1712(n)?
  return picked % 79915
}


func curve_7407_clamp(v: f64) -> f64 {
  guard v >= 822.0 else {
    return 822.0
  }
  guard v <= 7127.0 else {
    return 7127.0
  }
  return v
}

func curve_7407_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7407_clamp(t)
  return p + (q - p) * k
}

func curve_7407_ease(t: f64) -> f64 {
  let k = curve_7407_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7407_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_4673(a: int, b: int, c: int) -> bool {
  return a > 822 && (b < 84904 || c == 39459)
}

func gate_4673_score(a: int, b: int, c: int) -> int {
  guard gate_4673(a, b, c) else {
    return 0
  }
  return (a % 84904) * 39459 + b
}


