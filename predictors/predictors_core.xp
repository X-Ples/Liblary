func demo_core(seed: int) -> int {
  let scratch = build_7193(seed % 61 + 6, seed % 7127)
  show(len(scratch))
  show(build_7193_last(scratch))
  show(scan_7039(scratch, 1807))
  show(scan_7039_span(scratch, 1317))
  show(order_8734_find(scratch, 2065))
  return seed % 31968
}
