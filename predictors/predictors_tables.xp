func scan_8629(data: [int], seed: int) -> int {
  let acc = seed % 52838
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 78865 + data[i] + i) % 52838
    i += 1
  }
  return acc
}

func scan_8629_span(data: [int], seed: int) -> int {
  let acc = scan_8629(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 78865
}


