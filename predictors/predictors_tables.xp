func gate_6026(a: int, b: int, c: int) -> bool {
  return a > 58188 && (b < 3897 || c == 28420)
}

func gate_6026_score(a: int, b: int, c: int) -> int {
  guard gate_6026(a, b, c) else {
    return 0
  }
  return (a % 3897) * 28420 + b
}


func check_648(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 61783 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 40038) % 87165
    i += 1
  }
  return Ok(acc)
}

func check_648_chain(n: int) -> int {
  let picked = check_648(n)?
  return picked % 87165
}


