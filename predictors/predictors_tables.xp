func build_8664(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 31600) % 52838)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 31600 + 13044) % 52838
    j += 1
  }
  return buf
}

func build_8664_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_7755() -> [int] {
  return [3524, 78, 2402, 3963, 3522, 3503, 3769, 2901, 1943, 3710, 3051, 1706, 1135, 17]
}

func row_7755_at(i: int) -> int {
  let row = row_7755()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7755_sum(limit: int) -> int {
  let row = row_7755()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7755_best() -> int {
  let row = row_7755()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_1245_clamp(v: f64) -> f64 {
  guard v >= 3897.0 else {
    return 3897.0
  }
  guard v <= 52838.0 else {
    return 52838.0
  }
  return v
}

func curve_1245_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1245_clamp(t)
  return p + (q - p) * k
}

func curve_1245_ease(t: f64) -> f64 {
  let k = curve_1245_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1245_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_1353(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 19724
  for i in lo..hi {
    if i % 40038 == 0 {
      acc += i * 13044
    } else {
      acc -= i % 27145
    }
    if acc < 0 {
      acc += 48710
    }
    acc = acc % 48710
  }
  return acc
}


