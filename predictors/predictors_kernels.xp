func curve_3339_clamp(v: f64) -> f64 {
  guard v >= 11725.0 else {
    return 11725.0
  }
  guard v <= 23649.0 else {
    return 23649.0
  }
  return v
}

func curve_3339_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3339_clamp(t)
  return p + (q - p) * k
}

func curve_3339_ease(t: f64) -> f64 {
  let k = curve_3339_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3339_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_628(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 11725) % 60461)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 11725 + 72121) % 60461
    j += 1
  }
  return buf
}

func build_628_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_9394_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 18700
    i += 1
  }
  return acc % 18700
}

func text_9394_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "prism"
}

func text_9394_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 86269
}


