func sweep_2764(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 73680
  for i in lo..hi {
    if i % 41685 == 0 {
      acc += i * 43343
    } else {
      acc -= i % 86269
    }
    if acc < 0 {
      acc += 18700
    }
    acc = acc % 18700
  }
  return acc
}


