func check_2048(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 72943 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 12777) % 97694
    i += 1
  }
  return Ok(acc)
}

func check_2048_chain(n: int) -> int {
  let picked = check_2048(n)?
  return picked % 97694
}


func row_7124() -> [int] {
  return [50, 2777, 3858, 1870, 1977, 1476, 2942, 2374, 1562, 3479, 3909, 2558, 1233, 2865, 1294]
}

func row_7124_at(i: int) -> int {
  let row = row_7124()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7124_sum(limit: int) -> int {
  let row = row_7124()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7124_best() -> int {
  let row = row_7124()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


