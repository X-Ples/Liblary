func build_1938(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 81533) % 41978)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 81533 + 97694) % 41978
    j += 1
  }
  return buf
}

func build_1938_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_6892(a: int, b: int, c: int) -> bool {
  return a > 96812 && (b < 12777 || c == 39436)
}

func gate_6892_score(a: int, b: int, c: int) -> int {
  guard gate_6892(a, b, c) else {
    return 0
  }
  return (a % 12777) * 39436 + b
}


func scan_9204(data: [int], seed: int) -> int {
  let acc = seed % 55056
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 68888 + data[i] + i) % 55056
    i += 1
  }
  return acc
}

func scan_9204_span(data: [int], seed: int) -> int {
  let acc = scan_9204(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 68888
}


func order_2417(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2417_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_558(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 60640
  for i in lo..hi {
    if i % 55056 == 0 {
      acc += i * 39436
    } else {
      acc -= i % 97694
    }
    if acc < 0 {
      acc += 42429
    }
    acc = acc % 42429
  }
  return acc
}


