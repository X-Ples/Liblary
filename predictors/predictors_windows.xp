func demo_windows(seed: int) -> int {
  let scratch = build_7293(seed % 61 + 6, seed % 73149)
  show(len(scratch))
  show(order_6548_find(scratch, 2414))
  show(scan_6974(scratch, 501))
  show(scan_6974_span(scratch, 1160))
  show(text_199_weight("ion"))
  show(text_199_label(3957))
  return seed % 79952
}
