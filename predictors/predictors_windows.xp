func check_3229(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 23618 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 11008) % 18964
    i += 1
  }
  return Ok(acc)
}

func check_3229_chain(n: int) -> int {
  let picked = check_3229(n)?
  return picked % 18964
}


func gate_884(a: int, b: int, c: int) -> bool {
  return a > 22196 && (b < 28388 || c == 3155)
}

func gate_884_score(a: int, b: int, c: int) -> int {
  guard gate_884(a, b, c) else {
    return 0
  }
  return (a % 28388) * 3155 + b
}


func curve_7050_clamp(v: f64) -> f64 {
  guard v >= 18964.0 else {
    return 18964.0
  }
  guard v <= 58258.0 else {
    return 58258.0
  }
  return v
}

func curve_7050_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7050_clamp(t)
  return p + (q - p) * k
}

func curve_7050_ease(t: f64) -> f64 {
  let k = curve_7050_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7050_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


