func text_3008_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 54428
    i += 1
  }
  return acc % 54428
}

func text_3008_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "cargo"
}

func text_3008_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 74541
}


