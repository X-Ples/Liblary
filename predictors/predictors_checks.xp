func demo_checks(seed: int) -> int {
  let scratch = build_336(seed % 61 + 6, seed % 23173)
  show(len(scratch))
  show(build_336_last(scratch))
  show(sweep_1834(1382, 1179))
  show(row_4023_at(3567))
  show(row_4023_sum(1437))
  show(row_4023_best())
  return seed % 24277
}
