func build_336(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 15926) % 82493)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 15926 + 9210) % 82493
    j += 1
  }
  return buf
}

func build_336_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_1834(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 99410
  for i in lo..hi {
    if i % 15926 == 0 {
      acc += i * 20079
    } else {
      acc -= i % 74541
    }
    if acc < 0 {
      acc += 90573
    }
    acc = acc % 90573
  }
  return acc
}


func curve_355_clamp(v: f64) -> f64 {
  guard v >= 23173.0 else {
    return 23173.0
  }
  guard v <= 68625.0 else {
    return 68625.0
  }
  return v
}

func curve_355_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_355_clamp(t)
  return p + (q - p) * k
}

func curve_355_ease(t: f64) -> f64 {
  let k = curve_355_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_355_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


