const K0 = 78431
const K1 = 9892
const K2 = 8496
const K3 = 2201
const K4 = 98052
const K5 = 74973
const K6 = 61898
const K7 = 52321

func curve_9704_clamp(v: f64) -> f64 {
  guard v >= 52321.0 else {
    return 52321.0
  }
  guard v <= 59844.0 else {
    return 59844.0
  }
  return v
}

func curve_9704_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9704_clamp(t)
  return p + (q - p) * k
}

func curve_9704_ease(t: f64) -> f64 {
  let k = curve_9704_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9704_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_2974(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 20115) % 20137)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 20115 + 61898) % 20137
    j += 1
  }
  return buf
}

func build_2974_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_6381(a: int, b: int, c: int) -> bool {
  return a > 1807 && (b < 9892 || c == 11509)
}

func gate_6381_score(a: int, b: int, c: int) -> int {
  guard gate_6381(a, b, c) else {
    return 0
  }
  return (a % 9892) * 11509 + b
}


func text_2834_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 20115
    i += 1
  }
  return acc % 20115
}

func text_2834_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "sigma"
}

func text_2834_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 81554
}


func scan_8489(data: [int], seed: int) -> int {
  let acc = seed % 95087
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 16587 + data[i] + i) % 95087
    i += 1
  }
  return acc
}

func scan_8489_span(data: [int], seed: int) -> int {
  let acc = scan_8489(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 16587
}


func order_3332(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3332_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func check_6253(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 81554 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 19421) % 81554
    i += 1
  }
  return Ok(acc)
}

func check_6253_chain(n: int) -> int {
  let picked = check_6253(n)?
  return picked % 81554
}


