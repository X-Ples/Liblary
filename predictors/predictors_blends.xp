func demo_blends(seed: int) -> int {
  let scratch = build_2974(seed % 61 + 6, seed % 95087)
  show(len(scratch))
  show(build_2974_last(scratch))
  show(gate_6381(1761, 2580, 2755))
  show(gate_6381_score(1819, 3636, 708))
  show(text_2834_weight("harbor"))
  return seed % 24659
}
