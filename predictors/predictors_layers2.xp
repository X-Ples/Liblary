const K0 = 90785
const K1 = 67080
const K2 = 91165
const K3 = 23014
const K4 = 90785
const K5 = 21261
const K6 = 94004
const K7 = 91165

func curve_6332_clamp(v: f64) -> f64 {
  guard v >= 88477.0 else {
    return 88477.0
  }
  guard v <= 91165.0 else {
    return 91165.0
  }
  return v
}

func curve_6332_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6332_clamp(t)
  return p + (q - p) * k
}

func curve_6332_ease(t: f64) -> f64 {
  let k = curve_6332_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6332_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_2140(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 50892) % 95321)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 50892 + 19003) % 95321
    j += 1
  }
  return buf
}

func build_2140_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_9534(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 90934 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 80588) % 95321
    i += 1
  }
  return Ok(acc)
}

func check_9534_chain(n: int) -> int {
  let picked = check_9534(n)?
  return picked % 95321
}


func sweep_6692(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 80588
  for i in lo..hi {
    if i % 88477 == 0 {
      acc += i * 96676
    } else {
      acc -= i % 67080
    }
    if acc < 0 {
      acc += 23014
    }
    acc = acc % 23014
  }
  return acc
}


func gate_8553(a: int, b: int, c: int) -> bool {
  return a > 70438 && (b < 19003 || c == 47710)
}

func gate_8553_score(a: int, b: int, c: int) -> int {
  guard gate_8553(a, b, c) else {
    return 0
  }
  return (a % 19003) * 47710 + b
}


func row_422() -> [int] {
  return [3467, 3882, 2281, 3412, 1090, 3143, 1842, 3941, 2614, 1767, 3274, 1252]
}

func row_422_at(i: int) -> int {
  let row = row_422()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_422_sum(limit: int) -> int {
  let row = row_422()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_422_best() -> int {
  let row = row_422()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_6671_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 91165 + c * 80588 + seed) % 80588)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6671_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 80588 == want {
      total += acc
    }
    r += 1
  }
  return total
}


