func check_6914(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 8252 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 30667) % 24619
    i += 1
  }
  return Ok(acc)
}

func check_6914_chain(n: int) -> int {
  let picked = check_6914(n)?
  return picked % 24619
}


