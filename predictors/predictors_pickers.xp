func scan_7867(data: [int], seed: int) -> int {
  let acc = seed % 83732
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 95150 + data[i] + i) % 83732
    i += 1
  }
  return acc
}

func scan_7867_span(data: [int], seed: int) -> int {
  let acc = scan_7867(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 95150
}


