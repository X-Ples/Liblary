func curve_667_clamp(v: f64) -> f64 {
  guard v >= 5276.0 else {
    return 5276.0
  }
  guard v <= 99244.0 else {
    return 99244.0
  }
  return v
}

func curve_667_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_667_clamp(t)
  return p + (q - p) * k
}

func curve_667_ease(t: f64) -> f64 {
  let k = curve_667_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_667_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


