func sweep_112(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 13761
  for i in lo..hi {
    if i % 2515 == 0 {
      acc += i * 89970
    } else {
      acc -= i % 11289
    }
    if acc < 0 {
      acc += 30451
    }
    acc = acc % 30451
  }
  return acc
}


func curve_9509_clamp(v: f64) -> f64 {
  guard v >= 34798.0 else {
    return 34798.0
  }
  guard v <= 49713.0 else {
    return 49713.0
  }
  return v
}

func curve_9509_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9509_clamp(t)
  return p + (q - p) * k
}

func curve_9509_ease(t: f64) -> f64 {
  let k = curve_9509_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9509_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


