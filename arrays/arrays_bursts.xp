func demo_bursts(seed: int) -> int {
  let scratch = build_3887(seed % 61 + 6, seed % 61403)
  show(len(scratch))
  show(build_3887_last(scratch))
  show(text_1643_weight("quartz"))
  show(text_1643_label(3528))
  show(text_1643_has("ember"))
  return seed % 31549
}
