func build_3887(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 59633) % 64297)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 59633 + 64297) % 64297
    j += 1
  }
  return buf
}

func build_3887_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_1643_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
