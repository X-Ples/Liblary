const K0 = 62633
const K1 = 1557
const K2 = 26869
const K3 = 43266
const K4 = 93614
const K5 = 51798
const K6 = 93571
const K7 = 43056

func build_3741(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 43056) % 62633)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 43056 + 43266) % 62633
    j += 1
  }
  return buf
}

func build_3741_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_6873(data: [int], seed: int) -> int {
  let acc = seed % 49093
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 51798 + data[i] + i) % 49093
    i += 1
  }
  return acc
}

func scan_6873_span(data: [int], seed: int) -> int {
  let acc = scan_6873(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 51798
}


func curve_7531_clamp(v: f64) -> f64 {
  guard v >= 43056.0 else {
    return 43056.0
  }
  guard v <= 43266.0 else {
    return 43266.0
  }
  return v
}

func curve_7531_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7531_clamp(t)
  return p + (q - p) * k
}

func curve_7531_ease(t: f64) -> f64 {
  let k = curve_7531_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7531_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_7482(a: int, b: int, c: int) -> bool {
  return a > 9240 && (b < 26869 || c == 79883)
}

func gate_7482_score(a: int, b: int, c: int) -> int {
  guard gate_7482(a, b, c) else {
    return 0
  }
  return (a % 26869) * 79883 + b
}


func gate_3705(a: int, b: int, c: int) -> bool {
  return a > 24895 && (b < 49093 || c == 99166)
}

func gate_3705_score(a: int, b: int, c: int) -> int {
