func demo_blends(seed: int) -> int {
  let scratch = build_3741(seed % 61 + 6, seed % 43266)
  show(len(scratch))
  show(build_3741_last(scratch))
  show(scan_6873(scratch, 1079))
  show(scan_6873_span(scratch, 3387))
  show(gate_7482(187, 3387, 3977))
  show(gate_7482_score(1797, 3710, 156))
  return seed % 49093
}
