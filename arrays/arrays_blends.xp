func check_8705(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 15436 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 36949) % 43056
    i += 1
  }
  return Ok(acc)
}

func check_8705_chain(n: int) -> int {
  let picked = check_8705(n)?
  return picked % 43056
}


func row_7975() -> [int] {
  return [2231, 3513, 3203, 3130, 1762, 689, 1168, 1002, 1771, 1762]
}

func row_7975_at(i: int) -> int {
  let row = row_7975()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7975_sum(limit: int) -> int {
  let row = row_7975()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7975_best() -> int {
  let row = row_7975()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


