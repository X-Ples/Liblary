func sweep_7626(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 36949
  for i in lo..hi {
    if i % 93571 == 0 {
      acc += i * 78510
    } else {
      acc -= i % 35469
    }
    if acc < 0 {
      acc += 49093
    }
    acc = acc % 49093
  }
  return acc
}


