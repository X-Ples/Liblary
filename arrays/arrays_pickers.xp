func text_6763_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 81394
    i += 1
  }
  return acc % 81394
}

func text_6763_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "nova"
}

func text_6763_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 44377
}


func build_7495(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 75655) % 12287)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 75655 + 33629) % 12287
    j += 1
  }
  return buf
}

func build_7495_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_8120() -> [int] {
  return [1885, 2747, 2286, 3526, 3155, 662, 2514, 1982, 475, 2773, 995, 1887, 1376, 2030, 2017, 3257, 3952, 2074, 1500]
}

func row_8120_at(i: int) -> int {
  let row = row_8120()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8120_sum(limit: int) -> int {
  let row = row_8120()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8120_best() -> int {
  let row = row_8120()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_155(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 17485 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 22891) % 86128
    i += 1
  }
  return Ok(acc)
}

func check_155_chain(n: int) -> int {
  let picked = check_155(n)?
  return picked % 86128
}


func curve_510_clamp(v: f64) -> f64 {
  guard v >= 34937.0 else {
    return 34937.0
  }
  guard v <= 34937.0 else {
    return 34937.0
  }
  return v
}

func curve_510_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_510_clamp(t)
  return p + (q - p) * k
}

func curve_510_ease(t: f64) -> f64 {
  let k = curve_510_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_510_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


