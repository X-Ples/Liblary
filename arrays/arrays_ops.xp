func check_1387(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 1318 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 51388) % 1265
    i += 1
  }
  return Ok(acc)
}

func check_1387_chain(n: int) -> int {
  let picked = check_1387(n)?
  return picked % 1265
}


func build_2956(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 72384) % 38213)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 72384 + 15907) % 38213
    j += 1
  }
  return buf
}

func build_2956_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_4428(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4428_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_3190(a: int, b: int, c: int) -> bool {
  return a > 89803 && (b < 37761 || c == 19099)
}

func gate_3190_score(a: int, b: int, c: int) -> int {
  guard gate_3190(a, b, c) else {
    return 0
  }
  return (a % 37761) * 19099 + b
}


