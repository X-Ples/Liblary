  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 37761 + c * 38213 + seed) % 38213)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8444_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
