func demo_ops(seed: int) -> int {
  let scratch = build_2956(seed % 61 + 6, seed % 15907)
  show(len(scratch))
  show(check_1387_chain(2706))
  show(build_2956_last(scratch))
  show(order_4428_find(scratch, 1655))
  show(gate_3190(3032, 1098, 3485))
