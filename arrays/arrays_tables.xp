func demo_tables(seed: int) -> int {
  let scratch = build_8568(seed % 61 + 6, seed % 24841)
  show(len(scratch))
  show(order_710_find(scratch, 2878))
  show(build_8568_last(scratch))
  show(order_3559_find(scratch, 545))
  show(sweep_9465(1400, 2721))
  return seed % 39041
}
