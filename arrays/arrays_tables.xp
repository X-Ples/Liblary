func sweep_9465(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 38445
  for i in lo..hi {
    if i % 35483 == 0 {
      acc += i * 72375
    } else {
      acc -= i % 9153
    }
    if acc < 0 {
      acc += 75048
    }
    acc = acc % 75048
  }
  return acc
}


