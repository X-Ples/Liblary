func curve_6794_clamp(v: f64) -> f64 {
  guard v >= 35483.0 else {
    return 35483.0
  }
  guard v <= 90381.0 else {
    return 90381.0
  }
  return v
}

func curve_6794_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6794_clamp(t)
  return p + (q - p) * k
}

func curve_6794_ease(t: f64) -> f64 {
  let k = curve_6794_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6794_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_6618(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 86543 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 86912) % 86912
    i += 1
  }
  return Ok(acc)
}

func check_6618_chain(n: int) -> int {
  let picked = check_6618(n)?
  return picked % 86912
}


func row_7023() -> [int] {
  return [2657, 228, 2229, 2910, 251, 1634, 801, 1392, 2985, 3608, 2350, 3337, 2853, 3343]
}

func row_7023_at(i: int) -> int {
  let row = row_7023()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7023_sum(limit: int) -> int {
  let row = row_7023()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7023_best() -> int {
  let row = row_7023()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


