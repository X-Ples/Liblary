func sweep_7219(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 80341
  for i in lo..hi {
    if i % 96628 == 0 {
      acc += i * 25973
    } else {
      acc -= i % 4032
    }
    if acc < 0 {
      acc += 4032
    }
    acc = acc % 4032
  }
  return acc
}


func build_5123(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 85086) % 52566)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 85086 + 49471) % 52566
    j += 1
  }
  return buf
}

func build_5123_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_2542(data: [int], seed: int) -> int {
  let acc = seed % 11980
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 24598 + data[i] + i) % 11980
    i += 1
  }
  return acc
}

func scan_2542_span(data: [int], seed: int) -> int {
  let acc = scan_2542(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 24598
}


func check_3561(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 99715 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 96628) % 75004
    i += 1
  }
  return Ok(acc)
}

func check_3561_chain(n: int) -> int {
  let picked = check_3561(n)?
  return picked % 75004
}


func curve_3386_clamp(v: f64) -> f64 {
  guard v >= 24598.0 else {
    return 24598.0
  }
  guard v <= 85970.0 else {
    return 85970.0
  }
  return v
}

func curve_3386_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3386_clamp(t)
  return p + (q - p) * k
}

func curve_3386_ease(t: f64) -> f64 {
  let k = curve_3386_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3386_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


