func row_8617() -> [int] {
  return [442, 279, 2503, 1345, 2166, 1286, 1947, 116, 3214, 1911, 1033, 3287, 3692, 3298, 1353]
}

func row_8617_at(i: int) -> int {
  let row = row_8617()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8617_sum(limit: int) -> int {
  let row = row_8617()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8617_best() -> int {
  let row = row_8617()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


