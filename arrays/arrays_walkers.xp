func text_3034_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 93542
    i += 1
  }
  return acc % 93542
}

func text_3034_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "alpha"
}

func text_3034_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 21968
}


func check_8216(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 29336 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 10488) % 33476
    i += 1
  }
  return Ok(acc)
}

func check_8216_chain(n: int) -> int {
  let picked = check_8216(n)?
  return picked % 33476
}


