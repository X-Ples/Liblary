func demo_walkers(seed: int) -> int {
  let scratch = build_8072(seed % 61 + 6, seed % 10488)
  show(len(scratch))
  show(build_8072_last(scratch))
  show(order_8033_find(scratch, 1028))
  show(sweep_346(567, 1254))
  return seed % 59827
}
