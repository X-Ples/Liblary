func build_8072(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 94390) % 22185)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 94390 + 40666) % 22185
    j += 1
  }
  return buf
}

func build_8072_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_8033(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8033_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_346(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 19440
  for i in lo..hi {
    if i % 83714 == 0 {
      acc += i * 94920
    } else {
      acc -= i % 23252
    }
    if acc < 0 {
      acc += 21968
    }
    acc = acc % 21968
  }
  return acc
}


func curve_4692_clamp(v: f64) -> f64 {
  guard v >= 19440.0 else {
    return 19440.0
  }
  guard v <= 25433.0 else {
    return 25433.0
  }
  return v
}

func curve_4692_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4692_clamp(t)
  return p + (q - p) * k
}

func curve_4692_ease(t: f64) -> f64 {
  let k = curve_4692_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4692_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_5364(a: int, b: int, c: int) -> bool {
  return a > 36657 && (b < 10114 || c == 25433)
}

func gate_5364_score(a: int, b: int, c: int) -> int {
  guard gate_5364(a, b, c) else {
    return 0
  }
  return (a % 10114) * 25433 + b
}


