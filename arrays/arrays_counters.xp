func gate_8601(a: int, b: int, c: int) -> bool {
  return a > 54567 && (b < 93117 || c == 54567)
}

func gate_8601_score(a: int, b: int, c: int) -> int {
  guard gate_8601(a, b, c) else {
    return 0
  }
  return (a % 93117) * 54567 + b
}


func build_3890(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 51266) % 93117)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 51266 + 4096) % 93117
    j += 1
  }
  return buf
}

func build_3890_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_6170(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 51266
  for i in lo..hi {
    if i % 90656 == 0 {
      acc += i * 37316
    } else {
      acc -= i % 17431
    }
    if acc < 0 {
      acc += 93040
    }
    acc = acc % 93040
  }
  return acc
}


