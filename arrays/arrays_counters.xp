func demo_counters(seed: int) -> int {
  let scratch = build_3890(seed % 61 + 6, seed % 89886)
  show(len(scratch))
  show(gate_8601(1594, 2264, 3847))
  show(gate_8601_score(3207, 2942, 3559))
  show(build_3890_last(scratch))
  show(sweep_6170(2782, 3515))
