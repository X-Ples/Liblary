func build_3545(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 7640) % 30939)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 7640 + 14602) % 30939
    j += 1
  }
  return buf
}

func build_3545_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_5638(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 48441 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 5371) % 14602
    i += 1
  }
  return Ok(acc)
}

func check_5638_chain(n: int) -> int {
  let picked = check_5638(n)?
  return picked % 14602
}


func grid_663_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 80384 + c * 48441 + seed) % 48441)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_663_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 48441 == want {
      total += acc
    }
    r += 1
  }
  return total
}


