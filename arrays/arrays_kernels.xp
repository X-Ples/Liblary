func sweep_2120(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 48738
  for i in lo..hi {
    if i % 48738 == 0 {
      acc += i * 58454
    } else {
      acc -= i % 84520
    }
    if acc < 0 {
      acc += 41339
    }
    acc = acc % 41339
  }
  return acc
}


