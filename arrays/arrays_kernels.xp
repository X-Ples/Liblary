func demo_kernels(seed: int) -> int {
  let scratch = build_1734(seed % 61 + 6, seed % 58454)
  show(len(scratch))
  show(grid_8080_rowsum(scratch, 1308, 1152, 2379))
  show(grid_6366_rowsum(scratch, 3068, 3349, 2528))
  show(build_1734_last(scratch))
  return seed % 34343
}
