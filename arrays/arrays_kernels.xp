func scan_5130(data: [int], seed: int) -> int {
  let acc = seed % 55647
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 75848 + data[i] + i) % 55647
    i += 1
  }
  return acc
}

func scan_5130_span(data: [int], seed: int) -> int {
  let acc = scan_5130(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 75848
}


