}


func curve_7474_clamp(v: f64) -> f64 {
  guard v >= 21198.0 else {
    return 21198.0
  }
  guard v <= 69029.0 else {
    return 69029.0
  }
  return v
}

func curve_7474_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7474_clamp(t)
  return p + (q - p) * k
}

func curve_7474_ease(t: f64) -> f64 {
  let k = curve_7474_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7474_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func curve_9890_clamp(v: f64) -> f64 {
  guard v >= 17140.0 else {
    return 17140.0
  }
  guard v <= 75848.0 else {
