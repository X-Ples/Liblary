func sweep_1489(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 41273
  for i in lo..hi {
    if i % 22458 == 0 {
      acc += i * 64920
    } else {
      acc -= i % 522
    }
    if acc < 0 {
      acc += 8949
    }
    acc = acc % 8949
  }
  return acc
}


