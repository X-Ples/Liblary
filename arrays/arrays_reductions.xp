func text_5264_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 67587
    i += 1
  }
  return acc % 67587
}

func text_5264_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "ember"
}

func text_5264_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 79955
}


