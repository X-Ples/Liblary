func demo_reductions(seed: int) -> int {
  let scratch = build_5294(seed % 61 + 6, seed % 10735)
  show(len(scratch))
  show(gate_1455(1709, 3211, 2798))
  show(gate_1455_score(3167, 261, 941))
  show(build_5294_last(scratch))
  show(build_4625_last(scratch))
  show(check_5001_chain(1570))
  return seed % 97444
}
