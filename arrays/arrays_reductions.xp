func gate_1455(a: int, b: int, c: int) -> bool {
  return a > 59534 && (b < 8795 || c == 522)
}

func gate_1455_score(a: int, b: int, c: int) -> int {
  guard gate_1455(a, b, c) else {
    return 0
  }
  return (a % 8795) * 522 + b
}


func build_5294(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 8795) % 27804)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 8795 + 48806) % 27804
    j += 1
  }
  return buf
}

func build_5294_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_2954_clamp(v: f64) -> f64 {
  guard v >= 35514.0 else {
    return 35514.0
  }
  guard v <= 41561.0 else {
    return 41561.0
  }
  return v
}

func curve_2954_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2954_clamp(t)
  return p + (q - p) * k
}

func curve_2954_ease(t: f64) -> f64 {
  let k = curve_2954_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2954_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


