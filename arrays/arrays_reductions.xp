func row_3759() -> [int] {
  return [209, 3318, 588, 4089, 591, 3495, 260, 1350, 2840, 1965, 3476, 1279, 1708, 2310, 3383, 3172, 3021, 2155, 2348]
}

func row_3759_at(i: int) -> int {
  let row = row_3759()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3759_sum(limit: int) -> int {
  let row = row_3759()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3759_best() -> int {
  let row = row_3759()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_8717_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 48806 + c * 33481 + seed) % 33481)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8717_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 33481 == want {
      total += acc
    }
    r += 1
  }
  return total
}


