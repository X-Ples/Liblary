func check_5001(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 22458 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 9634) % 66354
    i += 1
  }
  return Ok(acc)
}

func check_5001_chain(n: int) -> int {
  let picked = check_5001(n)?
  return picked % 66354
}


