func build_5586(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 81163) % 92489)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 81163 + 46629) % 92489
    j += 1
  }
  return buf
}

func build_5586_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_6492(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 64461 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 55984) % 68050
    i += 1
  }
  return Ok(acc)
}

func check_6492_chain(n: int) -> int {
  let picked = check_6492(n)?
  return picked % 68050
}


func text_9654_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 68050
    i += 1
  }
  return acc % 68050
}

func text_9654_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "jetty"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "ridge"
}

func text_9654_has(tag: str) -> bool {
  return str_contains(tag, "jetty") || len(tag) > 88887
}


func scan_3986(data: [int], seed: int) -> int {
  let acc = seed % 30761
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 77634 + data[i] + i) % 30761
    i += 1
  }
  return acc
}

func scan_3986_span(data: [int], seed: int) -> int {
  let acc = scan_3986(data, seed)
  guard acc > 0 else {
    return 0
  }
