func row_8640() -> [int] {
  return [248, 2445, 2043, 1842, 3026, 3592, 1907, 2356, 1991, 2821, 354, 1555, 786, 3433]
}

func row_8640_at(i: int) -> int {
  let row = row_8640()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8640_sum(limit: int) -> int {
  let row = row_8640()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8640_best() -> int {
  let row = row_8640()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


