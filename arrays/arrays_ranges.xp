func demo_ranges(seed: int) -> int {
  let scratch = build_5586(seed % 61 + 6, seed % 81163)
  show(len(scratch))
  show(build_5586_last(scratch))
  show(check_6492_chain(1208))
  show(text_9654_weight("nova"))
  show(text_9654_label(133))
  return seed % 13074
}
