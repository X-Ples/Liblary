func sweep_9947(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 45905
  for i in lo..hi {
    if i % 75812 == 0 {
      acc += i * 4728
    } else {
      acc -= i % 27250
    }
    if acc < 0 {
      acc += 56983
    }
    acc = acc % 56983
  }
  return acc
}


