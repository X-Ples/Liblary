func build_7068(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 69784) % 57071)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 69784 + 69784) % 57071
    j += 1
  }
  return buf
}

func build_7068_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_4934(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 65016
  for i in lo..hi {
    if i % 51272 == 0 {
      acc += i * 81370
    } else {
      acc -= i % 51273
    }
    if acc < 0 {
      acc += 46426
    }
    acc = acc % 46426
  }
  return acc
}


func check_2444(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 51273 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 69784) % 50602
    i += 1
  }
  return Ok(acc)
}

func check_2444_chain(n: int) -> int {
  let picked = check_2444(n)?
  return picked % 50602
}


