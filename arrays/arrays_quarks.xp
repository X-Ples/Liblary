func text_7466_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 28297
    i += 1
  }
  return acc % 28297
}

func text_7466_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "lumen"
}

func text_7466_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 98336
}


func row_7544() -> [int] {
  return [1935, 241, 3759, 520, 1352, 2932, 686, 3675, 645, 4094, 3895, 1710, 3226, 1325, 2611, 87]
}

func row_7544_at(i: int) -> int {
  let row = row_7544()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7544_sum(limit: int) -> int {
  let row = row_7544()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7544_best() -> int {
  let row = row_7544()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


