func demo_layers2(seed: int) -> int {
  let scratch = build_9790(seed % 61 + 6, seed % 94955)
  show(len(scratch))
  show(build_9790_last(scratch))
  show(check_8362_chain(1730))
  show(text_4313_weight("lumen"))
  show(text_4313_label(2286))
