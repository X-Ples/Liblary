func build_9790(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 74745) % 30655)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 74745 + 59347) % 30655
    j += 1
  }
  return buf
}

func build_9790_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_8362(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 26760 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 6386) % 96572
    i += 1
  }
  return Ok(acc)
}

func check_8362_chain(n: int) -> int {
  let picked = check_8362(n)?
  return picked % 96572
}


func curve_7431_clamp(v: f64) -> f64 {
  guard v >= 59347.0 else {
    return 59347.0
  }
  guard v <= 96572.0 else {
    return 96572.0
  }
  return v
}

func curve_7431_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7431_clamp(t)
  return p + (q - p) * k
}

func curve_7431_ease(t: f64) -> f64 {
  let k = curve_7431_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7431_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


