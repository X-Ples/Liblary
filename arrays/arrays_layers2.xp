func grid_7072_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 62659 + c * 74745 + seed) % 74745)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7072_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 74745 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_8068(data: [int], seed: int) -> int {
  let acc = seed % 67978
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 58259 + data[i] + i) % 67978
    i += 1
  }
  return acc
}

func scan_8068_span(data: [int], seed: int) -> int {
  let acc = scan_8068(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 58259
}


