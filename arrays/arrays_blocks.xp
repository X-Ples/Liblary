func build_5749(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 73051) % 67655)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 73051 + 98107) % 67655
    j += 1
  }
  return buf
}

func build_5749_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_3823_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 92227 + c * 34247 + seed) % 34247)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3823_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 34247 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_7366(data: [int], seed: int) -> int {
  let acc = seed % 27457
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 57455 + data[i] + i) % 27457
    i += 1
  }
  return acc
}

func scan_7366_span(data: [int], seed: int) -> int {
  let acc = scan_7366(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 57455
}


