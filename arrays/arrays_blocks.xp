func demo_blocks(seed: int) -> int {
  let scratch = build_5749(seed % 61 + 6, seed % 57455)
  show(len(scratch))
  show(build_5749_last(scratch))
  show(grid_3823_rowsum(scratch, 198, 479, 810))
  show(scan_7366(scratch, 1943))
  show(scan_7366_span(scratch, 1679))
  return seed % 85643
}
