func check_1378(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 80953 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 25285) % 57455
    i += 1
  }
  return Ok(acc)
}

func check_1378_chain(n: int) -> int {
  let picked = check_1378(n)?
  return picked % 57455
}


func curve_599_clamp(v: f64) -> f64 {
  guard v >= 49965.0 else {
    return 49965.0
  }
  guard v <= 99368.0 else {
    return 99368.0
  }
  return v
}

func curve_599_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_599_clamp(t)
  return p + (q - p) * k
}

func curve_599_ease(t: f64) -> f64 {
  let k = curve_599_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_599_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


