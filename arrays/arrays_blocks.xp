func sweep_2181(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 34247
  for i in lo..hi {
    if i % 86922 == 0 {
      acc += i * 34247
    } else {
      acc -= i % 99368
    }
    if acc < 0 {
      acc += 85643
    }
    acc = acc % 85643
  }
  return acc
}


