func check_5858(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 75059 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 12258) % 68252
    i += 1
  }
  return Ok(acc)
}

func check_5858_chain(n: int) -> int {
  let picked = check_5858(n)?
  return picked % 68252
}


