const K5 = 38015

func build_5334(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 91803) % 5409)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 91803 + 98500) % 5409
    j += 1
  }
  return buf
}

func build_5334_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_7121_clamp(v: f64) -> f64 {
  guard v >= 4302.0 else {
    return 4302.0
  }
  guard v <= 34883.0 else {
    return 34883.0
  }
  return v
}

func curve_7121_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7121_clamp(t)
  return p + (q - p) * k
}

func curve_7121_ease(t: f64) -> f64 {
  let k = curve_7121_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7121_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_634(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 29589 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 43456) % 38015
    i += 1
  }
  return Ok(acc)
}

func check_634_chain(n: int) -> int {
  let picked = check_634(n)?
  return picked % 38015
}


