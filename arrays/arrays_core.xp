func text_6602_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "prism"
}

func text_6602_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 67173
}


