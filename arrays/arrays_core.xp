}


func sweep_3932(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 14444
  for i in lo..hi {
    if i % 2517 == 0 {
      acc += i * 67173
    } else {
      acc -= i % 3798
    }
    if acc < 0 {
      acc += 3798
    }
    acc = acc % 3798
  }
  return acc
}


