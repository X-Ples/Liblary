func demo_core(seed: int) -> int {
  let scratch = build_5334(seed % 61 + 6, seed % 73171)
  show(len(scratch))
  show(build_5334_last(scratch))
  show(check_634_chain(3880))
  show(check_5553_chain(830))
  show(check_7290_chain(3861))
  show(scan_5500(scratch, 3088))
  return seed % 25987
}
