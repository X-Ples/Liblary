func check_6631(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 15036 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 46190) % 71630
    i += 1
  }
  return Ok(acc)
}

func check_6631_chain(n: int) -> int {
  let picked = check_6631(n)?
  return picked % 71630
}


