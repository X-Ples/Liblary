func row_959() -> [int] {
  return [2627, 3021, 670, 2694, 133, 3372, 2773, 3080, 759, 3622]
}

func row_959_at(i: int) -> int {
  let row = row_959()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_959_sum(limit: int) -> int {
  let row = row_959()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_959_best() -> int {
  let row = row_959()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


