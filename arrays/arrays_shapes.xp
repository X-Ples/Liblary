func text_608_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 55797
    i += 1
  }
  return acc % 55797
}

func text_608_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "cargo"
}

func text_608_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 46190
}


func sweep_2516(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 55797
  for i in lo..hi {
    if i % 4607 == 0 {
      acc += i * 73091
    } else {
      acc -= i % 55797
    }
    if acc < 0 {
      acc += 7944
    }
    acc = acc % 7944
  }
  return acc
}


