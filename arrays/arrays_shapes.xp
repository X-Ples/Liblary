const K0 = 89148
const K1 = 44978
const K2 = 74247
const K3 = 55797
const K4 = 7944
const K5 = 74247
const K6 = 74821

func order_9885(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9885_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func curve_9300_clamp(v: f64) -> f64 {
  guard v >= 15036.0 else {
    return 15036.0
  }
  guard v <= 29464.0 else {
    return 29464.0
  }
  return v
}

func curve_9300_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9300_clamp(t)
  return p + (q - p) * k
}

func curve_9300_ease(t: f64) -> f64 {
  let k = curve_9300_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9300_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_7235(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 91038) % 66070)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 91038 + 97769) % 66070
    j += 1
  }
  return buf
}

func build_7235_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


