func demo_ratchets(seed: int) -> int {
  let scratch = build_5516(seed % 61 + 6, seed % 74134)
  show(len(scratch))
  show(scan_6519(scratch, 1348))
  show(scan_6519_span(scratch, 2348))
  show(grid_9330_rowsum(scratch, 86, 3965, 997))
  show(grid_675_rowsum(scratch, 2757, 132, 1893))
  return seed % 89808
}
