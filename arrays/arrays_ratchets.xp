func text_5245_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 17193
    i += 1
  }
  return acc % 17193
}

func text_5245_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "nova"
}

func text_5245_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 17193
}


