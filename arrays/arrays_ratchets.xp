func build_5516(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 89808) % 3254)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 89808 + 42127) % 3254
    j += 1
  }
  return buf
}

func build_5516_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_3802(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 8179 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 74134) % 85280
    i += 1
  }
  return Ok(acc)
}

func check_3802_chain(n: int) -> int {
  let picked = check_3802(n)?
  return picked % 85280
}


