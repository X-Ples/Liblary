func check_8482(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 61644 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 57650) % 90713
    i += 1
  }
  return Ok(acc)
}

func check_8482_chain(n: int) -> int {
  let picked = check_8482(n)?
  return picked % 90713
}


