const K0 = 81767
const K1 = 26150
const K2 = 1509
const K3 = 88476
const K4 = 81767
const K5 = 13049

func build_7675(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 96104) % 40916)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 96104 + 75639) % 40916
    j += 1
  }
  return buf
}

func build_7675_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_7873_clamp(v: f64) -> f64 {
  guard v >= 71894.0 else {
    return 71894.0
  }
  guard v <= 84267.0 else {
    return 84267.0
  }
  return v
}

func curve_7873_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7873_clamp(t)
  return p + (q - p) * k
}

func curve_7873_ease(t: f64) -> f64 {
  let k = curve_7873_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7873_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_8412(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 75703
  for i in lo..hi {
    if i % 88476 == 0 {
      acc += i * 81767
    } else {
      acc -= i % 1509
    }
    if acc < 0 {
      acc += 75703
    }
    acc = acc % 75703
  }
  return acc
}


