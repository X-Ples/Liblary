func text_7441_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "flint"
}

func text_7441_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 66509
}


func grid_8221_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 91775 + c * 13049 + seed) % 13049)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8221_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 13049 == want {
      total += acc
    }
    r += 1
  }
  return total
}


