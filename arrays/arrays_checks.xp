func demo_checks(seed: int) -> int {
  let scratch = build_7675(seed % 61 + 6, seed % 61644)
  show(len(scratch))
  show(build_7675_last(scratch))
  show(sweep_8412(2065, 3444))
  show(order_8459_find(scratch, 1969))
  show(order_7863_find(scratch, 2826))
  return seed % 60432
}
