  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 90713 + c * 57650 + seed) % 57650)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1814_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
