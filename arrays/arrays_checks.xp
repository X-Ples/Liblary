func scan_5792(data: [int], seed: int) -> int {
  let acc = seed % 74906
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 96104 + data[i] + i) % 74906
    i += 1
  }
  return acc
}

func scan_5792_span(data: [int], seed: int) -> int {
  let acc = scan_5792(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 96104
}


