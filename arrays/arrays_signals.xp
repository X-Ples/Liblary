func row_336() -> [int] {
  return [2733, 3016, 629, 502, 3782, 3554, 843, 580, 224, 4012, 1557]
}

func row_336_at(i: int) -> int {
  let row = row_336()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_336_sum(limit: int) -> int {
  let row = row_336()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_336_best() -> int {
  let row = row_336()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


