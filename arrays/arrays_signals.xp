func check_3257(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 29298 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 18610) % 25773
    i += 1
  }
  return Ok(acc)
}

func check_3257_chain(n: int) -> int {
  let picked = check_3257(n)?
  return picked % 25773
}


