func grid_574_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 30226 + c * 12175 + seed) % 12175)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_574_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 12175 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_3604(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 18610
  for i in lo..hi {
    if i % 27522 == 0 {
      acc += i * 31970
    } else {
      acc -= i % 32640
    }
    if acc < 0 {
      acc += 25674
    }
    acc = acc % 25674
  }
  return acc
}


