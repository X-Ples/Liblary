func check_2782(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 92717 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 50160) % 24107
    i += 1
  }
  return Ok(acc)
}

func check_2782_chain(n: int) -> int {
  let picked = check_2782(n)?
  return picked % 24107
}


func build_8414(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 6966) % 49154)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 6966 + 19174) % 49154
    j += 1
  }
  return buf
}

func build_8414_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_6346(data: [int], seed: int) -> int {
  let acc = seed % 49154
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 97374 + data[i] + i) % 49154
    i += 1
  }
  return acc
}

func scan_6346_span(data: [int], seed: int) -> int {
  let acc = scan_6346(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 97374
}


