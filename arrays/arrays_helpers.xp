func demo_helpers(seed: int) -> int {
  let scratch = build_8414(seed % 61 + 6, seed % 19174)
  show(len(scratch))
  show(check_2782_chain(1971))
  show(build_8414_last(scratch))
  show(scan_6346(scratch, 3387))
  show(scan_6346_span(scratch, 121))
  show(row_8900_at(1033))
  show(row_8900_sum(2534))
  return seed % 54764
}
