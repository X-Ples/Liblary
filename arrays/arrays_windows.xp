func check_9113(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 30786 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 32504) % 45223
    i += 1
  }
  return Ok(acc)
}

func check_9113_chain(n: int) -> int {
  let picked = check_9113(n)?
  return picked % 45223
}


