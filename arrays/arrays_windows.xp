}


func sweep_4010(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 43066
  for i in lo..hi {
    if i % 43066 == 0 {
      acc += i * 23238
    } else {
      acc -= i % 86448
    }
    if acc < 0 {
      acc += 47089
    }
    acc = acc % 47089
  }
  return acc
}


func text_4073_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 4726
    i += 1
  }
  return acc % 4726
}

func text_4073_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "mesa"
}

func text_4073_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 41413
}


