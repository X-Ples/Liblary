func check_2509(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 11065 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 68116) % 46758
    i += 1
  }
  return Ok(acc)
}

func check_2509_chain(n: int) -> int {
  let picked = check_2509(n)?
  return picked % 46758
}


func build_3015(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 3833) % 61528)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 3833 + 4610) % 61528
    j += 1
  }
  return buf
}

func build_3015_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_5226() -> [int] {
  return [3807, 3859, 1429, 3476, 3529, 1733, 425, 501, 3686, 1441, 420, 919, 2602, 1721, 902, 3443, 1397]
}

func row_5226_at(i: int) -> int {
  let row = row_5226()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5226_sum(limit: int) -> int {
  let row = row_5226()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5226_best() -> int {
  let row = row_5226()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


