func demo_trims(seed: int) -> int {
  let scratch = build_3015(seed % 61 + 6, seed % 30391)
  show(len(scratch))
  show(check_2509_chain(1741))
  show(build_3015_last(scratch))
  show(row_5226_at(3489))
  show(row_5226_sum(1409))
  show(row_5226_best())
  return seed % 58859
}
