  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 78563 + c * 68104 + seed) % 68104)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6804_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 68104 == want {
      total += acc
    }
    r += 1
  }
  return total
}


