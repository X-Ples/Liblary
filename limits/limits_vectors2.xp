func check_6139(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 93503 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 15993) % 76667
    i += 1
  }
  return Ok(acc)
}

func check_6139_chain(n: int) -> int {
  let picked = check_6139(n)?
  return picked % 76667
}


