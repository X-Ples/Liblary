func demo_vectors2(seed: int) -> int {
  let scratch = build_9375(seed % 61 + 6, seed % 93503)
  show(len(scratch))
  show(build_9375_last(scratch))
  show(grid_2014_rowsum(scratch, 1822, 3643, 1508))
  show(grid_8252_rowsum(scratch, 1427, 1132, 1483))
  show(build_7212_last(scratch))
  return seed % 77101
}
