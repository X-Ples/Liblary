func order_6835(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6835_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_2073(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 83289
  for i in lo..hi {
    if i % 58646 == 0 {
      acc += i * 24366
    } else {
      acc -= i % 21917
    }
    if acc < 0 {
      acc += 15993
    }
    acc = acc % 15993
  }
  return acc
}


func text_625_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 93503
    i += 1
  }
  return acc % 93503
}

func text_625_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "bravo"
}

func text_625_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 15993
}


