func check_8589(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 85000 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 89965) % 9799
    i += 1
  }
  return Ok(acc)
}

func check_8589_chain(n: int) -> int {
  let picked = check_8589(n)?
  return picked % 9799
}


