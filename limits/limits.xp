func build_9406(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 61166) % 85000)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 61166 + 22740) % 85000
    j += 1
  }
  return buf
}

func build_9406_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_4499(data: [int], seed: int) -> int {
  let acc = seed % 41185
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 13923 + data[i] + i) % 41185
    i += 1
  }
  return acc
}

func scan_4499_span(data: [int], seed: int) -> int {
  let acc = scan_4499(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 13923
}


func row_1565() -> [int] {
  return [600, 2387, 1114, 555, 1965, 3277, 745, 2504, 218, 1918, 3970, 3119, 445, 1498, 82, 454]
}

func row_1565_at(i: int) -> int {
  let row = row_1565()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1565_sum(limit: int) -> int {
  let row = row_1565()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1565_best() -> int {
  let row = row_1565()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_6679(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 26013
  for i in lo..hi {
    if i % 45236 == 0 {
      acc += i * 33100
    } else {
      acc -= i % 50491
    }
    if acc < 0 {
      acc += 11074
    }
    acc = acc % 11074
  }
  return acc
}


func gate_9421(a: int, b: int, c: int) -> bool {
  return a > 45236 && (b < 82528 || c == 71607)
}

func gate_9421_score(a: int, b: int, c: int) -> int {
  guard gate_9421(a, b, c) else {
    return 0
  }
  return (a % 82528) * 71607 + b
}


func order_7395(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7395_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


