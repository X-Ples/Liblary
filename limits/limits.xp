func text_1658_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 89965
    i += 1
  }
  return acc % 89965
}

func text_1658_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "kilo"
}

func text_1658_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 9799
}


