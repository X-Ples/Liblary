func check_7928(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 72535 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 34523) % 38551
    i += 1
  }
  return Ok(acc)
}

func check_7928_chain(n: int) -> int {
  let picked = check_7928(n)?
  return picked % 38551
}


