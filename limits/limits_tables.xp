func build_4925(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 4505) % 1361)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 4505 + 72535) % 1361
    j += 1
  }
  return buf
}

func build_4925_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_7920_clamp(v: f64) -> f64 {
  guard v >= 1361.0 else {
    return 1361.0
  }
  guard v <= 60471.0 else {
    return 60471.0
  }
  return v
}

func curve_7920_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7920_clamp(t)
  return p + (q - p) * k
}

func curve_7920_ease(t: f64) -> f64 {
  let k = curve_7920_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7920_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_5274_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 72535
    i += 1
  }
  return acc % 72535
}

func text_5274_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "sigma"
}

func text_5274_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 4505
}


func order_5637(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5637_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


