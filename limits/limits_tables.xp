func sweep_8931(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10069
  for i in lo..hi {
    if i % 49314 == 0 {
      acc += i * 99723
    } else {
      acc -= i % 12826
    }
    if acc < 0 {
      acc += 79598
    }
    acc = acc % 79598
  }
  return acc
}


