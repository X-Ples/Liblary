func curve_6092_clamp(v: f64) -> f64 {
  guard v >= 24888.0 else {
    return 24888.0
  }
  guard v <= 80812.0 else {
    return 80812.0
  }
  return v
}

func curve_6092_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6092_clamp(t)
  return p + (q - p) * k
}

func curve_6092_ease(t: f64) -> f64 {
  let k = curve_6092_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6092_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


