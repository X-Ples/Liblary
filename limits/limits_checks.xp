func build_2643(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 80812) % 87794)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 80812 + 6061) % 87794
    j += 1
  }
  return buf
}

func build_2643_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_5925(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 87794 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 22307) % 19380
    i += 1
  }
  return Ok(acc)
}

func check_5925_chain(n: int) -> int {
  let picked = check_5925(n)?
  return picked % 19380
}


func sweep_4434(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 58675
  for i in lo..hi {
    if i % 6061 == 0 {
      acc += i * 25819
    } else {
      acc -= i % 90433
    }
    if acc < 0 {
      acc += 24888
    }
    acc = acc % 24888
  }
  return acc
}


