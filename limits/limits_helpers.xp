func scan_7247(data: [int], seed: int) -> int {
  let acc = seed % 15951
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 25467 + data[i] + i) % 15951
    i += 1
  }
  return acc
}

func scan_7247_span(data: [int], seed: int) -> int {
  let acc = scan_7247(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 25467
}


func sweep_1302(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 22131
  for i in lo..hi {
    if i % 82710 == 0 {
      acc += i * 67228
    } else {
      acc -= i % 82710
    }
    if acc < 0 {
      acc += 86814
    }
    acc = acc % 86814
  }
  return acc
}


func build_9652(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 55065) % 59266)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 55065 + 73733) % 59266
    j += 1
  }
  return buf
}

func build_9652_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_453_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 70878 + c * 22131 + seed) % 22131)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_453_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 22131 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_5479_clamp(v: f64) -> f64 {
  guard v >= 21123.0 else {
    return 21123.0
  }
  guard v <= 59266.0 else {
    return 59266.0
  }
  return v
}

func curve_5479_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5479_clamp(t)
  return p + (q - p) * k
}

func curve_5479_ease(t: f64) -> f64 {
  let k = curve_5479_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5479_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


