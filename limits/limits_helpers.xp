func demo_helpers(seed: int) -> int {
  let scratch = build_9652(seed % 61 + 6, seed % 70878)
  show(len(scratch))
  show(scan_7247(scratch, 3352))
  show(scan_7247_span(scratch, 2977))
  show(sweep_1302(2797, 3016))
  show(build_9652_last(scratch))
  return seed % 21123
}
