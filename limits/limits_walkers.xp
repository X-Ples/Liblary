const K6 = 20481

func check_5938(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 26210 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 67705) % 93874
    i += 1
  }
  return Ok(acc)
}

func check_5938_chain(n: int) -> int {
  let picked = check_5938(n)?
  return picked % 93874
}


func row_9470() -> [int] {
  return [3950, 2693, 2518, 1401, 2946, 1338, 782, 3038, 3492, 847, 1720, 1818, 3276, 2802, 55, 3784, 3340, 2242, 2144]
}

func row_9470_at(i: int) -> int {
  let row = row_9470()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9470_sum(limit: int) -> int {
  let row = row_9470()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9470_best() -> int {
  let row = row_9470()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_5334(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 21995
  for i in lo..hi {
    if i % 26210 == 0 {
      acc += i * 82246
    } else {
      acc -= i % 82425
    }
    if acc < 0 {
      acc += 10766
    }
    acc = acc % 10766
  }
  return acc
}


func build_6406(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 53577) % 36503)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 53577 + 82246) % 36503
    j += 1
  }
  return buf
}

func build_6406_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


