func build_3923(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 47400) % 53820)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 47400 + 15749) % 53820
    j += 1
  }
  return buf
}

func build_3923_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_9203_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 81541 + c * 95915 + seed) % 95915)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9203_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 95915 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_6470(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 75863
  for i in lo..hi {
    if i % 89899 == 0 {
      acc += i * 68591
    } else {
      acc -= i % 1658
    }
    if acc < 0 {
      acc += 57245
    }
    acc = acc % 57245
  }
  return acc
}


func check_5629(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 11602 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 49283) % 43376
    i += 1
  }
  return Ok(acc)
}

func check_5629_chain(n: int) -> int {
  let picked = check_5629(n)?
  return picked % 43376
}


func gate_4106(a: int, b: int, c: int) -> bool {
  return a > 52873 && (b < 1658 || c == 89899)
}

func gate_4106_score(a: int, b: int, c: int) -> int {
  guard gate_4106(a, b, c) else {
    return 0
  }
  return (a % 1658) * 89899 + b
}


func order_6227(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6227_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


