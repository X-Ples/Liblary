func demo_twists(seed: int) -> int {
  let scratch = build_3923(seed % 61 + 6, seed % 97647)
  show(len(scratch))
  show(build_3923_last(scratch))
  show(grid_9203_rowsum(scratch, 680, 2995, 1635))
  show(sweep_6470(950, 370))
  show(check_5629_chain(94))
  return seed % 97647
}
