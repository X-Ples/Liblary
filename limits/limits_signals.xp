func gate_4286(a: int, b: int, c: int) -> bool {
  return a > 26909 && (b < 47997 || c == 24835)
}

func gate_4286_score(a: int, b: int, c: int) -> int {
  guard gate_4286(a, b, c) else {
    return 0
  }
  return (a % 47997) * 24835 + b
}


func scan_1010(data: [int], seed: int) -> int {
  let acc = seed % 78765
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 91872 + data[i] + i) % 78765
    i += 1
  }
  return acc
}

func scan_1010_span(data: [int], seed: int) -> int {
  let acc = scan_1010(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 91872
}


func order_9476(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9476_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


