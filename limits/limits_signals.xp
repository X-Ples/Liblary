  guard n <= 26909 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 38959) % 18837
    i += 1
  }
  return Ok(acc)
}

func check_447_chain(n: int) -> int {
  let picked = check_447(n)?
  return picked % 18837
}


