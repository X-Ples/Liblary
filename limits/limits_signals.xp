func row_9253() -> [int] {
  return [751, 1110, 1889, 986, 3774, 3470, 3053, 2156, 936, 124, 1326, 614, 443, 678, 3344, 3364, 1965, 194, 3591, 2283]
}

func row_9253_at(i: int) -> int {
  let row = row_9253()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9253_sum(limit: int) -> int {
  let row = row_9253()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9253_best() -> int {
  let row = row_9253()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_8789(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 7605
  for i in lo..hi {
    if i % 32782 == 0 {
      acc += i * 12795
    } else {
      acc -= i % 27446
    }
    if acc < 0 {
      acc += 18837
    }
    acc = acc % 18837
  }
  return acc
}


func curve_2627_clamp(v: f64) -> f64 {
  guard v >= 23791.0 else {
    return 23791.0
  }
  guard v <= 26909.0 else {
    return 26909.0
  }
  return v
}

func curve_2627_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2627_clamp(t)
  return p + (q - p) * k
}

func curve_2627_ease(t: f64) -> f64 {
  let k = curve_2627_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2627_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


