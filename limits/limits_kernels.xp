func demo_kernels(seed: int) -> int {
  let scratch = build_3050(seed % 61 + 6, seed % 33528)
  show(len(scratch))
  show(build_3050_last(scratch))
  show(scan_438(scratch, 2976))
  show(scan_438_span(scratch, 2731))
  show(gate_9766(3876, 575, 1731))
  show(gate_9766_score(620, 1958, 2463))
  return seed % 10135
}
