func sweep_6239(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 29258
  for i in lo..hi {
    if i % 47453 == 0 {
      acc += i * 50250
    } else {
      acc -= i % 17889
    }
    if acc < 0 {
      acc += 57582
    }
    acc = acc % 57582
  }
  return acc
}


