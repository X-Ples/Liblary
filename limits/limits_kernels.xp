func build_3050(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 96558) % 33528)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 96558 + 19193) % 33528
    j += 1
  }
  return buf
}

func build_3050_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_438(data: [int], seed: int) -> int {
  let acc = seed % 19193
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 39030 + data[i] + i) % 19193
    i += 1
  }
  return acc
}

func scan_438_span(data: [int], seed: int) -> int {
  let acc = scan_438(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 39030
}


func gate_9766(a: int, b: int, c: int) -> bool {
  return a > 87328 && (b < 47453 || c == 86460)
}

func gate_9766_score(a: int, b: int, c: int) -> int {
  guard gate_9766(a, b, c) else {
    return 0
  }
  return (a % 47453) * 86460 + b
}


func curve_1895_clamp(v: f64) -> f64 {
  guard v >= 19193.0 else {
    return 19193.0
  }
  guard v <= 47260.0 else {
    return 47260.0
  }
  return v
}

func curve_1895_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1895_clamp(t)
  return p + (q - p) * k
}

func curve_1895_ease(t: f64) -> f64 {
  let k = curve_1895_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1895_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


