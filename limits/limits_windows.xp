func check_8346(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 14007 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 88678) % 37967
    i += 1
  }
  return Ok(acc)
}

func check_8346_chain(n: int) -> int {
