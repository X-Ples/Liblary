func sweep_9287(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 38013
  for i in lo..hi {
    if i % 88678 == 0 {
      acc += i * 90854
    } else {
      acc -= i % 92058
    }
    if acc < 0 {
      acc += 53734
    }
    acc = acc % 53734
  }
  return acc
}


