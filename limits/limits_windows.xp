func gate_149(a: int, b: int, c: int) -> bool {
  return a > 38013 && (b < 39787 || c == 29170)
}

func gate_149_score(a: int, b: int, c: int) -> int {
  guard gate_149(a, b, c) else {
    return 0
  }
  return (a % 39787) * 29170 + b
}


