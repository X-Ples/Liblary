func demo_windows(seed: int) -> int {
  let scratch = build_952(seed % 61 + 6, seed % 53734)
  show(len(scratch))
  show(build_952_last(scratch))
  show(gate_149(3202, 612, 495))
  show(gate_149_score(312, 2114, 2104))
  return seed % 95614
}
