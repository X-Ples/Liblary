func sweep_9705(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 63083
  for i in lo..hi {
    if i % 3479 == 0 {
      acc += i * 3479
    } else {
      acc -= i % 25286
    }
    if acc < 0 {
      acc += 81128
    }
    acc = acc % 81128
  }
  return acc
}


