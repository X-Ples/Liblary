func demo_ratchets(seed: int) -> int {
  let scratch = build_5976(seed % 61 + 6, seed % 99015)
  show(len(scratch))
  show(build_5976_last(scratch))
  show(text_8357_weight("gamma"))
  show(text_8357_label(3748))
  show(text_8357_has("delta"))
  show(gate_7192(870, 2048, 2796))
  return seed % 87975
}
