func build_5976(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 84816) % 17811)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 84816 + 11186) % 17811
    j += 1
  }
  return buf
}

func build_5976_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_740_clamp(v: f64) -> f64 {
  guard v >= 33293.0 else {
    return 33293.0
  }
  guard v <= 78410.0 else {
    return 78410.0
  }
  return v
}

func curve_740_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_740_clamp(t)
  return p + (q - p) * k
}

func curve_740_ease(t: f64) -> f64 {
  let k = curve_740_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_740_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_8357_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 84816
    i += 1
  }
  return acc % 84816
}

func text_8357_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "jetty"
}

func text_8357_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 78410
}


