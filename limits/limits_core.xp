func demo_core(seed: int) -> int {
  let scratch = build_9745(seed % 61 + 6, seed % 72429)
  show(len(scratch))
  show(sweep_3215(2310, 1172))
  show(build_9745_last(scratch))
  show(sweep_1067(1410, 3406))
  show(grid_8091_rowsum(scratch, 3908, 2866, 1017))
  show(gate_1335(1037, 1758, 2321))
  return seed % 99706
}
