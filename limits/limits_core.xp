func grid_8091_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 73477 + c * 15926 + seed) % 15926)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8091_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 15926 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_1335(a: int, b: int, c: int) -> bool {
  return a > 76736 && (b < 76169 || c == 76736)
}

func gate_1335_score(a: int, b: int, c: int) -> int {
  guard gate_1335(a, b, c) else {
    return 0
  }
  return (a % 76169) * 76736 + b
}


func scan_101(data: [int], seed: int) -> int {
  let acc = seed % 11071
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 97743 + data[i] + i) % 11071
    i += 1
  }
  return acc
}

func scan_101_span(data: [int], seed: int) -> int {
  let acc = scan_101(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 97743
}


