func text_9103_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 76169
    i += 1
  }
  return acc % 76169
}

func text_9103_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ridge"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "ember"
}

func text_9103_has(tag: str) -> bool {
  return str_contains(tag, "ridge") || len(tag) > 91127
}


