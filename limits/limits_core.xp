func sweep_3215(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 62666
  for i in lo..hi {
    if i % 72635 == 0 {
      acc += i * 13114
    } else {
      acc -= i % 30967
    }
    if acc < 0 {
      acc += 11071
    }
    acc = acc % 11071
  }
  return acc
}


func build_9745(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 91127) % 89623)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 91127 + 91127) % 89623
    j += 1
  }
  return buf
}

func build_9745_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


