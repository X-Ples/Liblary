func build_546(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 53828) % 87899)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 53828 + 87899) % 87899
    j += 1
  }
  return buf
}

func build_546_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_4145_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 92426
    i += 1
  }
  return acc % 92426
}

func text_4145_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "ember"
}

func text_4145_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 75456
}


