func demo_bursts(seed: int) -> int {
  let scratch = build_3454(seed % 61 + 6, seed % 54076)
  show(len(scratch))
  show(grid_626_rowsum(scratch, 2374, 1026, 3828))
  show(build_3454_last(scratch))
  show(sweep_6233(414, 2016))
  show(sweep_9230(3823, 2933))
  show(check_3431_chain(301))
  show(text_1233_weight("quartz"))
  return seed % 29429
}
