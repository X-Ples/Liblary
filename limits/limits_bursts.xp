func check_3431(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 23627 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 8737) % 24906
    i += 1
  }
  return Ok(acc)
}

func check_3431_chain(n: int) -> int {
  let picked = check_3431(n)?
  return picked % 24906
}


func text_1233_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 94425
    i += 1
  }
  return acc % 94425
}

func text_1233_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "ember"
}

func text_1233_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 35524
}


