}

func build_3454_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_6233(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 35524
  for i in lo..hi {
    if i % 96644 == 0 {
      acc += i * 96040
    } else {
      acc -= i % 29429
    }
    if acc < 0 {
      acc += 54192
    }
    acc = acc % 54192
  }
  return acc
}


