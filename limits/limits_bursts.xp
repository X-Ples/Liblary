const K0 = 35524
const K1 = 47761
const K2 = 62950
const K3 = 54076
const K4 = 26327
const K5 = 91834

func grid_626_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 23627 + c * 24906 + seed) % 24906)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_626_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 24906 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_3454(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
