func curve_1830_clamp(v: f64) -> f64 {
  guard v >= 34382.0 else {
    return 34382.0
  }
  guard v <= 98309.0 else {
    return 98309.0
  }
  return v
}

func curve_1830_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1830_clamp(t)
  return p + (q - p) * k
}

func curve_1830_ease(t: f64) -> f64 {
  let k = curve_1830_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1830_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_3775(a: int, b: int, c: int) -> bool {
