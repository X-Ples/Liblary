func demo_counters(seed: int) -> int {
  let scratch = build_2160(seed % 61 + 6, seed % 15979)
  show(len(scratch))
  show(build_2160_last(scratch))
  show(text_5745_weight("flint"))
  show(text_5745_label(2217))
  return seed % 18475
}
