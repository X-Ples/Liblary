func build_2160(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 84064) % 34538)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 84064 + 39321) % 34538
    j += 1
  }
  return buf
}

func build_2160_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_5745_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 45553
    i += 1
  }
  return acc % 45553
}

func text_5745_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "gamma"
}

func text_5745_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 26226
}


func scan_6123(data: [int], seed: int) -> int {
  let acc = seed % 30800
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 39321 + data[i] + i) % 30800
    i += 1
  }
  return acc
}

func scan_6123_span(data: [int], seed: int) -> int {
  let acc = scan_6123(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 39321
}


func check_7336(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 18475 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 34538) % 4912
    i += 1
  }
  return Ok(acc)
}

func check_7336_chain(n: int) -> int {
  let picked = check_7336(n)?
  return picked % 4912
}


