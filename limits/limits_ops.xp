    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 28321 + 52128) % 92725
    j += 1
  }
  return buf
}

func build_3761_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


