func build_4472(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 96582) % 24217)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 96582 + 46857) % 24217
    j += 1
  }
  return buf
}

func build_4472_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_4344() -> [int] {
  return [2396, 2997, 930, 921, 3833, 1527, 3360, 352, 2620, 1096, 119, 3509, 175, 1217, 4026, 3775, 2422, 1306]
}

func row_4344_at(i: int) -> int {
  let row = row_4344()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4344_sum(limit: int) -> int {
  let row = row_4344()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4344_best() -> int {
  let row = row_4344()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_3443(data: [int], seed: int) -> int {
  let acc = seed % 93101
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 26259 + data[i] + i) % 93101
    i += 1
  }
  return acc
}

func scan_3443_span(data: [int], seed: int) -> int {
  let acc = scan_3443(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 26259
}


func text_8432_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 60775
    i += 1
  }
  return acc % 60775
}

func text_8432_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "quartz"
}

func text_8432_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 27923
}


func grid_9098_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 37249 + c * 26259 + seed) % 26259)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9098_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 26259 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func order_204(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_204_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


