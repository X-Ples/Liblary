func check_9549(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 95928 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 30588) % 60775
    i += 1
  }
  return Ok(acc)
}

func check_9549_chain(n: int) -> int {
  let picked = check_9549(n)?
  return picked % 60775
}


