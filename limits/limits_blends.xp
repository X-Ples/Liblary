func demo_blends(seed: int) -> int {
  let scratch = build_2939(seed % 61 + 6, seed % 49206)
  show(len(scratch))
  show(grid_7012_rowsum(scratch, 117, 89, 1697))
  show(build_2939_last(scratch))
  show(row_5371_at(2288))
  show(row_5371_sum(458))
  show(row_5371_best())
  show(text_4567_weight("cargo"))
  return seed % 33601
}
