func text_4567_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 49206
    i += 1
  }
  return acc % 49206
}

func text_4567_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "bravo"
  }
  return "cargo"
}

func text_4567_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 15738
}


func curve_6297_clamp(v: f64) -> f64 {
  guard v >= 15738.0 else {
    return 15738.0
  }
  guard v <= 49206.0 else {
    return 49206.0
  }
  return v
}

func curve_6297_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6297_clamp(t)
  return p + (q - p) * k
}

func curve_6297_ease(t: f64) -> f64 {
  let k = curve_6297_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6297_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


