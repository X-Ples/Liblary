func scan_487(data: [int], seed: int) -> int {
  let acc = seed % 46542
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 73303 + data[i] + i) % 46542
    i += 1
  }
  return acc
}

func scan_487_span(data: [int], seed: int) -> int {
  let acc = scan_487(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 73303
}


func order_6323(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6323_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_4975(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 60188
  for i in lo..hi {
    if i % 42291 == 0 {
      acc += i * 35029
    } else {
      acc -= i % 41329
    }
    if acc < 0 {
      acc += 27204
    }
    acc = acc % 27204
  }
  return acc
}


func check_2474(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 21723 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 67003) % 68310
    i += 1
  }
  return Ok(acc)
}

func check_2474_chain(n: int) -> int {
  let picked = check_2474(n)?
  return picked % 68310
}


