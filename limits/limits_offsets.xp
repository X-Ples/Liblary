func build_6060(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 61908) % 26669)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 61908 + 26450) % 26669
    j += 1
  }
  return buf
}

func build_6060_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


