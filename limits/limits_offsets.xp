func demo_offsets(seed: int) -> int {
  let scratch = build_6060(seed % 61 + 6, seed % 7050)
  show(len(scratch))
  show(build_6060_last(scratch))
  show(gate_5669(2575, 1740, 1357))
  show(gate_5669_score(3003, 3405, 615))
  show(gate_2161(917, 2886, 3231))
  return seed % 63558
