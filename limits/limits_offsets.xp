func sweep_506(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 38634
  for i in lo..hi {
    if i % 32713 == 0 {
      acc += i * 90781
    } else {
      acc -= i % 26450
    }
    if acc < 0 {
      acc += 11717
    }
    acc = acc % 11717
  }
  return acc
}


func row_9777() -> [int] {
