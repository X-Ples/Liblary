func row_9408() -> [int] {
  return [1511, 2330, 1811, 1339, 3262, 2760, 3749, 2836, 802, 487, 2835, 3147, 4078, 3564, 275, 2806, 41, 756]
}

func row_9408_at(i: int) -> int {
  let row = row_9408()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9408_sum(limit: int) -> int {
  let row = row_9408()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9408_best() -> int {
  let row = row_9408()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


