  while i < count {
    array_push(buf, (start + i * 54065) % 66787)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 54065 + 13499) % 66787
    j += 1
  }
  return buf
}

func build_7047_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_9227_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
