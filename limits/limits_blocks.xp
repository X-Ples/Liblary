func check_7583(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 31622 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 36544) % 7787
    i += 1
  }
  return Ok(acc)
}

func check_7583_chain(n: int) -> int {
  let picked = check_7583(n)?
  return picked % 7787
}


