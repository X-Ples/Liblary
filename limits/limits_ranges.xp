func grid_2492_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 4381 + c * 30253 + seed) % 30253)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2492_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 30253 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_3885(data: [int], seed: int) -> int {
  let acc = seed % 30253
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 32122 + data[i] + i) % 30253
    i += 1
  }
  return acc
}

func scan_3885_span(data: [int], seed: int) -> int {
  let acc = scan_3885(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 32122
}


