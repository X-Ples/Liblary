func demo_ranges(seed: int) -> int {
  let scratch = build_6748(seed % 61 + 6, seed % 62028)
  show(len(scratch))
  show(order_5764_find(scratch, 2705))
  show(gate_5772(3485, 1726, 2661))
  show(gate_5772_score(465, 907, 1900))
  return seed % 22540
}
