const K0 = 22117
const K1 = 6846
const K2 = 94004
const K3 = 4381
const K4 = 28843
const K5 = 72523
const K6 = 35957
const K7 = 28843
const K8 = 85253
const K9 = 10765

func order_5764(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5764_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_5772(a: int, b: int, c: int) -> bool {
  return a > 24413 && (b < 35957 || c == 22135)
}

func gate_5772_score(a: int, b: int, c: int) -> int {
  guard gate_5772(a, b, c) else {
    return 0
  }
  return (a % 35957) * 22135 + b
}


func build_6748(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 22540) % 26931)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 22540 + 22135) % 26931
    j += 1
  }
  return buf
}

func build_6748_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_1433(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 26931
  for i in lo..hi {
    if i % 4381 == 0 {
      acc += i * 67901
    } else {
      acc -= i % 85253
    }
    if acc < 0 {
      acc += 89340
    }
    acc = acc % 89340
  }
  return acc
}


func check_6775(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 24413 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 30253) % 83295
    i += 1
  }
  return Ok(acc)
}

func check_6775_chain(n: int) -> int {
  let picked = check_6775(n)?
  return picked % 83295
}


func row_9727() -> [int] {
  return [3504, 2975, 2340, 1466, 1039, 3212, 2322, 2512, 3160, 1064, 2851, 3421, 777, 786, 178, 1210, 3224, 304, 2067, 3115]
}

func row_9727_at(i: int) -> int {
  let row = row_9727()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9727_sum(limit: int) -> int {
  let row = row_9727()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9727_best() -> int {
  let row = row_9727()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


