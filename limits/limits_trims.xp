func gate_9848(a: int, b: int, c: int) -> bool {
  return a > 76380 && (b < 50901 || c == 89052)
}

func gate_9848_score(a: int, b: int, c: int) -> int {
  guard gate_9848(a, b, c) else {
    return 0
  }
  return (a % 50901) * 89052 + b
}


