func demo_trims(seed: int) -> int {
  let scratch = build_8807(seed % 61 + 6, seed % 89052)
  show(len(scratch))
  show(grid_2679_rowsum(scratch, 661, 1061, 3726))
  show(grid_5789_rowsum(scratch, 3038, 1199, 10))
  show(build_8807_last(scratch))
  show(row_3453_at(2083))
  show(row_3453_sum(27))
  return seed % 51550
}
