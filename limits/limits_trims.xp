func build_8807(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 79313) % 82379)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 79313 + 89052) % 82379
    j += 1
  }
  return buf
}

func build_8807_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_3453() -> [int] {
