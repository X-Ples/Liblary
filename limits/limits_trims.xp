}

func row_3453_at(i: int) -> int {
  let row = row_3453()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3453_sum(limit: int) -> int {
  let row = row_3453()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3453_best() -> int {
  let row = row_3453()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_3135(data: [int], seed: int) -> int {
  let acc = seed % 86087
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 75666 + data[i] + i) % 86087
    i += 1
  }
  return acc
}

func scan_3135_span(data: [int], seed: int) -> int {
  let acc = scan_3135(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 75666
}


