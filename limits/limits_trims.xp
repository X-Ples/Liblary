func curve_5136_clamp(v: f64) -> f64 {
  guard v >= 51550.0 else {
    return 51550.0
  }
  guard v <= 86087.0 else {
    return 86087.0
  }
  return v
}

func curve_5136_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5136_clamp(t)
  return p + (q - p) * k
}

func curve_5136_ease(t: f64) -> f64 {
  let k = curve_5136_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5136_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_1095(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 51550
  for i in lo..hi {
    if i % 9838 == 0 {
      acc += i * 59270
    } else {
      acc -= i % 83918
    }
    if acc < 0 {
      acc += 63008
    }
    acc = acc % 63008
  }
  return acc
}


