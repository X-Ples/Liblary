func sweep_3788(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 85001
  for i in lo..hi {
    if i % 36077 == 0 {
      acc += i * 31273
    } else {
      acc -= i % 57698
    }
    if acc < 0 {
      acc += 84300
    }
    acc = acc % 84300
  }
  return acc
}


func build_5952(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 64546) % 57698)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 64546 + 32836) % 57698
    j += 1
  }
  return buf
}

func build_5952_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


