func build_5124(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 5778) % 46199)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 5778 + 33491) % 46199
    j += 1
  }
  return buf
}

func build_5124_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_1850(a: int, b: int, c: int) -> bool {
