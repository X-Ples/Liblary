func gate_1850_score(a: int, b: int, c: int) -> int {
  guard gate_1850(a, b, c) else {
    return 0
  }
  return (a % 40929) * 68506 + b
}


func check_8106(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 40489 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 42784) % 34357
    i += 1
  }
  return Ok(acc)
}

func check_8106_chain(n: int) -> int {
  let picked = check_8106(n)?
  return picked % 34357
}


