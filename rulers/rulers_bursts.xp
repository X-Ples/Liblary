func build_6674(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 90206) % 35863)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 90206 + 40878) % 35863
    j += 1
  }
  return buf
}

func build_6674_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_9742(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 71758
  for i in lo..hi {
    if i % 81432 == 0 {
      acc += i * 22280
    } else {
      acc -= i % 48650
    }
    if acc < 0 {
      acc += 63545
    }
    acc = acc % 63545
  }
  return acc
}


func scan_5775(data: [int], seed: int) -> int {
  let acc = seed % 30147
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 44998 + data[i] + i) % 30147
    i += 1
  }
  return acc
}

func scan_5775_span(data: [int], seed: int) -> int {
  let acc = scan_5775(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 44998
}


func text_5952_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 54921
    i += 1
  }
  return acc % 54921
}

func text_5952_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "quartz"
}

func text_5952_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 25500
}


