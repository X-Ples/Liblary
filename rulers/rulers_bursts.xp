func demo_bursts(seed: int) -> int {
  let scratch = build_6674(seed % 61 + 6, seed % 40878)
  show(len(scratch))
  show(build_6674_last(scratch))
  show(sweep_9742(10, 1599))
  show(scan_5775(scratch, 1080))
  show(scan_5775_span(scratch, 151))
  show(text_5952_weight("mesa"))
  return seed % 35863
}
