func check_2589(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 96679 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 13950) % 29244
    i += 1
  }
  return Ok(acc)
}

func check_2589_chain(n: int) -> int {
  let picked = check_2589(n)?
  return picked % 29244
}


