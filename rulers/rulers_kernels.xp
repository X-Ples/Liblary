func check_7621(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 3091 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 45137) % 45137
    i += 1
  }
  return Ok(acc)
}

func check_7621_chain(n: int) -> int {
  let picked = check_7621(n)?
  return picked % 45137
}


func build_7976(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 99230) % 99230)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 99230 + 47629) % 99230
    j += 1
  }
  return buf
}

func build_7976_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_6865_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 18367 + c * 47629 + seed) % 47629)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6865_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 47629 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_644_clamp(v: f64) -> f64 {
  guard v >= 1051.0 else {
    return 1051.0
  }
  guard v <= 62612.0 else {
    return 62612.0
  }
  return v
}

func curve_644_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_644_clamp(t)
  return p + (q - p) * k
}

func curve_644_ease(t: f64) -> f64 {
  let k = curve_644_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_644_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


