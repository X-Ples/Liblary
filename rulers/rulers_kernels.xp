func demo_kernels(seed: int) -> int {
  let scratch = build_7976(seed % 61 + 6, seed % 56639)
  show(len(scratch))
  show(check_7621_chain(755))
  show(build_7976_last(scratch))
  show(grid_6865_rowsum(scratch, 615, 1301, 483))
  show(build_1088_last(scratch))
  show(sweep_4580(1365, 1262))
  return seed % 91777
}
