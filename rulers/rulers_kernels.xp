func sweep_4580(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 32737
  for i in lo..hi {
    if i % 8453 == 0 {
      acc += i * 1405
    } else {
      acc -= i % 1405
    }
    if acc < 0 {
      acc += 3091
    }
    acc = acc % 3091
  }
  return acc
}


