  }
  return (a % 57777) * 98444 + b
}


func curve_9419_clamp(v: f64) -> f64 {
  guard v >= 39208.0 else {
    return 39208.0
  }
  guard v <= 41777.0 else {
    return 41777.0
  }
  return v
}

func curve_9419_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9419_clamp(t)
  return p + (q - p) * k
}

func curve_9419_ease(t: f64) -> f64 {
  let k = curve_9419_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9419_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


