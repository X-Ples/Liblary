func sweep_309(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 73197
  for i in lo..hi {
    if i % 91730 == 0 {
      acc += i * 68337
    } else {
      acc -= i % 86817
    }
    if acc < 0 {
      acc += 57777
    }
    acc = acc % 57777
  }
  return acc
}


func sweep_8232(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 39208
  for i in lo..hi {
    if i % 14449 == 0 {
      acc += i * 73611
    } else {
      acc -= i % 91821
    }
    if acc < 0 {
      acc += 64028
    }
    acc = acc % 64028
  }
  return acc
}


func demo_windows(seed: int) -> int {
  let scratch = build_3138(seed % 61 + 6, seed % 62293)
  show(len(scratch))
  show(build_3138_last(scratch))
  show(row_2513_at(3551))
  show(row_2513_sum(2405))
  show(row_2513_best())
  return seed % 18536
}
