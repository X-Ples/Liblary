func row_2513_at(i: int) -> int {
  let row = row_2513()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2513_sum(limit: int) -> int {
  let row = row_2513()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2513_best() -> int {
  let row = row_2513()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_4210(data: [int], seed: int) -> int {
  let acc = seed % 73197
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 62293 + data[i] + i) % 73197
    i += 1
  }
  return acc
}

func scan_4210_span(data: [int], seed: int) -> int {
  let acc = scan_4210(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 62293
}


func check_2622(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 35828 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 73197) % 4535
    i += 1
  }
  return Ok(acc)
}

func check_2622_chain(n: int) -> int {
  let picked = check_2622(n)?
  return picked % 4535
}


