func row_1358() -> [int] {
  return [3182, 2250, 2743, 2909, 200, 1831, 2777, 747, 3878, 3859, 1466, 2495, 3413, 2231, 1501, 1439, 3698, 472, 3015, 3321, 1351]
}

func row_1358_at(i: int) -> int {
  let row = row_1358()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1358_sum(limit: int) -> int {
  let row = row_1358()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1358_best() -> int {
  let row = row_1358()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


