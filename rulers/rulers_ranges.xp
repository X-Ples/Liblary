}


func scan_6189(data: [int], seed: int) -> int {
  let acc = seed % 23763
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 64683 + data[i] + i) % 23763
    i += 1
  }
  return acc
}

func scan_6189_span(data: [int], seed: int) -> int {
  let acc = scan_6189(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 64683
}


