}


func sweep_8888(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 87439
  for i in lo..hi {
    if i % 23763 == 0 {
      acc += i * 67666
    } else {
      acc -= i % 67666
    }
    if acc < 0 {
      acc += 26556
    }
    acc = acc % 26556
  }
  return acc
}


