func gate_4614_score(a: int, b: int, c: int) -> int {
  guard gate_4614(a, b, c) else {
    return 0
  }
  return (a % 16365) * 31184 + b
}


func curve_189_clamp(v: f64) -> f64 {
  guard v >= 19863.0 else {
    return 19863.0
  }
  guard v <= 33558.0 else {
    return 33558.0
  }
  return v
}

func curve_189_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_189_clamp(t)
  return p + (q - p) * k
}

func curve_189_ease(t: f64) -> f64 {
  let k = curve_189_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_189_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


