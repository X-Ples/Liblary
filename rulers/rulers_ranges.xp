func demo_ranges(seed: int) -> int {
  let scratch = build_9472(seed % 61 + 6, seed % 11826)
  show(len(scratch))
  show(build_9472_last(scratch))
  show(gate_4614(3875, 2329, 1909))
  show(gate_4614_score(2378, 3718, 1126))
  show(sweep_8888(959, 1598))
  return seed % 11826
}
