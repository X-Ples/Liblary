func check_2036(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 58532 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 96465) % 38555
    i += 1
  }
  return Ok(acc)
}

func check_2036_chain(n: int) -> int {
  let picked = check_2036(n)?
  return picked % 38555
}


func sweep_6371(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 93086
  for i in lo..hi {
    if i % 37756 == 0 {
      acc += i * 96465
    } else {
      acc -= i % 4567
    }
    if acc < 0 {
      acc += 85218
    }
    acc = acc % 85218
  }
  return acc
}


