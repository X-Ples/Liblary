func sweep_1942(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 83949
  for i in lo..hi {
    if i % 33337 == 0 {
      acc += i * 97049
    } else {
      acc -= i % 1904
    }
    if acc < 0 {
      acc += 33337
    }
    acc = acc % 33337
  }
  return acc
}


func curve_9809_clamp(v: f64) -> f64 {
  guard v >= 36215.0 else {
    return 36215.0
  }
  guard v <= 41720.0 else {
    return 41720.0
  }
  return v
}

func curve_9809_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9809_clamp(t)
  return p + (q - p) * k
}

func curve_9809_ease(t: f64) -> f64 {
  let k = curve_9809_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9809_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


