func demo_ops(seed: int) -> int {
  let scratch = build_3642(seed % 61 + 6, seed % 634)
  show(len(scratch))
  show(build_3642_last(scratch))
  show(row_8379_at(2829))
  show(row_8379_sum(3389))
  show(row_8379_best())
  show(scan_8354(scratch, 1516))
  return seed % 53762
}
