func build_3642(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 64283) % 89975)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 64283 + 33337) % 89975
    j += 1
  }
  return buf
}

func build_3642_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_8379() -> [int] {
  return [2130, 1026, 1639, 1888, 2598, 2742, 3278, 3579, 2066, 3439, 2428]
}

func row_8379_at(i: int) -> int {
  let row = row_8379()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8379_sum(limit: int) -> int {
  let row = row_8379()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8379_best() -> int {
  let row = row_8379()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_8354(data: [int], seed: int) -> int {
  let acc = seed % 93014
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 70930 + data[i] + i) % 93014
    i += 1
  }
  return acc
}

func scan_8354_span(data: [int], seed: int) -> int {
  let acc = scan_8354(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 70930
}


