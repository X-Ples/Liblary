func gate_1024(a: int, b: int, c: int) -> bool {
  return a > 83365 && (b < 77004 || c == 23258)
}

func gate_1024_score(a: int, b: int, c: int) -> int {
  guard gate_1024(a, b, c) else {
    return 0
  }
  return (a % 77004) * 23258 + b
}


func order_1697(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1697_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func demo_vectors2(seed: int) -> int {
  let scratch = build_2305(seed % 61 + 6, seed % 83365)
  show(len(scratch))
  show(build_2305_last(scratch))
  show(row_7292_at(2131))
  show(row_7292_sum(2544))
  return seed % 33387
}
