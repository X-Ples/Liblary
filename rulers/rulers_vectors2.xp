func text_9317_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 11209
    i += 1
  }
  return acc % 11209
}

func text_9317_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "prism"
}

func text_9317_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 48467
}


