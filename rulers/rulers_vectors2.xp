func build_2305(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 59498) % 29129)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 59498 + 43812) % 29129
    j += 1
  }
  return buf
}

func build_2305_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_7292() -> [int] {
  return [1408, 2710, 841, 702, 14, 767, 3969, 2910, 1812, 600, 183, 1902, 1594, 3749, 3656, 3974, 3767, 3042, 3287]
}

func row_7292_at(i: int) -> int {
  let row = row_7292()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7292_sum(limit: int) -> int {
  let row = row_7292()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7292_best() -> int {
  let row = row_7292()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_3450_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 52734 + c * 19713 + seed) % 19713)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3450_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 19713 == want {
      total += acc
    }
    r += 1
  }
  return total
}


