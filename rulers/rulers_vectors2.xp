func sweep_9813(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 87867
  for i in lo..hi {
    if i % 77004 == 0 {
      acc += i * 47788
    } else {
      acc -= i % 79479
    }
    if acc < 0 {
      acc += 67808
    }
    acc = acc % 67808
  }
  return acc
}


