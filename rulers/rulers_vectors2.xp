func curve_9959_clamp(v: f64) -> f64 {
  guard v >= 33387.0 else {
    return 33387.0
  }
  guard v <= 94642.0 else {
    return 94642.0
  }
  return v
}

func curve_9959_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9959_clamp(t)
  return p + (q - p) * k
}

func curve_9959_ease(t: f64) -> f64 {
  let k = curve_9959_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9959_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_3454(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 67255 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 59498) % 43812
    i += 1
  }
  return Ok(acc)
}

func check_3454_chain(n: int) -> int {
  let picked = check_3454(n)?
  return picked % 43812
}


