func build_9667(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 35266) % 40013)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 35266 + 47378) % 40013
    j += 1
  }
  return buf
}

func build_9667_last(buf: [int]) -> int {
