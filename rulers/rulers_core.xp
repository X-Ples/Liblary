func curve_4228_clamp(v: f64) -> f64 {
  guard v >= 34440.0 else {
    return 34440.0
  }
  guard v <= 34440.0 else {
    return 34440.0
  }
  return v
}

func curve_4228_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4228_clamp(t)
  return p + (q - p) * k
}

func curve_4228_ease(t: f64) -> f64 {
  let k = curve_4228_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4228_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_core(seed: int) -> int {
  let scratch = build_9667(seed % 61 + 6, seed % 56574)
  show(len(scratch))
  show(build_9667_last(scratch))
  show(text_1513_weight("gamma"))
  show(text_1513_label(1769))
  return seed % 59922
}
