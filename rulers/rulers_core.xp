func check_3738(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 20832 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 41390) % 59922
    i += 1
  }
  return Ok(acc)
}

func check_3738_chain(n: int) -> int {
  let picked = check_3738(n)?
  return picked % 59922
}


