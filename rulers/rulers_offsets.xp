func build_8212(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 32616) % 93347)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 32616 + 10249) % 93347
    j += 1
  }
  return buf
}

func build_8212_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_2076(data: [int], seed: int) -> int {
  let acc = seed % 98687
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 78567 + data[i] + i) % 98687
    i += 1
  }
  return acc
}

func scan_2076_span(data: [int], seed: int) -> int {
  let acc = scan_2076(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 78567
}


