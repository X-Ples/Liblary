func sweep_8818(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10249
  for i in lo..hi {
    if i % 67907 == 0 {
      acc += i * 89316
    } else {
      acc -= i % 60021
    }
    if acc < 0 {
      acc += 61630
    }
    acc = acc % 61630
  }
  return acc
}


