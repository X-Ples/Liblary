func sweep_2371(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 98560
  for i in lo..hi {
    if i % 47556 == 0 {
      acc += i * 65889
    } else {
      acc -= i % 63225
    }
    if acc < 0 {
      acc += 52582
    }
    acc = acc % 52582
  }
  return acc
}


func build_9459(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 34900) % 47556)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 34900 + 217) % 47556
    j += 1
  }
  return buf
}

func build_9459_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_9216(data: [int], seed: int) -> int {
  let acc = seed % 46340
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 63225 + data[i] + i) % 46340
    i += 1
  }
  return acc
}

func scan_9216_span(data: [int], seed: int) -> int {
  let acc = scan_9216(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 63225
}


