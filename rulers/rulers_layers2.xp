func gate_3527(a: int, b: int, c: int) -> bool {
  return a > 23056 && (b < 83413 || c == 63225)
}

func gate_3527_score(a: int, b: int, c: int) -> int {
  guard gate_3527(a, b, c) else {
    return 0
  }
  return (a % 83413) * 63225 + b
}


