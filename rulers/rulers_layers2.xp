func demo_layers2(seed: int) -> int {
  let scratch = build_9459(seed % 61 + 6, seed % 52582)
  show(len(scratch))
  show(sweep_2371(355, 301))
  show(build_9459_last(scratch))
  show(scan_9216(scratch, 1246))
  show(scan_9216_span(scratch, 2299))
  show(scan_3631(scratch, 1598))
  return seed % 21379
}
