func check_9492(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 42714 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 18826) % 76044
    i += 1
  }
  return Ok(acc)
}

func check_9492_chain(n: int) -> int {
  let picked = check_9492(n)?
  return picked % 76044
}


