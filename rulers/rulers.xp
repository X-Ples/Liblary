func scan_5823(data: [int], seed: int) -> int {
  let acc = seed % 52364
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 47447 + data[i] + i) % 52364
    i += 1
  }
  return acc
}

func scan_5823_span(data: [int], seed: int) -> int {
  let acc = scan_5823(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 47447
}


func curve_569_clamp(v: f64) -> f64 {
  guard v >= 18826.0 else {
    return 18826.0
  }
  guard v <= 66533.0 else {
    return 66533.0
  }
  return v
}

func curve_569_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_569_clamp(t)
  return p + (q - p) * k
}

func curve_569_ease(t: f64) -> f64 {
  let k = curve_569_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_569_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


