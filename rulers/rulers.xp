func build_5065(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 17713) % 42714)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 17713 + 69856) % 42714
    j += 1
  }
  return buf
}

func build_5065_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_2502(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 97294
  for i in lo..hi {
    if i % 54088 == 0 {
      acc += i * 33375
    } else {
      acc -= i % 23412
    }
    if acc < 0 {
      acc += 33375
    }
    acc = acc % 33375
  }
  return acc
}


func row_9947() -> [int] {
