func scan_5470(data: [int], seed: int) -> int {
  let acc = seed % 5706
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 81965 + data[i] + i) % 5706
    i += 1
  }
  return acc
}

func scan_5470_span(data: [int], seed: int) -> int {
  let acc = scan_5470(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 81965
}


