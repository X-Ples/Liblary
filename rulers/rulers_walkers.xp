  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 48559 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 16963) % 81355
    i += 1
  }
  return Ok(acc)
}

func check_7892_chain(n: int) -> int {
  let picked = check_7892(n)?
  return picked % 81355
}


