func gate_3751(a: int, b: int, c: int) -> bool {
  return a > 27871 && (b < 84861 || c == 33472)
}

func gate_3751_score(a: int, b: int, c: int) -> int {
  guard gate_3751(a, b, c) else {
    return 0
  }
  return (a % 84861) * 33472 + b
}


func gate_1788(a: int, b: int, c: int) -> bool {
  return a > 37214 && (b < 92753 || c == 57770)
}

func gate_1788_score(a: int, b: int, c: int) -> int {
  guard gate_1788(a, b, c) else {
    return 0
  }
  return (a % 92753) * 57770 + b
}


func sweep_1621(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 37121
  for i in lo..hi {
    if i % 88812 == 0 {
      acc += i * 37214
    } else {
      acc -= i % 46098
    }
    if acc < 0 {
      acc += 78481
    }
    acc = acc % 78481
  }
  return acc
}


func build_5296(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 96159) % 37121)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 96159 + 57770) % 37121
    j += 1
  }
  return buf
}

func build_5296_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_9501_clamp(v: f64) -> f64 {
  guard v >= 3792.0 else {
    return 3792.0
  }
  guard v <= 32959.0 else {
    return 32959.0
  }
  return v
}

func curve_9501_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9501_clamp(t)
  return p + (q - p) * k
}

func curve_9501_ease(t: f64) -> f64 {
  let k = curve_9501_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9501_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_4427(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4427_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


