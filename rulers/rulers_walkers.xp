func demo_walkers(seed: int) -> int {
  let scratch = build_5296(seed % 61 + 6, seed % 3792)
  show(len(scratch))
  show(gate_3751(2387, 2725, 3940))
  show(gate_3751_score(3896, 2117, 1028))
  show(gate_1788(1361, 291, 3342))
  show(gate_1788_score(2526, 522, 2983))
  show(sweep_1621(1086, 3700))
  return seed % 96523
}
