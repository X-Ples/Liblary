func grid_8102_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 99426 + c * 21980 + seed) % 21980)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8102_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 21980 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_1886_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 79849
    i += 1
  }
  return acc % 79849
}

func text_1886_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "omega"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "sigma"
}

func text_1886_has(tag: str) -> bool {
  return str_contains(tag, "omega") || len(tag) > 57313
}


func check_8168(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 78546 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 7379) % 25671
    i += 1
  }
  return Ok(acc)
}

func check_8168_chain(n: int) -> int {
  let picked = check_8168(n)?
  return picked % 25671
}


func sweep_2515(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 81360
  for i in lo..hi {
    if i % 90129 == 0 {
      acc += i * 76942
    } else {
      acc -= i % 57313
    }
    if acc < 0 {
      acc += 72763
    }
    acc = acc % 72763
  }
  return acc
}


func scan_1169(data: [int], seed: int) -> int {
  let acc = seed % 12087
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 81007 + data[i] + i) % 12087
    i += 1
  }
  return acc
}

func scan_1169_span(data: [int], seed: int) -> int {
  let acc = scan_1169(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 81007
}


func order_9092(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9092_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


