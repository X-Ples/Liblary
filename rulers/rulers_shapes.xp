func gate_836(a: int, b: int, c: int) -> bool {
  return a > 41026 && (b < 41026 || c == 49356)
}

func gate_836_score(a: int, b: int, c: int) -> int {
  guard gate_836(a, b, c) else {
    return 0
  }
  return (a % 41026) * 49356 + b
}


