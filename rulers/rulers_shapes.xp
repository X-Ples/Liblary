func demo_shapes(seed: int) -> int {
  let scratch = build_5893(seed % 61 + 6, seed % 64560)
  show(len(scratch))
  show(build_5893_last(scratch))
  show(build_1581_last(scratch))
  show(grid_8102_rowsum(scratch, 3741, 411, 3725))
  show(text_1886_weight("jetty"))
  return seed % 39170
}
