func row_3471() -> [int] {
  return [2261, 3068, 3465, 2837, 161, 163, 409, 2066, 1521, 140]
}

func row_3471_at(i: int) -> int {
  let row = row_3471()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3471_sum(limit: int) -> int {
  let row = row_3471()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3471_best() -> int {
  let row = row_3471()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_6519_clamp(v: f64) -> f64 {
  guard v >= 41026.0 else {
    return 41026.0
  }
  guard v <= 57313.0 else {
    return 57313.0
  }
  return v
}

func curve_6519_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6519_clamp(t)
  return p + (q - p) * k
}

func curve_6519_ease(t: f64) -> f64 {
  let k = curve_6519_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6519_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


