func demo_twists(seed: int) -> int {
  let scratch = build_8599(seed % 61 + 6, seed % 92385)
  show(len(scratch))
  show(build_8599_last(scratch))
  show(row_2767_at(3771))
  show(row_2767_sum(398))
  show(row_2767_best())
  show(scan_8957(scratch, 3016))
  show(scan_8957_span(scratch, 3595))
  return seed % 42599
}
