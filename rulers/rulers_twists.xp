  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 1360
    i += 1
  }
  return acc % 1360
}

func text_3218_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "quartz"
}

func text_3218_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 62797
}


