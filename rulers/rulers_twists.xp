func build_8599(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 96326) % 56449)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 96326 + 28589) % 56449
    j += 1
  }
  return buf
}

func build_8599_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_2767() -> [int] {
