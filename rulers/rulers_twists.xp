func check_8404(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 1245 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 49041) % 49041
    i += 1
  }
  return Ok(acc)
}

func check_8404_chain(n: int) -> int {
  let picked = check_8404(n)?
  return picked % 49041
}


