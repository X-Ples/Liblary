func sweep_9022(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 41891
  for i in lo..hi {
    if i % 60378 == 0 {
      acc += i * 92385
    } else {
      acc -= i % 61071
    }
    if acc < 0 {
      acc += 77801
    }
    acc = acc % 77801
  }
  return acc
}


