const K0 = 57433
const K1 = 41679
const K2 = 31856
const K3 = 75306
const K4 = 57451
const K5 = 20345

func order_9088(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9088_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_4656_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 55943
    i += 1
  }
  return acc % 55943
}

func text_4656_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "harbor"
}

func text_4656_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 41679
}


func build_498(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 67705) % 3583)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 67705 + 55943) % 3583
    j += 1
  }
  return buf
}

func build_498_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_180_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 72890 + c * 74808 + seed) % 74808)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_180_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 74808 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_3919(data: [int], seed: int) -> int {
  let acc = seed % 74808
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 57948 + data[i] + i) % 74808
    i += 1
  }
  return acc
}

func scan_3919_span(data: [int], seed: int) -> int {
  let acc = scan_3919(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 57948
}


func check_7851(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 57451 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 55943) % 18524
    i += 1
  }
  return Ok(acc)
}

func check_7851_chain(n: int) -> int {
  let picked = check_7851(n)?
  return picked % 18524
}


func curve_3910_clamp(v: f64) -> f64 {
  guard v >= 18524.0 else {
    return 18524.0
  }
  guard v <= 74808.0 else {
    return 74808.0
  }
  return v
}

func curve_3910_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3910_clamp(t)
  return p + (q - p) * k
}

func curve_3910_ease(t: f64) -> f64 {
  let k = curve_3910_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3910_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


