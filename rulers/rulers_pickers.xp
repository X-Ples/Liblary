func curve_251_clamp(v: f64) -> f64 {
  guard v >= 55943.0 else {
    return 55943.0
  }
  guard v <= 94067.0 else {
    return 94067.0
  }
  return v
}

func curve_251_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_251_clamp(t)
  return p + (q - p) * k
}

func curve_251_ease(t: f64) -> f64 {
  let k = curve_251_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_251_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_pickers(seed: int) -> int {
  let scratch = build_498(seed % 61 + 6, seed % 57948)
  show(len(scratch))
  show(order_9088_find(scratch, 3538))
  show(text_4656_weight("quartz"))
  show(text_4656_label(3230))
  show(text_4656_has("talus"))
  show(build_498_last(scratch))
  return seed % 81652
}
