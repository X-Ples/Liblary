func sweep_2629(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 63276
  for i in lo..hi {
    if i % 31856 == 0 {
      acc += i * 76356
    } else {
      acc -= i % 67705
    }
    if acc < 0 {
      acc += 67705
    }
    acc = acc % 67705
  }
  return acc
}


