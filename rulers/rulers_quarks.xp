func check_2552(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 61641 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 62514) % 73453
    i += 1
  }
  return Ok(acc)
}

func check_2552_chain(n: int) -> int {
  let picked = check_2552(n)?
  return picked % 73453
}


