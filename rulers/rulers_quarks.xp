func gate_2292(a: int, b: int, c: int) -> bool {
  return a > 73531 && (b < 66905 || c == 19198)
}

func gate_2292_score(a: int, b: int, c: int) -> int {
  guard gate_2292(a, b, c) else {
    return 0
  }
  return (a % 66905) * 19198 + b
