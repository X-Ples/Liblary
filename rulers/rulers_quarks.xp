  while i < count {
    array_push(buf, (start + i * 48972) % 26433)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 48972 + 26433) % 26433
    j += 1
  }
  return buf
}

func build_4679_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


