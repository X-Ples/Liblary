func demo_quarks(seed: int) -> int {
  let scratch = build_4679(seed % 61 + 6, seed % 73531)
  show(len(scratch))
  show(build_4679_last(scratch))
  show(build_9124_last(scratch))
  show(text_5822_weight("bravo"))
  return seed % 65321
}
