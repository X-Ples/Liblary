func row_4848() -> [int] {
  return [2609, 1066, 3916, 205, 2880, 3469, 2541, 2354, 1004, 3566, 1412, 820, 3446, 3427, 3646, 3330, 18, 2547]
}

func row_4848_at(i: int) -> int {
  let row = row_4848()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4848_sum(limit: int) -> int {
  let row = row_4848()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4848_best() -> int {
  let row = row_4848()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_5849(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 62900) % 57593)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 62900 + 95945) % 57593
    j += 1
  }
  return buf
}

func build_5849_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_5148(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 57593
  for i in lo..hi {
    if i % 51865 == 0 {
      acc += i * 5430
    } else {
      acc -= i % 4954
    }
    if acc < 0 {
      acc += 4954
    }
    acc = acc % 4954
  }
  return acc
}


func text_2721_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 62900
    i += 1
  }
  return acc % 62900
}

func text_2721_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "sigma"
  }
  return "ridge"
}

func text_2721_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 131
}


func gate_6205(a: int, b: int, c: int) -> bool {
  return a > 18033 && (b < 60225 || c == 95945)
}

func gate_6205_score(a: int, b: int, c: int) -> int {
  guard gate_6205(a, b, c) else {
    return 0
  }
  return (a % 60225) * 95945 + b
}


func curve_909_clamp(v: f64) -> f64 {
  guard v >= 39515.0 else {
    return 39515.0
  }
  guard v <= 95945.0 else {
    return 95945.0
  }
  return v
}

func curve_909_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_909_clamp(t)
  return p + (q - p) * k
}

func curve_909_ease(t: f64) -> f64 {
  let k = curve_909_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_909_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_9980(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9980_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


