func demo_tables(seed: int) -> int {
  let scratch = build_5849(seed % 61 + 6, seed % 50999)
  show(len(scratch))
  show(row_4848_at(1499))
  show(row_4848_sum(119))
  show(row_4848_best())
  show(build_5849_last(scratch))
  show(sweep_5148(1630, 2637))
  show(text_2721_weight("ember"))
  return seed % 60798
}
