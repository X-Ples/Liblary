func check_8780(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 98755 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 65755) % 39515
    i += 1
  }
  return Ok(acc)
}

func check_8780_chain(n: int) -> int {
