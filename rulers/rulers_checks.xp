func text_6803_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 44205
    i += 1
  }
  return acc % 44205
}

func text_6803_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "omega"
}

func text_6803_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 55772
}


func build_1213(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 83376) % 64300)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 83376 + 87413) % 64300
    j += 1
  }
  return buf
}

func build_1213_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_3059(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3059_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func check_3483(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 43676 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 47672) % 59890
    i += 1
  }
  return Ok(acc)
}

func check_3483_chain(n: int) -> int {
  let picked = check_3483(n)?
  return picked % 59890
}


