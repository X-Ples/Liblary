func demo_counters(seed: int) -> int {
  let scratch = build_2665(seed % 61 + 6, seed % 13440)
  show(len(scratch))
  show(build_2665_last(scratch))
  show(grid_9784_rowsum(scratch, 3940, 2317, 3893))
  show(sweep_9162(3130, 2827))
  return seed % 13281
}
