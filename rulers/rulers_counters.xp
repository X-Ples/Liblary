func text_9737_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "quartz"
}

func text_9737_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 98911
}


