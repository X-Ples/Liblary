func check_7232(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 86606 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 85615) % 83603
    i += 1
  }
  return Ok(acc)
}

func check_7232_chain(n: int) -> int {
  let picked = check_7232(n)?
  return picked % 83603
}


