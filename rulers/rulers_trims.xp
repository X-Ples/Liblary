func demo_trims(seed: int) -> int {
  let scratch = build_3157(seed % 61 + 6, seed % 84847)
  show(len(scratch))
  show(sweep_1035(149, 2100))
  show(scan_7832(scratch, 3117))
  show(scan_7832_span(scratch, 1916))
  show(build_3157_last(scratch))
  show(sweep_1884(3816, 631))
  return seed % 41494
}
