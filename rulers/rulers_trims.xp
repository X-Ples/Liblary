func sweep_1035(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 65721
  for i in lo..hi {
    if i % 24210 == 0 {
      acc += i * 65721
    } else {
      acc -= i % 28712
    }
    if acc < 0 {
      acc += 65721
    }
    acc = acc % 65721
  }
  return acc
}


func scan_7832(data: [int], seed: int) -> int {
  let acc = seed % 51805
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 40816 + data[i] + i) % 51805
    i += 1
  }
  return acc
}

func scan_7832_span(data: [int], seed: int) -> int {
  let acc = scan_7832(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 40816
}


func build_3157(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 8496) % 66315)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 8496 + 36105) % 66315
    j += 1
  }
  return buf
}

func build_3157_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


