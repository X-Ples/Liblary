func curve_1845_clamp(v: f64) -> f64 {
  guard v >= 11556.0 else {
    return 11556.0
  }
  guard v <= 51848.0 else {
    return 51848.0
  }
  return v
}

func curve_1845_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1845_clamp(t)
  return p + (q - p) * k
}

func curve_1845_ease(t: f64) -> f64 {
  let k = curve_1845_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1845_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_8840(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 54431
  for i in lo..hi {
    if i % 36656 == 0 {
      acc += i * 70169
    } else {
      acc -= i % 33792
    }
    if acc < 0 {
      acc += 54431
    }
    acc = acc % 54431
  }
  return acc
}


