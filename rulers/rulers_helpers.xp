func demo_helpers(seed: int) -> int {
  let scratch = build_7653(seed % 61 + 6, seed % 31098)
  show(len(scratch))
  show(build_7653_last(scratch))
  show(build_9413_last(scratch))
  show(sweep_8840(56, 1662))
  show(build_9948_last(scratch))
  return seed % 54431
}
