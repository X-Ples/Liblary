func check_8999(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 71558 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 78228) % 33792
    i += 1
  }
  return Ok(acc)
}

func check_8999_chain(n: int) -> int {
  let picked = check_8999(n)?
  return picked % 33792
}


