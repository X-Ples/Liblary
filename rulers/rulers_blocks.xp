func check_8615(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 82672 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 4360) % 36771
    i += 1
  }
  return Ok(acc)
}

func check_8615_chain(n: int) -> int {
  let picked = check_8615(n)?
  return picked % 36771
}


