func row_511() -> [int] {
  return [2113, 1563, 3729, 38, 2339, 1231, 2168, 1319, 7, 3143, 740, 2632, 2410, 180, 557, 3299, 513, 469, 142]
}

func row_511_at(i: int) -> int {
  let row = row_511()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_511_sum(limit: int) -> int {
  let row = row_511()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_511_best() -> int {
  let row = row_511()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_4234_clamp(v: f64) -> f64 {
  guard v >= 4360.0 else {
    return 4360.0
  }
  guard v <= 16921.0 else {
    return 16921.0
  }
  return v
}

func curve_4234_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4234_clamp(t)
  return p + (q - p) * k
}

func curve_4234_ease(t: f64) -> f64 {
  let k = curve_4234_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4234_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


