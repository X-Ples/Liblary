func demo_blocks(seed: int) -> int {
  let scratch = build_2962(seed % 61 + 6, seed % 76908)
  show(len(scratch))
  show(build_2962_last(scratch))
  show(build_704_last(scratch))
  show(gate_3577(3737, 1687, 3256))
  show(gate_3577_score(332, 2463, 779))
  return seed % 87958
}
