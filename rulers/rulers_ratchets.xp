func row_1762() -> [int] {
  return [2242, 3924, 924, 3551, 1153, 3063, 3205, 2545, 3034, 1916, 2881, 432, 2606, 2596, 1339, 2407, 3237, 2927]
}

func row_1762_at(i: int) -> int {
  let row = row_1762()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1762_sum(limit: int) -> int {
  let row = row_1762()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1762_best() -> int {
  let row = row_1762()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_2642(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 68343) % 39926)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 68343 + 73480) % 39926
    j += 1
  }
  return buf
}

func build_2642_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_4786_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 23980
    i += 1
  }
  return acc % 23980
}

func text_4786_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "ridge"
}

func text_4786_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 73418
}


