func scan_9826(data: [int], seed: int) -> int {
  let acc = seed % 73418
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 27794 + data[i] + i) % 73418
    i += 1
  }
  return acc
}

func scan_9826_span(data: [int], seed: int) -> int {
  let acc = scan_9826(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 27794
}


