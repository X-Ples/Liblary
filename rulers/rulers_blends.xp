func check_2786(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 5006 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 86198) % 48087
    i += 1
  }
  return Ok(acc)
}

func check_2786_chain(n: int) -> int {
  let picked = check_2786(n)?
  return picked % 48087
}


