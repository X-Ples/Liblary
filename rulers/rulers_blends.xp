}


func sweep_4160(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 12685
  for i in lo..hi {
    if i % 23210 == 0 {
      acc += i * 92635
    } else {
      acc -= i % 23210
    }
    if acc < 0 {
      acc += 60344
    }
    acc = acc % 60344
  }
  return acc
}


