func demo_blends(seed: int) -> int {
  let scratch = build_2858(seed % 61 + 6, seed % 55849)
  show(len(scratch))
  show(order_4662_find(scratch, 529))
  show(build_2858_last(scratch))
  show(gate_6454(3839, 2802, 3525))
  show(gate_6454_score(2823, 3004, 3717))
  show(text_8547_weight("harbor"))
  return seed % 1998
}
