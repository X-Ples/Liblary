func order_4662(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4662_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_2858(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 12685) % 68352)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 12685 + 31559) % 68352
    j += 1
  }
  return buf
}

func build_2858_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_6454(a: int, b: int, c: int) -> bool {
  return a > 92635 && (b < 18232 || c == 65519)
}

func gate_6454_score(a: int, b: int, c: int) -> int {
  guard gate_6454(a, b, c) else {
    return 0
  }
  return (a % 18232) * 65519 + b
}


func text_8547_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 86198
    i += 1
  }
  return acc % 86198
}

func text_8547_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "delta"
}

func text_8547_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 93658
}


