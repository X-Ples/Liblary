func sweep_338(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 47392
  for i in lo..hi {
    if i % 49394 == 0 {
      acc += i * 69525
    } else {
      acc -= i % 70663
    }
    if acc < 0 {
      acc += 34345
    }
    acc = acc % 34345
  }
  return acc
}


