func demo_signals(seed: int) -> int {
  let scratch = build_9181(seed % 61 + 6, seed % 69607)
  show(len(scratch))
  show(sweep_338(2739, 3267))
  show(build_9181_last(scratch))
  show(text_2044_weight("prism"))
  show(text_2044_label(1214))
  return seed % 50370
}
