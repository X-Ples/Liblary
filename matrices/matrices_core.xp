func check_1741(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 7756 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 69015) % 6262
    i += 1
  }
  return Ok(acc)
}

func check_1741_chain(n: int) -> int {
  let picked = check_1741(n)?
  return picked % 6262
}


func scan_826(data: [int], seed: int) -> int {
  let acc = seed % 41516
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 1045 + data[i] + i) % 41516
    i += 1
  }
  return acc
}

func scan_826_span(data: [int], seed: int) -> int {
  let acc = scan_826(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 1045
}


func row_1295() -> [int] {
