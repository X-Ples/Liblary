func demo_core(seed: int) -> int {
  let scratch = build_7836(seed % 61 + 6, seed % 44167)
  show(len(scratch))
  show(build_7836_last(scratch))
  show(build_5436_last(scratch))
  show(check_1741_chain(2376))
  show(scan_826(scratch, 1517))
  return seed % 94224
}
