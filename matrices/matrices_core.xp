func build_7836(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 41656) % 69015)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 41656 + 6443) % 69015
    j += 1
  }
  return buf
}

func build_7836_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


