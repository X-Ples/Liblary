func text_8948_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 88413
    i += 1
  }
  return acc % 88413
}

func text_8948_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "nova"
}

func text_8948_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 72368
}


func scan_7481(data: [int], seed: int) -> int {
  let acc = seed % 66948
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 71207 + data[i] + i) % 66948
    i += 1
  }
  return acc
}

func scan_7481_span(data: [int], seed: int) -> int {
  let acc = scan_7481(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 71207
}


