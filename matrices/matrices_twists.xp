func build_2462(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 54212) % 73851)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 54212 + 85675) % 73851
    j += 1
  }
  return buf
}

func build_2462_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_8652(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 33078 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 68824) % 71207
    i += 1
  }
  return Ok(acc)
}

func check_8652_chain(n: int) -> int {
  let picked = check_8652(n)?
  return picked % 71207
}


