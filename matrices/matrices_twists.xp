func sweep_6653(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 17339
  for i in lo..hi {
    if i % 45789 == 0 {
      acc += i * 45789
    } else {
      acc -= i % 17339
    }
    if acc < 0 {
      acc += 95437
    }
    acc = acc % 95437
  }
  return acc
}


