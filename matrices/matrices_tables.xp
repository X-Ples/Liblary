func build_2318(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 7545) % 35485)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 7545 + 30046) % 35485
    j += 1
  }
  return buf
}

func build_2318_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_6354(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 17235
  for i in lo..hi {
    if i % 40569 == 0 {
      acc += i * 84046
    } else {
      acc -= i % 24635
    }
    if acc < 0 {
      acc += 47848
    }
    acc = acc % 47848
  }
  return acc
}


func text_9140_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 12861
    i += 1
  }
  return acc % 12861
}

func text_9140_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "lumen"
}

func text_9140_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 7545
}


