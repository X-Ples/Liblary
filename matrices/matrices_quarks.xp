func demo_quarks(seed: int) -> int {
  let scratch = build_4404(seed % 61 + 6, seed % 36123)
  show(len(scratch))
  show(build_4404_last(scratch))
  show(gate_9799(1607, 2671, 1388))
  show(gate_9799_score(2755, 3134, 3425))
  show(row_5732_at(1328))
  return seed % 19647
}
