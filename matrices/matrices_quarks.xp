func build_4404(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 84777) % 19961)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 84777 + 1705) % 19961
    j += 1
  }
  return buf
}

func build_4404_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_9799(a: int, b: int, c: int) -> bool {
  return a > 3518 && (b < 31583 || c == 31583)
}

func gate_9799_score(a: int, b: int, c: int) -> int {
  guard gate_9799(a, b, c) else {
    return 0
  }
  return (a % 31583) * 31583 + b
}


