func demo_trims(seed: int) -> int {
  let scratch = build_8665(seed % 61 + 6, seed % 11710)
  show(len(scratch))
  show(order_9463_find(scratch, 2082))
  show(build_8665_last(scratch))
  show(order_9292_find(scratch, 2622))
  return seed % 84192
}
