  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 11710 + data[i] + i) % 82218
    i += 1
  }
  return acc
}

func scan_4672_span(data: [int], seed: int) -> int {
  let acc = scan_4672(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 11710
}


