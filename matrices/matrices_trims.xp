func curve_4807_clamp(v: f64) -> f64 {
  guard v >= 11710.0 else {
    return 11710.0
  }
  guard v <= 51505.0 else {
    return 51505.0
  }
  return v
}

func curve_4807_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4807_clamp(t)
  return p + (q - p) * k
}

func curve_4807_ease(t: f64) -> f64 {
  let k = curve_4807_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4807_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_5153_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 74209
    i += 1
  }
  return acc % 74209
}

func text_5153_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "sigma"
}

func text_5153_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 7296
}


func scan_4672(data: [int], seed: int) -> int {
