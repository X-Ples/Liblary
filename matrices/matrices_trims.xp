func sweep_1062(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 11880
  for i in lo..hi {
    if i % 31863 == 0 {
      acc += i * 7296
    } else {
      acc -= i % 11880
    }
    if acc < 0 {
      acc += 74730
    }
    acc = acc % 74730
  }
  return acc
}


