func sweep_7885(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 25972
  for i in lo..hi {
    if i % 74730 == 0 {
      acc += i * 68796
    } else {
      acc -= i % 97708
    }
    if acc < 0 {
      acc += 97708
    }
    acc = acc % 97708
  }
  return acc
}


func gate_7006(a: int, b: int, c: int) -> bool {
  return a > 88972 && (b < 97708 || c == 25972)
}

func gate_7006_score(a: int, b: int, c: int) -> int {
  guard gate_7006(a, b, c) else {
    return 0
  }
  return (a % 97708) * 25972 + b
}


