func curve_5120_clamp(v: f64) -> f64 {
  guard v >= 79204.0 else {
    return 79204.0
  }
  guard v <= 87410.0 else {
    return 87410.0
  }
  return v
}

func curve_5120_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5120_clamp(t)
  return p + (q - p) * k
}

func curve_5120_ease(t: f64) -> f64 {
  let k = curve_5120_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5120_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_9882_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 41862 + c * 20167 + seed) % 20167)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9882_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 20167 == want {
      total += acc
    }
    r += 1
  }
  return total
}


