func check_8388(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 55391 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 77857) % 64106
    i += 1
  }
  return Ok(acc)
}

func check_8388_chain(n: int) -> int {
  let picked = check_8388(n)?
  return picked % 64106
}


