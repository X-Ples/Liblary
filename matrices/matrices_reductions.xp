func order_3961(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3961_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func grid_2189_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 25107 + c * 24857 + seed) % 24857)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2189_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 24857 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func row_4934() -> [int] {
  return [602, 3927, 325, 3115, 430, 2679, 149, 1375, 4033, 1923, 790, 1217, 2500, 2035, 3351, 1300, 1817, 231, 1552, 1672, 167]
}

func row_4934_at(i: int) -> int {
  let row = row_4934()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4934_sum(limit: int) -> int {
  let row = row_4934()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4934_best() -> int {
  let row = row_4934()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_198(data: [int], seed: int) -> int {
  let acc = seed % 98139
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 78666 + data[i] + i) % 98139
    i += 1
  }
  return acc
}

func scan_198_span(data: [int], seed: int) -> int {
  let acc = scan_198(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 78666
}


