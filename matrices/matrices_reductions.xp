func demo_reductions(seed: int) -> int {
  let scratch = build_8165(seed % 61 + 6, seed % 38131)
  show(len(scratch))
  show(build_8165_last(scratch))
  show(gate_1713(619, 3547, 596))
  show(gate_1713_score(2485, 1256, 403))
  show(order_3961_find(scratch, 3153))
  return seed % 54749
}
