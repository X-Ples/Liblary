func build_8165(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 25882) % 14953)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 25882 + 14953) % 14953
    j += 1
  }
  return buf
}

func build_8165_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_7886_clamp(v: f64) -> f64 {
  guard v >= 36973.0 else {
    return 36973.0
  }
  guard v <= 44538.0 else {
    return 44538.0
  }
  return v
}

func curve_7886_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7886_clamp(t)
  return p + (q - p) * k
}

func curve_7886_ease(t: f64) -> f64 {
  let k = curve_7886_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7886_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_1713(a: int, b: int, c: int) -> bool {
  return a > 86713 && (b < 44538 || c == 78666)
}

func gate_1713_score(a: int, b: int, c: int) -> int {
  guard gate_1713(a, b, c) else {
    return 0
  }
  return (a % 44538) * 78666 + b
}


