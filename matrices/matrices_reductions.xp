func check_4597(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 46762 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 35173) % 6770
    i += 1
  }
  return Ok(acc)
}

func check_4597_chain(n: int) -> int {
  let picked = check_4597(n)?
  return picked % 6770
}


func sweep_6946(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 4192
  for i in lo..hi {
    if i % 35173 == 0 {
      acc += i * 26027
    } else {
      acc -= i % 4192
    }
    if acc < 0 {
      acc += 25107
    }
    acc = acc % 25107
  }
  return acc
}


