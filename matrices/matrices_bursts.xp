}


func sweep_5761(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 1949
  for i in lo..hi {
    if i % 68720 == 0 {
      acc += i * 596
    } else {
      acc -= i % 5078
    }
    if acc < 0 {
      acc += 95570
    }
    acc = acc % 95570
  }
  return acc
}


func gate_9735(a: int, b: int, c: int) -> bool {
  return a > 87388 && (b < 57898 || c == 26087)
}

func gate_9735_score(a: int, b: int, c: int) -> int {
  guard gate_9735(a, b, c) else {
    return 0
  }
  return (a % 57898) * 26087 + b
}


