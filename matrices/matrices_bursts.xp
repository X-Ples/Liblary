func demo_bursts(seed: int) -> int {
  let scratch = build_6295(seed % 61 + 6, seed % 55660)
  show(len(scratch))
  show(build_6295_last(scratch))
  show(scan_5839(scratch, 1483))
  show(scan_5839_span(scratch, 958))
  show(order_8950_find(scratch, 3553))
  show(row_4648_at(3399))
  show(row_4648_sum(2400))
  return seed % 5341
}
