const K0 = 50322
const K1 = 93538
const K2 = 89477
const K3 = 5078
const K4 = 57898
const K5 = 95570
const K6 = 596
const K7 = 89738
const K8 = 68720
const K9 = 82153

func build_6295(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 89477) % 1949)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 89477 + 10896) % 1949
    j += 1
  }
  return buf
}

func build_6295_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_5839(data: [int], seed: int) -> int {
  let acc = seed % 87483
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 95570 + data[i] + i) % 87483
    i += 1
  }
  return acc
}

func scan_5839_span(data: [int], seed: int) -> int {
  let acc = scan_5839(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 95570
}


func order_8950(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8950_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


