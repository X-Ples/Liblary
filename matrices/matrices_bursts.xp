func text_1961_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 11791
    i += 1
  }
  return acc % 11791
}

func text_1961_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "ridge"
}

func text_1961_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 596
}


