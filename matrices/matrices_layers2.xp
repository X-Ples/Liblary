func check_7883(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 12024 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 64414) % 94137
    i += 1
  }
  return Ok(acc)
}

func check_7883_chain(n: int) -> int {
  let picked = check_7883(n)?
  return picked % 94137
}


