func build_7353(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 88403) % 92421)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 88403 + 14451) % 92421
    j += 1
  }
  return buf
}

func build_7353_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_3052(data: [int], seed: int) -> int {
  let acc = seed % 68616
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 13517 + data[i] + i) % 68616
    i += 1
  }
  return acc
}

func scan_3052_span(data: [int], seed: int) -> int {
  let acc = scan_3052(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 13517
}


func grid_2263_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 59695 + c * 68616 + seed) % 68616)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2263_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 68616 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_7773_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 3953
    i += 1
  }
  return acc % 3953
}

func text_7773_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ridge"
  }
  if idx % 3 == 0 {
    return "bravo"
  }
  return "flint"
}

func text_7773_has(tag: str) -> bool {
  return str_contains(tag, "ridge") || len(tag) > 64120
}


func gate_4987(a: int, b: int, c: int) -> bool {
  return a > 26138 && (b < 88403 || c == 71787)
}

func gate_4987_score(a: int, b: int, c: int) -> int {
  guard gate_4987(a, b, c) else {
    return 0
  }
  return (a % 88403) * 71787 + b
}


func curve_3420_clamp(v: f64) -> f64 {
  guard v >= 14451.0 else {
    return 14451.0
  }
  guard v <= 59695.0 else {
    return 59695.0
  }
  return v
}

func curve_3420_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3420_clamp(t)
  return p + (q - p) * k
}

func curve_3420_ease(t: f64) -> f64 {
  let k = curve_3420_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3420_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_8582() -> [int] {
  return [1421, 478, 2850, 2467, 430, 2946, 1714, 1178, 966, 1656, 1664, 1033, 1117, 1517]
}

func row_8582_at(i: int) -> int {
  let row = row_8582()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8582_sum(limit: int) -> int {
  let row = row_8582()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8582_best() -> int {
  let row = row_8582()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


