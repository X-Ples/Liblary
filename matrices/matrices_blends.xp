func demo_blends(seed: int) -> int {
  let scratch = build_6320(seed % 61 + 6, seed % 51596)
  show(len(scratch))
  show(build_6320_last(scratch))
  show(row_9997_at(615))
  show(row_9997_sum(1499))
  show(row_9997_best())
  return seed % 62331
}
