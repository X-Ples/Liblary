func build_6320(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 19035) % 62331)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 19035 + 86725) % 62331
    j += 1
  }
  return buf
}

func build_6320_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_3787_clamp(v: f64) -> f64 {
  guard v >= 19035.0 else {
    return 19035.0
  }
  guard v <= 67181.0 else {
    return 67181.0
  }
  return v
}

func curve_3787_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3787_clamp(t)
  return p + (q - p) * k
}

func curve_3787_ease(t: f64) -> f64 {
  let k = curve_3787_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3787_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_9997() -> [int] {
  return [1785, 1619, 1550, 3754, 880, 294, 607, 648, 3047, 2783]
}

func row_9997_at(i: int) -> int {
  let row = row_9997()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9997_sum(limit: int) -> int {
  let row = row_9997()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9997_best() -> int {
  let row = row_9997()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


