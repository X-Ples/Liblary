func check_9065(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 29110 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 62839) % 25498
    i += 1
  }
  return Ok(acc)
}

func check_9065_chain(n: int) -> int {
  let picked = check_9065(n)?
  return picked % 25498
}


