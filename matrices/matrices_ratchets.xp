func build_4582(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 67969) % 64689)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 67969 + 12573) % 64689
    j += 1
  }
  return buf
}

func build_4582_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_5612(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5612_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_3998_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 24826
    i += 1
  }
  return acc % 24826
}

func text_3998_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "jetty"
}

func text_3998_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 48436
}


func curve_6630_clamp(v: f64) -> f64 {
  guard v >= 55417.0 else {
    return 55417.0
  }
  guard v <= 69942.0 else {
    return 69942.0
  }
  return v
}

func curve_6630_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6630_clamp(t)
  return p + (q - p) * k
}

func curve_6630_ease(t: f64) -> f64 {
  let k = curve_6630_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6630_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


