func row_6259() -> [int] {
  return [678, 3873, 3797, 1338, 3860, 3381, 3099, 2627, 2715, 1233, 716, 1209]
}

func row_6259_at(i: int) -> int {
  let row = row_6259()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6259_sum(limit: int) -> int {
  let row = row_6259()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6259_best() -> int {
  let row = row_6259()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


