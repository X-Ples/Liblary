func demo_helpers(seed: int) -> int {
  let scratch = build_5184(seed % 61 + 6, seed % 15250)
  show(len(scratch))
  show(build_5184_last(scratch))
  show(order_1984_find(scratch, 3460))
  show(check_2264_chain(3125))
  show(grid_4702_rowsum(scratch, 920, 3831, 1784))
  show(grid_1142_rowsum(scratch, 3123, 2031, 1984))
  return seed % 87208
}
