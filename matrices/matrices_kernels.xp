func sweep_6148(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 731
  for i in lo..hi {
    if i % 20396 == 0 {
      acc += i * 664
    } else {
      acc -= i % 55737
    }
    if acc < 0 {
      acc += 57043
    }
    acc = acc % 57043
  }
  return acc
}


func build_3240(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 664) % 664)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 664 + 69774) % 664
    j += 1
  }
  return buf
}

func build_3240_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_3658_clamp(v: f64) -> f64 {
  guard v >= 28497.0 else {
    return 28497.0
  }
  guard v <= 38220.0 else {
    return 38220.0
  }
  return v
}

func curve_3658_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3658_clamp(t)
  return p + (q - p) * k
}

func curve_3658_ease(t: f64) -> f64 {
  let k = curve_3658_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3658_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_5896_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 87843
    i += 1
  }
  return acc % 87843
}

func text_5896_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "omega"
}

func text_5896_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 5993
}


func grid_656_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 91825 + c * 731 + seed) % 731)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_656_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 731 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_977(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 36917 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 88386) % 7623
    i += 1
  }
  return Ok(acc)
}

func check_977_chain(n: int) -> int {
  let picked = check_977(n)?
  return picked % 7623
}


