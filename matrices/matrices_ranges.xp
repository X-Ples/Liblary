func check_8350(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 49040 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 92034) % 41943
    i += 1
  }
  return Ok(acc)
}

func check_8350_chain(n: int) -> int {
  let picked = check_8350(n)?
  return picked % 41943
}


