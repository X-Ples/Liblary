func sweep_6118(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 77065
  for i in lo..hi {
    if i % 26835 == 0 {
      acc += i * 58089
    } else {
      acc -= i % 50166
    }
    if acc < 0 {
      acc += 49556
    }
    acc = acc % 49556
  }
  return acc
}


func build_574(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 5935) % 26835)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 5935 + 77065) % 26835
    j += 1
  }
  return buf
}

func build_574_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_780(a: int, b: int, c: int) -> bool {
  return a > 18885 && (b < 49040 || c == 1463)
}

func gate_780_score(a: int, b: int, c: int) -> int {
  guard gate_780(a, b, c) else {
    return 0
  }
  return (a % 49040) * 1463 + b
}


