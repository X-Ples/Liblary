func demo_ranges(seed: int) -> int {
  let scratch = build_574(seed % 61 + 6, seed % 35150)
  show(len(scratch))
  show(sweep_6118(592, 2266))
  show(build_574_last(scratch))
  show(gate_780(1858, 2214, 774))
  show(gate_780_score(3625, 2470, 1100))
  show(gate_9736(2339, 754, 1817))
  return seed % 95140
}
