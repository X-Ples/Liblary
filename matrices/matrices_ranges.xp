func scan_1337(data: [int], seed: int) -> int {
  let acc = seed % 95140
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 5935 + data[i] + i) % 95140
    i += 1
  }
  return acc
}

func scan_1337_span(data: [int], seed: int) -> int {
  let acc = scan_1337(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 5935
}


