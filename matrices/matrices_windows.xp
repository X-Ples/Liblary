func demo_windows(seed: int) -> int {
  let scratch = build_752(seed % 61 + 6, seed % 71311)
  show(len(scratch))
  show(build_752_last(scratch))
  show(grid_1649_rowsum(scratch, 1725, 3567, 1720))
