func build_752(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 9227) % 49460)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 9227 + 25568) % 49460
    j += 1
  }
  return buf
}

func build_752_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_1649_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 95809 + c * 27934 + seed) % 27934)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1649_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 27934 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_9707_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 27934
    i += 1
  }
  return acc % 27934
}

func text_9707_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "delta"
}

func text_9707_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 9227
}


