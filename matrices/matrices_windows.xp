func gate_1738(a: int, b: int, c: int) -> bool {
  return a > 42997 && (b < 41700 || c == 69359)
}

func gate_1738_score(a: int, b: int, c: int) -> int {
  guard gate_1738(a, b, c) else {
    return 0
  }
  return (a % 41700) * 69359 + b
}


func order_629(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_629_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func row_7479() -> [int] {
  return [2790, 1855, 2334, 1897, 2183, 44, 764, 722, 3063, 2967, 2450, 2090, 1972, 1771]
}

func row_7479_at(i: int) -> int {
  let row = row_7479()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7479_sum(limit: int) -> int {
  let row = row_7479()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7479_best() -> int {
  let row = row_7479()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_2620(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 35864 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 27934) % 35864
    i += 1
  }
  return Ok(acc)
}

func check_2620_chain(n: int) -> int {
  let picked = check_2620(n)?
  return picked % 35864
}


func curve_7072_clamp(v: f64) -> f64 {
  guard v >= 47937.0 else {
    return 47937.0
  }
  guard v <= 72236.0 else {
    return 72236.0
  }
  return v
}

func curve_7072_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7072_clamp(t)
  return p + (q - p) * k
}

func curve_7072_ease(t: f64) -> f64 {
  let k = curve_7072_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7072_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


