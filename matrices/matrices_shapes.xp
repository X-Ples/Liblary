func check_8360(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 91694 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 34691) % 19136
    i += 1
  }
  return Ok(acc)
}

func check_8360_chain(n: int) -> int {
