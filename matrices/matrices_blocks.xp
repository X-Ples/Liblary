func demo_blocks(seed: int) -> int {
  let scratch = build_687(seed % 61 + 6, seed % 36289)
  show(len(scratch))
  show(build_687_last(scratch))
  show(order_9176_find(scratch, 1329))
  show(row_2104_at(2379))
  show(row_2104_sum(391))
  return seed % 93884
}
