func check_2627(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 69952 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 69952) % 84282
    i += 1
  }
  return Ok(acc)
}

func check_2627_chain(n: int) -> int {
  let picked = check_2627(n)?
  return picked % 84282
}


