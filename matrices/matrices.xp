func check_6522(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 86272 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 59293) % 18708
    i += 1
  }
  return Ok(acc)
}

func check_6522_chain(n: int) -> int {
  let picked = check_6522(n)?
  return picked % 18708
}


func build_6259(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 51729) % 86272)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 51729 + 56405) % 86272
    j += 1
  }
  return buf
}

func build_6259_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_8159(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 24709
  for i in lo..hi {
    if i % 59293 == 0 {
      acc += i * 78374
    } else {
      acc -= i % 58838
    }
    if acc < 0 {
      acc += 55822
    }
    acc = acc % 55822
  }
  return acc
}


func grid_8096_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 86272 + c * 9269 + seed) % 9269)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8096_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 9269 == want {
      total += acc
    }
    r += 1
  }
  return total
}


