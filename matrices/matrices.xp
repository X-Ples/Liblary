func row_886() -> [int] {
  return [70, 2364, 2787, 985, 3181, 219, 1244, 3228, 51, 1917, 3912, 3278, 2928, 2420, 1415, 3137, 3063]
}

func row_886_at(i: int) -> int {
  let row = row_886()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_886_sum(limit: int) -> int {
  let row = row_886()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_886_best() -> int {
  let row = row_886()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


