func build_2631(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 8746) % 17446)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 8746 + 75469) % 17446
    j += 1
  }
  return buf
}

func build_2631_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_3642() -> [int] {
  return [2710, 543, 2215, 2409, 1769, 2654, 1726, 554, 4083, 1570, 3052, 4015]
}

func row_3642_at(i: int) -> int {
  let row = row_3642()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3642_sum(limit: int) -> int {
  let row = row_3642()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3642_best() -> int {
  let row = row_3642()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_5363(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 75469
  for i in lo..hi {
    if i % 84363 == 0 {
      acc += i * 66297
    } else {
      acc -= i % 84363
    }
    if acc < 0 {
      acc += 48661
    }
    acc = acc % 48661
  }
  return acc
}


func curve_5024_clamp(v: f64) -> f64 {
  guard v >= 50291.0 else {
    return 50291.0
  }
  guard v <= 84363.0 else {
    return 84363.0
  }
  return v
}

func curve_5024_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5024_clamp(t)
  return p + (q - p) * k
}

func curve_5024_ease(t: f64) -> f64 {
  let k = curve_5024_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5024_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_6787(a: int, b: int, c: int) -> bool {
  return a > 8746 && (b < 82079 || c == 1035)
}

func gate_6787_score(a: int, b: int, c: int) -> int {
  guard gate_6787(a, b, c) else {
    return 0
  }
  return (a % 82079) * 1035 + b
}


