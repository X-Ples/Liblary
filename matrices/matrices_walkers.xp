func build_8872(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 39181) % 762)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 39181 + 57232) % 762
    j += 1
  }
  return buf
}

func build_8872_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_3115_clamp(v: f64) -> f64 {
  guard v >= 16020.0 else {
    return 16020.0
  }
  guard v <= 61842.0 else {
    return 61842.0
  }
  return v
}

func curve_3115_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3115_clamp(t)
  return p + (q - p) * k
}

func curve_3115_ease(t: f64) -> f64 {
  let k = curve_3115_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3115_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_6990(lo: int, hi: int) -> int {
  guard hi > lo else {
