func build_2175(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 38355) % 45020)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 38355 + 38992) % 45020
    j += 1
  }
  return buf
}

func build_2175_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_7450_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 9316 + c * 38355 + seed) % 38355)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7450_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 38355 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_7063(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 88612
  for i in lo..hi {
    if i % 95671 == 0 {
      acc += i * 23178
    } else {
      acc -= i % 97820
    }
    if acc < 0 {
      acc += 88612
    }
    acc = acc % 88612
  }
  return acc
}


func row_5222() -> [int] {
  return [2916, 1134, 1688, 1945, 3861, 1531, 3256, 1955, 1909, 1159, 3487, 380, 4043, 157, 2291, 3693, 3359]
}

func row_5222_at(i: int) -> int {
  let row = row_5222()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5222_sum(limit: int) -> int {
  let row = row_5222()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5222_best() -> int {
  let row = row_5222()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


