func text_6009_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 30452
    i += 1
  }
  return acc % 30452
}

func text_6009_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "omega"
}

func text_6009_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 55461
}


func order_3807(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3807_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func curve_758_clamp(v: f64) -> f64 {
  guard v >= 23178.0 else {
    return 23178.0
  }
  guard v <= 97820.0 else {
    return 97820.0
  }
  return v
}

func curve_758_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_758_clamp(t)
  return p + (q - p) * k
}

func curve_758_ease(t: f64) -> f64 {
  let k = curve_758_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_758_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_6736(data: [int], seed: int) -> int {
  let acc = seed % 89667
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 24061 + data[i] + i) % 89667
    i += 1
  }
  return acc
}

func scan_6736_span(data: [int], seed: int) -> int {
  let acc = scan_6736(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 24061
}


func check_5139(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 38992 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 84425) % 38992
    i += 1
  }
  return Ok(acc)
}

func check_5139_chain(n: int) -> int {
  let picked = check_5139(n)?
  return picked % 38992
}


