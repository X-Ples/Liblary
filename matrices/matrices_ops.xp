func demo_ops(seed: int) -> int {
  let scratch = build_2175(seed % 61 + 6, seed % 23178)
  show(len(scratch))
  show(build_2175_last(scratch))
  show(grid_7450_rowsum(scratch, 3172, 2950, 1080))
  show(sweep_7063(842, 1006))
  show(row_5222_at(1562))
  show(row_5222_sum(632))
  show(row_5222_best())
  return seed % 24061
}
