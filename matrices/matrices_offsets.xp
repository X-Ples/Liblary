func demo_offsets(seed: int) -> int {
  let scratch = build_3166(seed % 61 + 6, seed % 36053)
  show(len(scratch))
  show(build_3166_last(scratch))
  show(gate_5586(904, 675, 2396))
  show(gate_5586_score(198, 401, 188))
  show(build_2814_last(scratch))
  show(check_3967_chain(2003))
  return seed % 34576
}
