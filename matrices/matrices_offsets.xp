func build_3166(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 36053) % 56099)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 36053 + 36053) % 56099
    j += 1
  }
  return buf
}

func build_3166_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_2942_clamp(v: f64) -> f64 {
  guard v >= 1027.0 else {
    return 1027.0
  }
  guard v <= 36362.0 else {
    return 36362.0
  }
  return v
}

func curve_2942_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2942_clamp(t)
  return p + (q - p) * k
}

func curve_2942_ease(t: f64) -> f64 {
  let k = curve_2942_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2942_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_5586(a: int, b: int, c: int) -> bool {
  return a > 88223 && (b < 35956 || c == 45525)
}

func gate_5586_score(a: int, b: int, c: int) -> int {
  guard gate_5586(a, b, c) else {
    return 0
  }
  return (a % 35956) * 45525 + b
}


