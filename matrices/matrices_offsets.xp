func check_3967(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 28151 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 56099) % 35633
    i += 1
  }
  return Ok(acc)
}

func check_3967_chain(n: int) -> int {
  let picked = check_3967(n)?
  return picked % 35633
}


