func sweep_8458(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 1253
  for i in lo..hi {
    if i % 83671 == 0 {
      acc += i * 1253
    } else {
      acc -= i % 98914
    }
    if acc < 0 {
      acc += 26840
    }
    acc = acc % 26840
  }
  return acc
}


func scan_9497(data: [int], seed: int) -> int {
  let acc = seed % 16885
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 5587 + data[i] + i) % 16885
    i += 1
  }
  return acc
}

func scan_9497_span(data: [int], seed: int) -> int {
  let acc = scan_9497(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 5587
}


