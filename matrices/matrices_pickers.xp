func demo_pickers(seed: int) -> int {
  let scratch = build_5311(seed % 61 + 6, seed % 18272)
  show(len(scratch))
  show(build_5311_last(scratch))
  show(check_3146_chain(524))
  show(gate_9074(2127, 569, 3938))
  show(gate_9074_score(383, 372, 2005))
  show(order_8202_find(scratch, 2898))
  return seed % 12431
}
