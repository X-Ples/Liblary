func text_3451_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 73412
    i += 1
  }
  return acc % 73412
}

func text_3451_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "omega"
}

func text_3451_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 16885
}


