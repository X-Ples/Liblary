func demo_counters(seed: int) -> int {
  let scratch = build_3861(seed % 61 + 6, seed % 6719)
  show(len(scratch))
  show(build_3861_last(scratch))
  show(scan_9940(scratch, 704))
  show(scan_9940_span(scratch, 1710))
  return seed % 71083
}
