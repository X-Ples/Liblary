func build_3861(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 88935) % 25189)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 88935 + 39) % 25189
    j += 1
  }
  return buf
}

func build_3861_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_4564_clamp(v: f64) -> f64 {
  guard v >= 80113.0 else {
    return 80113.0
  }
  guard v <= 96354.0 else {
    return 96354.0
  }
  return v
}

func curve_4564_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4564_clamp(t)
  return p + (q - p) * k
}

func curve_4564_ease(t: f64) -> f64 {
  let k = curve_4564_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4564_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_9940(data: [int], seed: int) -> int {
  let acc = seed % 81612
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 97140 + data[i] + i) % 81612
    i += 1
  }
  return acc
}

func scan_9940_span(data: [int], seed: int) -> int {
  let acc = scan_9940(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 97140
}


