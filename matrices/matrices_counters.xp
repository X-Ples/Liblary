func sweep_3509(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 98191
  for i in lo..hi {
    if i % 75481 == 0 {
      acc += i * 98127
    } else {
      acc -= i % 98191
    }
    if acc < 0 {
      acc += 96354
    }
    acc = acc % 96354
  }
  return acc
}


