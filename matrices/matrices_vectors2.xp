func scan_2603(data: [int], seed: int) -> int {
  let acc = seed % 44418
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 2754 + data[i] + i) % 44418
    i += 1
  }
  return acc
}

func scan_2603_span(data: [int], seed: int) -> int {
  let acc = scan_2603(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 2754
}


func check_7551(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 5244 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 26523) % 8682
    i += 1
  }
  return Ok(acc)
}

func check_7551_chain(n: int) -> int {
  let picked = check_7551(n)?
  return picked % 8682
}


