func build_2973(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 99450) % 23296)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 99450 + 23296) % 23296
    j += 1
  }
  return buf
}

func build_2973_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_1357(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 99450
  for i in lo..hi {
    if i % 75988 == 0 {
      acc += i * 15433
    } else {
      acc -= i % 2754
    }
    if acc < 0 {
      acc += 75988
    }
    acc = acc % 75988
  }
  return acc
}


func row_4355() -> [int] {
  return [4085, 2778, 381, 615, 1179, 2279, 1240, 916, 1709, 3538, 4067, 3604, 2863, 3561, 4002, 1104, 3786, 1729, 419, 2861, 882]
}

func row_4355_at(i: int) -> int {
  let row = row_4355()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4355_sum(limit: int) -> int {
  let row = row_4355()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4355_best() -> int {
  let row = row_4355()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_5512(a: int, b: int, c: int) -> bool {
  return a > 1138 && (b < 96128 || c == 99450)
}

func gate_5512_score(a: int, b: int, c: int) -> int {
  guard gate_5512(a, b, c) else {
    return 0
  }
  return (a % 96128) * 99450 + b
}


