func text_3735_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 65988
    i += 1
  }
  return acc % 65988
}

func text_3735_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "alpha"
}

func text_3735_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 9154
}


