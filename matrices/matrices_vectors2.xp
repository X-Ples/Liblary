func demo_vectors2(seed: int) -> int {
  let scratch = build_2973(seed % 61 + 6, seed % 58337)
  show(len(scratch))
  show(build_2973_last(scratch))
  show(sweep_1357(1694, 849))
  show(row_4355_at(2946))
  show(row_4355_sum(927))
  show(row_4355_best())
  return seed % 90781
}
