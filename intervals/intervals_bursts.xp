func gate_3825(a: int, b: int, c: int) -> bool {
  return a > 16867 && (b < 45480 || c == 82780)
}

func gate_3825_score(a: int, b: int, c: int) -> int {
  guard gate_3825(a, b, c) else {
    return 0
  }
  return (a % 45480) * 82780 + b
}


func row_5346() -> [int] {
  return [956, 3151, 3911, 159, 186, 1034, 3772, 2157, 3830, 402, 570, 974, 2105, 2226, 1531, 1540]
}

func row_5346_at(i: int) -> int {
  let row = row_5346()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5346_sum(limit: int) -> int {
  let row = row_5346()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5346_best() -> int {
  let row = row_5346()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


