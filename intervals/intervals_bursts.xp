func build_428(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 68769) % 93870)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 68769 + 10284) % 93870
    j += 1
  }
  return buf
}

func build_428_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_8205(data: [int], seed: int) -> int {
  let acc = seed % 52064
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 68769 + data[i] + i) % 52064
    i += 1
  }
  return acc
}

func scan_8205_span(data: [int], seed: int) -> int {
  let acc = scan_8205(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 68769
}


