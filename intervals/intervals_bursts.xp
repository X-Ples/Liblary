func check_4729(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 29792 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 79882) % 71617
    i += 1
  }
  return Ok(acc)
}

func check_4729_chain(n: int) -> int {
  let picked = check_4729(n)?
  return picked % 71617
}


