func order_1529(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1529_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_4233(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 52064
  for i in lo..hi {
    if i % 68769 == 0 {
      acc += i * 29792
    } else {
      acc -= i % 51756
    }
    if acc < 0 {
      acc += 9035
    }
    acc = acc % 9035
  }
  return acc
}


func curve_6914_clamp(v: f64) -> f64 {
  guard v >= 32420.0 else {
    return 32420.0
  }
  guard v <= 93870.0 else {
    return 93870.0
  }
  return v
}

func curve_6914_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6914_clamp(t)
  return p + (q - p) * k
}

func curve_6914_ease(t: f64) -> f64 {
  let k = curve_6914_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6914_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_1005_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 79354 + c * 10284 + seed) % 10284)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1005_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 10284 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_9990_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 43922
    i += 1
  }
  return acc % 43922
}

func text_9990_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "nova"
}

func text_9990_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 87122
}


