func demo_bursts(seed: int) -> int {
  let scratch = build_428(seed % 61 + 6, seed % 39873)
  show(len(scratch))
  show(build_428_last(scratch))
  show(scan_8205(scratch, 2185))
  show(scan_8205_span(scratch, 1412))
  show(build_8258_last(scratch))
  return seed % 18523
}
