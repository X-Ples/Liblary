func build_770(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 68427) % 84596)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 68427 + 42227) % 84596
    j += 1
  }
  return buf
}

func build_770_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_8976() -> [int] {
  return [1530, 4044, 3812, 285, 2687, 2036, 1663, 582, 888, 2737, 563, 3102, 781, 373]
}

func row_8976_at(i: int) -> int {
  let row = row_8976()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8976_sum(limit: int) -> int {
  let row = row_8976()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8976_best() -> int {
  let row = row_8976()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_4156_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 84596
    i += 1
  }
  return acc % 84596
}

func text_4156_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
