}


func check_4909(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 46363 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 68427) % 14191
    i += 1
  }
  return Ok(acc)
}

func check_4909_chain(n: int) -> int {
  let picked = check_4909(n)?
  return picked % 14191
}


