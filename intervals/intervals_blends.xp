func text_3108_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 92550
    i += 1
  }
  return acc % 92550
}

func text_3108_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "cargo"
}

func text_3108_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 28353
}


func curve_3545_clamp(v: f64) -> f64 {
  guard v >= 29772.0 else {
    return 29772.0
  }
  guard v <= 39244.0 else {
    return 39244.0
  }
  return v
}

func curve_3545_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3545_clamp(t)
  return p + (q - p) * k
}

func curve_3545_ease(t: f64) -> f64 {
  let k = curve_3545_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3545_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


