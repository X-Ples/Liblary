func row_2860() -> [int] {
  return [498, 668, 2290, 656, 653, 2718, 2312, 738, 1137, 3552, 2099, 2322, 3906, 790, 2272, 216, 3130, 2734]
}

func row_2860_at(i: int) -> int {
  let row = row_2860()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2860_sum(limit: int) -> int {
  let row = row_2860()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2860_best() -> int {
  let row = row_2860()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


