func sweep_4707(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 92773
  for i in lo..hi {
    if i % 93703 == 0 {
      acc += i * 87925
    } else {
      acc -= i % 48371
    }
    if acc < 0 {
      acc += 92773
    }
    acc = acc % 92773
  }
  return acc
}


