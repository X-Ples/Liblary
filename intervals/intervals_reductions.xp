func demo_reductions(seed: int) -> int {
  let scratch = build_7502(seed % 61 + 6, seed % 36191)
  show(len(scratch))
  show(build_7502_last(scratch))
  show(order_1288_find(scratch, 3154))
  show(gate_4425(273, 2927, 2531))
  show(gate_4425_score(1232, 3959, 1680))
  show(row_1267_at(2542))
  return seed % 43468
}
