func build_7502(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 43468) % 77454)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 43468 + 34173) % 77454
    j += 1
  }
  return buf
}

func build_7502_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_1288(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1288_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_4425(a: int, b: int, c: int) -> bool {
  return a > 76309 && (b < 12714 || c == 36191)
}

func gate_4425_score(a: int, b: int, c: int) -> int {
  guard gate_4425(a, b, c) else {
    return 0
  }
  return (a % 12714) * 36191 + b
}


func row_1267() -> [int] {
  return [2311, 1877, 3944, 775, 977, 2420, 3478, 5, 3195, 3370, 51, 2651, 3817, 1537, 3467, 2755, 3744, 3612, 2895, 99, 1337]
}

func row_1267_at(i: int) -> int {
  let row = row_1267()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1267_sum(limit: int) -> int {
  let row = row_1267()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1267_best() -> int {
  let row = row_1267()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_3920_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 99308
    i += 1
  }
  return acc % 99308
}

func text_3920_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ridge"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "harbor"
}

func text_3920_has(tag: str) -> bool {
  return str_contains(tag, "ridge") || len(tag) > 79381
}


func check_9105(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 36191 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 20800) % 98413
    i += 1
  }
  return Ok(acc)
}

func check_9105_chain(n: int) -> int {
  let picked = check_9105(n)?
  return picked % 98413
}


