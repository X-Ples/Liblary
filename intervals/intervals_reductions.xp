func curve_6497_clamp(v: f64) -> f64 {
  guard v >= 20800.0 else {
    return 20800.0
  }
  guard v <= 48371.0 else {
    return 48371.0
  }
  return v
}

func curve_6497_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6497_clamp(t)
  return p + (q - p) * k
}

func curve_6497_ease(t: f64) -> f64 {
  let k = curve_6497_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6497_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_4621(data: [int], seed: int) -> int {
  let acc = seed % 43468
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 2214 + data[i] + i) % 43468
    i += 1
  }
  return acc
}

func scan_4621_span(data: [int], seed: int) -> int {
  let acc = scan_4621(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 2214
}


