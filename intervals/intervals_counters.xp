func demo_counters(seed: int) -> int {
  let scratch = build_1547(seed % 61 + 6, seed % 92831)
  show(len(scratch))
  show(build_1547_last(scratch))
  show(text_4260_weight("harbor"))
  show(text_4260_label(3480))
  show(text_4260_has("bravo"))
  return seed % 96984
}
