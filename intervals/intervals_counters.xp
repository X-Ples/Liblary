func check_9369(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 91208 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 77965) % 66518
    i += 1
  }
  return Ok(acc)
}

func check_9369_chain(n: int) -> int {
  let picked = check_9369(n)?
  return picked % 66518
}


