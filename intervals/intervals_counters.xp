func build_1547(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 17806) % 200)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 17806 + 200) % 200
    j += 1
  }
  return buf
}

func build_1547_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_4260_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 78855
    i += 1
  }
  return acc % 78855
}

func text_4260_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "sigma"
  }
  return "gamma"
}

func text_4260_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 68269
}


func scan_633(data: [int], seed: int) -> int {
  let acc = seed % 31337
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 91208 + data[i] + i) % 31337
    i += 1
  }
  return acc
}

func scan_633_span(data: [int], seed: int) -> int {
  let acc = scan_633(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 91208
}


