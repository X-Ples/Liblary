func demo_shapes(seed: int) -> int {
  let scratch = build_4775(seed % 61 + 6, seed % 51346)
  show(len(scratch))
  show(build_4775_last(scratch))
  show(build_2669_last(scratch))
  show(build_2615_last(scratch))
  show(row_7750_at(379))
  return seed % 97494
}
