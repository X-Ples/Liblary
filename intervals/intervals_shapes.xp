}

func row_7750_best() -> int {
  let row = row_7750()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_7865(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 10363 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 52134) % 60997
    i += 1
  }
  return Ok(acc)
}

func check_7865_chain(n: int) -> int {
  let picked = check_7865(n)?
  return picked % 60997
}


