func scan_9321(data: [int], seed: int) -> int {
  let acc = seed % 82504
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 52712 + data[i] + i) % 82504
    i += 1
  }
  return acc
}

func scan_9321_span(data: [int], seed: int) -> int {
  let acc = scan_9321(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 52712
}


