func check_3087(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 13181 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 18387) % 51072
    i += 1
  }
  return Ok(acc)
}

func check_3087_chain(n: int) -> int {
  let picked = check_3087(n)?
  return picked % 51072
}


