func sweep_7628(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 93266
  for i in lo..hi {
    if i % 62138 == 0 {
      acc += i * 13424
    } else {
      acc -= i % 63390
    }
    if acc < 0 {
      acc += 58503
    }
    acc = acc % 58503
  }
  return acc
}


func scan_451(data: [int], seed: int) -> int {
  let acc = seed % 68821
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 47975 + data[i] + i) % 68821
    i += 1
  }
  return acc
}

func scan_451_span(data: [int], seed: int) -> int {
  let acc = scan_451(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 47975
}


