func gate_8551(a: int, b: int, c: int) -> bool {
  return a > 42381 && (b < 79694 || c == 20341)
}

func gate_8551_score(a: int, b: int, c: int) -> int {
  guard gate_8551(a, b, c) else {
    return 0
  }
  return (a % 79694) * 20341 + b
}


