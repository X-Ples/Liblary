func sweep_3917(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10854
  for i in lo..hi {
    if i % 27748 == 0 {
      acc += i * 21582
    } else {
      acc -= i % 76192
    }
    if acc < 0 {
      acc += 59446
    }
    acc = acc % 59446
  }
  return acc
}


