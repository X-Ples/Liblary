func demo_ops(seed: int) -> int {
  let scratch = build_2366(seed % 61 + 6, seed % 21582)
  show(len(scratch))
  show(scan_5940(scratch, 3618))
  show(scan_5940_span(scratch, 2029))
  show(build_2366_last(scratch))
  show(check_2807_chain(999))
  show(gate_6729(3556, 146, 1992))
  show(gate_6729_score(2788, 1855, 105))
  return seed % 1624
}
