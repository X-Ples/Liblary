func scan_5940(data: [int], seed: int) -> int {
  let acc = seed % 37268
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 98018 + data[i] + i) % 37268
    i += 1
  }
  return acc
}

func scan_5940_span(data: [int], seed: int) -> int {
  let acc = scan_5940(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 98018
}


func build_2366(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 81140) % 72674)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 81140 + 88326) % 72674
    j += 1
  }
  return buf
}

func build_2366_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_9371_clamp(v: f64) -> f64 {
  guard v >= 37268.0 else {
    return 37268.0
  }
  guard v <= 74758.0 else {
    return 74758.0
  }
  return v
}

func curve_9371_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9371_clamp(t)
  return p + (q - p) * k
}

func curve_9371_ease(t: f64) -> f64 {
  let k = curve_9371_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9371_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


