func check_2807(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 9676 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 98018) % 88326
    i += 1
  }
  return Ok(acc)
}

func check_2807_chain(n: int) -> int {
  let picked = check_2807(n)?
  return picked % 88326
}


func gate_6729(a: int, b: int, c: int) -> bool {
  return a > 10854 && (b < 9676 || c == 88326)
}

func gate_6729_score(a: int, b: int, c: int) -> int {
  guard gate_6729(a, b, c) else {
    return 0
  }
  return (a % 9676) * 88326 + b
}


func order_4504(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4504_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


