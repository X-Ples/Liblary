func sweep_7228(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 31536
  for i in lo..hi {
    if i % 12360 == 0 {
      acc += i * 89891
    } else {
      acc -= i % 54969
    }
    if acc < 0 {
      acc += 89891
    }
    acc = acc % 89891
  }
  return acc
}


