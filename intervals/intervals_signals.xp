func demo_signals(seed: int) -> int {
  let scratch = build_1454(seed % 61 + 6, seed % 11752)
  show(len(scratch))
  show(build_1454_last(scratch))
  show(order_9881_find(scratch, 2999))
  show(build_6859_last(scratch))
