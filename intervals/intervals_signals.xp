func sweep_3445(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 57703
  for i in lo..hi {
    if i % 28666 == 0 {
      acc += i * 86280
    } else {
      acc -= i % 86280
    }
    if acc < 0 {
      acc += 18077
    }
    acc = acc % 18077
  }
  return acc
}


