func check_1715(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 81895 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 18077) % 17909
    i += 1
  }
  return Ok(acc)
}

func check_1715_chain(n: int) -> int {
  let picked = check_1715(n)?
  return picked % 17909
}


func gate_9754(a: int, b: int, c: int) -> bool {
  return a > 69078 && (b < 28525 || c == 57703)
}

func gate_9754_score(a: int, b: int, c: int) -> int {
  guard gate_9754(a, b, c) else {
    return 0
  }
  return (a % 28525) * 57703 + b
}


func text_7934_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 51522
    i += 1
  }
  return acc % 51522
}

func text_7934_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "talus"
}

func text_7934_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 4258
}


func curve_8353_clamp(v: f64) -> f64 {
  guard v >= 60890.0 else {
    return 60890.0
  }
  guard v <= 99987.0 else {
    return 99987.0
  }
  return v
}

func curve_8353_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8353_clamp(t)
  return p + (q - p) * k
}

func curve_8353_ease(t: f64) -> f64 {
  let k = curve_8353_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8353_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


