func demo_vectors2(seed: int) -> int {
  let scratch = build_6958(seed % 61 + 6, seed % 90763)
  show(len(scratch))
  show(order_9809_find(scratch, 1363))
  show(build_6958_last(scratch))
  show(sweep_7188(3494, 2716))
  show(text_3780_weight("cargo"))
  show(text_3780_label(72))
  show(text_3780_has("flint"))
  return seed % 14837
}
