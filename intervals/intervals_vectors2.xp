func scan_9855(data: [int], seed: int) -> int {
  let acc = seed % 74628
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 20171 + data[i] + i) % 74628
    i += 1
  }
  return acc
}

func scan_9855_span(data: [int], seed: int) -> int {
  let acc = scan_9855(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 20171
}


