func order_9809(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9809_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_6958(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 1318) % 87192)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 1318 + 87192) % 87192
    j += 1
  }
  return buf
}

func build_6958_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_7188(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 82378
  for i in lo..hi {
    if i % 9594 == 0 {
      acc += i * 59096
    } else {
      acc -= i % 74628
    }
    if acc < 0 {
      acc += 82378
    }
    acc = acc % 82378
  }
  return acc
}


func text_3780_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 38207
    i += 1
  }
  return acc % 38207
}

