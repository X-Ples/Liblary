  return a > 82378 && (b < 9594 || c == 9594)
}

func gate_3649_score(a: int, b: int, c: int) -> int {
  guard gate_3649(a, b, c) else {
    return 0
  }
  return (a % 9594) * 9594 + b
}


func check_7206(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 14837 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 20776) % 1318
    i += 1
  }
  return Ok(acc)
}

func check_7206_chain(n: int) -> int {
  let picked = check_7206(n)?
  return picked % 1318
}


