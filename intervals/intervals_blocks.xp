func check_8053(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 48240 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 75748) % 85600
    i += 1
  }
  return Ok(acc)
}

func check_8053_chain(n: int) -> int {
  let picked = check_8053(n)?
  return picked % 85600
}


