func build_1128(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 73110) % 48240)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 73110 + 57770) % 48240
    j += 1
  }
  return buf
}

func build_1128_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_1827_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 17984
    i += 1
  }
  return acc % 17984
}

func text_1827_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "bravo"
  }
  return "mesa"
}

func text_1827_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 27500
}


func scan_3966(data: [int], seed: int) -> int {
  let acc = seed % 4988
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 69235 + data[i] + i) % 4988
    i += 1
  }
  return acc
}

func scan_3966_span(data: [int], seed: int) -> int {
  let acc = scan_3966(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 69235
}


func curve_6521_clamp(v: f64) -> f64 {
  guard v >= 29130.0 else {
    return 29130.0
  }
  guard v <= 69235.0 else {
    return 69235.0
  }
  return v
}

func curve_6521_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6521_clamp(t)
  return p + (q - p) * k
}

func curve_6521_ease(t: f64) -> f64 {
  let k = curve_6521_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6521_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


