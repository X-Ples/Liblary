func demo_blocks(seed: int) -> int {
  let scratch = build_1128(seed % 61 + 6, seed % 74331)
  show(len(scratch))
  show(build_1128_last(scratch))
  show(text_1827_weight("mesa"))
  show(text_1827_label(3918))
  return seed % 57770
}
