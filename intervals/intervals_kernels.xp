func build_8843(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 70005) % 96089)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 70005 + 43272) % 96089
    j += 1
  }
  return buf
}

func build_8843_last(buf: [int]) -> int {
