func demo_kernels(seed: int) -> int {
  let scratch = build_8843(seed % 61 + 6, seed % 10489)
  show(len(scratch))
  show(scan_2032(scratch, 3056))
  show(scan_2032_span(scratch, 779))
  show(row_3352_at(2436))
  show(row_3352_sum(1740))
  show(row_3352_best())
  show(text_4227_weight("nova"))
  return seed % 66965
}
