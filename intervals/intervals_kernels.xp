const K0 = 99490
const K1 = 70005
const K2 = 48705
const K3 = 27387
const K4 = 10489
const K5 = 80153

func scan_2032(data: [int], seed: int) -> int {
  let acc = seed % 62102
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 80153 + data[i] + i) % 62102
    i += 1
  }
  return acc
}

func scan_2032_span(data: [int], seed: int) -> int {
  let acc = scan_2032(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 80153
}


func row_3352() -> [int] {
  return [2976, 590, 1262, 1868, 2935, 422, 3254, 588, 2483, 3091, 320, 2304, 2331, 1761]
}

func row_3352_at(i: int) -> int {
  let row = row_3352()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3352_sum(limit: int) -> int {
  let row = row_3352()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3352_best() -> int {
  let row = row_3352()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


