func check_1959(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 26249 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 72547) % 19546
    i += 1
  }
  return Ok(acc)
}

func check_1959_chain(n: int) -> int {
  let picked = check_1959(n)?
  return picked % 19546
}


