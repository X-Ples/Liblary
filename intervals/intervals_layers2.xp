func sweep_3388(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 16125
  for i in lo..hi {
    if i % 72936 == 0 {
      acc += i * 80556
    } else {
      acc -= i % 96419
    }
    if acc < 0 {
      acc += 46390
    }
    acc = acc % 46390
  }
  return acc
}


func build_5420(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 10848) % 6543)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 10848 + 16125) % 6543
    j += 1
  }
  return buf
}

func build_5420_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_8840(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 14491
  for i in lo..hi {
    if i % 44502 == 0 {
      acc += i * 16125
    } else {
      acc -= i % 16125
    }
    if acc < 0 {
      acc += 33335
    }
    acc = acc % 33335
  }
  return acc
}


func order_1622(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1622_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func scan_6030(data: [int], seed: int) -> int {
  let acc = seed % 57143
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 7887 + data[i] + i) % 57143
    i += 1
  }
  return acc
}

func scan_6030_span(data: [int], seed: int) -> int {
  let acc = scan_6030(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 7887
}


func grid_8374_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 43192 + c * 29595 + seed) % 29595)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8374_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 29595 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_5997(a: int, b: int, c: int) -> bool {
  return a > 44502 && (b < 45773 || c == 7393)
}

func gate_5997_score(a: int, b: int, c: int) -> int {
  guard gate_5997(a, b, c) else {
    return 0
  }
  return (a % 45773) * 7393 + b
}


