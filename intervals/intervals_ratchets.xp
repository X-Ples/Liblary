func scan_372(data: [int], seed: int) -> int {
  let acc = seed % 65135
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 19657 + data[i] + i) % 65135
    i += 1
  }
  return acc
}

func scan_372_span(data: [int], seed: int) -> int {
  let acc = scan_372(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 19657
}


