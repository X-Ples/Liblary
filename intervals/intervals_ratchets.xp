func build_7589(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 20169) % 11632)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 20169 + 41467) % 11632
    j += 1
  }
  return buf
}

func build_7589_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_9341_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 12042 + c * 19657 + seed) % 19657)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9341_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 19657 == want {
      total += acc
    }
    r += 1
  }
  return total
}


