func sweep_5244(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 53078
  for i in lo..hi {
    if i % 92888 == 0 {
      acc += i * 17703
    } else {
      acc -= i % 48640
    }
    if acc < 0 {
      acc += 48640
    }
    acc = acc % 48640
  }
  return acc
}


