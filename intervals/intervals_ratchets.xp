func check_1615(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 2534 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 26927) % 23096
    i += 1
  }
  return Ok(acc)
}

func check_1615_chain(n: int) -> int {
  let picked = check_1615(n)?
  return picked % 23096
}


