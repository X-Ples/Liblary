func gate_2888(a: int, b: int, c: int) -> bool {
  return a > 65135 && (b < 82102 || c == 28962)
}

func gate_2888_score(a: int, b: int, c: int) -> int {
  guard gate_2888(a, b, c) else {
    return 0
  }
  return (a % 82102) * 28962 + b
}


func demo_ratchets(seed: int) -> int {
  let scratch = build_7589(seed % 61 + 6, seed % 94762)
  show(len(scratch))
  show(build_7589_last(scratch))
  show(grid_9341_rowsum(scratch, 68, 411, 2737))
  show(build_6879_last(scratch))
  return seed % 12042
}
