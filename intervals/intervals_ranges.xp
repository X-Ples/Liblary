func sweep_2350(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 22486
  for i in lo..hi {
    if i % 63982 == 0 {
      acc += i * 38606
    } else {
      acc -= i % 85837
    }
    if acc < 0 {
      acc += 15944
    }
    acc = acc % 15944
  }
  return acc
}


