func row_205() -> [int] {
  return [78, 2830, 1683, 3867, 2995, 922, 767, 805, 3570, 3815, 225, 1824, 654, 3695, 1652, 85, 500, 3797, 3967, 2643]
}

func row_205_at(i: int) -> int {
  let row = row_205()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_205_sum(limit: int) -> int {
  let row = row_205()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_205_best() -> int {
  let row = row_205()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_9464(data: [int], seed: int) -> int {
  let acc = seed % 68239
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 22486 + data[i] + i) % 68239
    i += 1
  }
  return acc
}

func scan_9464_span(data: [int], seed: int) -> int {
  let acc = scan_9464(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 22486
}


func build_4298(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 49663) % 49663)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 49663 + 28866) % 49663
    j += 1
  }
  return buf
}

func build_4298_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


