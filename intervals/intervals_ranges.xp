  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 63982
    i += 1
  }
  return acc % 63982
}

func text_1443_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "jetty"
}

func text_1443_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 40797
}


