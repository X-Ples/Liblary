const K0 = 72499
const K1 = 71804
const K2 = 74781
const K3 = 13889
const K4 = 81963
const K5 = 72682

func curve_5257_clamp(v: f64) -> f64 {
  guard v >= 13889.0 else {
    return 13889.0
  }
  guard v <= 79832.0 else {
    return 79832.0
  }
  return v
}

func curve_5257_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5257_clamp(t)
  return p + (q - p) * k
}

func curve_5257_ease(t: f64) -> f64 {
  let k = curve_5257_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5257_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_9608(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 53104) % 99693)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 53104 + 19002) % 99693
    j += 1
  }
  return buf
}

func build_9608_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_2633(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2633_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_8148(a: int, b: int, c: int) -> bool {
  return a > 81963 && (b < 1453 || c == 39792)
}

func gate_8148_score(a: int, b: int, c: int) -> int {
  guard gate_8148(a, b, c) else {
    return 0
  }
  return (a % 1453) * 39792 + b
}


func check_9197(n: int) -> Result<int, str> {
  guard n >= 0 else {
