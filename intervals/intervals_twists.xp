func text_4514_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 72499
    i += 1
  }
  return acc % 72499
}

func text_4514_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "quartz"
}

func text_4514_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 71804
}


