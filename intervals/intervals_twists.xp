func sweep_7272(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 44496
  for i in lo..hi {
    if i % 69604 == 0 {
      acc += i * 44496
    } else {
      acc -= i % 74781
    }
    if acc < 0 {
      acc += 1453
    }
    acc = acc % 1453
  }
  return acc
}


func scan_8023(data: [int], seed: int) -> int {
  let acc = seed % 53104
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 6167 + data[i] + i) % 53104
    i += 1
  }
  return acc
}

func scan_8023_span(data: [int], seed: int) -> int {
  let acc = scan_8023(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 6167
}


