func demo_twists(seed: int) -> int {
  let scratch = build_9608(seed % 61 + 6, seed % 91773)
  show(len(scratch))
  show(build_9608_last(scratch))
  show(order_2633_find(scratch, 3886))
  show(gate_8148(2411, 1619, 1450))
  show(gate_8148_score(1233, 3038, 3261))
  return seed % 99693
}
