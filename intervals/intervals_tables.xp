func check_6352(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 69690 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 18247) % 92360
    i += 1
  }
  return Ok(acc)
}

func check_6352_chain(n: int) -> int {
  let picked = check_6352(n)?
  return picked % 92360
}


