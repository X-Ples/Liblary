func demo_tables(seed: int) -> int {
  let scratch = build_2318(seed % 61 + 6, seed % 36701)
  show(len(scratch))
  show(text_5393_weight("harbor"))
  show(text_5393_label(2361))
  show(text_5393_has("flint"))
