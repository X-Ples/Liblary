func check_8019(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 37153 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 8046) % 3886
    i += 1
  }
  return Ok(acc)
}

func check_8019_chain(n: int) -> int {
  let picked = check_8019(n)?
  return picked % 3886
}


