func sweep_7990(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 99870
  for i in lo..hi {
    if i % 160 == 0 {
      acc += i * 92669
    } else {
      acc -= i % 27369
    }
    if acc < 0 {
      acc += 37153
    }
    acc = acc % 37153
  }
  return acc
}


func demo_helpers(seed: int) -> int {
  let scratch = build_1741(seed % 61 + 6, seed % 19683)
  show(len(scratch))
  show(sweep_9457(2037, 2694))
  show(build_1741_last(scratch))
  show(grid_2486_rowsum(scratch, 1971, 2230, 1731))
  show(scan_1523(scratch, 3088))
  show(scan_1523_span(scratch, 1274))
  return seed % 52517
}
