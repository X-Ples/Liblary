func sweep_9457(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 37153
  for i in lo..hi {
    if i % 53674 == 0 {
      acc += i * 20743
    } else {
      acc -= i % 65624
    }
    if acc < 0 {
      acc += 160
    }
    acc = acc % 160
  }
  return acc
}


func build_1741(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 52517) % 92669)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 52517 + 54278) % 92669
    j += 1
  }
  return buf
}

func build_1741_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_2486_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 19683 + c * 59218 + seed) % 59218)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2486_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 59218 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_1523(data: [int], seed: int) -> int {
  let acc = seed % 59218
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 20743 + data[i] + i) % 59218
    i += 1
  }
  return acc
}

func scan_1523_span(data: [int], seed: int) -> int {
  let acc = scan_1523(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 20743
}


