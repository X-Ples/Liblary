func check_5461(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 27435 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 96616) % 88861
    i += 1
  }
  return Ok(acc)
}

func check_5461_chain(n: int) -> int {
  let picked = check_5461(n)?
  return picked % 88861
}


