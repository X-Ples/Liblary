func build_6484(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 98089) % 23616)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 98089 + 24849) % 23616
    j += 1
  }
  return buf
}

func build_6484_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_1280(data: [int], seed: int) -> int {
  let acc = seed % 21583
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 27435 + data[i] + i) % 21583
    i += 1
  }
  return acc
}

func scan_1280_span(data: [int], seed: int) -> int {
  let acc = scan_1280(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 27435
}


func text_9640_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 20971
    i += 1
  }
  return acc % 20971
}

func text_9640_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "kilo"
}

func text_9640_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 43801
}


