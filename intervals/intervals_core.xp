func demo_core(seed: int) -> int {
  let scratch = build_6484(seed % 61 + 6, seed % 63750)
  show(len(scratch))
  show(build_6484_last(scratch))
  show(scan_1280(scratch, 1697))
  show(scan_1280_span(scratch, 2823))
  show(text_9640_weight("bravo"))
  show(text_9640_label(348))
  return seed % 31279
}
