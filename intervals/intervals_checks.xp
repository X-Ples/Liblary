func build_1260(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 54368) % 61594)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 54368 + 75562) % 61594
    j += 1
  }
  return buf
}

func build_1260_last(buf: [int]) -> int {
