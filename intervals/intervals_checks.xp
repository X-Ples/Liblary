func check_133(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 53113 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 52501) % 44376
    i += 1
  }
  return Ok(acc)
}

func check_133_chain(n: int) -> int {
  let picked = check_133(n)?
  return picked % 44376
}


