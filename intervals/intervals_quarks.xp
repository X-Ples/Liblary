func demo_quarks(seed: int) -> int {
  let scratch = build_1067(seed % 61 + 6, seed % 93584)
  show(len(scratch))
  show(build_1067_last(scratch))
  show(scan_7294(scratch, 601))
  show(scan_7294_span(scratch, 1648))
  show(gate_2053(683, 66, 2127))
  return seed % 18855
}
