func text_2754_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "sigma"
  }
  return "lumen"
}

func text_2754_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 32229
}


func grid_3927_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 61273 + c * 32229 + seed) % 32229)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3927_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 32229 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_385(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 76438 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 43680) % 52620
    i += 1
  }
  return Ok(acc)
}

func check_385_chain(n: int) -> int {
  let picked = check_385(n)?
  return picked % 52620
}


