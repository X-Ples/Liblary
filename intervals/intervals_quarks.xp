func build_1067(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 26251) % 26251)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 26251 + 8785) % 26251
    j += 1
  }
  return buf
}

func build_1067_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_7294(data: [int], seed: int) -> int {
  let acc = seed % 69730
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 68962 + data[i] + i) % 69730
    i += 1
  }
  return acc
}

func scan_7294_span(data: [int], seed: int) -> int {
  let acc = scan_7294(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 68962
}


func gate_2053(a: int, b: int, c: int) -> bool {
  return a > 14633 && (b < 65345 || c == 52620)
}

func gate_2053_score(a: int, b: int, c: int) -> int {
  guard gate_2053(a, b, c) else {
    return 0
  }
  return (a % 65345) * 52620 + b
}


