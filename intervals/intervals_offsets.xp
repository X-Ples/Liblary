const K0 = 28800
const K1 = 85886
const K2 = 40031
const K3 = 97581
const K4 = 4199
const K5 = 93116
const K6 = 97164

func order_3516(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3516_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_1793(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 49345) % 8898)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 49345 + 9558) % 8898
    j += 1
  }
  return buf
}

func build_1793_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_948(a: int, b: int, c: int) -> bool {
  return a > 67819 && (b < 96489 || c == 97581)
}

func gate_948_score(a: int, b: int, c: int) -> int {
  guard gate_948(a, b, c) else {
    return 0
  }
  return (a % 96489) * 97581 + b
}


func grid_4216_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 24511 + c * 18852 + seed) % 18852)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4216_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 18852 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_2430_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 82269
    i += 1
  }
  return acc % 82269
}

func text_2430_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "cargo"
}

func text_2430_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 24511
}


func check_757(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 40031 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 40031) % 38785
    i += 1
  }
  return Ok(acc)
}

func check_757_chain(n: int) -> int {
  let picked = check_757(n)?
  return picked % 38785
}


func scan_7014(data: [int], seed: int) -> int {
  let acc = seed % 29213
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 8898 + data[i] + i) % 29213
    i += 1
  }
  return acc
}

func scan_7014_span(data: [int], seed: int) -> int {
  let acc = scan_7014(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 8898
}


