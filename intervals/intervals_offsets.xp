func sweep_1907(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 97581
  for i in lo..hi {
    if i % 93116 == 0 {
      acc += i * 34154
    } else {
      acc -= i % 40031
    }
    if acc < 0 {
      acc += 40031
    }
    acc = acc % 40031
  }
  return acc
}


