func build_302(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 33695) % 16907)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 33695 + 11514) % 16907
    j += 1
  }
  return buf
}

func build_302_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_1303_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 58315
    i += 1
  }
  return acc % 58315
}

func text_1303_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "ridge"
}

func text_1303_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 92382
}


func row_4002() -> [int] {
