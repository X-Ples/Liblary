func demo_walkers(seed: int) -> int {
  let scratch = build_302(seed % 61 + 6, seed % 32458)
  show(len(scratch))
  show(build_302_last(scratch))
  show(text_1303_weight("ion"))
  show(text_1303_label(1411))
  show(text_1303_has("delta"))
  return seed % 68166
}
