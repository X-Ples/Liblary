}


func check_2730(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 31199 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 58779) % 53029
    i += 1
  }
  return Ok(acc)
}

func check_2730_chain(n: int) -> int {
  let picked = check_2730(n)?
  return picked % 53029
}


