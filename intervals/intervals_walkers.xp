func sweep_7266(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 51142
  for i in lo..hi {
    if i % 51142 == 0 {
      acc += i * 76396
    } else {
      acc -= i % 45192
    }
    if acc < 0 {
      acc += 12650
    }
    acc = acc % 12650
  }
