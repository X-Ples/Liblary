func demo_trims(seed: int) -> int {
  let scratch = build_481(seed % 61 + 6, seed % 49165)
  show(len(scratch))
  show(gate_4068(59, 3664, 3559))
  show(gate_4068_score(1021, 104, 3725))
  show(text_4856_weight("ember"))
  show(text_4856_label(3806))
  show(text_4856_has("lumen"))
  show(build_481_last(scratch))
  return seed % 44663
}
