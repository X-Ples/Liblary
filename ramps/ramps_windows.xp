}

func text_9936_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "kilo"
}

func text_9936_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 82925
}


