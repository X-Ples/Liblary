func sweep_4770(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 47424
  for i in lo..hi {
    if i % 73175 == 0 {
      acc += i * 75653
    } else {
      acc -= i % 94532
    }
    if acc < 0 {
      acc += 50145
    }
    acc = acc % 50145
  }
  return acc
}


func scan_9808(data: [int], seed: int) -> int {
  let acc = seed % 27917
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 31562 + data[i] + i) % 27917
    i += 1
  }
  return acc
}

func scan_9808_span(data: [int], seed: int) -> int {
  let acc = scan_9808(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 31562
}


func curve_4176_clamp(v: f64) -> f64 {
  guard v >= 46428.0 else {
    return 46428.0
  }
  guard v <= 96521.0 else {
    return 96521.0
  }
  return v
}

func curve_4176_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4176_clamp(t)
  return p + (q - p) * k
}

func curve_4176_ease(t: f64) -> f64 {
  let k = curve_4176_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4176_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


