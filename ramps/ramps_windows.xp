func demo_windows(seed: int) -> int {
  let scratch = build_1940(seed % 61 + 6, seed % 5317)
  show(len(scratch))
  show(sweep_4770(2293, 1978))
  show(scan_9808(scratch, 131))
  show(scan_9808_span(scratch, 579))
  show(build_1940_last(scratch))
  show(build_1047_last(scratch))
  return seed % 15220
}
