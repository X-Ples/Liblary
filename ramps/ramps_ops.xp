func check_8572(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 130 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 3118) % 130
    i += 1
  }
  return Ok(acc)
}

func check_8572_chain(n: int) -> int {
  let picked = check_8572(n)?
  return picked % 130
}


