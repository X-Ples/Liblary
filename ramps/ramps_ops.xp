func sweep_7937(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 39208
  for i in lo..hi {
    if i % 130 == 0 {
      acc += i * 80693
    } else {
      acc -= i % 130
    }
    if acc < 0 {
      acc += 44143
    }
    acc = acc % 44143
  }
  return acc
}


