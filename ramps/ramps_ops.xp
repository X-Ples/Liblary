func scan_6308(data: [int], seed: int) -> int {
  let acc = seed % 66266
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 20371 + data[i] + i) % 66266
    i += 1
  }
  return acc
}

func scan_6308_span(data: [int], seed: int) -> int {
  let acc = scan_6308(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 20371
}


