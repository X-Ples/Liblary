func text_6614_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 47647
    i += 1
  }
  return acc % 47647
}

func text_6614_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "bravo"
}

func text_6614_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 64299
}


func demo_ops(seed: int) -> int {
  let scratch = build_2272(seed % 61 + 6, seed % 41749)
  show(len(scratch))
  show(row_4383_at(2469))
  show(row_4383_sum(1156))
  show(row_4383_best())
  show(build_2272_last(scratch))
  show(build_9069_last(scratch))
  return seed % 66266
}
