func row_4383() -> [int] {
  return [1118, 4016, 3097, 2689, 1071, 2550, 2420, 3438, 2233, 2107, 3992, 2527, 2702, 565]
}

func row_4383_at(i: int) -> int {
  let row = row_4383()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4383_sum(limit: int) -> int {
  let row = row_4383()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4383_best() -> int {
  let row = row_4383()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_2272(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 80693) % 72364)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 80693 + 37407) % 72364
    j += 1
  }
  return buf
}

func build_2272_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


