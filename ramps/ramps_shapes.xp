func demo_shapes(seed: int) -> int {
  let scratch = build_6265(seed % 61 + 6, seed % 44574)
  show(len(scratch))
  show(order_228_find(scratch, 3353))
  show(build_6265_last(scratch))
  show(order_4645_find(scratch, 38))
