func check_8987(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 39655 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 97371) % 59191
    i += 1
  }
  return Ok(acc)
}

func check_8987_chain(n: int) -> int {
  let picked = check_8987(n)?
  return picked % 59191
}


