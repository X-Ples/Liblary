func sweep_3514(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 44574
  for i in lo..hi {
    if i % 49622 == 0 {
      acc += i * 97371
    } else {
      acc -= i % 70059
    }
    if acc < 0 {
      acc += 32819
    }
    acc = acc % 32819
  }
  return acc
}


