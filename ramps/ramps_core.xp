func build_8973(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 10024) % 4134)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 10024 + 78063) % 4134
    j += 1
  }
  return buf
}

func build_8973_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_7719(a: int, b: int, c: int) -> bool {
  return a > 99818 && (b < 72319 || c == 59600)
}

func gate_7719_score(a: int, b: int, c: int) -> int {
  guard gate_7719(a, b, c) else {
    return 0
  }
  return (a % 72319) * 59600 + b
}


func sweep_6269(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 78063
  for i in lo..hi {
    if i % 56829 == 0 {
      acc += i * 99818
    } else {
      acc -= i % 59600
    }
    if acc < 0 {
      acc += 47297
    }
    acc = acc % 47297
  }
  return acc
}


func curve_3107_clamp(v: f64) -> f64 {
  guard v >= 46778.0 else {
    return 46778.0
  }
  guard v <= 56167.0 else {
    return 56167.0
  }
  return v
}

func curve_3107_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3107_clamp(t)
  return p + (q - p) * k
}

func curve_3107_ease(t: f64) -> f64 {
  let k = curve_3107_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3107_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


