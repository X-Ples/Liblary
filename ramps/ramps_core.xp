func demo_core(seed: int) -> int {
  let scratch = build_8973(seed % 61 + 6, seed % 70804)
  show(len(scratch))
  show(build_8973_last(scratch))
  show(gate_7719(1986, 2573, 2646))
  show(gate_7719_score(1155, 2908, 1283))
  show(sweep_6269(3007, 2451))
  show(row_1985_at(2832))
  return seed % 44041
}
