func row_1985_at(i: int) -> int {
  let row = row_1985()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1985_sum(limit: int) -> int {
  let row = row_1985()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1985_best() -> int {
  let row = row_1985()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_6220(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 4134 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 59600) % 53356
    i += 1
  }
  return Ok(acc)
}

func check_6220_chain(n: int) -> int {
  let picked = check_6220(n)?
  return picked % 53356
}


func grid_3339_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 23579 + c * 59600 + seed) % 59600)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3339_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 59600 == want {
      total += acc
    }
    r += 1
  }
  return total
}


