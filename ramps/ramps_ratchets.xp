func demo_ratchets(seed: int) -> int {
  let scratch = build_3899(seed % 61 + 6, seed % 59028)
  show(len(scratch))
  show(order_4254_find(scratch, 2417))
  show(sweep_1387(2585, 2318))
  show(build_3899_last(scratch))
  show(scan_6462(scratch, 3705))
  show(scan_6462_span(scratch, 421))
  show(check_2302_chain(1230))
  return seed % 88318
}
