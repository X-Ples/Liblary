const K0 = 92723
const K1 = 1151
const K2 = 58967
const K3 = 71805
const K4 = 1151
const K5 = 31495

func order_4254(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4254_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_1387(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 92723
  for i in lo..hi {
    if i % 68200 == 0 {
      acc += i * 43345
    } else {
      acc -= i % 37941
    }
    if acc < 0 {
      acc += 68200
    }
    acc = acc % 68200
  }
  return acc
}


func build_3899(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 15636) % 92723)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 15636 + 31495) % 92723
    j += 1
  }
  return buf
}

func build_3899_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_6462(data: [int], seed: int) -> int {
  let acc = seed % 68200
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 31495 + data[i] + i) % 68200
    i += 1
  }
  return acc
}

func scan_6462_span(data: [int], seed: int) -> int {
  let acc = scan_6462(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 31495
}


func check_2302(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 68200 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 58967) % 33539
    i += 1
  }
  return Ok(acc)
}

func check_2302_chain(n: int) -> int {
  let picked = check_2302(n)?
  return picked % 33539
}


func curve_3519_clamp(v: f64) -> f64 {
  guard v >= 1928.0 else {
    return 1928.0
  }
  guard v <= 92072.0 else {
    return 92072.0
  }
  return v
}

func curve_3519_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3519_clamp(t)
  return p + (q - p) * k
}

func curve_3519_ease(t: f64) -> f64 {
  let k = curve_3519_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3519_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


