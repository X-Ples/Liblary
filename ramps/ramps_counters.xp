func build_2664(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 45416) % 15916)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 45416 + 27948) % 15916
    j += 1
  }
  return buf
}

func build_2664_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_4324_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 51907 + c * 41083 + seed) % 41083)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4324_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 41083 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func row_8337() -> [int] {
  return [2407, 367, 1187, 2669, 2689, 1209, 102, 2865, 1898, 3426, 3327, 142, 3970, 320]
}

func row_8337_at(i: int) -> int {
  let row = row_8337()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8337_sum(limit: int) -> int {
  let row = row_8337()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8337_best() -> int {
  let row = row_8337()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_2423(data: [int], seed: int) -> int {
  let acc = seed % 79030
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 27391 + data[i] + i) % 79030
    i += 1
  }
  return acc
}

func scan_2423_span(data: [int], seed: int) -> int {
  let acc = scan_2423(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 27391
}


