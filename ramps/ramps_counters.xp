func demo_counters(seed: int) -> int {
  let scratch = build_2664(seed % 61 + 6, seed % 27391)
  show(len(scratch))
  show(build_2664_last(scratch))
  show(grid_4324_rowsum(scratch, 3136, 546, 2422))
  show(row_8337_at(932))
  show(row_8337_sum(3758))
  show(row_8337_best())
  return seed % 50632
}
