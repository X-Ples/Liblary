func curve_3200_clamp(v: f64) -> f64 {
  guard v >= 79030.0 else {
    return 79030.0
  }
  guard v <= 91965.0 else {
    return 91965.0
  }
  return v
}

func curve_3200_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3200_clamp(t)
  return p + (q - p) * k
}

func curve_3200_ease(t: f64) -> f64 {
  let k = curve_3200_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3200_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_4443(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 67266
  for i in lo..hi {
    if i % 84991 == 0 {
      acc += i * 36826
    } else {
      acc -= i % 79030
    }
    if acc < 0 {
      acc += 84991
    }
    acc = acc % 84991
  }
  return acc
}


