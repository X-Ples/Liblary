func build_9917(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 57574) % 56626)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 57574 + 56021) % 56626
    j += 1
  }
  return buf
}

func build_9917_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_4012(data: [int], seed: int) -> int {
  let acc = seed % 67653
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 21343 + data[i] + i) % 67653
    i += 1
  }
  return acc
}

func scan_4012_span(data: [int], seed: int) -> int {
  let acc = scan_4012(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 21343
}


func check_5794(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 60689 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 99327) % 97398
    i += 1
  }
  return Ok(acc)
}

func check_5794_chain(n: int) -> int {
  let picked = check_5794(n)?
  return picked % 97398
}


func curve_3565_clamp(v: f64) -> f64 {
  guard v >= 60689.0 else {
    return 60689.0
  }
  guard v <= 97148.0 else {
    return 97148.0
  }
  return v
}

func curve_3565_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3565_clamp(t)
  return p + (q - p) * k
}

func curve_3565_ease(t: f64) -> f64 {
  let k = curve_3565_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3565_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_476() -> [int] {
  return [4072, 680, 1701, 1694, 147, 3179, 1604, 2966, 3552, 1789, 2970, 2340, 2557, 3653]
}

func row_476_at(i: int) -> int {
  let row = row_476()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_476_sum(limit: int) -> int {
  let row = row_476()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_476_best() -> int {
  let row = row_476()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_7553(a: int, b: int, c: int) -> bool {
  return a > 95403 && (b < 5413 || c == 31959)
}

func gate_7553_score(a: int, b: int, c: int) -> int {
  guard gate_7553(a, b, c) else {
    return 0
  }
  return (a % 5413) * 31959 + b
}


