func demo_offsets(seed: int) -> int {
  let scratch = build_9917(seed % 61 + 6, seed % 79605)
  show(len(scratch))
  show(build_9917_last(scratch))
  show(scan_4012(scratch, 800))
  show(scan_4012_span(scratch, 1065))
  show(check_5794_chain(1110))
  return seed % 5413
}
