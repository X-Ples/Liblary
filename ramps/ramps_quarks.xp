    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 9189 + 56098) % 72822
    j += 1
  }
  return buf
}

func build_7099_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_1039(a: int, b: int, c: int) -> bool {
  return a > 11214 && (b < 22954 || c == 37697)
}

func gate_1039_score(a: int, b: int, c: int) -> int {
  guard gate_1039(a, b, c) else {
