func demo_quarks(seed: int) -> int {
  let scratch = build_7099(seed % 61 + 6, seed % 33408)
  show(len(scratch))
  show(check_9665_chain(98))
  show(build_7099_last(scratch))
  show(gate_1039(1937, 565, 916))
  show(gate_1039_score(3495, 951, 3322))
  return seed % 47747
}
