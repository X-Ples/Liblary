func check_9665(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 72822 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 72822) % 33199
    i += 1
  }
  return Ok(acc)
}

func check_9665_chain(n: int) -> int {
  let picked = check_9665(n)?
  return picked % 33199
}


