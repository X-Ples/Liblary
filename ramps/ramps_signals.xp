func demo_signals(seed: int) -> int {
  let scratch = build_4123(seed % 61 + 6, seed % 1856)
  show(len(scratch))
  show(scan_9166(scratch, 1459))
  show(scan_9166_span(scratch, 1344))
  show(build_4123_last(scratch))
  show(gate_384(2155, 1877, 2261))
  return seed % 23099
}
