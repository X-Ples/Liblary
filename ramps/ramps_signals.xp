func scan_9166(data: [int], seed: int) -> int {
  let acc = seed % 8980
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 15931 + data[i] + i) % 8980
    i += 1
  }
  return acc
}

func scan_9166_span(data: [int], seed: int) -> int {
  let acc = scan_9166(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 15931
}


func build_4123(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 1856) % 22420)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 1856 + 99438) % 22420
    j += 1
  }
  return buf
}

func build_4123_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_384(a: int, b: int, c: int) -> bool {
  return a > 23099 && (b < 46775 || c == 3723)
}

func gate_384_score(a: int, b: int, c: int) -> int {
  guard gate_384(a, b, c) else {
    return 0
  }
  return (a % 46775) * 3723 + b
}


