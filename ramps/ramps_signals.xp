func sweep_3070(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 90910
  for i in lo..hi {
    if i % 40422 == 0 {
      acc += i * 23099
    } else {
      acc -= i % 99438
    }
    if acc < 0 {
      acc += 90910
    }
    acc = acc % 90910
  }
  return acc
}


