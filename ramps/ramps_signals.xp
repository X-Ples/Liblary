func row_940() -> [int] {
  return [3636, 49, 3132, 1629, 3263, 1013, 1971, 106, 3068, 2763, 3073, 1976, 1938, 3346, 2565, 2828, 4088, 2866, 2490]
}

func row_940_at(i: int) -> int {
  let row = row_940()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_940_sum(limit: int) -> int {
  let row = row_940()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_940_best() -> int {
  let row = row_940()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


