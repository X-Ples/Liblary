func row_8656() -> [int] {
  return [2529, 1262, 1905, 629, 3527, 1590, 3594, 1396, 2837, 3173, 3039, 1453, 255, 2772, 1819, 2330]
}

func row_8656_at(i: int) -> int {
  let row = row_8656()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8656_sum(limit: int) -> int {
  let row = row_8656()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8656_best() -> int {
  let row = row_8656()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


