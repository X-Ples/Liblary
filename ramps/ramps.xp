func check_5959(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 34828 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 93143) % 49475
    i += 1
  }
  return Ok(acc)
}

func check_5959_chain(n: int) -> int {
  let picked = check_5959(n)?
  return picked % 49475
}


