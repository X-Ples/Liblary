func text_2188_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "flint"
}

func text_2188_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 43184
}


