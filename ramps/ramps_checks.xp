func scan_2819(data: [int], seed: int) -> int {
  let acc = seed % 98638
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 61265 + data[i] + i) % 98638
    i += 1
  }
  return acc
}

func scan_2819_span(data: [int], seed: int) -> int {
  let acc = scan_2819(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 61265
}


