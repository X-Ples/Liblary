func row_7037() -> [int] {
  return [1251, 2568, 688, 477, 1530, 1215, 436, 1863, 3605, 1316, 3574, 1571, 3455, 3821, 2539, 1052, 1691, 1130, 3471, 1312, 102]
}

func row_7037_at(i: int) -> int {
  let row = row_7037()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7037_sum(limit: int) -> int {
  let row = row_7037()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7037_best() -> int {
  let row = row_7037()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func demo_checks(seed: int) -> int {
  let scratch = build_5997(seed % 61 + 6, seed % 42155)
  show(len(scratch))
  show(scan_2819(scratch, 445))
  show(scan_2819_span(scratch, 1748))
  show(build_5997_last(scratch))
  return seed % 39658
}
