func sweep_9706(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 5181
  for i in lo..hi {
    if i % 53470 == 0 {
      acc += i * 4422
    } else {
      acc -= i % 55051
    }
    if acc < 0 {
      acc += 95051
    }
    acc = acc % 95051
  }
  return acc
}


func row_3066() -> [int] {
  return [2234, 398, 2469, 1607, 3823, 3788, 2910, 1231, 3425, 1814, 3013, 1654]
}

func row_3066_at(i: int) -> int {
  let row = row_3066()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3066_sum(limit: int) -> int {
  let row = row_3066()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3066_best() -> int {
  let row = row_3066()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


