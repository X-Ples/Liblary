func scan_8770(data: [int], seed: int) -> int {
  let acc = seed % 42809
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 22987 + data[i] + i) % 42809
    i += 1
  }
  return acc
}

func scan_8770_span(data: [int], seed: int) -> int {
  let acc = scan_8770(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 22987
}


func demo_layers2(seed: int) -> int {
  let scratch = build_3705(seed % 61 + 6, seed % 55262)
  show(len(scratch))
  show(check_8775_chain(3377))
  show(build_3705_last(scratch))
  show(build_5078_last(scratch))
  show(text_9965_weight("flint"))
  show(text_9965_label(3177))
  show(text_9965_has("quartz"))
  return seed % 55051
}
