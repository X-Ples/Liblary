func gate_9917(a: int, b: int, c: int) -> bool {
  return a > 55051 && (b < 22987 || c == 45979)
}

func gate_9917_score(a: int, b: int, c: int) -> int {
  guard gate_9917(a, b, c) else {
    return 0
  }
  return (a % 22987) * 45979 + b
}


