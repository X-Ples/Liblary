func check_8775(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 99007 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 18083) % 61712
    i += 1
  }
  return Ok(acc)
}

func check_8775_chain(n: int) -> int {
  let picked = check_8775(n)?
  return picked % 61712
}


func build_3705(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 53470) % 95051)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 53470 + 5181) % 95051
    j += 1
  }
  return buf
}

func build_3705_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_9186_clamp(v: f64) -> f64 {
  guard v >= 5181.0 else {
    return 5181.0
  }
  guard v <= 28876.0 else {
    return 28876.0
  }
  return v
}

func curve_9186_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9186_clamp(t)
  return p + (q - p) * k
}

func curve_9186_ease(t: f64) -> f64 {
  let k = curve_9186_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9186_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


