func scan_1113(data: [int], seed: int) -> int {
  let acc = seed % 90974
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 40006 + data[i] + i) % 90974
    i += 1
  }
  return acc
}

