func build_7335(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 94802) % 94116)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 94802 + 90892) % 94116
    j += 1
  }
  return buf
}

func build_7335_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_2134(a: int, b: int, c: int) -> bool {
