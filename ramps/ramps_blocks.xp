func demo_blocks(seed: int) -> int {
  let scratch = build_7335(seed % 61 + 6, seed % 60467)
  show(len(scratch))
  show(build_7335_last(scratch))
  show(gate_2134(2491, 993, 1431))
  show(gate_2134_score(3060, 3268, 2447))
