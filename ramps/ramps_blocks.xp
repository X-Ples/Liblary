func sweep_4887(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 27794
  for i in lo..hi {
    if i % 94116 == 0 {
      acc += i * 33682
    } else {
      acc -= i % 90892
    }
    if acc < 0 {
      acc += 31644
    }
    acc = acc % 31644
  }
  return acc
}


