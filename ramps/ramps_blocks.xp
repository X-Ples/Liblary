func check_3057(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 90892 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 94116) % 77312
    i += 1
  }
  return Ok(acc)
}

func check_3057_chain(n: int) -> int {
  let picked = check_3057(n)?
  return picked % 77312
}


