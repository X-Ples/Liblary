func text_2235_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 74287
    i += 1
  }
  return acc % 74287
}

func text_2235_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "sigma"
  }
  return "gamma"
}

func text_2235_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 16960
}


func check_4071(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 79319 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 67573) % 4090
    i += 1
  }
  return Ok(acc)
}

func check_4071_chain(n: int) -> int {
  let picked = check_4071(n)?
  return picked % 4090
}


