func scan_4107(data: [int], seed: int) -> int {
  let acc = seed % 4859
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 51557 + data[i] + i) % 4859
    i += 1
  }
  return acc
}

func scan_4107_span(data: [int], seed: int) -> int {
  let acc = scan_4107(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 51557
}


func grid_4718_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 97022 + c * 57602 + seed) % 57602)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4718_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
