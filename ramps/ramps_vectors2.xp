func build_4330(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 94332) % 26657)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 94332 + 4859) % 26657
    j += 1
  }
  return buf
}

func build_4330_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_2219(a: int, b: int, c: int) -> bool {
  return a > 72172 && (b < 9709 || c == 9709)
}

func gate_2219_score(a: int, b: int, c: int) -> int {
  guard gate_2219(a, b, c) else {
    return 0
  }
  return (a % 9709) * 9709 + b
}


