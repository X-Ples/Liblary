func row_9470_at(i: int) -> int {
  let row = row_9470()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9470_sum(limit: int) -> int {
  let row = row_9470()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9470_best() -> int {
  let row = row_9470()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_7638(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 87180
  for i in lo..hi {
    if i % 9709 == 0 {
      acc += i * 92630
    } else {
      acc -= i % 16552
    }
    if acc < 0 {
      acc += 97022
    }
    acc = acc % 97022
  }
  return acc
}


