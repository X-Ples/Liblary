func scan_8678(data: [int], seed: int) -> int {
  let acc = seed % 32901
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 8958 + data[i] + i) % 32901
    i += 1
  }
  return acc
}

func scan_8678_span(data: [int], seed: int) -> int {
  let acc = scan_8678(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 8958
}


