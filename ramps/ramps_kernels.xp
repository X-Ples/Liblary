func gate_6615(a: int, b: int, c: int) -> bool {
  return a > 83132 && (b < 70798 || c == 70798)
}

func gate_6615_score(a: int, b: int, c: int) -> int {
  guard gate_6615(a, b, c) else {
    return 0
  }
  return (a % 70798) * 70798 + b
}


