func sweep_1910(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 83132
  for i in lo..hi {
    if i % 99438 == 0 {
      acc += i * 79842
    } else {
      acc -= i % 74633
    }
    if acc < 0 {
      acc += 9748
    }
    acc = acc % 9748
  }
  return acc
}


