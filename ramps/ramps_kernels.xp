func demo_kernels(seed: int) -> int {
  let scratch = build_3636(seed % 61 + 6, seed % 7108)
  show(len(scratch))
  show(text_2929_weight("mesa"))
  show(text_2929_label(1958))
  show(text_2929_has("nova"))
  show(build_3636_last(scratch))
  show(check_8302_chain(2565))
  show(row_5820_at(97))
  return seed % 79842
}
