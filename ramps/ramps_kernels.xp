func text_2929_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 93419
    i += 1
  }
  return acc % 93419
}

func text_2929_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "mesa"
}

func text_2929_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 67457
}


func build_3636(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 67457) % 83132)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 67457 + 39565) % 83132
    j += 1
  }
  return buf
}

func build_3636_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_8302(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 7108 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 82838) % 33188
    i += 1
  }
  return Ok(acc)
}

func check_8302_chain(n: int) -> int {
  let picked = check_8302(n)?
  return picked % 33188
}


func row_5820() -> [int] {
  return [2335, 2919, 3720, 2808, 976, 1478, 2116, 2902, 2879, 1179, 1197]
}

func row_5820_at(i: int) -> int {
  let row = row_5820()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5820_sum(limit: int) -> int {
  let row = row_5820()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5820_best() -> int {
  let row = row_5820()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_296_clamp(v: f64) -> f64 {
  guard v >= 58227.0 else {
    return 58227.0
  }
  guard v <= 58227.0 else {
    return 58227.0
  }
  return v
}

func curve_296_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_296_clamp(t)
  return p + (q - p) * k
}

func curve_296_ease(t: f64) -> f64 {
  let k = curve_296_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_296_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


