func demo_walkers(seed: int) -> int {
  let scratch = build_2114(seed % 61 + 6, seed % 32595)
  show(len(scratch))
  show(check_9852_chain(1460))
  show(build_2114_last(scratch))
  show(text_7925_weight("cargo"))
  show(text_7925_label(671))
  show(text_7925_has("delta"))
  show(row_3750_at(2213))
  return seed % 77615
}
