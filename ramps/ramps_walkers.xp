func check_9852(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 4179 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 91761) % 83093
    i += 1
  }
  return Ok(acc)
}

func check_9852_chain(n: int) -> int {
  let picked = check_9852(n)?
  return picked % 83093
}


func build_2114(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 99749) % 63140)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 99749 + 43250) % 63140
    j += 1
  }
  return buf
}

func build_2114_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_7954_clamp(v: f64) -> f64 {
  guard v >= 4179.0 else {
    return 4179.0
  }
  guard v <= 87552.0 else {
    return 87552.0
  }
  return v
}

func curve_7954_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7954_clamp(t)
  return p + (q - p) * k
}

func curve_7954_ease(t: f64) -> f64 {
  let k = curve_7954_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7954_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_7925_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 83536
    i += 1
  }
  return acc % 83536
}

func text_7925_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "nova"
}

func text_7925_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 83536
}


func row_3750() -> [int] {
