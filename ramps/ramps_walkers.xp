}

func row_3750_at(i: int) -> int {
  let row = row_3750()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3750_sum(limit: int) -> int {
  let row = row_3750()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3750_best() -> int {
  let row = row_3750()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


