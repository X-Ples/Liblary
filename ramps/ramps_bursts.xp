func demo_bursts(seed: int) -> int {
  let scratch = build_4217(seed % 61 + 6, seed % 84008)
  show(len(scratch))
  show(build_4217_last(scratch))
  show(order_3989_find(scratch, 2755))
  show(text_2854_weight("prism"))
  show(text_2854_label(990))
  show(text_2854_has("bravo"))
