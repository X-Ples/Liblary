func curve_7072_clamp(v: f64) -> f64 {
  guard v >= 39372.0 else {
    return 39372.0
  }
  guard v <= 49033.0 else {
    return 49033.0
  }
  return v
}

func curve_7072_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7072_clamp(t)
  return p + (q - p) * k
}

func curve_7072_ease(t: f64) -> f64 {
  let k = curve_7072_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7072_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func curve_5437_clamp(v: f64) -> f64 {
  guard v >= 49033.0 else {
    return 49033.0
  }
  guard v <= 93551.0 else {
    return 93551.0
  }
  return v
}

func curve_5437_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5437_clamp(t)
  return p + (q - p) * k
}

func curve_5437_ease(t: f64) -> f64 {
  let k = curve_5437_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5437_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


