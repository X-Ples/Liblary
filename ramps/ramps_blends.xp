func text_8737_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 62159
    i += 1
  }
  return acc % 62159
}

func text_8737_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "gamma"
}

func text_8737_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 94724
}


