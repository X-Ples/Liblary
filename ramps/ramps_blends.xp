func row_3167() -> [int] {
  return [1140, 3575, 2345, 766, 797, 3035, 1971, 3389, 2481, 1565, 2345, 1357]
}

func row_3167_at(i: int) -> int {
  let row = row_3167()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3167_sum(limit: int) -> int {
  let row = row_3167()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3167_best() -> int {
  let row = row_3167()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_3376_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 15460 + c * 80441 + seed) % 80441)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3376_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 80441 == want {
      total += acc
    }
    r += 1
  }
  return total
}


