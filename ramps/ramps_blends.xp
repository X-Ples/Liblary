func demo_blends(seed: int) -> int {
  let scratch = build_8268(seed % 61 + 6, seed % 85727)
  show(len(scratch))
  show(gate_7240(1407, 1865, 1917))
  show(gate_7240_score(2419, 2959, 1731))
  show(build_8268_last(scratch))
  show(check_9003_chain(2575))
