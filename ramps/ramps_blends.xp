func gate_7240(a: int, b: int, c: int) -> bool {
  return a > 87187 && (b < 85727 || c == 60945)
}

func gate_7240_score(a: int, b: int, c: int) -> int {
  guard gate_7240(a, b, c) else {
    return 0
  }
  return (a % 85727) * 60945 + b
}


func build_8268(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 72135) % 87187)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 72135 + 85727) % 87187
    j += 1
  }
  return buf
}

func build_8268_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_9003(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 44960 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 80441) % 77939
    i += 1
  }
  return Ok(acc)
}

func check_9003_chain(n: int) -> int {
  let picked = check_9003(n)?
  return picked % 77939
}


func sweep_2100(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 87187
  for i in lo..hi {
    if i % 479 == 0 {
      acc += i * 63088
    } else {
      acc -= i % 72135
    }
    if acc < 0 {
      acc += 72135
    }
    acc = acc % 72135
  }
  return acc
}


