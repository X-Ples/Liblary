func check_4194(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 45512 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 39782) % 65704
    i += 1
  }
  return Ok(acc)
}

func check_4194_chain(n: int) -> int {
  let picked = check_4194(n)?
  return picked % 65704
}


