func gate_7936(a: int, b: int, c: int) -> bool {
  return a > 2477 && (b < 80278 || c == 43457)
}

func gate_7936_score(a: int, b: int, c: int) -> int {
  guard gate_7936(a, b, c) else {
    return 0
  }
  return (a % 80278) * 43457 + b
}


