func demo_twists(seed: int) -> int {
  let scratch = build_3560(seed % 61 + 6, seed % 193)
  show(len(scratch))
  show(build_3560_last(scratch))
  show(gate_6894(2278, 2728, 2414))
  show(gate_6894_score(3961, 1252, 2184))
  show(sweep_9307(1853, 1209))
  show(gate_8828(1566, 1782, 2358))
  return seed % 63411
}
