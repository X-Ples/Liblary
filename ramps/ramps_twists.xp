func build_3560(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 89961) % 79579)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 89961 + 56036) % 79579
    j += 1
  }
  return buf
}

func build_3560_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_6894(a: int, b: int, c: int) -> bool {
  return a > 25676 && (b < 89961 || c == 2902)
}

func gate_6894_score(a: int, b: int, c: int) -> int {
  guard gate_6894(a, b, c) else {
    return 0
  }
  return (a % 89961) * 2902 + b
}


func sweep_9307(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 24309
  for i in lo..hi {
    if i % 56036 == 0 {
      acc += i * 193
    } else {
      acc -= i % 5418
    }
    if acc < 0 {
      acc += 36502
    }
    acc = acc % 36502
  }
  return acc
}


func gate_8828(a: int, b: int, c: int) -> bool {
  return a > 2462 && (b < 30767 || c == 93014)
}

func gate_8828_score(a: int, b: int, c: int) -> int {
  guard gate_8828(a, b, c) else {
    return 0
  }
  return (a % 30767) * 93014 + b
}


func curve_8810_clamp(v: f64) -> f64 {
  guard v >= 30767.0 else {
    return 30767.0
  }
  guard v <= 79579.0 else {
    return 79579.0
  }
  return v
}

func curve_8810_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8810_clamp(t)
  return p + (q - p) * k
}

func curve_8810_ease(t: f64) -> f64 {
  let k = curve_8810_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8810_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_2460(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2460_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


