func check_305(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 63411 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 25676) % 88061
    i += 1
  }
  return Ok(acc)
}

func check_305_chain(n: int) -> int {
  let picked = check_305(n)?
  return picked % 88061
}


