func scan_2408(data: [int], seed: int) -> int {
  let acc = seed % 93014
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 30767 + data[i] + i) % 93014
    i += 1
  }
  return acc
}

func scan_2408_span(data: [int], seed: int) -> int {
  let acc = scan_2408(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 30767
}


