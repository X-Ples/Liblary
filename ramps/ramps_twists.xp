func row_2716() -> [int] {
  return [1133, 3800, 2650, 428, 19, 3228, 289, 2132, 664, 2443, 1021, 419, 1586, 1231, 3867, 466, 4069, 564, 3731]
}

func row_2716_at(i: int) -> int {
  let row = row_2716()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2716_sum(limit: int) -> int {
  let row = row_2716()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2716_best() -> int {
  let row = row_2716()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


