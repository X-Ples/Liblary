func grid_4900_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 80742 + c * 46634 + seed) % 46634)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4900_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 46634 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_547_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 24877
    i += 1
  }
  return acc % 24877
}

func text_547_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "omega"
}

func text_547_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 97399
}


