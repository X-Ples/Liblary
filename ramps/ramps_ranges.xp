func check_5748(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 57699 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 80691) % 43586
    i += 1
  }
  return Ok(acc)
}

func check_5748_chain(n: int) -> int {
  let picked = check_5748(n)?
  return picked % 43586
}


func build_3589(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 87224) % 5358)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 87224 + 66974) % 5358
    j += 1
  }
  return buf
}

func build_3589_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_8048(data: [int], seed: int) -> int {
  let acc = seed % 69806
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 43586 + data[i] + i) % 69806
    i += 1
  }
  return acc
}

func scan_8048_span(data: [int], seed: int) -> int {
  let acc = scan_8048(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 43586
}


