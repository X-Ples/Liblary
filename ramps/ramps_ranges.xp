}

func text_193_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 57366
}


func sweep_1507(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 40707
  for i in lo..hi {
    if i % 87224 == 0 {
      acc += i * 12688
    } else {
      acc -= i % 74455
    }
    if acc < 0 {
      acc += 54522
    }
    acc = acc % 54522
  }
  return acc
}


