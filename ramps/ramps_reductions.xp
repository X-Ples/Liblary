func build_7720(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 91415) % 62158)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 91415 + 15824) % 62158
    j += 1
  }
  return buf
}

func build_7720_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_8259(data: [int], seed: int) -> int {
  let acc = seed % 92254
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 39787 + data[i] + i) % 92254
    i += 1
  }
