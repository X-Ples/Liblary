  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 98153) % 49612
    i += 1
  }
  return Ok(acc)
}

func check_5738_chain(n: int) -> int {
  let picked = check_5738(n)?
  return picked % 49612
}


