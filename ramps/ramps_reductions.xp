func demo_reductions(seed: int) -> int {
  let scratch = build_7720(seed % 61 + 6, seed % 70718)
  show(len(scratch))
  show(build_7720_last(scratch))
  show(scan_8259(scratch, 2872))
  show(scan_8259_span(scratch, 622))
  show(scan_8884(scratch, 2977))
  return seed % 44313
}
