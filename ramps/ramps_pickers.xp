func demo_pickers(seed: int) -> int {
  let scratch = build_6955(seed % 61 + 6, seed % 14147)
  show(len(scratch))
  show(order_3248_find(scratch, 2335))
  show(gate_8843(3296, 3200, 3987))
  show(gate_8843_score(1590, 2337, 1155))
  show(gate_4974(1650, 3426, 2666))
  show(gate_4974_score(1442, 2835, 1536))
  return seed % 60722
}
