const K0 = 22313
const K1 = 92673
const K2 = 55830
const K3 = 2297
const K4 = 85141
const K5 = 97939

func order_3248(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3248_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_8843(a: int, b: int, c: int) -> bool {
  return a > 81959 && (b < 39859 || c == 33104)
}

func gate_8843_score(a: int, b: int, c: int) -> int {
  guard gate_8843(a, b, c) else {
    return 0
  }
  return (a % 39859) * 33104 + b
}


