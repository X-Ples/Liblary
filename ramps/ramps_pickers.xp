func build_6955(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 85134) % 8175)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 85134 + 85634) % 8175
    j += 1
  }
  return buf
}

func build_6955_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_1066(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 28337
  for i in lo..hi {
    if i % 22918 == 0 {
      acc += i * 36806
    } else {
      acc -= i % 12179
    }
    if acc < 0 {
      acc += 39859
    }
    acc = acc % 39859
  }
  return acc
}


func curve_9010_clamp(v: f64) -> f64 {
  guard v >= 60722.0 else {
    return 60722.0
  }
  guard v <= 85893.0 else {
    return 85893.0
  }
  return v
}

func curve_9010_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9010_clamp(t)
  return p + (q - p) * k
}

func curve_9010_ease(t: f64) -> f64 {
  let k = curve_9010_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9010_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


