func scan_8878(data: [int], seed: int) -> int {
  let acc = seed % 12179
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 12179 + data[i] + i) % 12179
    i += 1
  }
  return acc
}

func scan_8878_span(data: [int], seed: int) -> int {
  let acc = scan_8878(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 12179
}


