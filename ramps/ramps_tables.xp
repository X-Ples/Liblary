func demo_tables(seed: int) -> int {
  let scratch = build_5874(seed % 61 + 6, seed % 84784)
  show(len(scratch))
  show(build_5874_last(scratch))
  show(row_2542_at(2543))
  show(row_2542_sum(2844))
  show(row_2542_best())
  show(order_1426_find(scratch, 2052))
  return seed % 84784
}
