func build_5874(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 62341) % 25008)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 62341 + 4315) % 25008
    j += 1
  }
  return buf
}

func build_5874_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_2542() -> [int] {
  return [60, 1244, 1933, 207, 1877, 803, 2738, 2118, 2564, 2890, 51, 3566, 718, 3817, 3574, 264, 889, 3191, 1032, 4024, 3801]
}

func row_2542_at(i: int) -> int {
  let row = row_2542()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2542_sum(limit: int) -> int {
  let row = row_2542()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2542_best() -> int {
  let row = row_2542()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_1426(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1426_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func scan_6173(data: [int], seed: int) -> int {
  let acc = seed % 4315
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 8412 + data[i] + i) % 4315
    i += 1
  }
  return acc
}

func scan_6173_span(data: [int], seed: int) -> int {
  let acc = scan_6173(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 8412
}


func curve_131_clamp(v: f64) -> f64 {
  guard v >= 62341.0 else {
    return 62341.0
  }
  guard v <= 71106.0 else {
    return 71106.0
  }
  return v
}

func curve_131_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_131_clamp(t)
  return p + (q - p) * k
}

func curve_131_ease(t: f64) -> f64 {
  let k = curve_131_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_131_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


