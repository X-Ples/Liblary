func sweep_5644(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 42135
  for i in lo..hi {
    if i % 83368 == 0 {
      acc += i * 47946
    } else {
      acc -= i % 99584
    }
    if acc < 0 {
      acc += 95731
    }
    acc = acc % 95731
  }
  return acc
}


func check_3981(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 51632 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 97170) % 56201
    i += 1
  }
  return Ok(acc)
}

func check_3981_chain(n: int) -> int {
  let picked = check_3981(n)?
  return picked % 56201
}


