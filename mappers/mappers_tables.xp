func scan_5962(data: [int], seed: int) -> int {
  let acc = seed % 39938
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 42135 + data[i] + i) % 39938
    i += 1
  }
  return acc
}

func scan_5962_span(data: [int], seed: int) -> int {
  let acc = scan_5962(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 42135
}


func text_9984_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 97170
    i += 1
  }
  return acc % 97170
}

func text_9984_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "prism"
}

func text_9984_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 36580
}


