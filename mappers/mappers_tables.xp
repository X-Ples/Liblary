func demo_tables(seed: int) -> int {
  let scratch = build_5237(seed % 61 + 6, seed % 13081)
  show(len(scratch))
  show(build_5237_last(scratch))
  show(sweep_5644(3385, 2537))
  show(check_3981_chain(3384))
  show(order_2824_find(scratch, 3944))
  return seed % 314
}
