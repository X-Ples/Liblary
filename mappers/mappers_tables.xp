const K0 = 95731
const K1 = 86101
const K2 = 83368
const K3 = 87227
const K4 = 84569
const K5 = 26893

func build_5237(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 55151) % 97170)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 55151 + 99584) % 97170
    j += 1
  }
  return buf
}

func build_5237_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_792_clamp(v: f64) -> f64 {
  guard v >= 71079.0 else {
    return 71079.0
  }
  guard v <= 84569.0 else {
    return 84569.0
  }
  return v
}

func curve_792_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_792_clamp(t)
  return p + (q - p) * k
}

func curve_792_ease(t: f64) -> f64 {
  let k = curve_792_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_792_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


