func gate_4210(a: int, b: int, c: int) -> bool {
  return a > 84569 && (b < 26893 || c == 97170)
}

func gate_4210_score(a: int, b: int, c: int) -> int {
  guard gate_4210(a, b, c) else {
    return 0
  }
  return (a % 26893) * 97170 + b
}


