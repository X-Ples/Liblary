  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 22489 + c * 19826 + seed) % 19826)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4761_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
