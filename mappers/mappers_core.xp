func row_2615() -> [int] {
  return [2255, 3701, 3362, 39, 125, 3354, 1571, 2630, 876, 1594, 522, 261, 3394, 3081, 4068, 2592]
}

func row_2615_at(i: int) -> int {
  let row = row_2615()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2615_sum(limit: int) -> int {
  let row = row_2615()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2615_best() -> int {
  let row = row_2615()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_6362(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6362_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_6192(a: int, b: int, c: int) -> bool {
  return a > 66101 && (b < 92648 || c == 76088)
}

func gate_6192_score(a: int, b: int, c: int) -> int {
  guard gate_6192(a, b, c) else {
    return 0
  }
  return (a % 92648) * 76088 + b
}


