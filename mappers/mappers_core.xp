func scan_7402(data: [int], seed: int) -> int {
  let acc = seed % 45125
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 85703 + data[i] + i) % 45125
    i += 1
  }
  return acc
}

func scan_7402_span(data: [int], seed: int) -> int {
  let acc = scan_7402(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 85703
}


func sweep_9120(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 32259
  for i in lo..hi {
    if i % 76088 == 0 {
      acc += i * 96861
    } else {
      acc -= i % 37901
    }
    if acc < 0 {
      acc += 37901
    }
    acc = acc % 37901
  }
  return acc
}


func build_6816(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 28950) % 7791)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 28950 + 32259) % 7791
    j += 1
  }
  return buf
}

func build_6816_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_122_clamp(v: f64) -> f64 {
  guard v >= 28983.0 else {
    return 28983.0
  }
  guard v <= 76885.0 else {
    return 76885.0
  }
  return v
}

func curve_122_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_122_clamp(t)
  return p + (q - p) * k
}

func curve_122_ease(t: f64) -> f64 {
  let k = curve_122_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_122_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_3288(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 40820 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 96861) % 32259
    i += 1
  }
  return Ok(acc)
}

func check_3288_chain(n: int) -> int {
  let picked = check_3288(n)?
  return picked % 32259
}


