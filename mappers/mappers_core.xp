func demo_core(seed: int) -> int {
  let scratch = build_6816(seed % 61 + 6, seed % 76885)
  show(len(scratch))
  show(scan_7402(scratch, 3975))
  show(scan_7402_span(scratch, 3755))
  show(sweep_9120(2182, 2314))
  show(build_6816_last(scratch))
  return seed % 85236
}
