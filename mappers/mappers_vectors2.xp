func check_2789(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 74337 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 13917) % 97636
    i += 1
  }
  return Ok(acc)
}

func check_2789_chain(n: int) -> int {
  let picked = check_2789(n)?
  return picked % 97636
}


