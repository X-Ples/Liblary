func build_7918(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 50389) % 50389)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 50389 + 47595) % 50389
    j += 1
  }
  return buf
}

func build_7918_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_6432_clamp(v: f64) -> f64 {
  guard v >= 73513.0 else {
    return 73513.0
  }
  guard v <= 73513.0 else {
    return 73513.0
  }
  return v
}

func curve_6432_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6432_clamp(t)
  return p + (q - p) * k
}

func curve_6432_ease(t: f64) -> f64 {
  let k = curve_6432_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6432_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_1306() -> [int] {
  return [2839, 2698, 598, 1441, 381, 853, 774, 3934, 1337, 1705, 76, 2482]
}

func row_1306_at(i: int) -> int {
  let row = row_1306()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1306_sum(limit: int) -> int {
  let row = row_1306()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1306_best() -> int {
  let row = row_1306()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


