}


func sweep_8867(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 13917
  for i in lo..hi {
    if i % 79653 == 0 {
      acc += i * 74558
    } else {
      acc -= i % 50389
    }
    if acc < 0 {
      acc += 48627
    }
    acc = acc % 48627
  }
  return acc
}


