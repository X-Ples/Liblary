func build_2953(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 79958) % 70777)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 79958 + 16361) % 70777
    j += 1
  }
  return buf
}

func build_2953_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_7880_clamp(v: f64) -> f64 {
  guard v >= 45987.0 else {
    return 45987.0
  }
  guard v <= 52899.0 else {
    return 52899.0
  }
  return v
}

func curve_7880_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7880_clamp(t)
  return p + (q - p) * k
}

func curve_7880_ease(t: f64) -> f64 {
  let k = curve_7880_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7880_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_5273_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 16361 + c * 97888 + seed) % 97888)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5273_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 97888 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_9066(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 79958 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 70777) % 55663
    i += 1
  }
  return Ok(acc)
}

func check_9066_chain(n: int) -> int {
  let picked = check_9066(n)?
  return picked % 55663
}


