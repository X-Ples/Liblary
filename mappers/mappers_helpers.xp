func check_1295(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 61525 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 10469) % 84757
    i += 1
  }
  return Ok(acc)
}

func check_1295_chain(n: int) -> int {
  let picked = check_1295(n)?
  return picked % 84757
}


func scan_1016(data: [int], seed: int) -> int {
  let acc = seed % 73066
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 96080 + data[i] + i) % 73066
    i += 1
  }
  return acc
}

func scan_1016_span(data: [int], seed: int) -> int {
  let acc = scan_1016(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 96080
}


