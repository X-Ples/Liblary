func demo_helpers(seed: int) -> int {
  let scratch = build_8940(seed % 61 + 6, seed % 98281)
  show(len(scratch))
  show(build_8940_last(scratch))
  show(build_8699_last(scratch))
  show(check_1295_chain(206))
  show(scan_1016(scratch, 1283))
  show(scan_1016_span(scratch, 3228))
  show(scan_9637(scratch, 1809))
  return seed % 96080
}
