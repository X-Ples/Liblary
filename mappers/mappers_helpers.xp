func curve_6483_clamp(v: f64) -> f64 {
  guard v >= 3973.0 else {
    return 3973.0
  }
  guard v <= 65074.0 else {
    return 65074.0
  }
  return v
}

func curve_6483_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6483_clamp(t)
  return p + (q - p) * k
}

func curve_6483_ease(t: f64) -> f64 {
  let k = curve_6483_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6483_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_4601() -> [int] {
  return [152, 2711, 2070, 1627, 2114, 3520, 3862, 1456, 566, 1560, 266, 3643, 2109, 3188]
}

func row_4601_at(i: int) -> int {
  let row = row_4601()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4601_sum(limit: int) -> int {
  let row = row_4601()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4601_best() -> int {
  let row = row_4601()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


