func demo_ratchets(seed: int) -> int {
  let scratch = build_8449(seed % 61 + 6, seed % 71574)
  show(len(scratch))
  show(build_8449_last(scratch))
  show(row_8754_at(2110))
  show(row_8754_sum(162))
  show(row_8754_best())
  show(scan_7030(scratch, 2047))
  return seed % 10972
}
