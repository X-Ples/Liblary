func sweep_608(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 88053
  for i in lo..hi {
    if i % 41197 == 0 {
      acc += i * 26084
    } else {
      acc -= i % 11155
    }
    if acc < 0 {
      acc += 34720
    }
    acc = acc % 34720
  }
  return acc
}


