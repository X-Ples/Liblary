func build_8449(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 71574) % 18118)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 71574 + 17026) % 18118
    j += 1
  }
  return buf
}

func build_8449_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_8754() -> [int] {
  return [4, 2585, 2015, 2157, 2075, 3769, 2922, 1510, 1412, 1518, 2850, 1921, 707]
}

func row_8754_at(i: int) -> int {
  let row = row_8754()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8754_sum(limit: int) -> int {
  let row = row_8754()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8754_best() -> int {
  let row = row_8754()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_7030(data: [int], seed: int) -> int {
  let acc = seed % 34720
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 94271 + data[i] + i) % 34720
    i += 1
  }
  return acc
}

func scan_7030_span(data: [int], seed: int) -> int {
  let acc = scan_7030(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 94271
}


func curve_2663_clamp(v: f64) -> f64 {
  guard v >= 6301.0 else {
    return 6301.0
  }
  guard v <= 8960.0 else {
    return 8960.0
  }
  return v
}

func curve_2663_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2663_clamp(t)
  return p + (q - p) * k
}

func curve_2663_ease(t: f64) -> f64 {
  let k = curve_2663_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2663_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_2171_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 17026 + c * 8960 + seed) % 8960)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2171_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 8960 == want {
      total += acc
    }
    r += 1
  }
  return total
}


