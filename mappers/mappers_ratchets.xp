func check_529(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 75732 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 94271) % 17026
    i += 1
  }
  return Ok(acc)
}

func check_529_chain(n: int) -> int {
  let picked = check_529(n)?
  return picked % 17026
}


