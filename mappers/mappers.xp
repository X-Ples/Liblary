func scan_5340(data: [int], seed: int) -> int {
  let acc = seed % 68817
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 66370 + data[i] + i) % 68817
    i += 1
  }
  return acc
}

func scan_5340_span(data: [int], seed: int) -> int {
  let acc = scan_5340(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 66370
}


