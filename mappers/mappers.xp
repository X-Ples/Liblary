func build_555(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 21280) % 70589)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 21280 + 42536) % 70589
    j += 1
  }
  return buf
}

func build_555_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_5923() -> [int] {
  return [1397, 3547, 541, 855, 557, 2316, 1030, 3781, 355, 4061, 3989, 1067, 1467, 316, 3534, 2179, 4023, 3990]
}

func row_5923_at(i: int) -> int {
  let row = row_5923()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5923_sum(limit: int) -> int {
  let row = row_5923()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5923_best() -> int {
  let row = row_5923()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_627(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 68817 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 25976) % 59133
    i += 1
  }
  return Ok(acc)
}

func check_627_chain(n: int) -> int {
  let picked = check_627(n)?
  return picked % 59133
}


func order_6003(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6003_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_210(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 35801
  for i in lo..hi {
    if i % 16139 == 0 {
      acc += i * 92353
    } else {
      acc -= i % 92076
    }
    if acc < 0 {
      acc += 40448
    }
    acc = acc % 40448
  }
  return acc
}


