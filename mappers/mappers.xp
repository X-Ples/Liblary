func gate_1615(a: int, b: int, c: int) -> bool {
  return a > 13118 && (b < 66370 || c == 87324)
}

func gate_1615_score(a: int, b: int, c: int) -> int {
  guard gate_1615(a, b, c) else {
    return 0
  }
  return (a % 66370) * 87324 + b
}


func curve_5168_clamp(v: f64) -> f64 {
  guard v >= 66370.0 else {
    return 66370.0
  }
  guard v <= 80789.0 else {
    return 80789.0
  }
  return v
}

func curve_5168_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5168_clamp(t)
  return p + (q - p) * k
}

func curve_5168_ease(t: f64) -> f64 {
  let k = curve_5168_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5168_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func curve_1685_clamp(v: f64) -> f64 {
  guard v >= 73394.0 else {
    return 73394.0
  }
  guard v <= 73394.0 else {
    return 73394.0
