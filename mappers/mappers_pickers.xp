func demo_pickers(seed: int) -> int {
  let scratch = build_973(seed % 61 + 6, seed % 62191)
  show(len(scratch))
  show(sweep_3978(14, 1689))
  show(build_973_last(scratch))
  show(build_518_last(scratch))
  show(row_1950_at(3733))
  return seed % 65336
}
