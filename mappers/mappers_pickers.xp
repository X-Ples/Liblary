func sweep_3978(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 62191
  for i in lo..hi {
    if i % 92602 == 0 {
      acc += i * 83761
    } else {
      acc -= i % 93438
    }
    if acc < 0 {
      acc += 13453
    }
    acc = acc % 13453
  }
  return acc
}


func build_973(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 82739) % 83761)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 82739 + 94125) % 83761
    j += 1
  }
  return buf
}

func build_973_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_5343_clamp(v: f64) -> f64 {
  guard v >= 7671.0 else {
    return 7671.0
  }
  guard v <= 44380.0 else {
    return 44380.0
  }
  return v
}

func curve_5343_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5343_clamp(t)
  return p + (q - p) * k
}

func curve_5343_ease(t: f64) -> f64 {
  let k = curve_5343_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5343_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


