func sweep_7353(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 21045
  for i in lo..hi {
    if i % 29065 == 0 {
      acc += i * 33005
    } else {
      acc -= i % 2581
    }
    if acc < 0 {
      acc += 51568
    }
    acc = acc % 51568
  }
  return acc
}


func build_3019(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 73811) % 30486)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 73811 + 33005) % 30486
    j += 1
  }
  return buf
}

func build_3019_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_1642(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 67599 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 82490) % 27983
    i += 1
  }
  return Ok(acc)
}

func check_1642_chain(n: int) -> int {
  let picked = check_1642(n)?
  return picked % 27983
}


func gate_9314(a: int, b: int, c: int) -> bool {
  return a > 7754 && (b < 30486 || c == 95503)
}

func gate_9314_score(a: int, b: int, c: int) -> int {
  guard gate_9314(a, b, c) else {
    return 0
  }
  return (a % 30486) * 95503 + b
}


func row_8188() -> [int] {
  return [2552, 286, 2304, 1031, 3744, 3102, 3332, 3225, 913, 2911, 2940, 135, 2942, 3420, 3025]
}

func row_8188_at(i: int) -> int {
  let row = row_8188()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8188_sum(limit: int) -> int {
  let row = row_8188()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8188_best() -> int {
  let row = row_8188()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_1672_clamp(v: f64) -> f64 {
  guard v >= 27983.0 else {
    return 27983.0
  }
  guard v <= 81667.0 else {
    return 81667.0
  }
  return v
}

func curve_1672_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1672_clamp(t)
  return p + (q - p) * k
}

func curve_1672_ease(t: f64) -> f64 {
  let k = curve_1672_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1672_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


