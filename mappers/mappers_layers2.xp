func demo_layers2(seed: int) -> int {
  let scratch = build_3019(seed % 61 + 6, seed % 30486)
  show(len(scratch))
  show(sweep_7353(2035, 1354))
  show(build_3019_last(scratch))
  show(check_1642_chain(159))
  show(gate_9314(231, 3545, 376))
  show(gate_9314_score(290, 2607, 3161))
  show(row_8188_at(1743))
  return seed % 30486
}
