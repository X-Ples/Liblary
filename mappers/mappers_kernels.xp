const K8 = 44296

func grid_4618_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 48903 + c * 9106 + seed) % 9106)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4618_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 9106 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_3223(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 84155) % 80814)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 84155 + 67142) % 80814
    j += 1
  }
  return buf
}

func build_3223_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_524() -> [int] {
  return [2990, 4069, 783, 3422, 2395, 446, 2641, 2567, 3157, 1062, 2232]
}

func row_524_at(i: int) -> int {
  let row = row_524()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_524_sum(limit: int) -> int {
  let row = row_524()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_524_best() -> int {
  let row = row_524()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


