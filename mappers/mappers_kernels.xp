func gate_1375(a: int, b: int, c: int) -> bool {
  return a > 16366 && (b < 37244 || c == 32042)
}

func gate_1375_score(a: int, b: int, c: int) -> int {
  guard gate_1375(a, b, c) else {
    return 0
  }
  return (a % 37244) * 32042 + b
}


func scan_8379(data: [int], seed: int) -> int {
  let acc = seed % 37244
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 96514 + data[i] + i) % 37244
    i += 1
  }
  return acc
}

func scan_8379_span(data: [int], seed: int) -> int {
  let acc = scan_8379(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 96514
}


