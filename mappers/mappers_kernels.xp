func text_2884_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 85199
    i += 1
  }
  return acc % 85199
}

func text_2884_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "nova"
}

func text_2884_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 72517
}


func curve_1899_clamp(v: f64) -> f64 {
  guard v >= 37244.0 else {
    return 37244.0
  }
  guard v <= 72517.0 else {
    return 72517.0
  }
  return v
}

func curve_1899_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1899_clamp(t)
  return p + (q - p) * k
}

func curve_1899_ease(t: f64) -> f64 {
  let k = curve_1899_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1899_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


