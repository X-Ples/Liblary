}


func demo_kernels(seed: int) -> int {
  let scratch = build_3223(seed % 61 + 6, seed % 16366)
  show(len(scratch))
  show(grid_4618_rowsum(scratch, 1997, 1959, 3681))
  show(build_3223_last(scratch))
  show(row_524_at(441))
  show(row_524_sum(3168))
  show(row_524_best())
  show(grid_8030_rowsum(scratch, 925, 30, 2261))
  return seed % 9106
}
