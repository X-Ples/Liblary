func text_4050_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "cargo"
}

func text_4050_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 55754
}


