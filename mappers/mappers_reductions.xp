func scan_2000(data: [int], seed: int) -> int {
  let acc = seed % 31316
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 45821 + data[i] + i) % 31316
    i += 1
  }
  return acc
}

func scan_2000_span(data: [int], seed: int) -> int {
  let acc = scan_2000(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 45821
}


