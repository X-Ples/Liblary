const K0 = 55754
const K1 = 30416
const K2 = 41668
const K3 = 65329
const K4 = 5027
const K5 = 69251
const K6 = 52368

func curve_1439_clamp(v: f64) -> f64 {
  guard v >= 30961.0 else {
    return 30961.0
  }
  guard v <= 55754.0 else {
    return 55754.0
  }
  return v
}

func curve_1439_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1439_clamp(t)
  return p + (q - p) * k
}

func curve_1439_ease(t: f64) -> f64 {
  let k = curve_1439_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1439_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_5481() -> [int] {
  return [293, 978, 2401, 1435, 3282, 3671, 3625, 3356, 2708, 3889, 1523, 3363, 1552, 2920, 2193, 439, 3219, 3077]
}

func row_5481_at(i: int) -> int {
  let row = row_5481()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5481_sum(limit: int) -> int {
  let row = row_5481()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5481_best() -> int {
  let row = row_5481()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_751(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 5027) % 45821)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 5027 + 16669) % 45821
    j += 1
  }
  return buf
}

func build_751_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_6472(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 41668 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 25927) % 16669
    i += 1
  }
  return Ok(acc)
}

func check_6472_chain(n: int) -> int {
  let picked = check_6472(n)?
  return picked % 16669
}


