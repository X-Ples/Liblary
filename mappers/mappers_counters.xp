func sweep_9316(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 32713
  for i in lo..hi {
    if i % 98288 == 0 {
      acc += i * 48763
    } else {
      acc -= i % 10131
    }
    if acc < 0 {
      acc += 47421
    }
    acc = acc % 47421
  }
  return acc
}


