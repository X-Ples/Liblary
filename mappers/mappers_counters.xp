func scan_2453(data: [int], seed: int) -> int {
  let acc = seed % 31392
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 52587 + data[i] + i) % 31392
    i += 1
  }
  return acc
}

func scan_2453_span(data: [int], seed: int) -> int {
  let acc = scan_2453(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 52587
}


func demo_counters(seed: int) -> int {
  let scratch = build_2738(seed % 61 + 6, seed % 31392)
  show(len(scratch))
  show(build_2738_last(scratch))
  show(text_8764_weight("cargo"))
  show(text_8764_label(3683))
  show(text_8764_has("prism"))
  return seed % 10131
}
