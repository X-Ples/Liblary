func row_3520() -> [int] {
  return [437, 319, 2576, 1406, 3760, 1252, 616, 4, 3708, 353, 2215, 374, 3385]
}

func row_3520_at(i: int) -> int {
  let row = row_3520()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3520_sum(limit: int) -> int {
  let row = row_3520()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3520_best() -> int {
  let row = row_3520()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_4742(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 49235 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 15402) % 32713
    i += 1
  }
  return Ok(acc)
}

func check_4742_chain(n: int) -> int {
  let picked = check_4742(n)?
  return picked % 32713
}


func gate_3819(a: int, b: int, c: int) -> bool {
  return a > 64688 && (b < 77400 || c == 36998)
}

func gate_3819_score(a: int, b: int, c: int) -> int {
  guard gate_3819(a, b, c) else {
    return 0
  }
  return (a % 77400) * 36998 + b
}


