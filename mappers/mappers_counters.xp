func build_2738(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 98288) % 64688)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 98288 + 15402) % 64688
    j += 1
  }
  return buf
}

func build_2738_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_8764_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 47421
    i += 1
  }
  return acc % 47421
}

func text_8764_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "cargo"
}

func text_8764_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 61074
}


func curve_5105_clamp(v: f64) -> f64 {
  guard v >= 18964.0 else {
    return 18964.0
  }
  guard v <= 32713.0 else {
    return 32713.0
  }
  return v
}

func curve_5105_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5105_clamp(t)
  return p + (q - p) * k
}

func curve_5105_ease(t: f64) -> f64 {
  let k = curve_5105_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5105_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


