func demo_signals(seed: int) -> int {
  let scratch = build_9520(seed % 61 + 6, seed % 39103)
  show(len(scratch))
  show(build_9520_last(scratch))
  show(order_6122_find(scratch, 3703))
  show(check_8164_chain(3251))
  show(row_770_at(3798))
  show(row_770_sum(1425))
  return seed % 72055
}
