func build_9520(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 71956) % 55563)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 71956 + 48109) % 55563
    j += 1
  }
  return buf
}

func build_9520_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_6122(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6122_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func check_8164(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 48109 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 69563) % 7220
    i += 1
  }
  return Ok(acc)
}

func check_8164_chain(n: int) -> int {
  let picked = check_8164(n)?
  return picked % 7220
}


func row_770() -> [int] {
  return [2869, 2948, 3398, 3062, 166, 3553, 3134, 1460, 163, 3193, 922, 1974, 110, 1427, 2890, 2184, 497, 3603, 1558]
}

func row_770_at(i: int) -> int {
  let row = row_770()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_770_sum(limit: int) -> int {
  let row = row_770()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_770_best() -> int {
  let row = row_770()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


