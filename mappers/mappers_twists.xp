    }
  }
  return best
}


func check_2823(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 8268 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 42130) % 8268
    i += 1
  }
  return Ok(acc)
}

func check_2823_chain(n: int) -> int {
  let picked = check_2823(n)?
  return picked % 8268
}


