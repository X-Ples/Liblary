}

func text_9130_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "jetty"
}

func text_9130_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 69620
}


func curve_3029_clamp(v: f64) -> f64 {
  guard v >= 57759.0 else {
    return 57759.0
  }
  guard v <= 94830.0 else {
    return 94830.0
  }
  return v
}

func curve_3029_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3029_clamp(t)
  return p + (q - p) * k
}

func curve_3029_ease(t: f64) -> f64 {
  let k = curve_3029_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3029_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


