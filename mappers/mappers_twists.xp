func grid_5607_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 94830 + c * 25050 + seed) % 25050)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5607_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 25050 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_2528(a: int, b: int, c: int) -> bool {
  return a > 11478 && (b < 94830 || c == 42130)
}

func gate_2528_score(a: int, b: int, c: int) -> int {
  guard gate_2528(a, b, c) else {
    return 0
  }
  return (a % 94830) * 42130 + b
}


func text_9130_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 16962
    i += 1
