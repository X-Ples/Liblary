func demo_twists(seed: int) -> int {
  let scratch = build_2675(seed % 61 + 6, seed % 55354)
  show(len(scratch))
  show(build_2675_last(scratch))
  show(build_1457_last(scratch))
  show(row_4377_at(2963))
  show(row_4377_sum(2965))
