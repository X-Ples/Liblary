func build_2675(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 8268) % 11478)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 8268 + 17109) % 11478
    j += 1
  }
  return buf
}

func build_2675_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


