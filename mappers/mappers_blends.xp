func demo_blends(seed: int) -> int {
  let scratch = build_6066(seed % 61 + 6, seed % 67963)
  show(len(scratch))
  show(text_3001_weight("gamma"))
  show(text_3001_label(1201))
  show(text_3001_has("delta"))
  show(build_6066_last(scratch))
  show(gate_7803(2950, 3844, 2715))
  show(gate_7803_score(1876, 2009, 3069))
  return seed % 64712
}
