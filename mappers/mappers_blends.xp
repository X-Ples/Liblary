func text_3001_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 11522
    i += 1
  }
  return acc % 11522
}

func text_3001_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "harbor"
}

func text_3001_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 11522
}


func build_6066(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 64712) % 34310)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 64712 + 35515) % 34310
    j += 1
  }
  return buf
}

func build_6066_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_7803(a: int, b: int, c: int) -> bool {
  return a > 96484 && (b < 13427 || c == 80289)
}

func gate_7803_score(a: int, b: int, c: int) -> int {
  guard gate_7803(a, b, c) else {
    return 0
  }
  return (a % 13427) * 80289 + b
}


func check_8940(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 13721 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 85928) % 63514
    i += 1
  }
  return Ok(acc)
}

func check_8940_chain(n: int) -> int {
  let picked = check_8940(n)?
  return picked % 63514
}


