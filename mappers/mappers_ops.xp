func sweep_8051(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 37829
  for i in lo..hi {
    if i % 99037 == 0 {
      acc += i * 69040
    } else {
      acc -= i % 69403
    }
    if acc < 0 {
      acc += 29179
    }
    acc = acc % 29179
  }
  return acc
}


