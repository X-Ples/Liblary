func row_3410() -> [int] {
  return [2571, 538, 3015, 2580, 2165, 1621, 3347, 2072, 3803, 1829, 2219, 3900, 515, 3518, 1227, 502]
}

func row_3410_at(i: int) -> int {
  let row = row_3410()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3410_sum(limit: int) -> int {
  let row = row_3410()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3410_best() -> int {
  let row = row_3410()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_7961(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 60031 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 49993) % 69040
    i += 1
  }
  return Ok(acc)
}

func check_7961_chain(n: int) -> int {
  let picked = check_7961(n)?
  return picked % 69040
}


