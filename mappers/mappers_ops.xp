func demo_ops(seed: int) -> int {
  let scratch = build_2838(seed % 61 + 6, seed % 16720)
  show(len(scratch))
  show(build_2838_last(scratch))
  show(order_8060_find(scratch, 2546))
  show(build_8320_last(scratch))
