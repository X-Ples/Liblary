func text_7936_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 44959
    i += 1
  }
  return acc % 44959
}

func text_7936_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "kilo"
}

func text_7936_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 13326
}


