func demo_quarks(seed: int) -> int {
  let scratch = build_6038(seed % 61 + 6, seed % 26346)
  show(len(scratch))
  show(gate_8537(3614, 759, 284))
  show(gate_8537_score(408, 1476, 2640))
  show(build_6038_last(scratch))
  show(order_2349_find(scratch, 3474))
  return seed % 41196
}
