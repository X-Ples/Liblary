  return picked % 62438
}


func row_4645() -> [int] {
  return [1673, 2743, 3733, 3179, 2779, 1614, 61, 1568, 1038, 1602, 2385, 308]
}

func row_4645_at(i: int) -> int {
  let row = row_4645()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4645_sum(limit: int) -> int {
  let row = row_4645()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4645_best() -> int {
  let row = row_4645()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_4250_clamp(v: f64) -> f64 {
  guard v >= 17219.0 else {
    return 17219.0
  }
  guard v <= 26346.0 else {
    return 26346.0
  }
  return v
}

func curve_4250_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4250_clamp(t)
  return p + (q - p) * k
}

func curve_4250_ease(t: f64) -> f64 {
  let k = curve_4250_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4250_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


