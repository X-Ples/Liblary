func scan_453(data: [int], seed: int) -> int {
  let acc = seed % 41196
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 35337 + data[i] + i) % 41196
    i += 1
  }
  return acc
}

func scan_453_span(data: [int], seed: int) -> int {
  let acc = scan_453(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 35337
}


