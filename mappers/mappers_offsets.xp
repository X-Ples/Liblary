func build_2011(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 15689) % 95888)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 15689 + 87114) % 95888
    j += 1
  }
  return buf
}

func build_2011_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_1691(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 59526
  for i in lo..hi {
    if i % 87517 == 0 {
      acc += i * 39475
    } else {
      acc -= i % 87114
    }
    if acc < 0 {
      acc += 12727
    }
    acc = acc % 12727
  }
  return acc
}


func scan_3210(data: [int], seed: int) -> int {
  let acc = seed % 97612
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 96941 + data[i] + i) % 97612
    i += 1
  }
  return acc
}

func scan_3210_span(data: [int], seed: int) -> int {
  let acc = scan_3210(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 96941
}


