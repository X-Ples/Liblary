func order_7557(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7557_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_5169_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 60200
    i += 1
  }
  return acc % 60200
}

func text_5169_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "gamma"
}

func text_5169_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 5568
}


func grid_4963_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 60200 + c * 12727 + seed) % 12727)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4963_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 12727 == want {
      total += acc
    }
    r += 1
  }
  return total
}


