func demo_offsets(seed: int) -> int {
  let scratch = build_2011(seed % 61 + 6, seed % 96941)
  show(len(scratch))
  show(build_2011_last(scratch))
  show(sweep_1691(120, 2136))
  show(scan_3210(scratch, 231))
  show(scan_3210_span(scratch, 3162))
  show(scan_6211(scratch, 3359))
  return seed % 27351
}
