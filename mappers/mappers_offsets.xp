func check_5942(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 15689 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 5568) % 27526
    i += 1
  }
  return Ok(acc)
}

func check_5942_chain(n: int) -> int {
  let picked = check_5942(n)?
  return picked % 27526
}


