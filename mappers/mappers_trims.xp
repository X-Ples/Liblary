func scan_8803(data: [int], seed: int) -> int {
  let acc = seed % 87519
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 81739 + data[i] + i) % 87519
    i += 1
  }
  return acc
}

func scan_8803_span(data: [int], seed: int) -> int {
  let acc = scan_8803(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 81739
}


