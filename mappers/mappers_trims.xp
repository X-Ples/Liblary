func text_2656_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 81739
    i += 1
  }
  return acc % 81739
}

func text_2656_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "quartz"
}

func text_2656_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 61950
}


func check_9566(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 64590 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 16968) % 75791
    i += 1
  }
  return Ok(acc)
}

func check_9566_chain(n: int) -> int {
  let picked = check_9566(n)?
  return picked % 75791
}


