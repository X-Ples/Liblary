func sweep_7160(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 47478
  for i in lo..hi {
    if i % 93126 == 0 {
      acc += i * 80008
    } else {
      acc -= i % 81739
    }
    if acc < 0 {
      acc += 93126
    }
    acc = acc % 93126
  }
  return acc
}


func demo_trims(seed: int) -> int {
  let scratch = build_1399(seed % 61 + 6, seed % 60883)
  show(len(scratch))
  show(order_1193_find(scratch, 2357))
  show(order_6103_find(scratch, 1723))
  show(build_1399_last(scratch))
  show(order_6474_find(scratch, 3834))
  show(order_1917_find(scratch, 1557))
  show(grid_6828_rowsum(scratch, 1866, 15, 3611))
  return seed % 33206
}
