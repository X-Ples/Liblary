func row_5531() -> [int] {
  return [410, 759, 2846, 2933, 2306, 2097, 3922, 670, 665, 3960, 1478, 28, 361]
}

func row_5531_at(i: int) -> int {
  let row = row_5531()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5531_sum(limit: int) -> int {
  let row = row_5531()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5531_best() -> int {
  let row = row_5531()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


