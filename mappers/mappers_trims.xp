func curve_8433_clamp(v: f64) -> f64 {
  guard v >= 94250.0 else {
    return 94250.0
  }
  guard v <= 99351.0 else {
    return 99351.0
  }
  return v
}

func curve_8433_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8433_clamp(t)
  return p + (q - p) * k
}

func curve_8433_ease(t: f64) -> f64 {
  let k = curve_8433_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8433_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func curve_8145_clamp(v: f64) -> f64 {
  guard v >= 91767.0 else {
    return 91767.0
  }
  guard v <= 93376.0 else {
    return 93376.0
  }
  return v
}

func curve_8145_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8145_clamp(t)
  return p + (q - p) * k
}

func curve_8145_ease(t: f64) -> f64 {
  let k = curve_8145_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8145_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


