func row_7032() -> [int] {
  return [1853, 82, 1611, 2228, 915, 531, 950, 3519, 2838, 108, 2026]
}

func row_7032_at(i: int) -> int {
  let row = row_7032()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7032_sum(limit: int) -> int {
  let row = row_7032()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7032_best() -> int {
  let row = row_7032()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_9494_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 37067 + c * 36731 + seed) % 36731)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9494_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 36731 == want {
      total += acc
    }
    r += 1
  }
  return total
}


