func demo_walkers(seed: int) -> int {
  let scratch = build_1735(seed % 61 + 6, seed % 49524)
  show(len(scratch))
  show(check_5726_chain(3611))
  show(build_1735_last(scratch))
  show(order_2300_find(scratch, 2680))
  show(build_9829_last(scratch))
  show(order_9547_find(scratch, 2322))
  return seed % 55338
}
