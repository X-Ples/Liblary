func demo_windows(seed: int) -> int {
  let scratch = build_2983(seed % 61 + 6, seed % 27049)
  show(len(scratch))
  show(build_2983_last(scratch))
  show(grid_8639_rowsum(scratch, 72, 2764, 2941))
  show(check_5927_chain(3526))
  show(check_6658_chain(2739))
  return seed % 55355
}
