func sweep_7256(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 14069
  for i in lo..hi {
    if i % 18497 == 0 {
      acc += i * 14069
    } else {
      acc -= i % 87260
    }
    if acc < 0 {
      acc += 5416
    }
    acc = acc % 5416
  }
  return acc
}


