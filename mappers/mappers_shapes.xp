func demo_shapes(seed: int) -> int {
  let scratch = build_1872(seed % 61 + 6, seed % 8064)
  show(len(scratch))
  show(build_1872_last(scratch))
  show(scan_1197(scratch, 3888))
  show(scan_1197_span(scratch, 353))
  show(grid_506_rowsum(scratch, 2853, 282, 2956))
  show(row_7940_at(3912))
  return seed % 19994
}
