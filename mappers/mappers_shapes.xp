func build_1872(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 82132) % 75732)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 82132 + 73346) % 75732
    j += 1
  }
  return buf
}

func build_1872_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_1197(data: [int], seed: int) -> int {
  let acc = seed % 73346
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 62070 + data[i] + i) % 73346
    i += 1
  }
  return acc
}

func scan_1197_span(data: [int], seed: int) -> int {
  let acc = scan_1197(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 62070
}


func grid_506_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 65906 + c * 83298 + seed) % 83298)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_506_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 83298 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_7018_clamp(v: f64) -> f64 {
  guard v >= 19994.0 else {
    return 19994.0
  }
  guard v <= 54605.0 else {
    return 54605.0
  }
  return v
}

func curve_7018_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7018_clamp(t)
  return p + (q - p) * k
}

func curve_7018_ease(t: f64) -> f64 {
  let k = curve_7018_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7018_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_7940() -> [int] {
  return [2840, 2181, 2859, 2100, 2030, 852, 2104, 915, 322, 2054, 3921, 2725, 3070, 612, 1542, 3920, 276, 1212, 3308]
}

func row_7940_at(i: int) -> int {
  let row = row_7940()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7940_sum(limit: int) -> int {
  let row = row_7940()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7940_best() -> int {
  let row = row_7940()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_8932(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 22662 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 95931) % 95931
    i += 1
  }
  return Ok(acc)
}

func check_8932_chain(n: int) -> int {
  let picked = check_8932(n)?
  return picked % 95931
}


