func build_401(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 83916) % 1095)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 83916 + 24249) % 1095
    j += 1
  }
  return buf
}

func build_401_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_1214(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 91245
  for i in lo..hi {
    if i % 71510 == 0 {
      acc += i * 93497
    } else {
      acc -= i % 34500
    }
    if acc < 0 {
      acc += 1095
    }
    acc = acc % 1095
  }
  return acc
}


