func row_2566() -> [int] {
  return [635, 1714, 3245, 3432, 3189, 2910, 1988, 4062, 4000, 2700, 2201, 470, 2618, 1953, 1969]
}

func row_2566_at(i: int) -> int {
  let row = row_2566()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2566_sum(limit: int) -> int {
  let row = row_2566()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2566_best() -> int {
  let row = row_2566()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


