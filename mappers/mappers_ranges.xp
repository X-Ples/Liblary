func demo_ranges(seed: int) -> int {
  let scratch = build_401(seed % 61 + 6, seed % 83916)
  show(len(scratch))
  show(build_401_last(scratch))
  show(sweep_1214(436, 2761))
  show(build_1791_last(scratch))
  show(row_2566_at(2163))
  show(row_2566_sum(2423))
  show(row_2566_best())
  return seed % 96584
}
