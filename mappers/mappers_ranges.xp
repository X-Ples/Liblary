func grid_547_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 56289 + c * 69384 + seed) % 69384)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_547_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 69384 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_1135(data: [int], seed: int) -> int {
  let acc = seed % 34500
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 83916 + data[i] + i) % 34500
    i += 1
  }
  return acc
}

func scan_1135_span(data: [int], seed: int) -> int {
  let acc = scan_1135(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 83916
}


