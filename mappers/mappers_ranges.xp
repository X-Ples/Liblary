func check_8330(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 1095 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 73386) % 59973
    i += 1
  }
  return Ok(acc)
}

func check_8330_chain(n: int) -> int {
  let picked = check_8330(n)?
  return picked % 59973
}


