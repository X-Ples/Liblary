func text_1562_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 29144
    i += 1
  }
  return acc % 29144
}

func text_1562_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "ridge"
}

func text_1562_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 37574
}


func grid_2536_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 39743 + c * 61624 + seed) % 61624)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2536_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 61624 == want {
      total += acc
    }
    r += 1
  }
  return total
}


