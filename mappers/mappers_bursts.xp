func check_5035(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 78172 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 64323) % 21007
    i += 1
  }
  return Ok(acc)
}

func check_5035_chain(n: int) -> int {
  let picked = check_5035(n)?
  return picked % 21007
}


