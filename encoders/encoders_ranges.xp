func row_5121() -> [int] {
  return [3777, 3249, 1400, 1853, 1657, 3364, 2554, 360, 377, 1797, 3929, 3891]
}

func row_5121_at(i: int) -> int {
  let row = row_5121()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5121_sum(limit: int) -> int {
  let row = row_5121()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5121_best() -> int {
  let row = row_5121()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_2931_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 53216 + c * 30249 + seed) % 30249)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2931_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 30249 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_2696(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 88861
  for i in lo..hi {
    if i % 47618 == 0 {
      acc += i * 55076
    } else {
      acc -= i % 57779
    }
    if acc < 0 {
      acc += 83680
    }
    acc = acc % 83680
  }
  return acc
}


