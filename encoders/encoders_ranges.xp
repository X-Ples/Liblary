func demo_ranges(seed: int) -> int {
  let scratch = build_1612(seed % 61 + 6, seed % 65008)
  show(len(scratch))
  show(build_1612_last(scratch))
  show(build_3141_last(scratch))
  show(row_5121_at(703))
  show(row_5121_sum(2465))
  return seed % 77237
}
