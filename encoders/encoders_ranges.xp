func check_9773(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 93630 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 22304) % 96295
    i += 1
  }
  return Ok(acc)
}

func check_9773_chain(n: int) -> int {
  let picked = check_9773(n)?
  return picked % 96295
}


