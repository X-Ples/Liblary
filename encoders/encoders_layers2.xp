func build_5268(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 70526) % 58597)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 70526 + 11144) % 58597
    j += 1
  }
  return buf
}

func build_5268_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_6881(data: [int], seed: int) -> int {
  let acc = seed % 7134
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 70526 + data[i] + i) % 7134
    i += 1
  }
  return acc
}

func scan_6881_span(data: [int], seed: int) -> int {
  let acc = scan_6881(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 70526
}


func curve_1194_clamp(v: f64) -> f64 {
  guard v >= 16360.0 else {
    return 16360.0
  }
  guard v <= 29623.0 else {
    return 29623.0
  }
  return v
}

func curve_1194_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1194_clamp(t)
  return p + (q - p) * k
}

func curve_1194_ease(t: f64) -> f64 {
  let k = curve_1194_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1194_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_331(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 43967 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 29287) % 70526
    i += 1
  }
  return Ok(acc)
}

func check_331_chain(n: int) -> int {
  let picked = check_331(n)?
  return picked % 70526
}


func order_8288(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8288_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_7997(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 29494
  for i in lo..hi {
    if i % 23864 == 0 {
      acc += i * 67452
    } else {
      acc -= i % 58597
    }
    if acc < 0 {
      acc += 5304
    }
    acc = acc % 5304
  }
  return acc
}


