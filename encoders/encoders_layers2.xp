func demo_layers2(seed: int) -> int {
  let scratch = build_5268(seed % 61 + 6, seed % 72571)
  show(len(scratch))
  show(build_5268_last(scratch))
  show(scan_6881(scratch, 602))
  show(scan_6881_span(scratch, 2088))
  return seed % 29494
}
