func curve_320_clamp(v: f64) -> f64 {
  guard v >= 11792.0 else {
    return 11792.0
  }
  guard v <= 14736.0 else {
    return 14736.0
  }
  return v
}

func curve_320_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_320_clamp(t)
  return p + (q - p) * k
}

func curve_320_ease(t: f64) -> f64 {
  let k = curve_320_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_320_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_4128(data: [int], seed: int) -> int {
  let acc = seed % 78636
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 22323 + data[i] + i) % 78636
    i += 1
  }
  return acc
}

func scan_4128_span(data: [int], seed: int) -> int {
  let acc = scan_4128(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 22323
}


