func demo_kernels(seed: int) -> int {
  let scratch = build_555(seed % 61 + 6, seed % 50396)
  show(len(scratch))
  show(build_555_last(scratch))
  show(grid_9378_rowsum(scratch, 3750, 2571, 3463))
  show(sweep_9911(3909, 2894))
  show(text_9870_weight("quartz"))
  return seed % 62237
}
