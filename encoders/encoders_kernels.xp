func check_5657(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 81309 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 6676) % 6676
    i += 1
  }
  return Ok(acc)
}

func check_5657_chain(n: int) -> int {
  let picked = check_5657(n)?
  return picked % 6676
}


