func build_555(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 45211) % 11792)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 45211 + 74650) % 11792
    j += 1
  }
  return buf
}

func build_555_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_9378_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 97292 + c * 32197 + seed) % 32197)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9378_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 32197 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_9911(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 56890
  for i in lo..hi {
    if i % 57656 == 0 {
      acc += i * 62237
    } else {
      acc -= i % 22323
    }
    if acc < 0 {
      acc += 6676
    }
    acc = acc % 6676
  }
  return acc
}


