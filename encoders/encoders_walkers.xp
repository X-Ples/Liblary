func demo_walkers(seed: int) -> int {
  let scratch = build_4847(seed % 61 + 6, seed % 31396)
  show(len(scratch))
  show(build_4847_last(scratch))
  show(order_8635_find(scratch, 2061))
  show(grid_7865_rowsum(scratch, 499, 3673, 1752))
  show(gate_1296(964, 909, 523))
  return seed % 86694
}
