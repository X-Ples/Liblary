func check_9726(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 95499 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 42062) % 15382
    i += 1
  }
  return Ok(acc)
}

func check_9726_chain(n: int) -> int {
  let picked = check_9726(n)?
  return picked % 15382
}


