func scan_4953(data: [int], seed: int) -> int {
  let acc = seed % 63685
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 98988 + data[i] + i) % 63685
    i += 1
  }
  return acc
}

func scan_4953_span(data: [int], seed: int) -> int {
  let acc = scan_4953(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 98988
}


