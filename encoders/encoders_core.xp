func scan_7312(data: [int], seed: int) -> int {
  let acc = seed % 93338
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 7618 + data[i] + i) % 93338
    i += 1
  }
  return acc
}

func scan_7312_span(data: [int], seed: int) -> int {
  let acc = scan_7312(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 7618
}


