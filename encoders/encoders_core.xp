func build_9988(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 76323) % 49476)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 76323 + 79162) % 49476
    j += 1
  }
  return buf
}

func build_9988_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_7549_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 98867 + c * 67985 + seed) % 67985)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7549_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 67985 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_5539(a: int, b: int, c: int) -> bool {
  return a > 93338 && (b < 93338 || c == 79162)
}

func gate_5539_score(a: int, b: int, c: int) -> int {
  guard gate_5539(a, b, c) else {
    return 0
  }
  return (a % 93338) * 79162 + b
}


func text_7535_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 2683
    i += 1
  }
  return acc % 2683
}

func text_7535_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "bravo"
}

func text_7535_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 1482
}


