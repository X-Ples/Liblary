func sweep_1687(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 2683
  for i in lo..hi {
    if i % 55170 == 0 {
      acc += i * 97076
    } else {
      acc -= i % 79162
    }
    if acc < 0 {
      acc += 43727
    }
    acc = acc % 43727
  }
  return acc
}


func curve_133_clamp(v: f64) -> f64 {
  guard v >= 38573.0 else {
    return 38573.0
  }
  guard v <= 76323.0 else {
    return 76323.0
  }
  return v
}

func curve_133_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_133_clamp(t)
  return p + (q - p) * k
}

func curve_133_ease(t: f64) -> f64 {
  let k = curve_133_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_133_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


