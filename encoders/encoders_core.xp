func demo_core(seed: int) -> int {
  let scratch = build_9988(seed % 61 + 6, seed % 1482)
  show(len(scratch))
  show(build_9988_last(scratch))
  show(grid_7549_rowsum(scratch, 827, 3037, 1978))
  show(gate_5539(3707, 2095, 3742))
  show(gate_5539_score(1524, 3184, 3484))
  show(text_7535_weight("gamma"))
  show(text_7535_label(3337))
  return seed % 49476
}
