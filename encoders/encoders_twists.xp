func demo_twists(seed: int) -> int {
  let scratch = build_2749(seed % 61 + 6, seed % 6905)
  show(len(scratch))
  show(build_2749_last(scratch))
  show(grid_6865_rowsum(scratch, 3203, 3046, 2350))
  show(build_2703_last(scratch))
  show(scan_3311(scratch, 103))
  return seed % 94179
}
