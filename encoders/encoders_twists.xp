func curve_9264_clamp(v: f64) -> f64 {
  guard v >= 71086.0 else {
    return 71086.0
  }
  guard v <= 99036.0 else {
    return 99036.0
  }
  return v
}

func curve_9264_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9264_clamp(t)
  return p + (q - p) * k
}

func curve_9264_ease(t: f64) -> f64 {
  let k = curve_9264_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9264_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_3311(data: [int], seed: int) -> int {
  let acc = seed % 30922
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 69899 + data[i] + i) % 30922
    i += 1
  }
