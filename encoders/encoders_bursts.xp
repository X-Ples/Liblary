func scan_3458(data: [int], seed: int) -> int {
  let acc = seed % 14538
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 28008 + data[i] + i) % 14538
    i += 1
  }
  return acc
}

func scan_3458_span(data: [int], seed: int) -> int {
  let acc = scan_3458(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 28008
}


func row_7548() -> [int] {
