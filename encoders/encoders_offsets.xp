func check_1643(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 97631 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 69429) % 53910
    i += 1
  }
  return Ok(acc)
}

func check_1643_chain(n: int) -> int {
  let picked = check_1643(n)?
  return picked % 53910
}


