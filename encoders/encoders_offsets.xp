func sweep_4115(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 92046
  for i in lo..hi {
    if i % 53910 == 0 {
      acc += i * 53910
    } else {
      acc -= i % 76570
    }
    if acc < 0 {
      acc += 53210
    }
    acc = acc % 53210
  }
  return acc
}


