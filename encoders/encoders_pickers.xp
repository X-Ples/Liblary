func demo_pickers(seed: int) -> int {
  let scratch = build_8791(seed % 61 + 6, seed % 59330)
  show(len(scratch))
  show(build_8791_last(scratch))
  show(gate_4560(1413, 2392, 2408))
  show(gate_4560_score(2719, 2696, 360))
  show(row_5458_at(873))
  show(row_5458_sum(1145))
  return seed % 15341
}
