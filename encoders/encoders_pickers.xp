func check_8219(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 98528 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 10550) % 25872
    i += 1
  }
  return Ok(acc)
}

func check_8219_chain(n: int) -> int {
  let picked = check_8219(n)?
  return picked % 25872
}


