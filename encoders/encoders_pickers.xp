func build_8791(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 43019) % 18396)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 43019 + 17881) % 18396
    j += 1
  }
  return buf
}

func build_8791_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_4560(a: int, b: int, c: int) -> bool {
  return a > 8684 && (b < 10550 || c == 15341)
}

func gate_4560_score(a: int, b: int, c: int) -> int {
  guard gate_4560(a, b, c) else {
    return 0
  }
  return (a % 10550) * 15341 + b
}


func row_5458() -> [int] {
  return [3994, 2980, 4015, 3874, 3839, 959, 983, 746, 2568, 1577, 1678, 1308, 209, 1214, 3988, 1645, 528, 2507]
}

func row_5458_at(i: int) -> int {
  let row = row_5458()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5458_sum(limit: int) -> int {
  let row = row_5458()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5458_best() -> int {
  let row = row_5458()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_8756_clamp(v: f64) -> f64 {
  guard v >= 7809.0 else {
    return 7809.0
  }
  guard v <= 43156.0 else {
    return 43156.0
  }
  return v
}

func curve_8756_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8756_clamp(t)
  return p + (q - p) * k
}

func curve_8756_ease(t: f64) -> f64 {
  let k = curve_8756_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8756_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


