func build_520(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 9645) % 18571)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 9645 + 6795) % 18571
    j += 1
  }
  return buf
}

func build_520_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_3707_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 1852
    i += 1
  }
  return acc % 1852
}

func text_3707_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "talus"
}

func text_3707_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 20825
}


