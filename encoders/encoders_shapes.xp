func check_8682(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 55094 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 90666) % 99125
    i += 1
  }
  return Ok(acc)
}

func check_8682_chain(n: int) -> int {
  let picked = check_8682(n)?
  return picked % 99125
}


