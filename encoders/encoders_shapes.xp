func scan_7467(data: [int], seed: int) -> int {
  let acc = seed % 50184
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 1852 + data[i] + i) % 50184
    i += 1
  }
  return acc
}

func scan_7467_span(data: [int], seed: int) -> int {
  let acc = scan_7467(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 1852
}


func row_857() -> [int] {
  return [3873, 1593, 3748, 3041, 1411, 3850, 712, 3987, 232, 3798]
}

func row_857_at(i: int) -> int {
  let row = row_857()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_857_sum(limit: int) -> int {
  let row = row_857()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_857_best() -> int {
  let row = row_857()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_3188_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 12317 + c * 50184 + seed) % 50184)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3188_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 50184 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_8317_clamp(v: f64) -> f64 {
  guard v >= 6795.0 else {
    return 6795.0
  }
  guard v <= 15623.0 else {
    return 15623.0
  }
  return v
}

func curve_8317_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8317_clamp(t)
  return p + (q - p) * k
}

func curve_8317_ease(t: f64) -> f64 {
  let k = curve_8317_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8317_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


