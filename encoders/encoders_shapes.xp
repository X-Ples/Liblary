func demo_shapes(seed: int) -> int {
  let scratch = build_520(seed % 61 + 6, seed % 67768)
  show(len(scratch))
  show(build_520_last(scratch))
  show(text_3707_weight("omega"))
  show(text_3707_label(195))
  show(text_3707_has("flint"))
  show(gate_2973(1883, 1673, 1196))
  return seed % 99125
}
