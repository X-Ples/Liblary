func build_3972(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 6775) % 35697)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 6775 + 69161) % 35697
    j += 1
  }
  return buf
}

func build_3972_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_9786() -> [int] {
  return [3526, 1561, 4084, 2757, 1949, 784, 78, 3173, 537, 1802, 1246, 546, 4054, 2583, 3925, 1166, 2912, 1302, 3738, 1465, 540]
}

func row_9786_at(i: int) -> int {
  let row = row_9786()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9786_sum(limit: int) -> int {
  let row = row_9786()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9786_best() -> int {
  let row = row_9786()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_2880(data: [int], seed: int) -> int {
  let acc = seed % 35697
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 12962 + data[i] + i) % 35697
    i += 1
  }
  return acc
}

func scan_2880_span(data: [int], seed: int) -> int {
  let acc = scan_2880(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 12962
}


