func demo_trims(seed: int) -> int {
  let scratch = build_3972(seed % 61 + 6, seed % 12962)
  show(len(scratch))
  show(build_3972_last(scratch))
  show(row_9786_at(3106))
  show(row_9786_sum(3640))
