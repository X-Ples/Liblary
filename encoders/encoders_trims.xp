func check_3436(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 29227 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 83793) % 38865
    i += 1
  }
  return Ok(acc)
}

func check_3436_chain(n: int) -> int {
  let picked = check_3436(n)?
  return picked % 38865
}


func curve_6099_clamp(v: f64) -> f64 {
  guard v >= 6775.0 else {
    return 6775.0
  }
  guard v <= 69161.0 else {
    return 69161.0
  }
  return v
}

func curve_6099_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6099_clamp(t)
  return p + (q - p) * k
}

func curve_6099_ease(t: f64) -> f64 {
  let k = curve_6099_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6099_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


