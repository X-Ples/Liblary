func demo_blends(seed: int) -> int {
  let scratch = build_9261(seed % 61 + 6, seed % 76479)
  show(len(scratch))
  show(build_9261_last(scratch))
  show(check_3408_chain(3847))
  show(sweep_5991(3076, 3891))
  show(grid_921_rowsum(scratch, 37, 821, 731))
  show(build_4504_last(scratch))
  return seed % 92458
}
