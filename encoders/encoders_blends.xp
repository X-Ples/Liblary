  let acc = seed % 72876
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 46433 + data[i] + i) % 72876
    i += 1
  }
  return acc
}

func scan_4314_span(data: [int], seed: int) -> int {
  let acc = scan_4314(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 46433
}


