func build_9261(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 25889) % 60793)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 25889 + 16684) % 60793
    j += 1
  }
  return buf
}

func build_9261_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_6137_clamp(v: f64) -> f64 {
  guard v >= 20380.0 else {
    return 20380.0
  }
  guard v <= 25889.0 else {
    return 25889.0
  }
  return v
}

func curve_6137_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6137_clamp(t)
  return p + (q - p) * k
}

func curve_6137_ease(t: f64) -> f64 {
  let k = curve_6137_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6137_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_3408(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 80304 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 51367) % 51367
    i += 1
  }
  return Ok(acc)
}

func check_3408_chain(n: int) -> int {
  let picked = check_3408(n)?
  return picked % 51367
}


func sweep_5991(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 69442
  for i in lo..hi {
    if i % 83758 == 0 {
      acc += i * 38270
    } else {
      acc -= i % 72876
    }
    if acc < 0 {
      acc += 28103
    }
    acc = acc % 28103
  }
  return acc
}


func grid_921_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 91195 + c * 27141 + seed) % 27141)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_921_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 27141 == want {
      total += acc
    }
    r += 1
  }
  return total
}


