func curve_379_clamp(v: f64) -> f64 {
  guard v >= 36053.0 else {
    return 36053.0
  }
  guard v <= 71196.0 else {
    return 71196.0
  }
  return v
}

func curve_379_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_379_clamp(t)
  return p + (q - p) * k
}

func curve_379_ease(t: f64) -> f64 {
  let k = curve_379_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_379_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_1504(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 87514 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 85013) % 75659
    i += 1
  }
  return Ok(acc)
}

func check_1504_chain(n: int) -> int {
  let picked = check_1504(n)?
  return picked % 75659
}


func build_7194(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 57623) % 84308)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 57623 + 57623) % 84308
    j += 1
  }
  return buf
}

func build_7194_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_4807(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 87514
  for i in lo..hi {
    if i % 87514 == 0 {
      acc += i * 22336
    } else {
      acc -= i % 73872
    }
    if acc < 0 {
      acc += 89142
    }
    acc = acc % 89142
  }
  return acc
}


func grid_3405_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 22336 + c * 27795 + seed) % 27795)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3405_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 27795 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_4394(a: int, b: int, c: int) -> bool {
  return a > 52130 && (b < 52130 || c == 57623)
}

func gate_4394_score(a: int, b: int, c: int) -> int {
  guard gate_4394(a, b, c) else {
    return 0
  }
  return (a % 52130) * 57623 + b
}


func order_4070(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4070_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


