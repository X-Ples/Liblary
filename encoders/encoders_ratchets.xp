    return 0
  }
  return row[i]
}

func row_4305_sum(limit: int) -> int {
  let row = row_4305()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
