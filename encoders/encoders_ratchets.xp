func demo_ratchets(seed: int) -> int {
  let scratch = build_7194(seed % 61 + 6, seed % 87514)
  show(len(scratch))
  show(check_1504_chain(2424))
  show(build_7194_last(scratch))
  show(sweep_4807(3081, 1646))
  show(grid_3405_rowsum(scratch, 73, 2355, 3071))
  return seed % 77752
}
