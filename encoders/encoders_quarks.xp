}


func curve_5226_clamp(v: f64) -> f64 {
  guard v >= 64337.0 else {
    return 64337.0
  }
  guard v <= 80460.0 else {
    return 80460.0
  }
  return v
}

func curve_5226_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5226_clamp(t)
  return p + (q - p) * k
}

func curve_5226_ease(t: f64) -> f64 {
  let k = curve_5226_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5226_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_5038(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 80723 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 13368) % 66860
    i += 1
  }
  return Ok(acc)
}

func check_5038_chain(n: int) -> int {
  let picked = check_5038(n)?
  return picked % 66860
}


func scan_2058(data: [int], seed: int) -> int {
  let acc = seed % 13368
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 80460 + data[i] + i) % 13368
    i += 1
  }
  return acc
}

func scan_2058_span(data: [int], seed: int) -> int {
  let acc = scan_2058(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 80460
}


func text_1612_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 22576
    i += 1
  }
  return acc % 22576
}

func text_1612_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "omega"
}

func text_1612_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 41653
}


func grid_6752_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 9364 + c * 82124 + seed) % 82124)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6752_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 82124 == want {
      total += acc
    }
    r += 1
  }
  return total
}


