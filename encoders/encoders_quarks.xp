func demo_quarks(seed: int) -> int {
  let scratch = build_680(seed % 61 + 6, seed % 86447)
  show(len(scratch))
  show(build_680_last(scratch))
  show(build_3304_last(scratch))
  show(check_5038_chain(2694))
  show(scan_2058(scratch, 2425))
  return seed % 99429
}
