func build_6672(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 14146) % 13395)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 14146 + 70403) % 13395
    j += 1
  }
  return buf
}

func build_6672_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_4546_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 21596
    i += 1
  }
  return acc % 21596
}

func text_4546_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "alpha"
}

func text_4546_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 99386
}


