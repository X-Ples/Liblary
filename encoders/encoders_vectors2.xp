func row_6578() -> [int] {
  return [3019, 3469, 3148, 743, 2060, 448, 78, 2858, 156, 150, 4068, 3534]
}

func row_6578_at(i: int) -> int {
  let row = row_6578()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6578_sum(limit: int) -> int {
  let row = row_6578()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6578_best() -> int {
  let row = row_6578()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


