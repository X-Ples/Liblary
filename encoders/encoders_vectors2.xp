func grid_6084_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 8510 + c * 85379 + seed) % 85379)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6084_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 85379 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_4685(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 26977
  for i in lo..hi {
    if i % 70403 == 0 {
      acc += i * 71951
    } else {
      acc -= i % 65997
    }
    if acc < 0 {
      acc += 21596
    }
    acc = acc % 21596
  }
  return acc
}


