func check_3827(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 49884 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 79015) % 4206
    i += 1
  }
  return Ok(acc)
}

func check_3827_chain(n: int) -> int {
  let picked = check_3827(n)?
  return picked % 4206
}


func sweep_224(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 87062
  for i in lo..hi {
    if i % 1184 == 0 {
      acc += i * 79015
    } else {
      acc -= i % 65768
    }
    if acc < 0 {
      acc += 89895
    }
    acc = acc % 89895
  }
  return acc
}


func scan_6949(data: [int], seed: int) -> int {
  let acc = seed % 94243
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 93976 + data[i] + i) % 94243
    i += 1
  }
  return acc
}

func scan_6949_span(data: [int], seed: int) -> int {
  let acc = scan_6949(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 93976
}


