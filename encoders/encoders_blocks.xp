func grid_5510_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 20188 + c * 62800 + seed) % 62800)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5510_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 62800 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_8294(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 71019
  for i in lo..hi {
    if i % 16610 == 0 {
      acc += i * 37288
    } else {
      acc -= i % 81853
    }
    if acc < 0 {
      acc += 53752
    }
    acc = acc % 53752
  }
  return acc
}


