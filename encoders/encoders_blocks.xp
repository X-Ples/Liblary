func text_3861_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "delta"
}

func text_3861_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 51100
}


func curve_5988_clamp(v: f64) -> f64 {
  guard v >= 68648.0 else {
    return 68648.0
  }
  guard v <= 98204.0 else {
    return 98204.0
  }
  return v
}

func curve_5988_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5988_clamp(t)
  return p + (q - p) * k
}

func curve_5988_ease(t: f64) -> f64 {
  let k = curve_5988_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5988_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


