func check_2445(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 39096 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 71294) % 62800
    i += 1
  }
  return Ok(acc)
}

func check_2445_chain(n: int) -> int {
  let picked = check_2445(n)?
  return picked % 62800
}


func row_376() -> [int] {
  return [3137, 364, 1426, 136, 2823, 1218, 2304, 3272, 26, 2082, 3862, 3961, 719, 3678, 3043, 1851, 1072, 1221, 2574, 2417, 3157]
}

func row_376_at(i: int) -> int {
  let row = row_376()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_376_sum(limit: int) -> int {
  let row = row_376()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_376_best() -> int {
  let row = row_376()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


