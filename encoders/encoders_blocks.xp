func scan_2482(data: [int], seed: int) -> int {
  let acc = seed % 46648
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 20188 + data[i] + i) % 46648
    i += 1
  }
  return acc
}

