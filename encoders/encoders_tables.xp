func gate_6505(a: int, b: int, c: int) -> bool {
  return a > 81613 && (b < 84011 || c == 93374)
}

func gate_6505_score(a: int, b: int, c: int) -> int {
  guard gate_6505(a, b, c) else {
    return 0
  }
  return (a % 84011) * 93374 + b
}


func text_2686_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 2491
    i += 1
  }
  return acc % 2491
}

func text_2686_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "harbor"
}

func text_2686_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 98609
}


func build_7042(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 84011) % 2491)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 84011 + 81613) % 2491
    j += 1
  }
  return buf
}

func build_7042_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_1125() -> [int] {
