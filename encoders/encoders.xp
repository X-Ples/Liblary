func sweep_6620(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 35667
  for i in lo..hi {
    if i % 72913 == 0 {
      acc += i * 25022
    } else {
      acc -= i % 72913
    }
    if acc < 0 {
      acc += 72913
    }
    acc = acc % 72913
  }
  return acc
}


