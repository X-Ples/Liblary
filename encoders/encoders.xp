func build_9443(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 46308) % 62631)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 46308 + 46308) % 62631
    j += 1
  }
  return buf
}

func build_9443_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_6542_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 1268
    i += 1
  }
  return acc % 1268
}

func text_6542_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "prism"
}

func text_6542_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 1268
}


func scan_9289(data: [int], seed: int) -> int {
  let acc = seed % 55978
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 34272 + data[i] + i) % 55978
    i += 1
  }
  return acc
}

func scan_9289_span(data: [int], seed: int) -> int {
  let acc = scan_9289(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 34272
}


func check_3365(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 62903 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 62631) % 12349
    i += 1
  }
  return Ok(acc)
}

func check_3365_chain(n: int) -> int {
  let picked = check_3365(n)?
  return picked % 12349
}


func curve_8779_clamp(v: f64) -> f64 {
  guard v >= 35667.0 else {
    return 35667.0
  }
  guard v <= 62631.0 else {
    return 62631.0
  }
  return v
}

func curve_8779_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8779_clamp(t)
  return p + (q - p) * k
}

func curve_8779_ease(t: f64) -> f64 {
  let k = curve_8779_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8779_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


