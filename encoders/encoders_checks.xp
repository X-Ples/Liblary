func build_8711(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 61339) % 15351)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 61339 + 3269) % 15351
    j += 1
  }
  return buf
}

func build_8711_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_5617(a: int, b: int, c: int) -> bool {
  return a > 9601 && (b < 3269 || c == 53917)
}

func gate_5617_score(a: int, b: int, c: int) -> int {
  guard gate_5617(a, b, c) else {
    return 0
  }
  return (a % 3269) * 53917 + b
}


func sweep_6353(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 90999
  for i in lo..hi {
    if i % 90463 == 0 {
      acc += i * 51270
    } else {
      acc -= i % 89296
    }
    if acc < 0 {
      acc += 44598
    }
    acc = acc % 44598
  }
  return acc
}


