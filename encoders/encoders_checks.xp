func text_271_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 90999
    i += 1
  }
  return acc % 90999
}

func text_271_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "cargo"
}

func text_271_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 51270
}


