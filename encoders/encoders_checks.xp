func scan_7489(data: [int], seed: int) -> int {
  let acc = seed % 15351
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 9601 + data[i] + i) % 15351
    i += 1
  }
  return acc
}

func scan_7489_span(data: [int], seed: int) -> int {
  let acc = scan_7489(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 9601
}


