func demo_checks(seed: int) -> int {
  let scratch = build_8711(seed % 61 + 6, seed % 44598)
  show(len(scratch))
  show(build_8711_last(scratch))
  show(gate_5617(1601, 2328, 797))
  show(gate_5617_score(1713, 1164, 3824))
  show(sweep_6353(2236, 2735))
  return seed % 40638
