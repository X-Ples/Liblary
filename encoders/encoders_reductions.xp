func curve_7409_clamp(v: f64) -> f64 {
  guard v >= 26130.0 else {
    return 26130.0
  }
  guard v <= 79604.0 else {
    return 79604.0
  }
  return v
}

func curve_7409_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7409_clamp(t)
  return p + (q - p) * k
}

func curve_7409_ease(t: f64) -> f64 {
  let k = curve_7409_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7409_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_4436(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 48491 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 70861) % 79604
    i += 1
  }
  return Ok(acc)
}

func check_4436_chain(n: int) -> int {
  let picked = check_4436(n)?
  return picked % 79604
}


