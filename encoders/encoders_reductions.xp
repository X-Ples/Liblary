func build_3670(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 8909) % 26130)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 8909 + 84476) % 26130
    j += 1
  }
  return buf
}

func build_3670_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_9236(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 30593
  for i in lo..hi {
    if i % 57476 == 0 {
      acc += i * 70261
    } else {
      acc -= i % 41745
    }
    if acc < 0 {
      acc += 33691
    }
    acc = acc % 33691
  }
  return acc
}


func gate_5628(a: int, b: int, c: int) -> bool {
  return a > 26450 && (b < 21524 || c == 14197)
}

func gate_5628_score(a: int, b: int, c: int) -> int {
  guard gate_5628(a, b, c) else {
    return 0
  }
  return (a % 21524) * 14197 + b
}


func grid_9154_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 42683 + c * 8909 + seed) % 8909)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9154_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 8909 == want {
      total += acc
    }
    r += 1
  }
  return total
}


