func demo_reductions(seed: int) -> int {
  let scratch = build_3670(seed % 61 + 6, seed % 52276)
  show(len(scratch))
  show(build_3670_last(scratch))
  show(sweep_9236(3310, 3040))
  show(gate_5628(2080, 3251, 2405))
  return seed % 40130
}
