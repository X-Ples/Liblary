func row_9752() -> [int] {
  return [1922, 2305, 3023, 2215, 3165, 1338, 785, 2979, 1780, 50, 2903, 2185, 1878, 745, 1711]
}

func row_9752_at(i: int) -> int {
  let row = row_9752()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9752_sum(limit: int) -> int {
  let row = row_9752()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9752_best() -> int {
  let row = row_9752()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


