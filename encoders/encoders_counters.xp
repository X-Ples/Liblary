func demo_counters(seed: int) -> int {
  let scratch = build_6721(seed % 61 + 6, seed % 87616)
  show(len(scratch))
  show(build_6721_last(scratch))
  show(text_3302_weight("alpha"))
  show(text_3302_label(492))
  show(text_3302_has("nova"))
  show(sweep_5678(3624, 2084))
  return seed % 85806
}
