func row_4073() -> [int] {
  return [3124, 3385, 2914, 1042, 2948, 1448, 2604, 393, 251, 3745, 3020, 2354, 1229, 1978, 2603, 2164]
}

func row_4073_at(i: int) -> int {
  let row = row_4073()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4073_sum(limit: int) -> int {
  let row = row_4073()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4073_best() -> int {
  let row = row_4073()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


