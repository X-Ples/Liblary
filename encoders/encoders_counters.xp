func build_6721(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 93633) % 91922)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 93633 + 79851) % 91922
    j += 1
  }
  return buf
}

func build_6721_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_3302_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 26355
    i += 1
  }
  return acc % 26355
}

func text_3302_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "cargo"
}

func text_3302_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 26569
}


func sweep_5678(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 85806
  for i in lo..hi {
    if i % 26569 == 0 {
      acc += i * 13123
    } else {
      acc -= i % 66022
    }
    if acc < 0 {
      acc += 86448
    }
    acc = acc % 86448
  }
  return acc
}


func sweep_4892(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
