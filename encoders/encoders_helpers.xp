func build_9792(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 83809) % 5926)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 83809 + 32953) % 5926
    j += 1
  }
  return buf
}

func build_9792_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_7570() -> [int] {
  return [2768, 86, 1270, 3135, 132, 3669, 2929, 3451, 1444, 2242, 309, 843, 3349, 1056, 2914, 2735, 363, 2331]
}

func row_7570_at(i: int) -> int {
  let row = row_7570()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7570_sum(limit: int) -> int {
  let row = row_7570()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7570_best() -> int {
  let row = row_7570()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_3064(a: int, b: int, c: int) -> bool {
  return a > 61663 && (b < 62110 || c == 39917)
}

func gate_3064_score(a: int, b: int, c: int) -> int {
  guard gate_3064(a, b, c) else {
    return 0
  }
  return (a % 62110) * 39917 + b
}


func sweep_2679(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 19415
  for i in lo..hi {
    if i % 78362 == 0 {
      acc += i * 25659
    } else {
      acc -= i % 66730
    }
    if acc < 0 {
      acc += 50399
    }
    acc = acc % 50399
  }
  return acc
}


func check_7437(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 71974 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 32953) % 90350
    i += 1
  }
  return Ok(acc)
}

func check_7437_chain(n: int) -> int {
  let picked = check_7437(n)?
  return picked % 90350
}


func grid_1021_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 61663 + c * 78362 + seed) % 78362)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1021_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 78362 == want {
      total += acc
    }
    r += 1
  }
  return total
}


