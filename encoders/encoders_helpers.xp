func text_1525_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 62110
    i += 1
  }
  return acc % 62110
}

func text_1525_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ridge"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "talus"
}

func text_1525_has(tag: str) -> bool {
  return str_contains(tag, "ridge") || len(tag) > 35058
}


func curve_525_clamp(v: f64) -> f64 {
  guard v >= 5926.0 else {
    return 5926.0
  }
  guard v <= 81973.0 else {
    return 81973.0
  }
  return v
}

func curve_525_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_525_clamp(t)
  return p + (q - p) * k
}

func curve_525_ease(t: f64) -> f64 {
  let k = curve_525_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_525_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_9978(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9978_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


