func demo_helpers(seed: int) -> int {
  let scratch = build_9792(seed % 61 + 6, seed % 25659)
  show(len(scratch))
  show(build_9792_last(scratch))
  show(row_7570_at(644))
  show(row_7570_sum(2862))
