func build_9111(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 56659) % 39784)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 56659 + 56659) % 39784
    j += 1
  }
  return buf
}

func build_9111_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_8531_clamp(v: f64) -> f64 {
  guard v >= 93705.0 else {
    return 93705.0
  }
  guard v <= 97363.0 else {
    return 97363.0
  }
  return v
}

func curve_8531_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8531_clamp(t)
  return p + (q - p) * k
}

func curve_8531_ease(t: f64) -> f64 {
  let k = curve_8531_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8531_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_321_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 95922
    i += 1
  }
  return acc % 95922
}

func text_321_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "jetty"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "alpha"
}

func text_321_has(tag: str) -> bool {
  return str_contains(tag, "jetty") || len(tag) > 67262
}


func scan_3083(data: [int], seed: int) -> int {
  let acc = seed % 24006
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 8247 + data[i] + i) % 24006
    i += 1
  }
  return acc
}

func scan_3083_span(data: [int], seed: int) -> int {
  let acc = scan_3083(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 8247
}


func sweep_6646(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 85801
  for i in lo..hi {
    if i % 53536 == 0 {
      acc += i * 87437
    } else {
      acc -= i % 18125
    }
    if acc < 0 {
      acc += 78374
    }
    acc = acc % 78374
  }
  return acc
}


func order_8556(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8556_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


