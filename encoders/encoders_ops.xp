func row_5392() -> [int] {
  return [2492, 3031, 3849, 782, 2323, 2202, 3072, 2513, 1648, 3627]
}

func row_5392_at(i: int) -> int {
  let row = row_5392()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5392_sum(limit: int) -> int {
  let row = row_5392()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5392_best() -> int {
  let row = row_5392()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


