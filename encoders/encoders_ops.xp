func check_8387(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 56659 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 78374) % 90170
    i += 1
  }
  return Ok(acc)
}

func check_8387_chain(n: int) -> int {
  let picked = check_8387(n)?
  return picked % 90170
}


