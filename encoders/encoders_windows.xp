func curve_4726_clamp(v: f64) -> f64 {
  guard v >= 17341.0 else {
    return 17341.0
  }
  guard v <= 25777.0 else {
    return 25777.0
  }
  return v
}

func curve_4726_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4726_clamp(t)
  return p + (q - p) * k
}

func curve_4726_ease(t: f64) -> f64 {
  let k = curve_4726_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4726_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_4766(data: [int], seed: int) -> int {
  let acc = seed % 34023
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 40527 + data[i] + i) % 34023
    i += 1
  }
  return acc
}

func scan_4766_span(data: [int], seed: int) -> int {
  let acc = scan_4766(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 40527
}


func sweep_5742(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 13893
  for i in lo..hi {
    if i % 13893 == 0 {
      acc += i * 41636
    } else {
      acc -= i % 89555
    }
    if acc < 0 {
      acc += 34023
    }
    acc = acc % 34023
  }
  return acc
}


func text_6053_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 43989
    i += 1
  }
  return acc % 43989
}

