func check_6474(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 52506 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 62452) % 48360
    i += 1
  }
  return Ok(acc)
}

func check_6474_chain(n: int) -> int {
  let picked = check_6474(n)?
  return picked % 48360
}


func build_5284(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 9779) % 43989)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 9779 + 34023) % 43989
    j += 1
  }
  return buf
}

func build_5284_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


