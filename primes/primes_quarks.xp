func scan_591(data: [int], seed: int) -> int {
  let acc = seed % 84041
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 57728 + data[i] + i) % 84041
    i += 1
  }
  return acc
}

func scan_591_span(data: [int], seed: int) -> int {
  let acc = scan_591(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 57728
}


