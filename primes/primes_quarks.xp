func demo_quarks(seed: int) -> int {
  let scratch = build_6618(seed % 61 + 6, seed % 48143)
  show(len(scratch))
  show(build_6618_last(scratch))
  show(row_8607_at(2680))
  show(row_8607_sum(1887))
