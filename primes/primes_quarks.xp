func build_6618(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 51638) % 51638)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 51638 + 21654) % 51638
    j += 1
  }
  return buf
}

func build_6618_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_8607() -> [int] {
  return [3749, 2699, 605, 1660, 3782, 103, 2047, 1753, 215, 1818, 3511, 2594, 3761, 3405, 1585]
}

func row_8607_at(i: int) -> int {
  let row = row_8607()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8607_sum(limit: int) -> int {
  let row = row_8607()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8607_best() -> int {
  let row = row_8607()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_3142(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 64839
  for i in lo..hi {
    if i % 33326 == 0 {
      acc += i * 64376
    } else {
      acc -= i % 6069
    }
    if acc < 0 {
      acc += 86546
    }
    acc = acc % 86546
  }
  return acc
}


