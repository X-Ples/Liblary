func demo_core(seed: int) -> int {
  let scratch = build_4835(seed % 61 + 6, seed % 73015)
  show(len(scratch))
  show(build_4835_last(scratch))
  show(scan_4324(scratch, 1633))
  show(scan_4324_span(scratch, 2874))
  show(order_4146_find(scratch, 2330))
  return seed % 90506
}
