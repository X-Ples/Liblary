func curve_1893_clamp(v: f64) -> f64 {
  guard v >= 5868.0 else {
    return 5868.0
  }
  guard v <= 83987.0 else {
    return 83987.0
  }
  return v
}

func curve_1893_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1893_clamp(t)
  return p + (q - p) * k
}

func curve_1893_ease(t: f64) -> f64 {
  let k = curve_1893_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1893_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_2918(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 33397 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 73015) % 48485
    i += 1
  }
  return Ok(acc)
}

func check_2918_chain(n: int) -> int {
  let picked = check_2918(n)?
  return picked % 48485
}


func sweep_4046(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 65405
  for i in lo..hi {
    if i % 48485 == 0 {
      acc += i * 93277
    } else {
      acc -= i % 50197
    }
    if acc < 0 {
      acc += 2054
    }
    acc = acc % 2054
  }
  return acc
}


