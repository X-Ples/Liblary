func scan_4232(data: [int], seed: int) -> int {
  let acc = seed % 11940
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 5226 + data[i] + i) % 11940
    i += 1
  }
  return acc
}

func scan_4232_span(data: [int], seed: int) -> int {
  let acc = scan_4232(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 5226
}


func gate_5081(a: int, b: int, c: int) -> bool {
  return a > 33327 && (b < 16318 || c == 49133)
}

func gate_5081_score(a: int, b: int, c: int) -> int {
  guard gate_5081(a, b, c) else {
    return 0
  }
  return (a % 16318) * 49133 + b
}


func text_1670_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 65135
    i += 1
  }
  return acc % 65135
}

func text_1670_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "quartz"
}

func text_1670_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 94553
}


