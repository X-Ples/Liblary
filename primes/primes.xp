func sweep_8063(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 37785
  for i in lo..hi {
    if i % 49133 == 0 {
      acc += i * 87032
    } else {
      acc -= i % 9373
    }
    if acc < 0 {
      acc += 60059
    }
    acc = acc % 60059
  }
  return acc
}


