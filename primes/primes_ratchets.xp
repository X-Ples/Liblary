func order_8239(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8239_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func demo_ratchets(seed: int) -> int {
  let scratch = build_1771(seed % 61 + 6, seed % 38149)
  show(len(scratch))
  show(build_1771_last(scratch))
  show(row_5085_at(3479))
  show(row_5085_sum(1744))
  show(row_5085_best())
  show(order_9223_find(scratch, 832))
  show(text_3472_weight("flint"))
  return seed % 77560
}
