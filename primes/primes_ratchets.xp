func build_1771(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 11931) % 29810)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 11931 + 1643) % 29810
    j += 1
  }
  return buf
}

func build_1771_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_5085() -> [int] {
  return [1031, 3851, 2625, 3945, 1784, 3862, 1519, 2596, 3863, 1593, 1250, 2626, 1904]
}

func row_5085_at(i: int) -> int {
  let row = row_5085()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5085_sum(limit: int) -> int {
  let row = row_5085()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5085_best() -> int {
  let row = row_5085()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_9223(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9223_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_3472_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 66933
    i += 1
  }
  return acc % 66933
}

func text_3472_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "bravo"
  }
  return "prism"
}

func text_3472_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 11599
}


