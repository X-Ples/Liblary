func scan_5925(data: [int], seed: int) -> int {
  let acc = seed % 11931
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 64847 + data[i] + i) % 11931
    i += 1
  }
  return acc
}

