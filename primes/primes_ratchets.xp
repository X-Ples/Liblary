func sweep_8804(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 91626
  for i in lo..hi {
    if i % 11599 == 0 {
      acc += i * 99678
    } else {
      acc -= i % 77560
    }
    if acc < 0 {
      acc += 84226
    }
    acc = acc % 84226
  }
  return acc
}


func curve_3918_clamp(v: f64) -> f64 {
  guard v >= 91626.0 else {
    return 91626.0
  }
  guard v <= 97189.0 else {
    return 97189.0
  }
  return v
}

func curve_3918_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3918_clamp(t)
  return p + (q - p) * k
}

func curve_3918_ease(t: f64) -> f64 {
  let k = curve_3918_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3918_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


