func demo_signals(seed: int) -> int {
  let scratch = build_9891(seed % 61 + 6, seed % 56427)
  show(len(scratch))
  show(build_9891_last(scratch))
  show(text_2429_weight("nova"))
  show(text_2429_label(1832))
  show(text_2429_has("cargo"))
  show(gate_5130(2689, 2405, 149))
  return seed % 77473
}
