func build_2208(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 92834) % 20947)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 92834 + 92834) % 20947
    j += 1
  }
  return buf
}

func build_2208_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_7044(data: [int], seed: int) -> int {
  let acc = seed % 54780
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 98028 + data[i] + i) % 54780
    i += 1
  }
  return acc
}

func scan_7044_span(data: [int], seed: int) -> int {
  let acc = scan_7044(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 98028
}


func row_4842() -> [int] {
  return [2158, 1785, 612, 3315, 3344, 2847, 238, 782, 1847, 3433]
}

func row_4842_at(i: int) -> int {
  let row = row_4842()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4842_sum(limit: int) -> int {
  let row = row_4842()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4842_best() -> int {
  let row = row_4842()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_2713(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 96144 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 98028) % 10741
    i += 1
  }
  return Ok(acc)
}

func check_2713_chain(n: int) -> int {
  let picked = check_2713(n)?
  return picked % 10741
}


func curve_2407_clamp(v: f64) -> f64 {
  guard v >= 63975.0 else {
    return 63975.0
  }
  guard v <= 92834.0 else {
    return 92834.0
  }
  return v
}

func curve_2407_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2407_clamp(t)
  return p + (q - p) * k
}

func curve_2407_ease(t: f64) -> f64 {
  let k = curve_2407_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2407_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_6118(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6118_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_3812_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 20947
    i += 1
  }
  return acc % 20947
}

func text_3812_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "cargo"
}

func text_3812_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 46308
}


