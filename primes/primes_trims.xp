func grid_2084_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 85592 + c * 10741 + seed) % 10741)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2084_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 10741 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func demo_trims(seed: int) -> int {
  let scratch = build_2208(seed % 61 + 6, seed % 63975)
  show(len(scratch))
  show(build_2208_last(scratch))
  show(scan_7044(scratch, 3581))
  show(scan_7044_span(scratch, 930))
  show(row_4842_at(1319))
  show(row_4842_sum(2240))
  return seed % 63975
}
