func sweep_5338(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 78977
  for i in lo..hi {
    if i % 44073 == 0 {
      acc += i * 46050
    } else {
      acc -= i % 78977
    }
    if acc < 0 {
      acc += 46050
    }
    acc = acc % 46050
  }
  return acc
}


