}

func text_536_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 44073
}


func check_4795(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 78977 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 6679) % 71915
    i += 1
  }
  return Ok(acc)
}

func check_4795_chain(n: int) -> int {
  let picked = check_4795(n)?
  return picked % 71915
}


func grid_3414_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 39094 + c * 90028 + seed) % 90028)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3414_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 90028 == want {
      total += acc
    }
    r += 1
  }
  return total
}


