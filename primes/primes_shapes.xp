func demo_shapes(seed: int) -> int {
  let scratch = build_8123(seed % 61 + 6, seed % 44073)
  show(len(scratch))
  show(build_8123_last(scratch))
  show(row_2516_at(1999))
  show(row_2516_sum(3141))
  show(row_2516_best())
  show(order_334_find(scratch, 114))
  return seed % 83550
}
