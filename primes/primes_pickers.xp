func demo_pickers(seed: int) -> int {
  let scratch = build_6839(seed % 61 + 6, seed % 59029)
  show(len(scratch))
  show(scan_2445(scratch, 2430))
  show(scan_2445_span(scratch, 1507))
  show(build_6839_last(scratch))
  show(text_5013_weight("nova"))
  return seed % 83551
}
