func scan_2445(data: [int], seed: int) -> int {
  let acc = seed % 81495
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 901 + data[i] + i) % 81495
    i += 1
  }
  return acc
}

func scan_2445_span(data: [int], seed: int) -> int {
  let acc = scan_2445(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 901
}


func build_6839(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 61639) % 57370)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 61639 + 40200) % 57370
    j += 1
  }
  return buf
}

func build_6839_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_5013_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 81495
    i += 1
  }
  return acc % 81495
}

func text_5013_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "alpha"
}

func text_5013_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 29361
}


