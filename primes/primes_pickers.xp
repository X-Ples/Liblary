func grid_4913_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 57825 + c * 57825 + seed) % 57825)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4913_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 57825 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func row_8908() -> [int] {
  return [3856, 3446, 160, 350, 1303, 3541, 311, 1861, 122, 3016, 3537, 3669, 2113, 1349, 1850, 703]
}

func row_8908_at(i: int) -> int {
  let row = row_8908()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8908_sum(limit: int) -> int {
  let row = row_8908()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8908_best() -> int {
  let row = row_8908()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


