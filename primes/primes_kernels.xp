func grid_5363_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 56489 + c * 3512 + seed) % 3512)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5363_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 3512 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func row_5953() -> [int] {
  return [378, 3980, 2464, 195, 1365, 3282, 2011, 3114, 3013, 2764, 1518, 4012, 2921, 1223, 3271, 2631, 2229]
}

func row_5953_at(i: int) -> int {
  let row = row_5953()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5953_sum(limit: int) -> int {
  let row = row_5953()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5953_best() -> int {
  let row = row_5953()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


