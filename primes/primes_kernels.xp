func scan_2283(data: [int], seed: int) -> int {
  let acc = seed % 55947
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 37658 + data[i] + i) % 55947
    i += 1
  }
  return acc
}

func scan_2283_span(data: [int], seed: int) -> int {
  let acc = scan_2283(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 37658
}


func check_7248(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 18178 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 39212) % 57926
    i += 1
  }
  return Ok(acc)
}

func check_7248_chain(n: int) -> int {
  let picked = check_7248(n)?
  return picked % 57926
}


