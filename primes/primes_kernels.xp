func demo_kernels(seed: int) -> int {
  let scratch = build_9918(seed % 61 + 6, seed % 25317)
  show(len(scratch))
  show(build_9918_last(scratch))
  show(build_6435_last(scratch))
  show(scan_2283(scratch, 956))
  show(scan_2283_span(scratch, 2223))
  return seed % 87726
}
