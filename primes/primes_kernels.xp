func sweep_6615(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 87726
  for i in lo..hi {
    if i % 87778 == 0 {
      acc += i * 59522
    } else {
      acc -= i % 29862
    }
    if acc < 0 {
      acc += 64697
    }
    acc = acc % 64697
  }
  return acc
}


func order_4250(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4250_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_2674_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 89845
    i += 1
  }
  return acc % 89845
}

func text_2674_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
