func demo_offsets(seed: int) -> int {
  let scratch = build_3017(seed % 61 + 6, seed % 73964)
  show(len(scratch))
  show(order_8740_find(scratch, 3053))
  show(build_3017_last(scratch))
  show(grid_9956_rowsum(scratch, 2576, 856, 3201))
  show(scan_7117(scratch, 1029))
  show(scan_7117_span(scratch, 1975))
  return seed % 11252
}
