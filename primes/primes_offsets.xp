const K0 = 55516
const K1 = 8114
const K2 = 6575
const K3 = 20610
const K4 = 52307
const K5 = 25667
const K6 = 61116
const K7 = 230
const K8 = 42565
const K9 = 45930

func curve_4771_clamp(v: f64) -> f64 {
  guard v >= 51238.0 else {
    return 51238.0
  }
  guard v <= 52263.0 else {
    return 52263.0
  }
  return v
}

func curve_4771_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4771_clamp(t)
  return p + (q - p) * k
}

func curve_4771_ease(t: f64) -> f64 {
  let k = curve_4771_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4771_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_8740(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8740_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_3017(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 48016) % 55516)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 48016 + 42565) % 55516
    j += 1
  }
  return buf
}

func build_3017_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_9956_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 51238 + c * 19731 + seed) % 19731)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9956_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 19731 == want {
      total += acc
    }
    r += 1
  }
  return total
}


