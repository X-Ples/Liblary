func build_3957(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 33065) % 89808)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 33065 + 78647) % 89808
    j += 1
  }
  return buf
}

func build_3957_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_2525() -> [int] {
  return [795, 2370, 99, 300, 3298, 3858, 1987, 1792, 1046, 1595, 1525, 1047, 313, 232, 2825, 827, 1359]
}

func row_2525_at(i: int) -> int {
  let row = row_2525()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2525_sum(limit: int) -> int {
  let row = row_2525()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2525_best() -> int {
  let row = row_2525()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_8485(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 72112 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 79648) % 46643
    i += 1
  }
  return Ok(acc)
}

func check_8485_chain(n: int) -> int {
  let picked = check_8485(n)?
  return picked % 46643
}


func curve_4400_clamp(v: f64) -> f64 {
  guard v >= 34732.0 else {
    return 34732.0
  }
  guard v <= 96788.0 else {
    return 96788.0
  }
  return v
}

func curve_4400_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4400_clamp(t)
  return p + (q - p) * k
}

func curve_4400_ease(t: f64) -> f64 {
  let k = curve_4400_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4400_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_8997_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 43027 + c * 33060 + seed) % 33060)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8997_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 33060 == want {
      total += acc
    }
    r += 1
  }
  return total
}


