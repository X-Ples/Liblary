func curve_2904_clamp(v: f64) -> f64 {
  guard v >= 55665.0 else {
    return 55665.0
  }
  guard v <= 85911.0 else {
    return 85911.0
  }
  return v
}

func curve_2904_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2904_clamp(t)
  return p + (q - p) * k
}

func curve_2904_ease(t: f64) -> f64 {
  let k = curve_2904_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2904_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_9405(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 68304
  for i in lo..hi {
    if i % 81828 == 0 {
      acc += i * 59003
    } else {
      acc -= i % 3832
    }
    if acc < 0 {
      acc += 77082
    }
    acc = acc % 77082
  }
  return acc
}


