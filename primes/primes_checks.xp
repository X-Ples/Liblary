func sweep_1552(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 29915
  for i in lo..hi {
    if i % 29915 == 0 {
      acc += i * 22401
    } else {
      acc -= i % 96842
    }
    if acc < 0 {
      acc += 26189
    }
    acc = acc % 26189
  }
  return acc
}


