func curve_2697_clamp(v: f64) -> f64 {
  guard v >= 85569.0 else {
    return 85569.0
  }
  guard v <= 95921.0 else {
    return 95921.0
  }
  return v
}

func curve_2697_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2697_clamp(t)
  return p + (q - p) * k
}

func curve_2697_ease(t: f64) -> f64 {
  let k = curve_2697_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2697_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_2805(a: int, b: int, c: int) -> bool {
  return a > 95798 && (b < 64933 || c == 8300)
}

func gate_2805_score(a: int, b: int, c: int) -> int {
  guard gate_2805(a, b, c) else {
    return 0
  }
  return (a % 64933) * 8300 + b
}


