func check_2385(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 6522 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 84854) % 34827
    i += 1
  }
  return Ok(acc)
}

func check_2385_chain(n: int) -> int {
  let picked = check_2385(n)?
  return picked % 34827
}


