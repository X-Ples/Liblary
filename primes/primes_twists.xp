func row_4643() -> [int] {
  return [962, 542, 3839, 1318, 2498, 861, 3148, 1639, 3186, 995, 205, 3511, 2300, 2329, 2905, 2004, 1710, 1000, 46]
}

func row_4643_at(i: int) -> int {
  let row = row_4643()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4643_sum(limit: int) -> int {
  let row = row_4643()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4643_best() -> int {
  let row = row_4643()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


