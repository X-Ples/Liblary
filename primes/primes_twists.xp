func demo_twists(seed: int) -> int {
  let scratch = build_2849(seed % 61 + 6, seed % 71038)
  show(len(scratch))
  show(sweep_8525(703, 2700))
  show(gate_2203(18, 2310, 1527))
  show(gate_2203_score(3600, 2935, 150))
  show(sweep_3064(3550, 1367))
  show(build_2849_last(scratch))
  show(check_2385_chain(2384))
  return seed % 34827
}
