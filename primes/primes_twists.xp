func sweep_8525(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 71038
  for i in lo..hi {
    if i % 48150 == 0 {
      acc += i * 84854
    } else {
      acc -= i % 73639
    }
    if acc < 0 {
      acc += 85250
    }
    acc = acc % 85250
  }
  return acc
}


func gate_2203(a: int, b: int, c: int) -> bool {
  return a > 73639 && (b < 48935 || c == 84854)
}

func gate_2203_score(a: int, b: int, c: int) -> int {
  guard gate_2203(a, b, c) else {
    return 0
  }
  return (a % 48935) * 84854 + b
}


