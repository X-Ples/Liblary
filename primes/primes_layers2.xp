func row_4139() -> [int] {
  return [3089, 3318, 3993, 3645, 941, 2254, 3784, 2520, 3431, 1768, 3972, 1089, 1955, 2064, 3573]
}

func row_4139_at(i: int) -> int {
  let row = row_4139()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4139_sum(limit: int) -> int {
  let row = row_4139()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4139_best() -> int {
  let row = row_4139()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


