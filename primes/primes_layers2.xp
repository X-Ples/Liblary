func text_2500_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 63853
    i += 1
  }
  return acc % 63853
}

func text_2500_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "talus"
}

func text_2500_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 92430
}


func scan_1243(data: [int], seed: int) -> int {
  let acc = seed % 68601
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 15390 + data[i] + i) % 68601
    i += 1
  }
  return acc
}

func scan_1243_span(data: [int], seed: int) -> int {
  let acc = scan_1243(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 15390
}


