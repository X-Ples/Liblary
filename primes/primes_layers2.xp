func grid_2852_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 40390 + c * 68601 + seed) % 68601)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2852_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 68601 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func demo_layers2(seed: int) -> int {
  let scratch = build_7756(seed % 61 + 6, seed % 38740)
  show(len(scratch))
  show(order_1922_find(scratch, 3896))
  show(order_5193_find(scratch, 849))
  show(order_742_find(scratch, 3718))
  show(text_2500_weight("delta"))
  show(text_2500_label(2547))
  return seed % 30954
}
