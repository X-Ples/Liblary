func check_8765(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 32014 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 17694) % 81706
    i += 1
  }
  return Ok(acc)
}

func check_8765_chain(n: int) -> int {
  let picked = check_8765(n)?
  return picked % 81706
}


func text_7453_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 21955
    i += 1
  }
  return acc % 21955
}

func text_7453_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "prism"
}

func text_7453_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 33349
}


func scan_3594(data: [int], seed: int) -> int {
  let acc = seed % 81706
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 79673 + data[i] + i) % 81706
    i += 1
  }
  return acc
}

func scan_3594_span(data: [int], seed: int) -> int {
  let acc = scan_3594(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 79673
}


func row_4671() -> [int] {
  return [939, 10, 752, 533, 1152, 3781, 1342, 3291, 2312, 2679, 1966, 1236, 3229, 1919, 3876, 1139, 131, 2043, 301, 2610]
}

func row_4671_at(i: int) -> int {
  let row = row_4671()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4671_sum(limit: int) -> int {
  let row = row_4671()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4671_best() -> int {
  let row = row_4671()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_5447(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 32527) % 76152)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 32527 + 15554) % 76152
    j += 1
  }
  return buf
}

func build_5447_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_7907_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 57861 + c * 21955 + seed) % 21955)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7907_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 21955 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func order_735(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_735_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


