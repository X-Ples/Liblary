func demo_tables(seed: int) -> int {
  let scratch = build_7939(seed % 61 + 6, seed % 9403)
  show(len(scratch))
  show(build_7939_last(scratch))
  show(check_6973_chain(3785))
  show(gate_5658(3166, 3237, 3456))
  show(gate_5658_score(114, 2837, 2871))
  show(scan_7410(scratch, 2455))
  show(scan_7410_span(scratch, 1572))
  return seed % 90244
}
