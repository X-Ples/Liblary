const K9 = 74342

func build_7939(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 67903) % 3540)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 67903 + 32627) % 3540
    j += 1
  }
  return buf
}

func build_7939_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_6973(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 41978 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 84405) % 3540
    i += 1
  }
  return Ok(acc)
}

func check_6973_chain(n: int) -> int {
  let picked = check_6973(n)?
  return picked % 3540
}


func curve_3116_clamp(v: f64) -> f64 {
  guard v >= 23143.0 else {
    return 23143.0
  }
  guard v <= 78779.0 else {
    return 78779.0
  }
  return v
}

func curve_3116_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3116_clamp(t)
  return p + (q - p) * k
}

func curve_3116_ease(t: f64) -> f64 {
  let k = curve_3116_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3116_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_5658(a: int, b: int, c: int) -> bool {
  return a > 67903 && (b < 26836 || c == 74342)
}

func gate_5658_score(a: int, b: int, c: int) -> int {
  guard gate_5658(a, b, c) else {
    return 0
  }
  return (a % 26836) * 74342 + b
}


func scan_7410(data: [int], seed: int) -> int {
  let acc = seed % 79052
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 26489 + data[i] + i) % 79052
    i += 1
  }
  return acc
}

func scan_7410_span(data: [int], seed: int) -> int {
  let acc = scan_7410(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 26489
}


func grid_9014_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 23143 + c * 82523 + seed) % 82523)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9014_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 82523 == want {
      total += acc
    }
    r += 1
  }
  return total
}


