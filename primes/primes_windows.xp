func sweep_3366(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 63748
  for i in lo..hi {
    if i % 77030 == 0 {
      acc += i * 24701
    } else {
      acc -= i % 81190
    }
    if acc < 0 {
      acc += 27668
    }
    acc = acc % 27668
  }
  return acc
}


func row_2346() -> [int] {
  return [3362, 2205, 2885, 3034, 459, 2822, 3093, 3190, 586, 1904, 3894, 542]
}

func row_2346_at(i: int) -> int {
  let row = row_2346()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2346_sum(limit: int) -> int {
  let row = row_2346()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2346_best() -> int {
  let row = row_2346()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_5024(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5024_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


