func build_7321(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 73975) % 56833)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 73975 + 70674) % 56833
    j += 1
  }
  return buf
}

func build_7321_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_1158_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 82985
    i += 1
  }
  return acc % 82985
}

func text_1158_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "harbor"
}

func text_1158_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 6320
}


func curve_7129_clamp(v: f64) -> f64 {
  guard v >= 6320.0 else {
    return 6320.0
  }
  guard v <= 56833.0 else {
    return 56833.0
  }
  return v
}

func curve_7129_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7129_clamp(t)
  return p + (q - p) * k
}

func curve_7129_ease(t: f64) -> f64 {
  let k = curve_7129_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7129_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


