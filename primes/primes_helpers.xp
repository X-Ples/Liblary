func build_9318(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 36018) % 12301)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 36018 + 70710) % 12301
    j += 1
  }
  return buf
}

func build_9318_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_6548(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 65759
  for i in lo..hi {
    if i % 25419 == 0 {
      acc += i * 23859
    } else {
      acc -= i % 42478
    }
    if acc < 0 {
      acc += 15750
    }
    acc = acc % 15750
  }
  return acc
}


func grid_2434_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 25419 + c * 65770 + seed) % 65770)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2434_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 65770 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_2982(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 36018 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 10903) % 38339
    i += 1
  }
  return Ok(acc)
}

func check_2982_chain(n: int) -> int {
  let picked = check_2982(n)?
  return picked % 38339
}


