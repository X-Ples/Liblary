func scan_815(data: [int], seed: int) -> int {
  let acc = seed % 57372
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 30157 + data[i] + i) % 57372
    i += 1
  }
  return acc
}

func scan_815_span(data: [int], seed: int) -> int {
  let acc = scan_815(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 30157
}


