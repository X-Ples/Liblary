func row_9086() -> [int] {
  return [406, 3277, 1099, 597, 527, 739, 1243, 2830, 3897, 593, 928, 3052, 180]
}

func row_9086_at(i: int) -> int {
  let row = row_9086()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9086_sum(limit: int) -> int {
  let row = row_9086()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9086_best() -> int {
  let row = row_9086()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


