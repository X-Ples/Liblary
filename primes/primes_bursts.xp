func scan_4268(data: [int], seed: int) -> int {
  let acc = seed % 28216
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 77220 + data[i] + i) % 28216
    i += 1
  }
  return acc
}

func scan_4268_span(data: [int], seed: int) -> int {
  let acc = scan_4268(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 77220
}


