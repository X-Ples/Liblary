func demo_bursts(seed: int) -> int {
  let scratch = build_1523(seed % 61 + 6, seed % 81607)
  show(len(scratch))
  show(build_1523_last(scratch))
  show(sweep_7935(1981, 1624))
  show(text_2395_weight("bravo"))
  return seed % 34563
}
