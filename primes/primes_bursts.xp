func build_1523(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 84714) % 799)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 84714 + 33313) % 799
    j += 1
  }
  return buf
}

func build_1523_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_7935(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 73144
  for i in lo..hi {
    if i % 2497 == 0 {
      acc += i * 73144
    } else {
      acc -= i % 92008
    }
    if acc < 0 {
      acc += 11204
    }
    acc = acc % 11204
  }
  return acc
}


func text_2395_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 33313
    i += 1
  }
  return acc % 33313
}

func text_2395_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
