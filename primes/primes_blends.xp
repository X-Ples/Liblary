func check_3486(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 70740 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 34590) % 76369
    i += 1
  }
  return Ok(acc)
}

func check_3486_chain(n: int) -> int {
  let picked = check_3486(n)?
  return picked % 76369
}


func sweep_8791(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 39459
  for i in lo..hi {
    if i % 3176 == 0 {
      acc += i * 64829
    } else {
      acc -= i % 74386
    }
    if acc < 0 {
      acc += 43503
    }
    acc = acc % 43503
  }
  return acc
}


