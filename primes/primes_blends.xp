func text_1269_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 11785
    i += 1
  }
  return acc % 11785
}

func text_1269_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "ridge"
}

func text_1269_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 70740
}


func scan_7313(data: [int], seed: int) -> int {
  let acc = seed % 43503
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 3176 + data[i] + i) % 43503
    i += 1
  }
  return acc
}

func scan_7313_span(data: [int], seed: int) -> int {
  let acc = scan_7313(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 3176
}


func gate_1350(a: int, b: int, c: int) -> bool {
  return a > 79555 && (b < 43503 || c == 79555)
}

func gate_1350_score(a: int, b: int, c: int) -> int {
  guard gate_1350(a, b, c) else {
    return 0
  }
  return (a % 43503) * 79555 + b
}


