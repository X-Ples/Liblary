func scan_5279(data: [int], seed: int) -> int {
  let acc = seed % 3167
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 3167 + data[i] + i) % 3167
    i += 1
  }
  return acc
}

func scan_5279_span(data: [int], seed: int) -> int {
  let acc = scan_5279(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 3167
}


func order_7931(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7931_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func row_3261() -> [int] {
  return [2088, 3251, 178, 124, 257, 2436, 408, 584, 1123, 3216, 3114, 1995, 589, 184, 4047, 3660, 371, 3094]
}

func row_3261_at(i: int) -> int {
  let row = row_3261()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3261_sum(limit: int) -> int {
  let row = row_3261()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3261_best() -> int {
  let row = row_3261()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_6982(a: int, b: int, c: int) -> bool {
  return a > 48655 && (b < 4999 || c == 28164)
}

func gate_6982_score(a: int, b: int, c: int) -> int {
  guard gate_6982(a, b, c) else {
    return 0
  }
  return (a % 4999) * 28164 + b
}


func grid_1254_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 51236 + c * 34812 + seed) % 34812)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1254_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 34812 == want {
      total += acc
    }
    r += 1
  }
  return total
}


