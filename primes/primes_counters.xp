func demo_counters(seed: int) -> int {
  let scratch = build_7155(seed % 61 + 6, seed % 43595)
  show(len(scratch))
  show(check_2988_chain(2865))
  show(build_7155_last(scratch))
  show(sweep_2552(2112, 3148))
  show(check_202_chain(2033))
  show(scan_5279(scratch, 793))
  return seed % 51236
}
