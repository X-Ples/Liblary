func check_2988(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 9222 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 3101) % 87661
    i += 1
  }
  return Ok(acc)
}

func check_2988_chain(n: int) -> int {
  let picked = check_2988(n)?
  return picked % 87661
}


func build_7155(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 6389) % 19480)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 6389 + 17015) % 19480
    j += 1
  }
  return buf
}

func build_7155_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_4179_clamp(v: f64) -> f64 {
  guard v >= 34812.0 else {
    return 34812.0
  }
  guard v <= 69042.0 else {
    return 69042.0
  }
  return v
}

func curve_4179_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4179_clamp(t)
  return p + (q - p) * k
}

func curve_4179_ease(t: f64) -> f64 {
  let k = curve_4179_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4179_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_2552(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 58322
  for i in lo..hi {
    if i % 69042 == 0 {
      acc += i * 4166
    } else {
      acc -= i % 49507
    }
    if acc < 0 {
      acc += 34812
    }
    acc = acc % 34812
  }
  return acc
}


