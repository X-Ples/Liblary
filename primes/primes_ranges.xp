  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1951_sum(limit: int) -> int {
  let row = row_1951()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1951_best() -> int {
  let row = row_1951()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_882_clamp(v: f64) -> f64 {
  guard v >= 28955.0 else {
    return 28955.0
  }
  guard v <= 95623.0 else {
    return 95623.0
  }
  return v
}

func curve_882_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_882_clamp(t)
  return p + (q - p) * k
}

func curve_882_ease(t: f64) -> f64 {
  let k = curve_882_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_882_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


