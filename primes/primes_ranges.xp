func build_8819(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 44143) % 95623)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 44143 + 30178) % 95623
    j += 1
  }
  return buf
}

func build_8819_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_1505(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 52412 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 53085) % 68394
    i += 1
  }
  return Ok(acc)
}

func check_1505_chain(n: int) -> int {
  let picked = check_1505(n)?
  return picked % 68394
}


