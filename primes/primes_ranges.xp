func text_6688_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 28955
    i += 1
  }
  return acc % 28955
}

func text_6688_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "ember"
}

func text_6688_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 53085
}


func sweep_8117(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 26644
  for i in lo..hi {
    if i % 28955 == 0 {
      acc += i * 2096
    } else {
      acc -= i % 86184
    }
    if acc < 0 {
      acc += 77702
    }
    acc = acc % 77702
  }
  return acc
}


func scan_6765(data: [int], seed: int) -> int {
  let acc = seed % 53085
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 13371 + data[i] + i) % 53085
    i += 1
  }
  return acc
}

func scan_6765_span(data: [int], seed: int) -> int {
  let acc = scan_6765(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 13371
}


