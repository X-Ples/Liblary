func sweep_8025(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 24225
  for i in lo..hi {
    if i % 14421 == 0 {
      acc += i * 1000
    } else {
      acc -= i % 51377
    }
    if acc < 0 {
      acc += 12424
    }
    acc = acc % 12424
  }
  return acc
}


