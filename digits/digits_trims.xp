func demo_trims(seed: int) -> int {
  let scratch = build_3941(seed % 61 + 6, seed % 66599)
  show(len(scratch))
  show(build_3941_last(scratch))
  show(gate_8926(2415, 484, 890))
  show(gate_8926_score(2360, 1420, 258))
  return seed % 26759
}
