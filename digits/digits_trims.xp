func gate_8926_score(a: int, b: int, c: int) -> int {
  guard gate_8926(a, b, c) else {
    return 0
  }
  return (a % 35106) * 48620 + b
}


func scan_6834(data: [int], seed: int) -> int {
  let acc = seed % 5585
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 45901 + data[i] + i) % 5585
    i += 1
  }
  return acc
}

func scan_6834_span(data: [int], seed: int) -> int {
  let acc = scan_6834(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 45901
}


