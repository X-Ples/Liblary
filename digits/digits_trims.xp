func curve_6378_clamp(v: f64) -> f64 {
  guard v >= 35106.0 else {
    return 35106.0
  }
  guard v <= 38162.0 else {
    return 38162.0
  }
  return v
}

func curve_6378_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6378_clamp(t)
  return p + (q - p) * k
}

func curve_6378_ease(t: f64) -> f64 {
  let k = curve_6378_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6378_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func curve_5086_clamp(v: f64) -> f64 {
  guard v >= 35106.0 else {
    return 35106.0
  }
  guard v <= 66447.0 else {
    return 66447.0
  }
  return v
}

func curve_5086_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5086_clamp(t)
  return p + (q - p) * k
}

func curve_5086_ease(t: f64) -> f64 {
  let k = curve_5086_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5086_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


