func sweep_3474(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 9700
  for i in lo..hi {
    if i % 48135 == 0 {
      acc += i * 25224
    } else {
      acc -= i % 59380
    }
    if acc < 0 {
      acc += 50455
    }
    acc = acc % 50455
  }
  return acc
}


func scan_2769(data: [int], seed: int) -> int {
  let acc = seed % 9700
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 67695 + data[i] + i) % 9700
    i += 1
  }
  return acc
}

func scan_2769_span(data: [int], seed: int) -> int {
  let acc = scan_2769(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 67695
}


