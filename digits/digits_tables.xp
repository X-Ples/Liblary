func text_3959_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 35375
    i += 1
  }
  return acc % 35375
}

func text_3959_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "quartz"
}

func text_3959_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 42290
}


