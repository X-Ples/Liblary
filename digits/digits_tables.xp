func grid_498_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 61428 + c * 27084 + seed) % 27084)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_498_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 27084 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_9312(a: int, b: int, c: int) -> bool {
  return a > 79784 && (b < 47866 || c == 67695)
}

func gate_9312_score(a: int, b: int, c: int) -> int {
  guard gate_9312(a, b, c) else {
    return 0
  }
  return (a % 47866) * 67695 + b
}


