func row_4028() -> [int] {
  return [1239, 118, 1676, 1148, 2418, 2390, 2845, 3731, 2503, 2493, 3877, 417, 518, 630, 782, 370, 781, 3079, 3097, 1633]
}

func row_4028_at(i: int) -> int {
  let row = row_4028()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4028_sum(limit: int) -> int {
  let row = row_4028()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4028_best() -> int {
  let row = row_4028()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_5713(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 9105) % 88649)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 9105 + 50455) % 88649
    j += 1
  }
  return buf
}

func build_5713_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_5210(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5210_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func check_8516(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 61428 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 35795) % 71187
    i += 1
  }
  return Ok(acc)
}

func check_8516_chain(n: int) -> int {
  let picked = check_8516(n)?
  return picked % 71187
}


