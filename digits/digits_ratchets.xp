func build_8606(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 11567) % 83427)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 11567 + 8546) % 83427
    j += 1
  }
  return buf
}

func build_8606_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


