func gate_3627_score(a: int, b: int, c: int) -> int {
  guard gate_3627(a, b, c) else {
    return 0
  }
  return (a % 28574) * 26307 + b
}


func sweep_1275(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 84719
  for i in lo..hi {
    if i % 98506 == 0 {
      acc += i * 7740
    } else {
      acc -= i % 57985
    }
    if acc < 0 {
      acc += 8546
    }
    acc = acc % 8546
  }
  return acc
}


