func demo_ratchets(seed: int) -> int {
  let scratch = build_8606(seed % 61 + 6, seed % 57985)
  show(len(scratch))
  show(build_8606_last(scratch))
  show(gate_3627(3807, 1012, 3370))
  show(gate_3627_score(3695, 3983, 1771))
  return seed % 98710
}
