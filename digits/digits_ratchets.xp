func scan_6542(data: [int], seed: int) -> int {
  let acc = seed % 8546
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 32108 + data[i] + i) % 8546
    i += 1
  }
  return acc
}

func scan_6542_span(data: [int], seed: int) -> int {
  let acc = scan_6542(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 32108
}


