func demo_helpers(seed: int) -> int {
  let scratch = build_9476(seed % 61 + 6, seed % 90175)
  show(len(scratch))
  show(gate_7656(200, 95, 3283))
  show(gate_7656_score(3385, 1158, 544))
  show(build_9476_last(scratch))
  show(order_1670_find(scratch, 3146))
  show(check_7482_chain(481))
  show(order_9049_find(scratch, 3588))
  return seed % 62875
}
