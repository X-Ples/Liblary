}


func scan_524(data: [int], seed: int) -> int {
  let acc = seed % 62875
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 37592 + data[i] + i) % 62875
    i += 1
  }
  return acc
}

func scan_524_span(data: [int], seed: int) -> int {
  let acc = scan_524(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 37592
}


