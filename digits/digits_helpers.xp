func sweep_4100(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 87896
  for i in lo..hi {
    if i % 95207 == 0 {
      acc += i * 87896
    } else {
      acc -= i % 34279
    }
    if acc < 0 {
      acc += 62875
    }
    acc = acc % 62875
  }
  return acc
}


