func row_5125() -> [int] {
  return [791, 1433, 2569, 3562, 3216, 3595, 3853, 3684, 2392, 2744, 3210, 1542, 3708, 3448, 1840, 569, 1069, 1187, 2055]
}

func row_5125_at(i: int) -> int {
  let row = row_5125()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5125_sum(limit: int) -> int {
  let row = row_5125()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5125_best() -> int {
  let row = row_5125()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


