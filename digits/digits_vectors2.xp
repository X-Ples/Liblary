func scan_6292(data: [int], seed: int) -> int {
  let acc = seed % 28189
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 42805 + data[i] + i) % 28189
    i += 1
  }
  return acc
}

func scan_6292_span(data: [int], seed: int) -> int {
  let acc = scan_6292(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 42805
}


