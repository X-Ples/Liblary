func curve_5376_clamp(v: f64) -> f64 {
  guard v >= 284.0 else {
    return 284.0
  }
  guard v <= 81956.0 else {
    return 81956.0
  }
  return v
}

func curve_5376_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5376_clamp(t)
  return p + (q - p) * k
}

func curve_5376_ease(t: f64) -> f64 {
  let k = curve_5376_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5376_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


