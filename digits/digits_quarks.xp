func build_8960(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 4744) % 42090)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 4744 + 81956) % 42090
    j += 1
  }
  return buf
}

func build_8960_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_6810(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 58462
  for i in lo..hi {
    if i % 29140 == 0 {
      acc += i * 40088
    } else {
      acc -= i % 14580
    }
    if acc < 0 {
      acc += 42788
    }
    acc = acc % 42788
  }
  return acc
}


func check_9785(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 74314 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 14580) % 53827
    i += 1
  }
  return Ok(acc)
}

func check_9785_chain(n: int) -> int {
  let picked = check_9785(n)?
  return picked % 53827
}


