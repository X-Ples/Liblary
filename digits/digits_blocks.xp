  guard hi > lo else {
    return 0
  }
  let acc = 6734
  for i in lo..hi {
    if i % 24046 == 0 {
      acc += i * 98859
    } else {
      acc -= i % 32058
    }
    if acc < 0 {
      acc += 26623
    }
    acc = acc % 26623
  }
  return acc
}


