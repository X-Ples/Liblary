func row_8793() -> [int] {
  return [2055, 4081, 390, 3640, 1455, 1429, 603, 2655, 2220, 1085, 1216, 536]
}

func row_8793_at(i: int) -> int {
  let row = row_8793()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8793_sum(limit: int) -> int {
  let row = row_8793()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8793_best() -> int {
  let row = row_8793()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func demo_blocks(seed: int) -> int {
  let scratch = build_3056(seed % 61 + 6, seed % 86421)
  show(len(scratch))
  show(build_3056_last(scratch))
  show(order_3897_find(scratch, 2422))
  show(grid_6869_rowsum(scratch, 3414, 1909, 3706))
  return seed % 94815
}
