func gate_8665(a: int, b: int, c: int) -> bool {
  return a > 25352 && (b < 95010 || c == 77616)
}

func gate_8665_score(a: int, b: int, c: int) -> int {
  guard gate_8665(a, b, c) else {
    return 0
  }
  return (a % 95010) * 77616 + b
}


