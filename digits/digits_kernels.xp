const K0 = 25847
const K1 = 25847
const K2 = 79136
const K3 = 42491
const K4 = 53999
const K5 = 78402

func grid_9331_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 25352 + c * 95773 + seed) % 95773)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9331_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 95773 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_3371(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 22211) % 35723)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 22211 + 36274) % 35723
    j += 1
  }
  return buf
}

func build_3371_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_4101(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 22211
  for i in lo..hi {
    if i % 22211 == 0 {
      acc += i * 42491
    } else {
      acc -= i % 25847
    }
    if acc < 0 {
      acc += 79136
    }
    acc = acc % 79136
  }
  return acc
}


