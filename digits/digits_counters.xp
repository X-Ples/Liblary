func demo_counters(seed: int) -> int {
  let scratch = build_4832(seed % 61 + 6, seed % 42245)
  show(len(scratch))
  show(build_4832_last(scratch))
  show(scan_783(scratch, 3481))
  show(scan_783_span(scratch, 1306))
  return seed % 52708
}
