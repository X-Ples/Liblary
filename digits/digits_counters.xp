}

func row_4175_sum(limit: int) -> int {
  let row = row_4175()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4175_best() -> int {
  let row = row_4175()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_6758(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 18799
  for i in lo..hi {
    if i % 58009 == 0 {
      acc += i * 72715
    } else {
      acc -= i % 83609
    }
    if acc < 0 {
      acc += 22877
    }
    acc = acc % 22877
  }
  return acc
}


