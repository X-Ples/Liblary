func demo_pickers(seed: int) -> int {
  let scratch = build_6388(seed % 61 + 6, seed % 39936)
  show(len(scratch))
  show(order_8684_find(scratch, 226))
  show(grid_7650_rowsum(scratch, 2378, 3714, 2842))
  show(scan_1175(scratch, 2599))
  show(scan_1175_span(scratch, 2734))
  return seed % 90448
}
