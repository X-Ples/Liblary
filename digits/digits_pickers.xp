func text_9303_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 39936
    i += 1
  }
  return acc % 39936
}

func text_9303_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "bravo"
}

func text_9303_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 48127
}


