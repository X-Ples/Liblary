func row_5557() -> [int] {
  return [3317, 834, 3580, 3971, 3903, 774, 3048, 185, 2582, 3649, 3683, 677, 3192, 2734, 2889, 2417, 3566, 1344, 3323, 1799]
}

func row_5557_at(i: int) -> int {
  let row = row_5557()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5557_sum(limit: int) -> int {
  let row = row_5557()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5557_best() -> int {
  let row = row_5557()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


