func build_1209(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 36635) % 57220)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 36635 + 62684) % 57220
    j += 1
  }
  return buf
}

func build_1209_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_7358(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 98016 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 97601) % 76863
    i += 1
  }
  return Ok(acc)
}

func check_7358_chain(n: int) -> int {
  let picked = check_7358(n)?
  return picked % 76863
}


func grid_5685_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 97601 + c * 88466 + seed) % 88466)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5685_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 88466 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_2226_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 68633
    i += 1
  }
  return acc % 68633
}

func text_2226_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "quartz"
}

func text_2226_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 1262
}


func scan_6510(data: [int], seed: int) -> int {
  let acc = seed % 99947
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 40195 + data[i] + i) % 99947
    i += 1
  }
  return acc
}

func scan_6510_span(data: [int], seed: int) -> int {
  let acc = scan_6510(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 40195
}


func sweep_3742(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 43281
  for i in lo..hi {
    if i % 52639 == 0 {
      acc += i * 52639
    } else {
      acc -= i % 39462
    }
    if acc < 0 {
      acc += 82379
    }
    acc = acc % 82379
  }
  return acc
}


func gate_2275(a: int, b: int, c: int) -> bool {
  return a > 63797 && (b < 81744 || c == 88466)
}

func gate_2275_score(a: int, b: int, c: int) -> int {
  guard gate_2275(a, b, c) else {
    return 0
  }
  return (a % 81744) * 88466 + b
}


