func demo_twists(seed: int) -> int {
  let scratch = build_6079(seed % 61 + 6, seed % 92250)
  show(len(scratch))
  show(scan_1815(scratch, 248))
  show(scan_1815_span(scratch, 3479))
  show(build_6079_last(scratch))
  show(order_3282_find(scratch, 2677))
  return seed % 682
}
