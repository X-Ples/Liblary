func demo_checks(seed: int) -> int {
  let scratch = build_2517(seed % 61 + 6, seed % 86434)
  show(len(scratch))
  show(build_2517_last(scratch))
  show(sweep_8960(3361, 782))
  show(grid_6753_rowsum(scratch, 3315, 1058, 3812))
  show(scan_5327(scratch, 1956))
  show(scan_5327_span(scratch, 2330))
  return seed % 25656
}
