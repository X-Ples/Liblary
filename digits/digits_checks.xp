func build_2517(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 11667) % 23492)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 11667 + 83049) % 23492
    j += 1
  }
  return buf
}

func build_2517_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_8960(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 66228
  for i in lo..hi {
    if i % 26858 == 0 {
      acc += i * 74875
    } else {
      acc -= i % 56407
    }
    if acc < 0 {
      acc += 79959
    }
    acc = acc % 79959
  }
  return acc
}


func grid_6753_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 55379 + c * 79959 + seed) % 79959)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6753_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 79959 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_5327(data: [int], seed: int) -> int {
  let acc = seed % 74875
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 75030 + data[i] + i) % 74875
    i += 1
  }
  return acc
}

func scan_5327_span(data: [int], seed: int) -> int {
  let acc = scan_5327(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 75030
}


