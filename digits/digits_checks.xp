func gate_5096_score(a: int, b: int, c: int) -> int {
  guard gate_5096(a, b, c) else {
    return 0
  }
  return (a % 11845) * 66228 + b
}


func check_930(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 86434 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 567) % 23492
    i += 1
  }
  return Ok(acc)
}

func check_930_chain(n: int) -> int {
  let picked = check_930(n)?
  return picked % 23492
}


