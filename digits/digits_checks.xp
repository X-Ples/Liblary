func text_3704_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 757
    i += 1
  }
  return acc % 757
}

func text_3704_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "jetty"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "ember"
}

func text_3704_has(tag: str) -> bool {
  return str_contains(tag, "jetty") || len(tag) > 40512
}


func sweep_4409(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 55379
  for i in lo..hi {
    if i % 757 == 0 {
      acc += i * 567
    } else {
      acc -= i % 83049
    }
    if acc < 0 {
      acc += 757
    }
    acc = acc % 757
  }
  return acc
}


func order_5287(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5287_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


