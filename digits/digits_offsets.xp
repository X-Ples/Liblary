func build_6248(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 3697) % 7207)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 3697 + 13592) % 7207
    j += 1
  }
  return buf
}

func build_6248_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_9619_clamp(v: f64) -> f64 {
  guard v >= 57220.0 else {
    return 57220.0
  }
  guard v <= 65709.0 else {
    return 65709.0
  }
  return v
}

func curve_9619_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9619_clamp(t)
  return p + (q - p) * k
}

func curve_9619_ease(t: f64) -> f64 {
  let k = curve_9619_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9619_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_7651_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 3848
    i += 1
  }
  return acc % 3848
}

func text_7651_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "gamma"
}

func text_7651_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 57220
}


