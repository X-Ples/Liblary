func curve_5886_clamp(v: f64) -> f64 {
  guard v >= 73143.0 else {
    return 73143.0
  }
  guard v <= 76881.0 else {
    return 76881.0
  }
  return v
}

func curve_5886_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5886_clamp(t)
  return p + (q - p) * k
}

func curve_5886_ease(t: f64) -> f64 {
  let k = curve_5886_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5886_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


