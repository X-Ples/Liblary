}

func row_809_sum(limit: int) -> int {
  let row = row_809()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_809_best() -> int {
