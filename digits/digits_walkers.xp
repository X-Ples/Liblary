func scan_9264(data: [int], seed: int) -> int {
  let acc = seed % 76881
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 40988 + data[i] + i) % 76881
    i += 1
  }
  return acc
}

func scan_9264_span(data: [int], seed: int) -> int {
  let acc = scan_9264(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 40988
}


func check_7899(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 60607 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 9802) % 17515
    i += 1
  }
  return Ok(acc)
}

func check_7899_chain(n: int) -> int {
  let picked = check_7899(n)?
  return picked % 17515
}


