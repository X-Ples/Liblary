func demo_walkers(seed: int) -> int {
  let scratch = build_141(seed % 61 + 6, seed % 76881)
  show(len(scratch))
  show(build_141_last(scratch))
  show(grid_9898_rowsum(scratch, 882, 1336, 3055))
  show(order_6687_find(scratch, 2710))
  show(build_7125_last(scratch))
  show(scan_9264(scratch, 2415))
  show(scan_9264_span(scratch, 2116))
  return seed % 90294
}
