func sweep_3755(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 65810
  for i in lo..hi {
    if i % 31895 == 0 {
      acc += i * 65774
    } else {
      acc -= i % 78401
    }
    if acc < 0 {
      acc += 79898
    }
    acc = acc % 79898
  }
  return acc
}


