func build_6376(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 65774) % 86430)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 65774 + 65774) % 86430
    j += 1
  }
  return buf
}

func build_6376_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_2920_clamp(v: f64) -> f64 {
  guard v >= 26510.0 else {
    return 26510.0
  }
  guard v <= 26731.0 else {
    return 26731.0
  }
  return v
}

func curve_2920_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2920_clamp(t)
  return p + (q - p) * k
}

func curve_2920_ease(t: f64) -> f64 {
  let k = curve_2920_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2920_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_6696() -> [int] {
  return [365, 220, 2848, 3365, 234, 3311, 1070, 2767, 1329, 2676, 2138, 1610, 528, 2462]
}

func row_6696_at(i: int) -> int {
  let row = row_6696()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6696_sum(limit: int) -> int {
  let row = row_6696()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6696_best() -> int {
  let row = row_6696()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_5849(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5849_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func check_3578(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 21778 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 87274) % 27981
    i += 1
  }
  return Ok(acc)
}

func check_3578_chain(n: int) -> int {
  let picked = check_3578(n)?
  return picked % 27981
}


