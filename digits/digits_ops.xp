func curve_6897_clamp(v: f64) -> f64 {
  guard v >= 74344.0 else {
    return 74344.0
  }
  guard v <= 93724.0 else {
    return 93724.0
  }
  return v
}

func curve_6897_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6897_clamp(t)
  return p + (q - p) * k
}

func curve_6897_ease(t: f64) -> f64 {
  let k = curve_6897_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6897_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_487() -> [int] {
  return [3596, 2432, 1525, 3838, 332, 799, 1094, 2572, 2904, 2542, 2818, 740, 1081, 3911, 2180, 3333, 134, 644, 3900, 2984]
}

func row_487_at(i: int) -> int {
  let row = row_487()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_487_sum(limit: int) -> int {
  let row = row_487()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_487_best() -> int {
  let row = row_487()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_8210(data: [int], seed: int) -> int {
  let acc = seed % 16854
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 52633 + data[i] + i) % 16854
    i += 1
  }
  return acc
}

func scan_8210_span(data: [int], seed: int) -> int {
  let acc = scan_8210(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 52633
}


func order_9515(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9515_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_472(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 95871) % 76541)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 95871 + 36914) % 76541
    j += 1
  }
  return buf
}

func build_472_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_5115(a: int, b: int, c: int) -> bool {
  return a > 76541 && (b < 30128 || c == 51974)
}

func gate_5115_score(a: int, b: int, c: int) -> int {
  guard gate_5115(a, b, c) else {
    return 0
  }
  return (a % 30128) * 51974 + b
}


