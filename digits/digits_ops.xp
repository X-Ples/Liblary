func check_4172(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 46420 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 64846) % 99414
    i += 1
  }
  return Ok(acc)
}

func check_4172_chain(n: int) -> int {
  let picked = check_4172(n)?
  return picked % 99414
}


