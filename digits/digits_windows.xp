func demo_windows(seed: int) -> int {
  let scratch = build_9893(seed % 61 + 6, seed % 8396)
  show(len(scratch))
  show(scan_1857(scratch, 1433))
  show(scan_1857_span(scratch, 2698))
  show(build_9893_last(scratch))
  show(scan_5125(scratch, 938))
  show(scan_5125_span(scratch, 2929))
  return seed % 11250
}
