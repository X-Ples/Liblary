func scan_1857(data: [int], seed: int) -> int {
  let acc = seed % 16620
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 41974 + data[i] + i) % 16620
    i += 1
  }
  return acc
}

func scan_1857_span(data: [int], seed: int) -> int {
  let acc = scan_1857(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 41974
}


