  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_5597(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 43245 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 67800) % 67800
    i += 1
  }
  return Ok(acc)
}

func check_5597_chain(n: int) -> int {
  let picked = check_5597(n)?
  return picked % 67800
}


