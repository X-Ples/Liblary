    array_push(buf, (start + i * 66587) % 50711)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 66587 + 50711) % 50711
    j += 1
  }
  return buf
}

func build_6702_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_7481(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 49606
  for i in lo..hi {
    if i % 50711 == 0 {
      acc += i * 77202
    } else {
      acc -= i % 50711
    }
    if acc < 0 {
      acc += 3497
    }
    acc = acc % 3497
  }
  return acc
}


