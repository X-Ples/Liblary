func text_204_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 36525
    i += 1
  }
  return acc % 36525
}

func text_204_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "mesa"
}

func text_204_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 36525
}


