func sweep_5728(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 56481
  for i in lo..hi {
    if i % 95364 == 0 {
      acc += i * 56481
    } else {
      acc -= i % 19892
    }
    if acc < 0 {
      acc += 6537
    }
    acc = acc % 6537
  }
  return acc
}


func demo_ranges(seed: int) -> int {
  let scratch = build_3355(seed % 61 + 6, seed % 52647)
  show(len(scratch))
  show(text_204_weight("mesa"))
  show(text_204_label(3316))
  show(text_204_has("nova"))
  show(build_3355_last(scratch))
  show(row_7081_at(3102))
  show(row_7081_sum(3648))
  return seed % 36525
}
