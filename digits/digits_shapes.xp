func demo_shapes(seed: int) -> int {
  let scratch = build_2922(seed % 61 + 6, seed % 47107)
  show(len(scratch))
  show(build_2922_last(scratch))
  show(text_8337_weight("lumen"))
  show(text_8337_label(1449))
  show(text_8337_has("nova"))
  show(grid_9663_rowsum(scratch, 3333, 2441, 2635))
  return seed % 9653
}
