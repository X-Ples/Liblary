func scan_1499(data: [int], seed: int) -> int {
  let acc = seed % 53136
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 53136 + data[i] + i) % 53136
    i += 1
  }
  return acc
}

func scan_1499_span(data: [int], seed: int) -> int {
  let acc = scan_1499(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 53136
}


func check_6904(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 92429 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 47107) % 47107
    i += 1
  }
  return Ok(acc)
}

func check_6904_chain(n: int) -> int {
  let picked = check_6904(n)?
  return picked % 47107
}


