func build_2922(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 73723) % 14582)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 73723 + 60454) % 14582
    j += 1
  }
  return buf
}

func build_2922_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_3485_clamp(v: f64) -> f64 {
  guard v >= 2722.0 else {
    return 2722.0
  }
  guard v <= 12339.0 else {
    return 12339.0
  }
  return v
}

func curve_3485_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3485_clamp(t)
  return p + (q - p) * k
}

func curve_3485_ease(t: f64) -> f64 {
  let k = curve_3485_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3485_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_8337_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 73723
    i += 1
  }
  return acc % 73723
}

func text_8337_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "jetty"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "talus"
}

func text_8337_has(tag: str) -> bool {
  return str_contains(tag, "jetty") || len(tag) > 26724
}


func grid_9663_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 4149 + c * 92429 + seed) % 92429)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9663_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 92429 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_8834(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 53136
  for i in lo..hi {
    if i % 72617 == 0 {
      acc += i * 73289
    } else {
      acc -= i % 78112
    }
    if acc < 0 {
      acc += 4149
    }
    acc = acc % 4149
  }
  return acc
}


func gate_7606(a: int, b: int, c: int) -> bool {
  return a > 95905 && (b < 72617 || c == 52920)
}

func gate_7606_score(a: int, b: int, c: int) -> int {
  guard gate_7606(a, b, c) else {
    return 0
  }
  return (a % 72617) * 52920 + b
}


