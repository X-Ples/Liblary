func build_6000(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 27682) % 78920)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 27682 + 4997) % 78920
    j += 1
  }
  return buf
}

func build_6000_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_4509_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 6694
    i += 1
  }
  return acc % 6694
}

func text_4509_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "jetty"
}

func text_4509_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 36152
}


func gate_8244(a: int, b: int, c: int) -> bool {
  return a > 6694 && (b < 52603 || c == 36152)
}

func gate_8244_score(a: int, b: int, c: int) -> int {
  guard gate_8244(a, b, c) else {
    return 0
  }
  return (a % 52603) * 36152 + b
}


func grid_5570_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 4997 + c * 36152 + seed) % 36152)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5570_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 36152 == want {
      total += acc
    }
    r += 1
  }
  return total
}


