func curve_2058_clamp(v: f64) -> f64 {
  guard v >= 51631.0 else {
    return 51631.0
  }
  guard v <= 64066.0 else {
    return 64066.0
  }
  return v
}

func curve_2058_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2058_clamp(t)
  return p + (q - p) * k
}

func curve_2058_ease(t: f64) -> f64 {
  let k = curve_2058_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2058_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_7045(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 87405
  for i in lo..hi {
    if i % 51631 == 0 {
      acc += i * 87405
    } else {
      acc -= i % 3455
    }
    if acc < 0 {
      acc += 52603
    }
    acc = acc % 52603
  }
  return acc
}


