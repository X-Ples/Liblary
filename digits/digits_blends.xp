func demo_blends(seed: int) -> int {
  let scratch = build_9129(seed % 61 + 6, seed % 74951)
  show(len(scratch))
  show(order_4988_find(scratch, 2700))
  show(build_9129_last(scratch))
  show(row_9043_at(3322))
  show(row_9043_sum(3619))
  show(row_9043_best())
  return seed % 6269
}
