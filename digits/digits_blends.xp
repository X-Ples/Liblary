func text_9289_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 65316
    i += 1
  }
  return acc % 65316
}

func text_9289_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ridge"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "sigma"
}

func text_9289_has(tag: str) -> bool {
  return str_contains(tag, "ridge") || len(tag) > 335
}


func check_3893(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 80154 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 96053) % 74951
    i += 1
  }
  return Ok(acc)
}

func check_3893_chain(n: int) -> int {
  let picked = check_3893(n)?
  return picked % 74951
}


