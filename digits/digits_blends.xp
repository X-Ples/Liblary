}

func row_9043_at(i: int) -> int {
  let row = row_9043()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9043_sum(limit: int) -> int {
  let row = row_9043()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
