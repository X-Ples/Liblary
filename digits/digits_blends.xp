}

func row_9043_best() -> int {
  let row = row_9043()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_3821(data: [int], seed: int) -> int {
  let acc = seed % 335
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 76420 + data[i] + i) % 335
    i += 1
  }
  return acc
}

func scan_3821_span(data: [int], seed: int) -> int {
  let acc = scan_3821(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 76420
}


