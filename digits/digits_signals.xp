func demo_signals(seed: int) -> int {
  let scratch = build_5010(seed % 61 + 6, seed % 38980)
  show(len(scratch))
  show(check_3830_chain(62))
  show(gate_2738(1633, 3111, 2096))
  show(gate_2738_score(1506, 1236, 3918))
  show(build_5010_last(scratch))
  return seed % 28512
}
