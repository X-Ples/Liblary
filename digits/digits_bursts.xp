func row_931() -> [int] {
  return [839, 3614, 164, 2, 2087, 3110, 3843, 650, 3962, 3661, 529, 3991, 3847, 3847, 415, 3877, 2350, 3048, 2580]
}

func row_931_at(i: int) -> int {
  let row = row_931()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_931_sum(limit: int) -> int {
  let row = row_931()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_931_best() -> int {
  let row = row_931()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_8344(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 21291) % 42610)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 21291 + 53832) % 42610
    j += 1
  }
  return buf
}

func build_8344_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_7731(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 69434 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 32154) % 72636
    i += 1
  }
  return Ok(acc)
}

func check_7731_chain(n: int) -> int {
  let picked = check_7731(n)?
  return picked % 72636
}


func grid_857_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 88668 + c * 718 + seed) % 718)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_857_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 718 == want {
      total += acc
    }
    r += 1
  }
  return total
}


