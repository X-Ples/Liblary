func scan_7109(data: [int], seed: int) -> int {
  let acc = seed % 41014
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 5091 + data[i] + i) % 41014
    i += 1
  }
  return acc
}

func scan_7109_span(data: [int], seed: int) -> int {
  let acc = scan_7109(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 5091
}


