func check_526(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 90963 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 68943) % 37636
    i += 1
  }
  return Ok(acc)
}

func check_526_chain(n: int) -> int {
  let picked = check_526(n)?
  return picked % 37636
}


