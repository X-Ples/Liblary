    acc += str_code_at(tag, i) % 93782
    i += 1
  }
  return acc % 93782
}

func text_3623_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "lumen"
}

func text_3623_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 68943
}


