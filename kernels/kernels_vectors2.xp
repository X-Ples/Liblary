func demo_vectors2(seed: int) -> int {
  let scratch = build_6120(seed % 61 + 6, seed % 84181)
  show(len(scratch))
  show(scan_6977(scratch, 3550))
  show(scan_6977_span(scratch, 1279))
  show(order_9215_find(scratch, 2687))
  return seed % 59972
}
