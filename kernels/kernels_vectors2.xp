func scan_6977(data: [int], seed: int) -> int {
  let acc = seed % 14386
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 21639 + data[i] + i) % 14386
    i += 1
  }
  return acc
}

func scan_6977_span(data: [int], seed: int) -> int {
  let acc = scan_6977(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 21639
}


func order_9215(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9215_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_7325(a: int, b: int, c: int) -> bool {
  return a > 37311 && (b < 56913 || c == 21639)
}

func gate_7325_score(a: int, b: int, c: int) -> int {
  guard gate_7325(a, b, c) else {
    return 0
  }
  return (a % 56913) * 21639 + b
}


func text_6632_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 37554
    i += 1
  }
  return acc % 37554
}

func text_6632_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "gamma"
}

func text_6632_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 14386
}


func curve_9892_clamp(v: f64) -> f64 {
  guard v >= 20857.0 else {
    return 20857.0
  }
  guard v <= 45294.0 else {
    return 45294.0
  }
  return v
}

func curve_9892_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9892_clamp(t)
  return p + (q - p) * k
}

func curve_9892_ease(t: f64) -> f64 {
  let k = curve_9892_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9892_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_6120(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 93264) % 82064)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 93264 + 30493) % 82064
    j += 1
  }
  return buf
}

func build_6120_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_2333() -> [int] {
