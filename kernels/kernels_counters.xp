func demo_counters(seed: int) -> int {
  let scratch = build_4484(seed % 61 + 6, seed % 5797)
  show(len(scratch))
  show(build_4484_last(scratch))
  show(order_4808_find(scratch, 187))
  show(text_7942_weight("harbor"))
  return seed % 5797
}
