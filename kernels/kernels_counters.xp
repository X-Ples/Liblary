func check_7738(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 98136 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 61708) % 83031
    i += 1
  }
  return Ok(acc)
}

func check_7738_chain(n: int) -> int {
  let picked = check_7738(n)?
  return picked % 83031
}


