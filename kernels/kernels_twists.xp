func demo_twists(seed: int) -> int {
  let scratch = build_7805(seed % 61 + 6, seed % 90082)
  show(len(scratch))
  show(build_7805_last(scratch))
  show(sweep_5344(2782, 1755))
  show(row_2874_at(2146))
  show(row_2874_sum(211))
  show(row_2874_best())
  show(grid_396_rowsum(scratch, 1026, 970, 3338))
  return seed % 37578
}
