func build_7805(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 7162) % 82800)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 7162 + 20148) % 82800
    j += 1
  }
  return buf
}

func build_7805_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_5344(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 19716
  for i in lo..hi {
    if i % 95973 == 0 {
      acc += i * 62906
    } else {
      acc -= i % 85870
    }
    if acc < 0 {
      acc += 26048
    }
    acc = acc % 26048
  }
  return acc
}


func row_2874() -> [int] {
  return [2372, 3837, 46, 310, 2446, 388, 1041, 219, 2408, 1863, 1916, 2800, 135, 1461, 2337, 204, 3681]
}

func row_2874_at(i: int) -> int {
  let row = row_2874()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2874_sum(limit: int) -> int {
  let row = row_2874()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2874_best() -> int {
  let row = row_2874()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_396_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 23437 + c * 18681 + seed) % 18681)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_396_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 18681 == want {
      total += acc
    }
    r += 1
  }
  return total
}


