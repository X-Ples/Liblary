func gate_4239(a: int, b: int, c: int) -> bool {
  return a > 50810 && (b < 49240 || c == 1201)
}

func gate_4239_score(a: int, b: int, c: int) -> int {
  guard gate_4239(a, b, c) else {
    return 0
  }
  return (a % 49240) * 1201 + b
}


func scan_2656(data: [int], seed: int) -> int {
  let acc = seed % 26048
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 49240 + data[i] + i) % 26048
    i += 1
  }
  return acc
}

func scan_2656_span(data: [int], seed: int) -> int {
  let acc = scan_2656(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 49240
}


