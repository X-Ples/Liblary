func check_978(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 85870 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 7507) % 61402
    i += 1
  }
  return Ok(acc)
}

func check_978_chain(n: int) -> int {
  let picked = check_978(n)?
  return picked % 61402
}


