func build_3748(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 53605) % 32610)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 53605 + 21358) % 32610
    j += 1
  }
  return buf
}

func build_3748_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_2307_clamp(v: f64) -> f64 {
  guard v >= 78213.0 else {
    return 78213.0
  }
  guard v <= 93905.0 else {
    return 93905.0
  }
  return v
}

func curve_2307_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2307_clamp(t)
  return p + (q - p) * k
}

func curve_2307_ease(t: f64) -> f64 {
  let k = curve_2307_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2307_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_9298() -> [int] {
