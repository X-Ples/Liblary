func demo_windows(seed: int) -> int {
  let scratch = build_3748(seed % 61 + 6, seed % 35828)
  show(len(scratch))
  show(build_3748_last(scratch))
  show(row_9298_at(365))
  show(row_9298_sum(2106))
  show(row_9298_best())
  return seed % 78213
}
