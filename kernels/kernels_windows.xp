func scan_369(data: [int], seed: int) -> int {
  let acc = seed % 44413
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 21358 + data[i] + i) % 44413
    i += 1
  }
  return acc
}

