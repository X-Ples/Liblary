func row_9298_at(i: int) -> int {
  let row = row_9298()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9298_sum(limit: int) -> int {
  let row = row_9298()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9298_best() -> int {
  let row = row_9298()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_4224(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 97845
  for i in lo..hi {
    if i % 70098 == 0 {
      acc += i * 78213
    } else {
      acc -= i % 2079
    }
    if acc < 0 {
      acc += 93905
    }
    acc = acc % 93905
  }
  return acc
}


func check_145(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 94146 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 59736) % 2079
    i += 1
  }
  return Ok(acc)
}

func check_145_chain(n: int) -> int {
  let picked = check_145(n)?
  return picked % 2079
}


