func row_5496() -> [int] {
  return [3400, 16, 3900, 2492, 2350, 1075, 3760, 322, 1839, 3162, 3563, 37, 2018, 345, 2654, 3723]
}

func row_5496_at(i: int) -> int {
  let row = row_5496()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5496_sum(limit: int) -> int {
  let row = row_5496()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5496_best() -> int {
  let row = row_5496()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_3022(data: [int], seed: int) -> int {
  let acc = seed % 55159
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 10283 + data[i] + i) % 55159
    i += 1
  }
  return acc
}

func scan_3022_span(data: [int], seed: int) -> int {
  let acc = scan_3022(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 10283
}


