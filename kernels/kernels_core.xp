func sweep_956(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10283
  for i in lo..hi {
    if i % 32264 == 0 {
      acc += i * 47398
    } else {
      acc -= i % 20221
    }
    if acc < 0 {
      acc += 28558
    }
    acc = acc % 28558
  }
  return acc
}


func grid_4720_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 56981 + c * 94464 + seed) % 94464)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4720_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 94464 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_4915_clamp(v: f64) -> f64 {
  guard v >= 20133.0 else {
    return 20133.0
  }
  guard v <= 75610.0 else {
    return 75610.0
  }
  return v
}

func curve_4915_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4915_clamp(t)
  return p + (q - p) * k
}

func curve_4915_ease(t: f64) -> f64 {
  let k = curve_4915_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4915_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_549_weight(tag: str) -> int {
