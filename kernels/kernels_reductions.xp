func build_5488(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 70784) % 77266)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 70784 + 76551) % 77266
    j += 1
  }
  return buf
}

func build_5488_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_1915_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 54289 + c * 77094 + seed) % 77094)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1915_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 77094 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_4634(data: [int], seed: int) -> int {
  let acc = seed % 15162
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 82673 + data[i] + i) % 15162
    i += 1
  }
  return acc
}

func scan_4634_span(data: [int], seed: int) -> int {
  let acc = scan_4634(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 82673
}


func gate_271(a: int, b: int, c: int) -> bool {
  return a > 81871 && (b < 83436 || c == 3421)
}

func gate_271_score(a: int, b: int, c: int) -> int {
  guard gate_271(a, b, c) else {
    return 0
  }
  return (a % 83436) * 3421 + b
}


func text_4611_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 30065
    i += 1
  }
  return acc % 30065
}

func text_4611_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "jetty"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "lumen"
}

func text_4611_has(tag: str) -> bool {
  return str_contains(tag, "jetty") || len(tag) > 92474
}


