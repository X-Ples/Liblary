func sweep_162(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 76551
  for i in lo..hi {
    if i % 82275 == 0 {
      acc += i * 83436
    } else {
      acc -= i % 3421
    }
    if acc < 0 {
      acc += 82275
    }
    acc = acc % 82275
  }
  return acc
}


