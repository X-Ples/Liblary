func demo_reductions(seed: int) -> int {
  let scratch = build_5488(seed % 61 + 6, seed % 70784)
  show(len(scratch))
  show(build_5488_last(scratch))
  show(grid_1915_rowsum(scratch, 3359, 1031, 1380))
  show(scan_4634(scratch, 3400))
  return seed % 45001
}
