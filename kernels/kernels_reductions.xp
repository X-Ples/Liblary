func check_9682(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 92474 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 46713) % 82275
    i += 1
  }
  return Ok(acc)
}

func check_9682_chain(n: int) -> int {
  let picked = check_9682(n)?
  return picked % 82275
}


