func row_6878() -> [int] {
  return [760, 226, 555, 2104, 3255, 258, 751, 2876, 939, 992]
}

func row_6878_at(i: int) -> int {
  let row = row_6878()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6878_sum(limit: int) -> int {
  let row = row_6878()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6878_best() -> int {
  let row = row_6878()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_2236_clamp(v: f64) -> f64 {
  guard v >= 333.0 else {
    return 333.0
  }
  guard v <= 12300.0 else {
    return 12300.0
  }
  return v
}

func curve_2236_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2236_clamp(t)
  return p + (q - p) * k
}

func curve_2236_ease(t: f64) -> f64 {
  let k = curve_2236_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2236_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


