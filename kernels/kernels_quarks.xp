func check_9531(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 84871 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 16106) % 84871
    i += 1
  }
  return Ok(acc)
}

func check_9531_chain(n: int) -> int {
  let picked = check_9531(n)?
  return picked % 84871
}


