func demo_quarks(seed: int) -> int {
  let scratch = build_5726(seed % 61 + 6, seed % 38970)
  show(len(scratch))
  show(build_5726_last(scratch))
  show(scan_9255(scratch, 1013))
  show(scan_9255_span(scratch, 3854))
  show(gate_5911(2523, 56, 2838))
  return seed % 28461
}
