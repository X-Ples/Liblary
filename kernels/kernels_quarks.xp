func build_5726(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 16106) % 46250)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 16106 + 84871) % 46250
    j += 1
  }
  return buf
}

func build_5726_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_9255(data: [int], seed: int) -> int {
  let acc = seed % 84871
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 57237 + data[i] + i) % 84871
    i += 1
  }
  return acc
}

func scan_9255_span(data: [int], seed: int) -> int {
  let acc = scan_9255(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 57237
}


func gate_5911(a: int, b: int, c: int) -> bool {
  return a > 85939 && (b < 13594 || c == 7544)
}

func gate_5911_score(a: int, b: int, c: int) -> int {
  guard gate_5911(a, b, c) else {
    return 0
  }
  return (a % 13594) * 7544 + b
}


func grid_4255_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 59972 + c * 16359 + seed) % 16359)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4255_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 16359 == want {
      total += acc
    }
    r += 1
  }
  return total
}


