func scan_1076(data: [int], seed: int) -> int {
  let acc = seed % 90531
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 90531 + data[i] + i) % 90531
    i += 1
  }
  return acc
}

func scan_1076_span(data: [int], seed: int) -> int {
  let acc = scan_1076(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 90531
}


