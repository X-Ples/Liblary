func gate_8386(a: int, b: int, c: int) -> bool {
  return a > 80569 && (b < 80569 || c == 92002)
}

func gate_8386_score(a: int, b: int, c: int) -> int {
  guard gate_8386(a, b, c) else {
    return 0
  }
  return (a % 80569) * 92002 + b
}


func check_7242(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 3895 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 3895) % 29356
    i += 1
  }
  return Ok(acc)
}

func check_7242_chain(n: int) -> int {
  let picked = check_7242(n)?
  return picked % 29356
}


