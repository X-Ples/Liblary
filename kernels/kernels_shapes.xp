func demo_shapes(seed: int) -> int {
  let scratch = build_7075(seed % 61 + 6, seed % 47824)
  show(len(scratch))
  show(build_7075_last(scratch))
  show(order_4007_find(scratch, 1075))
  show(grid_2999_rowsum(scratch, 512, 1748, 1100))
  return seed % 68792
}
