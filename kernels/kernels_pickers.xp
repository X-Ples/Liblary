func curve_5342_clamp(v: f64) -> f64 {
  guard v >= 28753.0 else {
    return 28753.0
  }
  guard v <= 60979.0 else {
    return 60979.0
  }
  return v
}

func curve_5342_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5342_clamp(t)
  return p + (q - p) * k
}

func curve_5342_ease(t: f64) -> f64 {
  let k = curve_5342_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5342_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_4727(data: [int], seed: int) -> int {
  let acc = seed % 59526
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 259 + data[i] + i) % 59526
    i += 1
  }
  return acc
}

func scan_4727_span(data: [int], seed: int) -> int {
  let acc = scan_4727(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 259
}


