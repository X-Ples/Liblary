func text_3675_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 16973
    i += 1
  }
  return acc % 16973
}

func text_3675_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "jetty"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "prism"
}

func text_3675_has(tag: str) -> bool {
  return str_contains(tag, "jetty") || len(tag) > 21608
}


func row_4256() -> [int] {
  return [192, 3230, 2380, 43, 3735, 1603, 811, 2604, 3524, 618, 4071, 3825, 3507, 529, 2104, 2920, 3933]
}

func row_4256_at(i: int) -> int {
  let row = row_4256()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4256_sum(limit: int) -> int {
  let row = row_4256()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4256_best() -> int {
  let row = row_4256()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_5718(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 60979) % 27909)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 60979 + 82123) % 27909
    j += 1
  }
  return buf
}

func build_5718_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_3072(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3072_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_4695(a: int, b: int, c: int) -> bool {
  return a > 68390 && (b < 27108 || c == 86701)
}

func gate_4695_score(a: int, b: int, c: int) -> int {
  guard gate_4695(a, b, c) else {
    return 0
  }
  return (a % 27108) * 86701 + b
}


