func check_4853(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 60979 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 59402) % 1036
    i += 1
  }
  return Ok(acc)
}

func check_4853_chain(n: int) -> int {
  let picked = check_4853(n)?
  return picked % 1036
}


