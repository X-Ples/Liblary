func row_9925() -> [int] {
  return [1829, 688, 1241, 3397, 3918, 3788, 2169, 1626, 62, 2749, 952, 998, 566, 3467, 3812, 972, 3712, 4080]
}

func row_9925_at(i: int) -> int {
  let row = row_9925()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9925_sum(limit: int) -> int {
  let row = row_9925()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9925_best() -> int {
  let row = row_9925()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


