func scan_2540(data: [int], seed: int) -> int {
  let acc = seed % 17870
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 4740 + data[i] + i) % 17870
    i += 1
  }
  return acc
}

func scan_2540_span(data: [int], seed: int) -> int {
  let acc = scan_2540(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 4740
}


func curve_2516_clamp(v: f64) -> f64 {
  guard v >= 46421.0 else {
    return 46421.0
  }
  guard v <= 57730.0 else {
    return 57730.0
  }
  return v
}

func curve_2516_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2516_clamp(t)
  return p + (q - p) * k
}

func curve_2516_ease(t: f64) -> f64 {
  let k = curve_2516_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2516_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_9012(a: int, b: int, c: int) -> bool {
  return a > 10837 && (b < 65473 || c == 59177)
}

func gate_9012_score(a: int, b: int, c: int) -> int {
  guard gate_9012(a, b, c) else {
    return 0
  }
  return (a % 65473) * 59177 + b
}


