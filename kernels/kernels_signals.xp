func check_3854(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 34458 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 55217) % 78642
    i += 1
  }
  return Ok(acc)
}

func check_3854_chain(n: int) -> int {
  let picked = check_3854(n)?
  return picked % 78642
}


