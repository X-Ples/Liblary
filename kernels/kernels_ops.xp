func demo_ops(seed: int) -> int {
  let scratch = build_1377(seed % 61 + 6, seed % 46834)
  show(len(scratch))
  show(check_6057_chain(1281))
  show(build_1377_last(scratch))
  show(scan_4182(scratch, 2853))
  show(scan_4182_span(scratch, 708))
