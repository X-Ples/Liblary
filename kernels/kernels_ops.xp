func check_6057(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 2649 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 98359) % 98447
    i += 1
  }
  return Ok(acc)
}

func check_6057_chain(n: int) -> int {
  let picked = check_6057(n)?
  return picked % 98447
}


func build_1377(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 16688) % 57157)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 16688 + 95771) % 57157
    j += 1
  }
  return buf
}

func build_1377_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_4182(data: [int], seed: int) -> int {
  let acc = seed % 34461
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 83129 + data[i] + i) % 34461
    i += 1
  }
  return acc
}

func scan_4182_span(data: [int], seed: int) -> int {
  let acc = scan_4182(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 83129
}


func grid_2109_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 26546 + c * 80888 + seed) % 80888)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2109_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 80888 == want {
      total += acc
    }
    r += 1
  }
  return total
}


