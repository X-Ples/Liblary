}


func row_113() -> [int] {
  return [2981, 874, 453, 1219, 3552, 873, 2871, 4044, 978, 3738, 1005]
}

func row_113_at(i: int) -> int {
  let row = row_113()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_113_sum(limit: int) -> int {
  let row = row_113()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_113_best() -> int {
  let row = row_113()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


