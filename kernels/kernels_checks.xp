func row_5427_at(i: int) -> int {
  let row = row_5427()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5427_sum(limit: int) -> int {
  let row = row_5427()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5427_best() -> int {
  let row = row_5427()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_6632_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 72719
    i += 1
  }
  return acc % 72719
}

func text_6632_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "omega"
}

func text_6632_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 94175
}


func build_882(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 65873) % 94175)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 65873 + 62511) % 94175
    j += 1
  }
  return buf
}

func build_882_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_7060_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 57067 + c * 65873 + seed) % 65873)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7060_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 65873 == want {
      total += acc
    }
    r += 1
  }
  return total
}


