  guard hi > lo else {
    return 0
  }
  let acc = 85942
  for i in lo..hi {
    if i % 53312 == 0 {
      acc += i * 34270
    } else {
      acc -= i % 83105
    }
    if acc < 0 {
      acc += 85942
    }
    acc = acc % 85942
  }
