func build_8562(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 60147) % 43388)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 60147 + 2826) % 43388
    j += 1
  }
  return buf
}

func build_8562_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_7065_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 50501 + c * 48804 + seed) % 48804)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7065_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 48804 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_2359_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 60147
    i += 1
  }
  return acc % 60147
}

func text_2359_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "bravo"
  }
  return "alpha"
}

func text_2359_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 48385
}


func order_9147(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9147_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func check_9754(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 72004 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 72300) % 36278
    i += 1
  }
  return Ok(acc)
}

func check_9754_chain(n: int) -> int {
  let picked = check_9754(n)?
  return picked % 36278
}


