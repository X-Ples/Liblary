func demo_offsets(seed: int) -> int {
  let scratch = build_8562(seed % 61 + 6, seed % 9646)
  show(len(scratch))
  show(build_8562_last(scratch))
  show(grid_7065_rowsum(scratch, 2442, 716, 506))
  show(text_2359_weight("cargo"))
  show(text_2359_label(144))
  show(text_2359_has("ion"))
  return seed % 85942
}
