func demo_helpers(seed: int) -> int {
  let scratch = build_4466(seed % 61 + 6, seed % 22857)
  show(len(scratch))
  show(scan_3934(scratch, 2100))
  show(scan_3934_span(scratch, 298))
  show(text_2143_weight("omega"))
  show(text_2143_label(1757))
  show(text_2143_has("gamma"))
  return seed % 98391
}
