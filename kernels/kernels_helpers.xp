func row_8771() -> [int] {
  return [3519, 1464, 415, 2027, 696, 1279, 2774, 2852, 4054, 2928, 4028, 3348, 2485, 3519, 2748]
}

func row_8771_at(i: int) -> int {
  let row = row_8771()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8771_sum(limit: int) -> int {
  let row = row_8771()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8771_best() -> int {
  let row = row_8771()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_8504(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 17129 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 45785) % 92869
    i += 1
  }
  return Ok(acc)
}

func check_8504_chain(n: int) -> int {
  let picked = check_8504(n)?
  return picked % 92869
}


