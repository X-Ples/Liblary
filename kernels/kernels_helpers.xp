func scan_3934(data: [int], seed: int) -> int {
  let acc = seed % 79178
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 79178 + data[i] + i) % 79178
    i += 1
  }
  return acc
}

func scan_3934_span(data: [int], seed: int) -> int {
  let acc = scan_3934(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 79178
}


func text_2143_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 98539
    i += 1
  }
  return acc % 98539
}

func text_2143_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "sigma"
}

func text_2143_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 97174
}


func grid_6325_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 5219 + c * 82384 + seed) % 82384)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6325_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 82384 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_5399(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 94463
  for i in lo..hi {
    if i % 79935 == 0 {
      acc += i * 34311
    } else {
      acc -= i % 92757
    }
    if acc < 0 {
      acc += 51511
    }
    acc = acc % 51511
  }
  return acc
}


func build_4466(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 92757) % 22857)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 92757 + 45785) % 22857
    j += 1
  }
  return buf
}

func build_4466_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


