func build_3139(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 52449) % 4367)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 52449 + 86960) % 4367
    j += 1
  }
  return buf
}

func build_3139_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_9705(a: int, b: int, c: int) -> bool {
  return a > 79334 && (b < 75035 || c == 4367)
}

func gate_9705_score(a: int, b: int, c: int) -> int {
  guard gate_9705(a, b, c) else {
    return 0
  }
  return (a % 75035) * 4367 + b
}


func text_8940_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 52449
    i += 1
  }
  return acc % 52449
}

func text_8940_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "lumen"
}

func text_8940_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 4367
}


func sweep_9676(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 66012
  for i in lo..hi {
    if i % 91730 == 0 {
      acc += i * 86960
    } else {
      acc -= i % 90634
    }
    if acc < 0 {
      acc += 66012
    }
    acc = acc % 66012
  }
  return acc
}


func scan_9003(data: [int], seed: int) -> int {
  let acc = seed % 61329
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 89820 + data[i] + i) % 61329
    i += 1
  }
  return acc
}

func scan_9003_span(data: [int], seed: int) -> int {
  let acc = scan_9003(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 89820
}


func grid_4634_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 49656 + c * 78565 + seed) % 78565)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4634_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 78565 == want {
      total += acc
    }
    r += 1
  }
  return total
}


