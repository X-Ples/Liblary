func check_9885(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 75035 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 86960) % 86960
    i += 1
  }
  return Ok(acc)
}

func check_9885_chain(n: int) -> int {
  let picked = check_9885(n)?
  return picked % 86960
}


