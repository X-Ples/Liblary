func check_1953(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 9828 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 68339) % 1479
    i += 1
  }
  return Ok(acc)
}

func check_1953_chain(n: int) -> int {
  let picked = check_1953(n)?
  return picked % 1479
}


