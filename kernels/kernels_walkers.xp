func curve_6491_clamp(v: f64) -> f64 {
  guard v >= 62502.0 else {
    return 62502.0
  }
  guard v <= 74927.0 else {
    return 74927.0
  }
  return v
}

func curve_6491_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6491_clamp(t)
  return p + (q - p) * k
}

func curve_6491_ease(t: f64) -> f64 {
  let k = curve_6491_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6491_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_8460(data: [int], seed: int) -> int {
  let acc = seed % 69813
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 36152 + data[i] + i) % 69813
    i += 1
  }
  return acc
}

func scan_8460_span(data: [int], seed: int) -> int {
  let acc = scan_8460(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 36152
}


func grid_9029_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 36475 + c * 68339 + seed) % 68339)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9029_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 68339 == want {
      total += acc
    }
    r += 1
  }
  return total
}


