func row_8453_at(i: int) -> int {
  let row = row_8453()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8453_sum(limit: int) -> int {
  let row = row_8453()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8453_best() -> int {
  let row = row_8453()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_2769(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 36475) % 9828)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 36475 + 69813) % 9828
    j += 1
  }
  return buf
}

func build_2769_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


