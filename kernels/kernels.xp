func scan_8061(data: [int], seed: int) -> int {
  let acc = seed % 41438
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 97976 + data[i] + i) % 41438
    i += 1
  }
  return acc
}

func scan_8061_span(data: [int], seed: int) -> int {
  let acc = scan_8061(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 97976
}


