func curve_5460_clamp(v: f64) -> f64 {
  guard v >= 32738.0 else {
    return 32738.0
  }
  guard v <= 85855.0 else {
    return 85855.0
  }
  return v
}

func curve_5460_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5460_clamp(t)
  return p + (q - p) * k
}

func curve_5460_ease(t: f64) -> f64 {
  let k = curve_5460_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5460_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_2985(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 46969) % 5827)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 46969 + 88453) % 5827
    j += 1
  }
  return buf
}

func build_2985_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_6028_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 98459
    i += 1
  }
  return acc % 98459
}

func text_6028_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "harbor"
}

func text_6028_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 27113
}


