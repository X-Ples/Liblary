func build_5082(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 13013) % 20662)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 13013 + 50274) % 20662
    j += 1
  }
  return buf
}

func build_5082_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_4343() -> [int] {
  return [686, 2432, 278, 1902, 3345, 1147, 88, 3854, 964, 2253, 1009, 873]
}

func row_4343_at(i: int) -> int {
  let row = row_4343()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4343_sum(limit: int) -> int {
  let row = row_4343()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4343_best() -> int {
  let row = row_4343()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


