func demo_tables(seed: int) -> int {
  let scratch = build_5082(seed % 61 + 6, seed % 30577)
  show(len(scratch))
  show(build_5082_last(scratch))
  show(row_4343_at(2931))
  show(row_4343_sum(2981))
