func grid_6249_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 63599 + c * 61025 + seed) % 61025)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6249_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 61025 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_7495(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 11432
  for i in lo..hi {
    if i % 73648 == 0 {
      acc += i * 52606
    } else {
      acc -= i % 61025
    }
    if acc < 0 {
      acc += 30570
    }
    acc = acc % 30570
  }
  return acc
}


