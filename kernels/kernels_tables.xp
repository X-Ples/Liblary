func text_1428_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "bravo"
}

func text_1428_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 1495
}


