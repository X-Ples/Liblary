func sweep_2909(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 77812
  for i in lo..hi {
    if i % 79014 == 0 {
      acc += i * 79442
    } else {
      acc -= i % 50529
    }
    if acc < 0 {
      acc += 84002
    }
    acc = acc % 84002
  }
  return acc
}


