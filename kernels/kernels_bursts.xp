func build_3281(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 50529) % 52427)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 50529 + 50529) % 52427
    j += 1
  }
  return buf
}

func build_3281_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_4213(data: [int], seed: int) -> int {
  let acc = seed % 65221
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 12325 + data[i] + i) % 65221
    i += 1
  }
  return acc
}

func scan_4213_span(data: [int], seed: int) -> int {
  let acc = scan_4213(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 12325
}


