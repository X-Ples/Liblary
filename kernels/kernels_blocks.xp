func sweep_1182(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10546
  for i in lo..hi {
    if i % 35203 == 0 {
      acc += i * 65081
    } else {
      acc -= i % 6932
    }
    if acc < 0 {
      acc += 49581
    }
    acc = acc % 49581
  }
  return acc
}


