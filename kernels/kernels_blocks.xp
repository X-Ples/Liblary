func scan_8475(data: [int], seed: int) -> int {
  let acc = seed % 8301
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 27736 + data[i] + i) % 8301
    i += 1
  }
  return acc
}

func scan_8475_span(data: [int], seed: int) -> int {
  let acc = scan_8475(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 27736
}


func build_5327(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 8301) % 55380)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 8301 + 94519) % 55380
    j += 1
  }
  return buf
}

func build_5327_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


