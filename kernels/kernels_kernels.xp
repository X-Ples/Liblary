func check_3713(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 97664 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 36942) % 52401
    i += 1
  }
  return Ok(acc)
}

func check_3713_chain(n: int) -> int {
  let picked = check_3713(n)?
  return picked % 52401
}


