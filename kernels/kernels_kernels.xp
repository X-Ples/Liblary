func text_8092_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 89688
    i += 1
  }
  return acc % 89688
}

func text_8092_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "bravo"
}

func text_8092_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 10776
}


