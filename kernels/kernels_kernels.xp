func row_170() -> [int] {
  return [3381, 1004, 2147, 2670, 2836, 1024, 716, 1106, 3540, 2618, 2517, 3223, 34, 1677, 969, 3386]
}

func row_170_at(i: int) -> int {
  let row = row_170()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_170_sum(limit: int) -> int {
  let row = row_170()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_170_best() -> int {
  let row = row_170()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


