func grid_7014_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 3009 + c * 35505 + seed) % 35505)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7014_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 35505 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func demo_kernels(seed: int) -> int {
  let scratch = build_2141(seed % 61 + 6, seed % 31086)
  show(len(scratch))
  show(build_2141_last(scratch))
  show(order_305_find(scratch, 2144))
  show(order_4172_find(scratch, 446))
  show(gate_4047(3482, 105, 3639))
  return seed % 32735
}
