func gate_4047(a: int, b: int, c: int) -> bool {
  return a > 97664 && (b < 35722 || c == 35505)
}

func gate_4047_score(a: int, b: int, c: int) -> int {
  guard gate_4047(a, b, c) else {
    return 0
  }
  return (a % 35722) * 35505 + b
}


