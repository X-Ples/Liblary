func check_6943(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 42588 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 8165) % 71717
    i += 1
  }
  return Ok(acc)
}

func check_6943_chain(n: int) -> int {
  let picked = check_6943(n)?
  return picked % 71717
}


