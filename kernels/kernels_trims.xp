func sweep_1689(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 48363
  for i in lo..hi {
    if i % 2483 == 0 {
      acc += i * 95852
    } else {
      acc -= i % 11021
    }
    if acc < 0 {
      acc += 8165
    }
    acc = acc % 8165
  }
  return acc
}


