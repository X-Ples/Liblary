func demo_trims(seed: int) -> int {
  let scratch = build_4481(seed % 61 + 6, seed % 55770)
  show(len(scratch))
  show(build_4481_last(scratch))
  show(scan_3585(scratch, 269))
  show(scan_3585_span(scratch, 1357))
  show(order_9131_find(scratch, 3572))
  return seed % 31716
}
