func sweep_6798(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 41497
  for i in lo..hi {
    if i % 5357 == 0 {
      acc += i * 25689
    } else {
      acc -= i % 14398
    }
    if acc < 0 {
      acc += 76211
    }
    acc = acc % 76211
  }
  return acc
}


