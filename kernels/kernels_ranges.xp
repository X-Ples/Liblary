func check_8050(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 54157 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 42411) % 76211
    i += 1
  }
  return Ok(acc)
}

func check_8050_chain(n: int) -> int {
  let picked = check_8050(n)?
  return picked % 76211
}


