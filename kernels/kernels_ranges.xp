const K0 = 16681
const K1 = 15471
const K2 = 148
const K3 = 38805
const K4 = 5357
const K5 = 40010
const K6 = 45965

func gate_8136(a: int, b: int, c: int) -> bool {
  return a > 42411 && (b < 148 || c == 28861)
}

func gate_8136_score(a: int, b: int, c: int) -> int {
  guard gate_8136(a, b, c) else {
    return 0
  }
  return (a % 148) * 28861 + b
}


func build_7161(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 88426) % 41497)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 88426 + 88426) % 41497
    j += 1
  }
  return buf
}

func build_7161_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_7716(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7716_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func scan_6504(data: [int], seed: int) -> int {
  let acc = seed % 11726
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 15471 + data[i] + i) % 11726
    i += 1
  }
  return acc
}

func scan_6504_span(data: [int], seed: int) -> int {
  let acc = scan_6504(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 15471
}


func curve_7597_clamp(v: f64) -> f64 {
  guard v >= 9480.0 else {
    return 9480.0
  }
  guard v <= 30863.0 else {
    return 30863.0
  }
  return v
}

func curve_7597_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7597_clamp(t)
  return p + (q - p) * k
}

func curve_7597_ease(t: f64) -> f64 {
  let k = curve_7597_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7597_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


