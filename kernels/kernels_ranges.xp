func demo_ranges(seed: int) -> int {
  let scratch = build_7161(seed % 61 + 6, seed % 5357)
  show(len(scratch))
  show(gate_8136(2466, 509, 2047))
  show(gate_8136_score(1791, 903, 3786))
  show(build_7161_last(scratch))
  show(order_7716_find(scratch, 3822))
  show(scan_6504(scratch, 2913))
  return seed % 25689
}
