func demo_ratchets(seed: int) -> int {
  let scratch = build_9711(seed % 61 + 6, seed % 71529)
  show(len(scratch))
  show(build_9711_last(scratch))
  show(text_9865_weight("mesa"))
  show(text_9865_label(1402))
  show(text_9865_has("harbor"))
  return seed % 59750
}
