func build_9711(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 15484) % 81647)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 15484 + 44179) % 81647
    j += 1
  }
  return buf
}

func build_9711_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_7805_clamp(v: f64) -> f64 {
  guard v >= 15233.0 else {
    return 15233.0
  }
  guard v <= 15484.0 else {
    return 15484.0
  }
  return v
}

func curve_7805_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7805_clamp(t)
  return p + (q - p) * k
}

func curve_7805_ease(t: f64) -> f64 {
  let k = curve_7805_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7805_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_9865_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 23111
    i += 1
  }
  return acc % 23111
}

func text_9865_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "kilo"
}

func text_9865_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 19189
}


func grid_6627_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 6652 + c * 81647 + seed) % 81647)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6627_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 81647 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_2322(a: int, b: int, c: int) -> bool {
  return a > 3754 && (b < 1891 || c == 42584)
}

func gate_2322_score(a: int, b: int, c: int) -> int {
  guard gate_2322(a, b, c) else {
    return 0
  }
  return (a % 1891) * 42584 + b
}


func order_1844(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1844_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func row_4835() -> [int] {
  return [2810, 3607, 1338, 1947, 1403, 1038, 2748, 1026, 867, 56, 1263, 2498, 3342, 3113, 1118]
}

func row_4835_at(i: int) -> int {
  let row = row_4835()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4835_sum(limit: int) -> int {
  let row = row_4835()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4835_best() -> int {
  let row = row_4835()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


