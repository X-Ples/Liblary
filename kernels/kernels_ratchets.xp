func check_5108(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 15484 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 64220) % 88222
    i += 1
  }
  return Ok(acc)
}

func check_5108_chain(n: int) -> int {
  let picked = check_5108(n)?
  return picked % 88222
}


