func row_9115() -> [int] {
  return [251, 3064, 216, 3936, 1906, 269, 87, 3891, 3066, 1029, 2879, 798, 3794, 3194, 1694, 2414, 1403, 411]
}

func row_9115_at(i: int) -> int {
  let row = row_9115()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9115_sum(limit: int) -> int {
  let row = row_9115()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9115_best() -> int {
  let row = row_9115()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


