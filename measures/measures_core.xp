func scan_8020(data: [int], seed: int) -> int {
  let acc = seed % 8818
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 34018 + data[i] + i) % 8818
    i += 1
  }
  return acc
}

func scan_8020_span(data: [int], seed: int) -> int {
  let acc = scan_8020(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 34018
}


func curve_1241_clamp(v: f64) -> f64 {
  guard v >= 10030.0 else {
    return 10030.0
  }
  guard v <= 22833.0 else {
    return 22833.0
  }
  return v
}

func curve_1241_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1241_clamp(t)
  return p + (q - p) * k
}

func curve_1241_ease(t: f64) -> f64 {
  let k = curve_1241_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1241_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


