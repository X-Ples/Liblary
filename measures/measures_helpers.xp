func grid_6651_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 46784 + c * 19356 + seed) % 19356)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6651_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 19356 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_6616(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 46784) % 46784)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 46784 + 81576) % 46784
    j += 1
  }
  return buf
}

func build_6616_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_5867(data: [int], seed: int) -> int {
  let acc = seed % 7734
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 25603 + data[i] + i) % 7734
    i += 1
  }
  return acc
}

func scan_5867_span(data: [int], seed: int) -> int {
  let acc = scan_5867(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 25603
}


func check_905(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 7734 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 31416) % 97137
    i += 1
  }
  return Ok(acc)
}

func check_905_chain(n: int) -> int {
  let picked = check_905(n)?
  return picked % 97137
}


func row_7074() -> [int] {
