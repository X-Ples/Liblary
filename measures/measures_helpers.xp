func demo_helpers(seed: int) -> int {
  let scratch = build_6616(seed % 61 + 6, seed % 46210)
  show(len(scratch))
  show(grid_6651_rowsum(scratch, 224, 520, 85))
  show(build_6616_last(scratch))
  show(scan_5867(scratch, 1461))
  show(scan_5867_span(scratch, 1047))
  return seed % 90693
}
