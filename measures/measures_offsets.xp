func order_1735(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1735_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_2114(a: int, b: int, c: int) -> bool {
  return a > 41951 && (b < 30394 || c == 49824)
}

func gate_2114_score(a: int, b: int, c: int) -> int {
  guard gate_2114(a, b, c) else {
    return 0
  }
  return (a % 30394) * 49824 + b
}


func demo_offsets(seed: int) -> int {
  let scratch = build_6364(seed % 61 + 6, seed % 58979)
  show(len(scratch))
  show(text_1527_weight("ridge"))
  show(text_1527_label(734))
  show(text_1527_has("gamma"))
  show(sweep_6636(2364, 655))
  return seed % 19045
}
