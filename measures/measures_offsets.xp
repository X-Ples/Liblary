func text_1527_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 24181
    i += 1
  }
  return acc % 24181
}

func text_1527_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "mesa"
}

func text_1527_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 63384
}


func sweep_6636(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 36767
  for i in lo..hi {
    if i % 12586 == 0 {
      acc += i * 19045
    } else {
      acc -= i % 30394
    }
    if acc < 0 {
      acc += 72295
    }
    acc = acc % 72295
  }
  return acc
}


