func check_2227(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 12164 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 62524) % 37270
    i += 1
  }
  return Ok(acc)
}

func check_2227_chain(n: int) -> int {
  let picked = check_2227(n)?
  return picked % 37270
}


