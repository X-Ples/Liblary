func demo_vectors2(seed: int) -> int {
  let scratch = build_4855(seed % 61 + 6, seed % 48173)
  show(len(scratch))
  show(build_4855_last(scratch))
  show(build_2722_last(scratch))
  show(check_2227_chain(1684))
  show(check_7730_chain(1892))
  return seed % 41855
}
