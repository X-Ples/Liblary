func sweep_8828(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 62524
  for i in lo..hi {
    if i % 11317 == 0 {
      acc += i * 29496
    } else {
      acc -= i % 13519
    }
    if acc < 0 {
      acc += 12164
    }
    acc = acc % 12164
  }
  return acc
}


func curve_699_clamp(v: f64) -> f64 {
  guard v >= 31884.0 else {
    return 31884.0
  }
  guard v <= 92019.0 else {
    return 92019.0
  }
  return v
}

func curve_699_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_699_clamp(t)
  return p + (q - p) * k
}

func curve_699_ease(t: f64) -> f64 {
  let k = curve_699_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_699_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


