func grid_1874_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 41855 + c * 62524 + seed) % 62524)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1874_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 62524 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_1986_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 208
    i += 1
  }
  return acc % 208
}

func text_1986_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "bravo"
}

func text_1986_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 92019
}


