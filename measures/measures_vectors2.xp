func scan_2827(data: [int], seed: int) -> int {
  let acc = seed % 39350
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 12658 + data[i] + i) % 39350
    i += 1
  }
  return acc
}

func scan_2827_span(data: [int], seed: int) -> int {
  let acc = scan_2827(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 12658
}


