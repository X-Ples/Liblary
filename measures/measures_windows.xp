func sweep_3701(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 8277
  for i in lo..hi {
    if i % 93296 == 0 {
      acc += i * 837
    } else {
      acc -= i % 82254
    }
    if acc < 0 {
      acc += 95243
    }
    acc = acc % 95243
  }
  return acc
}


