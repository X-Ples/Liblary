func demo_windows(seed: int) -> int {
  let scratch = build_2983(seed % 61 + 6, seed % 53618)
  show(len(scratch))
  show(build_2983_last(scratch))
  show(gate_7668(940, 914, 2073))
  show(gate_7668_score(154, 2204, 2984))
  show(order_8148_find(scratch, 2048))
  return seed % 58495
}
