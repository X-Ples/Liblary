func build_2983(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 10618) % 83714)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 10618 + 63934) % 83714
    j += 1
  }
  return buf
}

func build_2983_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_7668(a: int, b: int, c: int) -> bool {
  return a > 10618 && (b < 58495 || c == 12018)
}

func gate_7668_score(a: int, b: int, c: int) -> int {
  guard gate_7668(a, b, c) else {
    return 0
  }
  return (a % 58495) * 12018 + b
}


func order_8148(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8148_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_5983_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 8277
    i += 1
  }
  return acc % 8277
}

func text_5983_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "delta"
}

func text_5983_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 10618
}


func scan_1865(data: [int], seed: int) -> int {
  let acc = seed % 23890
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 24077 + data[i] + i) % 23890
    i += 1
  }
  return acc
}

