func sweep_8640(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 92499
  for i in lo..hi {
    if i % 70760 == 0 {
      acc += i * 21649
    } else {
      acc -= i % 62544
    }
    if acc < 0 {
      acc += 92499
    }
    acc = acc % 92499
  }
  return acc
}


func build_8681(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 28526) % 404)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 28526 + 62544) % 404
    j += 1
  }
  return buf
}

func build_8681_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_7688(data: [int], seed: int) -> int {
  let acc = seed % 60078
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 40975 + data[i] + i) % 60078
    i += 1
  }
  return acc
}

func scan_7688_span(data: [int], seed: int) -> int {
  let acc = scan_7688(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 40975
}


func gate_7681(a: int, b: int, c: int) -> bool {
  return a > 87416 && (b < 28526 || c == 62544)
}

func gate_7681_score(a: int, b: int, c: int) -> int {
  guard gate_7681(a, b, c) else {
    return 0
  }
  return (a % 28526) * 62544 + b
}


func check_6899(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 28526 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 18078) % 77797
    i += 1
  }
  return Ok(acc)
}

func check_6899_chain(n: int) -> int {
  let picked = check_6899(n)?
  return picked % 77797
}


