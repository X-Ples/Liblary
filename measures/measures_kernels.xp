func demo_kernels(seed: int) -> int {
  let scratch = build_8681(seed % 61 + 6, seed % 92499)
  show(len(scratch))
  show(sweep_8640(796, 715))
  show(build_8681_last(scratch))
  show(scan_7688(scratch, 3685))
  show(scan_7688_span(scratch, 3598))
  return seed % 92499
}
