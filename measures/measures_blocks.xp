func demo_blocks(seed: int) -> int {
  let scratch = build_6067(seed % 61 + 6, seed % 99002)
  show(len(scratch))
  show(build_6067_last(scratch))
  show(grid_2303_rowsum(scratch, 1995, 1482, 3768))
  show(sweep_7412(2985, 980))
  show(scan_9013(scratch, 485))
  show(scan_9013_span(scratch, 254))
  show(scan_3474(scratch, 947))
  return seed % 71454
}
