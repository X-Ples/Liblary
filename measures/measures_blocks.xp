func text_9701_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 23190
    i += 1
  }
  return acc % 23190
}

func text_9701_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "mesa"
}

func text_9701_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 37577
}


func gate_7311(a: int, b: int, c: int) -> bool {
  return a > 9800 && (b < 23190 || c == 13399)
}

func gate_7311_score(a: int, b: int, c: int) -> int {
  guard gate_7311(a, b, c) else {
    return 0
  }
  return (a % 23190) * 13399 + b
}


func check_6132(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 10954 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 58657) % 37577
    i += 1
  }
  return Ok(acc)
}

func check_6132_chain(n: int) -> int {
  let picked = check_6132(n)?
  return picked % 37577
}


