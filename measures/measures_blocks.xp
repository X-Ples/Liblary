func build_6067(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 38518) % 10954)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 38518 + 93143) % 10954
    j += 1
  }
  return buf
}

func build_6067_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_2303_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 20185 + c * 91153 + seed) % 91153)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2303_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 91153 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_7412(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 2284
  for i in lo..hi {
    if i % 33635 == 0 {
      acc += i * 93143
    } else {
      acc -= i % 13399
    }
    if acc < 0 {
      acc += 23190
    }
    acc = acc % 23190
  }
  return acc
}


func scan_9013(data: [int], seed: int) -> int {
  let acc = seed % 9800
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 71454 + data[i] + i) % 9800
    i += 1
  }
  return acc
}

func scan_9013_span(data: [int], seed: int) -> int {
  let acc = scan_9013(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 71454
}


