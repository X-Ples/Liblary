func text_1131_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 92203
    i += 1
  }
  return acc % 92203
}

func text_1131_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "ion"
}

func text_1131_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 11729
}


