func check_7519(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 65793 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 66234) % 99811
    i += 1
  }
  return Ok(acc)
}

func check_7519_chain(n: int) -> int {
  let picked = check_7519(n)?
  return picked % 99811
}


