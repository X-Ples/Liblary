func demo_shapes(seed: int) -> int {
  let scratch = build_5300(seed % 61 + 6, seed % 14131)
  show(len(scratch))
  show(build_5300_last(scratch))
  show(order_3002_find(scratch, 2390))
  show(row_8446_at(2673))
  show(row_8446_sum(2646))
  show(row_8446_best())
  return seed % 30181
}
