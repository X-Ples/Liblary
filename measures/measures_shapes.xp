const K0 = 66234
const K1 = 50473
const K2 = 11896
const K3 = 85086
const K4 = 65793
const K5 = 41338
const K6 = 11896
const K7 = 92203

func build_5300(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 26231) % 85086)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 26231 + 41338) % 85086
    j += 1
  }
  return buf
}

func build_5300_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_3002(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3002_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func curve_8685_clamp(v: f64) -> f64 {
  guard v >= 34369.0 else {
    return 34369.0
  }
  guard v <= 55597.0 else {
    return 55597.0
  }
  return v
}

func curve_8685_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8685_clamp(t)
  return p + (q - p) * k
}

func curve_8685_ease(t: f64) -> f64 {
  let k = curve_8685_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8685_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_8446() -> [int] {
  return [802, 3806, 1420, 1869, 2575, 3489, 1482, 2532, 1734, 2479, 735, 519]
}

func row_8446_at(i: int) -> int {
  let row = row_8446()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8446_sum(limit: int) -> int {
  let row = row_8446()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8446_best() -> int {
  let row = row_8446()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_5953(a: int, b: int, c: int) -> bool {
  return a > 31948 && (b < 41967 || c == 31948)
}

func gate_5953_score(a: int, b: int, c: int) -> int {
  guard gate_5953(a, b, c) else {
    return 0
  }
  return (a % 41967) * 31948 + b
}


