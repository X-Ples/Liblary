func scan_6560(data: [int], seed: int) -> int {
  let acc = seed % 55597
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 65959 + data[i] + i) % 55597
    i += 1
  }
  return acc
}

func scan_6560_span(data: [int], seed: int) -> int {
  let acc = scan_6560(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 65959
}


