func demo_ratchets(seed: int) -> int {
  let scratch = build_7836(seed % 61 + 6, seed % 39464)
  show(len(scratch))
  show(build_7836_last(scratch))
  show(grid_3005_rowsum(scratch, 3816, 861, 182))
  show(check_3051_chain(1511))
  show(order_9973_find(scratch, 2519))
  return seed % 7996
}
