func check_7477(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 63363 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 98825) % 75592
    i += 1
  }
  return Ok(acc)
}

func check_7477_chain(n: int) -> int {
  let picked = check_7477(n)?
  return picked % 75592
}


