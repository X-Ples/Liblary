func curve_9584_clamp(v: f64) -> f64 {
  guard v >= 19740.0 else {
    return 19740.0
  }
  guard v <= 83060.0 else {
    return 83060.0
  }
  return v
}

func curve_9584_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9584_clamp(t)
  return p + (q - p) * k
}

func curve_9584_ease(t: f64) -> f64 {
  let k = curve_9584_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9584_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_9888(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 28983) % 61862)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 28983 + 19740) % 61862
    j += 1
  }
  return buf
}

func build_9888_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_417(data: [int], seed: int) -> int {
  let acc = seed % 15562
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 25715 + data[i] + i) % 15562
    i += 1
  }
  return acc
}

func scan_417_span(data: [int], seed: int) -> int {
  let acc = scan_417(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 25715
}


func text_7579_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 64624
    i += 1
  }
  return acc % 64624
}

func text_7579_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "jetty"
}

func text_7579_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 10561
}


