func demo_reductions(seed: int) -> int {
  let scratch = build_9888(seed % 61 + 6, seed % 66459)
  show(len(scratch))
  show(build_9888_last(scratch))
  show(scan_417(scratch, 2210))
  show(scan_417_span(scratch, 3379))
  return seed % 81284
}
