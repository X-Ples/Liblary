  while i < n {
    acc = (acc * 74625 + data[i] + i) % 44635
    i += 1
  }
  return acc
}

func scan_7485_span(data: [int], seed: int) -> int {
  let acc = scan_7485(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 74625
}


func curve_3507_clamp(v: f64) -> f64 {
  guard v >= 13466.0 else {
    return 13466.0
  }
  guard v <= 40690.0 else {
    return 40690.0
  }
  return v
}

func curve_3507_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3507_clamp(t)
  return p + (q - p) * k
}

func curve_3507_ease(t: f64) -> f64 {
  let k = curve_3507_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3507_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


