func demo_tables(seed: int) -> int {
  let scratch = build_7317(seed % 61 + 6, seed % 33059)
  show(len(scratch))
  show(check_6338_chain(2426))
  show(build_7317_last(scratch))
  show(build_5134_last(scratch))
  show(order_6723_find(scratch, 2980))
  return seed % 49587
}
