func check_6338(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 44635 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 21033) % 49812
    i += 1
  }
  return Ok(acc)
}

func check_6338_chain(n: int) -> int {
  let picked = check_6338(n)?
  return picked % 49812
}


