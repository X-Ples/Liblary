func check_8102(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 33845 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 90356) % 56220
    i += 1
  }
  return Ok(acc)
}

func check_8102_chain(n: int) -> int {
  let picked = check_8102(n)?
  return picked % 56220
}


func grid_4592_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 35930 + c * 55070 + seed) % 55070)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4592_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 55070 == want {
      total += acc
    }
    r += 1
  }
  return total
}


