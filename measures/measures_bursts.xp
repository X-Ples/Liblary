func build_1985(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 73667) % 45695)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 73667 + 21909) % 45695
    j += 1
  }
  return buf
}

func build_1985_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_1177(data: [int], seed: int) -> int {
  let acc = seed % 22438
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 90356 + data[i] + i) % 22438
    i += 1
  }
  return acc
}

func scan_1177_span(data: [int], seed: int) -> int {
  let acc = scan_1177(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 90356
}


func gate_3761(a: int, b: int, c: int) -> bool {
  return a > 75215 && (b < 60229 || c == 67963)
}

func gate_3761_score(a: int, b: int, c: int) -> int {
  guard gate_3761(a, b, c) else {
    return 0
  }
  return (a % 60229) * 67963 + b
}


func text_5964_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 58561
    i += 1
  }
  return acc % 58561
}

func text_5964_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "sigma"
}

func text_5964_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 75017
}


