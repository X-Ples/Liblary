func demo_bursts(seed: int) -> int {
  let scratch = build_1985(seed % 61 + 6, seed % 2692)
  show(len(scratch))
  show(build_1985_last(scratch))
  show(scan_1177(scratch, 2955))
  show(scan_1177_span(scratch, 2256))
  show(gate_3761(2982, 3336, 591))
  show(gate_3761_score(437, 1089, 2228))
  return seed % 2692
}
