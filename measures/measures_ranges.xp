func demo_ranges(seed: int) -> int {
  let scratch = build_2964(seed % 61 + 6, seed % 67235)
  show(len(scratch))
  show(build_2964_last(scratch))
  show(check_4932_chain(3662))
  show(row_3760_at(1817))
  show(row_3760_sum(722))
  return seed % 89692
}
