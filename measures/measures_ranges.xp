func sweep_4861(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 65176
  for i in lo..hi {
    if i % 92694 == 0 {
      acc += i * 27593
    } else {
      acc -= i % 67235
    }
    if acc < 0 {
      acc += 18347
    }
    acc = acc % 18347
  }
  return acc
}


