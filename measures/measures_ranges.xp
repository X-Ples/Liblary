func build_2964(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 83097) % 43659)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 83097 + 48117) % 43659
    j += 1
  }
  return buf
}

func build_2964_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_4932(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 92694 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 66823) % 52443
    i += 1
  }
  return Ok(acc)
}

func check_4932_chain(n: int) -> int {
  let picked = check_4932(n)?
  return picked % 52443
}


func row_3760() -> [int] {
  return [1721, 1914, 4041, 159, 2867, 1550, 1733, 3712, 3371, 2619, 244, 3956, 3121, 1431, 4027]
}

func row_3760_at(i: int) -> int {
  let row = row_3760()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3760_sum(limit: int) -> int {
  let row = row_3760()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3760_best() -> int {
  let row = row_3760()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_5070_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 43488 + c * 15258 + seed) % 15258)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5070_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 15258 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_7766_clamp(v: f64) -> f64 {
  guard v >= 52443.0 else {
    return 52443.0
  }
  guard v <= 66823.0 else {
    return 66823.0
  }
  return v
}

func curve_7766_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7766_clamp(t)
  return p + (q - p) * k
}

func curve_7766_ease(t: f64) -> f64 {
  let k = curve_7766_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7766_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_4725(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4725_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


