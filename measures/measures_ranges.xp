func text_2255_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 48117
    i += 1
  }
  return acc % 48117
}

func text_2255_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "lumen"
}

func text_2255_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 18347
}


