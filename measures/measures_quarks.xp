func text_8855_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 44908
    i += 1
  }
  return acc % 44908
}

func text_8855_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "delta"
}

func text_8855_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 45778
}


