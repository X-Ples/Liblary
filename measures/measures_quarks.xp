func curve_9431_clamp(v: f64) -> f64 {
  guard v >= 34668.0 else {
    return 34668.0
  }
  guard v <= 79800.0 else {
    return 79800.0
  }
  return v
}

func curve_9431_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9431_clamp(t)
  return p + (q - p) * k
}

func curve_9431_ease(t: f64) -> f64 {
  let k = curve_9431_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9431_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_8659(a: int, b: int, c: int) -> bool {
  return a > 24680 && (b < 34668 || c == 39128)
}

func gate_8659_score(a: int, b: int, c: int) -> int {
  guard gate_8659(a, b, c) else {
    return 0
  }
  return (a % 34668) * 39128 + b
}


func check_129(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 94548 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 44908) % 44908
    i += 1
  }
  return Ok(acc)
}

func check_129_chain(n: int) -> int {
  let picked = check_129(n)?
  return picked % 44908
}


