func sweep_5536(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 86493
  for i in lo..hi {
    if i % 43476 == 0 {
      acc += i * 94548
    } else {
      acc -= i % 9210
    }
    if acc < 0 {
      acc += 39128
    }
    acc = acc % 39128
  }
  return acc
}


