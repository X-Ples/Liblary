func order_5667(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5667_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func demo_quarks(seed: int) -> int {
  let scratch = build_8490(seed % 61 + 6, seed % 44908)
  show(len(scratch))
  show(build_8490_last(scratch))
  show(grid_5649_rowsum(scratch, 3661, 2413, 3736))
  show(build_1245_last(scratch))
  show(gate_8659(2942, 555, 1940))
  show(gate_8659_score(3990, 31, 2590))
  return seed % 58646
}
