func row_7250() -> [int] {
  return [2235, 3849, 3324, 492, 3715, 2297, 1177, 1662, 923, 1431, 2112, 4049, 3801, 3217]
}

func row_7250_at(i: int) -> int {
  let row = row_7250()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7250_sum(limit: int) -> int {
  let row = row_7250()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7250_best() -> int {
  let row = row_7250()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_1634(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 30412) % 57437)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 30412 + 88951) % 57437
    j += 1
  }
  return buf
}

func build_1634_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_3667(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 73274
  for i in lo..hi {
    if i % 87176 == 0 {
      acc += i * 52859
    } else {
      acc -= i % 90
    }
    if acc < 0 {
      acc += 89547
    }
    acc = acc % 89547
  }
  return acc
}


func order_8768(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8768_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_724_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 90
    i += 1
  }
  return acc % 90
}

