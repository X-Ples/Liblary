func demo_counters(seed: int) -> int {
  let scratch = build_7306(seed % 61 + 6, seed % 7087)
  show(len(scratch))
  show(build_7306_last(scratch))
  show(scan_8361(scratch, 3196))
  show(scan_8361_span(scratch, 2521))
  show(scan_8033(scratch, 240))
  show(scan_8033_span(scratch, 2561))
  return seed % 54891
}
