func build_7306(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 3134) % 74536)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 3134 + 97663) % 74536
    j += 1
  }
  return buf
}

func build_7306_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_8361(data: [int], seed: int) -> int {
  let acc = seed % 99575
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 99575 + data[i] + i) % 99575
    i += 1
  }
  return acc
}

func scan_8361_span(data: [int], seed: int) -> int {
  let acc = scan_8361(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 99575
}


func curve_376_clamp(v: f64) -> f64 {
  guard v >= 7087.0 else {
    return 7087.0
  }
  guard v <= 80348.0 else {
    return 80348.0
  }
  return v
}

func curve_376_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_376_clamp(t)
  return p + (q - p) * k
}

func curve_376_ease(t: f64) -> f64 {
  let k = curve_376_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_376_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


