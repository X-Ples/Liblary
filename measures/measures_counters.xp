func sweep_2025(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 12232
  for i in lo..hi {
    if i % 12232 == 0 {
      acc += i * 12232
    } else {
      acc -= i % 74536
    }
    if acc < 0 {
      acc += 80493
    }
    acc = acc % 80493
  }
  return acc
}


func check_1437(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 99575 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 4944) % 27465
    i += 1
  }
  return Ok(acc)
}

func check_1437_chain(n: int) -> int {
  let picked = check_1437(n)?
  return picked % 27465
}


