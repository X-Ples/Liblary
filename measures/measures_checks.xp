const K0 = 61300
const K1 = 80607
const K2 = 42962
const K3 = 97016
const K4 = 13977
const K5 = 31364

func build_4241(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 13977) % 68431)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 13977 + 3130) % 68431
    j += 1
  }
  return buf
}

func build_4241_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_7053(a: int, b: int, c: int) -> bool {
  return a > 31364 && (b < 42962 || c == 97016)
}

func gate_7053_score(a: int, b: int, c: int) -> int {
  guard gate_7053(a, b, c) else {
    return 0
  }
  return (a % 42962) * 97016 + b
}


func curve_3145_clamp(v: f64) -> f64 {
  guard v >= 3130.0 else {
    return 3130.0
  }
  guard v <= 67673.0 else {
    return 67673.0
  }
  return v
}

func curve_3145_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3145_clamp(t)
  return p + (q - p) * k
}

func curve_3145_ease(t: f64) -> f64 {
  let k = curve_3145_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3145_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_4266() -> [int] {
  return [3556, 1073, 1639, 3748, 296, 823, 3535, 116, 2716, 1103, 797, 1531, 1958, 1317, 1524, 3333, 104, 1691, 3073, 2608, 2819]
}

func row_4266_at(i: int) -> int {
  let row = row_4266()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4266_sum(limit: int) -> int {
  let row = row_4266()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4266_best() -> int {
  let row = row_4266()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_7621_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 61300 + c * 3130 + seed) % 3130)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7621_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 3130 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_9060(data: [int], seed: int) -> int {
  let acc = seed % 43484
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 43484 + data[i] + i) % 43484
    i += 1
  }
  return acc
}

func scan_9060_span(data: [int], seed: int) -> int {
  let acc = scan_9060(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 43484
}


func sweep_2711(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 13977
  for i in lo..hi {
    if i % 23795 == 0 {
      acc += i * 81569
    } else {
      acc -= i % 59535
    }
    if acc < 0 {
      acc += 13977
    }
    acc = acc % 13977
  }
  return acc
}


func text_515_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 97016
    i += 1
  }
  return acc % 97016
}

func text_515_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "quartz"
}

func text_515_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 43484
}


