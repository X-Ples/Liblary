func check_8026(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 80607 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 45990) % 13977
    i += 1
  }
  return Ok(acc)
}

func check_8026_chain(n: int) -> int {
  let picked = check_8026(n)?
  return picked % 13977
}


