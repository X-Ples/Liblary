func demo_checks(seed: int) -> int {
  let scratch = build_4241(seed % 61 + 6, seed % 93264)
  show(len(scratch))
  show(build_4241_last(scratch))
  show(gate_7053(418, 175, 1238))
  show(gate_7053_score(2699, 664, 3741))
  show(row_4266_at(3053))
  return seed % 81569
}
