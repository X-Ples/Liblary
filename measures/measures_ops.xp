func text_2302_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 35874
    i += 1
  }
  return acc % 35874
}

func text_2302_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "delta"
}

func text_2302_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 26387
}


