func check_3788(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 78666 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 49114) % 42114
    i += 1
  }
  return Ok(acc)
}

func check_3788_chain(n: int) -> int {
  let picked = check_3788(n)?
  return picked % 42114
}


func gate_7541(a: int, b: int, c: int) -> bool {
  return a > 42114 && (b < 52999 || c == 64324)
}

func gate_7541_score(a: int, b: int, c: int) -> int {
  guard gate_7541(a, b, c) else {
    return 0
  }
  return (a % 52999) * 64324 + b
}


