func demo_ops(seed: int) -> int {
  let scratch = build_8632(seed % 61 + 6, seed % 77800)
  show(len(scratch))
  show(grid_9108_rowsum(scratch, 1035, 1937, 537))
  show(build_8632_last(scratch))
  show(order_7785_find(scratch, 1131))
  show(row_2330_at(254))
  return seed % 77800
}
