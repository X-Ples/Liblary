func row_5663() -> [int] {
  return [1316, 2094, 1906, 2684, 751, 2273, 1746, 2864, 125, 2452, 2683, 550, 3734, 3851, 2736, 508]
}

func row_5663_at(i: int) -> int {
  let row = row_5663()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5663_sum(limit: int) -> int {
  let row = row_5663()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5663_best() -> int {
  let row = row_5663()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


