func demo_signals(seed: int) -> int {
  let scratch = build_3384(seed % 61 + 6, seed % 21007)
  show(len(scratch))
  show(check_262_chain(1081))
  show(build_3384_last(scratch))
  show(order_6865_find(scratch, 2447))
  show(gate_5583(2408, 3714, 650))
  show(gate_5583_score(1798, 36, 3788))
  return seed % 47236
}
