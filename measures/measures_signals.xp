func check_262(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 97999 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 81579) % 38495
    i += 1
  }
  return Ok(acc)
}

func check_262_chain(n: int) -> int {
  let picked = check_262(n)?
  return picked % 38495
}


func build_3384(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 9953) % 21007)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 9953 + 13831) % 21007
    j += 1
  }
  return buf
}

func build_3384_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_6865(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6865_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_5583(a: int, b: int, c: int) -> bool {
  return a > 38495 && (b < 27613 || c == 13831)
}

func gate_5583_score(a: int, b: int, c: int) -> int {
  guard gate_5583(a, b, c) else {
    return 0
  }
  return (a % 27613) * 13831 + b
}


func grid_662_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 9953 + c * 81579 + seed) % 81579)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_662_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 81579 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_2551_clamp(v: f64) -> f64 {
  guard v >= 21007.0 else {
    return 21007.0
  }
  guard v <= 91685.0 else {
    return 91685.0
  }
  return v
}

func curve_2551_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2551_clamp(t)
  return p + (q - p) * k
}

func curve_2551_ease(t: f64) -> f64 {
  let k = curve_2551_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2551_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


