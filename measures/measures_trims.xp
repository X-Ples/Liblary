func demo_trims(seed: int) -> int {
  let scratch = build_1350(seed % 61 + 6, seed % 79487)
  show(len(scratch))
  show(sweep_3567(3585, 2432))
  show(build_1350_last(scratch))
  show(order_7144_find(scratch, 803))
  show(row_6240_at(2523))
  return seed % 21012
}
