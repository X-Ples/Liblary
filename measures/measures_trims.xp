func check_8449(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 15863 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 5741) % 54177
    i += 1
  }
  return Ok(acc)
}

func check_8449_chain(n: int) -> int {
  let picked = check_8449(n)?
  return picked % 54177
}


