func curve_7147_clamp(v: f64) -> f64 {
  guard v >= 25579.0 else {
    return 25579.0
  }
  guard v <= 95286.0 else {
    return 95286.0
  }
  return v
}

func curve_7147_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7147_clamp(t)
  return p + (q - p) * k
}

func curve_7147_ease(t: f64) -> f64 {
  let k = curve_7147_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7147_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_5430(a: int, b: int, c: int) -> bool {
  return a > 47320 && (b < 5741 || c == 77020)
}

func gate_5430_score(a: int, b: int, c: int) -> int {
  guard gate_5430(a, b, c) else {
    return 0
  }
  return (a % 5741) * 77020 + b
}


