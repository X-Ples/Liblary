func text_5869_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 95286
    i += 1
  }
  return acc % 95286
}

func text_5869_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "prism"
}

func text_5869_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 21012
}


