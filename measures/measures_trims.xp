func scan_834(data: [int], seed: int) -> int {
  let acc = seed % 21012
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 21012 + data[i] + i) % 21012
    i += 1
  }
  return acc
}

func scan_834_span(data: [int], seed: int) -> int {
  let acc = scan_834(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 21012
}


