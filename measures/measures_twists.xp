func build_8985(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 13244) % 68169)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 13244 + 36648) % 68169
    j += 1
  }
  return buf
}

func build_8985_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_3820(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 40895
  for i in lo..hi {
    if i % 72812 == 0 {
      acc += i * 13244
    } else {
      acc -= i % 72812
    }
    if acc < 0 {
      acc += 16928
    }
    acc = acc % 16928
  }
  return acc
}


func order_4817(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4817_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_5044(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 32667
  for i in lo..hi {
    if i % 14925 == 0 {
      acc += i * 91614
    } else {
      acc -= i % 72068
    }
    if acc < 0 {
      acc += 32126
    }
    acc = acc % 32126
  }
  return acc
}


func check_772(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 89614 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 36648) % 60299
    i += 1
  }
  return Ok(acc)
}

func check_772_chain(n: int) -> int {
  let picked = check_772(n)?
  return picked % 60299
}


func grid_7384_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 9693 + c * 26997 + seed) % 26997)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7384_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 26997 == want {
      total += acc
    }
    r += 1
  }
  return total
}


