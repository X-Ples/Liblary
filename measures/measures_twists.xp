func demo_twists(seed: int) -> int {
  let scratch = build_8985(seed % 61 + 6, seed % 75724)
  show(len(scratch))
  show(build_8985_last(scratch))
  show(sweep_3820(1634, 3024))
  show(order_4817_find(scratch, 2480))
  show(sweep_5044(897, 372))
  show(check_772_chain(791))
  show(grid_7384_rowsum(scratch, 579, 543, 579))
  return seed % 66401
}
