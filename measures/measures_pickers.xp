func build_7897(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 84275) % 70887)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 84275 + 94581) % 70887
    j += 1
  }
  return buf
}

func build_7897_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_6474_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 65405
    i += 1
  }
  return acc % 65405
}

func text_6474_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "quartz"
}

func text_6474_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 19032
}


