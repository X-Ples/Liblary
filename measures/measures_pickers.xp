func demo_pickers(seed: int) -> int {
  let scratch = build_7897(seed % 61 + 6, seed % 45638)
  show(len(scratch))
  show(build_7897_last(scratch))
  show(text_6474_weight("alpha"))
  show(text_6474_label(432))
  return seed % 59934
}
