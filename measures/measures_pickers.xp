func scan_9636(data: [int], seed: int) -> int {
  let acc = seed % 96796
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 96796 + data[i] + i) % 96796
    i += 1
  }
  return acc
}

func scan_9636_span(data: [int], seed: int) -> int {
  let acc = scan_9636(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 96796
}


