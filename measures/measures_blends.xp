func check_4625(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 80348 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 50816) % 25268
    i += 1
  }
  return Ok(acc)
}

func check_4625_chain(n: int) -> int {
  let picked = check_4625(n)?
  return picked % 25268
}


