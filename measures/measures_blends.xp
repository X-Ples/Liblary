const K0 = 51360
const K1 = 13887
const K2 = 85737
const K3 = 78120
const K4 = 41469
const K5 = 68180

func build_4046(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 50816) % 58524)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 50816 + 51360) % 58524
    j += 1
  }
  return buf
}

func build_4046_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_8043(data: [int], seed: int) -> int {
  let acc = seed % 2843
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 53977 + data[i] + i) % 2843
    i += 1
  }
  return acc
}

func scan_8043_span(data: [int], seed: int) -> int {
  let acc = scan_8043(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 53977
}


func grid_8526_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 89614 + c * 2843 + seed) % 2843)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8526_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 2843 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_5436(a: int, b: int, c: int) -> bool {
  return a > 41469 && (b < 58524 || c == 50816)
}

func gate_5436_score(a: int, b: int, c: int) -> int {
  guard gate_5436(a, b, c) else {
    return 0
  }
  return (a % 58524) * 50816 + b
}


func text_6803_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 80348
    i += 1
  }
  return acc % 80348
}

func text_6803_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "prism"
}

func text_6803_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 13887
}


func curve_3734_clamp(v: f64) -> f64 {
  guard v >= 25268.0 else {
    return 25268.0
  }
  guard v <= 78120.0 else {
    return 78120.0
  }
  return v
}

func curve_3734_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3734_clamp(t)
  return p + (q - p) * k
}

func curve_3734_ease(t: f64) -> f64 {
  let k = curve_3734_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3734_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


