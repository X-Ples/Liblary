func demo_blends(seed: int) -> int {
  let scratch = build_4046(seed % 61 + 6, seed % 85737)
  show(len(scratch))
  show(build_4046_last(scratch))
  show(scan_8043(scratch, 2096))
  show(scan_8043_span(scratch, 3648))
  show(grid_8526_rowsum(scratch, 1783, 2985, 2238))
  show(gate_5436(2587, 2648, 1067))
  show(gate_5436_score(219, 3740, 1084))
  return seed % 58524
}
