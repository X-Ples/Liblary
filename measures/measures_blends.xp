func row_4238() -> [int] {
  return [1260, 1033, 364, 2177, 3444, 172, 1066, 3594, 1692, 1255, 3, 3641, 3949, 115, 2496, 967, 278, 318, 4047]
}

func row_4238_at(i: int) -> int {
  let row = row_4238()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4238_sum(limit: int) -> int {
  let row = row_4238()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4238_best() -> int {
  let row = row_4238()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_8246(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 68180
  for i in lo..hi {
    if i % 20258 == 0 {
      acc += i * 9685
    } else {
      acc -= i % 2843
    }
    if acc < 0 {
      acc += 42801
    }
    acc = acc % 42801
  }
  return acc
}


