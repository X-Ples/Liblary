func check_417(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 93982 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 11108) % 48506
    i += 1
  }
  return Ok(acc)
}

func check_417_chain(n: int) -> int {
  let picked = check_417(n)?
  return picked % 48506
}


