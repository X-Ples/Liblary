func build_5826(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 88502) % 74597)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 88502 + 88502) % 74597
    j += 1
  }
  return buf
}

func build_5826_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_400_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 77223
    i += 1
  }
  return acc % 77223
}

func text_400_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "omega"
}

func text_400_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 93982
}


func grid_1131_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 22765 + c * 85988 + seed) % 85988)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1131_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 85988 == want {
      total += acc
    }
    r += 1
  }
  return total
}


