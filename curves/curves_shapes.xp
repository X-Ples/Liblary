func text_1985_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 84939
    i += 1
  }
  return acc % 84939
}

func text_1985_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "nova"
}

func text_1985_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 50907
}


func row_4357() -> [int] {
  return [2219, 651, 2639, 1685, 3947, 1447, 3295, 3296, 1927, 2712, 1819, 2025, 1229]
}

func row_4357_at(i: int) -> int {
  let row = row_4357()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4357_sum(limit: int) -> int {
  let row = row_4357()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4357_best() -> int {
  let row = row_4357()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_5158(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 79010) % 46719)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 79010 + 80119) % 46719
    j += 1
  }
  return buf
}

func build_5158_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_285_clamp(v: f64) -> f64 {
  guard v >= 19564.0 else {
    return 19564.0
  }
  guard v <= 43565.0 else {
    return 43565.0
  }
  return v
}

func curve_285_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_285_clamp(t)
  return p + (q - p) * k
}

func curve_285_ease(t: f64) -> f64 {
  let k = curve_285_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_285_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_8730_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 84498 + c * 84939 + seed) % 84939)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8730_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 84939 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_5994(data: [int], seed: int) -> int {
  let acc = seed % 80119
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 34571 + data[i] + i) % 80119
    i += 1
  }
  return acc
}

func scan_5994_span(data: [int], seed: int) -> int {
  let acc = scan_5994(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 34571
}


func order_5781(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5781_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


