func check_3710(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 7687 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 19564) % 21524
    i += 1
  }
  return Ok(acc)
}

func check_3710_chain(n: int) -> int {
  let picked = check_3710(n)?
  return picked % 21524
}


