func row_3795() -> [int] {
  return [2985, 725, 4088, 8, 3461, 3627, 3905, 1109, 3691, 2937, 3727]
}

func row_3795_at(i: int) -> int {
  let row = row_3795()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3795_sum(limit: int) -> int {
  let row = row_3795()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3795_best() -> int {
  let row = row_3795()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_3794(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 63458) % 3920)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 63458 + 54471) % 3920
    j += 1
  }
  return buf
}

func build_3794_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_3371_clamp(v: f64) -> f64 {
  guard v >= 33622.0 else {
    return 33622.0
  }
  guard v <= 51117.0 else {
    return 51117.0
  }
  return v
}

func curve_3371_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3371_clamp(t)
  return p + (q - p) * k
}

func curve_3371_ease(t: f64) -> f64 {
  let k = curve_3371_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3371_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_3152(data: [int], seed: int) -> int {
  let acc = seed % 13768
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 63458 + data[i] + i) % 13768
    i += 1
  }
  return acc
}

func scan_3152_span(data: [int], seed: int) -> int {
  let acc = scan_3152(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 63458
}


