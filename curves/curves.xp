func gate_3144(a: int, b: int, c: int) -> bool {
  return a > 80072 && (b < 80072 || c == 3920)
}

func gate_3144_score(a: int, b: int, c: int) -> int {
  guard gate_3144(a, b, c) else {
    return 0
  }
  return (a % 80072) * 3920 + b
}


func check_7156(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 80072 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 20054) % 57722
    i += 1
  }
  return Ok(acc)
}

func check_7156_chain(n: int) -> int {
  let picked = check_7156(n)?
  return picked % 57722
}


