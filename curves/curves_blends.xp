func demo_blends(seed: int) -> int {
  let scratch = build_3858(seed % 61 + 6, seed % 77779)
  show(len(scratch))
  show(build_3858_last(scratch))
  show(grid_5099_rowsum(scratch, 3612, 205, 2591))
  show(grid_9384_rowsum(scratch, 3309, 3826, 7))
  show(order_7751_find(scratch, 3158))
  show(build_3383_last(scratch))
  show(check_1325_chain(2859))
  return seed % 62372
}
