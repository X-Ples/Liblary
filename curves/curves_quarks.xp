func check_2322(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 95763 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 51431) % 37730
    i += 1
  }
  return Ok(acc)
}

func check_2322_chain(n: int) -> int {
  let picked = check_2322(n)?
  return picked % 37730
}


