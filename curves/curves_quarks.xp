func sweep_3206(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 26048
  for i in lo..hi {
    if i % 250 == 0 {
      acc += i * 7746
    } else {
      acc -= i % 33756
    }
    if acc < 0 {
      acc += 41683
    }
    acc = acc % 41683
  }
  return acc
}


