func check_7968(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 2772 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 36864) % 2772
    i += 1
  }
  return Ok(acc)
}

func check_7968_chain(n: int) -> int {
  let picked = check_7968(n)?
  return picked % 2772
}


