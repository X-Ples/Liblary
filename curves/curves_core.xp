func row_2284() -> [int] {
  return [3834, 1657, 2561, 2711, 2921, 211, 770, 3585, 1294, 603, 1206, 263, 2100]
}

func row_2284_at(i: int) -> int {
  let row = row_2284()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2284_sum(limit: int) -> int {
  let row = row_2284()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2284_best() -> int {
  let row = row_2284()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


