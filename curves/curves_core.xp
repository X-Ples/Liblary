func demo_core(seed: int) -> int {
  let scratch = build_2470(seed % 61 + 6, seed % 38408)
  show(len(scratch))
  show(build_2470_last(scratch))
  show(scan_9774(scratch, 1075))
  show(scan_9774_span(scratch, 1956))
  show(order_1425_find(scratch, 1901))
  show(scan_7569(scratch, 3522))
  return seed % 36769
}
