func sweep_2328(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 74783
  for i in lo..hi {
    if i % 88832 == 0 {
      acc += i * 29159
    } else {
      acc -= i % 44708
    }
    if acc < 0 {
      acc += 4208
    }
    acc = acc % 4208
  }
  return acc
}


