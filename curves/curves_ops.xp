func build_7960(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 88832) % 17591)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 88832 + 29159) % 17591
    j += 1
  }
  return buf
}

func build_7960_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_3183(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 96636 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 13006) % 31982
    i += 1
  }
  return Ok(acc)
}

func check_3183_chain(n: int) -> int {
  let picked = check_3183(n)?
  return picked % 31982
}


