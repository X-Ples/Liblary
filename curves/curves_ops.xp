func text_4879_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 17591
    i += 1
  }
  return acc % 17591
}

func text_4879_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "kilo"
}

func text_4879_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 17591
}


func demo_ops(seed: int) -> int {
  let scratch = build_7960(seed % 61 + 6, seed % 45973)
  show(len(scratch))
  show(build_7960_last(scratch))
  show(check_3183_chain(3777))
  show(build_7233_last(scratch))
  show(sweep_2328(3954, 1640))
  return seed % 66792
}
