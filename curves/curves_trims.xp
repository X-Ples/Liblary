func demo_trims(seed: int) -> int {
  let scratch = build_7146(seed % 61 + 6, seed % 34566)
  show(len(scratch))
  show(scan_3306(scratch, 2370))
  show(scan_3306_span(scratch, 3011))
  show(check_4499_chain(2845))
  show(row_3326_at(2584))
  return seed % 3281
}
