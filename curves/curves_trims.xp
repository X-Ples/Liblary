func scan_3306(data: [int], seed: int) -> int {
  let acc = seed % 92928
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 78192 + data[i] + i) % 92928
    i += 1
  }
  return acc
}

func scan_3306_span(data: [int], seed: int) -> int {
  let acc = scan_3306(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 78192
}


func check_4499(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 38247 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 9556) % 9556
    i += 1
  }
  return Ok(acc)
}

func check_4499_chain(n: int) -> int {
  let picked = check_4499(n)?
  return picked % 9556
}


func row_3326() -> [int] {
