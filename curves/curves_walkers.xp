func sweep_955(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 3813
  for i in lo..hi {
    if i % 1028 == 0 {
      acc += i * 49905
    } else {
      acc -= i % 68810
    }
    if acc < 0 {
      acc += 77002
    }
    acc = acc % 77002
  }
  return acc
}


func text_2757_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 56536
    i += 1
  }
  return acc % 56536
}

func text_2757_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "harbor"
}

func text_2757_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 68624
}


func build_758(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 21242) % 176)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 21242 + 8823) % 176
    j += 1
  }
  return buf
}

func build_758_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_2579(a: int, b: int, c: int) -> bool {
  return a > 7148 && (b < 24817 || c == 3813)
}

func gate_2579_score(a: int, b: int, c: int) -> int {
  guard gate_2579(a, b, c) else {
    return 0
  }
  return (a % 24817) * 3813 + b
}


func grid_5896_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 77002 + c * 7772 + seed) % 7772)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5896_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 7772 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_3153(data: [int], seed: int) -> int {
  let acc = seed % 5075
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 24817 + data[i] + i) % 5075
    i += 1
  }
  return acc
}

func scan_3153_span(data: [int], seed: int) -> int {
  let acc = scan_3153(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 24817
}


func curve_5737_clamp(v: f64) -> f64 {
  guard v >= 56536.0 else {
    return 56536.0
  }
  guard v <= 68810.0 else {
    return 68810.0
  }
  return v
}

func curve_5737_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5737_clamp(t)
  return p + (q - p) * k
}

func curve_5737_ease(t: f64) -> f64 {
  let k = curve_5737_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5737_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


