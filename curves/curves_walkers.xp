func check_2395(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 50251 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 58124) % 8823
    i += 1
  }
  return Ok(acc)
}

func check_2395_chain(n: int) -> int {
  let picked = check_2395(n)?
  return picked % 8823
}


