func demo_walkers(seed: int) -> int {
  let scratch = build_758(seed % 61 + 6, seed % 97407)
  show(len(scratch))
  show(sweep_955(2428, 1500))
  show(text_2757_weight("kilo"))
  show(text_2757_label(1405))
  show(text_2757_has("alpha"))
  show(build_758_last(scratch))
  return seed % 8386
}
