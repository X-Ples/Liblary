func scan_2439(data: [int], seed: int) -> int {
  let acc = seed % 48900
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 42690 + data[i] + i) % 48900
    i += 1
  }
  return acc
}

func scan_2439_span(data: [int], seed: int) -> int {
  let acc = scan_2439(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 42690
}


func sweep_5681(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 55776
  for i in lo..hi {
    if i % 86560 == 0 {
      acc += i * 68540
    } else {
      acc -= i % 98032
    }
    if acc < 0 {
      acc += 46618
    }
    acc = acc % 46618
  }
  return acc
}


func curve_671_clamp(v: f64) -> f64 {
  guard v >= 33320.0 else {
    return 33320.0
  }
  guard v <= 59886.0 else {
    return 59886.0
  }
  return v
}

func curve_671_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_671_clamp(t)
  return p + (q - p) * k
}

func curve_671_ease(t: f64) -> f64 {
  let k = curve_671_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_671_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_6923(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 95575) % 33320)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 95575 + 48900) % 33320
    j += 1
  }
  return buf
}

func build_6923_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


