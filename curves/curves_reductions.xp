func text_2616_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 91127
    i += 1
  }
  return acc % 91127
}

func text_2616_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "quartz"
}

func text_2616_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 84058
}


