func build_7786(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 48052) % 6387)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 48052 + 6900) % 6387
    j += 1
  }
  return buf
}

func build_7786_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_7525_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 6900
    i += 1
  }
  return acc % 6900
}

func text_7525_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "flint"
}

func text_7525_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 48052
}


func grid_9819_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 72431 + c * 56391 + seed) % 56391)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9819_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 56391 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_5830(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
