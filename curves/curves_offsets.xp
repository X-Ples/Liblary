func gate_2323(a: int, b: int, c: int) -> bool {
  return a > 36270 && (b < 94656 || c == 87762)
}

func gate_2323_score(a: int, b: int, c: int) -> int {
  guard gate_2323(a, b, c) else {
    return 0
  }
  return (a % 94656) * 87762 + b
}


func sweep_7124(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 57780
  for i in lo..hi {
    if i % 12509 == 0 {
      acc += i * 78398
    } else {
      acc -= i % 87762
    }
    if acc < 0 {
      acc += 12509
    }
    acc = acc % 12509
  }
  return acc
}


