func demo_offsets(seed: int) -> int {
  let scratch = build_1960(seed % 61 + 6, seed % 12509)
  show(len(scratch))
  show(grid_3326_rowsum(scratch, 3695, 95, 3610))
  show(build_1960_last(scratch))
  show(gate_2323(1947, 3850, 1449))
  show(gate_2323_score(655, 3100, 3844))
  show(sweep_7124(109, 3092))
  return seed % 96479
}
