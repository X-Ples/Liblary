func row_4648() -> [int] {
  return [3725, 3018, 1648, 3231, 2458, 3293, 1045, 2125, 804, 959, 1302, 559, 3711, 2196, 1361, 3389, 665, 2032, 305, 3982, 572]
}

func row_4648_at(i: int) -> int {
  let row = row_4648()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4648_sum(limit: int) -> int {
  let row = row_4648()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4648_best() -> int {
  let row = row_4648()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


