func demo_bursts(seed: int) -> int {
  let scratch = build_9637(seed % 61 + 6, seed % 98263)
  show(len(scratch))
  show(sweep_273(853, 3417))
  show(check_2010_chain(2799))
  show(order_6825_find(scratch, 1694))
  show(build_9637_last(scratch))
  show(scan_4216(scratch, 1479))
  return seed % 8321
}
