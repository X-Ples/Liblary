const K0 = 89491
const K1 = 42630
const K2 = 15223
const K3 = 40113
const K4 = 68493
const K5 = 6494

func curve_6705_clamp(v: f64) -> f64 {
  guard v >= 10258.0 else {
    return 10258.0
  }
  guard v <= 15223.0 else {
    return 15223.0
  }
  return v
}

func curve_6705_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6705_clamp(t)
  return p + (q - p) * k
}

func curve_6705_ease(t: f64) -> f64 {
  let k = curve_6705_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6705_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_273(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 48316
  for i in lo..hi {
    if i % 26895 == 0 {
      acc += i * 41577
    } else {
      acc -= i % 76315
    }
    if acc < 0 {
      acc += 68493
    }
    acc = acc % 68493
  }
  return acc
}


func check_2010(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 50320 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 26895) % 68493
    i += 1
  }
  return Ok(acc)
}

func check_2010_chain(n: int) -> int {
  let picked = check_2010(n)?
  return picked % 68493
}


func order_6825(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6825_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


