func row_3116() -> [int] {
  return [1483, 1731, 3599, 2846, 3183, 1328, 1914, 2121, 3767, 2401, 1591, 2779, 328, 1223, 2376, 2491, 1183, 3313, 122, 3587]
}

func row_3116_at(i: int) -> int {
  let row = row_3116()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3116_sum(limit: int) -> int {
  let row = row_3116()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3116_best() -> int {
  let row = row_3116()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


