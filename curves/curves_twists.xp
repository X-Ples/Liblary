func build_8388(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 63369) % 10857)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 63369 + 22642) % 10857
    j += 1
  }
  return buf
}

func build_8388_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_9422(data: [int], seed: int) -> int {
  let acc = seed % 20822
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 10857 + data[i] + i) % 20822
    i += 1
  }
  return acc
}

func scan_9422_span(data: [int], seed: int) -> int {
  let acc = scan_9422(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 10857
}


