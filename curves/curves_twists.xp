func demo_twists(seed: int) -> int {
  let scratch = build_8388(seed % 61 + 6, seed % 82432)
  show(len(scratch))
  show(build_8388_last(scratch))
  show(scan_9422(scratch, 908))
  show(scan_9422_span(scratch, 920))
  return seed % 82432
}
