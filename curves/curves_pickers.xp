func order_7581(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7581_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_3433(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 81873
  for i in lo..hi {
    if i % 91609 == 0 {
      acc += i * 44570
    } else {
      acc -= i % 4976
    }
    if acc < 0 {
      acc += 51137
    }
    acc = acc % 51137
  }
  return acc
}


func check_2693(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 51137 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 36223) % 58570
    i += 1
  }
  return Ok(acc)
}

func check_2693_chain(n: int) -> int {
  let picked = check_2693(n)?
  return picked % 58570
}


