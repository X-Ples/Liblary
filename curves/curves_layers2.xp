func sweep_909(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 48769
  for i in lo..hi {
    if i % 91611 == 0 {
      acc += i * 62154
    } else {
      acc -= i % 62154
    }
    if acc < 0 {
      acc += 56821
    }
    acc = acc % 56821
  }
  return acc
}


func grid_2413_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 8942 + c * 30460 + seed) % 30460)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2413_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 30460 == want {
      total += acc
    }
    r += 1
  }
  return total
}


