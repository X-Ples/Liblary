const K6 = 50928
const K7 = 48769

func row_8384() -> [int] {
  return [1810, 1014, 1334, 1493, 2018, 3683, 2175, 1477, 3807, 1171, 574, 1920, 191, 3023, 703, 2203, 2389, 4016, 3081, 2046]
}

func row_8384_at(i: int) -> int {
  let row = row_8384()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8384_sum(limit: int) -> int {
  let row = row_8384()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8384_best() -> int {
  let row = row_8384()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_6160(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 48769) % 91131)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 48769 + 80302) % 91131
    j += 1
  }
  return buf
}

func build_6160_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_6276_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 84496
    i += 1
  }
  return acc % 84496
}

func text_6276_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "omega"
}

func text_6276_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 37565
}


func scan_5145(data: [int], seed: int) -> int {
  let acc = seed % 8942
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 75762 + data[i] + i) % 8942
    i += 1
  }
  return acc
}

func scan_5145_span(data: [int], seed: int) -> int {
  let acc = scan_5145(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 75762
}


func curve_8418_clamp(v: f64) -> f64 {
  guard v >= 63228.0 else {
    return 63228.0
  }
  guard v <= 84496.0 else {
    return 84496.0
  }
  return v
}

func curve_8418_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8418_clamp(t)
  return p + (q - p) * k
}

func curve_8418_ease(t: f64) -> f64 {
  let k = curve_8418_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8418_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


