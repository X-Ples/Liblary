func demo_layers2(seed: int) -> int {
  let scratch = build_6160(seed % 61 + 6, seed % 27296)
  show(len(scratch))
  show(row_8384_at(2211))
  show(row_8384_sum(2483))
  show(row_8384_best())
  show(build_6160_last(scratch))
  show(text_6276_weight("alpha"))
  return seed % 91131
}
