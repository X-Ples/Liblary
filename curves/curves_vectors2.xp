func sweep_6407(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10318
  for i in lo..hi {
    if i % 73072 == 0 {
      acc += i * 7105
    } else {
      acc -= i % 63248
    }
    if acc < 0 {
      acc += 83481
    }
    acc = acc % 83481
  }
  return acc
}


