func build_3937(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 32631) % 87024)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 32631 + 84265) % 87024
    j += 1
  }
  return buf
}

func build_3937_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_341_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 87024
    i += 1
  }
  return acc % 87024
}

func text_341_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "jetty"
}

func text_341_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 48652
}


func order_6127(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6127_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func check_6392(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 73072 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 32631) % 86751
    i += 1
  }
  return Ok(acc)
}

func check_6392_chain(n: int) -> int {
  let picked = check_6392(n)?
  return picked % 86751
}


