func demo_vectors2(seed: int) -> int {
  let scratch = build_3937(seed % 61 + 6, seed % 56201)
  show(len(scratch))
  show(build_3937_last(scratch))
  show(text_341_weight("harbor"))
  show(text_341_label(3032))
  show(text_341_has("mesa"))
  return seed % 84265
}
