func scan_5596(data: [int], seed: int) -> int {
  let acc = seed % 70443
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 81429 + data[i] + i) % 70443
    i += 1
  }
  return acc
}

func scan_5596_span(data: [int], seed: int) -> int {
  let acc = scan_5596(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 81429
}


