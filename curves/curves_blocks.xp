func demo_blocks(seed: int) -> int {
  let scratch = build_3543(seed % 61 + 6, seed % 79862)
  show(len(scratch))
  show(check_9579_chain(1259))
  show(build_3543_last(scratch))
  show(order_5934_find(scratch, 3793))
  show(check_9225_chain(1840))
