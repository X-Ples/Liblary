func sweep_7607(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 53988
  for i in lo..hi {
    if i % 58344 == 0 {
      acc += i * 34619
    } else {
      acc -= i % 58344
    }
    if acc < 0 {
      acc += 96135
    }
    acc = acc % 96135
  }
  return acc
}


func row_6385() -> [int] {
  return [693, 1916, 324, 667, 814, 2686, 2714, 2488, 138, 801, 3676, 25, 506, 2842, 1627, 571, 2242, 3427]
}

func row_6385_at(i: int) -> int {
  let row = row_6385()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6385_sum(limit: int) -> int {
  let row = row_6385()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6385_best() -> int {
  let row = row_6385()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


