func grid_5094_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 46532 + c * 11488 + seed) % 11488)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5094_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 11488 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func demo_checks(seed: int) -> int {
  let scratch = build_3422(seed % 61 + 6, seed % 91444)
  show(len(scratch))
  show(build_3422_last(scratch))
  show(text_9969_weight("prism"))
  show(text_9969_label(1909))
  show(text_9969_has("ion"))
  show(gate_742(795, 2391, 2055))
  show(gate_742_score(2816, 3764, 3206))
  return seed % 90744
}
