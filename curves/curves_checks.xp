func build_3422(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 69483) % 80496)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 69483 + 57248) % 80496
    j += 1
  }
  return buf
}

func build_3422_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_9969_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 53035
    i += 1
  }
  return acc % 53035
}

func text_9969_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "ion"
}

func text_9969_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 92156
}


