func sweep_1861(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 11488
  for i in lo..hi {
    if i % 56161 == 0 {
      acc += i * 53035
    } else {
      acc -= i % 26270
    }
    if acc < 0 {
      acc += 75579
    }
    acc = acc % 75579
  }
  return acc
}


