func check_777(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 22247 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 90744) % 57248
    i += 1
  }
  return Ok(acc)
}

func check_777_chain(n: int) -> int {
  let picked = check_777(n)?
  return picked % 57248
}


