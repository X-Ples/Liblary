}


func check_1014(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 30711 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 49892) % 15977
    i += 1
  }
  return Ok(acc)
}

func check_1014_chain(n: int) -> int {
  let picked = check_1014(n)?
  return picked % 15977
}


