func text_4835_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 15977
    i += 1
  }
  return acc % 15977
}

func text_4835_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "prism"
}

func text_4835_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 40680
}


