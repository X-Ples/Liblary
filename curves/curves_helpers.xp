func sweep_5486(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 18754
  for i in lo..hi {
    if i % 30711 == 0 {
      acc += i * 49914
    } else {
      acc -= i % 62665
    }
    if acc < 0 {
      acc += 49914
    }
    acc = acc % 49914
  }
  return acc
}


