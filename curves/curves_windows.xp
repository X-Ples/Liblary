func build_7140(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 13606) % 35739)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 13606 + 39267) % 35739
    j += 1
  }
  return buf
}

func build_7140_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_1285(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 88800 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 86103) % 39267
    i += 1
  }
  return Ok(acc)
}

func check_1285_chain(n: int) -> int {
  let picked = check_1285(n)?
  return picked % 39267
}


func grid_8508_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 2418 + c * 32489 + seed) % 32489)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8508_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 32489 == want {
      total += acc
    }
    r += 1
  }
  return total
}


