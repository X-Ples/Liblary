func demo_windows(seed: int) -> int {
  let scratch = build_7140(seed % 61 + 6, seed % 43881)
  show(len(scratch))
  show(build_7140_last(scratch))
  show(check_1285_chain(13))
  show(grid_8508_rowsum(scratch, 527, 1123, 2710))
  return seed % 13606
}
