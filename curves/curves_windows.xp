func sweep_5708(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 8662
  for i in lo..hi {
    if i % 99149 == 0 {
      acc += i * 9263
    } else {
      acc -= i % 43881
    }
    if acc < 0 {
      acc += 35739
    }
    acc = acc % 35739
  }
  return acc
}


