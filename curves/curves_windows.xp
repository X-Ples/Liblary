func row_2930() -> [int] {
  return [1791, 2165, 4077, 1428, 2126, 2906, 3685, 305, 48, 333, 447]
}

func row_2930_at(i: int) -> int {
  let row = row_2930()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2930_sum(limit: int) -> int {
  let row = row_2930()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2930_best() -> int {
  let row = row_2930()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


