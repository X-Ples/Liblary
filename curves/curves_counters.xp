func demo_counters(seed: int) -> int {
  let scratch = build_6607(seed % 61 + 6, seed % 85576)
  show(len(scratch))
  show(build_6607_last(scratch))
  show(scan_3303(scratch, 697))
  show(scan_3303_span(scratch, 2141))
  show(text_1221_weight("talus"))
  show(text_1221_label(3392))
  show(text_1221_has("gamma"))
  return seed % 80676
}
