func build_6607(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 12117) % 19251)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 12117 + 47284) % 19251
    j += 1
  }
  return buf
}

func build_6607_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_3303(data: [int], seed: int) -> int {
  let acc = seed % 85576
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 9484 + data[i] + i) % 85576
    i += 1
  }
  return acc
}

func scan_3303_span(data: [int], seed: int) -> int {
  let acc = scan_3303(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 9484
}


func text_1221_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 95799
    i += 1
  }
  return acc % 95799
}

func text_1221_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "talus"
}

func text_1221_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 19251
}


func grid_9327_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 12117 + c * 47284 + seed) % 47284)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9327_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 47284 == want {
      total += acc
    }
    r += 1
  }
  return total
}


