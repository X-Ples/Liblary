func row_5620() -> [int] {
  return [1554, 40, 3975, 1534, 3901, 893, 2307, 694, 82, 3716]
}

func row_5620_at(i: int) -> int {
  let row = row_5620()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5620_sum(limit: int) -> int {
  let row = row_5620()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5620_best() -> int {
  let row = row_5620()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


