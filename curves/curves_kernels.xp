func build_8843(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 45997) % 89535)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 45997 + 68851) % 89535
    j += 1
  }
  return buf
}

func build_8843_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_5606(a: int, b: int, c: int) -> bool {
  return a > 47978 && (b < 10857 || c == 17049)
}

func gate_5606_score(a: int, b: int, c: int) -> int {
  guard gate_5606(a, b, c) else {
    return 0
  }
  return (a % 10857) * 17049 + b
}


