func check_5788(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 29597 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 45997) % 94490
    i += 1
  }
  return Ok(acc)
}

func check_5788_chain(n: int) -> int {
  let picked = check_5788(n)?
  return picked % 94490
}


