func demo_kernels(seed: int) -> int {
  let scratch = build_8843(seed % 61 + 6, seed % 33929)
  show(len(scratch))
  show(build_8843_last(scratch))
  show(gate_5606(625, 1610, 3097))
  show(gate_5606_score(3514, 696, 2030))
  show(row_1979_at(913))
  return seed % 75751
}
