func sweep_6753(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 67035
  for i in lo..hi {
    if i % 52396 == 0 {
      acc += i * 64675
    } else {
      acc -= i % 64675
    }
    if acc < 0 {
      acc += 53993
    }
    acc = acc % 53993
  }
  return acc
}


