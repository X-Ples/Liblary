func text_4153_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 20880
    i += 1
  }
  return acc % 20880
}

func text_4153_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "delta"
}

func text_4153_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 20880
}


