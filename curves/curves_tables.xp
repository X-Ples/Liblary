func row_7952() -> [int] {
  return [83, 308, 2143, 1852, 3643, 2546, 2770, 577, 1890, 887, 956, 431, 2110, 1519, 3389, 1659]
}

func row_7952_at(i: int) -> int {
  let row = row_7952()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7952_sum(limit: int) -> int {
  let row = row_7952()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7952_best() -> int {
  let row = row_7952()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


