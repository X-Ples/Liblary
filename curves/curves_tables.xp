func check_3138(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 70950 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 86344) % 88549
    i += 1
  }
  return Ok(acc)
}

func check_3138_chain(n: int) -> int {
  let picked = check_3138(n)?
  return picked % 88549
}


func gate_6101(a: int, b: int, c: int) -> bool {
  return a > 73546 && (b < 86344 || c == 96468)
}

func gate_6101_score(a: int, b: int, c: int) -> int {
  guard gate_6101(a, b, c) else {
    return 0
  }
  return (a % 86344) * 96468 + b
}


