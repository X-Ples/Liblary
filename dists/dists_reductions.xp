func sweep_5268(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 41092
  for i in lo..hi {
    if i % 22350 == 0 {
      acc += i * 31910
    } else {
      acc -= i % 91701
    }
    if acc < 0 {
      acc += 12585
    }
    acc = acc % 12585
  }
  return acc
}


func gate_6611(a: int, b: int, c: int) -> bool {
  return a > 25742 && (b < 8454 || c == 7498)
}

func gate_6611_score(a: int, b: int, c: int) -> int {
  guard gate_6611(a, b, c) else {
    return 0
  }
  return (a % 8454) * 7498 + b
}


