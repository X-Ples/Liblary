func text_4171_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 55668
    i += 1
  }
  return acc % 55668
}

func text_4171_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "sigma"
}

func text_4171_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 97704
}


func grid_7342_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 55363 + c * 28612 + seed) % 28612)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7342_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 28612 == want {
      total += acc
    }
    r += 1
  }
  return total
}


