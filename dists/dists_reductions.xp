func curve_132_clamp(v: f64) -> f64 {
  guard v >= 11484.0 else {
    return 11484.0
  }
  guard v <= 41092.0 else {
    return 41092.0
  }
  return v
}

func curve_132_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_132_clamp(t)
  return p + (q - p) * k
}

func curve_132_ease(t: f64) -> f64 {
  let k = curve_132_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_132_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_2608(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 91701) % 11484)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 91701 + 31910) % 11484
    j += 1
  }
  return buf
}

func build_2608_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_9275() -> [int] {
  return [1342, 475, 3130, 781, 33, 1450, 1947, 2300, 1346, 2741, 2290, 3389, 1843]
}

func row_9275_at(i: int) -> int {
  let row = row_9275()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9275_sum(limit: int) -> int {
  let row = row_9275()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9275_best() -> int {
  let row = row_9275()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


