func demo_reductions(seed: int) -> int {
  let scratch = build_2608(seed % 61 + 6, seed % 17017)
  show(len(scratch))
  show(build_2608_last(scratch))
  show(row_9275_at(1220))
  show(row_9275_sum(3429))
  show(row_9275_best())
  show(row_1233_at(2515))
  return seed % 85483
}
