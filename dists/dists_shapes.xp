func sweep_637(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 79156
  for i in lo..hi {
    if i % 73303 == 0 {
      acc += i * 73589
    } else {
      acc -= i % 73589
    }
    if acc < 0 {
      acc += 13270
    }
    acc = acc % 13270
  }
  return acc
}


