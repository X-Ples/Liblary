func demo_shapes(seed: int) -> int {
  let scratch = build_7960(seed % 61 + 6, seed % 66287)
  show(len(scratch))
  show(text_2021_weight("gamma"))
  show(text_2021_label(3871))
  show(text_2021_has("bravo"))
  return seed % 68940
}
