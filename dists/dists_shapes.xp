func text_2021_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 73303
    i += 1
  }
  return acc % 73303
}

func text_2021_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "jetty"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "ridge"
}

func text_2021_has(tag: str) -> bool {
  return str_contains(tag, "jetty") || len(tag) > 97402
}


func check_3789(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 97402 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 73303) % 13270
    i += 1
  }
  return Ok(acc)
}

func check_3789_chain(n: int) -> int {
  let picked = check_3789(n)?
  return picked % 13270
}


func build_7960(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 66287) % 97402)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 66287 + 47820) % 97402
    j += 1
  }
  return buf
}

func build_7960_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


