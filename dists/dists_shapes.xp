func row_2223() -> [int] {
  return [3290, 3387, 3162, 3631, 3741, 229, 2915, 383, 2697, 1244, 2589, 2109, 2508, 3729, 1412]
}

func row_2223_at(i: int) -> int {
  let row = row_2223()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2223_sum(limit: int) -> int {
  let row = row_2223()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2223_best() -> int {
  let row = row_2223()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


