func scan_2467(data: [int], seed: int) -> int {
  let acc = seed % 66225
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 68292 + data[i] + i) % 66225
    i += 1
  }
  return acc
}

func scan_2467_span(data: [int], seed: int) -> int {
  let acc = scan_2467(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 68292
}


