func demo_layers2(seed: int) -> int {
  let scratch = build_7925(seed % 61 + 6, seed % 38980)
  show(len(scratch))
  show(build_7925_last(scratch))
  show(sweep_3860(3451, 166))
  show(sweep_3665(2101, 2240))
  show(order_2328_find(scratch, 2104))
  show(scan_9135(scratch, 2868))
  show(scan_9135_span(scratch, 2324))
  return seed % 86657
}
