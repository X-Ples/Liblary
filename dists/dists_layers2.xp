func build_7925(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 4597) % 25432)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 4597 + 92517) % 25432
    j += 1
  }
  return buf
}

func build_7925_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_3860(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 37659
  for i in lo..hi {
    if i % 86121 == 0 {
      acc += i * 47696
    } else {
      acc -= i % 92517
    }
    if acc < 0 {
      acc += 24019
    }
    acc = acc % 24019
  }
  return acc
}


