func text_7819_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 34780
    i += 1
  }
  return acc % 34780
}

func text_7819_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "mesa"
}

func text_7819_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 38980
}


func curve_799_clamp(v: f64) -> f64 {
  guard v >= 17523.0 else {
    return 17523.0
  }
  guard v <= 47696.0 else {
    return 47696.0
  }
  return v
}

func curve_799_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_799_clamp(t)
  return p + (q - p) * k
}

func curve_799_ease(t: f64) -> f64 {
  let k = curve_799_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_799_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


