func check_6527(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 15279 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 71537) % 27192
    i += 1
  }
  return Ok(acc)
}

func check_6527_chain(n: int) -> int {
  let picked = check_6527(n)?
  return picked % 27192
}


