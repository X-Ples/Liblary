func sweep_4040(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 45981
  for i in lo..hi {
    if i % 73672 == 0 {
      acc += i * 86065
    } else {
      acc -= i % 45981
    }
    if acc < 0 {
      acc += 9900
    }
    acc = acc % 9900
  }
  return acc
}


