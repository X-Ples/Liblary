func curve_8778_clamp(v: f64) -> f64 {
  guard v >= 25671.0 else {
    return 25671.0
  }
  guard v <= 88442.0 else {
    return 88442.0
  }
  return v
}

func curve_8778_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8778_clamp(t)
  return p + (q - p) * k
}

func curve_8778_ease(t: f64) -> f64 {
  let k = curve_8778_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8778_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_trims(seed: int) -> int {
  let scratch = build_9819(seed % 61 + 6, seed % 40371)
  show(len(scratch))
  show(build_9819_last(scratch))
  show(row_7016_at(1990))
  show(row_7016_sum(1427))
  return seed % 85967
}
