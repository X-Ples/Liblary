func build_9819(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 23837) % 82487)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 23837 + 24512) % 82487
    j += 1
  }
  return buf
}

func build_9819_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_7016() -> [int] {
  return [3604, 3568, 1843, 166, 1739, 782, 2320, 1695, 3301, 806, 38, 1181, 1568, 3550, 3312, 2893, 3678, 2744, 3263]
}

func row_7016_at(i: int) -> int {
  let row = row_7016()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7016_sum(limit: int) -> int {
  let row = row_7016()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7016_best() -> int {
  let row = row_7016()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_2601(data: [int], seed: int) -> int {
  let acc = seed % 25671
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 6030 + data[i] + i) % 25671
    i += 1
  }
  return acc
}

func scan_2601_span(data: [int], seed: int) -> int {
  let acc = scan_2601(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 6030
}


func check_3966(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 7276 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 7276) % 24512
    i += 1
  }
  return Ok(acc)
}

func check_3966_chain(n: int) -> int {
  let picked = check_3966(n)?
  return picked % 24512
}


func grid_3944_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 85761 + c * 46146 + seed) % 46146)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3944_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 46146 == want {
      total += acc
    }
    r += 1
  }
  return total
}


