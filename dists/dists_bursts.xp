func demo_bursts(seed: int) -> int {
  let scratch = build_2751(seed % 61 + 6, seed % 11326)
  show(len(scratch))
  show(gate_7233(2156, 1829, 3613))
  show(gate_7233_score(273, 553, 2955))
  show(scan_8957(scratch, 3383))
  show(scan_8957_span(scratch, 3148))
  return seed % 76511
}
