func gate_7233(a: int, b: int, c: int) -> bool {
  return a > 51210 && (b < 51210 || c == 76511)
}

func gate_7233_score(a: int, b: int, c: int) -> int {
  guard gate_7233(a, b, c) else {
    return 0
  }
  return (a % 51210) * 76511 + b
}


func scan_8957(data: [int], seed: int) -> int {
  let acc = seed % 27657
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 69669 + data[i] + i) % 27657
    i += 1
  }
  return acc
}

func scan_8957_span(data: [int], seed: int) -> int {
  let acc = scan_8957(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 69669
}


func build_2751(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 51210) % 51210)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 51210 + 34015) % 51210
    j += 1
  }
  return buf
}

func build_2751_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


