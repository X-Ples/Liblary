func demo_counters(seed: int) -> int {
  let scratch = build_5532(seed % 61 + 6, seed % 68427)
  show(len(scratch))
  show(sweep_2058(3622, 984))
  show(scan_4523(scratch, 1491))
  show(scan_4523_span(scratch, 2400))
  show(build_5532_last(scratch))
  show(order_9002_find(scratch, 537))
  return seed % 53392
}
