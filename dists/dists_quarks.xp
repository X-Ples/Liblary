func scan_2925(data: [int], seed: int) -> int {
  let acc = seed % 96678
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 88554 + data[i] + i) % 96678
    i += 1
  }
  return acc
}

func scan_2925_span(data: [int], seed: int) -> int {
  let acc = scan_2925(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 88554
}


func build_7434(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
