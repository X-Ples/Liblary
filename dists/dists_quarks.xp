func demo_quarks(seed: int) -> int {
  let scratch = build_7434(seed % 61 + 6, seed % 75742)
  show(len(scratch))
  show(scan_2925(scratch, 1520))
  show(scan_2925_span(scratch, 899))
  show(build_7434_last(scratch))
  show(sweep_9348(1370, 3080))
  return seed % 76727
}
