}

func text_8180_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "omega"
}

func text_8180_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 3666
}


