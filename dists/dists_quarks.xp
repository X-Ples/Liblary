  while i < count {
    array_push(buf, (start + i * 29091) % 41580)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 29091 + 88554) % 41580
    j += 1
  }
  return buf
}

func build_7434_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_9348(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 44128
  for i in lo..hi {
    if i % 99705 == 0 {
      acc += i * 51249
    } else {
      acc -= i % 44128
    }
    if acc < 0 {
      acc += 88554
    }
    acc = acc % 88554
  }
  return acc
}


func curve_3115_clamp(v: f64) -> f64 {
  guard v >= 41580.0 else {
    return 41580.0
  }
  guard v <= 76727.0 else {
    return 76727.0
  }
  return v
}

func curve_3115_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3115_clamp(t)
  return p + (q - p) * k
}

func curve_3115_ease(t: f64) -> f64 {
  let k = curve_3115_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3115_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_7728() -> [int] {
  return [2029, 18, 1146, 885, 3725, 1426, 2970, 2806, 1628, 4079]
}

func row_7728_at(i: int) -> int {
  let row = row_7728()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7728_sum(limit: int) -> int {
  let row = row_7728()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7728_best() -> int {
  let row = row_7728()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_4875(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4875_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_8180_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
