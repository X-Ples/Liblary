const K0 = 44736
const K1 = 37727
const K2 = 63139
const K3 = 20306
const K4 = 49059
const K5 = 28926

func scan_5200(data: [int], seed: int) -> int {
  let acc = seed % 86718
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 28926 + data[i] + i) % 86718
    i += 1
  }
  return acc
}

func scan_5200_span(data: [int], seed: int) -> int {
  let acc = scan_5200(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 28926
}


func row_4384() -> [int] {
  return [2667, 1225, 775, 4052, 1094, 1542, 3299, 3602, 636, 2313, 2055, 1345, 3400, 297, 1194, 224, 2919]
}

func row_4384_at(i: int) -> int {
  let row = row_4384()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4384_sum(limit: int) -> int {
  let row = row_4384()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4384_best() -> int {
  let row = row_4384()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_1290(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 63139
  for i in lo..hi {
    if i % 76135 == 0 {
      acc += i * 76135
    } else {
      acc -= i % 61468
    }
    if acc < 0 {
      acc += 81528
    }
    acc = acc % 81528
  }
  return acc
}


