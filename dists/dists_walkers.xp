func check_6572(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 20306 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 93414) % 5831
    i += 1
  }
  return Ok(acc)
}

func check_6572_chain(n: int) -> int {
  let picked = check_6572(n)?
  return picked % 5831
}


