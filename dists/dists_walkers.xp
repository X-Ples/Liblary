func demo_walkers(seed: int) -> int {
  let scratch = build_5133(seed % 61 + 6, seed % 93966)
  show(len(scratch))
  show(scan_5200(scratch, 2514))
  show(scan_5200_span(scratch, 350))
  show(row_4384_at(923))
  show(row_4384_sum(256))
  return seed % 61468
}
