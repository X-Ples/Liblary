func row_4145() -> [int] {
  return [1860, 1842, 228, 332, 391, 359, 834, 1852, 3006, 3611, 2080, 12, 4046, 2034, 902, 3627, 1653, 1018, 1873]
}

func row_4145_at(i: int) -> int {
  let row = row_4145()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4145_sum(limit: int) -> int {
  let row = row_4145()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4145_best() -> int {
  let row = row_4145()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


