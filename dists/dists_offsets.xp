}


func check_8766(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 16263 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 71149) % 95965
    i += 1
  }
  return Ok(acc)
}

func check_8766_chain(n: int) -> int {
  let picked = check_8766(n)?
  return picked % 95965
}


func sweep_952(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 71331
  for i in lo..hi {
    if i % 77529 == 0 {
      acc += i * 10247
    } else {
      acc -= i % 55979
    }
    if acc < 0 {
      acc += 71331
    }
    acc = acc % 71331
  }
  return acc
}


func curve_4108_clamp(v: f64) -> f64 {
  guard v >= 952.0 else {
    return 952.0
  }
  guard v <= 71149.0 else {
    return 71149.0
  }
  return v
}

func curve_4108_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4108_clamp(t)
  return p + (q - p) * k
}

func curve_4108_ease(t: f64) -> f64 {
  let k = curve_4108_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4108_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


