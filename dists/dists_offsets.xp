func demo_offsets(seed: int) -> int {
  let scratch = build_5181(seed % 61 + 6, seed % 4757)
  show(len(scratch))
  show(grid_399_rowsum(scratch, 761, 2954, 1792))
  show(order_7454_find(scratch, 2787))
  show(build_5181_last(scratch))
  show(gate_9302(2366, 3584, 22))
  show(gate_9302_score(3627, 194, 1577))
  return seed % 15809
}
