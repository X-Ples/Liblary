func scan_4038(data: [int], seed: int) -> int {
  let acc = seed % 65009
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 22757 + data[i] + i) % 65009
    i += 1
  }
  return acc
}

func scan_4038_span(data: [int], seed: int) -> int {
  let acc = scan_4038(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 22757
}


