func build_8516(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 44139) % 74435)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 44139 + 42073) % 74435
    j += 1
  }
  return buf
}

func build_8516_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_1883(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 45698 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 29222) % 67068
    i += 1
  }
  return Ok(acc)
}

func check_1883_chain(n: int) -> int {
  let picked = check_1883(n)?
  return picked % 67068
}


func row_2469() -> [int] {
  return [3633, 2292, 2323, 2794, 360, 3308, 2649, 3189, 4077, 1027, 2614, 3253]
}

func row_2469_at(i: int) -> int {
  let row = row_2469()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2469_sum(limit: int) -> int {
  let row = row_2469()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2469_best() -> int {
  let row = row_2469()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_9377(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 62901
  for i in lo..hi {
    if i % 5158 == 0 {
      acc += i * 93226
    } else {
      acc -= i % 62901
    }
    if acc < 0 {
      acc += 73072
    }
    acc = acc % 73072
  }
  return acc
}


