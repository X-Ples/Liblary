func demo_twists(seed: int) -> int {
  let scratch = build_8516(seed % 61 + 6, seed % 75510)
  show(len(scratch))
  show(build_8516_last(scratch))
  show(check_1883_chain(3803))
  show(row_2469_at(2168))
  show(row_2469_sum(37))
  show(row_2469_best())
  show(sweep_9377(2326, 1057))
  return seed % 74435
}
