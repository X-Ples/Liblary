func curve_4080_clamp(v: f64) -> f64 {
  guard v >= 60234.0 else {
    return 60234.0
  }
  guard v <= 67068.0 else {
    return 67068.0
  }
  return v
}

func curve_4080_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4080_clamp(t)
  return p + (q - p) * k
}

func curve_4080_ease(t: f64) -> f64 {
  let k = curve_4080_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4080_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_4208(data: [int], seed: int) -> int {
  let acc = seed % 5158
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 76143 + data[i] + i) % 5158
    i += 1
  }
  return acc
}

func scan_4208_span(data: [int], seed: int) -> int {
  let acc = scan_4208(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 76143
}


