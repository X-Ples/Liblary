func check_4969(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 71537 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 85712) % 71537
    i += 1
  }
  return Ok(acc)
}

func check_4969_chain(n: int) -> int {
  let picked = check_4969(n)?
  return picked % 71537
}


