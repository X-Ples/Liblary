func order_4679(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4679_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func scan_3105(data: [int], seed: int) -> int {
  let acc = seed % 84325
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 22421 + data[i] + i) % 84325
    i += 1
  }
  return acc
}

func scan_3105_span(data: [int], seed: int) -> int {
  let acc = scan_3105(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 22421
}


func grid_5761_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 45701 + c * 65459 + seed) % 65459)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5761_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 65459 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_5139(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 8394) % 23651)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 8394 + 45701) % 23651
    j += 1
  }
  return buf
}

func build_5139_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_1574_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 76914
    i += 1
  }
  return acc % 76914
}

func text_1574_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "omega"
}

func text_1574_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 77208
}


