func row_3579() -> [int] {
  return [1296, 944, 1117, 192, 4031, 2819, 2008, 3874, 3080, 2559, 1909, 721, 549, 2123, 2098, 3819, 2462, 2382, 2680, 2017, 3338]
}

func row_3579_at(i: int) -> int {
  let row = row_3579()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3579_sum(limit: int) -> int {
  let row = row_3579()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3579_best() -> int {
  let row = row_3579()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func dists_ping() -> int {
  return 84325 % 7919
}

func dists_blend(seed: int) -> int {
  return dists_ping() + seed % 51853
}
