func demo_signals(seed: int) -> int {
  let scratch = build_2158(seed % 61 + 6, seed % 30932)
  show(len(scratch))
  show(build_2158_last(scratch))
  show(build_4610_last(scratch))
  show(gate_9809(476, 2866, 3328))
  show(gate_9809_score(506, 1460, 262))
  show(text_9544_weight("alpha"))
  return seed % 62715
}
