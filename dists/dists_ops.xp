func build_1586(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 41502) % 58099)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 41502 + 43528) % 58099
    j += 1
  }
  return buf
}

func build_1586_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_7771() -> [int] {
  return [2233, 121, 344, 3618, 1624, 299, 3811, 1212, 1560, 3399, 2058, 3669, 756]
}

func row_7771_at(i: int) -> int {
  let row = row_7771()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7771_sum(limit: int) -> int {
  let row = row_7771()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7771_best() -> int {
  let row = row_7771()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_4535(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 22663
  for i in lo..hi {
    if i % 13699 == 0 {
      acc += i * 81388
    } else {
      acc -= i % 13699
    }
    if acc < 0 {
      acc += 66572
    }
    acc = acc % 66572
  }
  return acc
}


func check_2896(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 45615 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 20279) % 59912
    i += 1
  }
  return Ok(acc)
}

func check_2896_chain(n: int) -> int {
  let picked = check_2896(n)?
  return picked % 59912
}


