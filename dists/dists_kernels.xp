func build_6892(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 70226) % 11199)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 70226 + 51161) % 11199
    j += 1
  }
  return buf
}

func build_6892_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_3022(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 63563
  for i in lo..hi {
    if i % 71581 == 0 {
      acc += i * 17531
    } else {
      acc -= i % 2243
    }
    if acc < 0 {
      acc += 96038
    }
    acc = acc % 96038
  }
  return acc
}


