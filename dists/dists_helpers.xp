func row_9826() -> [int] {
  return [3262, 2227, 488, 2281, 144, 949, 1663, 786, 3226, 4040, 2773, 2126]
}

func row_9826_at(i: int) -> int {
  let row = row_9826()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9826_sum(limit: int) -> int {
  let row = row_9826()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9826_best() -> int {
  let row = row_9826()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


