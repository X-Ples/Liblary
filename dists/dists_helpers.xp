func curve_9217_clamp(v: f64) -> f64 {
  guard v >= 3095.0 else {
    return 3095.0
  }
  guard v <= 23018.0 else {
    return 23018.0
  }
  return v
}

func curve_9217_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9217_clamp(t)
  return p + (q - p) * k
}

func curve_9217_ease(t: f64) -> f64 {
  let k = curve_9217_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9217_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_5628(a: int, b: int, c: int) -> bool {
  return a > 57088 && (b < 33383 || c == 3095)
}

func gate_5628_score(a: int, b: int, c: int) -> int {
  guard gate_5628(a, b, c) else {
    return 0
  }
  return (a % 33383) * 3095 + b
}


func sweep_6803(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 78032
  for i in lo..hi {
    if i % 191 == 0 {
      acc += i * 51398
    } else {
      acc -= i % 23018
    }
    if acc < 0 {
      acc += 3095
    }
    acc = acc % 3095
  }
  return acc
}


