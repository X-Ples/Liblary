func scan_4049(data: [int], seed: int) -> int {
  let acc = seed % 50441
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 9692 + data[i] + i) % 50441
    i += 1
  }
  return acc
}

func scan_4049_span(data: [int], seed: int) -> int {
  let acc = scan_4049(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 9692
}


func build_2379(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 21720) % 56850)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 21720 + 9692) % 56850
    j += 1
  }
  return buf
}

func build_2379_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_3017(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 51398 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 96375) % 81439
    i += 1
  }
  return Ok(acc)
}

func check_3017_chain(n: int) -> int {
  let picked = check_3017(n)?
  return picked % 81439
}


