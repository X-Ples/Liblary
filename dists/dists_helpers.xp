func demo_helpers(seed: int) -> int {
  let scratch = build_2379(seed % 61 + 6, seed % 97082)
  show(len(scratch))
  show(scan_4049(scratch, 1521))
  show(scan_4049_span(scratch, 2207))
  show(build_2379_last(scratch))
