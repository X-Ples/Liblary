func check_1219(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 28136 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 56685) % 25429
    i += 1
  }
  return Ok(acc)
}

func check_1219_chain(n: int) -> int {
  let picked = check_1219(n)?
  return picked % 25429
}


func scan_1173(data: [int], seed: int) -> int {
  let acc = seed % 19644
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 25429 + data[i] + i) % 19644
    i += 1
  }
  return acc
}

func scan_1173_span(data: [int], seed: int) -> int {
  let acc = scan_1173(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 25429
}


