func build_4813(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 70343) % 56685)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 70343 + 43292) % 56685
    j += 1
  }
  return buf
}

func build_4813_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_6488() -> [int] {
  return [1673, 1913, 3032, 2654, 3211, 356, 3360, 2196, 2384, 720, 1790, 1885]
}

func row_6488_at(i: int) -> int {
  let row = row_6488()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6488_sum(limit: int) -> int {
  let row = row_6488()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6488_best() -> int {
  let row = row_6488()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_4329_clamp(v: f64) -> f64 {
  guard v >= 16437.0 else {
    return 16437.0
  }
  guard v <= 93155.0 else {
    return 93155.0
  }
  return v
}

func curve_4329_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4329_clamp(t)
  return p + (q - p) * k
}

func curve_4329_ease(t: f64) -> f64 {
  let k = curve_4329_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4329_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


