func sweep_8607(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 19756
  for i in lo..hi {
    if i % 31871 == 0 {
      acc += i * 8683
    } else {
      acc -= i % 63743
    }
    if acc < 0 {
      acc += 14646
    }
    acc = acc % 14646
  }
  return acc
}


