func grid_5185_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 17146 + c * 2590 + seed) % 2590)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5185_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 2590 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_5616(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 16632 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 69828) % 43327
    i += 1
  }
  return Ok(acc)
}

func check_5616_chain(n: int) -> int {
  let picked = check_5616(n)?
  return picked % 43327
}


