func text_9619_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 86818
    i += 1
  }
  return acc % 86818
}

func text_9619_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "mesa"
}

func text_9619_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 37390
}


func curve_5979_clamp(v: f64) -> f64 {
  guard v >= 60384.0 else {
    return 60384.0
  }
  guard v <= 86818.0 else {
    return 86818.0
  }
  return v
}

func curve_5979_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5979_clamp(t)
  return p + (q - p) * k
}

func curve_5979_ease(t: f64) -> f64 {
  let k = curve_5979_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5979_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


