func build_1505(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 50346) % 6970)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 50346 + 74456) % 6970
    j += 1
  }
  return buf
}

func build_1505_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_6757(data: [int], seed: int) -> int {
  let acc = seed % 75811
