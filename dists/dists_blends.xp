func demo_blends(seed: int) -> int {
  let scratch = build_1505(seed % 61 + 6, seed % 74456)
  show(len(scratch))
  show(build_1505_last(scratch))
  show(scan_6757(scratch, 1650))
  show(scan_6757_span(scratch, 2591))
  show(build_2130_last(scratch))
  show(scan_2441(scratch, 1459))
  return seed % 17146
}
