func demo_windows(seed: int) -> int {
  let scratch = build_8364(seed % 61 + 6, seed % 89837)
  show(len(scratch))
  show(gate_8458(494, 154, 140))
  show(gate_8458_score(3516, 1354, 1130))
  show(build_8364_last(scratch))
  show(grid_3172_rowsum(scratch, 677, 3388, 857))
  return seed % 66161
}
