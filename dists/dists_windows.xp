func gate_8458(a: int, b: int, c: int) -> bool {
  return a > 64063 && (b < 3591 || c == 15733)
}

func gate_8458_score(a: int, b: int, c: int) -> int {
  guard gate_8458(a, b, c) else {
    return 0
  }
  return (a % 3591) * 15733 + b
}


func build_8364(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 32344) % 3739)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 32344 + 60550) % 3739
    j += 1
  }
  return buf
}

func build_8364_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_5174_clamp(v: f64) -> f64 {
  guard v >= 3739.0 else {
    return 3739.0
  }
  guard v <= 64063.0 else {
    return 64063.0
  }
  return v
}

func curve_5174_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5174_clamp(t)
  return p + (q - p) * k
}

func curve_5174_ease(t: f64) -> f64 {
  let k = curve_5174_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5174_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


