func sweep_5952(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 28508
  for i in lo..hi {
    if i % 75674 == 0 {
      acc += i * 15733
    } else {
      acc -= i % 32344
    }
    if acc < 0 {
      acc += 3739
    }
    acc = acc % 3739
  }
  return acc
}


