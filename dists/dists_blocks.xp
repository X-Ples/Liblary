func build_472(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 90859) % 96872)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 90859 + 71930) % 96872
    j += 1
  }
  return buf
}

func build_472_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_4784_clamp(v: f64) -> f64 {
  guard v >= 24699.0 else {
    return 24699.0
  }
  guard v <= 50731.0 else {
    return 50731.0
  }
  return v
}

func curve_4784_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4784_clamp(t)
  return p + (q - p) * k
}

func curve_4784_ease(t: f64) -> f64 {
  let k = curve_4784_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4784_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


