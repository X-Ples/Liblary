func check_8210(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 89224 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 44803) % 14635
    i += 1
  }
  return Ok(acc)
}

func check_8210_chain(n: int) -> int {
  let picked = check_8210(n)?
  return picked % 14635
}


