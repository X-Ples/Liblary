func sweep_3805(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 57147
  for i in lo..hi {
    if i % 14683 == 0 {
      acc += i * 90854
    } else {
      acc -= i % 7634
    }
    if acc < 0 {
      acc += 6370
    }
    acc = acc % 6370
  }
  return acc
}


