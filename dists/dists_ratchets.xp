func demo_ratchets(seed: int) -> int {
  let scratch = build_3130(seed % 61 + 6, seed % 97936)
  show(len(scratch))
  show(build_3130_last(scratch))
  show(build_2172_last(scratch))
  show(build_4527_last(scratch))
  return seed % 4108
}
