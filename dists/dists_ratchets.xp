func build_3130(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 70328) % 9315)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 70328 + 8254) % 9315
    j += 1
  }
  return buf
}

func build_3130_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_4480_clamp(v: f64) -> f64 {
  guard v >= 6370.0 else {
    return 6370.0
  }
  guard v <= 18638.0 else {
    return 18638.0
  }
  return v
}

func curve_4480_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4480_clamp(t)
  return p + (q - p) * k
}

func curve_4480_ease(t: f64) -> f64 {
  let k = curve_4480_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4480_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


