func order_7187(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7187_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func row_6051() -> [int] {
  return [345, 3137, 3903, 1082, 579, 2142, 2378, 1195, 1446, 3655, 3610, 900, 314, 2045, 2477, 2838, 3504, 442, 1183]
}

func row_6051_at(i: int) -> int {
  let row = row_6051()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6051_sum(limit: int) -> int {
  let row = row_6051()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6051_best() -> int {
  let row = row_6051()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_9254(data: [int], seed: int) -> int {
  let acc = seed % 82847
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 97936 + data[i] + i) % 82847
    i += 1
  }
  return acc
}

