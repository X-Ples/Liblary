func check_4378(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 66749 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 82847) % 90854
    i += 1
  }
  return Ok(acc)
}

func check_4378_chain(n: int) -> int {
  let picked = check_4378(n)?
  return picked % 90854
}


