func row_4005() -> [int] {
  return [2124, 3586, 2255, 2152, 600, 269, 2730, 70, 1180, 1057, 3426, 991, 3288, 692, 2680, 404, 2049, 2831, 3945]
}

func row_4005_at(i: int) -> int {
  let row = row_4005()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4005_sum(limit: int) -> int {
  let row = row_4005()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4005_best() -> int {
  let row = row_4005()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_5681(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 64127) % 39910)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 64127 + 39910) % 39910
    j += 1
  }
  return buf
}

func build_5681_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_9893_clamp(v: f64) -> f64 {
  guard v >= 21802.0 else {
    return 21802.0
  }
  guard v <= 34356.0 else {
    return 34356.0
  }
  return v
}

func curve_9893_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9893_clamp(t)
  return p + (q - p) * k
}

func curve_9893_ease(t: f64) -> f64 {
  let k = curve_9893_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9893_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func curve_7838_clamp(v: f64) -> f64 {
  guard v >= 42402.0 else {
    return 42402.0
  }
  guard v <= 78088.0 else {
    return 78088.0
  }
