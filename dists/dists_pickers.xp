func sweep_7414(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 16420
  for i in lo..hi {
    if i % 71341 == 0 {
      acc += i * 42402
    } else {
      acc -= i % 78088
    }
    if acc < 0 {
      acc += 35511
    }
    acc = acc % 35511
  }
  return acc
}


