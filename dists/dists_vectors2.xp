func demo_vectors2(seed: int) -> int {
  let scratch = build_3148(seed % 61 + 6, seed % 10167)
  show(len(scratch))
  show(order_6541_find(scratch, 864))
  show(build_3148_last(scratch))
  show(row_7305_at(419))
  return seed % 48241
}
