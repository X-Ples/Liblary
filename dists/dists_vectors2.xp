func order_6541(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6541_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_3148(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 45627) % 83855)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 45627 + 16671) % 83855
    j += 1
  }
  return buf
}

func build_3148_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_7305() -> [int] {
  return [2350, 3109, 2879, 2592, 1068, 3531, 2310, 1971, 702, 1586, 3548, 1772, 3596, 1935, 3561]
}

func row_7305_at(i: int) -> int {
  let row = row_7305()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7305_sum(limit: int) -> int {
  let row = row_7305()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7305_best() -> int {
  let row = row_7305()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_1790(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 81289 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 24036) % 68619
    i += 1
  }
  return Ok(acc)
}

func check_1790_chain(n: int) -> int {
  let picked = check_1790(n)?
  return picked % 68619
}


