func sweep_4883(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 47372
  for i in lo..hi {
    if i % 9240 == 0 {
      acc += i * 98462
    } else {
      acc -= i % 4461
    }
    if acc < 0 {
      acc += 86674
    }
    acc = acc % 86674
  }
  return acc
}


