func scan_2533(data: [int], seed: int) -> int {
  let acc = seed % 19778
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 74924 + data[i] + i) % 19778
    i += 1
  }
  return acc
}

