func demo_ranges(seed: int) -> int {
  let scratch = build_8161(seed % 61 + 6, seed % 5575)
  show(len(scratch))
  show(sweep_3399(3059, 2401))
  show(build_8161_last(scratch))
  show(order_6780_find(scratch, 3821))
  show(gate_4386(662, 2124, 1982))
  return seed % 29930
}
