func sweep_3399(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 68767
  for i in lo..hi {
    if i % 53691 == 0 {
      acc += i * 96186
    } else {
      acc -= i % 6703
    }
    if acc < 0 {
      acc += 41376
    }
    acc = acc % 41376
  }
  return acc
}


func build_8161(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 13874) % 36290)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 13874 + 41376) % 36290
    j += 1
  }
  return buf
}

func build_8161_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_6780(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6780_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_4386(a: int, b: int, c: int) -> bool {
  return a > 96186 && (b < 19778 || c == 36290)
}

func gate_4386_score(a: int, b: int, c: int) -> int {
  guard gate_4386(a, b, c) else {
    return 0
  }
  return (a % 19778) * 36290 + b
}


func grid_1594_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 53745 + c * 44040 + seed) % 44040)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1594_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 44040 == want {
      total += acc
    }
    r += 1
  }
  return total
}


