func curve_3061_clamp(v: f64) -> f64 {
  guard v >= 40763.0 else {
    return 40763.0
  }
  guard v <= 45256.0 else {
    return 45256.0
  }
  return v
}

func curve_3061_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3061_clamp(t)
  return p + (q - p) * k
}

func curve_3061_ease(t: f64) -> f64 {
  let k = curve_3061_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3061_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_6853(data: [int], seed: int) -> int {
  let acc = seed % 20136
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 60005 + data[i] + i) % 20136
    i += 1
  }
  return acc
}

func scan_6853_span(data: [int], seed: int) -> int {
  let acc = scan_6853(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 60005
}


