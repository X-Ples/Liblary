    return 0
  }
  return row[i]
}

func row_5358_sum(limit: int) -> int {
  let row = row_5358()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5358_best() -> int {
