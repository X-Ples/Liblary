func sweep_4417(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 1821
  for i in lo..hi {
    if i % 10742 == 0 {
      acc += i * 4464
    } else {
      acc -= i % 55928
    }
    if acc < 0 {
      acc += 10383
    }
    acc = acc % 10383
  }
  return acc
}


