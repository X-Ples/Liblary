func build_7582(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 50387) % 15645)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 50387 + 25889) % 15645
    j += 1
  }
  return buf
}

func build_7582_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_8650(a: int, b: int, c: int) -> bool {
  return a > 73309 && (b < 54263 || c == 78419)
}

func gate_8650_score(a: int, b: int, c: int) -> int {
  guard gate_8650(a, b, c) else {
    return 0
  }
  return (a % 54263) * 78419 + b
}


func text_2279_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 50387
    i += 1
  }
  return acc % 50387
}

func text_2279_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "ion"
}

func text_2279_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 56136
}


func grid_740_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 4464 + c * 54263 + seed) % 54263)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_740_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 54263 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_2539(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 56136 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 67638) % 80431
    i += 1
  }
  return Ok(acc)
}

func check_2539_chain(n: int) -> int {
  let picked = check_2539(n)?
  return picked % 80431
}


func curve_1052_clamp(v: f64) -> f64 {
  guard v >= 40514.0 else {
    return 40514.0
  }
  guard v <= 78419.0 else {
    return 78419.0
  }
  return v
}

func curve_1052_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1052_clamp(t)
  return p + (q - p) * k
}

func curve_1052_ease(t: f64) -> f64 {
  let k = curve_1052_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1052_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_8094(data: [int], seed: int) -> int {
  let acc = seed % 7176
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 80431 + data[i] + i) % 7176
    i += 1
  }
  return acc
}

func scan_8094_span(data: [int], seed: int) -> int {
  let acc = scan_8094(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 80431
}


