func build_4069(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 11722) % 59274)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 11722 + 9752) % 59274
    j += 1
  }
  return buf
}

func build_4069_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_3375_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 31542 + c * 60190 + seed) % 60190)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3375_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 60190 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_9943_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 8172
    i += 1
  }
  return acc % 8172
}

func text_9943_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "sigma"
  }
  return "bravo"
}

func text_9943_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 54891
}


func gate_4112(a: int, b: int, c: int) -> bool {
  return a > 62070 && (b < 59274 || c == 62070)
}

func gate_4112_score(a: int, b: int, c: int) -> int {
  guard gate_4112(a, b, c) else {
    return 0
  }
  return (a % 59274) * 62070 + b
}


func curve_205_clamp(v: f64) -> f64 {
  guard v >= 65794.0 else {
    return 65794.0
  }
  guard v <= 73051.0 else {
    return 73051.0
  }
  return v
}

func curve_205_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_205_clamp(t)
  return p + (q - p) * k
}

func curve_205_ease(t: f64) -> f64 {
  let k = curve_205_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_205_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


