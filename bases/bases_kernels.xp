func demo_kernels(seed: int) -> int {
  let scratch = build_2090(seed % 61 + 6, seed % 85934)
  show(len(scratch))
  show(build_2090_last(scratch))
  show(scan_3841(scratch, 447))
  show(scan_3841_span(scratch, 2532))
  show(row_493_at(2351))
  show(row_493_sum(2825))
  show(row_493_best())
  return seed % 12715
}
