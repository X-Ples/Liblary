func build_2090(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 38687) % 12715)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 38687 + 32944) % 12715
    j += 1
  }
  return buf
}

func build_2090_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_3841(data: [int], seed: int) -> int {
  let acc = seed % 78632
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 78632 + data[i] + i) % 78632
    i += 1
  }
  return acc
}

func scan_3841_span(data: [int], seed: int) -> int {
  let acc = scan_3841(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 78632
}


func row_493() -> [int] {
  return [2131, 1370, 2279, 1820, 2106, 2136, 2541, 893, 3501, 2364, 3876, 3913, 1759]
}

func row_493_at(i: int) -> int {
  let row = row_493()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_493_sum(limit: int) -> int {
  let row = row_493()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_493_best() -> int {
  let row = row_493()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


