func order_8234(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8234_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func curve_8271_clamp(v: f64) -> f64 {
  guard v >= 48540.0 else {
    return 48540.0
  }
  guard v <= 72125.0 else {
    return 72125.0
  }
  return v
}

func curve_8271_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8271_clamp(t)
  return p + (q - p) * k
}

func curve_8271_ease(t: f64) -> f64 {
  let k = curve_8271_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8271_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_3537_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 16980 + c * 42685 + seed) % 42685)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3537_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 42685 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_1028(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 38687
  for i in lo..hi {
    if i % 73799 == 0 {
      acc += i * 79360
    } else {
      acc -= i % 73799
    }
    if acc < 0 {
      acc += 72125
    }
    acc = acc % 72125
  }
  return acc
}


