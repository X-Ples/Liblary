func check_3715(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 6808 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 12715) % 6808
    i += 1
  }
  return Ok(acc)
}

func check_3715_chain(n: int) -> int {
  let picked = check_3715(n)?
  return picked % 6808
}


