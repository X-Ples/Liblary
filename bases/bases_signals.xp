const K0 = 93825
const K1 = 68514
const K2 = 24246
const K3 = 72412
const K4 = 62016
const K5 = 81096
const K6 = 20793

func build_3277(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 20542) % 63688)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 20542 + 93825) % 63688
    j += 1
  }
  return buf
}

func build_3277_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_1164_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 97652 + c * 80807 + seed) % 80807)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1164_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 80807 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_1421(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 85141
  for i in lo..hi {
    if i % 97652 == 0 {
      acc += i * 6191
    } else {
      acc -= i % 85141
    }
    if acc < 0 {
      acc += 81096
    }
    acc = acc % 81096
  }
  return acc
}


func scan_7960(data: [int], seed: int) -> int {
  let acc = seed % 93825
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 63688 + data[i] + i) % 93825
    i += 1
  }
  return acc
}

func scan_7960_span(data: [int], seed: int) -> int {
  let acc = scan_7960(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 63688
}


func curve_7261_clamp(v: f64) -> f64 {
  guard v >= 32782.0 else {
    return 32782.0
  }
  guard v <= 63688.0 else {
    return 63688.0
  }
  return v
}

func curve_7261_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7261_clamp(t)
  return p + (q - p) * k
}

func curve_7261_ease(t: f64) -> f64 {
  let k = curve_7261_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7261_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_5296(a: int, b: int, c: int) -> bool {
  return a > 62016 && (b < 65341 || c == 92980)
}

func gate_5296_score(a: int, b: int, c: int) -> int {
  guard gate_5296(a, b, c) else {
    return 0
  }
  return (a % 65341) * 92980 + b
}


