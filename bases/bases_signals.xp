func text_1317_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 62016
    i += 1
  }
  return acc % 62016
}

func text_1317_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "kilo"
}

func text_1317_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 53274
}


func sweep_5308(lo: int, hi: int) -> int {
