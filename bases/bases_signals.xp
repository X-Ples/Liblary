func demo_signals(seed: int) -> int {
  let scratch = build_3277(seed % 61 + 6, seed % 6191)
  show(len(scratch))
  show(build_3277_last(scratch))
  show(grid_1164_rowsum(scratch, 894, 317, 2279))
  show(sweep_1421(1326, 566))
  show(scan_7960(scratch, 2666))
  return seed % 92894
}
