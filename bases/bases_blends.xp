const K0 = 8001
const K1 = 70008
const K2 = 80365
const K3 = 70008
const K4 = 83719
const K5 = 10290
const K6 = 11631
const K7 = 18691
const K8 = 15904

func gate_2100(a: int, b: int, c: int) -> bool {
  return a > 8395 && (b < 70008 || c == 40601)
}

func gate_2100_score(a: int, b: int, c: int) -> int {
  guard gate_2100(a, b, c) else {
    return 0
  }
  return (a % 70008) * 40601 + b
}


func scan_477(data: [int], seed: int) -> int {
  let acc = seed % 57981
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 25160 + data[i] + i) % 57981
    i += 1
  }
  return acc
}

func scan_477_span(data: [int], seed: int) -> int {
  let acc = scan_477(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 25160
}


func build_8408(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 62040) % 52898)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 62040 + 2979) % 52898
    j += 1
  }
  return buf
}

func build_8408_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_2933_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 11631 + c * 81442 + seed) % 81442)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2933_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 81442 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_9691_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 81442
    i += 1
  }
  return acc % 81442
}

func text_9691_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "alpha"
}

func text_9691_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 62040
}


func curve_9803_clamp(v: f64) -> f64 {
  guard v >= 10290.0 else {
    return 10290.0
  }
  guard v <= 11631.0 else {
    return 11631.0
  }
  return v
}

func curve_9803_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9803_clamp(t)
  return p + (q - p) * k
}

func curve_9803_ease(t: f64) -> f64 {
  let k = curve_9803_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9803_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


