func row_9175() -> [int] {
  return [3700, 2707, 1856, 590, 3767, 179, 1203, 3024, 2329, 1112, 3680, 1509, 338, 2761, 1004, 3318, 3855, 348]
}

func row_9175_at(i: int) -> int {
  let row = row_9175()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9175_sum(limit: int) -> int {
  let row = row_9175()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9175_best() -> int {
  let row = row_9175()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


