func demo_blends(seed: int) -> int {
  let scratch = build_8408(seed % 61 + 6, seed % 81442)
  show(len(scratch))
  show(gate_2100(2635, 3683, 3987))
  show(gate_2100_score(1149, 2759, 219))
  show(scan_477(scratch, 1292))
  return seed % 20110
}
