}

func row_9852_at(i: int) -> int {
  let row = row_9852()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9852_sum(limit: int) -> int {
  let row = row_9852()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9852_best() -> int {
  let row = row_9852()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_5118(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 635
  for i in lo..hi {
    if i % 19775 == 0 {
      acc += i * 5803
    } else {
      acc -= i % 77129
    }
    if acc < 0 {
      acc += 36344
    }
    acc = acc % 36344
  }
  return acc
}


