func demo_trims(seed: int) -> int {
  let scratch = build_2386(seed % 61 + 6, seed % 3246)
  show(len(scratch))
  show(build_2386_last(scratch))
  show(gate_2368(1398, 3005, 945))
  show(gate_2368_score(1140, 3878, 785))
  show(scan_1931(scratch, 3596))
  return seed % 50714
}
