func build_2386(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 56400) % 90449)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 56400 + 79759) % 90449
    j += 1
  }
  return buf
}

func build_2386_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_2368(a: int, b: int, c: int) -> bool {
  return a > 77129 && (b < 5803 || c == 35774)
}

func gate_2368_score(a: int, b: int, c: int) -> int {
  guard gate_2368(a, b, c) else {
    return 0
  }
  return (a % 5803) * 35774 + b
}


func scan_1931(data: [int], seed: int) -> int {
  let acc = seed % 36479
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 54513 + data[i] + i) % 36479
    i += 1
  }
  return acc
}

func scan_1931_span(data: [int], seed: int) -> int {
  let acc = scan_1931(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 54513
}


func gate_5852(a: int, b: int, c: int) -> bool {
  return a > 90449 && (b < 28898 || c == 5803)
}

func gate_5852_score(a: int, b: int, c: int) -> int {
  guard gate_5852(a, b, c) else {
    return 0
  }
  return (a % 28898) * 5803 + b
}


func order_5203(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5203_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_6481_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 28898
    i += 1
  }
  return acc % 28898
}

func text_6481_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "mesa"
}

func text_6481_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 28898
}


func grid_9513_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 53357 + c * 11699 + seed) % 11699)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9513_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 11699 == want {
      total += acc
    }
    r += 1
  }
  return total
}


