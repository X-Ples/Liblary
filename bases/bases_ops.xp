func build_8943(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 39023) % 61202)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 39023 + 26270) % 61202
    j += 1
  }
  return buf
}

func build_8943_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_2945(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2945_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_4798(a: int, b: int, c: int) -> bool {
  return a > 72777 && (b < 17503 || c == 23744)
}

func gate_4798_score(a: int, b: int, c: int) -> int {
  guard gate_4798(a, b, c) else {
    return 0
  }
  return (a % 17503) * 23744 + b
}


func sweep_5968(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 52556
  for i in lo..hi {
    if i % 52556 == 0 {
      acc += i * 59643
    } else {
      acc -= i % 61202
    }
    if acc < 0 {
      acc += 61202
    }
    acc = acc % 61202
  }
  return acc
}


