func demo_ops(seed: int) -> int {
  let scratch = build_8943(seed % 61 + 6, seed % 42401)
  show(len(scratch))
  show(build_8943_last(scratch))
  show(order_2945_find(scratch, 2052))
  show(gate_4798(2207, 3477, 2439))
  show(gate_4798_score(767, 1430, 1305))
  show(sweep_5968(929, 2333))
  return seed % 72777
}
