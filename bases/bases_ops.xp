func check_1268(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 17503 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 17503) % 65852
    i += 1
  }
  return Ok(acc)
}

func check_1268_chain(n: int) -> int {
  let picked = check_1268(n)?
  return picked % 65852
}


