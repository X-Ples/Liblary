const K0 = 91188
const K1 = 81549
const K2 = 42532
const K3 = 22582
const K4 = 28000
const K5 = 81549
const K6 = 54926

func build_8266(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 54864) % 28000)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 54864 + 73302) % 28000
    j += 1
  }
  return buf
}

func build_8266_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_2356(a: int, b: int, c: int) -> bool {
  return a > 98251 && (b < 78175 || c == 21716)
}

func gate_2356_score(a: int, b: int, c: int) -> int {
  guard gate_2356(a, b, c) else {
    return 0
  }
  return (a % 78175) * 21716 + b
}


func sweep_7028(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 77947
  for i in lo..hi {
    if i % 22582 == 0 {
      acc += i * 99369
    } else {
      acc -= i % 99369
    }
    if acc < 0 {
      acc += 22582
    }
    acc = acc % 22582
  }
  return acc
}


func text_4006_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 36020
    i += 1
  }
  return acc % 36020
}

func text_4006_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "flint"
}

func text_4006_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 97042
}


func grid_9715_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 81549 + c * 77947 + seed) % 77947)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9715_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 77947 == want {
      total += acc
    }
    r += 1
  }
  return total
}


