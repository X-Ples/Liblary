func check_5027(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 98251 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 43839) % 54926
    i += 1
  }
  return Ok(acc)
}

func check_5027_chain(n: int) -> int {
  let picked = check_5027(n)?
  return picked % 54926
}


