func row_5210() -> [int] {
  return [3213, 2492, 3696, 3646, 1924, 3406, 1242, 2033, 3479, 2121, 769, 2404]
}

func row_5210_at(i: int) -> int {
  let row = row_5210()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5210_sum(limit: int) -> int {
  let row = row_5210()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5210_best() -> int {
  let row = row_5210()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


