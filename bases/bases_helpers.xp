func demo_helpers(seed: int) -> int {
  let scratch = build_8266(seed % 61 + 6, seed % 55679)
  show(len(scratch))
  show(build_8266_last(scratch))
  show(gate_2356(2141, 1013, 1624))
  show(gate_2356_score(3300, 2354, 2064))
  return seed % 54864
}
