func sweep_182(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 53117
  for i in lo..hi {
    if i % 24906 == 0 {
      acc += i * 72579
    } else {
      acc -= i % 25110
    }
    if acc < 0 {
      acc += 17734
    }
    acc = acc % 17734
  }
  return acc
}


func build_2583(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 17734) % 49381)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 17734 + 49909) % 49381
    j += 1
  }
  return buf
}

func build_2583_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_7117(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7117_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func scan_6610(data: [int], seed: int) -> int {
  let acc = seed % 76496
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 72579 + data[i] + i) % 76496
    i += 1
  }
  return acc
}

func scan_6610_span(data: [int], seed: int) -> int {
  let acc = scan_6610(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 72579
}


