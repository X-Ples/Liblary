func check_4381(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 57036 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 83691) % 44856
    i += 1
  }
  return Ok(acc)
}

func check_4381_chain(n: int) -> int {
  let picked = check_4381(n)?
  return picked % 44856
}


