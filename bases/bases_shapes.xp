func build_845(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 19299) % 26212)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 19299 + 64992) % 26212
    j += 1
  }
  return buf
}

func build_845_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_1477(data: [int], seed: int) -> int {
  let acc = seed % 99944
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 25397 + data[i] + i) % 99944
    i += 1
  }
  return acc
}

func scan_1477_span(data: [int], seed: int) -> int {
  let acc = scan_1477(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 25397
}


func row_5530() -> [int] {
  return [336, 2399, 1706, 2199, 1420, 876, 807, 2195, 313, 2189, 882, 1946, 3215, 2744, 2439]
}

func row_5530_at(i: int) -> int {
  let row = row_5530()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5530_sum(limit: int) -> int {
  let row = row_5530()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5530_best() -> int {
  let row = row_5530()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_4703(a: int, b: int, c: int) -> bool {
  return a > 76137 && (b < 26212 || c == 77855)
}

func gate_4703_score(a: int, b: int, c: int) -> int {
  guard gate_4703(a, b, c) else {
    return 0
  }
  return (a % 26212) * 77855 + b
}


func grid_6817_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 57012 + c * 95472 + seed) % 95472)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6817_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 95472 == want {
      total += acc
    }
    r += 1
  }
  return total
}


