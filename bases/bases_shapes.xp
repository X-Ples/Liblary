func demo_shapes(seed: int) -> int {
  let scratch = build_845(seed % 61 + 6, seed % 44771)
  show(len(scratch))
  show(build_845_last(scratch))
  show(scan_1477(scratch, 1805))
  show(scan_1477_span(scratch, 2757))
  show(row_5530_at(880))
  show(row_5530_sum(3727))
  show(row_5530_best())
  return seed % 44771
}
