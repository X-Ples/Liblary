func sweep_6001(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 25397
  for i in lo..hi {
    if i % 14486 == 0 {
      acc += i * 25397
    } else {
      acc -= i % 44771
    }
    if acc < 0 {
      acc += 69899
    }
    acc = acc % 69899
  }
