func row_812() -> [int] {
  return [2542, 984, 1880, 835, 932, 1647, 2347, 3880, 2319, 1665, 2209]
}

func row_812_at(i: int) -> int {
  let row = row_812()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_812_sum(limit: int) -> int {
  let row = row_812()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_812_best() -> int {
  let row = row_812()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


