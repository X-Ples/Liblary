func check_5074(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 10856 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 72746) % 12553
    i += 1
  }
  return Ok(acc)
}

func check_5074_chain(n: int) -> int {
  let picked = check_5074(n)?
  return picked % 12553
}


