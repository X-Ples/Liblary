func demo_ratchets(seed: int) -> int {
  let scratch = build_2688(seed % 61 + 6, seed % 21393)
  show(len(scratch))
  show(build_2688_last(scratch))
  show(text_4291_weight("alpha"))
  show(text_4291_label(1623))
  return seed % 59300
}
