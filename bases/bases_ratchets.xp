func sweep_9891(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 51667
  for i in lo..hi {
    if i % 2909 == 0 {
      acc += i * 74282
    } else {
      acc -= i % 37890
    }
    if acc < 0 {
      acc += 1622
    }
    acc = acc % 1622
  }
  return acc
}


