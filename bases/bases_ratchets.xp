func scan_2190(data: [int], seed: int) -> int {
  let acc = seed % 18261
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 97949 + data[i] + i) % 18261
    i += 1
  }
  return acc
}

