func gate_1147(a: int, b: int, c: int) -> bool {
  return a > 33036 && (b < 89433 || c == 81733)
}

func gate_1147_score(a: int, b: int, c: int) -> int {
  guard gate_1147(a, b, c) else {
    return 0
  }
  return (a % 89433) * 81733 + b
}


func row_9069() -> [int] {
  return [2736, 481, 4084, 770, 3012, 1355, 2703, 2488, 254, 1964, 1147, 3134, 3704, 547, 668, 2866, 2004, 2883, 1637, 555]
}

func row_9069_at(i: int) -> int {
  let row = row_9069()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9069_sum(limit: int) -> int {
  let row = row_9069()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9069_best() -> int {
  let row = row_9069()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_4011(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 75846) % 75319)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 75846 + 75846) % 75319
    j += 1
  }
  return buf
}

func build_4011_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_4680(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4680_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_4855(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 33036
  for i in lo..hi {
    if i % 28441 == 0 {
      acc += i * 75846
    } else {
      acc -= i % 89433
    }
    if acc < 0 {
      acc += 30798
    }
    acc = acc % 30798
  }
  return acc
}


