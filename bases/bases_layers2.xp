func check_2403(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 29682 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 76568) % 34934
    i += 1
  }
  return Ok(acc)
}

func check_2403_chain(n: int) -> int {
  let picked = check_2403(n)?
  return picked % 34934
}


