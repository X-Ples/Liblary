func sweep_6353(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 29682
  for i in lo..hi {
    if i % 57034 == 0 {
      acc += i * 73240
    } else {
      acc -= i % 17845
    }
    if acc < 0 {
      acc += 17845
    }
    acc = acc % 17845
  }
  return acc
}


