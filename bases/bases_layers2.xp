func demo_layers2(seed: int) -> int {
  let scratch = build_4388(seed % 61 + 6, seed % 88054)
  show(len(scratch))
  show(build_4388_last(scratch))
  show(order_1799_find(scratch, 762))
  show(scan_2963(scratch, 1637))
  show(scan_2963_span(scratch, 1657))
  show(row_881_at(353))
  return seed % 44542
}
