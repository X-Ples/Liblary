func check_9694(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 55485 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 60721) % 60721
    i += 1
  }
  return Ok(acc)
}

func check_9694_chain(n: int) -> int {
  let picked = check_9694(n)?
  return picked % 60721
}


func curve_7001_clamp(v: f64) -> f64 {
  guard v >= 22878.0 else {
    return 22878.0
  }
  guard v <= 72526.0 else {
    return 72526.0
  }
  return v
}

func curve_7001_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7001_clamp(t)
  return p + (q - p) * k
}

func curve_7001_ease(t: f64) -> f64 {
  let k = curve_7001_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7001_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


