}


func row_3303() -> [int] {
  return [1950, 1027, 1018, 287, 776, 76, 3024, 2337, 2019, 3632, 3490, 1446, 2190, 3676, 1386]
}

func row_3303_at(i: int) -> int {
  let row = row_3303()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3303_sum(limit: int) -> int {
  let row = row_3303()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3303_best() -> int {
  let row = row_3303()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


