func text_5351_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 5300
    i += 1
  }
  return acc % 5300
}

func text_5351_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "sigma"
}

func text_5351_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 391
}


