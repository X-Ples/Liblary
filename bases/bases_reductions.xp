func demo_reductions(seed: int) -> int {
  let scratch = build_3496(seed % 61 + 6, seed % 73143)
  show(len(scratch))
  show(scan_165(scratch, 2464))
  show(scan_165_span(scratch, 3277))
  show(build_3496_last(scratch))
  show(text_5351_weight("sigma"))
  show(text_5351_label(2634))
  show(text_5351_has("ridge"))
  return seed % 96387
}
