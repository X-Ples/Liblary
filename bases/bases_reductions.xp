const K0 = 63874
const K1 = 98148
const K2 = 15441
const K3 = 78332
const K4 = 33145
const K5 = 98588
const K6 = 96387
const K7 = 391

func scan_165(data: [int], seed: int) -> int {
  let acc = seed % 57501
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 10993 + data[i] + i) % 57501
    i += 1
  }
  return acc
}

func scan_165_span(data: [int], seed: int) -> int {
  let acc = scan_165(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 10993
}


func build_3496(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 82304) % 391)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 82304 + 12883) % 391
    j += 1
  }
  return buf
}

func build_3496_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_8512_clamp(v: f64) -> f64 {
  guard v >= 6833.0 else {
    return 6833.0
  }
  guard v <= 98148.0 else {
    return 98148.0
  }
  return v
}

func curve_8512_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8512_clamp(t)
  return p + (q - p) * k
}

func curve_8512_ease(t: f64) -> f64 {
  let k = curve_8512_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8512_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


