func check_3465(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 99042 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 14886) % 62450
    i += 1
  }
  return Ok(acc)
}

func check_3465_chain(n: int) -> int {
  let picked = check_3465(n)?
  return picked % 62450
}


func row_9600() -> [int] {
  return [2761, 3933, 2244, 578, 2807, 1401, 2547, 2313, 1359, 1725, 946, 1831, 33, 3880, 3467, 2242, 1274, 3828, 1849, 567]
}

func row_9600_at(i: int) -> int {
  let row = row_9600()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9600_sum(limit: int) -> int {
  let row = row_9600()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9600_best() -> int {
  let row = row_9600()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


