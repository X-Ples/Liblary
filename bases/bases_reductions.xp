func sweep_3585(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 9867
  for i in lo..hi {
    if i % 391 == 0 {
      acc += i * 34664
    } else {
      acc -= i % 18914
    }
    if acc < 0 {
      acc += 14886
    }
    acc = acc % 14886
  }
  return acc
}


