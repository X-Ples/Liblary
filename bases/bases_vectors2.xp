func demo_vectors2(seed: int) -> int {
  let scratch = build_250(seed % 61 + 6, seed % 15796)
  show(len(scratch))
  show(build_250_last(scratch))
  show(check_2268_chain(735))
  show(scan_5290(scratch, 2390))
  show(scan_5290_span(scratch, 662))
  show(text_8323_weight("flint"))
  return seed % 58381
}
