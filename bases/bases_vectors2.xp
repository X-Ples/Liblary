func sweep_2736(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 34697
  for i in lo..hi {
    if i % 15796 == 0 {
      acc += i * 45437
    } else {
      acc -= i % 76272
    }
    if acc < 0 {
      acc += 15796
    }
    acc = acc % 15796
  }
  return acc
}


