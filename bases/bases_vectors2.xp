func build_250(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 50206) % 14317)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 50206 + 25168) % 14317
    j += 1
  }
  return buf
}

func build_250_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_2268(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 61270 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 30909) % 88051
    i += 1
  }
  return Ok(acc)
}

func check_2268_chain(n: int) -> int {
  let picked = check_2268(n)?
  return picked % 88051
}


func scan_5290(data: [int], seed: int) -> int {
  let acc = seed % 52919
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 45004 + data[i] + i) % 52919
    i += 1
  }
  return acc
}

func scan_5290_span(data: [int], seed: int) -> int {
  let acc = scan_5290(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 45004
}


func text_8323_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 15796
    i += 1
  }
  return acc % 15796
}

func text_8323_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "flint"
}

func text_8323_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 40616
}


