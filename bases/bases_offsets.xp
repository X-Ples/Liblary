func build_7285(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 19085) % 70152)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 19085 + 96863) % 70152
    j += 1
  }
  return buf
}

func build_7285_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_4998() -> [int] {
  return [4078, 1779, 2338, 2052, 2162, 2185, 3449, 645, 1774, 3298, 1564, 4042, 2419, 2231, 629, 1440, 802, 1678, 2448, 587]
}

func row_4998_at(i: int) -> int {
  let row = row_4998()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4998_sum(limit: int) -> int {
  let row = row_4998()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4998_best() -> int {
  let row = row_4998()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_4804(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4804_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_9290_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 30028
    i += 1
  }
  return acc % 30028
}

func text_9290_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "bravo"
}

func text_9290_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 96863
}


func curve_567_clamp(v: f64) -> f64 {
  guard v >= 19020.0 else {
    return 19020.0
  }
  guard v <= 70152.0 else {
    return 70152.0
  }
  return v
}

func curve_567_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_567_clamp(t)
  return p + (q - p) * k
}

func curve_567_ease(t: f64) -> f64 {
  let k = curve_567_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_567_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_6609(data: [int], seed: int) -> int {
  let acc = seed % 19020
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 80098 + data[i] + i) % 19020
    i += 1
  }
  return acc
}

func scan_6609_span(data: [int], seed: int) -> int {
  let acc = scan_6609(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 80098
}


func check_4198(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 80951 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 69140) % 73690
    i += 1
  }
  return Ok(acc)
}

func check_4198_chain(n: int) -> int {
  let picked = check_4198(n)?
  return picked % 73690
}


