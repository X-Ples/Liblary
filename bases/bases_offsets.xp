func sweep_2229(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 62351
  for i in lo..hi {
    if i % 73690 == 0 {
      acc += i * 69140
    } else {
      acc -= i % 30929
    }
    if acc < 0 {
      acc += 80098
    }
    acc = acc % 80098
  }
  return acc
}


