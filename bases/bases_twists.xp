func grid_2165_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 16522 + c * 53613 + seed) % 53613)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2165_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 53613 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_662(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 16522) % 96642)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 16522 + 85381) % 96642
    j += 1
  }
  return buf
}

func build_662_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_3379(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10390
  for i in lo..hi {
    if i % 21642 == 0 {
      acc += i * 29918
    } else {
      acc -= i % 22649
    }
    if acc < 0 {
      acc += 65591
    }
    acc = acc % 65591
  }
  return acc
}


func check_4557(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 70635 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 30703) % 40079
    i += 1
  }
  return Ok(acc)
}

func check_4557_chain(n: int) -> int {
  let picked = check_4557(n)?
  return picked % 40079
}


