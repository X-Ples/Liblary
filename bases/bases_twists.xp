func text_3405_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 10390
    i += 1
  }
  return acc % 10390
}

func text_3405_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "jetty"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "kilo"
}

func text_3405_has(tag: str) -> bool {
  return str_contains(tag, "jetty") || len(tag) > 82611
}


func demo_twists(seed: int) -> int {
  let scratch = build_662(seed % 61 + 6, seed % 53613)
  show(len(scratch))
  show(grid_2165_rowsum(scratch, 2364, 2975, 565))
  show(build_662_last(scratch))
  show(sweep_3379(635, 1310))
  show(check_4557_chain(3953))
  return seed % 8467
}
