func gate_5602(a: int, b: int, c: int) -> bool {
  return a > 41161 && (b < 78977 || c == 61497)
}

func gate_5602_score(a: int, b: int, c: int) -> int {
  guard gate_5602(a, b, c) else {
    return 0
  }
  return (a % 78977) * 61497 + b
}


