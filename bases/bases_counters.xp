func text_8462_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 26092
    i += 1
  }
  return acc % 26092
}

func text_8462_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "gamma"
}

func text_8462_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 61560
}


