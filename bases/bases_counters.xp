func curve_2059_clamp(v: f64) -> f64 {
  guard v >= 26092.0 else {
    return 26092.0
  }
  guard v <= 77524.0 else {
    return 77524.0
  }
  return v
}

func curve_2059_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2059_clamp(t)
  return p + (q - p) * k
}

func curve_2059_ease(t: f64) -> f64 {
  let k = curve_2059_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2059_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_counters(seed: int) -> int {
  let scratch = build_4384(seed % 61 + 6, seed % 60620)
  show(len(scratch))
  show(build_4384_last(scratch))
  show(check_8130_chain(132))
  show(check_4898_chain(332))
  show(sweep_3454(2558, 3035))
  show(order_6480_find(scratch, 1834))
  return seed % 61497
}
