func build_4384(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 24166) % 80912)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 24166 + 24166) % 80912
    j += 1
  }
  return buf
}

func build_4384_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_8130(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 2070 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 35271) % 48479
    i += 1
  }
  return Ok(acc)
}

func check_8130_chain(n: int) -> int {
  let picked = check_8130(n)?
  return picked % 48479
}


