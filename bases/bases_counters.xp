func sweep_3454(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 88305
  for i in lo..hi {
    if i % 60620 == 0 {
      acc += i * 30369
    } else {
      acc -= i % 26092
    }
    if acc < 0 {
      acc += 78977
    }
    acc = acc % 78977
  }
  return acc
}


func order_6480(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6480_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func scan_1721(data: [int], seed: int) -> int {
  let acc = seed % 711
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 37574 + data[i] + i) % 711
    i += 1
  }
  return acc
}

func scan_1721_span(data: [int], seed: int) -> int {
  let acc = scan_1721(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 37574
}


