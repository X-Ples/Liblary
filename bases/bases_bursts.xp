func demo_bursts(seed: int) -> int {
  let scratch = build_6803(seed % 61 + 6, seed % 58016)
  show(len(scratch))
  show(check_8774_chain(2387))
  show(build_6803_last(scratch))
  show(check_1092_chain(1226))
