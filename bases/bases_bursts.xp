func check_8774(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 66642 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 45669) % 41709
    i += 1
  }
  return Ok(acc)
}

func check_8774_chain(n: int) -> int {
  let picked = check_8774(n)?
  return picked % 41709
}


func build_6803(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 88210) % 66642)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 88210 + 28138) % 66642
    j += 1
  }
  return buf
}

func build_6803_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


