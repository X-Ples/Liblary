func demo_quarks(seed: int) -> int {
  let scratch = build_9638(seed % 61 + 6, seed % 74325)
  show(len(scratch))
  show(grid_7611_rowsum(scratch, 2688, 3190, 72))
  show(scan_127(scratch, 439))
  show(scan_127_span(scratch, 1556))
  show(gate_8735(1281, 1386, 145))
  show(gate_8735_score(1600, 2182, 2774))
  show(gate_6500(32, 866, 3716))
  return seed % 32357
}
