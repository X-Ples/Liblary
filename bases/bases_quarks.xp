func check_5557(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 33850 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 65482) % 53832
    i += 1
  }
  return Ok(acc)
}

func check_5557_chain(n: int) -> int {
  let picked = check_5557(n)?
  return picked % 53832
}


