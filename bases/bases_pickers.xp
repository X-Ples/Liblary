func demo_pickers(seed: int) -> int {
  let scratch = build_2236(seed % 61 + 6, seed % 98170)
  show(len(scratch))
  show(scan_4296(scratch, 1089))
  show(scan_4296_span(scratch, 2059))
  show(build_2236_last(scratch))
  show(grid_3443_rowsum(scratch, 838, 3437, 2394))
  show(scan_2513(scratch, 3345))
  show(scan_2513_span(scratch, 2599))
  return seed % 94577
}
