func sweep_6869(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 89577
  for i in lo..hi {
    if i % 6168 == 0 {
      acc += i * 31632
    } else {
      acc -= i % 86036
    }
    if acc < 0 {
      acc += 94577
    }
    acc = acc % 94577
  }
  return acc
}


