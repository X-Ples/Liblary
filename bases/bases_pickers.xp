}

func row_5939_sum(limit: int) -> int {
  let row = row_5939()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5939_best() -> int {
  let row = row_5939()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
