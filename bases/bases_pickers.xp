func check_5807(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 98170 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 76517) % 53346
    i += 1
  }
  return Ok(acc)
}

func check_5807_chain(n: int) -> int {
  let picked = check_5807(n)?
  return picked % 53346
}


