func scan_4296(data: [int], seed: int) -> int {
  let acc = seed % 74901
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 31632 + data[i] + i) % 74901
    i += 1
  }
  return acc
}

func scan_4296_span(data: [int], seed: int) -> int {
  let acc = scan_4296(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 31632
}


