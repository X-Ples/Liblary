func row_4840() -> [int] {
  return [3267, 294, 415, 1754, 2944, 366, 2642, 283, 1603, 1283, 3848, 3313, 2496, 3937, 635, 2449, 1708, 281, 3909, 2030, 349]
}

func row_4840_at(i: int) -> int {
  let row = row_4840()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4840_sum(limit: int) -> int {
  let row = row_4840()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4840_best() -> int {
  let row = row_4840()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_796(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 18865) % 17005)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 18865 + 28976) % 17005
    j += 1
  }
  return buf
}

func build_796_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_1183_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 6321
    i += 1
  }
  return acc % 6321
}

func text_1183_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "ion"
}

func text_1183_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 76436
}


func scan_1110(data: [int], seed: int) -> int {
  let acc = seed % 36382
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 63450 + data[i] + i) % 36382
    i += 1
  }
  return acc
}

func scan_1110_span(data: [int], seed: int) -> int {
  let acc = scan_1110(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 63450
}


func sweep_9594(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 78096
  for i in lo..hi {
    if i % 28976 == 0 {
      acc += i * 28976
    } else {
      acc -= i % 76436
    }
    if acc < 0 {
      acc += 16663
    }
    acc = acc % 16663
  }
  return acc
}


func order_912(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_912_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


