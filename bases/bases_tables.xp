    array_push(buf, (start + i * 5258) % 29214)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 5258 + 66111) % 29214
    j += 1
  }
  return buf
}

func build_7889_last(buf: [int]) -> int {
