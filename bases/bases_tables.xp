func demo_tables(seed: int) -> int {
  let scratch = build_7889(seed % 61 + 6, seed % 5258)
  show(len(scratch))
  show(gate_7041(2149, 940, 3739))
  show(gate_7041_score(2241, 2661, 3665))
  show(build_7889_last(scratch))
  show(gate_4862(2917, 1899, 610))
  show(gate_4862_score(1668, 2439, 1599))
  return seed % 10943
}
