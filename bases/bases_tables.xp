func curve_488_clamp(v: f64) -> f64 {
  guard v >= 14820.0 else {
    return 14820.0
  }
  guard v <= 58841.0 else {
    return 58841.0
  }
  return v
}

func curve_488_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_488_clamp(t)
  return p + (q - p) * k
}

func curve_488_ease(t: f64) -> f64 {
  let k = curve_488_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_488_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


