func text_411_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 34132
    i += 1
  }
  return acc % 34132
}

func text_411_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "omega"
}

func text_411_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 67880
}


func build_4595(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 72759) % 31190)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 72759 + 47906) % 31190
    j += 1
  }
  return buf
}

func build_4595_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_9362(n: int) -> Result<int, str> {
