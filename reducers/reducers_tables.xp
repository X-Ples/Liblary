func demo_tables(seed: int) -> int {
  let scratch = build_781(seed % 61 + 6, seed % 88138)
  show(len(scratch))
  show(build_781_last(scratch))
  show(grid_688_rowsum(scratch, 1114, 3779, 24))
  show(gate_2607(668, 599, 3826))
  show(gate_2607_score(2806, 3634, 1972))
  return seed % 31753
}
