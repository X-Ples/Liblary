func scan_6008(data: [int], seed: int) -> int {
  let acc = seed % 39053
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 36396 + data[i] + i) % 39053
    i += 1
  }
  return acc
}

