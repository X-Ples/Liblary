func build_781(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 39844) % 84523)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 39844 + 34822) % 84523
    j += 1
  }
  return buf
}

func build_781_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_688_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 12708 + c * 8251 + seed) % 8251)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_688_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 8251 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_2607(a: int, b: int, c: int) -> bool {
  return a > 24084 && (b < 91458 || c == 13013)
}

func gate_2607_score(a: int, b: int, c: int) -> int {
  guard gate_2607(a, b, c) else {
    return 0
  }
  return (a % 91458) * 13013 + b
}


func sweep_7945(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 38584
  for i in lo..hi {
    if i % 41254 == 0 {
      acc += i * 84523
    } else {
      acc -= i % 24084
    }
    if acc < 0 {
      acc += 12069
    }
    acc = acc % 12069
  }
  return acc
}


func check_5680(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 24084 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 28857) % 84523
    i += 1
  }
  return Ok(acc)
}

func check_5680_chain(n: int) -> int {
  let picked = check_5680(n)?
  return picked % 84523
}


func curve_388_clamp(v: f64) -> f64 {
  guard v >= 34822.0 else {
    return 34822.0
  }
  guard v <= 41254.0 else {
    return 41254.0
  }
  return v
}

func curve_388_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_388_clamp(t)
  return p + (q - p) * k
}

func curve_388_ease(t: f64) -> f64 {
  let k = curve_388_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_388_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


