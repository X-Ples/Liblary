func demo_core(seed: int) -> int {
  let scratch = build_3971(seed % 61 + 6, seed % 29775)
  show(len(scratch))
  show(sweep_4940(2586, 982))
  show(build_3971_last(scratch))
  show(scan_262(scratch, 572))
  show(scan_262_span(scratch, 3044))
  show(sweep_2126(525, 2466))
  return seed % 94919
}
