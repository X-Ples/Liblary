func row_6685() -> [int] {
  return [1832, 3068, 2023, 205, 1610, 3000, 2946, 1392, 2539, 2076, 3864, 2624, 2912, 1184, 1826, 89, 3589, 3131, 3022, 339, 2655]
}

func row_6685_at(i: int) -> int {
  let row = row_6685()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6685_sum(limit: int) -> int {
  let row = row_6685()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6685_best() -> int {
  let row = row_6685()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


