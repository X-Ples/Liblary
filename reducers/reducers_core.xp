func sweep_4940(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 51193
  for i in lo..hi {
    if i % 7934 == 0 {
      acc += i * 42119
    } else {
      acc -= i % 47690
    }
    if acc < 0 {
      acc += 95165
    }
    acc = acc % 95165
  }
  return acc
}


func build_3971(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 42119) % 70022)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 42119 + 4400) % 70022
    j += 1
  }
  return buf
}

func build_3971_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_262(data: [int], seed: int) -> int {
  let acc = seed % 29775
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 7934 + data[i] + i) % 29775
    i += 1
  }
  return acc
}

func scan_262_span(data: [int], seed: int) -> int {
  let acc = scan_262(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 7934
}


