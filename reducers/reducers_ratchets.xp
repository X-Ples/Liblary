func demo_ratchets(seed: int) -> int {
  let scratch = build_8774(seed % 61 + 6, seed % 99843)
  show(len(scratch))
  show(gate_7782(2669, 1124, 3212))
  show(gate_7782_score(1865, 841, 3447))
  show(build_8774_last(scratch))
  show(check_8947_chain(2023))
  return seed % 85874
}
