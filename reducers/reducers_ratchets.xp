func build_8774(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 18947) % 92603)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 18947 + 9248) % 92603
    j += 1
  }
  return buf
}

func build_8774_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_8947(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 92057 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 35648) % 47897
    i += 1
  }
  return Ok(acc)
}

func check_8947_chain(n: int) -> int {
  let picked = check_8947(n)?
  return picked % 47897
}


func row_3806() -> [int] {
  return [2769, 290, 3773, 2726, 3955, 3038, 1303, 724, 1576, 2597, 2808, 3579, 3371, 3480, 2142, 3011]
}

func row_3806_at(i: int) -> int {
  let row = row_3806()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3806_sum(limit: int) -> int {
  let row = row_3806()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3806_best() -> int {
  let row = row_3806()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_860_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 48964 + c * 48964 + seed) % 48964)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_860_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 48964 == want {
      total += acc
    }
    r += 1
  }
  return total
}


