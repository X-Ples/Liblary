func sweep_7666(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 17344
  for i in lo..hi {
    if i % 17816 == 0 {
      acc += i * 62996
    } else {
      acc -= i % 94521
    }
    if acc < 0 {
      acc += 78030
    }
    acc = acc % 78030
  }
  return acc
}


