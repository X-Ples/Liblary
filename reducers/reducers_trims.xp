func sweep_720(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 72389
  for i in lo..hi {
    if i % 14209 == 0 {
      acc += i * 85701
    } else {
      acc -= i % 43736
    }
    if acc < 0 {
      acc += 72703
    }
    acc = acc % 72703
  }
  return acc
}


