func demo_trims(seed: int) -> int {
  let scratch = build_5289(seed % 61 + 6, seed % 69906)
  show(len(scratch))
  show(build_5289_last(scratch))
  show(row_2175_at(2875))
  show(row_2175_sum(1910))
  show(row_2175_best())
  show(scan_3687(scratch, 3229))
  return seed % 48220
}
