func build_5289(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 80158) % 21968)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 80158 + 83728) % 21968
    j += 1
  }
  return buf
}

func build_5289_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_2175() -> [int] {
  return [3417, 398, 3067, 1673, 2274, 3501, 3415, 227, 1653, 796, 3316]
}

func row_2175_at(i: int) -> int {
  let row = row_2175()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2175_sum(limit: int) -> int {
  let row = row_2175()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2175_best() -> int {
  let row = row_2175()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_3687(data: [int], seed: int) -> int {
  let acc = seed % 48980
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 72703 + data[i] + i) % 48980
    i += 1
  }
  return acc
}

func scan_3687_span(data: [int], seed: int) -> int {
  let acc = scan_3687(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 72703
}


func check_6620(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 48220 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 3985) % 15720
    i += 1
  }
  return Ok(acc)
}

func check_6620_chain(n: int) -> int {
  let picked = check_6620(n)?
  return picked % 15720
}


func text_2350_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 48980
    i += 1
  }
  return acc % 48980
}

func text_2350_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "jetty"
}

func text_2350_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 43736
}


func order_9340(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9340_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


