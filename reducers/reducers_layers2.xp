  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 88533 + data[i] + i) % 78456
    i += 1
  }
  return acc
}

func scan_7223_span(data: [int], seed: int) -> int {
  let acc = scan_7223(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 88533
}


