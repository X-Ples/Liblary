func text_1091_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 18040
    i += 1
  }
  return acc % 18040
}

func text_1091_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "kilo"
}

func text_1091_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 30316
}


func check_450(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 37794 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 65412) % 14247
    i += 1
  }
  return Ok(acc)
}

func check_450_chain(n: int) -> int {
  let picked = check_450(n)?
  return picked % 14247
}


func build_7032(count: int, start: int) -> [int] {
