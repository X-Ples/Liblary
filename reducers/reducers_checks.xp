func sweep_5876(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 77399
  for i in lo..hi {
    if i % 22525 == 0 {
      acc += i * 86229
    } else {
      acc -= i % 94136
    }
    if acc < 0 {
      acc += 65830
    }
    acc = acc % 65830
  }
  return acc
}


