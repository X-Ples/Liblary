func build_9624(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 11985) % 21408)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 11985 + 67353) % 21408
    j += 1
  }
  return buf
}

func build_9624_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_1674_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 52887 + c * 65830 + seed) % 65830)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1674_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 65830 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func order_9694(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9694_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func curve_4313_clamp(v: f64) -> f64 {
  guard v >= 75730.0 else {
    return 75730.0
  }
  guard v <= 78270.0 else {
    return 78270.0
  }
  return v
}

func curve_4313_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4313_clamp(t)
  return p + (q - p) * k
}

func curve_4313_ease(t: f64) -> f64 {
  let k = curve_4313_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4313_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


