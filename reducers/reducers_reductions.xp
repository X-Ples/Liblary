func demo_reductions(seed: int) -> int {
  let scratch = build_8792(seed % 61 + 6, seed % 18079)
  show(len(scratch))
  show(grid_4742_rowsum(scratch, 170, 2192, 3172))
  show(build_8792_last(scratch))
  show(scan_625(scratch, 2057))
  return seed % 42167
}
