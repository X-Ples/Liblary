func check_6323(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 36672 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 42167) % 5020
    i += 1
  }
  return Ok(acc)
}

func check_6323_chain(n: int) -> int {
  let picked = check_6323(n)?
  return picked % 5020
}


func row_8265() -> [int] {
  return [2853, 1357, 3431, 1391, 3311, 66, 2287, 233, 2048, 3546, 102, 1382, 1699, 2803, 679, 1089, 3032, 3440, 663]
}

func row_8265_at(i: int) -> int {
  let row = row_8265()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8265_sum(limit: int) -> int {
  let row = row_8265()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8265_best() -> int {
  let row = row_8265()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


