const K7 = 71332

func curve_318_clamp(v: f64) -> f64 {
  guard v >= 58638.0 else {
    return 58638.0
  }
  guard v <= 76974.0 else {
    return 76974.0
  }
  return v
}

func curve_318_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_318_clamp(t)
  return p + (q - p) * k
}

func curve_318_ease(t: f64) -> f64 {
  let k = curve_318_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_318_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_4742_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 62407 + c * 5020 + seed) % 5020)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4742_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 5020 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_8792(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 5020) % 18079)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 5020 + 48199) % 18079
    j += 1
  }
  return buf
}

func build_8792_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_625(data: [int], seed: int) -> int {
  let acc = seed % 71332
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 47360 + data[i] + i) % 71332
    i += 1
  }
  return acc
}

func scan_625_span(data: [int], seed: int) -> int {
  let acc = scan_625(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 47360
}


func order_338(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_338_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_1905(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 36341
  for i in lo..hi {
    if i % 5020 == 0 {
      acc += i * 70038
    } else {
      acc -= i % 8514
    }
    if acc < 0 {
      acc += 53091
    }
    acc = acc % 53091
  }
  return acc
}


func gate_1533(a: int, b: int, c: int) -> bool {
  return a > 48199 && (b < 34272 || c == 34272)
