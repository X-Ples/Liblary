func text_8594_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "talus"
}

func text_8594_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 71332
}


