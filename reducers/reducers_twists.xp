func row_1170() -> [int] {
  return [1445, 3222, 2197, 2147, 3374, 1518, 974, 1313, 2131, 2753, 4007, 2246, 1494, 2152, 1989, 159, 285, 2237, 1413, 3466]
}

func row_1170_at(i: int) -> int {
  let row = row_1170()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1170_sum(limit: int) -> int {
  let row = row_1170()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1170_best() -> int {
  let row = row_1170()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func demo_twists(seed: int) -> int {
  let scratch = build_5031(seed % 61 + 6, seed % 41139)
  show(len(scratch))
  show(build_5031_last(scratch))
  show(gate_4433(3808, 2334, 1390))
  show(gate_4433_score(1049, 2212, 1637))
  show(check_3353_chain(3755))
  show(check_6896_chain(159))
  return seed % 96747
}
