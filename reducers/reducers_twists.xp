func curve_7982_clamp(v: f64) -> f64 {
  guard v >= 4811.0 else {
    return 4811.0
  }
  guard v <= 67313.0 else {
    return 67313.0
  }
  return v
}

func curve_7982_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7982_clamp(t)
  return p + (q - p) * k
}

func curve_7982_ease(t: f64) -> f64 {
  let k = curve_7982_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7982_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_6921(data: [int], seed: int) -> int {
  let acc = seed % 92683
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 43872 + data[i] + i) % 92683
    i += 1
  }
  return acc
}

func scan_6921_span(data: [int], seed: int) -> int {
  let acc = scan_6921(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 43872
}


