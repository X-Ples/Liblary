func build_5031(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 41139) % 42850)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 41139 + 91835) % 42850
    j += 1
  }
  return buf
}

func build_5031_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_4433(a: int, b: int, c: int) -> bool {
  return a > 92683 && (b < 99366 || c == 41216)
}

func gate_4433_score(a: int, b: int, c: int) -> int {
  guard gate_4433(a, b, c) else {
    return 0
  }
  return (a % 99366) * 41216 + b
}


func check_3353(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 92683 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 31519) % 92797
    i += 1
  }
  return Ok(acc)
}

func check_3353_chain(n: int) -> int {
  let picked = check_3353(n)?
  return picked % 92797
}


