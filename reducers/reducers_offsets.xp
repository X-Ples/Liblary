func demo_offsets(seed: int) -> int {
  let scratch = build_9218(seed % 61 + 6, seed % 41579)
  show(len(scratch))
  show(build_9218_last(scratch))
  show(build_3065_last(scratch))
  show(grid_4878_rowsum(scratch, 3716, 1065, 22))
  show(scan_2788(scratch, 2733))
  return seed % 54626
}
