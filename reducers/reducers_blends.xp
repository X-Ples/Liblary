func build_9078(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 54483) % 60822)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 54483 + 1242) % 60822
    j += 1
  }
  return buf
}

func build_9078_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_8253_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 6085 + c * 54483 + seed) % 54483)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8253_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 54483 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_2503_clamp(v: f64) -> f64 {
  guard v >= 23660.0 else {
    return 23660.0
  }
  guard v <= 91913.0 else {
    return 91913.0
  }
  return v
}

func curve_2503_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2503_clamp(t)
  return p + (q - p) * k
}

func curve_2503_ease(t: f64) -> f64 {
  let k = curve_2503_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2503_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_5455(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 67718 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 31734) % 47091
    i += 1
  }
  return Ok(acc)
}

func check_5455_chain(n: int) -> int {
  let picked = check_5455(n)?
  return picked % 47091
}


