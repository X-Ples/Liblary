func demo_blends(seed: int) -> int {
  let scratch = build_9078(seed % 61 + 6, seed % 26556)
  show(len(scratch))
  show(build_9078_last(scratch))
  show(grid_8253_rowsum(scratch, 1608, 1015, 304))
