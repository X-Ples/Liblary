func row_7631() -> [int] {
  return [1181, 3023, 3614, 2238, 2838, 845, 726, 1241, 2538, 2096, 9, 448, 706, 3053]
}

func row_7631_at(i: int) -> int {
  let row = row_7631()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7631_sum(limit: int) -> int {
  let row = row_7631()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7631_best() -> int {
  let row = row_7631()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


