func gate_5589(a: int, b: int, c: int) -> bool {
  return a > 43221 && (b < 9307 || c == 91913)
}

func gate_5589_score(a: int, b: int, c: int) -> int {
  guard gate_5589(a, b, c) else {
    return 0
  }
  return (a % 9307) * 91913 + b
}


func sweep_6574(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 22949
  for i in lo..hi {
    if i % 60822 == 0 {
      acc += i * 1416
    } else {
      acc -= i % 47091
    }
    if acc < 0 {
      acc += 23660
    }
    acc = acc % 23660
  }
  return acc
}


func order_7350(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7350_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


