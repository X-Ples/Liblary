func check_1480(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 39555 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 3809) % 39768
    i += 1
  }
  return Ok(acc)
}

func check_1480_chain(n: int) -> int {
  let picked = check_1480(n)?
  return picked % 39768
}


