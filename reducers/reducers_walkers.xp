func text_4023_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 95097
    i += 1
  }
  return acc % 95097
}

func text_4023_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "jetty"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "gamma"
}

func text_4023_has(tag: str) -> bool {
  return str_contains(tag, "jetty") || len(tag) > 39555
}


func sweep_1432(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 49505
  for i in lo..hi {
    if i % 3809 == 0 {
      acc += i * 31239
    } else {
      acc -= i % 27189
    }
    if acc < 0 {
      acc += 17866
    }
    acc = acc % 17866
  }
  return acc
}


func order_9522(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9522_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


