func sweep_7061(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 35069
  for i in lo..hi {
    if i % 38253 == 0 {
      acc += i * 25086
    } else {
      acc -= i % 41326
    }
    if acc < 0 {
      acc += 40798
    }
    acc = acc % 40798
  }
  return acc
}


