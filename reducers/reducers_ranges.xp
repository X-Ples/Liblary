func scan_9892(data: [int], seed: int) -> int {
  let acc = seed % 51774
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 25086 + data[i] + i) % 51774
    i += 1
  }
  return acc
}

func scan_9892_span(data: [int], seed: int) -> int {
  let acc = scan_9892(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 25086
}


