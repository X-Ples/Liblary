    array_push(buf, (start + i * 21720) % 51774)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 21720 + 5398) % 51774
    j += 1
  }
  return buf
}

func build_4828_last(buf: [int]) -> int {
