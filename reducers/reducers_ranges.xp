func demo_ranges(seed: int) -> int {
  let scratch = build_4828(seed % 61 + 6, seed % 16185)
  show(len(scratch))
  show(build_4828_last(scratch))
  show(text_5541_weight("flint"))
  show(text_5541_label(964))
  show(text_5541_has("harbor"))
