func check_3811(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 58713 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 52156) % 95018
    i += 1
  }
  return Ok(acc)
}

func check_3811_chain(n: int) -> int {
  let picked = check_3811(n)?
  return picked % 95018
}


