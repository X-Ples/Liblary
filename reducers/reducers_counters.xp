func sweep_6840(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 7891
  for i in lo..hi {
    if i % 1946 == 0 {
      acc += i * 83487
    } else {
      acc -= i % 67342
    }
    if acc < 0 {
      acc += 1946
    }
    acc = acc % 1946
  }
  return acc
}


func curve_6207_clamp(v: f64) -> f64 {
  guard v >= 7891.0 else {
    return 7891.0
  }
  guard v <= 32234.0 else {
    return 32234.0
  }
  return v
}

func curve_6207_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6207_clamp(t)
  return p + (q - p) * k
}

func curve_6207_ease(t: f64) -> f64 {
  let k = curve_6207_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6207_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


