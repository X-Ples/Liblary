func text_2163_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 73027
    i += 1
  }
  return acc % 73027
}

func text_2163_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "bravo"
}

func text_2163_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 87907
}


