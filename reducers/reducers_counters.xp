func demo_counters(seed: int) -> int {
  let scratch = build_1192(seed % 61 + 6, seed % 16635)
  show(len(scratch))
  show(build_1192_last(scratch))
  show(scan_2924(scratch, 2929))
  show(scan_2924_span(scratch, 3570))
  show(build_2087_last(scratch))
  show(build_960_last(scratch))
  return seed % 95018
}
