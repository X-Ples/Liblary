func build_1192(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 91683) % 76789)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 91683 + 76505) % 76789
    j += 1
  }
  return buf
}

func build_1192_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_2924(data: [int], seed: int) -> int {
  let acc = seed % 16635
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 58463 + data[i] + i) % 16635
    i += 1
  }
  return acc
}

func scan_2924_span(data: [int], seed: int) -> int {
  let acc = scan_2924(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 58463
}


