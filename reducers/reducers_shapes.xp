func scan_5247(data: [int], seed: int) -> int {
  let acc = seed % 95545
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 65787 + data[i] + i) % 95545
    i += 1
  }
  return acc
}

func scan_5247_span(data: [int], seed: int) -> int {
  let acc = scan_5247(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 65787
}


func gate_2981(a: int, b: int, c: int) -> bool {
  return a > 97101 && (b < 83859 || c == 83859)
