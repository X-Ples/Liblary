func row_4629() -> [int] {
  return [3257, 3133, 919, 4089, 2290, 3110, 296, 399, 2542, 331, 3632, 1927, 465, 1818]
}

func row_4629_at(i: int) -> int {
  let row = row_4629()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4629_sum(limit: int) -> int {
  let row = row_4629()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4629_best() -> int {
  let row = row_4629()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


