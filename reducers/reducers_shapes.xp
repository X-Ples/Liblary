func grid_814_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 72716 + c * 69558 + seed) % 69558)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_814_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 69558 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func demo_shapes(seed: int) -> int {
  let scratch = build_1337(seed % 61 + 6, seed % 54310)
  show(len(scratch))
  show(build_1337_last(scratch))
  show(check_4098_chain(935))
  show(order_5013_find(scratch, 2715))
  return seed % 47571
}
