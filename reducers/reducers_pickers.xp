func row_1899() -> [int] {
  return [842, 1607, 197, 863, 2846, 2492, 132, 4025, 217, 114, 1028, 2530, 2115, 3682, 818]
}

func row_1899_at(i: int) -> int {
  let row = row_1899()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1899_sum(limit: int) -> int {
  let row = row_1899()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1899_best() -> int {
  let row = row_1899()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_8123_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 85144 + c * 53969 + seed) % 53969)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8123_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 53969 == want {
      total += acc
    }
    r += 1
  }
  return total
}


