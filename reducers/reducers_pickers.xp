func check_6250(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 53887 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 10449) % 21660
    i += 1
  }
  return Ok(acc)
}

func check_6250_chain(n: int) -> int {
  let picked = check_6250(n)?
  return picked % 21660
}


