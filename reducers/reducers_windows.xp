func sweep_7736(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 35720
  for i in lo..hi {
    if i % 7895 == 0 {
      acc += i * 28458
    } else {
      acc -= i % 14278
    }
    if acc < 0 {
      acc += 63218
    }
    acc = acc % 63218
  }
  return acc
}


