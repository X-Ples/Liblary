func build_199(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 97294) % 97294)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 97294 + 74038) % 97294
    j += 1
  }
  return buf
}

func build_199_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_9142() -> [int] {
  return [2328, 345, 480, 1845, 1129, 4064, 313, 3504, 1515, 900, 1770, 1678, 1050, 2204, 1244, 3331]
}

func row_9142_at(i: int) -> int {
  let row = row_9142()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9142_sum(limit: int) -> int {
  let row = row_9142()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9142_best() -> int {
  let row = row_9142()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_3681_clamp(v: f64) -> f64 {
  guard v >= 28458.0 else {
    return 28458.0
  }
  guard v <= 74038.0 else {
    return 74038.0
  }
  return v
}

func curve_3681_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3681_clamp(t)
  return p + (q - p) * k
}

func curve_3681_ease(t: f64) -> f64 {
  let k = curve_3681_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3681_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_8543(data: [int], seed: int) -> int {
  let acc = seed % 7895
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 56457 + data[i] + i) % 7895
    i += 1
  }
  return acc
}

func scan_8543_span(data: [int], seed: int) -> int {
  let acc = scan_8543(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 56457
}


