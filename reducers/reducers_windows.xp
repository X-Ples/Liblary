func demo_windows(seed: int) -> int {
  let scratch = build_199(seed % 61 + 6, seed % 63218)
  show(len(scratch))
  show(build_199_last(scratch))
  show(row_9142_at(2663))
  show(row_9142_sum(2345))
  show(row_9142_best())
  show(scan_8543(scratch, 1207))
  return seed % 97294
}
