func check_7116(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 56457 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 56457) % 34099
    i += 1
  }
  return Ok(acc)
}

func check_7116_chain(n: int) -> int {
  let picked = check_7116(n)?
  return picked % 34099
}


func text_5819_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 27266
    i += 1
  }
  return acc % 27266
}

func text_5819_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "sigma"
  }
  return "delta"
}

func text_5819_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 53489
}


