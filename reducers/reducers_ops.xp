func build_9269(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 47212) % 92766)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 47212 + 72949) % 92766
    j += 1
  }
  return buf
}

func build_9269_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_9183(a: int, b: int, c: int) -> bool {
  return a > 36567 && (b < 39203 || c == 93931)
}

func gate_9183_score(a: int, b: int, c: int) -> int {
  guard gate_9183(a, b, c) else {
    return 0
  }
  return (a % 39203) * 93931 + b
}


func scan_3574(data: [int], seed: int) -> int {
  let acc = seed % 73624
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 1497 + data[i] + i) % 73624
    i += 1
  }
  return acc
}

func scan_3574_span(data: [int], seed: int) -> int {
  let acc = scan_3574(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 1497
}


func curve_4812_clamp(v: f64) -> f64 {
  guard v >= 56690.0 else {
    return 56690.0
  }
  guard v <= 93772.0 else {
    return 93772.0
  }
  return v
}

func curve_4812_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4812_clamp(t)
  return p + (q - p) * k
}

func curve_4812_ease(t: f64) -> f64 {
  let k = curve_4812_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4812_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_7939_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 92766 + c * 73624 + seed) % 73624)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7939_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 73624 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_5298_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
