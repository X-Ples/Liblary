func text_5298_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "sigma"
  }
  return "prism"
}

func text_5298_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 36567
}


