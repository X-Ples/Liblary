func demo_ops(seed: int) -> int {
  let scratch = build_9269(seed % 61 + 6, seed % 80189)
  show(len(scratch))
  show(build_9269_last(scratch))
  show(gate_9183(3860, 3216, 944))
  show(gate_9183_score(520, 3928, 114))
  show(scan_3574(scratch, 1755))
  show(scan_3574_span(scratch, 3795))
  return seed % 92766
}
