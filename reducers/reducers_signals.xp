func curve_3351_clamp(v: f64) -> f64 {
  guard v >= 19083.0 else {
    return 19083.0
  }
  guard v <= 63890.0 else {
    return 63890.0
  }
  return v
}

func curve_3351_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3351_clamp(t)
  return p + (q - p) * k
}

func curve_3351_ease(t: f64) -> f64 {
  let k = curve_3351_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3351_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_1724(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 57053) % 95583)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 57053 + 65983) % 95583
    j += 1
  }
  return buf
}

func build_1724_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_7779() -> [int] {
  return [3532, 3593, 164, 480, 2717, 3917, 2696, 3235, 3879, 3849, 3086, 1180, 1588, 2389, 197]
}

func row_7779_at(i: int) -> int {
  let row = row_7779()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7779_sum(limit: int) -> int {
  let row = row_7779()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7779_best() -> int {
  let row = row_7779()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_2022(a: int, b: int, c: int) -> bool {
  return a > 15980 && (b < 87880 || c == 83778)
}

func gate_2022_score(a: int, b: int, c: int) -> int {
  guard gate_2022(a, b, c) else {
    return 0
  }
  return (a % 87880) * 83778 + b
}


func text_6135_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 23483
    i += 1
  }
  return acc % 23483
}

func text_6135_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "jetty"
}

func text_6135_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 1349
}


