func build_9737(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 56536) % 46371)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 56536 + 20285) % 46371
    j += 1
  }
  return buf
}

func build_9737_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_7599(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 84356
  for i in lo..hi {
    if i % 17158 == 0 {
      acc += i * 56536
    } else {
      acc -= i % 39054
    }
    if acc < 0 {
      acc += 17158
    }
    acc = acc % 17158
  }
  return acc
}


func order_7508(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7508_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


