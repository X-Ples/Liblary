func demo_quarks(seed: int) -> int {
  let scratch = build_9737(seed % 61 + 6, seed % 91779)
  show(len(scratch))
  show(build_9737_last(scratch))
  show(sweep_7599(1995, 202))
  show(order_7508_find(scratch, 2703))
  show(order_2069_find(scratch, 3415))
  show(row_4552_at(3494))
  return seed % 29742
}
