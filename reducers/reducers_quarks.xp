func scan_8010(data: [int], seed: int) -> int {
  let acc = seed % 56536
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 31232 + data[i] + i) % 56536
    i += 1
  }
  return acc
}

func scan_8010_span(data: [int], seed: int) -> int {
  let acc = scan_8010(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 31232
}


