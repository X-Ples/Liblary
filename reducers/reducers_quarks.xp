func check_7344(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 46371 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 46371) % 82857
    i += 1
  }
  return Ok(acc)
}

func check_7344_chain(n: int) -> int {
  let picked = check_7344(n)?
  return picked % 82857
}


