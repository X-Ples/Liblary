func curve_4400_clamp(v: f64) -> f64 {
  guard v >= 42571.0 else {
    return 42571.0
  }
  guard v <= 52505.0 else {
    return 52505.0
  }
  return v
}

func curve_4400_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4400_clamp(t)
  return p + (q - p) * k
}

func curve_4400_ease(t: f64) -> f64 {
  let k = curve_4400_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4400_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_4552() -> [int] {
  return [2004, 554, 2486, 194, 3656, 3973, 221, 1157, 1953, 1234, 2671, 3635, 1617, 3080]
}

func row_4552_at(i: int) -> int {
  let row = row_4552()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4552_sum(limit: int) -> int {
  let row = row_4552()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4552_best() -> int {
  let row = row_4552()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_8353_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 98599 + c * 57949 + seed) % 57949)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8353_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 57949 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_737(a: int, b: int, c: int) -> bool {
  return a > 61404 && (b < 52505 || c == 84356)
}

func gate_737_score(a: int, b: int, c: int) -> int {
  guard gate_737(a, b, c) else {
    return 0
  }
  return (a % 52505) * 84356 + b
}


