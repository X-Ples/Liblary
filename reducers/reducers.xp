func check_3096(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 64653 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 37131) % 69472
    i += 1
  }
  return Ok(acc)
}

func check_3096_chain(n: int) -> int {
  let picked = check_3096(n)?
  return picked % 69472
}


func grid_6348_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
