func sweep_8494(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 58776
  for i in lo..hi {
    if i % 90346 == 0 {
      acc += i * 19152
    } else {
      acc -= i % 37131
    }
    if acc < 0 {
      acc += 90346
    }
    acc = acc % 90346
  }
  return acc
}


func order_4963(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4963_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func reducers_ping() -> int {
  return 28077 % 7919
}

func reducers_blend(seed: int) -> int {
  return reducers_ping() + seed % 24320
}
