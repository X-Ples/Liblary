func gate_8323(a: int, b: int, c: int) -> bool {
  return a > 97913 && (b < 72269 || c == 90809)
}

func gate_8323_score(a: int, b: int, c: int) -> int {
  guard gate_8323(a, b, c) else {
    return 0
  }
  return (a % 72269) * 90809 + b
}


