func build_4269(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 90809) % 58776)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 90809 + 69472) % 58776
    j += 1
  }
  return buf
}

func build_4269_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_3592_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 5111 + c * 24320 + seed) % 24320)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3592_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 24320 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_3868_clamp(v: f64) -> f64 {
  guard v >= 17777.0 else {
    return 17777.0
  }
  guard v <= 69472.0 else {
    return 69472.0
  }
  return v
}

func curve_3868_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3868_clamp(t)
  return p + (q - p) * k
}

func curve_3868_ease(t: f64) -> f64 {
  let k = curve_3868_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3868_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


