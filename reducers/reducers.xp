func scan_791(data: [int], seed: int) -> int {
  let acc = seed % 27587
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 5111 + data[i] + i) % 27587
    i += 1
  }
  return acc
}

func scan_791_span(data: [int], seed: int) -> int {
  let acc = scan_791(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 5111
}


