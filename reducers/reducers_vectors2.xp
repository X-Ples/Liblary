func sweep_9994(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 93488
  for i in lo..hi {
    if i % 5460 == 0 {
      acc += i * 33944
    } else {
      acc -= i % 41104
    }
    if acc < 0 {
      acc += 87962
    }
    acc = acc % 87962
  }
  return acc
}


