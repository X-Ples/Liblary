func demo_vectors2(seed: int) -> int {
  let scratch = build_2596(seed % 61 + 6, seed % 38872)
  show(len(scratch))
  show(scan_2732(scratch, 3092))
  show(scan_2732_span(scratch, 886))
  show(scan_2809(scratch, 3434))
  show(scan_2809_span(scratch, 3545))
  return seed % 71124
}
