func row_5664_at(i: int) -> int {
  let row = row_5664()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5664_sum(limit: int) -> int {
  let row = row_5664()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5664_best() -> int {
  let row = row_5664()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


