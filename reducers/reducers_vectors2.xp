const K0 = 5460
const K1 = 82941
const K2 = 3688
const K3 = 1880
const K4 = 95997
const K5 = 87962
const K6 = 49497

func curve_2998_clamp(v: f64) -> f64 {
  guard v >= 3688.0 else {
    return 3688.0
  }
  guard v <= 38872.0 else {
    return 38872.0
  }
  return v
}

func curve_2998_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2998_clamp(t)
  return p + (q - p) * k
}

func curve_2998_ease(t: f64) -> f64 {
  let k = curve_2998_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2998_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_2732(data: [int], seed: int) -> int {
  let acc = seed % 57511
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 87962 + data[i] + i) % 57511
    i += 1
  }
  return acc
}

func scan_2732_span(data: [int], seed: int) -> int {
  let acc = scan_2732(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 87962
}


