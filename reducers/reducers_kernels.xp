func demo_kernels(seed: int) -> int {
  let scratch = build_852(seed % 61 + 6, seed % 43450)
  show(len(scratch))
  show(build_852_last(scratch))
  show(gate_3578(2217, 2083, 1262))
  show(gate_3578_score(427, 3577, 2623))
  show(gate_5567(1762, 1764, 1439))
  show(gate_5567_score(387, 38, 623))
  return seed % 96353
}
