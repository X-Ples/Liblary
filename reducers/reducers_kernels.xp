func build_852(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 23650) % 71089)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 23650 + 13177) % 71089
    j += 1
  }
  return buf
}

func build_852_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_3578(a: int, b: int, c: int) -> bool {
  return a > 1333 && (b < 47003 || c == 97558)
}

func gate_3578_score(a: int, b: int, c: int) -> int {
  guard gate_3578(a, b, c) else {
    return 0
  }
  return (a % 47003) * 97558 + b
}


func curve_6732_clamp(v: f64) -> f64 {
  guard v >= 15568.0 else {
    return 15568.0
  }
  guard v <= 74629.0 else {
    return 74629.0
  }
  return v
}

func curve_6732_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6732_clamp(t)
  return p + (q - p) * k
}

func curve_6732_ease(t: f64) -> f64 {
  let k = curve_6732_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6732_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


