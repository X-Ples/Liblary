func check_5388(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 69884 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 41237) % 69884
    i += 1
  }
  return Ok(acc)
}

func check_5388_chain(n: int) -> int {
  let picked = check_5388(n)?
  return picked % 69884
}


func row_1466() -> [int] {
  return [3908, 3595, 1067, 1694, 918, 3447, 604, 1594, 3785, 1726, 1214, 58, 3799, 1611, 77, 2536, 2937, 1408]
}

func row_1466_at(i: int) -> int {
  let row = row_1466()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1466_sum(limit: int) -> int {
  let row = row_1466()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1466_best() -> int {
  let row = row_1466()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


