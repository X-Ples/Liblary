func sweep_8106(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 50030
  for i in lo..hi {
    if i % 62332 == 0 {
      acc += i * 43450
    } else {
      acc -= i % 23650
    }
    if acc < 0 {
      acc += 74629
    }
    acc = acc % 74629
  }
  return acc
}


