func demo_helpers(seed: int) -> int {
  let scratch = build_3233(seed % 61 + 6, seed % 67621)
  show(len(scratch))
  show(build_3233_last(scratch))
  show(check_6387_chain(1541))
  show(sweep_6466(321, 571))
  show(gate_5435(3050, 309, 3250))
  return seed % 67621
}
