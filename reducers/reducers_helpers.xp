const K0 = 72786
const K1 = 23448
const K2 = 89825
const K3 = 52091
const K4 = 25462
const K5 = 41615
const K6 = 41228
const K7 = 1629

func build_3233(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 41615) % 67621)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 41615 + 65394) % 67621
    j += 1
  }
  return buf
}

func build_3233_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_6387(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 89825 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 52091) % 23448
    i += 1
  }
  return Ok(acc)
}

func check_6387_chain(n: int) -> int {
  let picked = check_6387(n)?
  return picked % 23448
}


func sweep_6466(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 67621
  for i in lo..hi {
    if i % 23448 == 0 {
      acc += i * 40202
    } else {
      acc -= i % 41228
    }
    if acc < 0 {
      acc += 27768
    }
    acc = acc % 27768
  }
  return acc
}


func gate_5435(a: int, b: int, c: int) -> bool {
  return a > 84892 && (b < 72786 || c == 84892)
}

func gate_5435_score(a: int, b: int, c: int) -> int {
  guard gate_5435(a, b, c) else {
    return 0
  }
  return (a % 72786) * 84892 + b
}


func grid_2995_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 96565 + c * 41615 + seed) % 41615)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2995_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 41615 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_1019_clamp(v: f64) -> f64 {
  guard v >= 67621.0 else {
    return 67621.0
  }
  guard v <= 72027.0 else {
    return 72027.0
  }
  return v
}

func curve_1019_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1019_clamp(t)
  return p + (q - p) * k
}

func curve_1019_ease(t: f64) -> f64 {
  let k = curve_1019_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1019_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_8537(data: [int], seed: int) -> int {
  let acc = seed % 84697
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 65394 + data[i] + i) % 84697
    i += 1
  }
  return acc
}

func scan_8537_span(data: [int], seed: int) -> int {
  let acc = scan_8537(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 65394
}


