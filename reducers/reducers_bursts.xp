func build_8218(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 83844) % 40044)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 83844 + 26599) % 40044
    j += 1
  }
  return buf
}

func build_8218_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_5979(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 35828 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 14767) % 91490
    i += 1
  }
  return Ok(acc)
}

func check_5979_chain(n: int) -> int {
  let picked = check_5979(n)?
  return picked % 91490
}


func grid_1129_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 41328 + c * 15448 + seed) % 15448)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1129_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 15448 == want {
      total += acc
    }
    r += 1
  }
  return total
}


