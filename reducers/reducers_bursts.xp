func order_3080(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3080_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func row_6103() -> [int] {
  return [2281, 2830, 1087, 914, 268, 2897, 3472, 3438, 3161, 1100, 3463, 1721, 492, 1582, 3256, 2945]
}

func row_6103_at(i: int) -> int {
  let row = row_6103()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6103_sum(limit: int) -> int {
  let row = row_6103()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6103_best() -> int {
  let row = row_6103()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_2134_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 65985
    i += 1
  }
  return acc % 65985
}

func text_2134_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "ion"
}

func text_2134_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 47232
}


func scan_3128(data: [int], seed: int) -> int {
  let acc = seed % 31034
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 41328 + data[i] + i) % 31034
    i += 1
  }
  return acc
}

func scan_3128_span(data: [int], seed: int) -> int {
  let acc = scan_3128(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 41328
}


