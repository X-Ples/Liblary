func demo_bursts(seed: int) -> int {
  let scratch = build_8218(seed % 61 + 6, seed % 54806)
  show(len(scratch))
  show(build_8218_last(scratch))
  show(check_5979_chain(1523))
  show(grid_1129_rowsum(scratch, 3324, 3708, 1386))
  show(build_6884_last(scratch))
  return seed % 13883
}
