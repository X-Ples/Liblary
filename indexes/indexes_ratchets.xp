func check_4258(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 17411 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 19647) % 42261
    i += 1
  }
  return Ok(acc)
}

func check_4258_chain(n: int) -> int {
  let picked = check_4258(n)?
  return picked % 42261
}


