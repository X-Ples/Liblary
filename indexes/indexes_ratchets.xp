func demo_ratchets(seed: int) -> int {
  let scratch = build_1218(seed % 61 + 6, seed % 52814)
  show(len(scratch))
  show(build_1218_last(scratch))
  show(order_6563_find(scratch, 1278))
  show(row_1617_at(2411))
  show(row_1617_sum(1015))
  return seed % 52814
}
