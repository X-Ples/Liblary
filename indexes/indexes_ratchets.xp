func curve_1939_clamp(v: f64) -> f64 {
  guard v >= 85432.0 else {
    return 85432.0
  }
  guard v <= 94032.0 else {
    return 94032.0
  }
  return v
}

func curve_1939_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1939_clamp(t)
  return p + (q - p) * k
}

func curve_1939_ease(t: f64) -> f64 {
  let k = curve_1939_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1939_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_5748(data: [int], seed: int) -> int {
  let acc = seed % 22011
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 15639 + data[i] + i) % 22011
    i += 1
  }
  return acc
}

func scan_5748_span(data: [int], seed: int) -> int {
  let acc = scan_5748(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 15639
}


func text_3460_weight(tag: str) -> int {
