func demo_bursts(seed: int) -> int {
  let scratch = build_9329(seed % 61 + 6, seed % 32046)
  show(len(scratch))
  show(build_9329_last(scratch))
  show(build_1116_last(scratch))
  show(grid_1134_rowsum(scratch, 48, 3336, 2463))
  show(scan_6261(scratch, 1337))
  return seed % 5893
}
