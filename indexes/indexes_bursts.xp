func sweep_8619(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 12879
  for i in lo..hi {
    if i % 39344 == 0 {
      acc += i * 12879
    } else {
      acc -= i % 66295
    }
    if acc < 0 {
      acc += 13649
    }
    acc = acc % 13649
  }
  return acc
}


