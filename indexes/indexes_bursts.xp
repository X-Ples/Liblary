func grid_1134_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 83325 + c * 12879 + seed) % 12879)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1134_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 12879 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_6261(data: [int], seed: int) -> int {
  let acc = seed % 13580
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 32046 + data[i] + i) % 13580
    i += 1
  }
  return acc
}

func scan_6261_span(data: [int], seed: int) -> int {
  let acc = scan_6261(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 32046
}


func gate_5506(a: int, b: int, c: int) -> bool {
  return a > 537 && (b < 99675 || c == 537)
}

func gate_5506_score(a: int, b: int, c: int) -> int {
  guard gate_5506(a, b, c) else {
    return 0
  }
  return (a % 99675) * 537 + b
}


func text_5737_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 56322
    i += 1
  }
  return acc % 56322
}

func text_5737_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "omega"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "delta"
}

func text_5737_has(tag: str) -> bool {
  return str_contains(tag, "omega") || len(tag) > 70732
}


