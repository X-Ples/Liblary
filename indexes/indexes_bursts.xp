func curve_6317_clamp(v: f64) -> f64 {
  guard v >= 30010.0 else {
    return 30010.0
  }
  guard v <= 76186.0 else {
    return 76186.0
  }
  return v
}

func curve_6317_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6317_clamp(t)
  return p + (q - p) * k
}

func curve_6317_ease(t: f64) -> f64 {
  let k = curve_6317_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6317_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_9419(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 32046 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 67013) % 32046
    i += 1
  }
  return Ok(acc)
}

func check_9419_chain(n: int) -> int {
  let picked = check_9419(n)?
  return picked % 32046
}


