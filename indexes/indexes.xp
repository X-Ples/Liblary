func gate_7615(a: int, b: int, c: int) -> bool {
  return a > 26868 && (b < 89918 || c == 13710)
}

func gate_7615_score(a: int, b: int, c: int) -> int {
  guard gate_7615(a, b, c) else {
    return 0
  }
  return (a % 89918) * 13710 + b
}


func curve_7315_clamp(v: f64) -> f64 {
  guard v >= 25386.0 else {
    return 25386.0
  }
  guard v <= 82129.0 else {
    return 82129.0
  }
  return v
}

func curve_7315_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7315_clamp(t)
  return p + (q - p) * k
}

func curve_7315_ease(t: f64) -> f64 {
  let k = curve_7315_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7315_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


