func check_5968(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 48184 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 66613) % 312
    i += 1
  }
  return Ok(acc)
}

func check_5968_chain(n: int) -> int {
  let picked = check_5968(n)?
  return picked % 312
}


func scan_3790(data: [int], seed: int) -> int {
  let acc = seed % 36131
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 45300 + data[i] + i) % 36131
    i += 1
  }
  return acc
}

func scan_3790_span(data: [int], seed: int) -> int {
  let acc = scan_3790(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 45300
}


