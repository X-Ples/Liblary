func build_7332(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 16502) % 13476)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 16502 + 36131) % 13476
    j += 1
  }
  return buf
}

func build_7332_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_4981() -> [int] {
  return [2164, 2013, 3487, 1415, 1887, 2339, 3881, 1687, 779, 1366, 2591, 2680, 3305, 3391, 3078, 3595, 930, 3560, 244]
}

func row_4981_at(i: int) -> int {
  let row = row_4981()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4981_sum(limit: int) -> int {
  let row = row_4981()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4981_best() -> int {
  let row = row_4981()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_412(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_412_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_9122_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 8705
    i += 1
  }
  return acc % 8705
}

func text_9122_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "mesa"
}

func text_9122_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 55331
}


