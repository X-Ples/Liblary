func check_7269(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 41525 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 47235) % 50983
    i += 1
  }
  return Ok(acc)
}

func check_7269_chain(n: int) -> int {
  let picked = check_7269(n)?
  return picked % 50983
}


