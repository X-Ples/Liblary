func build_7045(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 50983) % 48648)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 50983 + 54988) % 48648
    j += 1
  }
  return buf
}

func build_7045_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_803_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 74313 + c * 29920 + seed) % 29920)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_803_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 29920 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func row_1233() -> [int] {
  return [1836, 165, 2950, 3769, 1129, 2609, 293, 1907, 1117, 2373, 2037, 280, 2564, 2264]
}

func row_1233_at(i: int) -> int {
  let row = row_1233()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1233_sum(limit: int) -> int {
  let row = row_1233()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1233_best() -> int {
  let row = row_1233()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_8172_clamp(v: f64) -> f64 {
  guard v >= 461.0 else {
    return 461.0
  }
  guard v <= 45567.0 else {
    return 45567.0
  }
  return v
}

func curve_8172_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8172_clamp(t)
  return p + (q - p) * k
}

func curve_8172_ease(t: f64) -> f64 {
  let k = curve_8172_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8172_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_967(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_967_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_7444(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 45567
  for i in lo..hi {
    if i % 1288 == 0 {
      acc += i * 26635
    } else {
      acc -= i % 48648
    }
    if acc < 0 {
      acc += 71836
    }
    acc = acc % 71836
  }
  return acc
}


