}


func scan_3021(data: [int], seed: int) -> int {
  let acc = seed % 34032
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 1288 + data[i] + i) % 34032
    i += 1
  }
  return acc
}

func scan_3021_span(data: [int], seed: int) -> int {
  let acc = scan_3021(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 1288
}


func gate_8241(a: int, b: int, c: int) -> bool {
  return a > 96259 && (b < 45567 || c == 48648)
}

func gate_8241_score(a: int, b: int, c: int) -> int {
  guard gate_8241(a, b, c) else {
    return 0
  }
  return (a % 45567) * 48648 + b
}


