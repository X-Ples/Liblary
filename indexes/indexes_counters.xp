func demo_counters(seed: int) -> int {
  let scratch = build_4146(seed % 61 + 6, seed % 99321)
  show(len(scratch))
  show(build_4146_last(scratch))
  show(gate_7678(2761, 188, 2697))
  show(gate_7678_score(2842, 1696, 978))
  show(text_4339_weight("quartz"))
  show(text_4339_label(3773))
  return seed % 21393
}
