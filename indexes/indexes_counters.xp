func check_394(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 65111 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 42359) % 7108
    i += 1
  }
  return Ok(acc)
}

func check_394_chain(n: int) -> int {
  let picked = check_394(n)?
  return picked % 7108
}


func curve_5791_clamp(v: f64) -> f64 {
  guard v >= 63986.0 else {
    return 63986.0
  }
  guard v <= 72226.0 else {
    return 72226.0
  }
  return v
}

func curve_5791_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5791_clamp(t)
  return p + (q - p) * k
}

func curve_5791_ease(t: f64) -> f64 {
  let k = curve_5791_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5791_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


