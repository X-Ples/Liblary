func build_4146(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 65111) % 63986)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 65111 + 60293) % 63986
    j += 1
  }
  return buf
}

func build_4146_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_7678(a: int, b: int, c: int) -> bool {
  return a > 42359 && (b < 99321 || c == 60293)
}

func gate_7678_score(a: int, b: int, c: int) -> int {
  guard gate_7678(a, b, c) else {
    return 0
  }
  return (a % 99321) * 60293 + b
}


func text_4339_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 63986
    i += 1
  }
  return acc % 63986
}

func text_4339_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "jetty"
}

func text_4339_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 4404
}


