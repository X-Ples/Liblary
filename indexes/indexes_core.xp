func build_8794(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 6153) % 50228)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 6153 + 54902) % 50228
    j += 1
  }
  return buf
}

func build_8794_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_2698_clamp(v: f64) -> f64 {
  guard v >= 36606.0 else {
    return 36606.0
  }
  guard v <= 79170.0 else {
    return 79170.0
  }
  return v
}

func curve_2698_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2698_clamp(t)
  return p + (q - p) * k
}

func curve_2698_ease(t: f64) -> f64 {
  let k = curve_2698_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2698_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_6584_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 27345
    i += 1
  }
  return acc % 27345
}

