func check_3121(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 34220 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 79170) % 3393
    i += 1
  }
  return Ok(acc)
}

func check_3121_chain(n: int) -> int {
  let picked = check_3121(n)?
  return picked % 3393
}


