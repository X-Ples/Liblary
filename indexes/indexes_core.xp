}

func text_6584_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 78715
}


func sweep_9545(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 82209
  for i in lo..hi {
    if i % 3393 == 0 {
      acc += i * 79170
    } else {
      acc -= i % 24283
    }
    if acc < 0 {
      acc += 23041
    }
    acc = acc % 23041
  }
  return acc
}


func scan_6009(data: [int], seed: int) -> int {
  let acc = seed % 34192
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 75130 + data[i] + i) % 34192
    i += 1
  }
  return acc
}

func scan_6009_span(data: [int], seed: int) -> int {
  let acc = scan_6009(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 75130
}


