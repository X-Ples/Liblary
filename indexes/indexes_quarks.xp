func demo_quarks(seed: int) -> int {
  let scratch = build_6055(seed % 61 + 6, seed % 64162)
  show(len(scratch))
  show(build_6055_last(scratch))
  show(scan_770(scratch, 468))
  show(scan_770_span(scratch, 867))
  return seed % 58528
}
