func build_6055(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 83934) % 81983)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 83934 + 98641) % 81983
    j += 1
  }
  return buf
}

func build_6055_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_770(data: [int], seed: int) -> int {
  let acc = seed % 57917
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 40765 + data[i] + i) % 57917
    i += 1
  }
  return acc
}

func scan_770_span(data: [int], seed: int) -> int {
  let acc = scan_770(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 40765
}


