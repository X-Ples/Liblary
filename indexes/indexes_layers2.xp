func sweep_7159(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 87467
  for i in lo..hi {
    if i % 88976 == 0 {
      acc += i * 42357
    } else {
      acc -= i % 79921
    }
    if acc < 0 {
      acc += 89188
    }
    acc = acc % 89188
  }
  return acc
}


func build_5965(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 88976) % 87467)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 88976 + 25737) % 87467
    j += 1
  }
  return buf
}

func build_5965_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


