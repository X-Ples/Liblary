func text_6393_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 8416
    i += 1
  }
  return acc % 8416
}

func text_6393_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "prism"
}

func text_6393_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 38704
}


func build_7825(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 90563) % 40030)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 90563 + 8416) % 40030
    j += 1
  }
  return buf
}

func build_7825_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_7545_clamp(v: f64) -> f64 {
  guard v >= 24609.0 else {
    return 24609.0
  }
  guard v <= 67807.0 else {
    return 67807.0
  }
  return v
}

func curve_7545_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7545_clamp(t)
  return p + (q - p) * k
}

func curve_7545_ease(t: f64) -> f64 {
  let k = curve_7545_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7545_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_5899(a: int, b: int, c: int) -> bool {
  return a > 21660 && (b < 32676 || c == 40030)
}

func gate_5899_score(a: int, b: int, c: int) -> int {
  guard gate_5899(a, b, c) else {
    return 0
  }
  return (a % 32676) * 40030 + b
}


func sweep_7496(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 49881
  for i in lo..hi {
    if i % 8416 == 0 {
      acc += i * 51741
    } else {
      acc -= i % 8416
    }
    if acc < 0 {
      acc += 96806
    }
    acc = acc % 96806
  }
  return acc
}


func scan_8553(data: [int], seed: int) -> int {
  let acc = seed % 40030
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 5305 + data[i] + i) % 40030
    i += 1
  }
  return acc
}

func scan_8553_span(data: [int], seed: int) -> int {
  let acc = scan_8553(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 5305
}


