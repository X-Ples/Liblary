func row_1034() -> [int] {
  return [1614, 272, 2734, 3178, 3118, 2683, 1254, 2754, 2216, 2002, 3508, 633, 967]
}

func row_1034_at(i: int) -> int {
  let row = row_1034()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1034_sum(limit: int) -> int {
  let row = row_1034()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1034_best() -> int {
  let row = row_1034()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


