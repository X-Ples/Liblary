func grid_5653_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 59476 + c * 52545 + seed) % 52545)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5653_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 52545 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_2987(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 60331) % 22411)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 60331 + 60331) % 22411
    j += 1
  }
  return buf
}

func build_2987_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_9874(a: int, b: int, c: int) -> bool {
  return a > 69835 && (b < 28747 || c == 8185)
}

func gate_9874_score(a: int, b: int, c: int) -> int {
  guard gate_9874(a, b, c) else {
    return 0
  }
  return (a % 28747) * 8185 + b
}


func sweep_6445(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 60331
  for i in lo..hi {
    if i % 28747 == 0 {
      acc += i * 56905
    } else {
      acc -= i % 30890
    }
    if acc < 0 {
      acc += 69835
    }
    acc = acc % 69835
  }
  return acc
}


func scan_3725(data: [int], seed: int) -> int {
  let acc = seed % 5191
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 33291 + data[i] + i) % 5191
    i += 1
  }
  return acc
}

func scan_3725_span(data: [int], seed: int) -> int {
  let acc = scan_3725(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 33291
}


