func demo_trims(seed: int) -> int {
  let scratch = build_2987(seed % 61 + 6, seed % 21294)
  show(len(scratch))
  show(grid_5653_rowsum(scratch, 3391, 3131, 1803))
  show(build_2987_last(scratch))
  show(gate_9874(1366, 2603, 878))
  show(gate_9874_score(2388, 3512, 14))
  return seed % 30890
}
