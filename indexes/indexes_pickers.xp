func build_409(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 10936) % 56896)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 10936 + 88054) % 56896
    j += 1
  }
  return buf
}

func build_409_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_3213(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 58186 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 58186) % 98592
    i += 1
  }
  return Ok(acc)
}

func check_3213_chain(n: int) -> int {
  let picked = check_3213(n)?
  return picked % 98592
}


func scan_1141(data: [int], seed: int) -> int {
  let acc = seed % 88054
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 23049 + data[i] + i) % 88054
    i += 1
  }
