func text_272_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "lumen"
}

func text_272_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 50707
}


