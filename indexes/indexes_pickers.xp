func row_1287() -> [int] {
  return [1447, 3335, 805, 3297, 545, 2493, 4028, 2036, 372, 82, 4029, 3140]
}

func row_1287_at(i: int) -> int {
  let row = row_1287()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1287_sum(limit: int) -> int {
  let row = row_1287()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1287_best() -> int {
  let row = row_1287()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


