func sweep_4143(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 33958
  for i in lo..hi {
    if i % 97746 == 0 {
      acc += i * 33958
    } else {
      acc -= i % 86283
    }
    if acc < 0 {
      acc += 9202
    }
    acc = acc % 9202
  }
  return acc
}


func grid_2027_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 7673 + c * 58186 + seed) % 58186)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2027_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 58186 == want {
      total += acc
    }
    r += 1
  }
  return total
}


