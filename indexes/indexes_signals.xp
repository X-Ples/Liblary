func demo_signals(seed: int) -> int {
  let scratch = build_4917(seed % 61 + 6, seed % 52896)
  show(len(scratch))
  show(gate_7242(1222, 1999, 234))
  show(gate_7242_score(1057, 1742, 3407))
  show(build_4917_last(scratch))
  show(row_556_at(169))
  return seed % 86862
}
