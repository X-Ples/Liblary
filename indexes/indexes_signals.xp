func scan_8240(data: [int], seed: int) -> int {
  let acc = seed % 82768
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 147 + data[i] + i) % 82768
    i += 1
  }
  return acc
}

func scan_8240_span(data: [int], seed: int) -> int {
  let acc = scan_8240(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 147
}


func text_5226_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 62828
    i += 1
  }
  return acc % 62828
}

func text_5226_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "quartz"
}

func text_5226_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 80585
}


func grid_9243_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 86862 + c * 85075 + seed) % 85075)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9243_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 85075 == want {
      total += acc
    }
    r += 1
  }
  return total
}


