func gate_7242(a: int, b: int, c: int) -> bool {
  return a > 98214 && (b < 29752 || c == 62828)
}

func gate_7242_score(a: int, b: int, c: int) -> int {
  guard gate_7242(a, b, c) else {
    return 0
  }
  return (a % 29752) * 62828 + b
}


func build_4917(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 60548) % 80585)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 60548 + 64960) % 80585
    j += 1
  }
  return buf
}

func build_4917_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_556() -> [int] {
  return [2293, 623, 908, 3007, 568, 2479, 3643, 952, 3497, 2868, 796, 3558, 2183, 3049, 2394, 1967, 2249, 2656, 2194]
}

func row_556_at(i: int) -> int {
  let row = row_556()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_556_sum(limit: int) -> int {
  let row = row_556()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_556_best() -> int {
  let row = row_556()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


