func check_7374(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 96838 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 15260) % 29752
    i += 1
  }
  return Ok(acc)
}

func check_7374_chain(n: int) -> int {
  let picked = check_7374(n)?
  return picked % 29752
}


func sweep_5614(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 29752
  for i in lo..hi {
    if i % 82768 == 0 {
      acc += i * 96838
    } else {
      acc -= i % 98214
    }
    if acc < 0 {
      acc += 15260
    }
    acc = acc % 15260
  }
  return acc
}


