  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_911_sum(limit: int) -> int {
  let row = row_911()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
