func build_1346(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 16459) % 9779)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 16459 + 75165) % 9779
    j += 1
  }
  return buf
}

func build_1346_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_2580(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 73224 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 88818) % 58137
    i += 1
  }
  return Ok(acc)
}

func check_2580_chain(n: int) -> int {
  let picked = check_2580(n)?
  return picked % 58137
}


func grid_8764_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 49894 + c * 59002 + seed) % 59002)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8764_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 59002 == want {
      total += acc
    }
    r += 1
  }
  return total
}


