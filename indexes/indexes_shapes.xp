func sweep_339(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 34467
  for i in lo..hi {
    if i % 72927 == 0 {
      acc += i * 47874
    } else {
      acc -= i % 53460
