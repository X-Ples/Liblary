func demo_kernels(seed: int) -> int {
  let scratch = build_9100(seed % 61 + 6, seed % 40699)
  show(len(scratch))
  show(build_9100_last(scratch))
  show(order_8986_find(scratch, 2588))
  show(text_3319_weight("omega"))
  return seed % 32778
}
