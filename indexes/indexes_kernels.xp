    let c = 0
    while c < cols {
      array_push(cells, (r * 30537 + c * 80876 + seed) % 80876)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5546_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
