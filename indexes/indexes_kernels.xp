func gate_6012(a: int, b: int, c: int) -> bool {
  return a > 40699 && (b < 34206 || c == 62960)
}

func gate_6012_score(a: int, b: int, c: int) -> int {
  guard gate_6012(a, b, c) else {
    return 0
  }
  return (a % 34206) * 62960 + b
}


func scan_844(data: [int], seed: int) -> int {
  let acc = seed % 33591
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 96260 + data[i] + i) % 33591
    i += 1
  }
  return acc
}

func scan_844_span(data: [int], seed: int) -> int {
  let acc = scan_844(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 96260
}


