func build_2012(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 72060) % 3882)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 72060 + 4062) % 3882
    j += 1
  }
  return buf
}

func build_2012_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_7785() -> [int] {
  return [1251, 1067, 1442, 576, 1805, 109, 661, 2555, 351, 2874, 460]
}

func row_7785_at(i: int) -> int {
  let row = row_7785()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7785_sum(limit: int) -> int {
  let row = row_7785()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7785_best() -> int {
  let row = row_7785()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_7070(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 42766
  for i in lo..hi {
    if i % 18255 == 0 {
      acc += i * 67535
    } else {
      acc -= i % 55939
    }
    if acc < 0 {
      acc += 56415
    }
    acc = acc % 56415
  }
  return acc
}


func gate_6564(a: int, b: int, c: int) -> bool {
  return a > 67535 && (b < 3288 || c == 3288)
}

func gate_6564_score(a: int, b: int, c: int) -> int {
  guard gate_6564(a, b, c) else {
    return 0
  }
  return (a % 3288) * 3288 + b
}


func check_4682(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 30509 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 72060) % 72060
    i += 1
  }
  return Ok(acc)
}

func check_4682_chain(n: int) -> int {
  let picked = check_4682(n)?
  return picked % 72060
}


func curve_3862_clamp(v: f64) -> f64 {
  guard v >= 3882.0 else {
    return 3882.0
  }
  guard v <= 56415.0 else {
    return 56415.0
  }
  return v
}

func curve_3862_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3862_clamp(t)
  return p + (q - p) * k
}

func curve_3862_ease(t: f64) -> f64 {
  let k = curve_3862_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3862_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


