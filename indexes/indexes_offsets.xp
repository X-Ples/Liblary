func scan_1488(data: [int], seed: int) -> int {
  let acc = seed % 60666
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 42766 + data[i] + i) % 60666
    i += 1
  }
  return acc
}

func scan_1488_span(data: [int], seed: int) -> int {
  let acc = scan_1488(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 42766
}


