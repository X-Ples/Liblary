func demo_twists(seed: int) -> int {
  let scratch = build_5327(seed % 61 + 6, seed % 27336)
  show(len(scratch))
  show(sweep_3061(573, 3694))
  show(check_2862_chain(824))
  show(scan_5021(scratch, 427))
  return seed % 90248
}
