func sweep_3061(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 53599
  for i in lo..hi {
    if i % 27336 == 0 {
      acc += i * 44411
    } else {
      acc -= i % 44411
    }
    if acc < 0 {
      acc += 97277
    }
    acc = acc % 97277
  }
  return acc
}


func check_2862(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 86367 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 44411) % 86392
    i += 1
  }
  return Ok(acc)
}

func check_2862_chain(n: int) -> int {
  let picked = check_2862(n)?
  return picked % 86392
}


func scan_5021(data: [int], seed: int) -> int {
  let acc = seed % 26396
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 90248 + data[i] + i) % 26396
    i += 1
  }
  return acc
}

func scan_5021_span(data: [int], seed: int) -> int {
  let acc = scan_5021(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 90248
}


