func scan_1098(data: [int], seed: int) -> int {
  let acc = seed % 90954
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 51354 + data[i] + i) % 90954
    i += 1
  }
