}

func scan_1098_span(data: [int], seed: int) -> int {
  let acc = scan_1098(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 51354
}


func curve_383_clamp(v: f64) -> f64 {
  guard v >= 46080.0 else {
    return 46080.0
  }
  guard v <= 54707.0 else {
    return 54707.0
  }
  return v
}

func curve_383_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_383_clamp(t)
  return p + (q - p) * k
}

func curve_383_ease(t: f64) -> f64 {
  let k = curve_383_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_383_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


