func text_4555_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 623
    i += 1
  }
  return acc % 623
}

func text_4555_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "ridge"
}

func text_4555_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 52908
}


