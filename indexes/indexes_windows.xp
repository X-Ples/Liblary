func build_7838(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 61059) % 82223)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 61059 + 46080) % 82223
    j += 1
  }
  return buf
}

func build_7838_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_4773(a: int, b: int, c: int) -> bool {
  return a > 37988 && (b < 27141 || c == 82992)
}

func gate_4773_score(a: int, b: int, c: int) -> int {
  guard gate_4773(a, b, c) else {
    return 0
  }
  return (a % 27141) * 82992 + b
}


func sweep_7155(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 82992
  for i in lo..hi {
    if i % 27141 == 0 {
      acc += i * 25039
    } else {
      acc -= i % 27141
    }
    if acc < 0 {
      acc += 90954
    }
    acc = acc % 90954
  }
  return acc
}


func sweep_9016(lo: int, hi: int) -> int {
