func demo_windows(seed: int) -> int {
  let scratch = build_7838(seed % 61 + 6, seed % 74712)
  show(len(scratch))
  show(build_7838_last(scratch))
  show(gate_4773(34, 1098, 1421))
  show(gate_4773_score(2509, 1444, 1067))
  show(sweep_7155(636, 3423))
  show(sweep_9016(2805, 3831))
  return seed % 35436
}
