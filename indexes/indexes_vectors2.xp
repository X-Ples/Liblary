func sweep_1154(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 11256
  for i in lo..hi {
    if i % 24726 == 0 {
      acc += i * 41930
    } else {
      acc -= i % 11256
    }
    if acc < 0 {
      acc += 87396
    }
    acc = acc % 87396
  }
  return acc
}


