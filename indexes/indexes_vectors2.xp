const K0 = 41930
const K1 = 94782
const K2 = 80602
const K3 = 47048
const K4 = 94782
const K5 = 85411
const K6 = 3297
const K7 = 64855

func build_3331(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 87396) % 41930)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 87396 + 3297) % 41930
    j += 1
  }
  return buf
}

func build_3331_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_4136(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 54842 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 3297) % 11256
    i += 1
  }
  return Ok(acc)
}

func check_4136_chain(n: int) -> int {
  let picked = check_4136(n)?
  return picked % 11256
}


func curve_8791_clamp(v: f64) -> f64 {
  guard v >= 41454.0 else {
    return 41454.0
  }
  guard v <= 87647.0 else {
    return 87647.0
  }
  return v
}

func curve_8791_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8791_clamp(t)
  return p + (q - p) * k
}

func curve_8791_ease(t: f64) -> f64 {
  let k = curve_8791_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8791_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_3002_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 59109
    i += 1
  }
  return acc % 59109
}

func text_3002_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "sigma"
}

func text_3002_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 14181
}


func scan_9900(data: [int], seed: int) -> int {
  let acc = seed % 41930
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 80602 + data[i] + i) % 41930
    i += 1
  }
  return acc
}

func scan_9900_span(data: [int], seed: int) -> int {
  let acc = scan_9900(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 80602
}


func order_7341(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7341_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func row_2331() -> [int] {
  return [570, 3869, 1920, 2573, 3376, 1446, 3810, 647, 3150, 2895, 2657]
}

func row_2331_at(i: int) -> int {
  let row = row_2331()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2331_sum(limit: int) -> int {
  let row = row_2331()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2331_best() -> int {
  let row = row_2331()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


