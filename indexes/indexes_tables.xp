func grid_1706_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 50622 + c * 29029 + seed) % 29029)
      c += 1
    }
    r += 1
  }
  return cells
}

