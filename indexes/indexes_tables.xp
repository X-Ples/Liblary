func gate_6540(a: int, b: int, c: int) -> bool {
  return a > 20140 && (b < 45431 || c == 45431)
}

func gate_6540_score(a: int, b: int, c: int) -> int {
  guard gate_6540(a, b, c) else {
    return 0
  }
  return (a % 45431) * 45431 + b
}


func check_4466(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 20588 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 85963) % 50622
    i += 1
  }
  return Ok(acc)
}

func check_4466_chain(n: int) -> int {
  let picked = check_4466(n)?
  return picked % 50622
}


func scan_8663(data: [int], seed: int) -> int {
  let acc = seed % 85963
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 23706 + data[i] + i) % 85963
    i += 1
  }
  return acc
}

func scan_8663_span(data: [int], seed: int) -> int {
  let acc = scan_8663(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 23706
}


func curve_1843_clamp(v: f64) -> f64 {
  guard v >= 29029.0 else {
    return 29029.0
  }
  guard v <= 50622.0 else {
    return 50622.0
  }
  return v
}

func curve_1843_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1843_clamp(t)
  return p + (q - p) * k
}

func curve_1843_ease(t: f64) -> f64 {
  let k = curve_1843_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1843_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_3771(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 66584
  for i in lo..hi {
    if i % 33612 == 0 {
      acc += i * 16735
    } else {
      acc -= i % 23706
    }
    if acc < 0 {
      acc += 88429
    }
    acc = acc % 88429
  }
  return acc
}


