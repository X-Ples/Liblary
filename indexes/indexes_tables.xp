  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 29029 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func demo_tables(seed: int) -> int {
  let scratch = build_9103(seed % 61 + 6, seed % 85963)
  show(len(scratch))
  show(gate_6540(2419, 288, 3689))
  show(gate_6540_score(3897, 3934, 3335))
  show(check_4466_chain(1292))
  show(scan_8663(scratch, 1841))
  show(scan_8663_span(scratch, 982))
  return seed % 29029
}
