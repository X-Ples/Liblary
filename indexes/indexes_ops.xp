func scan_9559(data: [int], seed: int) -> int {
  let acc = seed % 79251
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 22956 + data[i] + i) % 79251
    i += 1
  }
  return acc
}

