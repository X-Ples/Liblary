func demo_ops(seed: int) -> int {
  let scratch = build_1273(seed % 61 + 6, seed % 30094)
  show(len(scratch))
  show(build_1273_last(scratch))
  show(text_7085_weight("ember"))
  show(text_7085_label(1068))
  show(text_7085_has("kilo"))
  show(order_4156_find(scratch, 2838))
  show(scan_9559(scratch, 1597))
  return seed % 5450
}
