func demo_checks(seed: int) -> int {
  let scratch = build_8712(seed % 61 + 6, seed % 40465)
  show(len(scratch))
  show(build_8712_last(scratch))
  show(build_776_last(scratch))
  show(check_5870_chain(1412))
  show(grid_8880_rowsum(scratch, 3307, 3017, 1453))
  show(order_6126_find(scratch, 333))
  return seed % 24385
}
