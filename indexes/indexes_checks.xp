func sweep_7616(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 57068
  for i in lo..hi {
    if i % 42289 == 0 {
      acc += i * 22319
    } else {
      acc -= i % 17078
    }
    if acc < 0 {
      acc += 74757
    }
    acc = acc % 74757
  }
  return acc
}


