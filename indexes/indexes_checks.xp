func row_4177() -> [int] {
  return [3963, 52, 1251, 2769, 1317, 1946, 1792, 3723, 1122, 1407, 1125, 1536, 2215, 2291, 2767, 2279, 2623, 2607]
}

func row_4177_at(i: int) -> int {
  let row = row_4177()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4177_sum(limit: int) -> int {
  let row = row_4177()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4177_best() -> int {
  let row = row_4177()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


