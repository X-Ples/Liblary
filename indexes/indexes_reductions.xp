func scan_3960(data: [int], seed: int) -> int {
  let acc = seed % 10394
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 92277 + data[i] + i) % 10394
    i += 1
  }
  return acc
}

func scan_3960_span(data: [int], seed: int) -> int {
  let acc = scan_3960(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 92277
}


