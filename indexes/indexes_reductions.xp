func sweep_8399(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 3189
  for i in lo..hi {
    if i % 3754 == 0 {
      acc += i * 14735
    } else {
      acc -= i % 3754
    }
    if acc < 0 {
      acc += 56079
    }
    acc = acc % 56079
  }
  return acc
}


func grid_3644_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 41713 + c * 16035 + seed) % 16035)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3644_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 16035 == want {
      total += acc
    }
    r += 1
  }
  return total
}


