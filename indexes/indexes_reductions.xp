func demo_reductions(seed: int) -> int {
  let scratch = build_5340(seed % 61 + 6, seed % 56745)
  show(len(scratch))
  show(order_1773_find(scratch, 545))
  show(build_5340_last(scratch))
  show(row_1015_at(1523))
  show(row_1015_sum(995))
  return seed % 65257
}
