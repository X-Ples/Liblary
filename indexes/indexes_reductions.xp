func gate_2195(a: int, b: int, c: int) -> bool {
  return a > 90995 && (b < 48948 || c == 4830)
}

func gate_2195_score(a: int, b: int, c: int) -> int {
  guard gate_2195(a, b, c) else {
    return 0
  }
  return (a % 48948) * 4830 + b
}


