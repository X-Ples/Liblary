func order_1773(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1773_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_5340(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 75282) % 3189)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 75282 + 19779) % 3189
    j += 1
  }
  return buf
}

func build_5340_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_1015() -> [int] {
  return [3461, 175, 975, 3021, 1557, 1274, 1058, 2440, 2720, 2249, 2565, 2094, 3619, 3733, 641, 3772, 1492]
}

func row_1015_at(i: int) -> int {
  let row = row_1015()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1015_sum(limit: int) -> int {
  let row = row_1015()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1015_best() -> int {
  let row = row_1015()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_2175(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 14735 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 2465) % 79155
    i += 1
  }
  return Ok(acc)
}

func check_2175_chain(n: int) -> int {
  let picked = check_2175(n)?
  return picked % 79155
}


