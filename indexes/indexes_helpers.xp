func row_2682() -> [int] {
  return [1161, 3111, 1747, 600, 143, 2217, 4051, 502, 1634, 759, 1967, 856, 3139, 3090, 715]
}

func row_2682_at(i: int) -> int {
  let row = row_2682()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2682_sum(limit: int) -> int {
  let row = row_2682()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2682_best() -> int {
  let row = row_2682()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


