func scan_7182(data: [int], seed: int) -> int {
  let acc = seed % 94678
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 6440 + data[i] + i) % 94678
    i += 1
  }
  return acc
}

func scan_7182_span(data: [int], seed: int) -> int {
  let acc = scan_7182(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 6440
}


func sweep_9375(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 63002
  for i in lo..hi {
    if i % 25249 == 0 {
      acc += i * 9413
    } else {
      acc -= i % 94678
    }
    if acc < 0 {
      acc += 91979
    }
    acc = acc % 91979
  }
  return acc
}


