func demo_helpers(seed: int) -> int {
  let scratch = build_615(seed % 61 + 6, seed % 8156)
  show(len(scratch))
  show(scan_7182(scratch, 1848))
  show(scan_7182_span(scratch, 2798))
  show(sweep_9375(2791, 2734))
  show(build_615_last(scratch))
  return seed % 52623
}
