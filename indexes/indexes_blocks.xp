func row_8655() -> [int] {
  return [1889, 2143, 1563, 1129, 816, 65, 2344, 1438, 3261, 3184, 2553, 2529, 2548, 371, 2090, 2117, 3373]
}

func row_8655_at(i: int) -> int {
  let row = row_8655()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8655_sum(limit: int) -> int {
  let row = row_8655()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8655_best() -> int {
  let row = row_8655()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_8408_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 44935 + c * 81743 + seed) % 81743)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8408_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 81743 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_7975(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 34282
  for i in lo..hi {
    if i % 34282 == 0 {
      acc += i * 40079
    } else {
      acc -= i % 18339
    }
    if acc < 0 {
      acc += 18339
    }
    acc = acc % 18339
  }
  return acc
}


