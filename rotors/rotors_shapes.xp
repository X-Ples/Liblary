func build_2132(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 3878) % 27959)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 3878 + 15714) % 27959
    j += 1
  }
  return buf
}

func build_2132_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_198(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 96138
  for i in lo..hi {
    if i % 17664 == 0 {
      acc += i * 21134
    } else {
      acc -= i % 21134
    }
    if acc < 0 {
      acc += 72201
    }
    acc = acc % 72201
  }
  return acc
}


