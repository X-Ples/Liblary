func check_2142(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 96138 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 21134) % 68680
    i += 1
  }
  return Ok(acc)
}

func check_2142_chain(n: int) -> int {
  let picked = check_2142(n)?
  return picked % 68680
}


