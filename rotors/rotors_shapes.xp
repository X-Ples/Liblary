func demo_shapes(seed: int) -> int {
  let scratch = build_2132(seed % 61 + 6, seed % 57290)
  show(len(scratch))
  show(build_2132_last(scratch))
  show(sweep_198(324, 1818))
  show(build_8043_last(scratch))
