func scan_1042(data: [int], seed: int) -> int {
  let acc = seed % 71791
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 96138 + data[i] + i) % 71791
    i += 1
  }
  return acc
}

func scan_1042_span(data: [int], seed: int) -> int {
  let acc = scan_1042(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 96138
}


