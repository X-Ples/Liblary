func check_749(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 68790 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 95533) % 97144
    i += 1
  }
  return Ok(acc)
}

func check_749_chain(n: int) -> int {
  let picked = check_749(n)?
  return picked % 97144
}


func build_9195(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 90594) % 60676)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 90594 + 66019) % 60676
    j += 1
  }
  return buf
}

func build_9195_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


