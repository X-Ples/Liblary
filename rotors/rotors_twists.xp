func check_3826(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 60284 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 99513) % 14449
    i += 1
  }
  return Ok(acc)
}

func check_3826_chain(n: int) -> int {
  let picked = check_3826(n)?
  return picked % 14449
}


