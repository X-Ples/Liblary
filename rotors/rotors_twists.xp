func build_9973(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 40259) % 47617)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 40259 + 48570) % 47617
    j += 1
  }
  return buf
}

func build_9973_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_2436(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 16083
  for i in lo..hi {
    if i % 49049 == 0 {
      acc += i * 49049
    } else {
      acc -= i % 99513
    }
    if acc < 0 {
      acc += 40259
    }
    acc = acc % 40259
  }
  return acc
}


func gate_2463(a: int, b: int, c: int) -> bool {
  return a > 47617 && (b < 19101 || c == 21231)
}

func gate_2463_score(a: int, b: int, c: int) -> int {
  guard gate_2463(a, b, c) else {
    return 0
  }
  return (a % 19101) * 21231 + b
}


func row_9295() -> [int] {
