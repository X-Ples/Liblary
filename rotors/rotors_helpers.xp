func sweep_3637(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 12256
  for i in lo..hi {
    if i % 74475 == 0 {
      acc += i * 12256
    } else {
      acc -= i % 74475
    }
    if acc < 0 {
      acc += 63647
    }
    acc = acc % 63647
  }
  return acc
}


func check_5579(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 54012 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 95644) % 5831
    i += 1
  }
  return Ok(acc)
}

func check_5579_chain(n: int) -> int {
  let picked = check_5579(n)?
  return picked % 5831
}


func gate_1335(a: int, b: int, c: int) -> bool {
  return a > 5831 && (b < 9684 || c == 72961)
}

func gate_1335_score(a: int, b: int, c: int) -> int {
  guard gate_1335(a, b, c) else {
    return 0
  }
  return (a % 9684) * 72961 + b
}


