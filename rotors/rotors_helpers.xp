func curve_305_clamp(v: f64) -> f64 {
  guard v >= 42577.0 else {
    return 42577.0
  }
  guard v <= 72961.0 else {
    return 72961.0
  }
  return v
}

func curve_305_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_305_clamp(t)
  return p + (q - p) * k
}

func curve_305_ease(t: f64) -> f64 {
  let k = curve_305_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_305_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_7511() -> [int] {
  return [4061, 327, 2775, 1821, 3192, 870, 2631, 3677, 1061, 2272, 774, 950, 2574]
}

func row_7511_at(i: int) -> int {
  let row = row_7511()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7511_sum(limit: int) -> int {
  let row = row_7511()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7511_best() -> int {
  let row = row_7511()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_9736(data: [int], seed: int) -> int {
  let acc = seed % 37538
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 5831 + data[i] + i) % 37538
    i += 1
  }
  return acc
}

func scan_9736_span(data: [int], seed: int) -> int {
  let acc = scan_9736(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 5831
}


