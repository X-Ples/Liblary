func text_172_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 10736
    i += 1
  }
  return acc % 10736
}

func text_172_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "jetty"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "cargo"
}

func text_172_has(tag: str) -> bool {
  return str_contains(tag, "jetty") || len(tag) > 64940
}


func scan_5484(data: [int], seed: int) -> int {
  let acc = seed % 30273
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 64940 + data[i] + i) % 30273
    i += 1
  }
  return acc
}

func scan_5484_span(data: [int], seed: int) -> int {
  let acc = scan_5484(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 64940
}


