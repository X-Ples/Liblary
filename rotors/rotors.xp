func build_3111(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 68965) % 76829)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 68965 + 61946) % 76829
    j += 1
  }
  return buf
}

func build_3111_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_9909(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9909_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_2630(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 277
  for i in lo..hi {
    if i % 4972 == 0 {
      acc += i * 88495
    } else {
      acc -= i % 17484
    }
    if acc < 0 {
      acc += 75105
    }
    acc = acc % 75105
  }
  return acc
}


