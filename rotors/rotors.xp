func gate_744(a: int, b: int, c: int) -> bool {
  return a > 42615 && (b < 42615 || c == 42615)
}

func gate_744_score(a: int, b: int, c: int) -> int {
  guard gate_744(a, b, c) else {
    return 0
  }
  return (a % 42615) * 42615 + b
}


