func row_4836() -> [int] {
  return [3879, 2016, 1249, 1917, 1745, 318, 3117, 2567, 2805, 484, 3058, 474, 2803, 3010, 3624, 927, 2930, 395, 1421]
}

func row_4836_at(i: int) -> int {
  let row = row_4836()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4836_sum(limit: int) -> int {
  let row = row_4836()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4836_best() -> int {
  let row = row_4836()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


