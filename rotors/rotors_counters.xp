func row_1026() -> [int] {
  return [2070, 2094, 2212, 2672, 568, 1986, 249, 2869, 829, 2158, 2172, 306, 1272, 3614]
}

func row_1026_at(i: int) -> int {
  let row = row_1026()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1026_sum(limit: int) -> int {
  let row = row_1026()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1026_best() -> int {
  let row = row_1026()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_3575(a: int, b: int, c: int) -> bool {
  return a > 84399 && (b < 60821 || c == 93174)
}

func gate_3575_score(a: int, b: int, c: int) -> int {
  guard gate_3575(a, b, c) else {
    return 0
  }
  return (a % 60821) * 93174 + b
}


func curve_1716_clamp(v: f64) -> f64 {
  guard v >= 6629.0 else {
    return 6629.0
  }
  guard v <= 58639.0 else {
    return 58639.0
  }
  return v
}

func curve_1716_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1716_clamp(t)
  return p + (q - p) * k
}

func curve_1716_ease(t: f64) -> f64 {
  let k = curve_1716_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1716_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_4611(data: [int], seed: int) -> int {
  let acc = seed % 59341
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 23979 + data[i] + i) % 59341
    i += 1
  }
  return acc
}

func scan_4611_span(data: [int], seed: int) -> int {
  let acc = scan_4611(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 23979
}


func sweep_7825(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 67369
  for i in lo..hi {
    if i % 93174 == 0 {
      acc += i * 96573
    } else {
      acc -= i % 88110
    }
    if acc < 0 {
      acc += 59341
    }
    acc = acc % 59341
  }
  return acc
}


