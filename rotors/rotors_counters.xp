func demo_counters(seed: int) -> int {
  let scratch = build_4771(seed % 61 + 6, seed % 48550)
  show(len(scratch))
  show(build_4771_last(scratch))
  show(build_9940_last(scratch))
  show(row_1026_at(3475))
  show(row_1026_sum(974))
  return seed % 91587
}
