func demo_windows(seed: int) -> int {
  let scratch = build_9926(seed % 61 + 6, seed % 34143)
  show(len(scratch))
  show(sweep_7744(2983, 75))
  show(build_9926_last(scratch))
  show(scan_2083(scratch, 765))
  show(scan_2083_span(scratch, 527))
  show(build_409_last(scratch))
  show(build_7599_last(scratch))
  return seed % 61276
}
