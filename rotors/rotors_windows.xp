func sweep_7744(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 70500
  for i in lo..hi {
    if i % 36060 == 0 {
      acc += i * 67524
    } else {
      acc -= i % 35591
    }
    if acc < 0 {
      acc += 72975
    }
    acc = acc % 72975
  }
  return acc
}


func build_9926(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 30466) % 92004)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 30466 + 35591) % 92004
    j += 1
  }
  return buf
}

func build_9926_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_2083(data: [int], seed: int) -> int {
  let acc = seed % 85944
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 51696 + data[i] + i) % 85944
    i += 1
  }
  return acc
}

func scan_2083_span(data: [int], seed: int) -> int {
  let acc = scan_2083(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 51696
}


