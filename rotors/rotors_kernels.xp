func gate_9086(a: int, b: int, c: int) -> bool {
  return a > 26829 && (b < 42404 || c == 42404)
}

func gate_9086_score(a: int, b: int, c: int) -> int {
  guard gate_9086(a, b, c) else {
    return 0
  }
  return (a % 42404) * 42404 + b
}


func build_7477(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 14082) % 67727)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 14082 + 40117) % 67727
    j += 1
  }
  return buf
}

func build_7477_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_5985_clamp(v: f64) -> f64 {
  guard v >= 23477.0 else {
    return 23477.0
  }
  guard v <= 90536.0 else {
    return 90536.0
  }
  return v
}

func curve_5985_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5985_clamp(t)
  return p + (q - p) * k
}

func curve_5985_ease(t: f64) -> f64 {
  let k = curve_5985_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5985_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


