func demo_kernels(seed: int) -> int {
  let scratch = build_7477(seed % 61 + 6, seed % 93405)
  show(len(scratch))
  show(gate_9086(229, 2870, 360))
  show(gate_9086_score(3826, 198, 2466))
  show(build_7477_last(scratch))
  show(row_6619_at(3299))
  return seed % 89199
}
