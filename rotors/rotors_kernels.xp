func scan_134(data: [int], seed: int) -> int {
  let acc = seed % 55807
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 80354 + data[i] + i) % 55807
    i += 1
  }
  return acc
}

func scan_134_span(data: [int], seed: int) -> int {
  let acc = scan_134(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 80354
}


