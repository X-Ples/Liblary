}


func check_2933(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 94168 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 33206) % 32262
    i += 1
  }
  return Ok(acc)
}

func check_2933_chain(n: int) -> int {
  let picked = check_2933(n)?
  return picked % 32262
}


