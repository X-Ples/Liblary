func demo_vectors2(seed: int) -> int {
  let scratch = build_2494(seed % 61 + 6, seed % 22038)
  show(len(scratch))
  show(scan_6632(scratch, 2074))
  show(scan_6632_span(scratch, 3550))
  show(build_2494_last(scratch))
  show(order_6027_find(scratch, 101))
  show(build_8452_last(scratch))
  return seed % 66067
}
