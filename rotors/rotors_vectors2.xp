func sweep_512(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 1995
  for i in lo..hi {
    if i % 59335 == 0 {
      acc += i * 77949
    } else {
      acc -= i % 92577
    }
    if acc < 0 {
      acc += 47592
    }
    acc = acc % 47592
  }
  return acc
}


