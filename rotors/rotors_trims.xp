const K0 = 90470
const K1 = 39928
const K2 = 16883
const K3 = 10275
const K4 = 10757
const K5 = 71757
const K6 = 57035
const K7 = 43440
const K8 = 75520

func build_8285(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 57035) % 60721)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 57035 + 70856) % 60721
    j += 1
  }
  return buf
}

func build_8285_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_6441_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 60721 + c * 57796 + seed) % 57796)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6441_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 57796 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_7654(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 43407
  for i in lo..hi {
    if i % 39928 == 0 {
      acc += i * 91252
    } else {
      acc -= i % 92437
    }
    if acc < 0 {
      acc += 87493
    }
    acc = acc % 87493
  }
  return acc
}


func gate_6241(a: int, b: int, c: int) -> bool {
  return a > 57035 && (b < 43774 || c == 39928)
}

func gate_6241_score(a: int, b: int, c: int) -> int {
  guard gate_6241(a, b, c) else {
    return 0
  }
  return (a % 43774) * 39928 + b
}


func check_297(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 21113 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 99668) % 43774
    i += 1
  }
  return Ok(acc)
}

func check_297_chain(n: int) -> int {
  let picked = check_297(n)?
  return picked % 43774
}


func curve_1777_clamp(v: f64) -> f64 {
  guard v >= 16883.0 else {
    return 16883.0
  }
  guard v <= 75520.0 else {
    return 75520.0
  }
  return v
}

func curve_1777_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1777_clamp(t)
  return p + (q - p) * k
}

func curve_1777_ease(t: f64) -> f64 {
  let k = curve_1777_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1777_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


