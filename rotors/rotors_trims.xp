func demo_trims(seed: int) -> int {
  let scratch = build_8285(seed % 61 + 6, seed % 39928)
  show(len(scratch))
  show(build_8285_last(scratch))
  show(grid_6441_rowsum(scratch, 1149, 827, 1010))
  show(sweep_7654(2079, 3188))
  return seed % 64804
}
