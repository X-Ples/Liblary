func build_2387(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 4590) % 64773)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 4590 + 93153) % 64773
    j += 1
  }
  return buf
}

func build_2387_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_4101_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 59116
    i += 1
  }
  return acc % 59116
}

func text_4101_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "gamma"
}

func text_4101_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 33721
}


func grid_808_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 90782 + c * 93153 + seed) % 93153)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_808_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 93153 == want {
      total += acc
    }
    r += 1
  }
  return total
}


