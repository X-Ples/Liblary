func sweep_7897(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 12891
  for i in lo..hi {
    if i % 24445 == 0 {
      acc += i * 46599
    } else {
      acc -= i % 76722
    }
    if acc < 0 {
      acc += 55772
    }
    acc = acc % 55772
  }
  return acc
}


