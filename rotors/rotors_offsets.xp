func demo_offsets(seed: int) -> int {
  let scratch = build_2175(seed % 61 + 6, seed % 47211)
  show(len(scratch))
  show(build_2175_last(scratch))
  show(gate_6769(419, 3629, 2317))
  show(gate_6769_score(2234, 1053, 3773))
  return seed % 68207
}
