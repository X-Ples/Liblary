func build_2175(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 66018) % 68207)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 66018 + 38238) % 68207
    j += 1
  }
  return buf
}

func build_2175_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_6769(a: int, b: int, c: int) -> bool {
  return a > 39770 && (b < 46599 || c == 68207)
}

func gate_6769_score(a: int, b: int, c: int) -> int {
  guard gate_6769(a, b, c) else {
    return 0
  }
  return (a % 46599) * 68207 + b
}


func check_405(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 12891 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 27762) % 36453
    i += 1
  }
  return Ok(acc)
}

func check_405_chain(n: int) -> int {
  let picked = check_405(n)?
  return picked % 36453
}


func text_3601_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 47211
    i += 1
  }
  return acc % 47211
}

func text_3601_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "sigma"
}

func text_3601_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 32134
}


