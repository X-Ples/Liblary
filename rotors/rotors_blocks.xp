func check_1353(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 89401 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 64773) % 61040
    i += 1
  }
  return Ok(acc)
}

func check_1353_chain(n: int) -> int {
  let picked = check_1353(n)?
  return picked % 61040
}


