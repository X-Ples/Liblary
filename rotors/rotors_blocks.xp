}


func scan_1470(data: [int], seed: int) -> int {
  let acc = seed % 5117
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 22741 + data[i] + i) % 5117
    i += 1
  }
  return acc
}

func scan_1470_span(data: [int], seed: int) -> int {
  let acc = scan_1470(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 22741
}


