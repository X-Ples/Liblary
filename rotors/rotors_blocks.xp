func grid_291_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 10323 + c * 27061 + seed) % 27061)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_291_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 27061 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_630(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 16093) % 74925)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 16093 + 7056) % 74925
    j += 1
  }
  return buf
}

func build_630_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_5051() -> [int] {
  return [129, 1270, 558, 2066, 488, 3051, 1277, 3217, 2840, 643, 4048, 1687, 3667, 1062, 3370, 853, 2323, 1448, 239]
}

func row_5051_at(i: int) -> int {
  let row = row_5051()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5051_sum(limit: int) -> int {
  let row = row_5051()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5051_best() -> int {
  let row = row_5051()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_8191(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 74925
  for i in lo..hi {
    if i % 74925 == 0 {
      acc += i * 10323
    } else {
      acc -= i % 11566
    }
    if acc < 0 {
      acc += 10717
    }
    acc = acc % 10717
  }
  return acc
}


func gate_9809(a: int, b: int, c: int) -> bool {
  return a > 10153 && (b < 11566 || c == 16093)
}

func gate_9809_score(a: int, b: int, c: int) -> int {
  guard gate_9809(a, b, c) else {
    return 0
  }
  return (a % 11566) * 16093 + b
}


func curve_6819_clamp(v: f64) -> f64 {
  guard v >= 89401.0 else {
    return 89401.0
  }
  guard v <= 95792.0 else {
    return 95792.0
  }
  return v
}

func curve_6819_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6819_clamp(t)
  return p + (q - p) * k
}

func curve_6819_ease(t: f64) -> f64 {
  let k = curve_6819_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6819_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_1293(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1293_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


