func build_3417(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 21383) % 57512)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 21383 + 48524) % 57512
    j += 1
  }
  return buf
}

func build_3417_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_212(a: int, b: int, c: int) -> bool {
  return a > 40325 && (b < 24824 || c == 39087)
}

func gate_212_score(a: int, b: int, c: int) -> int {
  guard gate_212(a, b, c) else {
    return 0
  }
  return (a % 24824) * 39087 + b
}


