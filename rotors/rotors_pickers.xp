func check_3172(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 97570 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 40325) % 94961
    i += 1
  }
  return Ok(acc)
}

func check_3172_chain(n: int) -> int {
  let picked = check_3172(n)?
  return picked % 94961
}


