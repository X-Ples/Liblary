func demo_pickers(seed: int) -> int {
  let scratch = build_3417(seed % 61 + 6, seed % 63915)
  show(len(scratch))
  show(build_3417_last(scratch))
  show(gate_212(3718, 1158, 2447))
  show(gate_212_score(3651, 1711, 2323))
  show(build_578_last(scratch))
  show(build_3115_last(scratch))
  show(row_7442_at(1417))
  return seed % 70247
}
