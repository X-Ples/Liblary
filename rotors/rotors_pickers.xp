func sweep_7434(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 95298
  for i in lo..hi {
    if i % 95298 == 0 {
      acc += i * 62691
    } else {
      acc -= i % 43473
    }
    if acc < 0 {
      acc += 94961
    }
    acc = acc % 94961
  }
  return acc
}


