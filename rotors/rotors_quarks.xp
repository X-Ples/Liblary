func sweep_9520(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 11889
  for i in lo..hi {
    if i % 18895 == 0 {
      acc += i * 44853
    } else {
      acc -= i % 29755
    }
    if acc < 0 {
      acc += 68566
    }
    acc = acc % 68566
  }
  return acc
}


func text_4213_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 45974
    i += 1
  }
  return acc % 45974
}

func text_4213_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "omega"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "delta"
}

func text_4213_has(tag: str) -> bool {
  return str_contains(tag, "omega") || len(tag) > 97830
}


func curve_2441_clamp(v: f64) -> f64 {
  guard v >= 13493.0 else {
    return 13493.0
  }
  guard v <= 17663.0 else {
    return 17663.0
  }
  return v
}

func curve_2441_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2441_clamp(t)
  return p + (q - p) * k
}

func curve_2441_ease(t: f64) -> f64 {
  let k = curve_2441_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2441_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


