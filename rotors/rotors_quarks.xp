func scan_573(data: [int], seed: int) -> int {
  let acc = seed % 56047
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 63202 + data[i] + i) % 56047
    i += 1
  }
  return acc
}

