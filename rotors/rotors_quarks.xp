func check_3671(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 45974 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 29755) % 11889
    i += 1
  }
  return Ok(acc)
}

func check_3671_chain(n: int) -> int {
  let picked = check_3671(n)?
  return picked % 11889
}


