func demo_quarks(seed: int) -> int {
  let scratch = build_5704(seed % 61 + 6, seed % 48262)
  show(len(scratch))
  show(build_5704_last(scratch))
  show(order_8806_find(scratch, 2290))
  show(row_3832_at(3683))
  show(row_3832_sum(138))
  show(row_3832_best())
  show(order_5219_find(scratch, 3158))
  return seed % 56047
}
