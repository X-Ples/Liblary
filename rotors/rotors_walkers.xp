func demo_walkers(seed: int) -> int {
  let scratch = build_9420(seed % 61 + 6, seed % 62182)
  show(len(scratch))
  show(check_7566_chain(3390))
  show(order_5877_find(scratch, 45))
  show(build_9420_last(scratch))
  show(order_6672_find(scratch, 1060))
  show(grid_7268_rowsum(scratch, 1042, 3662, 3301))
  return seed % 52067
}
