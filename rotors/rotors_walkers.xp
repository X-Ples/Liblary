func grid_7268_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 99904 + c * 93440 + seed) % 93440)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7268_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 93440 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_7243(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 47385
  for i in lo..hi {
    if i % 93440 == 0 {
      acc += i * 13995
    } else {
      acc -= i % 60797
    }
    if acc < 0 {
      acc += 57079
    }
    acc = acc % 57079
  }
  return acc
}


