func scan_2609(data: [int], seed: int) -> int {
  let acc = seed % 70815
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 69098 + data[i] + i) % 70815
    i += 1
  }
  return acc
}

func scan_2609_span(data: [int], seed: int) -> int {
  let acc = scan_2609(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 69098
}


