func demo_tables(seed: int) -> int {
  let scratch = build_3100(seed % 61 + 6, seed % 40231)
  show(len(scratch))
  show(build_3100_last(scratch))
  show(grid_7727_rowsum(scratch, 2714, 2979, 3781))
  show(text_1533_weight("cargo"))
  show(text_1533_label(741))
  show(text_1533_has("quartz"))
  return seed % 71059
}
