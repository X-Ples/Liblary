func sweep_5218(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 42027
  for i in lo..hi {
    if i % 40231 == 0 {
      acc += i * 42764
    } else {
      acc -= i % 37481
    }
    if acc < 0 {
      acc += 36504
    }
    acc = acc % 36504
  }
  return acc
}


