const K7 = 42764

func build_3100(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 55887) % 66323)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 55887 + 37823) % 66323
    j += 1
  }
  return buf
}

func build_3100_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_7727_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 24970 + c * 68573 + seed) % 68573)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7727_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 68573 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_1533_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 26382
    i += 1
  }
  return acc % 26382
}

func text_1533_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "prism"
}

func text_1533_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 53239
}


func gate_2596(a: int, b: int, c: int) -> bool {
  return a > 8178 && (b < 42764 || c == 40231)
}

func gate_2596_score(a: int, b: int, c: int) -> int {
  guard gate_2596(a, b, c) else {
    return 0
  }
  return (a % 42764) * 40231 + b
}


func curve_3669_clamp(v: f64) -> f64 {
  guard v >= 24970.0 else {
    return 24970.0
  }
  guard v <= 37481.0 else {
    return 37481.0
  }
  return v
}

func curve_3669_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3669_clamp(t)
  return p + (q - p) * k
}

func curve_3669_ease(t: f64) -> f64 {
  let k = curve_3669_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3669_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_5327(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 37481 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 37020) % 8178
    i += 1
  }
  return Ok(acc)
}

func check_5327_chain(n: int) -> int {
  let picked = check_5327(n)?
  return picked % 8178
}


