func scan_2355(data: [int], seed: int) -> int {
  let acc = seed % 87922
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 51681 + data[i] + i) % 87922
    i += 1
  }
  return acc
}

