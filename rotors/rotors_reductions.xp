func demo_reductions(seed: int) -> int {
  let scratch = build_2377(seed % 61 + 6, seed % 36544)
  show(len(scratch))
  show(grid_6486_rowsum(scratch, 830, 3172, 2471))
  show(build_2377_last(scratch))
  show(sweep_9961(950, 2306))
  show(build_1744_last(scratch))
  return seed % 30396
}
