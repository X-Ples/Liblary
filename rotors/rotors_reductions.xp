func scan_1533(data: [int], seed: int) -> int {
  let acc = seed % 30396
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 36133 + data[i] + i) % 30396
    i += 1
  }
  return acc
}

func scan_1533_span(data: [int], seed: int) -> int {
  let acc = scan_1533(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 36133
}


func curve_6937_clamp(v: f64) -> f64 {
  guard v >= 80018.0 else {
    return 80018.0
  }
  guard v <= 81912.0 else {
    return 81912.0
  }
  return v
}

func curve_6937_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6937_clamp(t)
  return p + (q - p) * k
}

func curve_6937_ease(t: f64) -> f64 {
  let k = curve_6937_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6937_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


