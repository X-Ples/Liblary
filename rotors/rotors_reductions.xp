func check_1251(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 22281 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 4518) % 44754
    i += 1
  }
  return Ok(acc)
}

func check_1251_chain(n: int) -> int {
  let picked = check_1251(n)?
  return picked % 44754
}


func row_5633() -> [int] {
  return [2297, 2403, 2396, 2549, 3857, 994, 3569, 3972, 3076, 2628, 1299, 37, 20, 656, 2709]
}

func row_5633_at(i: int) -> int {
  let row = row_5633()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5633_sum(limit: int) -> int {
  let row = row_5633()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5633_best() -> int {
  let row = row_5633()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_450(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_450_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


