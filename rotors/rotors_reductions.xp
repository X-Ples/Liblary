  while i < count {
    array_push(buf, (start + i * 2921) % 36544)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 2921 + 65690) % 36544
    j += 1
  }
  return buf
}

func build_2377_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_9961(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 36251
  for i in lo..hi {
    if i % 44754 == 0 {
      acc += i * 20460
    } else {
      acc -= i % 35153
    }
    if acc < 0 {
      acc += 30396
    }
    acc = acc % 30396
  }
  return acc
}


