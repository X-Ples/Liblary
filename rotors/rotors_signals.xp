func scan_2560(data: [int], seed: int) -> int {
  let acc = seed % 87396
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 90925 + data[i] + i) % 87396
    i += 1
  }
  return acc
}

func scan_2560_span(data: [int], seed: int) -> int {
  let acc = scan_2560(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 90925
}


