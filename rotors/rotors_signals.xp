func demo_signals(seed: int) -> int {
  let scratch = build_5317(seed % 61 + 6, seed % 11724)
  show(len(scratch))
  show(build_5317_last(scratch))
  show(order_5865_find(scratch, 1310))
  show(row_7797_at(3213))
  show(row_7797_sum(3504))
  show(row_7797_best())
  return seed % 46867
}
