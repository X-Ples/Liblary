func sweep_232(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 71743
  for i in lo..hi {
    if i % 13689 == 0 {
      acc += i * 68826
    } else {
      acc -= i % 6966
    }
    if acc < 0 {
      acc += 69090
    }
    acc = acc % 69090
  }
  return acc
}


func curve_5048_clamp(v: f64) -> f64 {
  guard v >= 28386.0 else {
    return 28386.0
  }
  guard v <= 68826.0 else {
    return 68826.0
  }
  return v
}

func curve_5048_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5048_clamp(t)
  return p + (q - p) * k
}

func curve_5048_ease(t: f64) -> f64 {
  let k = curve_5048_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5048_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


