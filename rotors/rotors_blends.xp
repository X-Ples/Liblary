func demo_blends(seed: int) -> int {
  let scratch = build_1679(seed % 61 + 6, seed % 12914)
  show(len(scratch))
  show(build_1679_last(scratch))
  show(order_6183_find(scratch, 3148))
  show(grid_2839_rowsum(scratch, 1630, 3244, 3257))
  show(gate_3817(3296, 2571, 765))
  return seed % 6966
}
