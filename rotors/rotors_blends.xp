func check_2834(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 11823 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 69090) % 11823
    i += 1
  }
  return Ok(acc)
}

func check_2834_chain(n: int) -> int {
  let picked = check_2834(n)?
  return picked % 11823
}


