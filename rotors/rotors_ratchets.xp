func build_4333(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 82892) % 2559)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 82892 + 33780) % 2559
    j += 1
  }
  return buf
}

func build_4333_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_2289_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 17921
    i += 1
  }
  return acc % 17921
}

func text_2289_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "harbor"
}

func text_2289_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 49296
}


