func grid_5484_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 65817 + c * 2559 + seed) % 2559)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5484_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 2559 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_7336(a: int, b: int, c: int) -> bool {
  return a > 2015 && (b < 2015 || c == 13683)
}

func gate_7336_score(a: int, b: int, c: int) -> int {
  guard gate_7336(a, b, c) else {
    return 0
  }
  return (a % 2015) * 13683 + b
}


func check_6300(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 2559 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 77938) % 13683
    i += 1
  }
  return Ok(acc)
}

func check_6300_chain(n: int) -> int {
  let picked = check_6300(n)?
  return picked % 13683
}


