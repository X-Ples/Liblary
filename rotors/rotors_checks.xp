func gate_9214(a: int, b: int, c: int) -> bool {
  return a > 80293 && (b < 46520 || c == 70006)
}

func gate_9214_score(a: int, b: int, c: int) -> int {
  guard gate_9214(a, b, c) else {
    return 0
  }
  return (a % 46520) * 70006 + b
}


func grid_7685_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 38620 + c * 92326 + seed) % 92326)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7685_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 92326 == want {
      total += acc
    }
    r += 1
  }
  return total
}


