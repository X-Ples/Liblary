}


func sweep_4193(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 78271
  for i in lo..hi {
    if i % 72137 == 0 {
      acc += i * 70006
    } else {
      acc -= i % 13044
    }
    if acc < 0 {
      acc += 55160
    }
    acc = acc % 55160
  }
  return acc
}


