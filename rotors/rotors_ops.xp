func build_5667(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 93323) % 52681)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 93323 + 50339) % 52681
    j += 1
  }
  return buf
}

func build_5667_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_745_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 69904
    i += 1
  }
  return acc % 69904
}

func text_745_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "ridge"
}

func text_745_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 37568
}


