func grid_3342_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 63128 + c * 63092 + seed) % 63092)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3342_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 63092 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func demo_reductions(seed: int) -> int {
  let scratch = build_3432(seed % 61 + 6, seed % 45555)
  show(len(scratch))
  show(build_3432_last(scratch))
  show(build_5144_last(scratch))
  show(row_9185_at(2646))
  return seed % 96290
}
