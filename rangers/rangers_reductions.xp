func sweep_3302(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 96290
  for i in lo..hi {
    if i % 44289 == 0 {
      acc += i * 63128
    } else {
      acc -= i % 21305
    }
    if acc < 0 {
      acc += 40491
    }
    acc = acc % 40491
  }
  return acc
}


func scan_7292(data: [int], seed: int) -> int {
  let acc = seed % 45555
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 87663 + data[i] + i) % 45555
    i += 1
  }
  return acc
}

func scan_7292_span(data: [int], seed: int) -> int {
  let acc = scan_7292(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 87663
}


func check_857(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 68880 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 45165) % 10590
    i += 1
  }
  return Ok(acc)
}

func check_857_chain(n: int) -> int {
  let picked = check_857(n)?
  return picked % 10590
}


func gate_1756(a: int, b: int, c: int) -> bool {
  return a > 87663 && (b < 63812 || c == 68880)
}

func gate_1756_score(a: int, b: int, c: int) -> int {
  guard gate_1756(a, b, c) else {
    return 0
  }
  return (a % 63812) * 68880 + b
}


