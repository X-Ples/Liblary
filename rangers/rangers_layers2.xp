func sweep_9264(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 73731
  for i in lo..hi {
    if i % 5316 == 0 {
      acc += i * 30780
    } else {
      acc -= i % 30780
    }
    if acc < 0 {
      acc += 8783
    }
    acc = acc % 8783
  }
  return acc
}


