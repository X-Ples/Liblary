func demo_layers2(seed: int) -> int {
  let scratch = build_8476(seed % 61 + 6, seed % 5316)
  show(len(scratch))
  show(build_8476_last(scratch))
  show(grid_758_rowsum(scratch, 589, 2904, 1418))
