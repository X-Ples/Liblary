func build_8476(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 2783) % 3348)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 2783 + 73731) % 3348
    j += 1
  }
  return buf
}

func build_8476_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_758_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 49016 + c * 98859 + seed) % 98859)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_758_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 98859 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_3540_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 8783
    i += 1
  }
  return acc % 8783
}

func text_3540_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "jetty"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "ridge"
}

func text_3540_has(tag: str) -> bool {
  return str_contains(tag, "jetty") || len(tag) > 67474
}


