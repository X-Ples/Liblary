func check_8058(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 86815 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 36723) % 62898
    i += 1
  }
  return Ok(acc)
}

func check_8058_chain(n: int) -> int {
  let picked = check_8058(n)?
  return picked % 62898
}


