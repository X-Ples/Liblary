  let acc = seed % 96803
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 86815 + data[i] + i) % 96803
    i += 1
  }
  return acc
}

func scan_8118_span(data: [int], seed: int) -> int {
  let acc = scan_8118(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 86815
}


