func build_3270(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 93657) % 51463)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 93657 + 55876) % 51463
    j += 1
  }
  return buf
}

func build_3270_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_3771(a: int, b: int, c: int) -> bool {
  return a > 46874 && (b < 38514 || c == 64150)
}

func gate_3771_score(a: int, b: int, c: int) -> int {
  guard gate_3771(a, b, c) else {
    return 0
  }
  return (a % 38514) * 64150 + b
}


func scan_7920(data: [int], seed: int) -> int {
  let acc = seed % 38514
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 64150 + data[i] + i) % 38514
    i += 1
  }
  return acc
}

func scan_7920_span(data: [int], seed: int) -> int {
  let acc = scan_7920(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 64150
}


func grid_1832_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 66373 + c * 55876 + seed) % 55876)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1832_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 55876 == want {
      total += acc
    }
    r += 1
  }
  return total
}


