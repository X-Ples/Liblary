func sweep_4063(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 22482
  for i in lo..hi {
    if i % 66373 == 0 {
      acc += i * 63073
    } else {
      acc -= i % 82095
    }
    if acc < 0 {
      acc += 82095
    }
    acc = acc % 82095
  }
  return acc
}


