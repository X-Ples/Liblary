    return 0
  }
  return row[i]
}

func row_8804_sum(limit: int) -> int {
  let row = row_8804()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
