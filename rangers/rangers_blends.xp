const K0 = 96396
const K1 = 77342
const K2 = 80506
const K3 = 96396
const K4 = 19973
const K5 = 19973
const K6 = 54265
const K7 = 889

func scan_5187(data: [int], seed: int) -> int {
  let acc = seed % 43450
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 54265 + data[i] + i) % 43450
    i += 1
  }
  return acc
}

func scan_5187_span(data: [int], seed: int) -> int {
  let acc = scan_5187(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 54265
}


func row_9879() -> [int] {
  return [1421, 1470, 348, 84, 795, 24, 3080, 1981, 1514, 10, 115, 926]
}

func row_9879_at(i: int) -> int {
  let row = row_9879()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9879_sum(limit: int) -> int {
  let row = row_9879()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9879_best() -> int {
  let row = row_9879()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_6212_clamp(v: f64) -> f64 {
  guard v >= 28249.0 else {
    return 28249.0
  }
  guard v <= 96396.0 else {
    return 96396.0
  }
  return v
}

func curve_6212_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6212_clamp(t)
  return p + (q - p) * k
}

func curve_6212_ease(t: f64) -> f64 {
  let k = curve_6212_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6212_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_8076(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 43450) % 33398)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 43450 + 26232) % 33398
    j += 1
  }
  return buf
}

func build_8076_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


