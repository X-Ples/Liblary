func check_3219(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 66478 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 54265) % 889
    i += 1
  }
  return Ok(acc)
}

func check_3219_chain(n: int) -> int {
  let picked = check_3219(n)?
  return picked % 889
}


func gate_1141(a: int, b: int, c: int) -> bool {
  return a > 889 && (b < 28249 || c == 57830)
}

func gate_1141_score(a: int, b: int, c: int) -> int {
  guard gate_1141(a, b, c) else {
    return 0
  }
  return (a % 28249) * 57830 + b
}


func grid_1368_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 50869 + c * 50869 + seed) % 50869)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1368_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 50869 == want {
      total += acc
    }
    r += 1
  }
  return total
}


