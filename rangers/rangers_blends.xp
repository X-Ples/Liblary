func demo_blends(seed: int) -> int {
  let scratch = build_8076(seed % 61 + 6, seed % 77342)
  show(len(scratch))
  show(scan_5187(scratch, 2859))
  show(scan_5187_span(scratch, 1285))
  show(row_9879_at(492))
  return seed % 60648
}
