func demo_bursts(seed: int) -> int {
  let scratch = build_2376(seed % 61 + 6, seed % 66052)
  show(len(scratch))
  show(build_2376_last(scratch))
  show(build_2671_last(scratch))
  show(gate_8754(650, 3896, 2658))
  show(gate_8754_score(629, 3267, 3608))
  return seed % 32142
}
