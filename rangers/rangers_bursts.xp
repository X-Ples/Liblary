func check_6193(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 43521 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 3427) % 66052
    i += 1
  }
  return Ok(acc)
}

func check_6193_chain(n: int) -> int {
  let picked = check_6193(n)?
  return picked % 66052
}


