func sweep_4126(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 44097
  for i in lo..hi {
    if i % 58372 == 0 {
      acc += i * 37348
    } else {
      acc -= i % 12591
    }
    if acc < 0 {
      acc += 97964
    }
    acc = acc % 97964
  }
  return acc
}


