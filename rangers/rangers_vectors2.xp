func scan_9191(data: [int], seed: int) -> int {
  let acc = seed % 8238
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 80746 + data[i] + i) % 8238
    i += 1
  }
  return acc
}

func scan_9191_span(data: [int], seed: int) -> int {
  let acc = scan_9191(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 80746
}


func build_6593(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
