    array_push(buf, (start + i * 99960) % 44177)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 99960 + 84585) % 44177
    j += 1
  }
  return buf
}

func build_6593_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_6851(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 28832 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 22608) % 99960
    i += 1
  }
  return Ok(acc)
}

func check_6851_chain(n: int) -> int {
  let picked = check_6851(n)?
  return picked % 99960
}


func grid_3494_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 28832 + c * 35937 + seed) % 35937)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3494_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 35937 == want {
      total += acc
    }
    r += 1
  }
  return total
}


