func order_4170(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4170_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_2855(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 54094
  for i in lo..hi {
    if i % 21775 == 0 {
      acc += i * 22608
    } else {
      acc -= i % 26336
    }
    if acc < 0 {
      acc += 29320
    }
    acc = acc % 29320
  }
  return acc
}


func text_6801_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 56963
    i += 1
  }
  return acc % 56963
}

func text_6801_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "sigma"
}

func text_6801_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 66870
}


