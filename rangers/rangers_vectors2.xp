func demo_vectors2(seed: int) -> int {
  let scratch = build_6593(seed % 61 + 6, seed % 35937)
  show(len(scratch))
  show(scan_9191(scratch, 723))
  show(scan_9191_span(scratch, 999))
  show(build_6593_last(scratch))
  show(check_6851_chain(2043))
  show(grid_3494_rowsum(scratch, 672, 1570, 3189))
  return seed % 64389
}
