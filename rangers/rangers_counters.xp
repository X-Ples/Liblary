func scan_4981(data: [int], seed: int) -> int {
  let acc = seed % 79633
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 70652 + data[i] + i) % 79633
    i += 1
  }
  return acc
}

func scan_4981_span(data: [int], seed: int) -> int {
  let acc = scan_4981(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 70652
}


