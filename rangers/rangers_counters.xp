func check_1240(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 87033 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 34251) % 28526
    i += 1
  }
  return Ok(acc)
}

func check_1240_chain(n: int) -> int {
  let picked = check_1240(n)?
  return picked % 28526
}


