func sweep_4425(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 87033
  for i in lo..hi {
    if i % 161 == 0 {
      acc += i * 28526
    } else {
      acc -= i % 34521
    }
    if acc < 0 {
      acc += 33020
    }
    acc = acc % 33020
  }
  return acc
}


