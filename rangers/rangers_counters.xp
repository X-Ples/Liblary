func row_5659() -> [int] {
  return [3302, 3110, 1327, 3879, 1649, 2340, 1020, 3920, 2147, 3295, 2910, 1231, 2057, 3660, 2126]
}

func row_5659_at(i: int) -> int {
  let row = row_5659()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5659_sum(limit: int) -> int {
  let row = row_5659()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5659_best() -> int {
  let row = row_5659()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


