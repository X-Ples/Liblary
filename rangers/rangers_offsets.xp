func build_2533(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 64934) % 5937)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 64934 + 4815) % 5937
    j += 1
  }
  return buf
}

func build_2533_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_9725_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 5937 + c * 84256 + seed) % 84256)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9725_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 84256 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_8917_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 71397
    i += 1
  }
  return acc % 71397
}

func text_8917_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "jetty"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "omega"
}

func text_8917_has(tag: str) -> bool {
  return str_contains(tag, "jetty") || len(tag) > 63743
}


func sweep_8134(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 4815
  for i in lo..hi {
    if i % 71397 == 0 {
      acc += i * 64934
    } else {
      acc -= i % 71397
    }
    if acc < 0 {
      acc += 82842
    }
    acc = acc % 82842
  }
  return acc
}


