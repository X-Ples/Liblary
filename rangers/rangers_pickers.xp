func text_5055_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 85155
    i += 1
  }
  return acc % 85155
}

func text_5055_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "sigma"
}

func text_5055_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 40637
}


func demo_pickers(seed: int) -> int {
  let scratch = build_4821(seed % 61 + 6, seed % 68097)
  show(len(scratch))
  show(build_4821_last(scratch))
  show(sweep_5482(32, 2718))
  show(row_7055_at(195))
  show(row_7055_sum(645))
  show(row_7055_best())
  return seed % 27257
}
