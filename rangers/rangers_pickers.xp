func build_4821(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 94794) % 27257)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 94794 + 9834) % 27257
    j += 1
  }
  return buf
}

func build_4821_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_2771_clamp(v: f64) -> f64 {
  guard v >= 52820.0 else {
    return 52820.0
  }
  guard v <= 68097.0 else {
    return 68097.0
  }
  return v
}

func curve_2771_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2771_clamp(t)
  return p + (q - p) * k
}

func curve_2771_ease(t: f64) -> f64 {
  let k = curve_2771_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2771_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_5482(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 94794
  for i in lo..hi {
    if i % 27428 == 0 {
      acc += i * 66764
    } else {
      acc -= i % 69936
    }
    if acc < 0 {
      acc += 41699
    }
    acc = acc % 41699
  }
  return acc
}


func row_7055() -> [int] {
  return [3645, 1100, 575, 2442, 681, 474, 2589, 1507, 2854, 1973, 3057]
}

func row_7055_at(i: int) -> int {
  let row = row_7055()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7055_sum(limit: int) -> int {
  let row = row_7055()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7055_best() -> int {
  let row = row_7055()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_7624(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7624_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


