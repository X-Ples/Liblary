func scan_8296(data: [int], seed: int) -> int {
  let acc = seed % 68097
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 65486 + data[i] + i) % 68097
    i += 1
  }
  return acc
}

func scan_8296_span(data: [int], seed: int) -> int {
  let acc = scan_8296(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 65486
}


