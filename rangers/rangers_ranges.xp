func build_1928(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 6804) % 26107)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 6804 + 71587) % 26107
    j += 1
  }
  return buf
}

func build_1928_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_1618_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 50670 + c * 76323 + seed) % 76323)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1618_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 76323 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func order_4005(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4005_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_2271(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 19436
  for i in lo..hi {
    if i % 7019 == 0 {
      acc += i * 71587
    } else {
      acc -= i % 59588
    }
    if acc < 0 {
      acc += 29107
    }
    acc = acc % 29107
  }
  return acc
}


