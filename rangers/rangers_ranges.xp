func text_5230_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "bravo"
}

func text_5230_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 27048
}


