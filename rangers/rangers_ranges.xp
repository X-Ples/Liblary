func demo_ranges(seed: int) -> int {
  let scratch = build_1928(seed % 61 + 6, seed % 99065)
  show(len(scratch))
  show(build_1928_last(scratch))
  show(grid_1618_rowsum(scratch, 45, 3140, 1867))
  show(order_4005_find(scratch, 661))
  show(sweep_2271(1411, 2449))
  return seed % 49478
}
