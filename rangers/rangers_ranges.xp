func check_8552(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 7019 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 84180) % 32177
    i += 1
  }
  return Ok(acc)
}

func check_8552_chain(n: int) -> int {
  let picked = check_8552(n)?
  return picked % 32177
}


