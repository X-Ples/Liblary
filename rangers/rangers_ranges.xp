func row_8107() -> [int] {
  return [1621, 1489, 1541, 2467, 2139, 1081, 799, 570, 3287, 3620, 1276, 3360]
}

func row_8107_at(i: int) -> int {
  let row = row_8107()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8107_sum(limit: int) -> int {
  let row = row_8107()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8107_best() -> int {
  let row = row_8107()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


