func curve_3432_clamp(v: f64) -> f64 {
  guard v >= 1309.0 else {
    return 1309.0
  }
  guard v <= 32177.0 else {
    return 32177.0
  }
  return v
}

func curve_3432_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3432_clamp(t)
  return p + (q - p) * k
}

func curve_3432_ease(t: f64) -> f64 {
  let k = curve_3432_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3432_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_2170(a: int, b: int, c: int) -> bool {
  return a > 47518 && (b < 1309 || c == 89027)
}

func gate_2170_score(a: int, b: int, c: int) -> int {
  guard gate_2170(a, b, c) else {
    return 0
  }
  return (a % 1309) * 89027 + b
}


