func build_9977(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 7736) % 36263)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 7736 + 31646) % 36263
    j += 1
  }
  return buf
}

func build_9977_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_2248() -> [int] {
  return [105, 657, 3336, 82, 1152, 2189, 2579, 2786, 4073, 2483]
}

func row_2248_at(i: int) -> int {
  let row = row_2248()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2248_sum(limit: int) -> int {
  let row = row_2248()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2248_best() -> int {
  let row = row_2248()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_683_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 3895
    i += 1
  }
  return acc % 3895
}

func text_683_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "sigma"
}

func text_683_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 3973
}


func curve_3855_clamp(v: f64) -> f64 {
  guard v >= 5420.0 else {
    return 5420.0
  }
  guard v <= 77331.0 else {
    return 77331.0
  }
  return v
}

func curve_3855_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3855_clamp(t)
  return p + (q - p) * k
}

func curve_3855_ease(t: f64) -> f64 {
  let k = curve_3855_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3855_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


