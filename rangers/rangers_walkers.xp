func build_2484(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 82489) % 46755)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 82489 + 6885) % 46755
    j += 1
  }
  return buf
}

func build_2484_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_5524(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 82195
  for i in lo..hi {
    if i % 82489 == 0 {
      acc += i * 77193
    } else {
      acc -= i % 30838
    }
    if acc < 0 {
      acc += 99120
    }
    acc = acc % 99120
  }
  return acc
}


