func check_7620(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 19305 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 37512) % 7896
    i += 1
  }
  return Ok(acc)
}

func check_7620_chain(n: int) -> int {
  let picked = check_7620(n)?
  return picked % 7896
}


