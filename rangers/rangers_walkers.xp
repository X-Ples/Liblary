func curve_7667_clamp(v: f64) -> f64 {
  guard v >= 7896.0 else {
    return 7896.0
  }
  guard v <= 80547.0 else {
    return 80547.0
  }
  return v
}

func curve_7667_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7667_clamp(t)
  return p + (q - p) * k
}

func curve_7667_ease(t: f64) -> f64 {
  let k = curve_7667_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7667_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


