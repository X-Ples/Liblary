func demo_ratchets(seed: int) -> int {
  let scratch = build_5603(seed % 61 + 6, seed % 65983)
  show(len(scratch))
  show(build_5603_last(scratch))
  show(scan_8517(scratch, 3808))
  show(scan_8517_span(scratch, 1922))
  show(sweep_8596(3844, 1362))
  show(check_5131_chain(3208))
  return seed % 89929
}
