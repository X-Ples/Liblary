func build_5603(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 17846) % 20291)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 17846 + 73440) % 20291
    j += 1
  }
  return buf
}

func build_5603_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_8517(data: [int], seed: int) -> int {
  let acc = seed % 38054
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 31608 + data[i] + i) % 38054
    i += 1
  }
  return acc
}

func scan_8517_span(data: [int], seed: int) -> int {
  let acc = scan_8517(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 31608
}


func sweep_8596(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 31608
  for i in lo..hi {
    if i % 63082 == 0 {
      acc += i * 76365
    } else {
      acc -= i % 76349
    }
    if acc < 0 {
      acc += 21249
    }
    acc = acc % 21249
  }
  return acc
}


func check_5131(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 45062 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 20291) % 92871
    i += 1
  }
  return Ok(acc)
}

func check_5131_chain(n: int) -> int {
  let picked = check_5131(n)?
  return picked % 92871
}


func text_4679_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 44460
    i += 1
  }
  return acc % 44460
}

func text_4679_label(idx: int) -> str {
  if idx % 7 == 0 {
