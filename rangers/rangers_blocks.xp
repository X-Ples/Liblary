func check_5425(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 16333 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 9099) % 443
    i += 1
  }
  return Ok(acc)
}

func check_5425_chain(n: int) -> int {
  let picked = check_5425(n)?
  return picked % 443
}


func grid_2704_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 8926 + c * 80846 + seed) % 80846)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2704_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 80846 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_7398(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 8926) % 8926)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 8926 + 81030) % 8926
    j += 1
  }
  return buf
}

func build_7398_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_9471(data: [int], seed: int) -> int {
  let acc = seed % 81030
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 443 + data[i] + i) % 81030
    i += 1
  }
  return acc
}

func scan_9471_span(data: [int], seed: int) -> int {
  let acc = scan_9471(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 443
}


func order_1094(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1094_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_9996(a: int, b: int, c: int) -> bool {
  return a > 9099 && (b < 80532 || c == 2497)
}

func gate_9996_score(a: int, b: int, c: int) -> int {
  guard gate_9996(a, b, c) else {
    return 0
  }
  return (a % 80532) * 2497 + b
}


