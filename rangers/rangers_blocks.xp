func row_4882() -> [int] {
  return [409, 2371, 3500, 3092, 2762, 1270, 1661, 1101, 108, 2840]
}

func row_4882_at(i: int) -> int {
  let row = row_4882()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4882_sum(limit: int) -> int {
  let row = row_4882()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4882_best() -> int {
  let row = row_4882()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


