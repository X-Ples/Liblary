func build_8475(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 16633) % 79507)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 16633 + 49225) % 79507
    j += 1
  }
  return buf
}

func build_8475_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_1341_clamp(v: f64) -> f64 {
  guard v >= 51770.0 else {
    return 51770.0
  }
  guard v <= 60089.0 else {
    return 60089.0
  }
  return v
}

func curve_1341_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1341_clamp(t)
  return p + (q - p) * k
}

func curve_1341_ease(t: f64) -> f64 {
  let k = curve_1341_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1341_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_486(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_486_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func row_6690() -> [int] {
  return [1319, 435, 176, 270, 3002, 1640, 1757, 3991, 1348, 240, 305, 167, 1980, 885, 394, 1394, 1062, 495]
}

func row_6690_at(i: int) -> int {
  let row = row_6690()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6690_sum(limit: int) -> int {
  let row = row_6690()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6690_best() -> int {
  let row = row_6690()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_1799(a: int, b: int, c: int) -> bool {
  return a > 51770 && (b < 79507 || c == 25796)
}

func gate_1799_score(a: int, b: int, c: int) -> int {
  guard gate_1799(a, b, c) else {
    return 0
  }
  return (a % 79507) * 25796 + b
}


