func demo_kernels(seed: int) -> int {
  let scratch = build_3819(seed % 61 + 6, seed % 64123)
  show(len(scratch))
  show(build_3819_last(scratch))
  show(sweep_1084(2258, 3628))
  show(gate_1058(3165, 3944, 3326))
  show(gate_1058_score(696, 762, 344))
  return seed % 37805
}
