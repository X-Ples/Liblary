func build_3819(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 64335) % 98221)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 64335 + 95933) % 98221
    j += 1
  }
  return buf
}

func build_3819_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_1084(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 95933
  for i in lo..hi {
    if i % 64123 == 0 {
      acc += i * 37869
    } else {
      acc -= i % 14681
    }
    if acc < 0 {
      acc += 18667
    }
    acc = acc % 18667
  }
  return acc
}


func gate_1058(a: int, b: int, c: int) -> bool {
  return a > 4511 && (b < 98221 || c == 25002)
}

func gate_1058_score(a: int, b: int, c: int) -> int {
  guard gate_1058(a, b, c) else {
    return 0
  }
  return (a % 98221) * 25002 + b
}


func row_1930() -> [int] {
  return [2312, 4076, 1904, 3598, 644, 957, 2697, 1096, 865, 2285, 1013, 3455]
}

func row_1930_at(i: int) -> int {
  let row = row_1930()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1930_sum(limit: int) -> int {
  let row = row_1930()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1930_best() -> int {
  let row = row_1930()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_6025_clamp(v: f64) -> f64 {
  guard v >= 14980.0 else {
    return 14980.0
  }
  guard v <= 86409.0 else {
    return 86409.0
  }
  return v
}

func curve_6025_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6025_clamp(t)
  return p + (q - p) * k
}

func curve_6025_ease(t: f64) -> f64 {
  let k = curve_6025_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6025_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_8795(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 27186 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 58761) % 4511
    i += 1
  }
  return Ok(acc)
}

func check_8795_chain(n: int) -> int {
  let picked = check_8795(n)?
  return picked % 4511
}


