func build_9767(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 94540) % 61492)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 94540 + 45227) % 61492
    j += 1
  }
  return buf
}

func build_9767_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_9958(data: [int], seed: int) -> int {
  let acc = seed % 94540
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 61492 + data[i] + i) % 94540
    i += 1
  }
  return acc
}

func scan_9958_span(data: [int], seed: int) -> int {
  let acc = scan_9958(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 61492
}


func grid_6784_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 24781 + c * 9058 + seed) % 9058)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6784_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 9058 == want {
      total += acc
    }
    r += 1
  }
  return total
}


