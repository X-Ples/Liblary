func sweep_5169(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 28471
  for i in lo..hi {
    if i % 24097 == 0 {
      acc += i * 75362
    } else {
      acc -= i % 24097
    }
    if acc < 0 {
      acc += 61492
    }
    acc = acc % 61492
  }
  return acc
}


