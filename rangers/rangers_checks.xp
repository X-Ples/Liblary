func curve_836_clamp(v: f64) -> f64 {
  guard v >= 61492.0 else {
    return 61492.0
  }
  guard v <= 70325.0 else {
    return 70325.0
  }
  return v
}

func curve_836_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_836_clamp(t)
  return p + (q - p) * k
}

func curve_836_ease(t: f64) -> f64 {
  let k = curve_836_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_836_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_checks(seed: int) -> int {
  let scratch = build_9767(seed % 61 + 6, seed % 24097)
  show(len(scratch))
  show(build_9767_last(scratch))
  show(scan_9958(scratch, 1671))
  show(scan_9958_span(scratch, 2892))
  return seed % 94540
}
