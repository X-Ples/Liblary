func check_6398(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 70325 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 7453) % 24097
    i += 1
  }
  return Ok(acc)
}

func check_6398_chain(n: int) -> int {
  let picked = check_6398(n)?
  return picked % 24097
}


