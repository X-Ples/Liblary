}

func row_2922_at(i: int) -> int {
  let row = row_2922()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2922_sum(limit: int) -> int {
  let row = row_2922()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
