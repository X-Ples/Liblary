func grid_7655_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 95537 + c * 1070 + seed) % 1070)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7655_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 1070 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_6503(data: [int], seed: int) -> int {
  let acc = seed % 24290
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 98409 + data[i] + i) % 24290
    i += 1
  }
  return acc
}

func scan_6503_span(data: [int], seed: int) -> int {
  let acc = scan_6503(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 98409
}


func sweep_1421(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 935
  for i in lo..hi {
    if i % 15598 == 0 {
      acc += i * 935
    } else {
      acc -= i % 63563
    }
    if acc < 0 {
      acc += 98409
    }
    acc = acc % 98409
  }
  return acc
}


func text_1252_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 22183
    i += 1
  }
  return acc % 22183
}

func text_1252_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "bravo"
}

func text_1252_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 63563
}


func build_4449(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 95773) % 62236)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 95773 + 95537) % 62236
    j += 1
  }
  return buf
}

func build_4449_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_7058_clamp(v: f64) -> f64 {
  guard v >= 49651.0 else {
    return 49651.0
  }
  guard v <= 95537.0 else {
    return 95537.0
  }
  return v
}

func curve_7058_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7058_clamp(t)
  return p + (q - p) * k
}

func curve_7058_ease(t: f64) -> f64 {
  let k = curve_7058_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7058_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


