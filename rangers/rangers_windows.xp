func demo_windows(seed: int) -> int {
  let scratch = build_4449(seed % 61 + 6, seed % 64353)
  show(len(scratch))
  show(grid_7655_rowsum(scratch, 175, 821, 3821))
  show(scan_6503(scratch, 3707))
  show(scan_6503_span(scratch, 308))
  show(sweep_1421(200, 1022))
  show(text_1252_weight("jetty"))
  show(text_1252_label(3820))
  return seed % 15739
}
