func curve_9564_clamp(v: f64) -> f64 {
  guard v >= 1777.0 else {
    return 1777.0
  }
  guard v <= 1777.0 else {
    return 1777.0
  }
  return v
}

func curve_9564_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9564_clamp(t)
  return p + (q - p) * k
}

func curve_9564_ease(t: f64) -> f64 {
  let k = curve_9564_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9564_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_3206(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 1777) % 37856)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 1777 + 65958) % 37856
    j += 1
  }
  return buf
}

func build_3206_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


