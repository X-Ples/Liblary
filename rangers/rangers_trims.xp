func demo_trims(seed: int) -> int {
  let scratch = build_3206(seed % 61 + 6, seed % 76631)
  show(len(scratch))
  show(build_3206_last(scratch))
  show(scan_536(scratch, 52))
  show(scan_536_span(scratch, 1412))
  show(build_3390_last(scratch))
  return seed % 83242
}
