func scan_536(data: [int], seed: int) -> int {
  let acc = seed % 3587
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 28093 + data[i] + i) % 3587
    i += 1
  }
  return acc
}

func scan_536_span(data: [int], seed: int) -> int {
  let acc = scan_536(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 28093
}


