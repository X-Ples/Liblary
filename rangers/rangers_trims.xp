func row_9004_at(i: int) -> int {
  let row = row_9004()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9004_sum(limit: int) -> int {
  let row = row_9004()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9004_best() -> int {
  let row = row_9004()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_5352(a: int, b: int, c: int) -> bool {
  return a > 54189 && (b < 69753 || c == 83242)
}

func gate_5352_score(a: int, b: int, c: int) -> int {
  guard gate_5352(a, b, c) else {
    return 0
  }
  return (a % 69753) * 83242 + b
}


