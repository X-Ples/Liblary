func grid_2276_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 76715 + c * 51787 + seed) % 51787)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2276_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 51787 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_5398(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 44910 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 51787) % 27665
    i += 1
  }
  return Ok(acc)
}

func check_5398_chain(n: int) -> int {
  let picked = check_5398(n)?
  return picked % 27665
}


func text_400_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 74578
    i += 1
  }
  return acc % 74578
}

func text_400_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "cargo"
}

func text_400_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 27614
}


