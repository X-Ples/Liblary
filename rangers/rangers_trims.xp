func sweep_2130(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 65958
  for i in lo..hi {
    if i % 44910 == 0 {
      acc += i * 76631
    } else {
      acc -= i % 58467
    }
    if acc < 0 {
      acc += 92953
    }
    acc = acc % 92953
  }
  return acc
}


