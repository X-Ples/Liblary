func demo_signals(seed: int) -> int {
  let scratch = build_4114(seed % 61 + 6, seed % 13371)
  show(len(scratch))
  show(grid_101_rowsum(scratch, 3374, 2036, 1342))
  show(grid_1426_rowsum(scratch, 2095, 1275, 2646))
  show(build_4114_last(scratch))
  show(text_8907_weight("nova"))
  return seed % 88358
}
