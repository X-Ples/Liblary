func scan_9560(data: [int], seed: int) -> int {
  let acc = seed % 99938
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 88358 + data[i] + i) % 99938
    i += 1
  }
  return acc
}

func scan_9560_span(data: [int], seed: int) -> int {
  let acc = scan_9560(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 88358
}


