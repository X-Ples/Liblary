func check_8758(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 88358 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 49809) % 95532
    i += 1
  }
  return Ok(acc)
}

func check_8758_chain(n: int) -> int {
  let picked = check_8758(n)?
  return picked % 95532
}


