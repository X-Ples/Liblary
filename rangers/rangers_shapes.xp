func row_1862() -> [int] {
  return [3035, 1918, 663, 2328, 1813, 1773, 1293, 2271, 506, 1529, 1927, 834, 1838, 758, 3099, 1662, 2230]
}

func row_1862_at(i: int) -> int {
  let row = row_1862()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1862_sum(limit: int) -> int {
  let row = row_1862()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1862_best() -> int {
  let row = row_1862()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


