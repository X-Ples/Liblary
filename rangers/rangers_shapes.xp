func demo_shapes(seed: int) -> int {
  let scratch = build_8281(seed % 61 + 6, seed % 24831)
  show(len(scratch))
  show(scan_617(scratch, 3226))
  show(scan_617_span(scratch, 2968))
  show(check_8395_chain(1450))
  show(build_8281_last(scratch))
  return seed % 4276
}
