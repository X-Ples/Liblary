const K0 = 24831
const K1 = 15611
const K2 = 37721
const K3 = 42565
const K4 = 66330
const K5 = 71256
const K6 = 67253

func scan_617(data: [int], seed: int) -> int {
  let acc = seed % 24831
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 67617 + data[i] + i) % 24831
    i += 1
  }
  return acc
}

func scan_617_span(data: [int], seed: int) -> int {
  let acc = scan_617(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 67617
}


func check_8395(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 68861 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 4276) % 24831
    i += 1
  }
  return Ok(acc)
}

func check_8395_chain(n: int) -> int {
  let picked = check_8395(n)?
  return picked % 24831
}


func build_8281(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 35656) % 24137)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 35656 + 42565) % 24137
    j += 1
  }
  return buf
}

func build_8281_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_6746_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 35656
    i += 1
  }
  return acc % 35656
}

func text_6746_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "cargo"
}

func text_6746_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 91519
}


func grid_8595_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 37721 + c * 89727 + seed) % 89727)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8595_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 89727 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_8879(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 14749
  for i in lo..hi {
    if i % 4276 == 0 {
      acc += i * 66330
    } else {
      acc -= i % 91519
    }
    if acc < 0 {
      acc += 48454
    }
    acc = acc % 48454
  }
  return acc
}


func gate_183(a: int, b: int, c: int) -> bool {
  return a > 14749 && (b < 91519 || c == 24831)
}

func gate_183_score(a: int, b: int, c: int) -> int {
  guard gate_183(a, b, c) else {
    return 0
  }
  return (a % 91519) * 24831 + b
}


func curve_7325_clamp(v: f64) -> f64 {
  guard v >= 73864.0 else {
    return 73864.0
  }
  guard v <= 90701.0 else {
    return 90701.0
  }
  return v
}

func curve_7325_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7325_clamp(t)
  return p + (q - p) * k
}

func curve_7325_ease(t: f64) -> f64 {
  let k = curve_7325_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7325_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_630(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_630_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


