func check_8084(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 99479 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 14996) % 33236
    i += 1
  }
  return Ok(acc)
}

func check_8084_chain(n: int) -> int {
  let picked = check_8084(n)?
  return picked % 33236
}


