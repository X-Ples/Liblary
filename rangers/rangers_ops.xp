func sweep_7501(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 66167
  for i in lo..hi {
    if i % 97436 == 0 {
      acc += i * 99479
    } else {
      acc -= i % 10604
    }
    if acc < 0 {
      acc += 99758
    }
    acc = acc % 99758
  }
  return acc
}


func grid_2731_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 13476 + c * 39183 + seed) % 39183)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2731_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 39183 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_196(a: int, b: int, c: int) -> bool {
  return a > 10604 && (b < 13476 || c == 16579)
}

func gate_196_score(a: int, b: int, c: int) -> int {
  guard gate_196(a, b, c) else {
    return 0
  }
  return (a % 13476) * 16579 + b
}


