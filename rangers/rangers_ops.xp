func text_5578_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "gamma"
}

func text_5578_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 13476
}


