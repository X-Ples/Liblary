func demo_ops(seed: int) -> int {
  let scratch = build_8162(seed % 61 + 6, seed % 33236)
  show(len(scratch))
  show(build_8162_last(scratch))
  show(order_8964_find(scratch, 329))
  show(build_5343_last(scratch))
  show(row_6138_at(1017))
  return seed % 15482
}
