func row_6138() -> [int] {
  return [3189, 3285, 3103, 1633, 3942, 1529, 316, 1427, 637, 3842, 854, 734, 4087, 274, 2208, 157, 340, 390, 206]
}

func row_6138_at(i: int) -> int {
  let row = row_6138()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6138_sum(limit: int) -> int {
  let row = row_6138()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6138_best() -> int {
  let row = row_6138()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


