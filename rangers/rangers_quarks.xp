func gate_5700(a: int, b: int, c: int) -> bool {
  return a > 73795 && (b < 61646 || c == 24358)
}

func gate_5700_score(a: int, b: int, c: int) -> int {
  guard gate_5700(a, b, c) else {
    return 0
  }
  return (a % 61646) * 24358 + b
}


