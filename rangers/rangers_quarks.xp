func build_7279(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 75298) % 13693)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 75298 + 7703) % 13693
    j += 1
  }
  return buf
}

func build_7279_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_703_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 77339
    i += 1
  }
  return acc % 77339
}

func text_703_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "gamma"
}

func text_703_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 73795
}


func grid_4384_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 12402 + c * 34714 + seed) % 34714)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4384_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 34714 == want {
      total += acc
    }
    r += 1
  }
  return total
}


