func demo_quarks(seed: int) -> int {
  let scratch = build_7279(seed % 61 + 6, seed % 34714)
  show(len(scratch))
  show(gate_5700(757, 2914, 2056))
  show(gate_5700_score(2006, 1358, 3087))
  show(gate_5574(1251, 2887, 1399))
  show(gate_5574_score(3723, 673, 2394))
  show(build_7279_last(scratch))
  return seed % 66305
}
