func sweep_1307(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 12402
  for i in lo..hi {
    if i % 24358 == 0 {
      acc += i * 13693
    } else {
      acc -= i % 81021
    }
    if acc < 0 {
      acc += 27754
    }
    acc = acc % 27754
  }
  return acc
}


