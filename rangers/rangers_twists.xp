func build_1837(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 8849) % 6928)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 8849 + 206) % 6928
    j += 1
  }
  return buf
}

func build_1837_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_8419_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 62958
    i += 1
  }
  return acc % 62958
}

func text_8419_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ridge"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "bravo"
}

func text_8419_has(tag: str) -> bool {
  return str_contains(tag, "ridge") || len(tag) > 55879
}


func sweep_2676(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 55879
  for i in lo..hi {
    if i % 83789 == 0 {
      acc += i * 68211
    } else {
      acc -= i % 84841
    }
    if acc < 0 {
      acc += 11216
    }
    acc = acc % 11216
  }
  return acc
}


