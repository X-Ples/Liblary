func check_8956(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 11216 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 40503) % 11028
    i += 1
  }
  return Ok(acc)
}

func check_8956_chain(n: int) -> int {
  let picked = check_8956(n)?
  return picked % 11028
}


