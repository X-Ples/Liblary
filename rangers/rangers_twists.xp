func demo_twists(seed: int) -> int {
  let scratch = build_1837(seed % 61 + 6, seed % 55355)
  show(len(scratch))
  show(build_1837_last(scratch))
  show(text_8419_weight("sigma"))
  show(text_8419_label(3490))
  show(text_8419_has("quartz"))
  return seed % 206
}
