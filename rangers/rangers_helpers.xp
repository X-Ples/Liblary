func row_5998() -> [int] {
  return [610, 3070, 3633, 1072, 970, 1478, 1199, 2804, 2283, 2740, 2664, 1774]
}

func row_5998_at(i: int) -> int {
  let row = row_5998()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5998_sum(limit: int) -> int {
  let row = row_5998()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5998_best() -> int {
  let row = row_5998()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_7887(data: [int], seed: int) -> int {
  let acc = seed % 76517
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 13419 + data[i] + i) % 76517
    i += 1
  }
  return acc
}

func scan_7887_span(data: [int], seed: int) -> int {
  let acc = scan_7887(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 13419
}


func curve_2571_clamp(v: f64) -> f64 {
  guard v >= 32382.0 else {
    return 32382.0
  }
  guard v <= 57349.0 else {
    return 57349.0
  }
  return v
}

func curve_2571_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2571_clamp(t)
  return p + (q - p) * k
}

func curve_2571_ease(t: f64) -> f64 {
  let k = curve_2571_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2571_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


