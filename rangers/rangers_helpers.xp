func build_1201(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 57349) % 78457)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 57349 + 79375) % 78457
    j += 1
  }
  return buf
}

func build_1201_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_7964(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 79000 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 2795) % 54959
    i += 1
  }
  return Ok(acc)
}

func check_7964_chain(n: int) -> int {
  let picked = check_7964(n)?
  return picked % 54959
}


