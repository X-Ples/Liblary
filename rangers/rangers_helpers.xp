func sweep_2154(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 78457
  for i in lo..hi {
    if i % 83267 == 0 {
      acc += i * 13419
    } else {
      acc -= i % 37380
    }
    if acc < 0 {
      acc += 35056
    }
    acc = acc % 35056
  }
  return acc
}


