func row_2171() -> [int] {
  return [3771, 99, 2811, 2181, 3663, 3872, 417, 3009, 2250, 3905, 1598, 629, 3906, 2639, 2629, 2764]
}

func row_2171_at(i: int) -> int {
  let row = row_2171()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2171_sum(limit: int) -> int {
  let row = row_2171()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2171_best() -> int {
  let row = row_2171()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


