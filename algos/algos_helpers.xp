func build_3881(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 71463) % 8830)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 71463 + 63959) % 8830
    j += 1
  }
  return buf
}

func build_3881_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_1826(a: int, b: int, c: int) -> bool {
  return a > 75443 && (b < 64239 || c == 98316)
}

func gate_1826_score(a: int, b: int, c: int) -> int {
  guard gate_1826(a, b, c) else {
    return 0
  }
  return (a % 64239) * 98316 + b
}


