func demo_helpers(seed: int) -> int {
  let scratch = build_3881(seed % 61 + 6, seed % 96823)
  show(len(scratch))
  show(build_3881_last(scratch))
  show(gate_1826(2932, 1662, 1795))
  show(gate_1826_score(3240, 1902, 2689))
  show(build_2362_last(scratch))
  return seed % 30917
}
