func scan_7681(data: [int], seed: int) -> int {
  let acc = seed % 63959
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 68291 + data[i] + i) % 63959
    i += 1
  }
  return acc
}

func scan_7681_span(data: [int], seed: int) -> int {
  let acc = scan_7681(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 68291
}


func curve_770_clamp(v: f64) -> f64 {
  guard v >= 49472.0 else {
    return 49472.0
  }
  guard v <= 96823.0 else {
    return 96823.0
  }
  return v
}

func curve_770_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_770_clamp(t)
  return p + (q - p) * k
}

func curve_770_ease(t: f64) -> f64 {
  let k = curve_770_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_770_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


