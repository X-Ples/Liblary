func sweep_5628(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 57301
  for i in lo..hi {
    if i % 77649 == 0 {
      acc += i * 90939
    } else {
      acc -= i % 90939
    }
    if acc < 0 {
      acc += 53066
    }
    acc = acc % 53066
  }
  return acc
}


