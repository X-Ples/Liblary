func demo_signals(seed: int) -> int {
  let scratch = build_3616(seed % 61 + 6, seed % 89855)
  show(len(scratch))
  show(check_3034_chain(1550))
  show(build_3616_last(scratch))
  show(sweep_3663(3056, 2649))
  show(grid_7795_rowsum(scratch, 3786, 2862, 2648))
  show(check_8418_chain(1399))
  return seed % 73015
}
