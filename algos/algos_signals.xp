}


func sweep_3663(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 38873
  for i in lo..hi {
    if i % 57588 == 0 {
      acc += i * 71785
    } else {
      acc -= i % 57588
    }
    if acc < 0 {
      acc += 13463
    }
    acc = acc % 13463
  }
  return acc
}


func grid_7795_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 38873 + c * 13463 + seed) % 13463)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7795_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 13463 == want {
      total += acc
    }
    r += 1
  }
  return total
}


