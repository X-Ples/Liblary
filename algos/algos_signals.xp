func check_3034(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 21261 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 92791) % 62202
    i += 1
  }
  return Ok(acc)
}

func check_3034_chain(n: int) -> int {
  let picked = check_3034(n)?
  return picked % 62202
}


func build_3616(count: int, start: int) -> [int] {
  guard count > 0 else {
