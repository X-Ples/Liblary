func order_4873(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4873_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_4233(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 24215
  for i in lo..hi {
    if i % 35716 == 0 {
      acc += i * 63625
    } else {
      acc -= i % 20079
    }
    if acc < 0 {
      acc += 63625
    }
    acc = acc % 63625
  }
  return acc
}


func text_1891_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 11597
    i += 1
  }
  return acc % 11597
}

func text_1891_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "prism"
}

func text_1891_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 21968
}


func curve_2780_clamp(v: f64) -> f64 {
  guard v >= 28291.0 else {
    return 28291.0
  }
  guard v <= 94076.0 else {
    return 94076.0
  }
  return v
}

func curve_2780_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2780_clamp(t)
  return p + (q - p) * k
}

func curve_2780_ease(t: f64) -> f64 {
  let k = curve_2780_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2780_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


