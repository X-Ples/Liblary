func gate_8240(a: int, b: int, c: int) -> bool {
  return a > 79019 && (b < 13694 || c == 7238)
}

func gate_8240_score(a: int, b: int, c: int) -> int {
  guard gate_8240(a, b, c) else {
    return 0
  }
  return (a % 13694) * 7238 + b
}


func grid_1626_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 94352 + c * 60063 + seed) % 60063)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1626_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 60063 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func demo_ranges(seed: int) -> int {
  let scratch = build_1988(seed % 61 + 6, seed % 76420)
  show(len(scratch))
  show(build_1988_last(scratch))
  show(build_749_last(scratch))
  show(order_4873_find(scratch, 2775))
  show(sweep_4233(1300, 2721))
  return seed % 95367
}
