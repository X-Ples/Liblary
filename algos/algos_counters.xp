func demo_counters(seed: int) -> int {
  let scratch = build_9111(seed % 61 + 6, seed % 16102)
  show(len(scratch))
  show(build_9111_last(scratch))
  show(order_4709_find(scratch, 1025))
  show(grid_2377_rowsum(scratch, 491, 3815, 478))
  show(order_6499_find(scratch, 709))
  show(row_4477_at(473))
  return seed % 47788
}
