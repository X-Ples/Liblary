func text_424_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "sigma"
}

func text_424_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 44933
}


