func scan_683(data: [int], seed: int) -> int {
  let acc = seed % 45191
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 67069 + data[i] + i) % 45191
    i += 1
  }
  return acc
}

func scan_683_span(data: [int], seed: int) -> int {
  let acc = scan_683(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 67069
}


func check_6697(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
