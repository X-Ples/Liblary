  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 75006) % 24623
    i += 1
  }
  return Ok(acc)
}

func check_6697_chain(n: int) -> int {
  let picked = check_6697(n)?
  return picked % 24623
}


