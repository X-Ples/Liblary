func check_4467(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 42057 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 90099) % 46056
    i += 1
  }
  return Ok(acc)
}

func check_4467_chain(n: int) -> int {
  let picked = check_4467(n)?
  return picked % 46056
}


