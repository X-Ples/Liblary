func sweep_9101(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 23298
  for i in lo..hi {
    if i % 87335 == 0 {
      acc += i * 78641
    } else {
      acc -= i % 78641
    }
    if acc < 0 {
      acc += 86546
    }
    acc = acc % 86546
  }
  return acc
}


func build_2245(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 11897) % 70000)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 11897 + 65220) % 70000
    j += 1
  }
  return buf
}

func build_2245_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_4260_clamp(v: f64) -> f64 {
  guard v >= 73051.0 else {
    return 73051.0
  }
  guard v <= 83023.0 else {
    return 83023.0
  }
  return v
}

func curve_4260_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4260_clamp(t)
  return p + (q - p) * k
}

func curve_4260_ease(t: f64) -> f64 {
  let k = curve_4260_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4260_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


