func build_5244(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 49705) % 39963)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 49705 + 97617) % 39963
    j += 1
  }
  return buf
}

func build_5244_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_9407_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 91751
    i += 1
  }
  return acc % 91751
}

func text_9407_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "prism"
}

func text_9407_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 73936
}


func curve_6167_clamp(v: f64) -> f64 {
  guard v >= 73048.0 else {
    return 73048.0
  }
  guard v <= 94058.0 else {
    return 94058.0
  }
  return v
}

func curve_6167_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6167_clamp(t)
  return p + (q - p) * k
}

func curve_6167_ease(t: f64) -> f64 {
  let k = curve_6167_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6167_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


