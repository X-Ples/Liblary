func demo_tables(seed: int) -> int {
  let scratch = build_5244(seed % 61 + 6, seed % 32716)
  show(len(scratch))
  show(build_5244_last(scratch))
  show(text_9407_weight("talus"))
  show(text_9407_label(2578))
  show(text_9407_has("lumen"))
  return seed % 49705
}
