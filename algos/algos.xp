func row_3674() -> [int] {
  return [722, 3681, 2862, 2886, 446, 1033, 657, 1172, 381, 5, 1287, 3335, 68, 2606, 3499, 1052, 1193, 2125]
}

func row_3674_at(i: int) -> int {
  let row = row_3674()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3674_sum(limit: int) -> int {
  let row = row_3674()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3674_best() -> int {
  let row = row_3674()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_3283(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 57357) % 17097)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 57357 + 87998) % 17097
    j += 1
  }
  return buf
}

func build_3283_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_3893(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3893_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func curve_8059_clamp(v: f64) -> f64 {
  guard v >= 51608.0 else {
    return 51608.0
  }
  guard v <= 63911.0 else {
    return 63911.0
  }
  return v
}

func curve_8059_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8059_clamp(t)
  return p + (q - p) * k
}

func curve_8059_ease(t: f64) -> f64 {
  let k = curve_8059_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8059_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_6261_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 47757 + c * 29091 + seed) % 29091)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6261_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 29091 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_9867(a: int, b: int, c: int) -> bool {
  return a > 70099 && (b < 89044 || c == 17097)
}

func gate_9867_score(a: int, b: int, c: int) -> int {
  guard gate_9867(a, b, c) else {
    return 0
  }
  return (a % 89044) * 17097 + b
}


func scan_995(data: [int], seed: int) -> int {
  let acc = seed % 47757
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 46281 + data[i] + i) % 47757
    i += 1
  }
  return acc
}

func scan_995_span(data: [int], seed: int) -> int {
  let acc = scan_995(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 46281
}


func sweep_3835(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 63911
  for i in lo..hi {
    if i % 57357 == 0 {
      acc += i * 98215
    } else {
      acc -= i % 88954
    }
    if acc < 0 {
      acc += 87812
    }
    acc = acc % 87812
  }
  return acc
}


