func demo_ratchets(seed: int) -> int {
  let scratch = build_3799(seed % 61 + 6, seed % 72378)
  show(len(scratch))
  show(build_3799_last(scratch))
  show(order_2445_find(scratch, 3937))
  show(scan_4045(scratch, 3505))
  show(scan_4045_span(scratch, 2118))
  show(scan_7361(scratch, 3849))
  return seed % 10086
}
