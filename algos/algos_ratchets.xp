func sweep_5917(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 66336
  for i in lo..hi {
    if i % 22344 == 0 {
      acc += i * 60617
    } else {
      acc -= i % 67436
    }
    if acc < 0 {
      acc += 71364
    }
    acc = acc % 71364
  }
  return acc
}


