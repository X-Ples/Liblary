func row_3102() -> [int] {
  return [3917, 485, 872, 3394, 3587, 515, 3068, 1510, 3034, 3086, 1752, 1204, 2266, 477, 3484, 2197]
}

func row_3102_at(i: int) -> int {
  let row = row_3102()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3102_sum(limit: int) -> int {
  let row = row_3102()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3102_best() -> int {
  let row = row_3102()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


