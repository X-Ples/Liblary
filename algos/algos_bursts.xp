func build_8032(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 64701) % 64701)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 64701 + 72301) % 64701
    j += 1
  }
  return buf
}

func build_8032_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_7300(a: int, b: int, c: int) -> bool {
  return a > 62070 && (b < 60282 || c == 84219)
}

func gate_7300_score(a: int, b: int, c: int) -> int {
  guard gate_7300(a, b, c) else {
    return 0
  }
  return (a % 60282) * 84219 + b
}


func row_6068() -> [int] {
  return [3594, 1045, 1115, 946, 1524, 2909, 3020, 17, 1022, 3736, 3345, 326, 2058, 2186, 714, 1023]
}

func row_6068_at(i: int) -> int {
  let row = row_6068()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6068_sum(limit: int) -> int {
  let row = row_6068()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6068_best() -> int {
  let row = row_6068()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_9137(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9137_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func grid_1631_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 83109 + c * 92855 + seed) % 92855)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1631_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 92855 == want {
      total += acc
    }
    r += 1
  }
  return total
}


