func sweep_871(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 62070
  for i in lo..hi {
    if i % 84219 == 0 {
      acc += i * 16516
    } else {
      acc -= i % 2025
    }
    if acc < 0 {
      acc += 19986
    }
    acc = acc % 19986
  }
  return acc
}


func check_8258(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 84219 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 70476) % 72301
    i += 1
  }
  return Ok(acc)
}

func check_8258_chain(n: int) -> int {
  let picked = check_8258(n)?
  return picked % 72301
}


