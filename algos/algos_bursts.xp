func demo_bursts(seed: int) -> int {
  let scratch = build_8032(seed % 61 + 6, seed % 64701)
  show(len(scratch))
  show(build_8032_last(scratch))
  show(gate_7300(1608, 2951, 3918))
  show(gate_7300_score(1096, 2699, 3766))
  show(row_6068_at(3403))
  show(row_6068_sum(2887))
