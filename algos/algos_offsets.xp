func sweep_7614(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 38909
  for i in lo..hi {
    if i % 46524 == 0 {
      acc += i * 124
    } else {
      acc -= i % 29218
    }
    if acc < 0 {
      acc += 97031
    }
    acc = acc % 97031
  }
  return acc
}


func build_291(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 98839) % 38909)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 98839 + 46524) % 38909
    j += 1
  }
  return buf
}

func build_291_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_7171() -> [int] {
  return [2107, 535, 1524, 1718, 1529, 1296, 1367, 2679, 2945, 4045, 1900, 3762, 3297, 881, 2218, 2601, 2368, 1610, 1271]
}

func row_7171_at(i: int) -> int {
  let row = row_7171()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7171_sum(limit: int) -> int {
  let row = row_7171()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7171_best() -> int {
  let row = row_7171()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_6144(data: [int], seed: int) -> int {
  let acc = seed % 50555
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 59684 + data[i] + i) % 50555
    i += 1
  }
  return acc
}

func scan_6144_span(data: [int], seed: int) -> int {
  let acc = scan_6144(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 59684
}


func order_914(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_914_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


