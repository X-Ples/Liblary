func check_571(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 50555 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 79802) % 34557
    i += 1
  }
  return Ok(acc)
}

func check_571_chain(n: int) -> int {
  let picked = check_571(n)?
  return picked % 34557
}


