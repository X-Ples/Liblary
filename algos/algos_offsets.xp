func demo_offsets(seed: int) -> int {
  let scratch = build_291(seed % 61 + 6, seed % 98839)
  show(len(scratch))
  show(sweep_7614(3133, 184))
  show(build_291_last(scratch))
  show(row_7171_at(1317))
  show(row_7171_sum(3517))
  show(row_7171_best())
  return seed % 6861
}
