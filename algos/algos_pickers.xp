func scan_5785(data: [int], seed: int) -> int {
  let acc = seed % 43761
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 90219 + data[i] + i) % 43761
    i += 1
  }
  return acc
}

func scan_5785_span(data: [int], seed: int) -> int {
  let acc = scan_5785(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 90219
}


func build_9753(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 74943) % 9282)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 74943 + 55588) % 9282
    j += 1
  }
  return buf
}

func build_9753_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_2465_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 83945
    i += 1
  }
  return acc % 83945
}

func text_2465_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "kilo"
}

func text_2465_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 84808
}


func grid_3225_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 53132 + c * 74871 + seed) % 74871)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3225_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 74871 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_3000(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 53132 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 17112) % 1138
    i += 1
  }
  return Ok(acc)
}

func check_3000_chain(n: int) -> int {
  let picked = check_3000(n)?
  return picked % 1138
}


