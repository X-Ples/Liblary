func demo_pickers(seed: int) -> int {
  let scratch = build_9753(seed % 61 + 6, seed % 48595)
  show(len(scratch))
  show(scan_5785(scratch, 2026))
  show(scan_5785_span(scratch, 3072))
  show(build_9753_last(scratch))
  show(text_2465_weight("nova"))
  return seed % 55588
}
