func sweep_6858(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 53132
  for i in lo..hi {
    if i % 74943 == 0 {
      acc += i * 95735
    } else {
      acc -= i % 43761
    }
    if acc < 0 {
      acc += 70908
    }
    acc = acc % 70908
  }
  return acc
}


