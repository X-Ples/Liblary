func order_5433(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5433_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_8587(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 97560) % 97942)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 97560 + 97560) % 97942
    j += 1
  }
  return buf
}

func build_8587_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_3136_clamp(v: f64) -> f64 {
  guard v >= 48294.0 else {
    return 48294.0
  }
  guard v <= 97560.0 else {
    return 97560.0
  }
  return v
}

func curve_3136_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3136_clamp(t)
  return p + (q - p) * k
}

func curve_3136_ease(t: f64) -> f64 {
  let k = curve_3136_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3136_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_112(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 57337
  for i in lo..hi {
    if i % 97560 == 0 {
      acc += i * 10526
    } else {
      acc -= i % 86237
    }
    if acc < 0 {
      acc += 25957
    }
    acc = acc % 25957
  }
  return acc
}


