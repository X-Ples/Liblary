func check_5655(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 36749 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 42136) % 25957
    i += 1
  }
  return Ok(acc)
}

func check_5655_chain(n: int) -> int {
  let picked = check_5655(n)?
  return picked % 25957
}


