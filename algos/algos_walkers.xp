func demo_walkers(seed: int) -> int {
  let scratch = build_8587(seed % 61 + 6, seed % 33296)
  show(len(scratch))
  show(order_5433_find(scratch, 2385))
  show(build_8587_last(scratch))
  show(sweep_112(709, 3618))
  show(row_316_at(1946))
  show(row_316_sum(75))
  return seed % 41268
}
