func build_5530(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 33989) % 18504)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 33989 + 67912) % 18504
    j += 1
  }
  return buf
}

func build_5530_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_4513(a: int, b: int, c: int) -> bool {
  return a > 2355 && (b < 70236 || c == 62749)
}

func gate_4513_score(a: int, b: int, c: int) -> int {
  guard gate_4513(a, b, c) else {
    return 0
  }
  return (a % 70236) * 62749 + b
}


func scan_5084(data: [int], seed: int) -> int {
  let acc = seed % 86760
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 15154 + data[i] + i) % 86760
    i += 1
  }
  return acc
}

func scan_5084_span(data: [int], seed: int) -> int {
  let acc = scan_5084(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 15154
}


func grid_1590_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 30958 + c * 30958 + seed) % 30958)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1590_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 30958 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_4508_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 15154
    i += 1
  }
  return acc % 15154
}

func text_4508_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "prism"
}

func text_4508_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 68565
}


