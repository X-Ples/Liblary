func demo_ops(seed: int) -> int {
  let scratch = build_5095(seed % 61 + 6, seed % 64094)
  show(len(scratch))
  show(build_5095_last(scratch))
  show(build_3176_last(scratch))
  show(order_7025_find(scratch, 3386))
  show(grid_2585_rowsum(scratch, 1264, 1409, 3704))
  show(grid_5769_rowsum(scratch, 2141, 1405, 2303))
  show(sweep_6153(1541, 2156))
  return seed % 17383
}
