func sweep_6153(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 4279
  for i in lo..hi {
    if i % 43996 == 0 {
      acc += i * 80751
    } else {
      acc -= i % 29460
    }
    if acc < 0 {
      acc += 80751
    }
    acc = acc % 80751
  }
  return acc
}


func check_4688(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 50483 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 43996) % 90660
    i += 1
  }
  return Ok(acc)
}

func check_4688_chain(n: int) -> int {
  let picked = check_4688(n)?
  return picked % 90660
}


func scan_1469(data: [int], seed: int) -> int {
  let acc = seed % 89162
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 17325 + data[i] + i) % 89162
    i += 1
  }
  return acc
}

func scan_1469_span(data: [int], seed: int) -> int {
  let acc = scan_1469(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 17325
}


func gate_5144(a: int, b: int, c: int) -> bool {
  return a > 80751 && (b < 23860 || c == 89162)
}

func gate_5144_score(a: int, b: int, c: int) -> int {
  guard gate_5144(a, b, c) else {
    return 0
  }
  return (a % 23860) * 89162 + b
}


