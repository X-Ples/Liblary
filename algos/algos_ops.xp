func row_6702() -> [int] {
  return [107, 2880, 2592, 138, 600, 617, 280, 2572, 3971, 3618, 3987, 2020, 1592, 2226, 3432, 3821, 2472, 1907, 3061, 808]
}

func row_6702_at(i: int) -> int {
  let row = row_6702()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6702_sum(limit: int) -> int {
  let row = row_6702()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6702_best() -> int {
  let row = row_6702()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


