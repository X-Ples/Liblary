}


func check_4279(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 41613 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 18496) % 75463
    i += 1
  }
  return Ok(acc)
}

func check_4279_chain(n: int) -> int {
  let picked = check_4279(n)?
  return picked % 75463
}


func text_9237_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 21915
    i += 1
  }
  return acc % 21915
}

func text_9237_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "alpha"
}

func text_9237_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 67396
}


