func sweep_5937(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 95466
  for i in lo..hi {
    if i % 97272 == 0 {
      acc += i * 97272
    } else {
      acc -= i % 12247
    }
    if acc < 0 {
      acc += 13066
    }
    acc = acc % 13066
  }
  return acc
}


