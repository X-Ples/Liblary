func text_5027_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 69271
    i += 1
  }
  return acc % 69271
}

func text_5027_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "ember"
}

func text_5027_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 69271
}


func build_280(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 72430) % 99650)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 72430 + 67532) % 99650
    j += 1
  }
  return buf
}

func build_280_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_4605_clamp(v: f64) -> f64 {
  guard v >= 51188.0 else {
    return 51188.0
  }
  guard v <= 72430.0 else {
    return 72430.0
  }
  return v
}

func curve_4605_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4605_clamp(t)
  return p + (q - p) * k
}

func curve_4605_ease(t: f64) -> f64 {
  let k = curve_4605_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4605_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_4334(a: int, b: int, c: int) -> bool {
  return a > 84216 && (b < 16050 || c == 72430)
}

func gate_4334_score(a: int, b: int, c: int) -> int {
  guard gate_4334(a, b, c) else {
    return 0
  }
  return (a % 16050) * 72430 + b
}


func check_9991(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 99650 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 25472) % 93066
    i += 1
  }
  return Ok(acc)
}

func check_9991_chain(n: int) -> int {
  let picked = check_9991(n)?
  return picked % 93066
}


