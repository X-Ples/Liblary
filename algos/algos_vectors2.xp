func sweep_2533(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 75532
  for i in lo..hi {
    if i % 69271 == 0 {
      acc += i * 69326
    } else {
      acc -= i % 69271
    }
    if acc < 0 {
      acc += 46780
    }
    acc = acc % 46780
  }
  return acc
}


func demo_vectors2(seed: int) -> int {
  let scratch = build_280(seed % 61 + 6, seed % 83274)
  show(len(scratch))
  show(text_5027_weight("gamma"))
  show(text_5027_label(3511))
  show(text_5027_has("jetty"))
  return seed % 77100
}
