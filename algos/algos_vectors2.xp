func scan_8314(data: [int], seed: int) -> int {
  let acc = seed % 72389
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 51188 + data[i] + i) % 72389
    i += 1
  }
  return acc
}

func scan_8314_span(data: [int], seed: int) -> int {
  let acc = scan_8314(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 51188
}


