func sweep_4948(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 59694
  for i in lo..hi {
    if i % 59694 == 0 {
      acc += i * 98396
    } else {
      acc -= i % 44998
    }
    if acc < 0 {
      acc += 33683
    }
    acc = acc % 33683
  }
  return acc
}


