func demo_shapes(seed: int) -> int {
  let scratch = build_3554(seed % 61 + 6, seed % 73506)
  show(len(scratch))
  show(build_3554_last(scratch))
  show(scan_5966(scratch, 1896))
  show(scan_5966_span(scratch, 1923))
  show(gate_2956(1223, 578, 2452))
  show(gate_2956_score(840, 1831, 2517))
  return seed % 41533
}
