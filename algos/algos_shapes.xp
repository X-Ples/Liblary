const K5 = 23190

func build_3554(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 23190) % 95124)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 23190 + 20590) % 95124
    j += 1
  }
  return buf
}

func build_3554_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_5966(data: [int], seed: int) -> int {
  let acc = seed % 76181
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 56737 + data[i] + i) % 76181
    i += 1
  }
  return acc
}

func scan_5966_span(data: [int], seed: int) -> int {
  let acc = scan_5966(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 56737
}


func gate_2956(a: int, b: int, c: int) -> bool {
  return a > 71059 && (b < 71059 || c == 76181)
}

func gate_2956_score(a: int, b: int, c: int) -> int {
  guard gate_2956(a, b, c) else {
    return 0
  }
  return (a % 71059) * 76181 + b
}


func curve_5884_clamp(v: f64) -> f64 {
  guard v >= 51943.0 else {
    return 51943.0
  }
  guard v <= 68621.0 else {
    return 68621.0
  }
  return v
}

func curve_5884_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5884_clamp(t)
  return p + (q - p) * k
}

func curve_5884_ease(t: f64) -> f64 {
  let k = curve_5884_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5884_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_4120(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 1526
  for i in lo..hi {
    if i % 64955 == 0 {
      acc += i * 64955
    } else {
      acc -= i % 26762
    }
    if acc < 0 {
      acc += 31439
    }
    acc = acc % 31439
  }
  return acc
}


func check_9888(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 38458 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 26762) % 64955
    i += 1
  }
  return Ok(acc)
}

func check_9888_chain(n: int) -> int {
  let picked = check_9888(n)?
  return picked % 64955
}


