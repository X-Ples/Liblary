func check_8823(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 56241 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 62279) % 64295
    i += 1
  }
  return Ok(acc)
}

func check_8823_chain(n: int) -> int {
  let picked = check_8823(n)?
  return picked % 64295
}


func sweep_2154(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 8218
  for i in lo..hi {
    if i % 76208 == 0 {
      acc += i * 94962
    } else {
      acc -= i % 71417
    }
    if acc < 0 {
      acc += 71417
    }
    acc = acc % 71417
  }
  return acc
}


func grid_8933_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 71417 + c * 8218 + seed) % 8218)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8933_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 8218 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_4537(data: [int], seed: int) -> int {
  let acc = seed % 64295
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 39269 + data[i] + i) % 64295
    i += 1
  }
  return acc
}

func scan_4537_span(data: [int], seed: int) -> int {
  let acc = scan_4537(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 39269
}


