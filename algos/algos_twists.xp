func demo_twists(seed: int) -> int {
  let scratch = build_4807(seed % 61 + 6, seed % 64295)
  show(len(scratch))
  show(build_4807_last(scratch))
  show(check_8823_chain(1995))
  show(sweep_2154(1297, 392))
  show(grid_8933_rowsum(scratch, 379, 3828, 1093))
  show(scan_4537(scratch, 2629))
  return seed % 42873
}
