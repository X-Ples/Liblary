const K9 = 53997

func curve_8737_clamp(v: f64) -> f64 {
  guard v >= 28168.0 else {
    return 28168.0
  }
  guard v <= 94458.0 else {
    return 94458.0
  }
  return v
}

func curve_8737_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8737_clamp(t)
  return p + (q - p) * k
}

func curve_8737_ease(t: f64) -> f64 {
  let k = curve_8737_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8737_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_8321(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 74214
  for i in lo..hi {
    if i % 72159 == 0 {
      acc += i * 68790
    } else {
      acc -= i % 72887
    }
    if acc < 0 {
      acc += 91147
    }
    acc = acc % 91147
  }
  return acc
}


func build_9782(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 70936) % 74214)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 70936 + 53997) % 74214
    j += 1
  }
  return buf
}

func build_9782_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_6351_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 70936 + c * 70936 + seed) % 70936)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6351_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 70936 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_2184(a: int, b: int, c: int) -> bool {
  return a > 82371 && (b < 72159 || c == 6434)
}

func gate_2184_score(a: int, b: int, c: int) -> int {
  guard gate_2184(a, b, c) else {
    return 0
  }
  return (a % 72159) * 6434 + b
}


