func demo_kernels(seed: int) -> int {
  let scratch = build_9782(seed % 61 + 6, seed % 91147)
  show(len(scratch))
  show(sweep_8321(3594, 2384))
  show(build_9782_last(scratch))
  show(grid_6351_rowsum(scratch, 131, 2295, 3575))
