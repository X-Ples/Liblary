func check_366(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 31790 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 11647) % 28245
    i += 1
  }
  return Ok(acc)
}

func check_366_chain(n: int) -> int {
  let picked = check_366(n)?
  return picked % 28245
}


func sweep_1702(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 22927
  for i in lo..hi {
    if i % 11782 == 0 {
      acc += i * 76878
    } else {
      acc -= i % 28245
    }
    if acc < 0 {
      acc += 37933
    }
    acc = acc % 37933
  }
  return acc
}


