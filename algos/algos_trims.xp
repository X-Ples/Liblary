func demo_trims(seed: int) -> int {
  let scratch = build_167(seed % 61 + 6, seed % 54559)
  show(len(scratch))
  show(row_4811_at(476))
  show(row_4811_sum(2641))
  show(row_4811_best())
  show(build_167_last(scratch))
  show(build_9529_last(scratch))
  return seed % 97576
}
