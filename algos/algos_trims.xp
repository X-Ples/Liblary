func curve_8794_clamp(v: f64) -> f64 {
  guard v >= 22927.0 else {
    return 22927.0
  }
  guard v <= 30288.0 else {
    return 30288.0
  }
  return v
}

func curve_8794_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8794_clamp(t)
  return p + (q - p) * k
}

func curve_8794_ease(t: f64) -> f64 {
  let k = curve_8794_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8794_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_167(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 44927) % 5931)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 44927 + 63901) % 5931
    j += 1
  }
  return buf
}

func build_167_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


