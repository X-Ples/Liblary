func sweep_9488(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 80191
  for i in lo..hi {
    if i % 38690 == 0 {
      acc += i * 4291
    } else {
      acc -= i % 68297
    }
    if acc < 0 {
      acc += 80191
    }
    acc = acc % 80191
  }
  return acc
}


func text_9993_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 27818
    i += 1
  }
  return acc % 27818
}

func text_9993_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "mesa"
}

func text_9993_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 4291
}


