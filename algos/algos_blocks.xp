func demo_blocks(seed: int) -> int {
  let scratch = build_4096(seed % 61 + 6, seed % 90558)
  show(len(scratch))
  show(row_365_at(1851))
  show(row_365_sum(528))
  show(row_365_best())
  show(build_4096_last(scratch))
  show(grid_2996_rowsum(scratch, 1350, 870, 3021))
  show(check_4543_chain(3846))
  return seed % 38690
}
