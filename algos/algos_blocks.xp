func row_365() -> [int] {
  return [3887, 372, 4051, 1333, 3974, 2886, 4023, 1215, 1463, 3381, 1825, 859, 3466, 3390, 3339]
}

func row_365_at(i: int) -> int {
  let row = row_365()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_365_sum(limit: int) -> int {
  let row = row_365()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_365_best() -> int {
  let row = row_365()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_4096(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 96847) % 69843)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 96847 + 66208) % 69843
    j += 1
  }
  return buf
}

func build_4096_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_2996_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 58074 + c * 21136 + seed) % 21136)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2996_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 21136 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_4543(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 36395 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 48490) % 80191
    i += 1
  }
  return Ok(acc)
}

func check_4543_chain(n: int) -> int {
  let picked = check_4543(n)?
  return picked % 80191
}


func scan_8637(data: [int], seed: int) -> int {
  let acc = seed % 30972
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 66208 + data[i] + i) % 30972
    i += 1
  }
  return acc
}

func scan_8637_span(data: [int], seed: int) -> int {
  let acc = scan_8637(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 66208
}


func curve_5721_clamp(v: f64) -> f64 {
  guard v >= 48490.0 else {
    return 48490.0
  }
  guard v <= 69843.0 else {
    return 69843.0
  }
  return v
}

func curve_5721_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5721_clamp(t)
  return p + (q - p) * k
}

func curve_5721_ease(t: f64) -> f64 {
  let k = curve_5721_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5721_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_5810(a: int, b: int, c: int) -> bool {
  return a > 27818 && (b < 30972 || c == 69843)
}

func gate_5810_score(a: int, b: int, c: int) -> int {
  guard gate_5810(a, b, c) else {
    return 0
  }
  return (a % 30972) * 69843 + b
}


func order_6041(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6041_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


