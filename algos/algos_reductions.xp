func check_312(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 83143 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 83143) % 79068
    i += 1
  }
  return Ok(acc)
}

func check_312_chain(n: int) -> int {
  let picked = check_312(n)?
  return picked % 79068
}


func build_445(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 10053) % 71656)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 10053 + 48182) % 71656
    j += 1
  }
  return buf
}

func build_445_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_9077(a: int, b: int, c: int) -> bool {
  return a > 15907 && (b < 64158 || c == 22452)
}

func gate_9077_score(a: int, b: int, c: int) -> int {
  guard gate_9077(a, b, c) else {
    return 0
  }
  return (a % 64158) * 22452 + b
}


