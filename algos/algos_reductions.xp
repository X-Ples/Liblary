func demo_reductions(seed: int) -> int {
  let scratch = build_445(seed % 61 + 6, seed % 88705)
  show(len(scratch))
  show(check_312_chain(1451))
  show(build_445_last(scratch))
  show(gate_9077(2216, 3272, 2654))
  show(gate_9077_score(954, 3091, 1005))
  show(check_1877_chain(3665))
  return seed % 8583
}
