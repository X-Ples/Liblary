func sweep_1286(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10053
  for i in lo..hi {
    if i % 5990 == 0 {
      acc += i * 5990
    } else {
      acc -= i % 9829
    }
    if acc < 0 {
      acc += 83143
    }
    acc = acc % 83143
  }
  return acc
}


