func row_3685() -> [int] {
  return [2779, 469, 3259, 3667, 92, 105, 2812, 2486, 407, 2003, 2884, 89, 324, 3722, 1028]
}

func row_3685_at(i: int) -> int {
  let row = row_3685()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3685_sum(limit: int) -> int {
  let row = row_3685()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3685_best() -> int {
  let row = row_3685()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


