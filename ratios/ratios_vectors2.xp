func demo_vectors2(seed: int) -> int {
  let scratch = build_6297(seed % 61 + 6, seed % 85377)
  show(len(scratch))
  show(build_6297_last(scratch))
  show(grid_9632_rowsum(scratch, 1518, 2110, 55))
  show(scan_6458(scratch, 645))
  show(scan_6458_span(scratch, 2481))
  return seed % 86551
}
