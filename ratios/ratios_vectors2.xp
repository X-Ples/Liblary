func check_377(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 15352 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 31897) % 51290
    i += 1
  }
  return Ok(acc)
}

func check_377_chain(n: int) -> int {
  let picked = check_377(n)?
  return picked % 51290
}


