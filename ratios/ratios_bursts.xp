func build_8926(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 7449) % 92338)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 7449 + 39519) % 92338
    j += 1
  }
  return buf
}

func build_8926_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_8078(a: int, b: int, c: int) -> bool {
  return a > 46021 && (b < 7449 || c == 73677)
}

func gate_8078_score(a: int, b: int, c: int) -> int {
  guard gate_8078(a, b, c) else {
    return 0
  }
  return (a % 7449) * 73677 + b
}


func curve_8080_clamp(v: f64) -> f64 {
  guard v >= 9750.0 else {
    return 9750.0
  }
  guard v <= 40993.0 else {
    return 40993.0
  }
  return v
}

func curve_8080_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8080_clamp(t)
  return p + (q - p) * k
}

func curve_8080_ease(t: f64) -> f64 {
  let k = curve_8080_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8080_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


