func check_9519(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 65368 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 71469) % 49830
    i += 1
  }
  return Ok(acc)
}

func check_9519_chain(n: int) -> int {
  let picked = check_9519(n)?
  return picked % 49830
}


