func demo_offsets(seed: int) -> int {
  let scratch = build_2683(seed % 61 + 6, seed % 51637)
  show(len(scratch))
  show(build_2683_last(scratch))
  show(grid_8833_rowsum(scratch, 1945, 3287, 3182))
  show(sweep_5544(2647, 1725))
  show(scan_6590(scratch, 1336))
  show(scan_6590_span(scratch, 3580))
  show(build_5507_last(scratch))
  return seed % 26534
}
