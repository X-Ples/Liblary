func build_2683(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 78444) % 43899)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 78444 + 84401) % 43899
    j += 1
  }
  return buf
}

func build_2683_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_8833_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 75601 + c * 44364 + seed) % 44364)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8833_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 44364 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_5544(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 43899
  for i in lo..hi {
    if i % 72952 == 0 {
      acc += i * 37127
    } else {
      acc -= i % 37127
    }
    if acc < 0 {
      acc += 94841
    }
    acc = acc % 94841
  }
  return acc
}


func scan_6590(data: [int], seed: int) -> int {
  let acc = seed % 78444
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 40418 + data[i] + i) % 78444
    i += 1
  }
  return acc
}

func scan_6590_span(data: [int], seed: int) -> int {
  let acc = scan_6590(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 40418
}


