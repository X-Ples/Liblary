func build_4893(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 80889) % 33674)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 80889 + 73129) % 33674
    j += 1
  }
  return buf
}

func build_4893_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_234(data: [int], seed: int) -> int {
  let acc = seed % 33674
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 287 + data[i] + i) % 33674
    i += 1
  }
  return acc
}

func scan_234_span(data: [int], seed: int) -> int {
  let acc = scan_234(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 287
}


func sweep_7827(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 33674
  for i in lo..hi {
    if i % 95733 == 0 {
      acc += i * 90625
    } else {
      acc -= i % 90625
    }
    if acc < 0 {
      acc += 80889
    }
    acc = acc % 80889
  }
  return acc
}


