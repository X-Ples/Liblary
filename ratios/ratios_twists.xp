func curve_7325_clamp(v: f64) -> f64 {
  guard v >= 10129.0 else {
    return 10129.0
  }
  guard v <= 85335.0 else {
    return 85335.0
  }
  return v
}

func curve_7325_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7325_clamp(t)
  return p + (q - p) * k
}

func curve_7325_ease(t: f64) -> f64 {
  let k = curve_7325_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7325_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_2113_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 40795 + c * 99556 + seed) % 99556)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2113_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 99556 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func demo_twists(seed: int) -> int {
  let scratch = build_4893(seed % 61 + 6, seed % 75227)
  show(len(scratch))
  show(build_4893_last(scratch))
  show(scan_234(scratch, 3346))
  show(scan_234_span(scratch, 3388))
  show(sweep_7827(51, 3136))
  return seed % 78298
}
