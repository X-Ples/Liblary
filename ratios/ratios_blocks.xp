func curve_4344_clamp(v: f64) -> f64 {
  guard v >= 82738.0 else {
    return 82738.0
  }
  guard v <= 93390.0 else {
    return 93390.0
  }
  return v
}

func curve_4344_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4344_clamp(t)
  return p + (q - p) * k
}

func curve_4344_ease(t: f64) -> f64 {
  let k = curve_4344_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4344_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_3168_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 48067
    i += 1
  }
  return acc % 48067
}

func text_3168_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "kilo"
}

func text_3168_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 73617
}


