func demo_blocks(seed: int) -> int {
  let scratch = build_6363(seed % 61 + 6, seed % 4242)
  show(len(scratch))
  show(order_5742_find(scratch, 3322))
  show(build_6363_last(scratch))
  show(gate_8622(3735, 2813, 1308))
  show(gate_8622_score(1662, 3959, 346))
  show(grid_6641_rowsum(scratch, 2470, 3149, 11))
  return seed % 60244
}
