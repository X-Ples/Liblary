func order_5742(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5742_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_6363(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 60244) % 25065)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 60244 + 66726) % 25065
    j += 1
  }
  return buf
}

func build_6363_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_8622(a: int, b: int, c: int) -> bool {
  return a > 60244 && (b < 80386 || c == 66726)
}

func gate_8622_score(a: int, b: int, c: int) -> int {
  guard gate_8622(a, b, c) else {
    return 0
  }
  return (a % 80386) * 66726 + b
}


func grid_6641_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 93390 + c * 72447 + seed) % 72447)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6641_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 72447 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_4067(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 31820 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 1595) % 20969
    i += 1
  }
  return Ok(acc)
}

func check_4067_chain(n: int) -> int {
  let picked = check_4067(n)?
  return picked % 20969
}


func sweep_948(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 67878
  for i in lo..hi {
    if i % 11882 == 0 {
      acc += i * 41724
    } else {
      acc -= i % 60244
    }
    if acc < 0 {
      acc += 20969
    }
    acc = acc % 20969
  }
  return acc
}


