func scan_6185(data: [int], seed: int) -> int {
  let acc = seed % 55570
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 80386 + data[i] + i) % 55570
    i += 1
  }
  return acc
}

func scan_6185_span(data: [int], seed: int) -> int {
  let acc = scan_6185(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 80386
}


