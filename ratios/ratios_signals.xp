func gate_7123(a: int, b: int, c: int) -> bool {
  return a > 65515 && (b < 824 || c == 98067)
}

func gate_7123_score(a: int, b: int, c: int) -> int {
  guard gate_7123(a, b, c) else {
    return 0
  }
  return (a % 824) * 98067 + b
}


func grid_2953_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 43997 + c * 90000 + seed) % 90000)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2953_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 90000 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_3645(data: [int], seed: int) -> int {
  let acc = seed % 10532
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 88354 + data[i] + i) % 10532
    i += 1
  }
  return acc
}

func scan_3645_span(data: [int], seed: int) -> int {
  let acc = scan_3645(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 88354
}


func curve_4645_clamp(v: f64) -> f64 {
  guard v >= 88354.0 else {
    return 88354.0
  }
  guard v <= 98042.0 else {
    return 98042.0
  }
  return v
}

func curve_4645_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4645_clamp(t)
  return p + (q - p) * k
}

func curve_4645_ease(t: f64) -> f64 {
  let k = curve_4645_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4645_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


