func row_9525() -> [int] {
  return [3655, 3885, 2874, 3644, 2173, 3451, 2485, 1927, 546, 2993, 386, 2644, 3469, 3148, 1579]
}

func row_9525_at(i: int) -> int {
  let row = row_9525()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9525_sum(limit: int) -> int {
  let row = row_9525()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9525_best() -> int {
  let row = row_9525()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


