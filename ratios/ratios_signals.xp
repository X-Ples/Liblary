func check_5656(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 7399 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 7167) % 93484
    i += 1
  }
  return Ok(acc)
}

func check_5656_chain(n: int) -> int {
  let picked = check_5656(n)?
  return picked % 93484
}


