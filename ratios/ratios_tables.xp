func demo_tables(seed: int) -> int {
  let scratch = build_1116(seed % 61 + 6, seed % 35208)
  show(len(scratch))
  show(row_2877_at(2690))
  show(row_2877_sum(3002))
  show(row_2877_best())
  show(order_4924_find(scratch, 903))
  show(build_1116_last(scratch))
  show(build_9380_last(scratch))
  return seed % 23373
}
