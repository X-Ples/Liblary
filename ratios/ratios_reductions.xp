func build_9777(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 68779) % 42260)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 68779 + 87449) % 42260
    j += 1
  }
  return buf
}

func build_9777_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_2863_clamp(v: f64) -> f64 {
  guard v >= 7715.0 else {
    return 7715.0
  }
  guard v <= 30207.0 else {
    return 30207.0
  }
  return v
}

func curve_2863_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2863_clamp(t)
  return p + (q - p) * k
}

func curve_2863_ease(t: f64) -> f64 {
  let k = curve_2863_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2863_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


