func gate_6067(a: int, b: int, c: int) -> bool {
  return a > 61078 && (b < 33653 || c == 31078)
}

func gate_6067_score(a: int, b: int, c: int) -> int {
  guard gate_6067(a, b, c) else {
    return 0
  }
  return (a % 33653) * 31078 + b
}


func order_6125(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6125_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func demo_reductions(seed: int) -> int {
  let scratch = build_9777(seed % 61 + 6, seed % 32591)
  show(len(scratch))
  show(build_9777_last(scratch))
  show(row_7779_at(1712))
  show(row_7779_sum(2627))
  show(row_7779_best())
  show(check_7378_chain(1173))
  return seed % 23101
}
