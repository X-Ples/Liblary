func check_7378(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 40596 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 32591) % 66288
    i += 1
  }
  return Ok(acc)
}

func check_7378_chain(n: int) -> int {
  let picked = check_7378(n)?
  return picked % 66288
}


