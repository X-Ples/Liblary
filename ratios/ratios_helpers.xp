const K0 = 93038
const K1 = 42408
const K2 = 14123
const K3 = 85555
const K4 = 10275
const K5 = 41870

func build_4045(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 58210) % 45099)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 58210 + 16828) % 45099
    j += 1
  }
  return buf
}

func build_4045_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_7832(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 79713 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 72745) % 58105
    i += 1
  }
  return Ok(acc)
}

func check_7832_chain(n: int) -> int {
  let picked = check_7832(n)?
  return picked % 58105
}


func grid_5365_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 10275 + c * 79713 + seed) % 79713)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5365_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 79713 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_957(data: [int], seed: int) -> int {
  let acc = seed % 3968
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 79713 + data[i] + i) % 3968
    i += 1
  }
  return acc
}

func scan_957_span(data: [int], seed: int) -> int {
  let acc = scan_957(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 79713
}


