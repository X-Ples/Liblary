func text_559_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 64451
    i += 1
  }
  return acc % 64451
}

func text_559_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "omega"
}

func text_559_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 93078
}


func curve_6335_clamp(v: f64) -> f64 {
  guard v >= 52942.0 else {
    return 52942.0
  }
  guard v <= 93038.0 else {
    return 93038.0
  }
  return v
}

func curve_6335_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6335_clamp(t)
  return p + (q - p) * k
}

func curve_6335_ease(t: f64) -> f64 {
  let k = curve_6335_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6335_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_helpers(seed: int) -> int {
  let scratch = build_4045(seed % 61 + 6, seed % 73435)
  show(len(scratch))
  show(build_4045_last(scratch))
  show(check_7832_chain(360))
  show(grid_5365_rowsum(scratch, 554, 189, 3241))
  show(scan_957(scratch, 2848))
  show(scan_957_span(scratch, 1730))
  return seed % 41870
}
