func sweep_8227(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 54224
  for i in lo..hi {
    if i % 73288 == 0 {
      acc += i * 54224
    } else {
      acc -= i % 48514
    }
    if acc < 0 {
      acc += 3610
    }
    acc = acc % 3610
  }
  return acc
}


func curve_4455_clamp(v: f64) -> f64 {
  guard v >= 73288.0 else {
    return 73288.0
  }
  guard v <= 77928.0 else {
    return 77928.0
  }
  return v
}

func curve_4455_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4455_clamp(t)
  return p + (q - p) * k
}

func curve_4455_ease(t: f64) -> f64 {
  let k = curve_4455_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4455_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_8719(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 53686) % 73288)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 53686 + 8327) % 73288
    j += 1
  }
  return buf
}

func build_8719_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_707(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_707_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_4962_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 82485
    i += 1
  }
  return acc % 82485
}

func text_4962_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "jetty"
}

func text_4962_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 77784
}


