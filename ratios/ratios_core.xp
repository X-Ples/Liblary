func demo_core(seed: int) -> int {
  let scratch = build_8719(seed % 61 + 6, seed % 51323)
  show(len(scratch))
  show(sweep_8227(3283, 1169))
  show(build_8719_last(scratch))
  show(order_707_find(scratch, 1141))
