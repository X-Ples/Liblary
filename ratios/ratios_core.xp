func scan_1885(data: [int], seed: int) -> int {
  let acc = seed % 14672
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 14672 + data[i] + i) % 14672
    i += 1
  }
  return acc
}

func scan_1885_span(data: [int], seed: int) -> int {
  let acc = scan_1885(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 14672
}


