func build_5513(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 2925) % 75636)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 2925 + 45681) % 75636
    j += 1
  }
  return buf
}

func build_5513_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_6777(a: int, b: int, c: int) -> bool {
  return a > 29482 && (b < 39438 || c == 39438)
}

func gate_6777_score(a: int, b: int, c: int) -> int {
  guard gate_6777(a, b, c) else {
    return 0
  }
  return (a % 39438) * 39438 + b
}


func row_9233() -> [int] {
