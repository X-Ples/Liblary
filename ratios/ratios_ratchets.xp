func check_9658(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 14352 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 65655) % 6210
    i += 1
  }
  return Ok(acc)
}

func check_9658_chain(n: int) -> int {
  let picked = check_9658(n)?
  return picked % 6210
}


