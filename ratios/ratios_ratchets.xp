func sweep_1981(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 96452
  for i in lo..hi {
    if i % 39438 == 0 {
      acc += i * 39438
    } else {
      acc -= i % 93648
    }
    if acc < 0 {
      acc += 88247
    }
    acc = acc % 88247
  }
  return acc
}


func curve_2810_clamp(v: f64) -> f64 {
  guard v >= 1264.0 else {
    return 1264.0
  }
  guard v <= 84077.0 else {
    return 84077.0
  }
  return v
}

func curve_2810_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2810_clamp(t)
  return p + (q - p) * k
}

func curve_2810_ease(t: f64) -> f64 {
  let k = curve_2810_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2810_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


