func sweep_7723(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 21932
  for i in lo..hi {
    if i % 20414 == 0 {
      acc += i * 94768
    } else {
      acc -= i % 92912
    }
    if acc < 0 {
      acc += 45975
    }
    acc = acc % 45975
  }
  return acc
}


