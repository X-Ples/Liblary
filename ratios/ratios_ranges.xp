func build_6075(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 17697) % 76446)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 17697 + 66929) % 76446
    j += 1
  }
  return buf
}

func build_6075_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_5043(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 66929 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 25897) % 54002
    i += 1
  }
  return Ok(acc)
}

func check_5043_chain(n: int) -> int {
  let picked = check_5043(n)?
  return picked % 54002
}


