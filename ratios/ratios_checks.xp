func sweep_6101(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 81367
  for i in lo..hi {
    if i % 47775 == 0 {
      acc += i * 49037
    } else {
      acc -= i % 55398
    }
    if acc < 0 {
      acc += 10976
    }
    acc = acc % 10976
  }
  return acc
}


