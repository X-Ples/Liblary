func build_5789(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 70316) % 47071)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 70316 + 76746) % 47071
    j += 1
  }
  return buf
}

func build_5789_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_4322_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 51050 + c * 81367 + seed) % 81367)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4322_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 81367 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_288(a: int, b: int, c: int) -> bool {
  return a > 74222 && (b < 87451 || c == 11546)
}

func gate_288_score(a: int, b: int, c: int) -> int {
  guard gate_288(a, b, c) else {
    return 0
  }
  return (a % 87451) * 11546 + b
}


func row_8499() -> [int] {
  return [399, 1483, 3809, 2088, 2480, 986, 2755, 548, 1212, 616, 3556, 2220, 1937]
}

func row_8499_at(i: int) -> int {
  let row = row_8499()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8499_sum(limit: int) -> int {
  let row = row_8499()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8499_best() -> int {
  let row = row_8499()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


