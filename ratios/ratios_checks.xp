func demo_checks(seed: int) -> int {
  let scratch = build_5789(seed % 61 + 6, seed % 74222)
  show(len(scratch))
  show(build_5789_last(scratch))
  show(grid_4322_rowsum(scratch, 2972, 256, 1774))
  show(gate_288(1913, 1848, 1473))
  show(gate_288_score(3201, 2358, 3006))
  return seed % 78235
}
