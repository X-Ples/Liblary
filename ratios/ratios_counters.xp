func row_8512() -> [int] {
  return [3478, 3264, 3079, 2552, 3068, 1668, 3651, 3995, 4056, 3344, 3821, 1108, 3954, 1682, 380, 3621, 2298, 2594]
}

func row_8512_at(i: int) -> int {
  let row = row_8512()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8512_sum(limit: int) -> int {
  let row = row_8512()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8512_best() -> int {
  let row = row_8512()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


