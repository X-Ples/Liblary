func demo_counters(seed: int) -> int {
  let scratch = build_641(seed % 61 + 6, seed % 42314)
  show(len(scratch))
  show(grid_4484_rowsum(scratch, 3293, 3614, 1999))
  show(build_641_last(scratch))
  show(scan_5447(scratch, 1058))
  show(scan_5447_span(scratch, 3078))
  show(check_7323_chain(2147))
  return seed % 93179
}
