func sweep_4068(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 57419
  for i in lo..hi {
    if i % 57419 == 0 {
      acc += i * 71064
    } else {
      acc -= i % 57419
    }
    if acc < 0 {
      acc += 76164
    }
    acc = acc % 76164
  }
  return acc
}


