func grid_4484_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 94022 + c * 33400 + seed) % 33400)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4484_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 33400 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_641(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 26730) % 88946)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 26730 + 57419) % 88946
    j += 1
  }
  return buf
}

func build_641_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_7704_clamp(v: f64) -> f64 {
  guard v >= 1076.0 else {
    return 1076.0
  }
  guard v <= 70418.0 else {
    return 70418.0
  }
  return v
}

func curve_7704_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7704_clamp(t)
  return p + (q - p) * k
}

func curve_7704_ease(t: f64) -> f64 {
  let k = curve_7704_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7704_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_5447(data: [int], seed: int) -> int {
  let acc = seed % 71064
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 74787 + data[i] + i) % 71064
    i += 1
  }
  return acc
}

func scan_5447_span(data: [int], seed: int) -> int {
  let acc = scan_5447(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 74787
}


func check_7323(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 99792 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 57419) % 59048
    i += 1
  }
  return Ok(acc)
}

func check_7323_chain(n: int) -> int {
  let picked = check_7323(n)?
  return picked % 59048
}


