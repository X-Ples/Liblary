func row_6275() -> [int] {
  return [2302, 1106, 1169, 4079, 472, 3356, 1204, 3013, 1766, 1121]
}

func row_6275_at(i: int) -> int {
  let row = row_6275()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6275_sum(limit: int) -> int {
  let row = row_6275()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6275_best() -> int {
  let row = row_6275()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_9865_clamp(v: f64) -> f64 {
  guard v >= 56017.0 else {
    return 56017.0
  }
  guard v <= 61152.0 else {
    return 61152.0
  }
  return v
}

func curve_9865_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9865_clamp(t)
  return p + (q - p) * k
}

func curve_9865_ease(t: f64) -> f64 {
  let k = curve_9865_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9865_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


