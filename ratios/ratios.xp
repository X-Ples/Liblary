func sweep_821(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 50317
  for i in lo..hi {
    if i % 30455 == 0 {
      acc += i * 30455
    } else {
      acc -= i % 61847
    }
    if acc < 0 {
      acc += 5744
    }
    acc = acc % 5744
  }
  return acc
}


func build_9687(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 87081) % 96760)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 87081 + 38545) % 96760
    j += 1
  }
  return buf
}

func build_9687_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_4672(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4672_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func grid_5119_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 31578 + c * 20630 + seed) % 20630)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5119_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 20630 == want {
      total += acc
    }
    r += 1
  }
  return total
}


