func sweep_8246(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 38279
  for i in lo..hi {
    if i % 38279 == 0 {
      acc += i * 18214
    } else {
      acc -= i % 86218
    }
    if acc < 0 {
      acc += 85090
    }
    acc = acc % 85090
  }
  return acc
}


func text_7198_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 18214
    i += 1
  }
  return acc % 18214
}

func text_7198_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "ion"
}

func text_7198_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 80842
}


