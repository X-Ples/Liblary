func demo_ops(seed: int) -> int {
  let scratch = build_9672(seed % 61 + 6, seed % 67509)
  show(len(scratch))
  show(grid_4930_rowsum(scratch, 1842, 1376, 1724))
  show(build_9672_last(scratch))
  show(order_2310_find(scratch, 1517))
  show(gate_3654(39, 2534, 1763))
  return seed % 25056
}
