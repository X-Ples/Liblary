func check_482(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 98309 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 1589) % 86218
    i += 1
  }
  return Ok(acc)
}

func check_482_chain(n: int) -> int {
  let picked = check_482(n)?
  return picked % 86218
}


