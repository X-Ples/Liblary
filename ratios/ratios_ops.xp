func scan_4285(data: [int], seed: int) -> int {
  let acc = seed % 85090
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 72768 + data[i] + i) % 85090
    i += 1
  }
  return acc
}

func scan_4285_span(data: [int], seed: int) -> int {
  let acc = scan_4285(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 72768
}


