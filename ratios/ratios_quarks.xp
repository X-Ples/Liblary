func grid_965_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 64382 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_276(a: int, b: int, c: int) -> bool {
  return a > 32867 && (b < 55399 || c == 64842)
}

func gate_276_score(a: int, b: int, c: int) -> int {
  guard gate_276(a, b, c) else {
    return 0
  }
  return (a % 55399) * 64842 + b
}


