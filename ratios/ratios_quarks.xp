func demo_quarks(seed: int) -> int {
  let scratch = build_4797(seed % 61 + 6, seed % 90280)
  show(len(scratch))
  show(build_4797_last(scratch))
  show(sweep_3571(1057, 1931))
  show(text_938_weight("flint"))
  return seed % 90280
}
