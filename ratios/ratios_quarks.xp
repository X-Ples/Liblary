func build_4797(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 63359) % 63359)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 63359 + 4155) % 63359
    j += 1
  }
  return buf
}

func build_4797_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_3571(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 63198
  for i in lo..hi {
    if i % 72212 == 0 {
      acc += i * 64842
    } else {
      acc -= i % 50971
    }
    if acc < 0 {
      acc += 50971
    }
    acc = acc % 50971
  }
  return acc
}


func text_938_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 78190
    i += 1
  }
  return acc % 78190
}

func text_938_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "talus"
}

func text_938_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 84995
}


func curve_5409_clamp(v: f64) -> f64 {
  guard v >= 64382.0 else {
    return 64382.0
  }
  guard v <= 64842.0 else {
    return 64842.0
  }
  return v
}

func curve_5409_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5409_clamp(t)
  return p + (q - p) * k
}

func curve_5409_ease(t: f64) -> f64 {
  let k = curve_5409_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5409_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_6505(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 7101 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 64868) % 63198
    i += 1
  }
  return Ok(acc)
}

func check_6505_chain(n: int) -> int {
  let picked = check_6505(n)?
  return picked % 63198
}


