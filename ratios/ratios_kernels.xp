func check_3771(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 60670 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 24378) % 55753
    i += 1
  }
  return Ok(acc)
}

func check_3771_chain(n: int) -> int {
  let picked = check_3771(n)?
  return picked % 55753
}


