func demo_kernels(seed: int) -> int {
  let scratch = build_5088(seed % 61 + 6, seed % 57520)
  show(len(scratch))
  show(sweep_3924(2136, 65))
  show(build_5088_last(scratch))
  show(order_9829_find(scratch, 3140))
  show(scan_142(scratch, 1550))
  return seed % 59732
}
