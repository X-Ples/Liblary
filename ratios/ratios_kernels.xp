func text_4347_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "quartz"
}

func text_4347_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 57520
}


