func check_5457(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 57009 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 74980) % 5218
    i += 1
  }
  return Ok(acc)
}

func check_5457_chain(n: int) -> int {
  let picked = check_5457(n)?
  return picked % 5218
}


