func sweep_1114(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 81151
  for i in lo..hi {
    if i % 14400 == 0 {
      acc += i * 28725
    } else {
      acc -= i % 18713
    }
    if acc < 0 {
      acc += 74232
    }
    acc = acc % 74232
  }
  return acc
}


func scan_7053(data: [int], seed: int) -> int {
  let acc = seed % 28012
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 95559 + data[i] + i) % 28012
    i += 1
  }
  return acc
}

func scan_7053_span(data: [int], seed: int) -> int {
  let acc = scan_7053(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 95559
}


func demo_pickers(seed: int) -> int {
  let scratch = build_7447(seed % 61 + 6, seed % 53523)
  show(len(scratch))
  show(build_7447_last(scratch))
  show(build_4742_last(scratch))
  show(text_5770_weight("alpha"))
  show(text_5770_label(981))
  show(text_5770_has("flint"))
  return seed % 91061
}
