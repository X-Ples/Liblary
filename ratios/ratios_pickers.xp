func text_5770_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 23941
    i += 1
  }
  return acc % 23941
}

func text_5770_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "flint"
}

func text_5770_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 43735
}


func order_4015(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4015_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func curve_8272_clamp(v: f64) -> f64 {
  guard v >= 28725.0 else {
    return 28725.0
  }
  guard v <= 95559.0 else {
    return 95559.0
  }
  return v
}

func curve_8272_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8272_clamp(t)
  return p + (q - p) * k
}

func curve_8272_ease(t: f64) -> f64 {
  let k = curve_8272_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8272_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_8015() -> [int] {
  return [3673, 3921, 3220, 2087, 2164, 169, 1854, 2970, 161, 1515, 2469, 831, 3154, 1896, 3973, 857, 3630, 1091, 981]
}

func row_8015_at(i: int) -> int {
  let row = row_8015()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8015_sum(limit: int) -> int {
  let row = row_8015()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8015_best() -> int {
  let row = row_8015()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


