func text_7002_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 94357
    i += 1
  }
  return acc % 94357
}

func text_7002_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "ridge"
}

func text_7002_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 94357
}


