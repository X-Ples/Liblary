func demo_shapes(seed: int) -> int {
  let scratch = build_6672(seed % 61 + 6, seed % 66076)
  show(len(scratch))
  show(build_6672_last(scratch))
  show(check_5963_chain(1903))
  show(order_1089_find(scratch, 1848))
  show(check_1510_chain(3268))
  show(check_1156_chain(1439))
  show(sweep_6030(3652, 3603))
  return seed % 20323
}
