func build_6672(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 94789) % 64164)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 94789 + 68296) % 64164
    j += 1
  }
  return buf
}

func build_6672_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_5963(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 10187 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 94357) % 63788
    i += 1
  }
  return Ok(acc)
}

func check_5963_chain(n: int) -> int {
  let picked = check_5963(n)?
  return picked % 63788
}


func curve_2806_clamp(v: f64) -> f64 {
  guard v >= 27296.0 else {
    return 27296.0
  }
  guard v <= 86279.0 else {
    return 86279.0
  }
  return v
}

func curve_2806_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2806_clamp(t)
  return p + (q - p) * k
}

func curve_2806_ease(t: f64) -> f64 {
  let k = curve_2806_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2806_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_1089(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1089_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


