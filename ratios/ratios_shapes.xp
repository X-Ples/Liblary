  guard hi > lo else {
    return 0
  }
  let acc = 27055
  for i in lo..hi {
    if i % 22604 == 0 {
      acc += i * 68296
    } else {
      acc -= i % 94357
    }
    if acc < 0 {
      acc += 83848
    }
    acc = acc % 83848
