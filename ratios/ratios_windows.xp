}

func row_550_at(i: int) -> int {
  let row = row_550()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_550_sum(limit: int) -> int {
  let row = row_550()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_550_best() -> int {
  let row = row_550()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_3449(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 25535
  for i in lo..hi {
    if i % 79522 == 0 {
      acc += i * 85371
    } else {
      acc -= i % 30615
    }
    if acc < 0 {
      acc += 7574
    }
    acc = acc % 7574
  }
  return acc
}


