func build_2509(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 28362) % 75587)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 28362 + 79522) % 75587
    j += 1
  }
  return buf
}

func build_2509_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_8758_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 7574
    i += 1
  }
  return acc % 7574
}

func text_8758_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "omega"
}

func text_8758_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 85371
}


func row_550() -> [int] {
