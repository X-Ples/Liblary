func order_9775(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9775_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_215(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 15292) % 15025)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 15292 + 94963) % 15025
    j += 1
  }
  return buf
}

func build_215_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_1253() -> [int] {
  return [3260, 923, 4034, 513, 3265, 2893, 1843, 3122, 2431, 1626, 2183]
}

func row_1253_at(i: int) -> int {
  let row = row_1253()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1253_sum(limit: int) -> int {
  let row = row_1253()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1253_best() -> int {
  let row = row_1253()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_9742_clamp(v: f64) -> f64 {
  guard v >= 58504.0 else {
    return 58504.0
  }
  guard v <= 94963.0 else {
    return 94963.0
  }
  return v
}

func curve_9742_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9742_clamp(t)
  return p + (q - p) * k
}

func curve_9742_ease(t: f64) -> f64 {
  let k = curve_9742_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9742_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_4775(data: [int], seed: int) -> int {
  let acc = seed % 15025
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 58504 + data[i] + i) % 15025
    i += 1
  }
  return acc
}

func scan_4775_span(data: [int], seed: int) -> int {
  let acc = scan_4775(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 58504
}


func grid_300_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 60563 + c * 7552 + seed) % 7552)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_300_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 7552 == want {
      total += acc
    }
    r += 1
  }
  return total
}


