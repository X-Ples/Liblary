func text_4603_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 74087
    i += 1
  }
  return acc % 74087
}

func text_4603_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "delta"
}

func text_4603_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 92206
}


