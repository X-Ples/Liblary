func demo_trims(seed: int) -> int {
  let scratch = build_215(seed % 61 + 6, seed % 86619)
  show(len(scratch))
  show(order_9775_find(scratch, 2548))
  show(build_215_last(scratch))
  show(row_1253_at(825))
  return seed % 86638
}
