func demo_walkers(seed: int) -> int {
  let scratch = build_6611(seed % 61 + 6, seed % 67226)
  show(len(scratch))
  show(gate_9203(1422, 2639, 2677))
  show(gate_9203_score(3477, 2248, 2859))
  show(text_3802_weight("omega"))
  show(text_3802_label(3396))
  return seed % 24556
}
