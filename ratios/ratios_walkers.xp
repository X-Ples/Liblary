func gate_9203(a: int, b: int, c: int) -> bool {
  return a > 63587 && (b < 24556 || c == 42985)
}

func gate_9203_score(a: int, b: int, c: int) -> int {
  guard gate_9203(a, b, c) else {
    return 0
  }
  return (a % 24556) * 42985 + b
}


func text_3802_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 36095
    i += 1
  }
  return acc % 36095
}

func text_3802_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "harbor"
}

func text_3802_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 24556
}


func order_8040(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8040_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_6611(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 24556) % 24556)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 24556 + 96515) % 24556
    j += 1
  }
  return buf
}

func build_6611_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_4559(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 60700 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 6506) % 67147
    i += 1
  }
  return Ok(acc)
}

func check_4559_chain(n: int) -> int {
  let picked = check_4559(n)?
  return picked % 67147
}


func grid_5885_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 63324 + c * 24556 + seed) % 24556)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5885_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 24556 == want {
      total += acc
    }
    r += 1
  }
  return total
}


