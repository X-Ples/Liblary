func sweep_1268(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 60799
  for i in lo..hi {
    if i % 58117 == 0 {
      acc += i * 58117
    } else {
      acc -= i % 58942
    }
    if acc < 0 {
      acc += 43085
    }
    acc = acc % 43085
  }
  return acc
}


func check_681(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 10235 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 68252) % 68252
    i += 1
  }
  return Ok(acc)
}

func check_681_chain(n: int) -> int {
  let picked = check_681(n)?
  return picked % 68252
}


