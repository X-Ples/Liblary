func row_7857() -> [int] {
  return [531, 2591, 3781, 1633, 1491, 2218, 1018, 2705, 1932, 2382, 317, 3380, 1009, 3172, 1283, 3432, 3383, 390, 2780]
}

func row_7857_at(i: int) -> int {
  let row = row_7857()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7857_sum(limit: int) -> int {
  let row = row_7857()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7857_best() -> int {
  let row = row_7857()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_3930_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
