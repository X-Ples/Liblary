func demo_blends(seed: int) -> int {
  let scratch = build_7190(seed % 61 + 6, seed % 58942)
  show(len(scratch))
  show(build_7190_last(scratch))
  show(scan_4142(scratch, 422))
  show(scan_4142_span(scratch, 1931))
  show(text_2864_weight("cargo"))
  show(text_2864_label(2162))
  return seed % 60799
}
