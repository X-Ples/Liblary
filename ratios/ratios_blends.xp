func build_7190(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 39017) % 68639)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 39017 + 68252) % 68639
    j += 1
  }
  return buf
}

func build_7190_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_4142(data: [int], seed: int) -> int {
  let acc = seed % 43085
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 68639 + data[i] + i) % 43085
    i += 1
  }
  return acc
}

func scan_4142_span(data: [int], seed: int) -> int {
  let acc = scan_4142(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 68639
}


func text_2864_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 39980
    i += 1
  }
  return acc % 39980
}

func text_2864_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "quartz"
}

func text_2864_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 56564
}


func curve_4200_clamp(v: f64) -> f64 {
  guard v >= 85058.0 else {
    return 85058.0
  }
  guard v <= 89304.0 else {
    return 89304.0
  }
  return v
}

func curve_4200_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4200_clamp(t)
  return p + (q - p) * k
}

func curve_4200_ease(t: f64) -> f64 {
  let k = curve_4200_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4200_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_8495(a: int, b: int, c: int) -> bool {
  return a > 39017 && (b < 43085 || c == 85058)
}

func gate_8495_score(a: int, b: int, c: int) -> int {
  guard gate_8495(a, b, c) else {
    return 0
  }
  return (a % 43085) * 85058 + b
}


func order_8083(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8083_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


