func order_7747(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7747_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_136(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 32624) % 14502)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 32624 + 32624) % 14502
    j += 1
  }
  return buf
}

func build_136_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_4428_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 25013
    i += 1
  }
  return acc % 25013
}

func text_4428_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "flint"
}

func text_4428_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 18291
}


func scan_6623(data: [int], seed: int) -> int {
  let acc = seed % 11388
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 82434 + data[i] + i) % 11388
    i += 1
  }
  return acc
}

func scan_6623_span(data: [int], seed: int) -> int {
  let acc = scan_6623(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 82434
}


func sweep_1877(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 61831
  for i in lo..hi {
    if i % 92784 == 0 {
      acc += i * 58894
    } else {
      acc -= i % 92784
    }
    if acc < 0 {
      acc += 61831
    }
    acc = acc % 61831
  }
  return acc
}


func curve_5502_clamp(v: f64) -> f64 {
  guard v >= 25013.0 else {
    return 25013.0
  }
  guard v <= 87491.0 else {
    return 87491.0
  }
  return v
}

func curve_5502_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5502_clamp(t)
  return p + (q - p) * k
}

func curve_5502_ease(t: f64) -> f64 {
  let k = curve_5502_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5502_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


