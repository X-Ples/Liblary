func new_builder() -> [str] {
  return []
}

func push_line(b: [str], s: str) -> [str] {
  array_push(b, s)
  return b
}

func push_many(b: [str], s: str, n: int) -> [str] {
  let i = 0
  while i < n {
    array_push(b, s)
    i = i + 1
  }
  return b
}

func join_builder(b: [str], sep: str) -> str {
  return str_join(b, sep)
}

func builder_len(b: [str]) -> int {
  return len(b)
}

func builder_clear(b: [str]) -> int {
  array_clear(b)
  return len(b)
}

func slice_range(s: str, start: int, stop: int) -> str {
  let n = len(s)
  guard start >= 0 && stop <= n && start <= stop else {
    return ""
  }
  let out = ""
  let i = start
  while i < stop {
    out = out + str_char_at(s, i)
    i = i + 1
  }
  return out
}

func char_at_or(s: str, i: int, fallback: str) -> str {
  guard i >= 0 && i < len(s) else {
    return fallback
  }
  return str_char_at(s, i)
}

func count_char(s: str, ch: str) -> int {
  let total = 0
  let i = 0
  while i < len(s) {
    if str_char_at(s, i) == ch {
      total = total + 1
    }
    i = i + 1
  }
  return total
}

func count_sub(s: str, sub: str) -> int {
  let n = len(sub)
  guard n > 0 else {
    return 0
  }
  let limit = len(s) - n
  let total = 0
  let i = 0
  while i <= limit {
    if slice_range(s, i, i + n) == sub {
      total = total + 1
    }
    i = i + 1
  }
  return total
}

func repeat_line(s: str, n: int) -> str {
  guard n > 0 else {
    return ""
  }
  return str_repeat(s, n)
}

func pad_left(s: str, width: int, ch: str) -> str {
  guard width > len(s) && len(ch) > 0 else {
    return s
  }
  return str_repeat(ch, width - len(s)) + s
}

func pad_right(s: str, width: int, ch: str) -> str {
  guard width > len(s) && len(ch) > 0 else {
    return s
  }
  return s + str_repeat(ch, width - len(s))
}

func center(s: str, width: int, ch: str) -> str {
  guard width > len(s) && len(ch) > 0 else {
    return s
  }
  let pad = width - len(s)
  let left = pad / 2
  let right = pad - left
  return str_repeat(ch, left) + s + str_repeat(ch, right)
}

func indent(s: str, prefix: str) -> str {
  let parts = str_split(s, "\n")
  let out = []
  for p in parts {
    array_push(out, prefix + p)
  }
  return str_join(out, "\n")
}

func leading_spaces(s: str) -> int {
  let i = 0
  while i < len(s) && str_code_at(s, i) == 32 {
    i = i + 1
  }
  return i
}

func dedent(s: str) -> str {
  let parts = str_split(s, "\n")
  let mind = -1
  for p in parts {
    if len(p) > 0 {
      let ls = leading_spaces(p)
      if mind < 0 || ls < mind {
        mind = ls
      }
    }
  }
  guard mind > 0 else {
    return s
  }
  let out = []
  for p in parts {
    if len(p) == 0 {
      array_push(out, "")
    } else {
      array_push(out, slice_range(p, mind, len(p)))
    }
  }
  return str_join(out, "\n")
}

func capitalize_first(s: str) -> str {
  guard len(s) > 0 else {
    return s
  }
  return str_upper(str_char_at(s, 0)) + slice_range(s, 1, len(s))
}

func swapcase(s: str) -> str {
  let out = ""
  let i = 0
  while i < len(s) {
    let code = str_code_at(s, i)
    let ch = str_char_at(s, i)
    if code >= 97 && code <= 122 {
      out = out + str_upper(ch)
    } else if code >= 65 && code <= 90 {
      out = out + str_lower(ch)
    } else {
      out = out + ch
    }
    i = i + 1
  }
  return out
}

func is_alpha_like(s: str) -> bool {
  guard len(s) > 0 else {
    return false
  }
  let i = 0
  while i < len(s) {
    let code = str_code_at(s, i)
    let lower = code >= 97 && code <= 122
    let upper = code >= 65 && code <= 90
    if !lower && !upper {
      return false
    }
    i = i + 1
  }
  return true
}

func is_digit_like(s: str) -> bool {
  guard len(s) > 0 else {
    return false
  }
  let i = 0
  while i < len(s) {
    let code = str_code_at(s, i)
    if code < 48 || code > 57 {
      return false
    }
    i = i + 1
  }
  return true
}

func count_vowels(s: str) -> int {
  let total = 0
  let i = 0
  while i < len(s) {
    let code = str_code_at(s, i)
    if code == 97 || code == 101 || code == 105 || code == 111 || code == 117 {
      total = total + 1
    } else if code == 65 || code == 69 || code == 73 || code == 79 || code == 85 {
      total = total + 1
    }
    i = i + 1
  }
  return total
}

func truncate_ellipsis(s: str, maxlen: int) -> str {
  if len(s) <= maxlen {
    return s
  }
  guard maxlen >= 4 else {
    return slice_range(s, 0, maxlen)
  }
  return slice_range(s, 0, maxlen - 3) + "..."
}

func wrap_words(s: str, width: int) -> str {
  guard width > 0 else {
    return s
  }
  let words = str_split(s, " ")
  let lines = []
  let cur = ""
  for w in words {
    if len(w) == 0 {
      continue
    }
    if len(cur) == 0 {
      cur = w
    } else if len(cur) + 1 + len(w) <= width {
      cur = cur + " " + w
    } else {
      array_push(lines, cur)
      cur = w
    }
  }
  if len(cur) > 0 {
    array_push(lines, cur)
  }
  return str_join(lines, "\n")
}

func slugify(s: str) -> str {
  let src = str_lower(s)
  let out = ""
  let last_dash = false
  let i = 0
  while i < len(src) {
    let code = str_code_at(src, i)
    let ch = str_char_at(src, i)
    let alnum = (code >= 97 && code <= 122) || (code >= 48 && code <= 57)
    if code == 32 || code == 95 {
      if !last_dash && len(out) > 0 {
        out = out + "-"
        last_dash = true
      }
    } else if alnum {
      out = out + ch
      last_dash = false
    }
    i = i + 1
  }
  if str_ends(out, "-") {
    out = slice_range(out, 0, len(out) - 1)
  }
  return out
}

func file_ext(s: str) -> str {
  let idx = -1
  let i = len(s) - 1
  while i >= 0 {
    if str_char_at(s, i) == "." {
      idx = i
      i = -1
    } else {
      i = i - 1
    }
  }
  guard idx >= 0 else {
    return ""
  }
  return slice_range(s, idx + 1, len(s))
}

func file_stem(s: str) -> str {
  let idx = -1
  let i = len(s) - 1
  while i >= 0 {
    if str_char_at(s, i) == "." {
      idx = i
      i = -1
    } else {
      i = i - 1
    }
  }
  guard idx > 0 else {
    return s
  }
  return slice_range(s, 0, idx)
}

func strip_prefix(s: str, p: str) -> str {
  guard len(p) > 0 && str_starts(s, p) else {
    return s
  }
  return slice_range(s, len(p), len(s))
}

func strip_suffix(s: str, suf: str) -> str {
  guard len(suf) > 0 && str_ends(s, suf) else {
    return s
  }
  return slice_range(s, 0, len(s) - len(suf))
}

func replace_all(s: str, a: str, b: str) -> str {
  guard len(a) > 0 else {
    return s
  }
  let out = s
  let rounds = 0
  while str_contains(out, a) && rounds < 32 {
    out = str_replace(out, a, b)
    rounds = rounds + 1
  }
  return out
}

func split_lines(s: str) -> [str] {
  return str_split(s, "\n")
}

func line_count(s: str) -> int {
  return len(str_split(s, "\n"))
}

func word_count(s: str) -> int {
  let parts = str_split(s, " ")
  let total = 0
  for p in parts {
    if len(p) > 0 {
      total = total + 1
    }
  }
  return total
}

func char_freq(s: str) {
  let chars = []
  let counts = []
  let i = 0
  while i < len(s) {
    let ch = str_char_at(s, i)
    let found = -1
    let j = 0
    while j < len(chars) {
      if chars[j] == ch {
        found = j
        break
      }
      j = j + 1
    }
    if found >= 0 {
      counts[found] = counts[found] + 1
    } else {
      array_push(chars, ch)
      array_push(counts, 1)
    }
    i = i + 1
  }
  return [chars, counts]
}

func reverse_str(s: str) -> str {
  let out = ""
  let i = len(s) - 1
  while i >= 0 {
    out = out + str_char_at(s, i)
    i = i - 1
  }
  return out
}

func is_palindrome(s: str) -> bool {
  let src = str_lower(s)
  let norm = ""
  let i = 0
  while i < len(src) {
    let code = str_code_at(src, i)
    let alnum = (code >= 97 && code <= 122) || (code >= 48 && code <= 57)
    if alnum {
      norm = norm + str_char_at(src, i)
    }
    i = i + 1
  }
  return len(norm) > 0 && norm == reverse_str(norm)
}
