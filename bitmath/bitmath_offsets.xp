func sweep_2454(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 59868
  for i in lo..hi {
    if i % 7591 == 0 {
      acc += i * 7591
    } else {
      acc -= i % 71998
    }
    if acc < 0 {
      acc += 7122
    }
    acc = acc % 7122
  }
