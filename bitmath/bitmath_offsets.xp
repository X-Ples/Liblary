func demo_offsets(seed: int) -> int {
  let scratch = build_8618(seed % 61 + 6, seed % 54705)
  show(len(scratch))
  show(build_8618_last(scratch))
  show(order_2692_find(scratch, 1800))
  show(scan_8917(scratch, 2258))
  show(scan_8917_span(scratch, 548))
  return seed % 72890
}
