func row_1112() -> [int] {
  return [1689, 2225, 2581, 496, 2042, 850, 3829, 1414, 1646, 3609, 2205, 1443, 2197, 3482, 1507]
}

func row_1112_at(i: int) -> int {
  let row = row_1112()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1112_sum(limit: int) -> int {
  let row = row_1112()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1112_best() -> int {
  let row = row_1112()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


