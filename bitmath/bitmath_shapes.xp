func scan_9588(data: [int], seed: int) -> int {
  let acc = seed % 24022
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 8574 + data[i] + i) % 24022
    i += 1
  }
  return acc
}

func scan_9588_span(data: [int], seed: int) -> int {
  let acc = scan_9588(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 8574
}


func build_9506(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 10537) % 34425)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 10537 + 50844) % 34425
    j += 1
  }
  return buf
}

func build_9506_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


