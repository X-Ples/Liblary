func sweep_3076(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 39598
  for i in lo..hi {
    if i % 67347 == 0 {
      acc += i * 24730
    } else {
      acc -= i % 36527
    }
    if acc < 0 {
      acc += 64278
    }
    acc = acc % 64278
  }
  return acc
}


