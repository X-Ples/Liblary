func demo_shapes(seed: int) -> int {
  let scratch = build_9506(seed % 61 + 6, seed % 64278)
  show(len(scratch))
  show(scan_9588(scratch, 1694))
  show(scan_9588_span(scratch, 3505))
  show(build_9506_last(scratch))
  show(scan_7849(scratch, 3109))
  return seed % 58043
}
