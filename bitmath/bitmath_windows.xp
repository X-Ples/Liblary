func sweep_2253(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 30729
  for i in lo..hi {
    if i % 90469 == 0 {
      acc += i * 30729
    } else {
      acc -= i % 88563
    }
    if acc < 0 {
      acc += 70939
    }
    acc = acc % 70939
  }
  return acc
}


func build_7678(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 79986) % 11270)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 79986 + 87346) % 11270
    j += 1
  }
  return buf
}

func build_7678_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_2306() -> [int] {
  return [2789, 2324, 4018, 1614, 1839, 2976, 46, 3474, 3548, 2477, 3926]
}

func row_2306_at(i: int) -> int {
  let row = row_2306()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2306_sum(limit: int) -> int {
  let row = row_2306()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2306_best() -> int {
  let row = row_2306()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_3155_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 39603 + c * 26701 + seed) % 26701)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3155_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 26701 == want {
      total += acc
    }
    r += 1
  }
  return total
}


