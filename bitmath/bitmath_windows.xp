func curve_3372_clamp(v: f64) -> f64 {
  guard v >= 65980.0 else {
    return 65980.0
  }
  guard v <= 93603.0 else {
    return 93603.0
  }
  return v
}

func curve_3372_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3372_clamp(t)
  return p + (q - p) * k
}

func curve_3372_ease(t: f64) -> f64 {
  let k = curve_3372_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3372_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_3471_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 93603
    i += 1
  }
  return acc % 93603
}

func text_3471_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "flint"
}

func text_3471_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 12115
}


