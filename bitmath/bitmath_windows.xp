func demo_windows(seed: int) -> int {
  let scratch = build_7678(seed % 61 + 6, seed % 70939)
  show(len(scratch))
  show(sweep_2253(3075, 1497))
  show(build_7678_last(scratch))
  show(row_2306_at(1191))
  show(row_2306_sum(3623))
  show(row_2306_best())
  show(grid_3155_rowsum(scratch, 2138, 3429, 2097))
  return seed % 44624
}
