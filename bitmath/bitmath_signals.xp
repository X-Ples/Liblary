func demo_signals(seed: int) -> int {
  let scratch = build_595(seed % 61 + 6, seed % 87586)
  show(len(scratch))
  show(build_595_last(scratch))
  show(text_4121_weight("delta"))
  show(text_4121_label(2263))
  show(text_4121_has("cargo"))
  return seed % 77737
}
