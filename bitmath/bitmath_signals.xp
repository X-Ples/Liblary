func build_595(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 77737) % 5652)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 77737 + 52007) % 5652
    j += 1
  }
  return buf
}

func build_595_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_4121_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 93725
    i += 1
  }
  return acc % 93725
}

func text_4121_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "ridge"
}

func text_4121_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 83160
}


