  }
  return (a % 11183) * 5652 + b
}


func grid_7403_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 91561 + c * 39731 + seed) % 39731)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7403_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 39731 == want {
      total += acc
    }
    r += 1
  }
  return total
}


