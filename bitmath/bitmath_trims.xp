func demo_trims(seed: int) -> int {
  let scratch = build_2442(seed % 61 + 6, seed % 84859)
  show(len(scratch))
  show(build_2442_last(scratch))
  show(check_2581_chain(1985))
  show(gate_4652(812, 577, 2547))
  show(gate_4652_score(2281, 1255, 2884))
  show(scan_3780(scratch, 1899))
  show(scan_3780_span(scratch, 3953))
  return seed % 49278
}
