func build_2442(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 49278) % 38269)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 49278 + 84859) % 38269
    j += 1
  }
  return buf
}

func build_2442_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_2581(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 5397 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 82343) % 91186
    i += 1
  }
  return Ok(acc)
}

func check_2581_chain(n: int) -> int {
  let picked = check_2581(n)?
  return picked % 91186
}


func gate_4652(a: int, b: int, c: int) -> bool {
  return a > 6286 && (b < 2259 || c == 49278)
}

func gate_4652_score(a: int, b: int, c: int) -> int {
  guard gate_4652(a, b, c) else {
    return 0
  }
  return (a % 2259) * 49278 + b
}


func scan_3780(data: [int], seed: int) -> int {
  let acc = seed % 71906
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 60483 + data[i] + i) % 71906
    i += 1
  }
  return acc
}

func scan_3780_span(data: [int], seed: int) -> int {
  let acc = scan_3780(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 60483
}


func curve_9881_clamp(v: f64) -> f64 {
  guard v >= 2259.0 else {
    return 2259.0
  }
  guard v <= 77038.0 else {
    return 77038.0
  }
  return v
}

func curve_9881_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9881_clamp(t)
  return p + (q - p) * k
}

func curve_9881_ease(t: f64) -> f64 {
  let k = curve_9881_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9881_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


