func scan_7203(data: [int], seed: int) -> int {
  let acc = seed % 25729
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 35796 + data[i] + i) % 25729
    i += 1
  }
  return acc
}

func scan_7203_span(data: [int], seed: int) -> int {
