func demo_ratchets(seed: int) -> int {
  let scratch = build_315(seed % 61 + 6, seed % 49324)
  show(len(scratch))
  show(build_315_last(scratch))
  show(grid_686_rowsum(scratch, 923, 3672, 2922))
  show(gate_2509(3909, 3343, 2805))
  show(gate_2509_score(924, 277, 633))
  return seed % 96693
}
