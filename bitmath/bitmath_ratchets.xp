func build_315(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 87949) % 37151)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 87949 + 49324) % 37151
    j += 1
  }
  return buf
}

func build_315_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_686_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 24388 + c * 96693 + seed) % 96693)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_686_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 96693 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_3505_clamp(v: f64) -> f64 {
  guard v >= 46287.0 else {
    return 46287.0
  }
  guard v <= 56017.0 else {
    return 56017.0
  }
  return v
}

func curve_3505_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3505_clamp(t)
  return p + (q - p) * k
}

func curve_3505_ease(t: f64) -> f64 {
  let k = curve_3505_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3505_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_2509(a: int, b: int, c: int) -> bool {
  return a > 20728 && (b < 24388 || c == 16951)
}

func gate_2509_score(a: int, b: int, c: int) -> int {
  guard gate_2509(a, b, c) else {
    return 0
  }
  return (a % 24388) * 16951 + b
}


func sweep_767(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 1325
  for i in lo..hi {
    if i % 68899 == 0 {
      acc += i * 10055
    } else {
      acc -= i % 26725
    }
    if acc < 0 {
      acc += 27320
    }
    acc = acc % 27320
  }
  return acc
}


func check_7637(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 8242 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 36306) % 56017
    i += 1
  }
  return Ok(acc)
}

func check_7637_chain(n: int) -> int {
  let picked = check_7637(n)?
  return picked % 56017
}


