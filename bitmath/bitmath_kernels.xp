func check_9306(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 11129 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 19459) % 81509
    i += 1
  }
  return Ok(acc)
}

func check_9306_chain(n: int) -> int {
  let picked = check_9306(n)?
  return picked % 81509
}


