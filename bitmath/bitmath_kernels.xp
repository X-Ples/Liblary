func demo_kernels(seed: int) -> int {
  let scratch = build_8941(seed % 61 + 6, seed % 11025)
  show(len(scratch))
  show(grid_358_rowsum(scratch, 1267, 1848, 319))
  show(build_8941_last(scratch))
  show(gate_8254(1653, 1942, 1265))
  show(gate_8254_score(1909, 1718, 3025))
  return seed % 86245
}
