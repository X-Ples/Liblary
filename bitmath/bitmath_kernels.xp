func row_804() -> [int] {
  return [1959, 2757, 603, 2012, 1909, 3139, 3488, 1058, 1462, 3707]
}

func row_804_at(i: int) -> int {
  let row = row_804()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_804_sum(limit: int) -> int {
  let row = row_804()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_804_best() -> int {
  let row = row_804()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


