func demo_blends(seed: int) -> int {
  let scratch = build_6036(seed % 61 + 6, seed % 91973)
  show(len(scratch))
  show(order_2565_find(scratch, 2896))
  show(build_6036_last(scratch))
  show(grid_698_rowsum(scratch, 2207, 2885, 2673))
  show(gate_534(3672, 1251, 123))
  return seed % 82955
}
