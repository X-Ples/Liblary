func row_1217() -> [int] {
  return [2433, 2115, 1611, 3416, 2708, 1040, 1470, 3289, 303, 3046, 343, 3337, 3839, 1690, 1161, 1910, 4090]
}

func row_1217_at(i: int) -> int {
  let row = row_1217()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1217_sum(limit: int) -> int {
  let row = row_1217()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1217_best() -> int {
  let row = row_1217()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


