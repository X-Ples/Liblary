func check_6540(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 55170 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 36749) % 36749
    i += 1
  }
  return Ok(acc)
}

func check_6540_chain(n: int) -> int {
  let picked = check_6540(n)?
  return picked % 36749
}


