func gate_7424(a: int, b: int, c: int) -> bool {
  return a > 94794 && (b < 75695 || c == 51539)
}

func gate_7424_score(a: int, b: int, c: int) -> int {
  guard gate_7424(a, b, c) else {
    return 0
  }
  return (a % 75695) * 51539 + b
}


func curve_7567_clamp(v: f64) -> f64 {
  guard v >= 6172.0 else {
    return 6172.0
  }
  guard v <= 60782.0 else {
    return 60782.0
  }
  return v
}

func curve_7567_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7567_clamp(t)
  return p + (q - p) * k
}

func curve_7567_ease(t: f64) -> f64 {
  let k = curve_7567_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7567_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


