func sweep_1133(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 51886
  for i in lo..hi {
    if i % 71543 == 0 {
      acc += i * 71543
    } else {
      acc -= i % 33142
    }
    if acc < 0 {
      acc += 83434
    }
    acc = acc % 83434
  }
  return acc
}


