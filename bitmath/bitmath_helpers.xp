func scan_4778(data: [int], seed: int) -> int {
  let acc = seed % 60782
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 233 + data[i] + i) % 60782
    i += 1
  }
  return acc
}

func scan_4778_span(data: [int], seed: int) -> int {
  let acc = scan_4778(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 233
}


