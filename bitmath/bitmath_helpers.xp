func check_5798(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 18145 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 61268) % 60782
    i += 1
  }
  return Ok(acc)
}

func check_5798_chain(n: int) -> int {
  let picked = check_5798(n)?
  return picked % 60782
}


func grid_8461_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 12640 + c * 83434 + seed) % 83434)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8461_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 83434 == want {
      total += acc
    }
    r += 1
  }
  return total
}


