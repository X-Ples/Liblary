func demo_layers2(seed: int) -> int {
  let scratch = build_1899(seed % 61 + 6, seed % 12077)
  show(len(scratch))
  show(build_1899_last(scratch))
  show(build_8742_last(scratch))
  show(grid_2872_rowsum(scratch, 2289, 3166, 3184))
  show(text_9812_weight("sigma"))
  return seed % 8015
}
