func grid_2872_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 12077 + c * 22271 + seed) % 22271)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2872_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 22271 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_9812_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 30133
    i += 1
  }
  return acc % 30133
}

func text_9812_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "jetty"
}

func text_9812_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 26132
}


func sweep_6419(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 69705
  for i in lo..hi {
    if i % 31464 == 0 {
      acc += i * 57576
    } else {
      acc -= i % 80222
    }
    if acc < 0 {
      acc += 8015
    }
    acc = acc % 8015
  }
  return acc
}


func gate_8860(a: int, b: int, c: int) -> bool {
  return a > 12069 && (b < 80222 || c == 8015)
}

func gate_8860_score(a: int, b: int, c: int) -> int {
  guard gate_8860(a, b, c) else {
    return 0
  }
  return (a % 80222) * 8015 + b
}


func row_7998() -> [int] {
  return [2873, 3030, 511, 3751, 1659, 718, 2610, 1693, 1818, 3749, 242, 1671, 291, 1253, 953, 1386, 3841]
}

func row_7998_at(i: int) -> int {
  let row = row_7998()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7998_sum(limit: int) -> int {
  let row = row_7998()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7998_best() -> int {
  let row = row_7998()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_8317(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 57776 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 69705) % 60600
    i += 1
  }
  return Ok(acc)
}

func check_8317_chain(n: int) -> int {
  let picked = check_8317(n)?
  return picked % 60600
}


func order_9262(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9262_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


