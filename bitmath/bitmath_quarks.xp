func demo_quarks(seed: int) -> int {
  let scratch = build_2459(seed % 61 + 6, seed % 57299)
  show(len(scratch))
  show(scan_7668(scratch, 2955))
  show(scan_7668_span(scratch, 1182))
  show(build_2459_last(scratch))
  show(check_4538_chain(864))
  show(check_1937_chain(70))
  return seed % 85772
}
