func scan_7668(data: [int], seed: int) -> int {
  let acc = seed % 47180
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 16133 + data[i] + i) % 47180
    i += 1
  }
  return acc
}

func scan_7668_span(data: [int], seed: int) -> int {
  let acc = scan_7668(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 16133
}


func build_2459(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 78804) % 85772)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 78804 + 74590) % 85772
    j += 1
  }
  return buf
}

func build_2459_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_4538(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 88946 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 85772) % 55707
    i += 1
  }
  return Ok(acc)
}

func check_4538_chain(n: int) -> int {
  let picked = check_4538(n)?
  return picked % 55707
}


func curve_1191_clamp(v: f64) -> f64 {
  guard v >= 6427.0 else {
    return 6427.0
  }
  guard v <= 88946.0 else {
    return 88946.0
  }
  return v
}

func curve_1191_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1191_clamp(t)
  return p + (q - p) * k
}

func curve_1191_ease(t: f64) -> f64 {
  let k = curve_1191_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1191_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


