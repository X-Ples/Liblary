}


func gate_1186(a: int, b: int, c: int) -> bool {
  return a > 57014 && (b < 32808 || c == 69449)
}

func gate_1186_score(a: int, b: int, c: int) -> int {
  guard gate_1186(a, b, c) else {
    return 0
  }
  return (a % 32808) * 69449 + b
}


