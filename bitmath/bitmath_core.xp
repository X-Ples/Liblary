const K0 = 99199
const K1 = 62962
const K2 = 91984
const K3 = 62335
const K4 = 95229
const K5 = 60986

func curve_1522_clamp(v: f64) -> f64 {
  guard v >= 89618.0 else {
    return 89618.0
  }
  guard v <= 99199.0 else {
    return 99199.0
  }
  return v
}

func curve_1522_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1522_clamp(t)
  return p + (q - p) * k
}

func curve_1522_ease(t: f64) -> f64 {
  let k = curve_1522_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1522_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_1711(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 13094 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 91984) % 75103
    i += 1
  }
  return Ok(acc)
}

func check_1711_chain(n: int) -> int {
  let picked = check_1711(n)?
  return picked % 75103
}


func sweep_9469(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 87459
  for i in lo..hi {
    if i % 57014 == 0 {
      acc += i * 95229
    } else {
      acc -= i % 32808
    }
    if acc < 0 {
      acc += 75103
    }
    acc = acc % 75103
  }
  return acc
}


func build_9527(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 91984) % 87459)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 91984 + 99199) % 87459
    j += 1
  }
  return buf
}

func build_9527_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_7658_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
