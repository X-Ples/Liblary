func scan_8055(data: [int], seed: int) -> int {
  let acc = seed % 60986
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 87459 + data[i] + i) % 60986
    i += 1
  }
  return acc
}

