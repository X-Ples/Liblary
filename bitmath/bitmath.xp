func scan_8159(data: [int], seed: int) -> int {
  let acc = seed % 94659
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 47201 + data[i] + i) % 94659
    i += 1
  }
  return acc
}

func scan_8159_span(data: [int], seed: int) -> int {
  let acc = scan_8159(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 47201
}


