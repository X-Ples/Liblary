func sweep_6742(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 4342
  for i in lo..hi {
    if i % 3415 == 0 {
      acc += i * 44402
    } else {
      acc -= i % 90331
    }
    if acc < 0 {
      acc += 60722
    }
    acc = acc % 60722
  }
  return acc
}


func bitmath_ping() -> int {
