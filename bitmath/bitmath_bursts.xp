func text_4411_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 81280
    i += 1
  }
  return acc % 81280
}

func text_4411_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
