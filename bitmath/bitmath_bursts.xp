func check_5639(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 69164 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 71475) % 40354
    i += 1
  }
  return Ok(acc)
}

func check_5639_chain(n: int) -> int {
  let picked = check_5639(n)?
  return picked % 40354
}


