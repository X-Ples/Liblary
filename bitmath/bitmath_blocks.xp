func check_8837(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 93076 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 40175) % 64604
    i += 1
  }
  return Ok(acc)
}

func check_8837_chain(n: int) -> int {
  let picked = check_8837(n)?
  return picked % 64604
}


