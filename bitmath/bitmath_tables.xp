func demo_tables(seed: int) -> int {
  let scratch = build_4704(seed % 61 + 6, seed % 51283)
  show(len(scratch))
  show(build_4704_last(scratch))
  show(check_6069_chain(1697))
  show(gate_1500(2080, 272, 3355))
  show(gate_1500_score(3173, 2466, 1281))
