func sweep_3179(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 21209
  for i in lo..hi {
    if i % 29951 == 0 {
      acc += i * 32553
    } else {
      acc -= i % 89178
    }
    if acc < 0 {
      acc += 13382
    }
    acc = acc % 13382
  }
  return acc
}


