func build_4704(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 12513) % 20401)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 12513 + 21209) % 20401
    j += 1
  }
  return buf
}

func build_4704_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_6069(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 93406 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 86662) % 21209
    i += 1
  }
  return Ok(acc)
}

func check_6069_chain(n: int) -> int {
  let picked = check_6069(n)?
  return picked % 21209
}


func gate_1500(a: int, b: int, c: int) -> bool {
  return a > 16775 && (b < 51283 || c == 35892)
}

func gate_1500_score(a: int, b: int, c: int) -> int {
  guard gate_1500(a, b, c) else {
    return 0
  }
  return (a % 51283) * 35892 + b
}


func text_3341_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 12513
    i += 1
  }
  return acc % 12513
}

func text_3341_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "nova"
}

func text_3341_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 29951
}


func curve_9364_clamp(v: f64) -> f64 {
  guard v >= 35331.0 else {
    return 35331.0
  }
  guard v <= 89178.0 else {
    return 89178.0
  }
  return v
}

func curve_9364_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9364_clamp(t)
  return p + (q - p) * k
}

func curve_9364_ease(t: f64) -> f64 {
  let k = curve_9364_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9364_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


