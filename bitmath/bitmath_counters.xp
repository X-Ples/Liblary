const K0 = 25853
const K1 = 96168
const K2 = 57501
const K3 = 10209
const K4 = 78996
const K5 = 96068
const K6 = 18891

func check_6815(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 69197 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 78996) % 96068
    i += 1
  }
  return Ok(acc)
}

func check_6815_chain(n: int) -> int {
  let picked = check_6815(n)?
  return picked % 96068
}


func build_1400(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 69809) % 25853)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 69809 + 24533) % 25853
    j += 1
  }
  return buf
}

func build_1400_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_2143_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 44043 + c * 62959 + seed) % 62959)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2143_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 62959 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_3338(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 98067
  for i in lo..hi {
    if i % 53605 == 0 {
      acc += i * 64903
    } else {
      acc -= i % 96068
    }
    if acc < 0 {
      acc += 10209
    }
    acc = acc % 10209
  }
  return acc
}


func order_9126(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9126_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_6275_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 61622
    i += 1
  }
  return acc % 61622
}

func text_6275_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "ion"
}

func text_6275_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 53605
}


