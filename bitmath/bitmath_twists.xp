func demo_twists(seed: int) -> int {
  let scratch = build_2003(seed % 61 + 6, seed % 67137)
  show(len(scratch))
  show(check_9238_chain(1948))
  show(sweep_4028(2828, 1685))
  show(scan_2757(scratch, 1239))
  show(scan_2757_span(scratch, 1048))
  return seed % 46018
}
