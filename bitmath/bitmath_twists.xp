func curve_9747_clamp(v: f64) -> f64 {
  guard v >= 40358.0 else {
    return 40358.0
  }
  guard v <= 82131.0 else {
    return 82131.0
  }
  return v
}

func curve_9747_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9747_clamp(t)
  return p + (q - p) * k
}

func curve_9747_ease(t: f64) -> f64 {
  let k = curve_9747_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9747_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


