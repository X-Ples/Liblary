func check_9238(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 64077 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 82131) % 82131
    i += 1
  }
  return Ok(acc)
}

func check_9238_chain(n: int) -> int {
  let picked = check_9238(n)?
  return picked % 82131
}


func sweep_4028(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 83478
  for i in lo..hi {
    if i % 59507 == 0 {
      acc += i * 47046
    } else {
      acc -= i % 46018
    }
    if acc < 0 {
      acc += 64077
    }
    acc = acc % 64077
  }
  return acc
}


func scan_2757(data: [int], seed: int) -> int {
  let acc = seed % 22620
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 14266 + data[i] + i) % 22620
    i += 1
  }
  return acc
}

func scan_2757_span(data: [int], seed: int) -> int {
  let acc = scan_2757(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 14266
}


func build_2003(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
