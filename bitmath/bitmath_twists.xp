func row_7898() -> [int] {
  return [3137, 3277, 290, 1381, 2127, 1487, 1336, 3982, 3024, 594, 1241, 3000, 3947, 2658, 2708, 2659, 3386, 1542, 655]
}

func row_7898_at(i: int) -> int {
  let row = row_7898()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7898_sum(limit: int) -> int {
  let row = row_7898()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7898_best() -> int {
  let row = row_7898()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


