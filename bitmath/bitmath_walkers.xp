func curve_2690_clamp(v: f64) -> f64 {
  guard v >= 1087.0 else {
    return 1087.0
  }
  guard v <= 68689.0 else {
    return 68689.0
  }
  return v
}

func curve_2690_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2690_clamp(t)
  return p + (q - p) * k
}

func curve_2690_ease(t: f64) -> f64 {
  let k = curve_2690_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2690_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_656(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 54752
  for i in lo..hi {
    if i % 86415 == 0 {
      acc += i * 54752
    } else {
      acc -= i % 68689
    }
    if acc < 0 {
      acc += 36469
    }
    acc = acc % 36469
  }
  return acc
}


