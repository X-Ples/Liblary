func check_8642(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 6678 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 68689) % 54752
    i += 1
  }
  return Ok(acc)
}

func check_8642_chain(n: int) -> int {
  let picked = check_8642(n)?
  return picked % 54752
}


