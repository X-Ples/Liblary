func text_9945_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 53486
    i += 1
  }
  return acc % 53486
}

func text_9945_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
