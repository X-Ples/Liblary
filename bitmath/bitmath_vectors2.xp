func scan_628(data: [int], seed: int) -> int {
  let acc = seed % 14464
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 87122 + data[i] + i) % 14464
    i += 1
  }
  return acc
}

func scan_628_span(data: [int], seed: int) -> int {
  let acc = scan_628(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 87122
}


