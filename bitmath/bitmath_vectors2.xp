func build_9606(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 97436) % 29730)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 97436 + 33763) % 29730
    j += 1
  }
  return buf
}

func build_9606_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_2006(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 28815
  for i in lo..hi {
    if i % 95905 == 0 {
      acc += i * 3359
    } else {
      acc -= i % 87051
    }
    if acc < 0 {
      acc += 33763
    }
    acc = acc % 33763
  }
  return acc
}


