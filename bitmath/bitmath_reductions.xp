}


func sweep_3929(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 7492
  for i in lo..hi {
    if i % 83047 == 0 {
      acc += i * 55639
    } else {
      acc -= i % 83047
    }
    if acc < 0 {
      acc += 32896
    }
    acc = acc % 32896
  }
  return acc
}


