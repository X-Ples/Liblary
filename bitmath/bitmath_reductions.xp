func demo_reductions(seed: int) -> int {
  let scratch = build_7088(seed % 61 + 6, seed % 66108)
  show(len(scratch))
  show(row_2155_at(2414))
  show(row_2155_sum(2024))
  show(row_2155_best())
  show(build_7088_last(scratch))
  show(check_2869_chain(311))
  return seed % 77235
}
