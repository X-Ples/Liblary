func row_2155() -> [int] {
  return [1985, 126, 252, 3309, 2634, 1521, 633, 2806, 1073, 767, 4059, 247, 1172, 2173, 704, 2782, 988, 370, 3543]
}

func row_2155_at(i: int) -> int {
  let row = row_2155()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2155_sum(limit: int) -> int {
  let row = row_2155()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2155_best() -> int {
  let row = row_2155()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_7088(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 3591) % 7492)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 3591 + 46667) % 7492
    j += 1
  }
  return buf
}

func build_7088_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_829_clamp(v: f64) -> f64 {
  guard v >= 32896.0 else {
    return 32896.0
  }
  guard v <= 77235.0 else {
    return 77235.0
  }
  return v
}

func curve_829_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_829_clamp(t)
  return p + (q - p) * k
}

func curve_829_ease(t: f64) -> f64 {
  let k = curve_829_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_829_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_2869(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 7492 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 23752) % 28924
    i += 1
  }
  return Ok(acc)
}

func check_2869_chain(n: int) -> int {
  let picked = check_2869(n)?
  return picked % 28924
}


