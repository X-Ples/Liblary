func build_2368(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 92380) % 25892)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 92380 + 28905) % 25892
    j += 1
  }
  return buf
}

func build_2368_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_2609(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 34512 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 92209) % 29281
    i += 1
  }
  return Ok(acc)
}

func check_2609_chain(n: int) -> int {
  let picked = check_2609(n)?
  return picked % 29281
}


func curve_6384_clamp(v: f64) -> f64 {
  guard v >= 73170.0 else {
    return 73170.0
  }
  guard v <= 93050.0 else {
    return 93050.0
  }
  return v
}

func curve_6384_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6384_clamp(t)
  return p + (q - p) * k
}

func curve_6384_ease(t: f64) -> f64 {
  let k = curve_6384_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6384_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_4165(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 28905
  for i in lo..hi {
    if i % 54156 == 0 {
      acc += i * 54384
    } else {
      acc -= i % 92209
    }
    if acc < 0 {
      acc += 28905
    }
    acc = acc % 28905
  }
  return acc
}


