func row_5322() -> [int] {
  return [2740, 2254, 1245, 837, 1078, 1252, 2779, 1345, 3679, 3138, 376, 1688, 280, 239, 3865, 3506, 3676, 3294, 542, 779, 884]
}

func row_5322_at(i: int) -> int {
  let row = row_5322()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5322_sum(limit: int) -> int {
  let row = row_5322()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5322_best() -> int {
  let row = row_5322()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


