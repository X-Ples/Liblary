func demo_ranges(seed: int) -> int {
  let scratch = build_4623(seed % 61 + 6, seed % 85683)
  show(len(scratch))
  show(build_4623_last(scratch))
  show(scan_1824(scratch, 2463))
  show(scan_1824_span(scratch, 1397))
  return seed % 52388
}
