func text_4756_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 35463
    i += 1
  }
  return acc % 35463
}

func text_4756_label(idx: int) -> str {
