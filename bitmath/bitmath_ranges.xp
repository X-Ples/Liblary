}


func gate_7864(a: int, b: int, c: int) -> bool {
  return a > 73162 && (b < 84802 || c == 77899)
}

func gate_7864_score(a: int, b: int, c: int) -> int {
  guard gate_7864(a, b, c) else {
    return 0
  }
  return (a % 84802) * 77899 + b
}


func curve_4795_clamp(v: f64) -> f64 {
  guard v >= 54899.0 else {
    return 54899.0
  }
  guard v <= 76261.0 else {
    return 76261.0
  }
  return v
}

func curve_4795_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4795_clamp(t)
  return p + (q - p) * k
}

func curve_4795_ease(t: f64) -> f64 {
  let k = curve_4795_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4795_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


