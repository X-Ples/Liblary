func build_4623(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 78421) % 55583)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 78421 + 60416) % 55583
    j += 1
  }
  return buf
}

func build_4623_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_1824(data: [int], seed: int) -> int {
  let acc = seed % 86652
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 82902 + data[i] + i) % 86652
    i += 1
  }
  return acc
}

func scan_1824_span(data: [int], seed: int) -> int {
  let acc = scan_1824(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 82902
}


