  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 64462 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_6158_clamp(v: f64) -> f64 {
  guard v >= 61134.0 else {
    return 61134.0
  }
  guard v <= 93232.0 else {
    return 93232.0
  }
  return v
}

func curve_6158_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6158_clamp(t)
  return p + (q - p) * k
}

func curve_6158_ease(t: f64) -> f64 {
  let k = curve_6158_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6158_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_657(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 79345 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 64198) % 64986
    i += 1
  }
  return Ok(acc)
}

func check_657_chain(n: int) -> int {
  let picked = check_657(n)?
  return picked % 64986
}


