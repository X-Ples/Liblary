    let c = 0
    while c < cols {
      array_push(cells, (r * 61134 + c * 64462 + seed) % 64462)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2309_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
