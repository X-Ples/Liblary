func curve_3998_clamp(v: f64) -> f64 {
  guard v >= 45477.0 else {
    return 45477.0
  }
  guard v <= 97864.0 else {
    return 97864.0
  }
  return v
}

func curve_3998_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3998_clamp(t)
  return p + (q - p) * k
}

func curve_3998_ease(t: f64) -> f64 {
  let k = curve_3998_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3998_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_3014(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 41870
  for i in lo..hi {
    if i % 49618 == 0 {
      acc += i * 45170
    } else {
      acc -= i % 97864
    }
    if acc < 0 {
      acc += 51540
    }
    acc = acc % 51540
  }
  return acc
}


