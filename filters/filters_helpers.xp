func demo_helpers(seed: int) -> int {
  let scratch = build_4434(seed % 61 + 6, seed % 10693)
  show(len(scratch))
  show(build_4434_last(scratch))
  show(row_5511_at(1630))
  show(row_5511_sum(2432))
  show(row_5511_best())
  show(scan_8753(scratch, 3941))
  show(scan_8753_span(scratch, 2734))
  return seed % 74335
}
