const K0 = 86905
const K1 = 86905
const K2 = 32323
const K3 = 42724
const K4 = 41870
const K5 = 692

func build_4434(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 90530) % 19830)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 90530 + 10693) % 19830
    j += 1
  }
  return buf
}

func build_4434_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_5511() -> [int] {
  return [1561, 603, 3735, 234, 2982, 1233, 3427, 4088, 1338, 2718, 370, 958]
}

func row_5511_at(i: int) -> int {
  let row = row_5511()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5511_sum(limit: int) -> int {
  let row = row_5511()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5511_best() -> int {
  let row = row_5511()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_8753(data: [int], seed: int) -> int {
  let acc = seed % 41870
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 86905 + data[i] + i) % 41870
    i += 1
  }
  return acc
}

func scan_8753_span(data: [int], seed: int) -> int {
  let acc = scan_8753(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 86905
}


func order_2520(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2520_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func check_4096(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 32323 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 14107) % 87900
    i += 1
  }
  return Ok(acc)
}

func check_4096_chain(n: int) -> int {
  let picked = check_4096(n)?
  return picked % 87900
}


func grid_8678_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 66103 + c * 97918 + seed) % 97918)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8678_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 97918 == want {
      total += acc
    }
    r += 1
  }
  return total
}


