func gate_1331(a: int, b: int, c: int) -> bool {
  return a > 35103 && (b < 86069 || c == 65875)
}

func gate_1331_score(a: int, b: int, c: int) -> int {
  guard gate_1331(a, b, c) else {
    return 0
  }
  return (a % 86069) * 65875 + b
}


func text_6439_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 35103
    i += 1
  }
  return acc % 35103
}

func text_6439_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "delta"
}

func text_6439_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 86069
}


