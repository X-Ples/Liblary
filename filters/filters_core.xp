func sweep_6885(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 62196
  for i in lo..hi {
    if i % 48793 == 0 {
      acc += i * 61920
    } else {
      acc -= i % 66330
    }
    if acc < 0 {
      acc += 22440
    }
    acc = acc % 22440
  }
  return acc
}


func order_223(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_223_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func demo_core(seed: int) -> int {
  let scratch = build_5286(seed % 61 + 6, seed % 11414)
  show(len(scratch))
  show(build_5286_last(scratch))
  show(check_5459_chain(3319))
  show(row_668_at(2977))
  return seed % 62196
}
