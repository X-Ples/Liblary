func build_5286(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 67563) % 85381)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 67563 + 48793) % 85381
    j += 1
  }
  return buf
}

func build_5286_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_5459(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 86069 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 48399) % 35103
    i += 1
  }
  return Ok(acc)
}

func check_5459_chain(n: int) -> int {
  let picked = check_5459(n)?
  return picked % 35103
}


func curve_7938_clamp(v: f64) -> f64 {
  guard v >= 22440.0 else {
    return 22440.0
  }
  guard v <= 61920.0 else {
    return 61920.0
  }
  return v
}

func curve_7938_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7938_clamp(t)
  return p + (q - p) * k
}

func curve_7938_ease(t: f64) -> f64 {
  let k = curve_7938_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7938_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


