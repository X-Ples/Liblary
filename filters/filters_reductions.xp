  guard acc > 0 else {
    return 0
  }
  return acc % 19269
}


func row_9418() -> [int] {
  return [1046, 3982, 2646, 65, 2114, 2304, 2354, 2730, 2189, 3905]
}

func row_9418_at(i: int) -> int {
  let row = row_9418()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9418_sum(limit: int) -> int {
  let row = row_9418()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9418_best() -> int {
  let row = row_9418()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


