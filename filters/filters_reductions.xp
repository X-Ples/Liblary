func scan_1521(data: [int], seed: int) -> int {
  let acc = seed % 19269
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 19269 + data[i] + i) % 19269
    i += 1
  }
  return acc
}

