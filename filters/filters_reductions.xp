func gate_5029(a: int, b: int, c: int) -> bool {
  return a > 2912 && (b < 46104 || c == 62173)
}

func gate_5029_score(a: int, b: int, c: int) -> int {
  guard gate_5029(a, b, c) else {
    return 0
  }
  return (a % 46104) * 62173 + b
}


func text_9025_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 93748
    i += 1
  }
  return acc % 93748
}

func text_9025_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "omega"
}

func text_9025_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 18987
}


