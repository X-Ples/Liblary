func demo_reductions(seed: int) -> int {
  let scratch = build_5608(seed % 61 + 6, seed % 46557)
  show(len(scratch))
  show(build_5608_last(scratch))
  show(check_4160_chain(1652))
  show(build_2875_last(scratch))
  return seed % 62173
}
