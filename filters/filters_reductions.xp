func sweep_1046(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 44276
  for i in lo..hi {
    if i % 93748 == 0 {
      acc += i * 54100
    } else {
      acc -= i % 24279
    }
    if acc < 0 {
      acc += 21957
    }
    acc = acc % 21957
  }
  return acc
}


