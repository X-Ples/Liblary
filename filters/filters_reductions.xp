func build_5608(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 18987) % 44276)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 18987 + 16412) % 44276
    j += 1
  }
  return buf
}

func build_5608_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_1372_clamp(v: f64) -> f64 {
  guard v >= 44276.0 else {
    return 44276.0
  }
  guard v <= 81203.0 else {
    return 81203.0
  }
  return v
}

func curve_1372_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1372_clamp(t)
  return p + (q - p) * k
}

func curve_1372_ease(t: f64) -> f64 {
  let k = curve_1372_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1372_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_4160(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 46557 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 21957) % 86881
    i += 1
  }
  return Ok(acc)
}

func check_4160_chain(n: int) -> int {
  let picked = check_4160(n)?
  return picked % 86881
}


