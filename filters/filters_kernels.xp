func gate_2693(a: int, b: int, c: int) -> bool {
  return a > 85989 && (b < 44344 || c == 52337)
}

func gate_2693_score(a: int, b: int, c: int) -> int {
  guard gate_2693(a, b, c) else {
    return 0
  }
  return (a % 44344) * 52337 + b
}


func check_6150(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 60600 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 44344) % 13233
    i += 1
  }
  return Ok(acc)
}

func check_6150_chain(n: int) -> int {
  let picked = check_6150(n)?
  return picked % 13233
}


func scan_7194(data: [int], seed: int) -> int {
  let acc = seed % 53926
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 25590 + data[i] + i) % 53926
    i += 1
  }
  return acc
}

func scan_7194_span(data: [int], seed: int) -> int {
  let acc = scan_7194(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 25590
}


