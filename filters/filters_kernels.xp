func demo_kernels(seed: int) -> int {
  let scratch = build_4254(seed % 61 + 6, seed % 84408)
  show(len(scratch))
  show(build_4254_last(scratch))
  show(order_9410_find(scratch, 3004))
  show(order_4645_find(scratch, 3259))
  show(build_4796_last(scratch))
  return seed % 61049
}
