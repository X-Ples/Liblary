func sweep_9204(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 38967
  for i in lo..hi {
    if i % 37777 == 0 {
      acc += i * 53205
    } else {
      acc -= i % 60600
    }
    if acc < 0 {
      acc += 90384
    }
    acc = acc % 90384
  }
  return acc
}


