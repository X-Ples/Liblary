func text_1061_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 85989
    i += 1
  }
  return acc % 85989
}

func text_1061_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ridge"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "nova"
}

func text_1061_has(tag: str) -> bool {
  return str_contains(tag, "ridge") || len(tag) > 52337
}


