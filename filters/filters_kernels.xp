func row_1728() -> [int] {
  return [2678, 1426, 324, 952, 806, 1662, 631, 175, 3290, 119, 2721, 911, 709, 249, 1579, 1536, 1641, 1344, 575, 2277]
}

func row_1728_at(i: int) -> int {
  let row = row_1728()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1728_sum(limit: int) -> int {
  let row = row_1728()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1728_best() -> int {
  let row = row_1728()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


