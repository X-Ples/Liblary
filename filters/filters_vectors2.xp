func row_4745() -> [int] {
  return [3246, 2061, 2234, 3325, 1459, 2140, 3060, 1694, 984, 2710, 2510, 1882, 3027]
}

func row_4745_at(i: int) -> int {
  let row = row_4745()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4745_sum(limit: int) -> int {
  let row = row_4745()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4745_best() -> int {
  let row = row_4745()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_8125(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 56421) % 57857)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 56421 + 48507) % 57857
    j += 1
  }
  return buf
}

func build_8125_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_6114_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 50374
    i += 1
  }
  return acc % 50374
}

func text_6114_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "ridge"
}

func text_6114_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 90857
}


func curve_3536_clamp(v: f64) -> f64 {
  guard v >= 90097.0 else {
    return 90097.0
  }
  guard v <= 90097.0 else {
    return 90097.0
  }
  return v
}

func curve_3536_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3536_clamp(t)
  return p + (q - p) * k
}

func curve_3536_ease(t: f64) -> f64 {
  let k = curve_3536_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3536_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


