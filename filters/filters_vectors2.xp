func sweep_2967(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 48507
  for i in lo..hi {
    if i % 27275 == 0 {
      acc += i * 24097
    } else {
      acc -= i % 56421
    }
    if acc < 0 {
      acc += 29893
    }
    acc = acc % 29893
  }
  return acc
}


func demo_vectors2(seed: int) -> int {
  let scratch = build_8125(seed % 61 + 6, seed % 4342)
  show(len(scratch))
  show(row_4745_at(1474))
  show(row_4745_sum(3882))
  show(row_4745_best())
  return seed % 56421
}
