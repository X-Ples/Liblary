func curve_538_clamp(v: f64) -> f64 {
  guard v >= 25951.0 else {
    return 25951.0
  }
  guard v <= 64720.0 else {
    return 64720.0
  }
  return v
}

func curve_538_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_538_clamp(t)
  return p + (q - p) * k
}

func curve_538_ease(t: f64) -> f64 {
  let k = curve_538_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_538_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_3883(data: [int], seed: int) -> int {
  let acc = seed % 85214
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 87052 + data[i] + i) % 85214
    i += 1
  }
  return acc
}

func scan_3883_span(data: [int], seed: int) -> int {
  let acc = scan_3883(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 87052
}


func grid_8506_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 26487 + c * 24097 + seed) % 24097)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8506_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 24097 == want {
      total += acc
    }
    r += 1
  }
  return total
}


