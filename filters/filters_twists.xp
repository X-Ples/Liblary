func build_6955(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 34395) % 40638)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 34395 + 97828) % 40638
    j += 1
  }
  return buf
}

func build_6955_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_124(a: int, b: int, c: int) -> bool {
  return a > 93253 && (b < 59886 || c == 32679)
}

func gate_124_score(a: int, b: int, c: int) -> int {
  guard gate_124(a, b, c) else {
    return 0
  }
  return (a % 59886) * 32679 + b
}


func order_9961(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9961_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func check_5698(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 89973 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 12286) % 51163
    i += 1
  }
  return Ok(acc)
}

func check_5698_chain(n: int) -> int {
  let picked = check_5698(n)?
  return picked % 51163
}


