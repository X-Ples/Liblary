func sweep_8908(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 40638
  for i in lo..hi {
    if i % 12286 == 0 {
      acc += i * 44547
    } else {
      acc -= i % 99712
    }
    if acc < 0 {
      acc += 12286
    }
    acc = acc % 12286
  }
  return acc
}


