func row_2096() -> [int] {
  return [1777, 749, 4067, 2319, 804, 2328, 2485, 594, 476, 3106, 1002, 1445, 3061, 1912, 3593, 904, 3420, 2269, 1274]
}

func row_2096_at(i: int) -> int {
  let row = row_2096()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2096_sum(limit: int) -> int {
  let row = row_2096()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2096_best() -> int {
  let row = row_2096()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


