func demo_twists(seed: int) -> int {
  let scratch = build_6955(seed % 61 + 6, seed % 12286)
  show(len(scratch))
  show(build_6955_last(scratch))
  show(gate_124(3913, 190, 1430))
  show(gate_124_score(3925, 3064, 522))
  show(order_9961_find(scratch, 1985))
  return seed % 51163
}
