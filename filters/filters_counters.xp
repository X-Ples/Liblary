func sweep_9229(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 28910
  for i in lo..hi {
    if i % 28083 == 0 {
      acc += i * 18306
    } else {
      acc -= i % 94501
    }
    if acc < 0 {
      acc += 90001
    }
    acc = acc % 90001
  }
  return acc
}


func check_5067(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 92860 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 11226) % 33789
    i += 1
  }
  return Ok(acc)
}

func check_5067_chain(n: int) -> int {
  let picked = check_5067(n)?
  return picked % 33789
}


