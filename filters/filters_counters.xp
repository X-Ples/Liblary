func text_4361_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "harbor"
}

func text_4361_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 79538
}


