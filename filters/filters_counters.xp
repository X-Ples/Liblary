func gate_5307(a: int, b: int, c: int) -> bool {
  return a > 91649 && (b < 60200 || c == 91649)
}

func gate_5307_score(a: int, b: int, c: int) -> int {
  guard gate_5307(a, b, c) else {
    return 0
  }
  return (a % 60200) * 91649 + b
}


func grid_3750_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 18306 + c * 60334 + seed) % 60334)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3750_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 60334 == want {
      total += acc
    }
    r += 1
  }
  return total
}


