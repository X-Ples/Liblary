func demo_counters(seed: int) -> int {
  let scratch = build_4070(seed % 61 + 6, seed % 33789)
  show(len(scratch))
  show(gate_5307(3920, 2799, 2766))
  show(gate_5307_score(3607, 3530, 2989))
  show(grid_3750_rowsum(scratch, 2771, 3151, 56))
  return seed % 55780
}
