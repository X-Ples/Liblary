func build_9946(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 27984) % 74125)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 27984 + 18290) % 74125
    j += 1
  }
  return buf
}

func build_9946_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_2153_clamp(v: f64) -> f64 {
  guard v >= 28954.0 else {
    return 28954.0
  }
  guard v <= 37690.0 else {
    return 37690.0
  }
  return v
}

func curve_2153_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2153_clamp(t)
  return p + (q - p) * k
}

func curve_2153_ease(t: f64) -> f64 {
  let k = curve_2153_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2153_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_5701(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 52529 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 2234) % 49904
    i += 1
  }
  return Ok(acc)
}

func check_5701_chain(n: int) -> int {
  let picked = check_5701(n)?
  return picked % 49904
}


func sweep_9477(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 74125
  for i in lo..hi {
    if i % 16416 == 0 {
      acc += i * 18290
    } else {
      acc -= i % 2658
    }
    if acc < 0 {
      acc += 4715
    }
    acc = acc % 4715
  }
  return acc
}


func sweep_7677(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 52529
  for i in lo..hi {
    if i % 19644 == 0 {
      acc += i * 17300
    } else {
      acc -= i % 58179
    }
    if acc < 0 {
      acc += 31749
    }
    acc = acc % 31749
  }
  return acc
}


func text_2990_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 52833
    i += 1
  }
  return acc % 52833
}

func text_2990_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "sigma"
  }
  return "ion"
}

func text_2990_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 37690
}


