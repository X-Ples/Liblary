func demo_quarks(seed: int) -> int {
  let scratch = build_9946(seed % 61 + 6, seed % 53)
  show(len(scratch))
  show(build_9946_last(scratch))
  show(check_5701_chain(2675))
  show(sweep_9477(671, 1760))
  show(sweep_7677(254, 3608))
  return seed % 87085
}
