func demo_ranges(seed: int) -> int {
  let scratch = build_1936(seed % 61 + 6, seed % 86728)
  show(len(scratch))
  show(build_1936_last(scratch))
  show(build_6098_last(scratch))
  show(scan_1178(scratch, 2002))
  show(scan_1178_span(scratch, 21))
  return seed % 51252
}
