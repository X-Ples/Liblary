func build_1936(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 86300) % 86300)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 86300 + 21384) % 86300
    j += 1
  }
  return buf
}

func build_1936_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_155_clamp(v: f64) -> f64 {
  guard v >= 31119.0 else {
    return 31119.0
  }
  guard v <= 36179.0 else {
    return 36179.0
  }
  return v
}

func curve_155_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_155_clamp(t)
  return p + (q - p) * k
}

func curve_155_ease(t: f64) -> f64 {
  let k = curve_155_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_155_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


