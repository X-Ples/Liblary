func scan_1178(data: [int], seed: int) -> int {
  let acc = seed % 31119
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 51252 + data[i] + i) % 31119
    i += 1
  }
  return acc
}

func scan_1178_span(data: [int], seed: int) -> int {
  let acc = scan_1178(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 51252
}


func row_4311() -> [int] {
  return [3762, 758, 761, 832, 1039, 335, 1844, 3500, 4007, 1985]
}

func row_4311_at(i: int) -> int {
  let row = row_4311()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4311_sum(limit: int) -> int {
  let row = row_4311()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4311_best() -> int {
  let row = row_4311()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_8289(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 36179 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 84769) % 58792
    i += 1
  }
  return Ok(acc)
}

func check_8289_chain(n: int) -> int {
  let picked = check_8289(n)?
  return picked % 58792
}


func text_1584_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 89624
    i += 1
  }
  return acc % 89624
}

func text_1584_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "kilo"
}

func text_1584_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 89895
}


func sweep_8501(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 1913
  for i in lo..hi {
    if i % 640 == 0 {
      acc += i * 46393
    } else {
      acc -= i % 1913
    }
    if acc < 0 {
      acc += 21384
    }
    acc = acc % 21384
  }
  return acc
}


