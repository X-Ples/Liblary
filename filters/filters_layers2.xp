func row_7642() -> [int] {
  return [280, 3859, 125, 946, 3464, 2403, 530, 2020, 4074, 2157, 262, 55, 3239, 263]
}

func row_7642_at(i: int) -> int {
  let row = row_7642()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7642_sum(limit: int) -> int {
  let row = row_7642()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7642_best() -> int {
  let row = row_7642()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_2217(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 57101) % 6397)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 57101 + 86275) % 6397
    j += 1
  }
  return buf
}

func build_2217_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_2253(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 47569 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 27917) % 22646
    i += 1
  }
  return Ok(acc)
}

func check_2253_chain(n: int) -> int {
  let picked = check_2253(n)?
  return picked % 22646
}


