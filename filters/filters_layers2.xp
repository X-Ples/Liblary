func curve_2276_clamp(v: f64) -> f64 {
  guard v >= 9396.0 else {
    return 9396.0
  }
  guard v <= 55831.0 else {
    return 55831.0
  }
  return v
}

func curve_2276_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2276_clamp(t)
  return p + (q - p) * k
}

func curve_2276_ease(t: f64) -> f64 {
  let k = curve_2276_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2276_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_2450(a: int, b: int, c: int) -> bool {
  return a > 6397 && (b < 78238 || c == 14208)
}

func gate_2450_score(a: int, b: int, c: int) -> int {
  guard gate_2450(a, b, c) else {
    return 0
  }
  return (a % 78238) * 14208 + b
}


