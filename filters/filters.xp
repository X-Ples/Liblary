func sweep_1674(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 98582
  for i in lo..hi {
    if i % 92955 == 0 {
      acc += i * 96588
    } else {
      acc -= i % 84168
    }
    if acc < 0 {
      acc += 76736
    }
    acc = acc % 76736
  }
  return acc
}


