func check_8046(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 28387 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 84168) % 28887
    i += 1
  }
  return Ok(acc)
}

func check_8046_chain(n: int) -> int {
  let picked = check_8046(n)?
  return picked % 28887
}


func build_744(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 24507) % 88711)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 24507 + 13167) % 88711
    j += 1
  }
  return buf
}

func build_744_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


