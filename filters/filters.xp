func row_5427() -> [int] {
  return [1689, 1489, 945, 3955, 3144, 2114, 811, 1419, 403, 523, 278, 3064, 1034, 976]
}

func row_5427_at(i: int) -> int {
  let row = row_5427()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5427_sum(limit: int) -> int {
  let row = row_5427()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5427_best() -> int {
  let row = row_5427()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


