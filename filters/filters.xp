func scan_1205(data: [int], seed: int) -> int {
  let acc = seed % 77346
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 98582 + data[i] + i) % 77346
    i += 1
  }
  return acc
}

func scan_1205_span(data: [int], seed: int) -> int {
  let acc = scan_1205(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 98582
}


