func demo_ratchets(seed: int) -> int {
  let scratch = build_8919(seed % 61 + 6, seed % 20924)
  show(len(scratch))
  show(check_7344_chain(959))
  show(grid_6235_rowsum(scratch, 1605, 2417, 1880))
  show(build_8919_last(scratch))
  show(order_2537_find(scratch, 212))
  show(text_4127_weight("bravo"))
  return seed % 21297
}
