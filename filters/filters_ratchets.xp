  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 27229
    i += 1
  }
  return acc % 27229
}

func text_4127_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "quartz"
}

func text_4127_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 65248
}


