func demo_walkers(seed: int) -> int {
  let scratch = build_2681(seed % 61 + 6, seed % 90183)
  show(len(scratch))
  show(build_2681_last(scratch))
  show(check_2438_chain(3339))
  show(grid_5305_rowsum(scratch, 626, 3494, 192))
  show(gate_2676(2768, 3008, 3258))
  show(gate_2676_score(3993, 2475, 2749))
  return seed % 19895
}
