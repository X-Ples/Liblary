func text_4177_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 81901
    i += 1
  }
  return acc % 81901
}

func text_4177_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "bravo"
}

func text_4177_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 97489
}


