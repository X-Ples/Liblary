func build_2681(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 84130) % 19895)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 84130 + 97489) % 19895
    j += 1
  }
  return buf
}

func build_2681_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_2438(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 93829 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 51840) % 95967
    i += 1
  }
  return Ok(acc)
}

func check_2438_chain(n: int) -> int {
  let picked = check_2438(n)?
  return picked % 95967
}


func grid_5305_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 13882 + c * 95967 + seed) % 95967)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5305_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 95967 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_2676(a: int, b: int, c: int) -> bool {
  return a > 88000 && (b < 84130 || c == 51840)
}

func gate_2676_score(a: int, b: int, c: int) -> int {
  guard gate_2676(a, b, c) else {
    return 0
  }
  return (a % 84130) * 51840 + b
}


