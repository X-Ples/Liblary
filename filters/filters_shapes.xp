func sweep_6025(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 88855
  for i in lo..hi {
    if i % 25176 == 0 {
      acc += i * 29820
    } else {
      acc -= i % 81117
    }
    if acc < 0 {
      acc += 88855
    }
    acc = acc % 88855
  }
  return acc
}


