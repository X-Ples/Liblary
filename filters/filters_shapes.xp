func scan_4709(data: [int], seed: int) -> int {
  let acc = seed % 25905
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 88855 + data[i] + i) % 25905
    i += 1
