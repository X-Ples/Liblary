func demo_shapes(seed: int) -> int {
  let scratch = build_6098(seed % 61 + 6, seed % 25905)
  show(len(scratch))
  show(build_6098_last(scratch))
  show(row_3486_at(1751))
  show(row_3486_sum(3142))
