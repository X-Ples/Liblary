func build_6098(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 22945) % 41051)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 22945 + 93208) % 41051
    j += 1
  }
  return buf
}

func build_6098_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_3486() -> [int] {
  return [120, 2480, 318, 222, 466, 3102, 1724, 1986, 3160, 356, 2957, 46, 878, 2960, 249, 1467, 2850]
}

func row_3486_at(i: int) -> int {
  let row = row_3486()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3486_sum(limit: int) -> int {
  let row = row_3486()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3486_best() -> int {
  let row = row_3486()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


