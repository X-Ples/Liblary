}

func text_7334_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 89485
}


func curve_9903_clamp(v: f64) -> f64 {
  guard v >= 7160.0 else {
    return 7160.0
  }
  guard v <= 25905.0 else {
    return 25905.0
  }
  return v
}

func curve_9903_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9903_clamp(t)
  return p + (q - p) * k
}

func curve_9903_ease(t: f64) -> f64 {
  let k = curve_9903_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9903_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_2008(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 99016 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 38310) % 53488
    i += 1
  }
  return Ok(acc)
}

func check_2008_chain(n: int) -> int {
  let picked = check_2008(n)?
  return picked % 53488
}


func grid_8426_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 25905 + c * 69273 + seed) % 69273)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8426_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 69273 == want {
      total += acc
    }
    r += 1
  }
  return total
}


