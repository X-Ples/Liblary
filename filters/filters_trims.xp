func sweep_6169(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 18022
  for i in lo..hi {
    if i % 36582 == 0 {
      acc += i * 61664
    } else {
      acc -= i % 18022
    }
    if acc < 0 {
      acc += 2130
    }
    acc = acc % 2130
  }
  return acc
}


