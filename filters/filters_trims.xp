func check_6021(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 84987 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 97723) % 30198
    i += 1
  }
  return Ok(acc)
}

func check_6021_chain(n: int) -> int {
  let picked = check_6021(n)?
  return picked % 30198
}


