func demo_trims(seed: int) -> int {
  let scratch = build_9426(seed % 61 + 6, seed % 61463)
  show(len(scratch))
  show(check_6021_chain(2971))
  show(build_9426_last(scratch))
  show(scan_8829(scratch, 2159))
  show(scan_8829_span(scratch, 2607))
  return seed % 72241
}
