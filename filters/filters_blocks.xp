const K5 = 92157

func build_9639(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 85846) % 59095)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 85846 + 92157) % 59095
    j += 1
  }
  return buf
}

func build_9639_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_3913(data: [int], seed: int) -> int {
  let acc = seed % 74375
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 9054 + data[i] + i) % 74375
    i += 1
  }
  return acc
}

func scan_3913_span(data: [int], seed: int) -> int {
  let acc = scan_3913(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 9054
}


func sweep_1596(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 74375
  for i in lo..hi {
    if i % 96041 == 0 {
      acc += i * 74845
    } else {
      acc -= i % 84923
    }
    if acc < 0 {
      acc += 92157
    }
    acc = acc % 92157
  }
  return acc
}


