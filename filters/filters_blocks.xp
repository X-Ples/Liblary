func text_6554_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 78373
    i += 1
  }
  return acc % 78373
}

func text_6554_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "bravo"
}

func text_6554_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 68692
}


func curve_2695_clamp(v: f64) -> f64 {
  guard v >= 1501.0 else {
    return 1501.0
  }
  guard v <= 15258.0 else {
    return 15258.0
  }
  return v
}

func curve_2695_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2695_clamp(t)
  return p + (q - p) * k
}

func curve_2695_ease(t: f64) -> f64 {
  let k = curve_2695_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2695_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


