func demo_blocks(seed: int) -> int {
  let scratch = build_9639(seed % 61 + 6, seed % 27113)
  show(len(scratch))
  show(build_9639_last(scratch))
  show(scan_3913(scratch, 1950))
  show(scan_3913_span(scratch, 1994))
  show(sweep_1596(1644, 3360))
  return seed % 15258
}
