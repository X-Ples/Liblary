func sweep_6115(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10791
  for i in lo..hi {
    if i % 51616 == 0 {
      acc += i * 22607
    } else {
      acc -= i % 24310
    }
    if acc < 0 {
      acc += 13348
    }
    acc = acc % 13348
  }
  return acc
}


func build_9311(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 16372) % 38)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 16372 + 38) % 38
    j += 1
  }
  return buf
}

func build_9311_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_2497(lo: int, hi: int) -> int {
