func check_762(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 10791 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 26903) % 10354
    i += 1
  }
  return Ok(acc)
}

func check_762_chain(n: int) -> int {
  let picked = check_762(n)?
  return picked % 10354
}


