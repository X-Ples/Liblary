func build_4356(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 25581) % 52499)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 25581 + 76625) % 52499
    j += 1
  }
  return buf
}

func build_4356_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_4368(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4368_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func scan_3947(data: [int], seed: int) -> int {
  let acc = seed % 43561
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 642 + data[i] + i) % 43561
    i += 1
  }
  return acc
}

func scan_3947_span(data: [int], seed: int) -> int {
  let acc = scan_3947(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 642
}


func gate_846(a: int, b: int, c: int) -> bool {
  return a > 57557 && (b < 40866 || c == 43561)
}

func gate_846_score(a: int, b: int, c: int) -> int {
  guard gate_846(a, b, c) else {
    return 0
  }
  return (a % 40866) * 43561 + b
}


func text_9257_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 642
    i += 1
  }
  return acc % 642
}

func text_9257_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "jetty"
}

func text_9257_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 47706
}


