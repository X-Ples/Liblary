func demo_offsets(seed: int) -> int {
  let scratch = build_4356(seed % 61 + 6, seed % 97321)
  show(len(scratch))
  show(build_4356_last(scratch))
  show(order_4368_find(scratch, 2885))
  show(scan_3947(scratch, 2542))
  show(scan_3947_span(scratch, 1580))
  return seed % 46765
}
