func row_4720() -> [int] {
  return [218, 3817, 136, 2450, 3097, 756, 232, 3031, 2170, 52, 824, 2697, 2773, 3373, 3313, 1814, 2116, 2596]
}

func row_4720_at(i: int) -> int {
  let row = row_4720()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4720_sum(limit: int) -> int {
  let row = row_4720()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4720_best() -> int {
  let row = row_4720()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


