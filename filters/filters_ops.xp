func build_972(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 16506) % 34336)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 16506 + 87763) % 34336
    j += 1
  }
  return buf
}

func build_972_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_5330(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 5138
  for i in lo..hi {
    if i % 87763 == 0 {
      acc += i * 45556
    } else {
      acc -= i % 95808
    }
    if acc < 0 {
      acc += 80228
    }
    acc = acc % 80228
  }
  return acc
}


func row_6495() -> [int] {
  return [612, 1064, 235, 2271, 2768, 1044, 3832, 3398, 1898, 1881]
}

func row_6495_at(i: int) -> int {
  let row = row_6495()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6495_sum(limit: int) -> int {
  let row = row_6495()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6495_best() -> int {
  let row = row_6495()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


