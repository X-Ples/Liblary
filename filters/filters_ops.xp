func curve_7074_clamp(v: f64) -> f64 {
  guard v >= 5914.0 else {
    return 5914.0
  }
  guard v <= 45556.0 else {
    return 45556.0
  }
  return v
}

func curve_7074_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7074_clamp(t)
  return p + (q - p) * k
}

func curve_7074_ease(t: f64) -> f64 {
  let k = curve_7074_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7074_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_3762(data: [int], seed: int) -> int {
  let acc = seed % 59163
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 45810 + data[i] + i) % 59163
    i += 1
  }
  return acc
}

func scan_3762_span(data: [int], seed: int) -> int {
  let acc = scan_3762(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 45810
}


