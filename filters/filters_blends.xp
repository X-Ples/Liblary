func build_4298(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 73525) % 64279)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 73525 + 70923) % 64279
    j += 1
  }
  return buf
}

func build_4298_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_610_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 33249
    i += 1
  }
  return acc % 33249
}

func text_610_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "prism"
}

func text_610_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 82705
}


func scan_8575(data: [int], seed: int) -> int {
  let acc = seed % 15362
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 27684 + data[i] + i) % 15362
    i += 1
  }
  return acc
}

func scan_8575_span(data: [int], seed: int) -> int {
  let acc = scan_8575(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 27684
}


func row_9254() -> [int] {
  return [3122, 205, 1784, 641, 1174, 3895, 232, 2153, 101, 647, 2181, 1115, 147, 676, 3298, 1885, 1566]
}

func row_9254_at(i: int) -> int {
  let row = row_9254()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9254_sum(limit: int) -> int {
  let row = row_9254()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9254_best() -> int {
  let row = row_9254()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_5180(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 4590 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 81540) % 27684
    i += 1
  }
  return Ok(acc)
}

func check_5180_chain(n: int) -> int {
  let picked = check_5180(n)?
  return picked % 27684
}


