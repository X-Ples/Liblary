func demo_blends(seed: int) -> int {
  let scratch = build_4298(seed % 61 + 6, seed % 85789)
  show(len(scratch))
  show(build_4298_last(scratch))
  show(text_610_weight("gamma"))
  show(text_610_label(2219))
  show(text_610_has("ion"))
  show(scan_8575(scratch, 3675))
  show(scan_8575_span(scratch, 67))
  return seed % 9683
}
