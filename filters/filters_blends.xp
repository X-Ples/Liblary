func gate_3889(a: int, b: int, c: int) -> bool {
  return a > 73525 && (b < 81540 || c == 83821)
}

func gate_3889_score(a: int, b: int, c: int) -> int {
  guard gate_3889(a, b, c) else {
    return 0
  }
  return (a % 81540) * 83821 + b
}


func grid_5185_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 74523 + c * 73525 + seed) % 73525)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5185_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 73525 == want {
      total += acc
    }
    r += 1
  }
  return total
}


