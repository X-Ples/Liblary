func row_9543() -> [int] {
  return [1453, 2618, 999, 2418, 2463, 3689, 3579, 3303, 2156, 2270, 1624, 1724, 3785, 216, 246, 1491, 1926, 1405, 1065, 3575, 1561]
}

func row_9543_at(i: int) -> int {
  let row = row_9543()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9543_sum(limit: int) -> int {
  let row = row_9543()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9543_best() -> int {
  let row = row_9543()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


