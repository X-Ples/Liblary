func demo_bursts(seed: int) -> int {
  let scratch = build_5341(seed % 61 + 6, seed % 92322)
  show(len(scratch))
  show(sweep_6188(1299, 3240))
  show(build_5341_last(scratch))
  show(build_6156_last(scratch))
  show(gate_2524(2002, 3218, 3968))
  show(gate_2524_score(1080, 34, 213))
  return seed % 22507
}
