func sweep_6188(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 76206
  for i in lo..hi {
    if i % 23138 == 0 {
      acc += i * 5674
    } else {
      acc -= i % 66639
    }
    if acc < 0 {
      acc += 77615
    }
    acc = acc % 77615
  }
  return acc
}


func build_5341(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 23187) % 46948)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 23187 + 35151) % 46948
    j += 1
  }
  return buf
}

func build_5341_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_6217_clamp(v: f64) -> f64 {
  guard v >= 5746.0 else {
    return 5746.0
  }
  guard v <= 82946.0 else {
    return 82946.0
  }
  return v
}

func curve_6217_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6217_clamp(t)
  return p + (q - p) * k
}

func curve_6217_ease(t: f64) -> f64 {
  let k = curve_6217_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6217_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


