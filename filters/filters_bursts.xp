func text_4641_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 69493
    i += 1
  }
  return acc % 69493
}

func text_4641_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "quartz"
}

func text_4641_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 5746
}


func scan_1047(data: [int], seed: int) -> int {
  let acc = seed % 62246
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 32539 + data[i] + i) % 62246
    i += 1
  }
  return acc
}

func scan_1047_span(data: [int], seed: int) -> int {
  let acc = scan_1047(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 32539
}


