func build_1059(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 85875) % 68335)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 85875 + 42712) % 68335
    j += 1
  }
  return buf
}

func build_1059_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_4333_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 74121
    i += 1
  }
  return acc % 74121
}

func text_4333_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "prism"
}

func text_4333_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 85875
}


func scan_1835(data: [int], seed: int) -> int {
  let acc = seed % 31568
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 79485 + data[i] + i) % 31568
    i += 1
  }
  return acc
}

func scan_1835_span(data: [int], seed: int) -> int {
  let acc = scan_1835(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 79485
}


