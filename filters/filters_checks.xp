func demo_checks(seed: int) -> int {
  let scratch = build_1059(seed % 61 + 6, seed % 15522)
  show(len(scratch))
  show(build_1059_last(scratch))
  show(text_4333_weight("gamma"))
  show(text_4333_label(478))
  show(text_4333_has("kilo"))
  show(scan_1835(scratch, 958))
  return seed % 50706
}
