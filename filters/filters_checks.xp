func check_2011(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 68335 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 70522) % 74121
    i += 1
  }
  return Ok(acc)
}

func check_2011_chain(n: int) -> int {
  let picked = check_2011(n)?
  return picked % 74121
}


