func demo_pickers(seed: int) -> int {
  let scratch = build_3782(seed % 61 + 6, seed % 57453)
  show(len(scratch))
  show(build_3782_last(scratch))
  show(check_3115_chain(652))
  show(check_6263_chain(3116))
  show(check_7495_chain(1075))
  show(order_6300_find(scratch, 2966))
  return seed % 18794
}
