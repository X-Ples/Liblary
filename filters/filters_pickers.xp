func build_3782(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 28940) % 51496)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 28940 + 40526) % 51496
    j += 1
  }
  return buf
}

func build_3782_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_3115(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 18794 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 61009) % 73571
    i += 1
  }
  return Ok(acc)
}

func check_3115_chain(n: int) -> int {
  let picked = check_3115(n)?
  return picked % 73571
}


func curve_220_clamp(v: f64) -> f64 {
  guard v >= 73571.0 else {
    return 73571.0
  }
  guard v <= 82509.0 else {
    return 82509.0
  }
  return v
}

func curve_220_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_220_clamp(t)
  return p + (q - p) * k
}

func curve_220_ease(t: f64) -> f64 {
  let k = curve_220_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_220_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


