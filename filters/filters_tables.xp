func demo_tables(seed: int) -> int {
  let scratch = build_6319(seed % 61 + 6, seed % 81837)
  show(len(scratch))
  show(order_4848_find(scratch, 3856))
  show(build_6319_last(scratch))
  show(text_4888_weight("talus"))
  show(text_4888_label(3061))
  show(text_4888_has("ion"))
  return seed % 85579
}
