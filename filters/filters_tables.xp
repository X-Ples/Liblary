func sweep_7475(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 82569
  for i in lo..hi {
    if i % 95375 == 0 {
      acc += i * 41980
    } else {
      acc -= i % 87462
    }
    if acc < 0 {
      acc += 8925
    }
    acc = acc % 8925
  }
  return acc
}


