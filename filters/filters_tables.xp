func order_4848(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4848_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_6319(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 37728) % 7776)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 37728 + 82256) % 7776
    j += 1
  }
  return buf
}

func build_6319_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_4888_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 7776
    i += 1
  }
  return acc % 7776
}

func text_4888_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "ion"
}

func text_4888_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 48463
}


func row_4795() -> [int] {
  return [2431, 2462, 3950, 3018, 3981, 2483, 4061, 2176, 835, 685]
}

func row_4795_at(i: int) -> int {
  let row = row_4795()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4795_sum(limit: int) -> int {
  let row = row_4795()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4795_best() -> int {
  let row = row_4795()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_3585_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 68833 + c * 68833 + seed) % 68833)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3585_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 68833 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_222(data: [int], seed: int) -> int {
  let acc = seed % 82569
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 19018 + data[i] + i) % 82569
    i += 1
  }
  return acc
}

func scan_222_span(data: [int], seed: int) -> int {
  let acc = scan_222(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 19018
}


func curve_9857_clamp(v: f64) -> f64 {
  guard v >= 82569.0 else {
    return 82569.0
  }
  guard v <= 95375.0 else {
    return 95375.0
  }
  return v
}

func curve_9857_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9857_clamp(t)
  return p + (q - p) * k
}

func curve_9857_ease(t: f64) -> f64 {
  let k = curve_9857_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9857_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


