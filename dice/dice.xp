func row_5913() -> [int] {
  return [3600, 253, 3066, 688, 3188, 2305, 3669, 1720, 833, 2986, 1423, 978, 505, 65, 2658, 2390, 499, 169, 1203, 3152]
}

func row_5913_at(i: int) -> int {
  let row = row_5913()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5913_sum(limit: int) -> int {
  let row = row_5913()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5913_best() -> int {
  let row = row_5913()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


