func scan_7672(data: [int], seed: int) -> int {
  let acc = seed % 54673
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 28235 + data[i] + i) % 54673
    i += 1
  }
  return acc
}

func scan_7672_span(data: [int], seed: int) -> int {
  let acc = scan_7672(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 28235
}


func curve_1532_clamp(v: f64) -> f64 {
  guard v >= 31378.0 else {
    return 31378.0
  }
  guard v <= 61197.0 else {
    return 61197.0
  }
  return v
}

func curve_1532_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1532_clamp(t)
  return p + (q - p) * k
}

func curve_1532_ease(t: f64) -> f64 {
  let k = curve_1532_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1532_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_9691(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 80989) % 94959)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 80989 + 91842) % 94959
    j += 1
  }
  return buf
}

func build_9691_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_3460(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 18677
  for i in lo..hi {
    if i % 61564 == 0 {
      acc += i * 76989
    } else {
      acc -= i % 80989
    }
    if acc < 0 {
      acc += 33312
    }
    acc = acc % 33312
  }
  return acc
}


