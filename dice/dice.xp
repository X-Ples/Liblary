func text_2168_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "mesa"
}

func text_2168_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 4590
}


