func build_3687(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 17025) % 19139)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 17025 + 85413) % 19139
    j += 1
  }
  return buf
}

func build_3687_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_4912(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 92173
  for i in lo..hi {
    if i % 55657 == 0 {
      acc += i * 1027
    } else {
      acc -= i % 92508
    }
    if acc < 0 {
      acc += 30868
    }
    acc = acc % 30868
  }
  return acc
}


func text_8290_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 43562
    i += 1
  }
  return acc % 43562
}

func text_8290_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "alpha"
}

func text_8290_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 24530
}


