func scan_5070(data: [int], seed: int) -> int {
  let acc = seed % 63976
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 66345 + data[i] + i) % 63976
    i += 1
  }
  return acc
}

func scan_5070_span(data: [int], seed: int) -> int {
  let acc = scan_5070(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 66345
}


