func demo_twists(seed: int) -> int {
  let scratch = build_4134(seed % 61 + 6, seed % 7633)
  show(len(scratch))
  show(check_4948_chain(3160))
  show(build_4134_last(scratch))
  show(row_3481_at(2354))
  show(row_3481_sum(2979))
  return seed % 27624
}
