func check_4948(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 89785 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 96071) % 63976
    i += 1
  }
  return Ok(acc)
}

func check_4948_chain(n: int) -> int {
  let picked = check_4948(n)?
  return picked % 63976
}


func build_4134(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 34874) % 34874)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 34874 + 59426) % 34874
    j += 1
  }
  return buf
}

func build_4134_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_3481() -> [int] {
  return [1213, 1212, 2285, 240, 1952, 1697, 2854, 2486, 1045, 1318, 3149, 1791, 1744, 810, 1418, 125]
}

func row_3481_at(i: int) -> int {
  let row = row_3481()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3481_sum(limit: int) -> int {
  let row = row_3481()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3481_best() -> int {
  let row = row_3481()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


