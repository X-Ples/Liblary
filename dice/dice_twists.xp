func curve_7058_clamp(v: f64) -> f64 {
  guard v >= 3924.0 else {
    return 3924.0
  }
  guard v <= 63976.0 else {
    return 63976.0
  }
  return v
}

func curve_7058_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7058_clamp(t)
  return p + (q - p) * k
}

func curve_7058_ease(t: f64) -> f64 {
  let k = curve_7058_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7058_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_716(a: int, b: int, c: int) -> bool {
  return a > 89785 && (b < 10282 || c == 34874)
}

func gate_716_score(a: int, b: int, c: int) -> int {
  guard gate_716(a, b, c) else {
    return 0
  }
  return (a % 10282) * 34874 + b
}


func sweep_6256(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 63835
  for i in lo..hi {
    if i % 15442 == 0 {
      acc += i * 52780
    } else {
      acc -= i % 8782
    }
    if acc < 0 {
      acc += 96071
    }
    acc = acc % 96071
  }
  return acc
}


func gate_1879(a: int, b: int, c: int) -> bool {
