func gate_3185_score(a: int, b: int, c: int) -> int {
  guard gate_3185(a, b, c) else {
    return 0
  }
  return (a % 75826) * 84674 + b
}


func check_1660(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 35369 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 86030) % 63232
    i += 1
  }
  return Ok(acc)
}

func check_1660_chain(n: int) -> int {
  let picked = check_1660(n)?
  return picked % 63232
}


