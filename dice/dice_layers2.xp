func build_3161(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 30966) % 48777)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 30966 + 74820) % 48777
    j += 1
  }
  return buf
}

func build_3161_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_8135() -> [int] {
  return [1726, 391, 2678, 2838, 2954, 741, 805, 1646, 1858, 2408, 1071, 3168, 2113, 156]
}

func row_8135_at(i: int) -> int {
  let row = row_8135()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8135_sum(limit: int) -> int {
  let row = row_8135()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8135_best() -> int {
  let row = row_8135()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


