func demo_layers2(seed: int) -> int {
  let scratch = build_3161(seed % 61 + 6, seed % 64661)
  show(len(scratch))
  show(build_3161_last(scratch))
  show(row_8135_at(504))
  show(row_8135_sum(1752))
  show(row_8135_best())
  return seed % 22461
}
