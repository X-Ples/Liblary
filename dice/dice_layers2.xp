func check_9903(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 39320 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 74820) % 92836
    i += 1
  }
  return Ok(acc)
}

func check_9903_chain(n: int) -> int {
  let picked = check_9903(n)?
  return picked % 92836
}


func curve_9662_clamp(v: f64) -> f64 {
  guard v >= 23049.0 else {
    return 23049.0
  }
  guard v <= 53050.0 else {
    return 53050.0
  }
  return v
}

func curve_9662_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9662_clamp(t)
  return p + (q - p) * k
}

func curve_9662_ease(t: f64) -> f64 {
  let k = curve_9662_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9662_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


