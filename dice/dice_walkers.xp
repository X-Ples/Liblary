func text_3061_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 89231
    i += 1
  }
  return acc % 89231
}

func text_3061_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "gamma"
}

func text_3061_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 1492
}


