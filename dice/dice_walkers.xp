const K1 = 80448
const K2 = 33711
const K3 = 206
const K4 = 935
const K5 = 1492
const K6 = 59353
const K7 = 45968
const K8 = 79382
const K9 = 42110

func build_7553(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 45968) % 38399)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 45968 + 33711) % 38399
    j += 1
  }
  return buf
}

func build_7553_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_5754(data: [int], seed: int) -> int {
  let acc = seed % 56632
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 83431 + data[i] + i) % 56632
    i += 1
  }
  return acc
}

func scan_5754_span(data: [int], seed: int) -> int {
  let acc = scan_5754(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 83431
}


func order_1436(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1436_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_1630(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 35100
  for i in lo..hi {
    if i % 89231 == 0 {
      acc += i * 935
    } else {
      acc -= i % 22322
    }
    if acc < 0 {
      acc += 1492
    }
    acc = acc % 1492
  }
  return acc
}


func gate_6916(a: int, b: int, c: int) -> bool {
  return a > 206 && (b < 79382 || c == 55576)
}

func gate_6916_score(a: int, b: int, c: int) -> int {
  guard gate_6916(a, b, c) else {
    return 0
  }
  return (a % 79382) * 55576 + b
}


func curve_1476_clamp(v: f64) -> f64 {
  guard v >= 26763.0 else {
    return 26763.0
  }
  guard v <= 99109.0 else {
    return 99109.0
  }
  return v
}

func curve_1476_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1476_clamp(t)
  return p + (q - p) * k
}

func curve_1476_ease(t: f64) -> f64 {
  let k = curve_1476_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1476_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_5479(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 68552 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 24138) % 35100
    i += 1
  }
  return Ok(acc)
}

func check_5479_chain(n: int) -> int {
  let picked = check_5479(n)?
  return picked % 35100
}


