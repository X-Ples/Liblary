func demo_walkers(seed: int) -> int {
  let scratch = build_7553(seed % 61 + 6, seed % 68552)
  show(len(scratch))
  show(build_7553_last(scratch))
  show(scan_5754(scratch, 1201))
  show(scan_5754_span(scratch, 1677))
  show(order_1436_find(scratch, 1724))
  show(sweep_1630(3386, 2067))
  show(gate_6916(673, 2121, 1697))
  return seed % 3380
}
