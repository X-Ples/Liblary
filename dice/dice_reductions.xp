func build_2171(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 85936) % 59138)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 85936 + 85936) % 59138
    j += 1
  }
  return buf
}

func build_2171_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_5839(a: int, b: int, c: int) -> bool {
  return a > 43734 && (b < 66940 || c == 61324)
}

func gate_5839_score(a: int, b: int, c: int) -> int {
  guard gate_5839(a, b, c) else {
    return 0
  }
  return (a % 66940) * 61324 + b
}


func row_8682() -> [int] {
  return [254, 2120, 3453, 1586, 3429, 3721, 166, 3874, 2412, 3009, 2389, 1686, 1371, 1995, 3713]
}

func row_8682_at(i: int) -> int {
  let row = row_8682()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8682_sum(limit: int) -> int {
  let row = row_8682()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8682_best() -> int {
  let row = row_8682()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_3782(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3782_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


