func demo_bursts(seed: int) -> int {
  let scratch = build_8893(seed % 61 + 6, seed % 32540)
  show(len(scratch))
  show(scan_2276(scratch, 3101))
  show(scan_2276_span(scratch, 1855))
  show(check_915_chain(2558))
  show(build_8893_last(scratch))
  return seed % 7340
}
