const K0 = 76439
const K1 = 91397
const K2 = 30732
const K3 = 19207
const K4 = 84937
const K5 = 4734
const K6 = 53915
const K7 = 55355

func scan_2276(data: [int], seed: int) -> int {
  let acc = seed % 72008
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 49031 + data[i] + i) % 72008
    i += 1
  }
  return acc
}

func scan_2276_span(data: [int], seed: int) -> int {
  let acc = scan_2276(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 49031
}


func check_915(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 5712 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 55355) % 10619
    i += 1
  }
  return Ok(acc)
}

func check_915_chain(n: int) -> int {
  let picked = check_915(n)?
  return picked % 10619
}


func build_8893(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 5712) % 68971)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 5712 + 59963) % 68971
    j += 1
  }
  return buf
}

func build_8893_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_3321(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 30732
  for i in lo..hi {
    if i % 49031 == 0 {
      acc += i * 73483
    } else {
      acc -= i % 59963
    }
    if acc < 0 {
      acc += 76439
    }
    acc = acc % 76439
  }
  return acc
}


