func curve_4756_clamp(v: f64) -> f64 {
  guard v >= 59963.0 else {
    return 59963.0
  }
  guard v <= 91397.0 else {
    return 91397.0
  }
  return v
}

func curve_4756_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4756_clamp(t)
  return p + (q - p) * k
}

func curve_4756_ease(t: f64) -> f64 {
  let k = curve_4756_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4756_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_9458() -> [int] {
