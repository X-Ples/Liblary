func sweep_1946(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 99863
  for i in lo..hi {
    if i % 45062 == 0 {
      acc += i * 23857
    } else {
      acc -= i % 87684
    }
    if acc < 0 {
      acc += 45062
    }
    acc = acc % 45062
  }
  return acc
}


