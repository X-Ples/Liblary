    return 0
  }
  return (a % 39878) * 60759 + b
}


func text_6611_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 8965
    i += 1
  }
  return acc % 8965
}

func text_6611_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "talus"
}

func text_6611_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 48040
}


