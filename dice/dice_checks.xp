func row_8931() -> [int] {
  return [1885, 2632, 3703, 1895, 2473, 1833, 3987, 3470, 160, 493, 1587, 1804, 1497]
}

func row_8931_at(i: int) -> int {
  let row = row_8931()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8931_sum(limit: int) -> int {
  let row = row_8931()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8931_best() -> int {
  let row = row_8931()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


