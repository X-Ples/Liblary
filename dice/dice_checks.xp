func demo_checks(seed: int) -> int {
  let scratch = build_8288(seed % 61 + 6, seed % 74772)
  show(len(scratch))
  show(grid_3402_rowsum(scratch, 2128, 2659, 3634))
  show(check_2144_chain(240))
  show(build_8288_last(scratch))
  show(order_8045_find(scratch, 3021))
  return seed % 48040
}
