  }
  let i = 0
  while i < n {
    acc = (acc * 81318 + data[i] + i) % 27592
    i += 1
  }
  return acc
}

func scan_2406_span(data: [int], seed: int) -> int {
  let acc = scan_2406(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 81318
}


func row_6845() -> [int] {
