func build_3169(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 75104) % 94588)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 75104 + 29000) % 94588
    j += 1
  }
  return buf
}

func build_3169_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


