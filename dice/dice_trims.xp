func row_6845_at(i: int) -> int {
  let row = row_6845()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6845_sum(limit: int) -> int {
  let row = row_6845()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6845_best() -> int {
  let row = row_6845()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_8089_clamp(v: f64) -> f64 {
  guard v >= 17932.0 else {
    return 17932.0
  }
  guard v <= 75104.0 else {
    return 75104.0
  }
  return v
}

func curve_8089_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8089_clamp(t)
  return p + (q - p) * k
}

func curve_8089_ease(t: f64) -> f64 {
  let k = curve_8089_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8089_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_9179(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 79924
  for i in lo..hi {
    if i % 77039 == 0 {
      acc += i * 81833
    } else {
      acc -= i % 81833
    }
    if acc < 0 {
      acc += 81833
    }
    acc = acc % 81833
  }
  return acc
}


