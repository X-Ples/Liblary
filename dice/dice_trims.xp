func demo_trims(seed: int) -> int {
  let scratch = build_3169(seed % 61 + 6, seed % 38774)
  show(len(scratch))
  show(build_3169_last(scratch))
  show(build_1374_last(scratch))
  show(check_4617_chain(2189))
  show(order_3319_find(scratch, 2473))
  return seed % 38774
}
