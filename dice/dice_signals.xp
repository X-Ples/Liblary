const K0 = 79118
const K1 = 8675
const K2 = 449
const K3 = 62531
const K4 = 5383
const K5 = 98310
const K6 = 64056

func check_3769(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 91892 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 449) % 9910
    i += 1
  }
  return Ok(acc)
}

func check_3769_chain(n: int) -> int {
  let picked = check_3769(n)?
  return picked % 9910
}


func order_6625(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6625_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func curve_5780_clamp(v: f64) -> f64 {
  guard v >= 62531.0 else {
    return 62531.0
  }
  guard v <= 65482.0 else {
    return 65482.0
  }
  return v
}

func curve_5780_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5780_clamp(t)
  return p + (q - p) * k
}

func curve_5780_ease(t: f64) -> f64 {
  let k = curve_5780_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5780_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_6005() -> [int] {
  return [2728, 3363, 3064, 3663, 3365, 357, 1312, 3141, 1926, 3194, 2502, 19]
}

func row_6005_at(i: int) -> int {
  let row = row_6005()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6005_sum(limit: int) -> int {
  let row = row_6005()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6005_best() -> int {
  let row = row_6005()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_2153_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 98310 + c * 38346 + seed) % 38346)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2153_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 38346 == want {
      total += acc
    }
    r += 1
  }
  return total
}


