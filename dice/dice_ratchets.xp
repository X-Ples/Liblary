func demo_ratchets(seed: int) -> int {
  let scratch = build_7080(seed % 61 + 6, seed % 45024)
  show(len(scratch))
  show(build_7080_last(scratch))
  show(check_5415_chain(951))
  show(grid_817_rowsum(scratch, 2041, 3996, 1432))
  show(check_896_chain(3457))
  return seed % 28626
}
