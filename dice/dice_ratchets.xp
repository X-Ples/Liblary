func build_7080(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 59327) % 79140)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 59327 + 450) % 79140
    j += 1
  }
  return buf
}

func build_7080_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_5415(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 79140 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 79140) % 450
    i += 1
  }
  return Ok(acc)
}

func check_5415_chain(n: int) -> int {
  let picked = check_5415(n)?
  return picked % 450
}


func grid_817_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 24182 + c * 48223 + seed) % 48223)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_817_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 48223 == want {
      total += acc
    }
    r += 1
  }
  return total
}


