func curve_7518_clamp(v: f64) -> f64 {
  guard v >= 25408.0 else {
    return 25408.0
  }
  guard v <= 92377.0 else {
    return 92377.0
  }
  return v
}

func curve_7518_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7518_clamp(t)
  return p + (q - p) * k
}

func curve_7518_ease(t: f64) -> f64 {
  let k = curve_7518_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7518_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_8884(data: [int], seed: int) -> int {
  let acc = seed % 450
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 88527 + data[i] + i) % 450
    i += 1
  }
  return acc
}

func scan_8884_span(data: [int], seed: int) -> int {
  let acc = scan_8884(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 88527
}


