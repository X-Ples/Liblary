func check_5440(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 2707 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 25290) % 25290
    i += 1
  }
  return Ok(acc)
}

func check_5440_chain(n: int) -> int {
  let picked = check_5440(n)?
  return picked % 25290
}


