}

func text_4533_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "nova"
}

func text_4533_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 30496
}


