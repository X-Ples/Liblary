func row_413() -> [int] {
  return [2812, 3301, 1935, 1528, 1933, 3445, 1614, 3595, 1405, 2979, 2953, 1467, 3131, 2818, 1893, 2087]
}

func row_413_at(i: int) -> int {
  let row = row_413()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_413_sum(limit: int) -> int {
  let row = row_413()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_413_best() -> int {
  let row = row_413()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


