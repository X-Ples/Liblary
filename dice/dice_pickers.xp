func curve_4400_clamp(v: f64) -> f64 {
  guard v >= 15110.0 else {
    return 15110.0
  }
  guard v <= 48877.0 else {
    return 48877.0
  }
  return v
}

func curve_4400_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4400_clamp(t)
  return p + (q - p) * k
}

func curve_4400_ease(t: f64) -> f64 {
  let k = curve_4400_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4400_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_6015(data: [int], seed: int) -> int {
  let acc = seed % 41642
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 28837 + data[i] + i) % 41642
    i += 1
  }
  return acc
}

func scan_6015_span(data: [int], seed: int) -> int {
  let acc = scan_6015(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 28837
}


