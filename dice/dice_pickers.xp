func build_6453(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 48484) % 54195)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 48484 + 29351) % 54195
    j += 1
  }
  return buf
}

func build_6453_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_4788(a: int, b: int, c: int) -> bool {
  return a > 64713 && (b < 15110 || c == 62736)
}

func gate_4788_score(a: int, b: int, c: int) -> int {
  guard gate_4788(a, b, c) else {
    return 0
  }
  return (a % 15110) * 62736 + b
}


func sweep_5488(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 19278
  for i in lo..hi {
    if i % 15110 == 0 {
      acc += i * 62273
    } else {
      acc -= i % 65582
    }
    if acc < 0 {
      acc += 19278
    }
    acc = acc % 19278
  }
  return acc
}


func check_3347(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 60256 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 39156) % 28837
    i += 1
  }
  return Ok(acc)
}

func check_3347_chain(n: int) -> int {
  let picked = check_3347(n)?
  return picked % 28837
}


