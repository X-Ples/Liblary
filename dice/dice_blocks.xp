const K0 = 29451
const K1 = 51575
const K2 = 7462
const K3 = 1651
const K4 = 98801
const K5 = 68150
const K6 = 22349

func build_3300(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 32431) % 68150)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 32431 + 24562) % 68150
    j += 1
  }
  return buf
}

func build_3300_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_9841_clamp(v: f64) -> f64 {
  guard v >= 58660.0 else {
    return 58660.0
  }
  guard v <= 98801.0 else {
    return 98801.0
  }
  return v
}

func curve_9841_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9841_clamp(t)
  return p + (q - p) * k
}

func curve_9841_ease(t: f64) -> f64 {
  let k = curve_9841_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9841_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_1331(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1331_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_2939(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 20700
  for i in lo..hi {
    if i % 95982 == 0 {
      acc += i * 92702
    } else {
      acc -= i % 68150
    }
    if acc < 0 {
      acc += 24562
    }
    acc = acc % 24562
  }
  return acc
}


func gate_897(a: int, b: int, c: int) -> bool {
  return a > 22349 && (b < 9448 || c == 33940)
}

func gate_897_score(a: int, b: int, c: int) -> int {
  guard gate_897(a, b, c) else {
    return 0
  }
  return (a % 9448) * 33940 + b
}


func check_4004(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 68150 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 9448) % 68150
    i += 1
  }
  return Ok(acc)
}

func check_4004_chain(n: int) -> int {
  let picked = check_4004(n)?
  return picked % 68150
}


