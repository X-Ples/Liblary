func scan_9507(data: [int], seed: int) -> int {
  let acc = seed % 68619
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 87063 + data[i] + i) % 68619
    i += 1
  }
  return acc
}

func scan_9507_span(data: [int], seed: int) -> int {
  let acc = scan_9507(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 87063
}


