func demo_blocks(seed: int) -> int {
  let scratch = build_3300(seed % 61 + 6, seed % 92702)
  show(len(scratch))
  show(build_3300_last(scratch))
  show(order_1331_find(scratch, 834))
  show(sweep_2939(1256, 905))
  show(gate_897(341, 1782, 105))
  return seed % 87063
}
