func text_5740_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "jetty"
}

func text_5740_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 20700
}


