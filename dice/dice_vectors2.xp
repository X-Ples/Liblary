func row_7076() -> [int] {
  return [590, 353, 3316, 40, 311, 3781, 851, 3565, 1409, 675, 1895, 257, 2839, 1851, 3149]
}

func row_7076_at(i: int) -> int {
  let row = row_7076()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7076_sum(limit: int) -> int {
  let row = row_7076()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7076_best() -> int {
  let row = row_7076()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


