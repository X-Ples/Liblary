func sweep_8762(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 58442
  for i in lo..hi {
    if i % 99358 == 0 {
      acc += i * 4492
    } else {
      acc -= i % 14333
    }
    if acc < 0 {
      acc += 99358
    }
    acc = acc % 99358
  }
  return acc
}


func check_4336(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 26341 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 26516) % 98254
    i += 1
  }
  return Ok(acc)
}

func check_4336_chain(n: int) -> int {
  let picked = check_4336(n)?
  return picked % 98254
}


