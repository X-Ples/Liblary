func demo_vectors2(seed: int) -> int {
  let scratch = build_6775(seed % 61 + 6, seed % 58492)
  show(len(scratch))
  show(build_6775_last(scratch))
  show(scan_3816(scratch, 1305))
  show(scan_3816_span(scratch, 1557))
  show(order_3593_find(scratch, 3169))
  show(scan_9536(scratch, 3357))
  return seed % 88585
}
