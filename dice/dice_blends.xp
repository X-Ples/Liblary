func check_693(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 58712 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 2886) % 21732
    i += 1
  }
  return Ok(acc)
}

func check_693_chain(n: int) -> int {
  let picked = check_693(n)?
  return picked % 21732
}


