func scan_8501(data: [int], seed: int) -> int {
  let acc = seed % 76167
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 39891 + data[i] + i) % 76167
    i += 1
  }
  return acc
}

func scan_8501_span(data: [int], seed: int) -> int {
  let acc = scan_8501(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 39891
}


