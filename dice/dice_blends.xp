func demo_blends(seed: int) -> int {
  let scratch = build_8031(seed % 61 + 6, seed % 65546)
  show(len(scratch))
  show(gate_348(1715, 7, 1917))
  show(gate_348_score(416, 675, 1305))
  show(build_8031_last(scratch))
  show(order_6101_find(scratch, 2842))
  return seed % 76167
}
