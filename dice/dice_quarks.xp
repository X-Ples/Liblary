func curve_5515_clamp(v: f64) -> f64 {
  guard v >= 75964.0 else {
    return 75964.0
  }
  guard v <= 88172.0 else {
    return 88172.0
  }
  return v
}

func curve_5515_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5515_clamp(t)
  return p + (q - p) * k
}

func curve_5515_ease(t: f64) -> f64 {
  let k = curve_5515_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5515_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_9579(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 80729 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 62856) % 34821
    i += 1
  }
  return Ok(acc)
}

func check_9579_chain(n: int) -> int {
  let picked = check_9579(n)?
  return picked % 34821
}


func build_1204(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 62342) % 88172)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 62342 + 49456) % 88172
    j += 1
  }
  return buf
}

func build_1204_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


