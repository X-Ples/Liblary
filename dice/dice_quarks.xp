func row_1894() -> [int] {
  return [1744, 70, 276, 98, 3338, 1090, 1340, 3105, 342, 4002, 3427, 1989, 3230]
}

func row_1894_at(i: int) -> int {
  let row = row_1894()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1894_sum(limit: int) -> int {
  let row = row_1894()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1894_best() -> int {
  let row = row_1894()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


