func demo_quarks(seed: int) -> int {
  let scratch = build_1204(seed % 61 + 6, seed % 63867)
  show(len(scratch))
  show(check_9579_chain(1217))
  show(build_1204_last(scratch))
  show(row_1894_at(598))
  show(row_1894_sum(2481))
  show(row_1894_best())
  show(build_5969_last(scratch))
  return seed % 35086
}
