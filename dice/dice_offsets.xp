    }
    acc = acc % 83122
  }
  return acc
}


func check_9937(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 22667 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 83122) % 49585
    i += 1
  }
  return Ok(acc)
}

func check_9937_chain(n: int) -> int {
  let picked = check_9937(n)?
  return picked % 49585
}


