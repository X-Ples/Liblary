func build_9356(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 4218) % 73900)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 4218 + 4218) % 73900
    j += 1
  }
  return buf
}

func build_9356_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_2751_clamp(v: f64) -> f64 {
  guard v >= 83122.0 else {
    return 83122.0
  }
  guard v <= 88639.0 else {
    return 88639.0
  }
  return v
}

func curve_2751_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2751_clamp(t)
  return p + (q - p) * k
}

func curve_2751_ease(t: f64) -> f64 {
  let k = curve_2751_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2751_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


