func demo_ranges(seed: int) -> int {
  let scratch = build_7568(seed % 61 + 6, seed % 54521)
  show(len(scratch))
  show(order_6260_find(scratch, 230))
  show(build_7568_last(scratch))
  show(grid_5540_rowsum(scratch, 1984, 427, 1247))
