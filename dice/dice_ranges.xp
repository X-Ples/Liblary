func row_5602() -> [int] {
  return [781, 3509, 2421, 1711, 355, 3065, 434, 2342, 140, 989, 2415, 2551, 1024, 3981]
}

func row_5602_at(i: int) -> int {
  let row = row_5602()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5602_sum(limit: int) -> int {
  let row = row_5602()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5602_best() -> int {
  let row = row_5602()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


