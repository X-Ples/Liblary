func check_2245(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 65702 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 75953) % 89134
    i += 1
  }
  return Ok(acc)
}

func check_2245_chain(n: int) -> int {
  let picked = check_2245(n)?
  return picked % 89134
}


