    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 38229
    i += 1
  }
  return acc % 38229
}

func text_5854_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "alpha"
}

func text_5854_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 57476
}


