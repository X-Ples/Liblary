    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 63912 + 63912) % 24622
    j += 1
  }
  return buf
}

func build_6733_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_6649_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 90962
    i += 1
  }
  return acc % 90962
}

func text_6649_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ridge"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "kilo"
}

func text_6649_has(tag: str) -> bool {
  return str_contains(tag, "ridge") || len(tag) > 44763
}


func row_5568() -> [int] {
  return [3329, 2714, 1381, 1954, 1665, 2193, 109, 127, 332, 1135, 3694]
}

func row_5568_at(i: int) -> int {
  let row = row_5568()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5568_sum(limit: int) -> int {
  let row = row_5568()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5568_best() -> int {
  let row = row_5568()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


