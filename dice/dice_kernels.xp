func gate_6175(a: int, b: int, c: int) -> bool {
  return a > 25993 && (b < 95821 || c == 75948)
}

func gate_6175_score(a: int, b: int, c: int) -> int {
  guard gate_6175(a, b, c) else {
    return 0
  }
  return (a % 95821) * 75948 + b
}


func build_5541(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 9901) % 81854)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 9901 + 95821) % 81854
    j += 1
  }
  return buf
}

func build_5541_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_1422_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 2987
    i += 1
  }
  return acc % 2987
}

func text_1422_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "cargo"
}

func text_1422_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 33596
}


