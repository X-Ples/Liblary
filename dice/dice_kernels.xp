func demo_kernels(seed: int) -> int {
  let scratch = build_5541(seed % 61 + 6, seed % 86406)
  show(len(scratch))
  show(gate_6175(232, 385, 2115))
  show(gate_6175_score(1055, 1513, 2250))
  show(build_5541_last(scratch))
  show(text_1422_weight("quartz"))
  show(text_1422_label(875))
  return seed % 15704
}
