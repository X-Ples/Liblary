func curve_893_clamp(v: f64) -> f64 {
  guard v >= 48563.0 else {
    return 48563.0
  }
  guard v <= 58143.0 else {
    return 58143.0
  }
  return v
}

func curve_893_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_893_clamp(t)
  return p + (q - p) * k
}

func curve_893_ease(t: f64) -> f64 {
  let k = curve_893_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_893_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_2919(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 86406
  for i in lo..hi {
    if i % 65985 == 0 {
      acc += i * 93441
    } else {
      acc -= i % 28190
    }
    if acc < 0 {
      acc += 15704
    }
    acc = acc % 15704
  }
  return acc
}


