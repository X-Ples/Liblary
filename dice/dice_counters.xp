func build_8946(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 14602) % 65421)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 14602 + 45105) % 65421
    j += 1
  }
  return buf
}

func build_8946_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_5546() -> [int] {
  return [549, 870, 100, 2206, 1545, 2636, 2440, 2328, 3179, 3115, 2509, 1855, 856, 1176, 3507, 973, 3649, 2720, 2054, 2279]
}

func row_5546_at(i: int) -> int {
  let row = row_5546()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5546_sum(limit: int) -> int {
  let row = row_5546()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5546_best() -> int {
  let row = row_5546()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_7383_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 53011 + c * 98864 + seed) % 98864)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7383_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 98864 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_7297(data: [int], seed: int) -> int {
  let acc = seed % 25744
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 25561 + data[i] + i) % 25744
    i += 1
  }
  return acc
}

func scan_7297_span(data: [int], seed: int) -> int {
  let acc = scan_7297(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 25561
}


