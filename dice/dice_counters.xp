func demo_counters(seed: int) -> int {
  let scratch = build_8946(seed % 61 + 6, seed % 26175)
  show(len(scratch))
  show(build_8946_last(scratch))
  show(row_5546_at(1139))
  show(row_5546_sum(2029))
  show(row_5546_best())
  return seed % 99020
}
