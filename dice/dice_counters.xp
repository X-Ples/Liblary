func sweep_5325(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 26976
  for i in lo..hi {
    if i % 14602 == 0 {
      acc += i * 13940
    } else {
      acc -= i % 62208
    }
    if acc < 0 {
      acc += 45105
    }
    acc = acc % 45105
  }
  return acc
}


