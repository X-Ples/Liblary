func scan_1842(data: [int], seed: int) -> int {
  let acc = seed % 57700
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 91457 + data[i] + i) % 57700
    i += 1
  }
  return acc
}

func scan_1842_span(data: [int], seed: int) -> int {
  let acc = scan_1842(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 91457
}


