func demo_tables(seed: int) -> int {
  let scratch = build_4693(seed % 61 + 6, seed % 99525)
  show(len(scratch))
  show(build_4693_last(scratch))
  show(row_8927_at(3126))
  show(row_8927_sum(2012))
