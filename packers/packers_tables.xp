}


func sweep_153(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 49595
  for i in lo..hi {
    if i % 49595 == 0 {
      acc += i * 57700
    } else {
      acc -= i % 43088
    }
    if acc < 0 {
      acc += 41082
    }
    acc = acc % 41082
  }
  return acc
}


