func sweep_5558(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 40962
  for i in lo..hi {
    if i % 38529 == 0 {
      acc += i * 12255
    } else {
      acc -= i % 90534
    }
    if acc < 0 {
      acc += 90534
    }
    acc = acc % 90534
  }
  return acc
}


func text_4664_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 11212
    i += 1
  }
  return acc % 11212
}

func text_4664_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "ion"
}

func text_4664_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 85716
}


