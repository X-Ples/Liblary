func build_7711(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 85716) % 92011)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 85716 + 60774) % 92011
    j += 1
  }
  return buf
}

func build_7711_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_7639(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7639_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func scan_8018(data: [int], seed: int) -> int {
  let acc = seed % 52578
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 60774 + data[i] + i) % 52578
    i += 1
  }
  return acc
}

func scan_8018_span(data: [int], seed: int) -> int {
  let acc = scan_8018(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 60774
}


func curve_9085_clamp(v: f64) -> f64 {
  guard v >= 40962.0 else {
    return 40962.0
  }
  guard v <= 52578.0 else {
    return 52578.0
  }
  return v
}

func curve_9085_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9085_clamp(t)
  return p + (q - p) * k
}

func curve_9085_ease(t: f64) -> f64 {
  let k = curve_9085_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9085_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_8147(a: int, b: int, c: int) -> bool {
  return a > 40962 && (b < 53496 || c == 17425)
}

func gate_8147_score(a: int, b: int, c: int) -> int {
  guard gate_8147(a, b, c) else {
    return 0
  }
  return (a % 53496) * 17425 + b
}


