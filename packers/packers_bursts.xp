func demo_bursts(seed: int) -> int {
  let scratch = build_7711(seed % 61 + 6, seed % 92011)
  show(len(scratch))
  show(build_7711_last(scratch))
  show(order_7639_find(scratch, 2773))
  show(scan_8018(scratch, 1224))
  show(scan_8018_span(scratch, 2360))
  show(gate_8147(867, 1624, 337))
  return seed % 52578
}
