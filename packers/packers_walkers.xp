func demo_walkers(seed: int) -> int {
  let scratch = build_159(seed % 61 + 6, seed % 94379)
  show(len(scratch))
  show(build_159_last(scratch))
  show(build_8081_last(scratch))
  show(check_6741_chain(1431))
  show(gate_9281(2855, 1043, 538))
  show(gate_9281_score(1152, 2158, 3904))
  show(scan_3969(scratch, 1777))
  return seed % 33264
}
