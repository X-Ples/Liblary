func row_6189() -> [int] {
  return [403, 767, 4074, 1323, 2416, 147, 1471, 68, 2800, 1750, 3440, 3399, 326]
}

func row_6189_at(i: int) -> int {
  let row = row_6189()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6189_sum(limit: int) -> int {
  let row = row_6189()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6189_best() -> int {
  let row = row_6189()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


