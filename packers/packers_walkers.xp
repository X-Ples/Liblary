func build_159(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 97310) % 99877)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 97310 + 54702) % 99877
    j += 1
  }
  return buf
}

func build_159_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


