func text_6401_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 36584
    i += 1
  }
  return acc % 36584
}

func text_6401_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "ember"
}

func text_6401_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 99877
}


