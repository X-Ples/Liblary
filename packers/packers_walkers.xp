func check_6741(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 77799 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 33264) % 26218
    i += 1
  }
  return Ok(acc)
}

func check_6741_chain(n: int) -> int {
  let picked = check_6741(n)?
  return picked % 26218
}


func gate_9281(a: int, b: int, c: int) -> bool {
  return a > 73251 && (b < 31894 || c == 73251)
}

func gate_9281_score(a: int, b: int, c: int) -> int {
  guard gate_9281(a, b, c) else {
    return 0
  }
  return (a % 31894) * 73251 + b
}


func scan_3969(data: [int], seed: int) -> int {
  let acc = seed % 26800
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 97310 + data[i] + i) % 26800
    i += 1
  }
  return acc
}

func scan_3969_span(data: [int], seed: int) -> int {
  let acc = scan_3969(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 97310
}


func curve_6845_clamp(v: f64) -> f64 {
  guard v >= 26800.0 else {
    return 26800.0
  }
  guard v <= 64146.0 else {
    return 64146.0
  }
  return v
}

func curve_6845_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6845_clamp(t)
  return p + (q - p) * k
}

func curve_6845_ease(t: f64) -> f64 {
  let k = curve_6845_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6845_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_3192_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 90709 + c * 26800 + seed) % 26800)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3192_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 26800 == want {
      total += acc
    }
    r += 1
  }
  return total
}


