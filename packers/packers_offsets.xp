const K0 = 52041
const K1 = 71326
const K2 = 96536
const K3 = 44547
const K4 = 6452
const K5 = 31447
const K6 = 9148
const K7 = 48582

func order_6933(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6933_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func curve_1999_clamp(v: f64) -> f64 {
  guard v >= 6301.0 else {
    return 6301.0
  }
  guard v <= 98208.0 else {
    return 98208.0
  }
  return v
}

func curve_1999_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1999_clamp(t)
  return p + (q - p) * k
}

func curve_1999_ease(t: f64) -> f64 {
  let k = curve_1999_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1999_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_7164(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 70056 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 52041) % 72264
    i += 1
  }
  return Ok(acc)
}

func check_7164_chain(n: int) -> int {
  let picked = check_7164(n)?
  return picked % 72264
}


func row_3544() -> [int] {
  return [495, 456, 3281, 2767, 3979, 991, 1411, 3667, 1481, 1478, 3553, 3691, 813, 545]
}

func row_3544_at(i: int) -> int {
  let row = row_3544()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3544_sum(limit: int) -> int {
  let row = row_3544()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3544_best() -> int {
  let row = row_3544()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


