func grid_1650_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 53379 + c * 79177 + seed) % 79177)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1650_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 79177 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_8527_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 96536
    i += 1
  }
  return acc % 96536
}

func text_8527_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "talus"
}

func text_8527_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 70056
}


