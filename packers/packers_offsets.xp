func gate_3637(a: int, b: int, c: int) -> bool {
  return a > 72264 && (b < 71326 || c == 78155)
}

func gate_3637_score(a: int, b: int, c: int) -> int {
  guard gate_3637(a, b, c) else {
    return 0
  }
  return (a % 71326) * 78155 + b
}


