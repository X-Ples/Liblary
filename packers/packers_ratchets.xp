func curve_5533_clamp(v: f64) -> f64 {
  guard v >= 29628.0 else {
    return 29628.0
  }
  guard v <= 61764.0 else {
    return 61764.0
  }
  return v
}

func curve_5533_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5533_clamp(t)
  return p + (q - p) * k
}

func curve_5533_ease(t: f64) -> f64 {
  let k = curve_5533_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5533_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_ratchets(seed: int) -> int {
  let scratch = build_2244(seed % 61 + 6, seed % 98222)
  show(len(scratch))
  show(build_2244_last(scratch))
  show(check_3431_chain(638))
  show(check_2699_chain(3590))
  show(grid_5382_rowsum(scratch, 1312, 1029, 3188))
  return seed % 79231
}
