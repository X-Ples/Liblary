func build_2244(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 40412) % 53829)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 40412 + 29628) % 53829
    j += 1
  }
  return buf
}

func build_2244_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_3431(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 61837 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 59196) % 61837
    i += 1
  }
  return Ok(acc)
}

func check_3431_chain(n: int) -> int {
  let picked = check_3431(n)?
  return picked % 61837
}


