func build_4572(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 49017) % 40300)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 49017 + 99) % 40300
    j += 1
  }
  return buf
}

func build_4572_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_7834() -> [int] {
  return [1707, 1267, 1308, 199, 3062, 2007, 3730, 3570, 1078, 1321, 1145, 526, 2104, 111, 556, 3624, 3931]
}

func row_7834_at(i: int) -> int {
  let row = row_7834()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7834_sum(limit: int) -> int {
  let row = row_7834()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7834_best() -> int {
  let row = row_7834()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_3615(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3615_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_3639(a: int, b: int, c: int) -> bool {
  return a > 92926 && (b < 60959 || c == 36210)
}

func gate_3639_score(a: int, b: int, c: int) -> int {
  guard gate_3639(a, b, c) else {
    return 0
  }
  return (a % 60959) * 36210 + b
}


