}

func text_3129_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "omega"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "nova"
}

func text_3129_has(tag: str) -> bool {
  return str_contains(tag, "omega") || len(tag) > 98564
}


