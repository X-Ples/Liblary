func demo_kernels(seed: int) -> int {
  let scratch = build_4572(seed % 61 + 6, seed % 49369)
  show(len(scratch))
  show(build_4572_last(scratch))
  show(row_7834_at(271))
  show(row_7834_sum(2888))
