func check_6889(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 42703 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 7712) % 13682
    i += 1
  }
  return Ok(acc)
}

func check_6889_chain(n: int) -> int {
  let picked = check_6889(n)?
  return picked % 13682
}


