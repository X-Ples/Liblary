const K0 = 75255
const K1 = 39535
const K2 = 83974
const K3 = 4763
const K4 = 60544
const K5 = 23449
const K6 = 7712

func grid_3414_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 25688 + c * 16051 + seed) % 16051)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3414_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 16051 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_9439_clamp(v: f64) -> f64 {
  guard v >= 32223.0 else {
    return 32223.0
  }
  guard v <= 75255.0 else {
    return 75255.0
  }
  return v
}

func curve_9439_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9439_clamp(t)
  return p + (q - p) * k
}

func curve_9439_ease(t: f64) -> f64 {
  let k = curve_9439_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9439_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_4625(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 4763
  for i in lo..hi {
    if i % 60544 == 0 {
      acc += i * 16880
    } else {
      acc -= i % 75255
    }
    if acc < 0 {
      acc += 4763
    }
    acc = acc % 4763
  }
  return acc
}


func text_1655_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 59693
    i += 1
  }
  return acc % 59693
}

func text_1655_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "ridge"
}

func text_1655_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 60544
}


