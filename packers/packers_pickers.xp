func demo_pickers(seed: int) -> int {
  let scratch = build_4995(seed % 61 + 6, seed % 4763)
  show(len(scratch))
  show(grid_3414_rowsum(scratch, 3514, 493, 2728))
  show(sweep_4625(1899, 2932))
  show(text_1655_weight("sigma"))
  show(text_1655_label(3719))
  show(text_1655_has("ember"))
  return seed % 4763
}
