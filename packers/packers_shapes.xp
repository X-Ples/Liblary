const K0 = 96763
const K1 = 30432
const K2 = 38255
const K3 = 12348
const K4 = 55955
const K5 = 1866

func curve_6182_clamp(v: f64) -> f64 {
  guard v >= 1866.0 else {
    return 1866.0
  }
  guard v <= 74364.0 else {
    return 74364.0
  }
  return v
}

func curve_6182_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6182_clamp(t)
  return p + (q - p) * k
}

func curve_6182_ease(t: f64) -> f64 {
  let k = curve_6182_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6182_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_8991() -> [int] {
  return [1628, 1441, 850, 2798, 2981, 1019, 3069, 2612, 2637, 3693, 851, 86]
}

func row_8991_at(i: int) -> int {
  let row = row_8991()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8991_sum(limit: int) -> int {
  let row = row_8991()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8991_best() -> int {
  let row = row_8991()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_1199(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 88961) % 38216)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 88961 + 59816) % 38216
    j += 1
  }
  return buf
}

func build_1199_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_1671_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 88961
    i += 1
  }
  return acc % 88961
}

func text_1671_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "harbor"
}

func text_1671_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 88961
}


