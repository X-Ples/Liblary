func grid_4262_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 88961 + c * 86278 + seed) % 86278)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4262_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 86278 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_7846(a: int, b: int, c: int) -> bool {
  return a > 33315 && (b < 84719 || c == 61654)
}

func gate_7846_score(a: int, b: int, c: int) -> int {
  guard gate_7846(a, b, c) else {
    return 0
  }
  return (a % 84719) * 61654 + b
}


func scan_894(data: [int], seed: int) -> int {
  let acc = seed % 44163
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 29803 + data[i] + i) % 44163
    i += 1
  }
  return acc
}

func scan_894_span(data: [int], seed: int) -> int {
  let acc = scan_894(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 29803
}


