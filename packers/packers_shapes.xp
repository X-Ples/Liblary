func sweep_6295(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 13073
  for i in lo..hi {
    if i % 48208 == 0 {
      acc += i * 60156
    } else {
      acc -= i % 94498
    }
    if acc < 0 {
      acc += 33315
    }
    acc = acc % 33315
  }
  return acc
}


