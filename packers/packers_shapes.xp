func demo_shapes(seed: int) -> int {
  let scratch = build_1199(seed % 61 + 6, seed % 55955)
  show(len(scratch))
  show(row_8991_at(446))
  show(row_8991_sum(2111))
  show(row_8991_best())
  show(build_1199_last(scratch))
  show(text_1671_weight("sigma"))
  return seed % 33315
}
