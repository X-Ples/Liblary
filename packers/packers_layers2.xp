func demo_layers2(seed: int) -> int {
  let scratch = build_7696(seed % 61 + 6, seed % 35411)
  show(len(scratch))
  show(build_7696_last(scratch))
  show(sweep_1791(177, 540))
  show(check_681_chain(104))
  show(row_4166_at(2825))
  return seed % 95507
}
