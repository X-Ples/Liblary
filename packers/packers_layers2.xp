func build_7696(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 90104) % 46110)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 90104 + 41171) % 46110
    j += 1
  }
  return buf
}

func build_7696_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_1791(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 79296
  for i in lo..hi {
    if i % 4110 == 0 {
      acc += i * 90104
    } else {
      acc -= i % 21069
    }
    if acc < 0 {
      acc += 94771
    }
    acc = acc % 94771
  }
  return acc
}


func check_681(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 24711 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 80222) % 31485
    i += 1
  }
  return Ok(acc)
}

func check_681_chain(n: int) -> int {
  let picked = check_681(n)?
  return picked % 31485
}


func row_4166() -> [int] {
  return [3837, 168, 975, 2858, 1320, 1397, 2657, 2223, 3413, 391, 2175, 1270, 3622, 2396, 3196]
}

func row_4166_at(i: int) -> int {
  let row = row_4166()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4166_sum(limit: int) -> int {
  let row = row_4166()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4166_best() -> int {
  let row = row_4166()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_546(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_546_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_2569(a: int, b: int, c: int) -> bool {
  return a > 88728 && (b < 21069 || c == 57409)
}

func gate_2569_score(a: int, b: int, c: int) -> int {
  guard gate_2569(a, b, c) else {
    return 0
  }
  return (a % 21069) * 57409 + b
}


