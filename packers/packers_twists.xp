func row_7650() -> [int] {
  return [1418, 2943, 3061, 3783, 973, 3041, 589, 3854, 1336, 2970]
}

func row_7650_at(i: int) -> int {
  let row = row_7650()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7650_sum(limit: int) -> int {
  let row = row_7650()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7650_best() -> int {
  let row = row_7650()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


