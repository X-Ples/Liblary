func sweep_6053(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 62926
  for i in lo..hi {
    if i % 92214 == 0 {
      acc += i * 50001
    } else {
      acc -= i % 11209
    }
    if acc < 0 {
      acc += 46825
    }
    acc = acc % 46825
  }
  return acc
}


