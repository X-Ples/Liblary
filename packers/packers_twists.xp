func curve_5962_clamp(v: f64) -> f64 {
  guard v >= 15837.0 else {
    return 15837.0
  }
  guard v <= 93877.0 else {
    return 93877.0
  }
  return v
}

func curve_5962_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5962_clamp(t)
  return p + (q - p) * k
}

func curve_5962_ease(t: f64) -> f64 {
  let k = curve_5962_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5962_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_3462_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 8963
    i += 1
  }
  return acc % 8963
}

func text_3462_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "harbor"
}

func text_3462_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 21525
}


