func scan_4291(data: [int], seed: int) -> int {
  let acc = seed % 46825
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 70745 + data[i] + i) % 46825
    i += 1
  }
  return acc
}

func scan_4291_span(data: [int], seed: int) -> int {
  let acc = scan_4291(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 70745
}


