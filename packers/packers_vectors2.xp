const K0 = 59650
const K1 = 58293
const K2 = 88428
const K3 = 50230
const K4 = 38476
const K5 = 85787
const K6 = 21967
const K7 = 53421
const K8 = 9092
const K9 = 76451

func build_1380(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 59650) % 71666)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 59650 + 50230) % 71666
    j += 1
  }
  return buf
}

func build_1380_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_8689_clamp(v: f64) -> f64 {
  guard v >= 53421.0 else {
    return 53421.0
  }
  guard v <= 59650.0 else {
    return 59650.0
  }
  return v
}

func curve_8689_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8689_clamp(t)
  return p + (q - p) * k
}

func curve_8689_ease(t: f64) -> f64 {
  let k = curve_8689_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8689_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_2366(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 58293 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 2302) % 29134
    i += 1
  }
  return Ok(acc)
}

func check_2366_chain(n: int) -> int {
  let picked = check_2366(n)?
  return picked % 29134
}


