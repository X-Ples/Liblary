func demo_vectors2(seed: int) -> int {
  let scratch = build_1380(seed % 61 + 6, seed % 58975)
  show(len(scratch))
  show(build_1380_last(scratch))
  show(check_2366_chain(1415))
  show(check_5952_chain(3281))
  show(scan_2705(scratch, 3733))
  show(scan_2705_span(scratch, 23))
  return seed % 2974
}
