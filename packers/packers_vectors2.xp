func scan_2705(data: [int], seed: int) -> int {
  let acc = seed % 6550
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 2302 + data[i] + i) % 6550
    i += 1
  }
  return acc
}

func scan_2705_span(data: [int], seed: int) -> int {
  let acc = scan_2705(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 2302
}


func row_1008() -> [int] {
  return [3078, 4060, 3924, 598, 1548, 3489, 2303, 3696, 426, 1977, 3229, 3135, 1822, 1689]
}

func row_1008_at(i: int) -> int {
  let row = row_1008()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1008_sum(limit: int) -> int {
  let row = row_1008()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1008_best() -> int {
  let row = row_1008()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


