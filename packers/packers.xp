func build_218(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 94339) % 49819)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 94339 + 30374) % 49819
    j += 1
  }
  return buf
}

func build_218_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_5504(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5504_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func scan_6768(data: [int], seed: int) -> int {
  let acc = seed % 30588
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 15293 + data[i] + i) % 30588
    i += 1
  }
  return acc
}

func scan_6768_span(data: [int], seed: int) -> int {
  let acc = scan_6768(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 15293
}


func check_3065(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 60003 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 16722) % 90807
    i += 1
  }
  return Ok(acc)
}

func check_3065_chain(n: int) -> int {
  let picked = check_3065(n)?
  return picked % 90807
}


