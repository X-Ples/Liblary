func row_2245() -> [int] {
  return [3775, 4068, 3881, 2817, 623, 466, 168, 2954, 1778, 1570, 1220, 3165, 2457, 238, 3217, 2356]
}

func row_2245_at(i: int) -> int {
  let row = row_2245()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2245_sum(limit: int) -> int {
  let row = row_2245()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2245_best() -> int {
  let row = row_2245()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_1066_clamp(v: f64) -> f64 {
  guard v >= 11032.0 else {
    return 11032.0
  }
  guard v <= 94339.0 else {
    return 94339.0
  }
  return v
}

func curve_1066_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1066_clamp(t)
  return p + (q - p) * k
}

func curve_1066_ease(t: f64) -> f64 {
  let k = curve_1066_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1066_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


