func text_7747_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 60776
    i += 1
  }
  return acc % 60776
}

func text_7747_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "omega"
}

func text_7747_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 47525
}


