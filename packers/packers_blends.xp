func build_291(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 22223) % 44413)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 22223 + 18975) % 44413
    j += 1
  }
  return buf
}

func build_291_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_3204(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 14167
  for i in lo..hi {
    if i % 74761 == 0 {
      acc += i * 44413
    } else {
      acc -= i % 18801
    }
    if acc < 0 {
      acc += 68404
    }
    acc = acc % 68404
  }
  return acc
}


