func demo_blends(seed: int) -> int {
  let scratch = build_291(seed % 61 + 6, seed % 5468)
  show(len(scratch))
  show(build_291_last(scratch))
  show(sweep_3204(774, 3264))
  show(build_9882_last(scratch))
  show(gate_5213(1770, 2414, 3861))
  return seed % 61222
}
