func gate_5213(a: int, b: int, c: int) -> bool {
  return a > 57616 && (b < 5645 || c == 18801)
}

func gate_5213_score(a: int, b: int, c: int) -> int {
  guard gate_5213(a, b, c) else {
    return 0
  }
  return (a % 5645) * 18801 + b
}


func order_7264(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7264_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func scan_573(data: [int], seed: int) -> int {
  let acc = seed % 12150
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 68404 + data[i] + i) % 12150
    i += 1
  }
  return acc
}

func scan_573_span(data: [int], seed: int) -> int {
  let acc = scan_573(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 68404
}


func row_4673() -> [int] {
  return [434, 1295, 1164, 2374, 611, 914, 2889, 1531, 2741, 1342, 3203, 988, 134, 1977, 381, 3637, 3781, 3947, 1256, 792]
}

func row_4673_at(i: int) -> int {
  let row = row_4673()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4673_sum(limit: int) -> int {
  let row = row_4673()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4673_best() -> int {
  let row = row_4673()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


