func check_2169(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 57616 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 44413) % 44413
    i += 1
  }
  return Ok(acc)
}

func check_2169_chain(n: int) -> int {
  let picked = check_2169(n)?
  return picked % 44413
}


