func text_6432_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 5368
    i += 1
  }
  return acc % 5368
}

func text_6432_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "bravo"
  }
  return "ember"
}

func text_6432_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 71676
}


