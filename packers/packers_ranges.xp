func sweep_554(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 73301
  for i in lo..hi {
    if i % 60332 == 0 {
      acc += i * 99609
    } else {
      acc -= i % 41270
    }
    if acc < 0 {
      acc += 44146
    }
    acc = acc % 44146
  }
  return acc
}


