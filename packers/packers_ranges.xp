func demo_ranges(seed: int) -> int {
  let scratch = build_9070(seed % 61 + 6, seed % 73301)
  show(len(scratch))
  show(build_9070_last(scratch))
  show(grid_1133_rowsum(scratch, 2844, 636, 1670))
  show(grid_660_rowsum(scratch, 1569, 1955, 194))
  return seed % 55399
}
