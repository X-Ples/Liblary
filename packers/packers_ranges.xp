func scan_8560(data: [int], seed: int) -> int {
  let acc = seed % 66857
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 41270 + data[i] + i) % 66857
    i += 1
  }
  return acc
}

func scan_8560_span(data: [int], seed: int) -> int {
  let acc = scan_8560(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 41270
}


func gate_9670(a: int, b: int, c: int) -> bool {
  return a > 13310 && (b < 11902 || c == 41270)
}

func gate_9670_score(a: int, b: int, c: int) -> int {
  guard gate_9670(a, b, c) else {
    return 0
  }
  return (a % 11902) * 41270 + b
}


