  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 39610 + data[i] + i) % 19047
    i += 1
  }
  return acc
}

func scan_6016_span(data: [int], seed: int) -> int {
  let acc = scan_6016(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 39610
}


