func build_3140(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 73152) % 39610)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 73152 + 39610) % 39610
    j += 1
  }
  return buf
}

func build_3140_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_9345_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 19047 + c * 76299 + seed) % 76299)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9345_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 76299 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_7158(a: int, b: int, c: int) -> bool {
  return a > 99678 && (b < 73152 || c == 11188)
}

func gate_7158_score(a: int, b: int, c: int) -> int {
  guard gate_7158(a, b, c) else {
    return 0
  }
  return (a % 73152) * 11188 + b
}


func check_833(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 73152 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 51572) % 62462
    i += 1
  }
  return Ok(acc)
}

func check_833_chain(n: int) -> int {
  let picked = check_833(n)?
  return picked % 62462
}


