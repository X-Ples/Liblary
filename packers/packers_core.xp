func demo_core(seed: int) -> int {
  let scratch = build_3140(seed % 61 + 6, seed % 22362)
  show(len(scratch))
  show(build_3140_last(scratch))
  show(grid_9345_rowsum(scratch, 274, 551, 235))
  show(gate_7158(1797, 927, 208))
  show(gate_7158_score(1082, 3313, 2052))
  return seed % 17139
}
