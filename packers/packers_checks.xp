func sweep_9147(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 3915
  for i in lo..hi {
    if i % 53418 == 0 {
      acc += i * 40735
    } else {
      acc -= i % 7580
    }
    if acc < 0 {
      acc += 30139
    }
    acc = acc % 30139
  }
  return acc
}


