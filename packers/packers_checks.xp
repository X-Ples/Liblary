func row_5269() -> [int] {
  return [3861, 2082, 2365, 2963, 2535, 1990, 1835, 3872, 2288, 3510, 3348, 1450, 1868, 1434, 416, 1401, 3041, 884, 3512]
}

func row_5269_at(i: int) -> int {
  let row = row_5269()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5269_sum(limit: int) -> int {
  let row = row_5269()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5269_best() -> int {
  let row = row_5269()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_8097_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 82205 + c * 83704 + seed) % 83704)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8097_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 83704 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_3569(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 5889 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 12924) % 30139
    i += 1
  }
  return Ok(acc)
}

func check_3569_chain(n: int) -> int {
  let picked = check_3569(n)?
  return picked % 30139
}


