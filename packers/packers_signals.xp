func sweep_3084(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 58366
  for i in lo..hi {
    if i % 77582 == 0 {
      acc += i * 29090
    } else {
      acc -= i % 17631
    }
    if acc < 0 {
      acc += 94554
    }
    acc = acc % 94554
  }
  return acc
}


func grid_9802_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 26583 + c * 50553 + seed) % 50553)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9802_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 50553 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_6546_clamp(v: f64) -> f64 {
  guard v >= 18368.0 else {
    return 18368.0
  }
  guard v <= 47596.0 else {
    return 47596.0
  }
  return v
}

func curve_6546_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6546_clamp(t)
  return p + (q - p) * k
}

func curve_6546_ease(t: f64) -> f64 {
  let k = curve_6546_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6546_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


