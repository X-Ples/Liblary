func row_9711() -> [int] {
  return [992, 3262, 3718, 650, 2948, 3630, 3848, 1528, 374, 2913, 1610, 2777, 1630, 2337, 2770, 3950, 1806, 262]
}

func row_9711_at(i: int) -> int {
  let row = row_9711()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9711_sum(limit: int) -> int {
  let row = row_9711()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9711_best() -> int {
  let row = row_9711()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


