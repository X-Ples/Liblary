const K0 = 19321
const K1 = 50553
const K2 = 79208
const K3 = 78655
const K4 = 58366
const K5 = 18368

func gate_9520(a: int, b: int, c: int) -> bool {
  return a > 79208 && (b < 97850 || c == 94554)
}

func gate_9520_score(a: int, b: int, c: int) -> int {
  guard gate_9520(a, b, c) else {
    return 0
  }
  return (a % 97850) * 94554 + b
}


func scan_1760(data: [int], seed: int) -> int {
  let acc = seed % 19545
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 66957 + data[i] + i) % 19545
    i += 1
  }
  return acc
}

func scan_1760_span(data: [int], seed: int) -> int {
  let acc = scan_1760(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 66957
}


func build_1725(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 75137) % 58366)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 75137 + 71361) % 58366
    j += 1
  }
  return buf
}

func build_1725_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_6771(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6771_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


