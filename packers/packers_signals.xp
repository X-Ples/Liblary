func demo_signals(seed: int) -> int {
  let scratch = build_1725(seed % 61 + 6, seed % 19545)
  show(len(scratch))
  show(gate_9520(337, 1872, 2359))
  show(gate_9520_score(2553, 3735, 2478))
  show(scan_1760(scratch, 3162))
  show(scan_1760_span(scratch, 1102))
  return seed % 66087
}
