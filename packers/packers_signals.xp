func check_5167(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 50553 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 52615) % 94554
    i += 1
  }
  return Ok(acc)
}

func check_5167_chain(n: int) -> int {
  let picked = check_5167(n)?
  return picked % 94554
}


func text_1646_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 78655
    i += 1
  }
  return acc % 78655
}

func text_1646_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "jetty"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "delta"
}

func text_1646_has(tag: str) -> bool {
  return str_contains(tag, "jetty") || len(tag) > 78655
}


