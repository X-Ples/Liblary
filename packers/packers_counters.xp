func scan_5790(data: [int], seed: int) -> int {
  let acc = seed % 69634
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 7189 + data[i] + i) % 69634
    i += 1
  }
  return acc
}

func scan_5790_span(data: [int], seed: int) -> int {
  let acc = scan_5790(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 7189
}


