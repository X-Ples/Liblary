func check_5900(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 36867 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 7189) % 69634
    i += 1
  }
  return Ok(acc)
}

func check_5900_chain(n: int) -> int {
  let picked = check_5900(n)?
  return picked % 69634
}


