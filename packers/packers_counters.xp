func row_171() -> [int] {
  return [3470, 1944, 2983, 32, 1816, 1379, 335, 3132, 3182, 4038, 1770, 2436]
}

func row_171_at(i: int) -> int {
  let row = row_171()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_171_sum(limit: int) -> int {
  let row = row_171()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_171_best() -> int {
  let row = row_171()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_906_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 68090 + c * 69185 + seed) % 69185)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_906_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 69185 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_1940(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 66874) % 69291)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 66874 + 68090) % 69291
    j += 1
  }
  return buf
}

func build_1940_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_4121(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 63500
  for i in lo..hi {
    if i % 18575 == 0 {
      acc += i * 7322
    } else {
      acc -= i % 18575
    }
    if acc < 0 {
      acc += 7189
    }
    acc = acc % 7189
  }
  return acc
}


func gate_7062(a: int, b: int, c: int) -> bool {
  return a > 18575 && (b < 6854 || c == 76926)
}

func gate_7062_score(a: int, b: int, c: int) -> int {
  guard gate_7062(a, b, c) else {
    return 0
  }
  return (a % 6854) * 76926 + b
}


