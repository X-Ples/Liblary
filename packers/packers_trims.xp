func build_9512(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 64469) % 43738)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 64469 + 31064) % 43738
    j += 1
  }
  return buf
}

func build_9512_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_4198(data: [int], seed: int) -> int {
  let acc = seed % 42561
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 65138 + data[i] + i) % 42561
    i += 1
  }
  return acc
}

func scan_4198_span(data: [int], seed: int) -> int {
  let acc = scan_4198(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 65138
}


func row_4654() -> [int] {
  return [651, 3494, 2663, 1707, 3007, 3867, 3054, 826, 3194, 3732, 2056, 451, 3864, 1473, 741, 1164, 796, 1702, 872]
}

func row_4654_at(i: int) -> int {
  let row = row_4654()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4654_sum(limit: int) -> int {
  let row = row_4654()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4654_best() -> int {
  let row = row_4654()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_5099(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 31064
  for i in lo..hi {
    if i % 40486 == 0 {
      acc += i * 69074
    } else {
      acc -= i % 61769
    }
    if acc < 0 {
      acc += 65138
    }
    acc = acc % 65138
  }
  return acc
}


func grid_252_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 42561 + c * 61769 + seed) % 61769)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_252_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 61769 == want {
      total += acc
    }
    r += 1
  }
  return total
}


