func demo_trims(seed: int) -> int {
  let scratch = build_9512(seed % 61 + 6, seed % 50267)
  show(len(scratch))
  show(build_9512_last(scratch))
  show(scan_4198(scratch, 2915))
  show(scan_4198_span(scratch, 3750))
  show(row_4654_at(2751))
  return seed % 43738
}
