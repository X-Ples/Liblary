func demo_blocks(seed: int) -> int {
  let scratch = build_7905(seed % 61 + 6, seed % 75397)
  show(len(scratch))
  show(build_7905_last(scratch))
  show(row_1952_at(1921))
  show(row_1952_sum(559))
  show(row_1952_best())
