func scan_7807(data: [int], seed: int) -> int {
  let acc = seed % 24611
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 1328 + data[i] + i) % 24611
    i += 1
  }
  return acc
}

func scan_7807_span(data: [int], seed: int) -> int {
  let acc = scan_7807(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 1328
}


