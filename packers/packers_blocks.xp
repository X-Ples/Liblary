func check_7591(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 31701 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 34045) % 22217
    i += 1
  }
  return Ok(acc)
}

func check_7591_chain(n: int) -> int {
  let picked = check_7591(n)?
  return picked % 22217
}


func sweep_1397(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 19095
  for i in lo..hi {
    if i % 80440 == 0 {
      acc += i * 22955
    } else {
      acc -= i % 61479
    }
    if acc < 0 {
      acc += 13248
    }
    acc = acc % 13248
  }
  return acc
}


