func row_8939() -> [int] {
  return [1664, 2769, 602, 989, 186, 1804, 2224, 3665, 38, 764, 2203, 2932, 1863, 3862, 2415, 3714]
}

func row_8939_at(i: int) -> int {
  let row = row_8939()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8939_sum(limit: int) -> int {
  let row = row_8939()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8939_best() -> int {
  let row = row_8939()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


