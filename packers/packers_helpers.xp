func sweep_788(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 50986
  for i in lo..hi {
    if i % 50986 == 0 {
      acc += i * 11512
    } else {
      acc -= i % 47957
    }
    if acc < 0 {
      acc += 9352
    }
    acc = acc % 9352
  }
  return acc
}


