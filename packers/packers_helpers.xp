func demo_helpers(seed: int) -> int {
  let scratch = build_370(seed % 61 + 6, seed % 84571)
  show(len(scratch))
  show(text_1190_weight("quartz"))
  show(text_1190_label(1893))
  show(text_1190_has("ion"))
  show(scan_1237(scratch, 1173))
  show(scan_1237_span(scratch, 2833))
  show(build_370_last(scratch))
  return seed % 97784
}
