func text_1190_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 99987
    i += 1
  }
  return acc % 99987
}

func text_1190_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "omega"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "harbor"
}

func text_1190_has(tag: str) -> bool {
  return str_contains(tag, "omega") || len(tag) > 64242
}


func scan_1237(data: [int], seed: int) -> int {
  let acc = seed % 87893
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 62682 + data[i] + i) % 87893
    i += 1
  }
  return acc
}

func scan_1237_span(data: [int], seed: int) -> int {
  let acc = scan_1237(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 62682
}


