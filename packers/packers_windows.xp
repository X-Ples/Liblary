    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 78516 + 70969) % 83153
    j += 1
  }
  return buf
}

func build_138_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_4772_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 88383
    i += 1
  }
  return acc % 88383
}

func text_4772_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "talus"
}

func text_4772_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 88383
}


