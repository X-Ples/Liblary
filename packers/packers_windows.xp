func scan_5027(data: [int], seed: int) -> int {
  let acc = seed % 40735
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 13297 + data[i] + i) % 40735
    i += 1
  }
  return acc
}

func scan_5027_span(data: [int], seed: int) -> int {
  let acc = scan_5027(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 13297
}


func build_138(count: int, start: int) -> [int] {
