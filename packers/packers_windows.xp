func row_2027() -> [int] {
  return [1947, 297, 3025, 1458, 1662, 925, 1258, 2229, 873, 2532, 922, 168, 609]
}

func row_2027_at(i: int) -> int {
  let row = row_2027()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2027_sum(limit: int) -> int {
  let row = row_2027()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2027_best() -> int {
  let row = row_2027()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func demo_windows(seed: int) -> int {
  let scratch = build_138(seed % 61 + 6, seed % 38765)
  show(len(scratch))
  show(scan_5027(scratch, 2481))
  show(scan_5027_span(scratch, 244))
  show(build_138_last(scratch))
  show(text_4772_weight("flint"))
  show(text_4772_label(3917))
  return seed % 83153
}
