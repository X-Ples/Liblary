func sweep_8463(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 87267
  for i in lo..hi {
    if i % 13297 == 0 {
      acc += i * 3681
    } else {
      acc -= i % 88208
    }
    if acc < 0 {
      acc += 70969
    }
    acc = acc % 70969
  }
  return acc
}


