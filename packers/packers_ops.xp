func text_8250_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 14831
    i += 1
  }
  return acc % 14831
}

func text_8250_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "ridge"
}

func text_8250_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 41795
}


func demo_ops(seed: int) -> int {
  let scratch = build_6011(seed % 61 + 6, seed % 48749)
  show(len(scratch))
  show(build_6011_last(scratch))
  show(check_4705_chain(1373))
  show(grid_143_rowsum(scratch, 820, 1905, 2875))
  show(scan_5461(scratch, 1130))
  show(scan_5461_span(scratch, 856))
  show(order_5771_find(scratch, 3626))
  return seed % 42205
}
