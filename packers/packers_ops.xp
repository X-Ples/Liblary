func build_6011(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 63702) % 19058)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 63702 + 61179) % 19058
    j += 1
  }
  return buf
}

func build_6011_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_4705(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 63011 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 33342) % 85136
    i += 1
  }
  return Ok(acc)
}

func check_4705_chain(n: int) -> int {
  let picked = check_4705(n)?
  return picked % 85136
}


func curve_3925_clamp(v: f64) -> f64 {
  guard v >= 41795.0 else {
    return 41795.0
  }
  guard v <= 60948.0 else {
    return 60948.0
  }
  return v
}

func curve_3925_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3925_clamp(t)
  return p + (q - p) * k
}

func curve_3925_ease(t: f64) -> f64 {
  let k = curve_3925_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3925_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_143_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 26863 + c * 88582 + seed) % 88582)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_143_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 88582 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_5461(data: [int], seed: int) -> int {
  let acc = seed % 60948
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 45832 + data[i] + i) % 60948
    i += 1
  }
  return acc
}

func scan_5461_span(data: [int], seed: int) -> int {
  let acc = scan_5461(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 45832
}


func order_5771(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5771_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


