func row_4921() -> [int] {
  return [710, 2555, 2837, 1791, 1129, 622, 2690, 2707, 793, 337, 2016, 3236]
}

func row_4921_at(i: int) -> int {
  let row = row_4921()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4921_sum(limit: int) -> int {
  let row = row_4921()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4921_best() -> int {
  let row = row_4921()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


