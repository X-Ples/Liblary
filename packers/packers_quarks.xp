func scan_1980(data: [int], seed: int) -> int {
  let acc = seed % 46353
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 90311 + data[i] + i) % 46353
    i += 1
  }
  return acc
}

func scan_1980_span(data: [int], seed: int) -> int {
  let acc = scan_1980(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 90311
}


func text_8641_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 23232
    i += 1
  }
  return acc % 23232
}

func text_8641_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "ridge"
}

func text_8641_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 65225
}


func grid_9763_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 25637 + c * 86206 + seed) % 86206)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9763_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 86206 == want {
      total += acc
    }
    r += 1
  }
  return total
}


