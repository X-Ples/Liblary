func demo_reductions(seed: int) -> int {
  let scratch = build_8087(seed % 61 + 6, seed % 40645)
  show(len(scratch))
  show(build_8087_last(scratch))
  show(check_457_chain(2799))
  show(check_716_chain(3458))
  show(order_1670_find(scratch, 2729))
  show(order_2838_find(scratch, 2375))
  return seed % 43029
}
