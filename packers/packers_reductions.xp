func build_8087(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 50868) % 49137)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 50868 + 54887) % 49137
    j += 1
  }
  return buf
}

func build_8087_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_457(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 44102 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 47567) % 48530
    i += 1
  }
  return Ok(acc)
}

func check_457_chain(n: int) -> int {
  let picked = check_457(n)?
  return picked % 48530
}


