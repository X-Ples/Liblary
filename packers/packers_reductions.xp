func grid_9633_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 47567 + c * 36652 + seed) % 36652)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9633_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 36652 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_4066(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 46256
  for i in lo..hi {
