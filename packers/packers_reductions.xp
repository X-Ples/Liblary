func scan_3709(data: [int], seed: int) -> int {
  let acc = seed % 39039
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 53489 + data[i] + i) % 39039
    i += 1
  }
  return acc
}

func scan_3709_span(data: [int], seed: int) -> int {
  let acc = scan_3709(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 53489
}


func curve_5612_clamp(v: f64) -> f64 {
  guard v >= 40645.0 else {
    return 40645.0
  }
  guard v <= 53958.0 else {
    return 53958.0
  }
  return v
}

func curve_5612_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5612_clamp(t)
  return p + (q - p) * k
}

func curve_5612_ease(t: f64) -> f64 {
  let k = curve_5612_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5612_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


