func sweep_3894(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 90110
  for i in lo..hi {
    if i % 61181 == 0 {
      acc += i * 52838
    } else {
      acc -= i % 80270
    }
    if acc < 0 {
      acc += 2736
    }
    acc = acc % 2736
  }
  return acc
}


