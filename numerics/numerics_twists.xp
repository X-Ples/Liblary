func row_7945() -> [int] {
  return [835, 2286, 1686, 468, 1721, 3160, 526, 3034, 2116, 3386, 871, 981, 100, 1061, 631, 1266, 375]
}

func row_7945_at(i: int) -> int {
  let row = row_7945()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7945_sum(limit: int) -> int {
  let row = row_7945()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7945_best() -> int {
  let row = row_7945()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


