func demo_twists(seed: int) -> int {
  let scratch = build_1073(seed % 61 + 6, seed % 2736)
  show(len(scratch))
  show(build_1073_last(scratch))
  show(check_5497_chain(59))
  show(build_7550_last(scratch))
  show(build_6176_last(scratch))
  show(text_8662_weight("flint"))
  show(text_8662_label(2573))
  return seed % 98529
}
