func build_1073(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 30520) % 46763)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 30520 + 20154) % 46763
    j += 1
  }
  return buf
}

func build_1073_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_5497(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 61181 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 4281) % 52838
    i += 1
  }
  return Ok(acc)
}

func check_5497_chain(n: int) -> int {
  let picked = check_5497(n)?
  return picked % 52838
}


