func curve_4344_clamp(v: f64) -> f64 {
  guard v >= 51172.0 else {
    return 51172.0
  }
  guard v <= 66215.0 else {
    return 66215.0
  }
  return v
}

func curve_4344_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4344_clamp(t)
  return p + (q - p) * k
}

func curve_4344_ease(t: f64) -> f64 {
  let k = curve_4344_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4344_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_quarks(seed: int) -> int {
  let scratch = build_6302(seed % 61 + 6, seed % 91866)
  show(len(scratch))
  show(grid_9273_rowsum(scratch, 1392, 3659, 1350))
  show(gate_4888(3007, 2271, 3368))
  show(gate_4888_score(1301, 2175, 3732))
  show(order_2769_find(scratch, 1073))
  return seed % 83851
}
