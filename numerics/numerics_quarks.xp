func grid_9273_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 16825 + c * 2187 + seed) % 2187)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9273_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 2187 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_4888(a: int, b: int, c: int) -> bool {
  return a > 77715 && (b < 69771 || c == 2805)
}

func gate_4888_score(a: int, b: int, c: int) -> int {
  guard gate_4888(a, b, c) else {
    return 0
  }
  return (a % 69771) * 2805 + b
}


func order_2769(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2769_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func row_3611() -> [int] {
  return [1761, 2103, 2833, 1963, 2939, 2649, 2478, 1753, 2302, 4030, 1505, 3049, 3400, 1955, 2962, 233, 967, 3281]
}

func row_3611_at(i: int) -> int {
  let row = row_3611()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3611_sum(limit: int) -> int {
  let row = row_3611()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3611_best() -> int {
  let row = row_3611()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


