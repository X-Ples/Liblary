func check_579(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 32816 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 3801) % 2805
    i += 1
  }
  return Ok(acc)
}

func check_579_chain(n: int) -> int {
  let picked = check_579(n)?
  return picked % 2805
}


func text_8223_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 77709
    i += 1
  }
  return acc % 77709
}

func text_8223_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "mesa"
}

func text_8223_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 25887
}


func sweep_1643(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 32721
  for i in lo..hi {
    if i % 10045 == 0 {
      acc += i * 2805
    } else {
      acc -= i % 16825
    }
    if acc < 0 {
      acc += 83851
    }
    acc = acc % 83851
  }
  return acc
}


