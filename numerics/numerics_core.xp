func curve_8161_clamp(v: f64) -> f64 {
  guard v >= 6789.0 else {
    return 6789.0
  }
  guard v <= 38905.0 else {
    return 38905.0
  }
  return v
}

func curve_8161_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8161_clamp(t)
  return p + (q - p) * k
}

func curve_8161_ease(t: f64) -> f64 {
  let k = curve_8161_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8161_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_core(seed: int) -> int {
  let scratch = build_3193(seed % 61 + 6, seed % 66254)
  show(len(scratch))
  show(scan_2214(scratch, 3611))
  show(scan_2214_span(scratch, 3681))
  show(sweep_1556(3316, 143))
  show(text_6866_weight("lumen"))
  show(text_6866_label(1550))
  return seed % 81666
}
