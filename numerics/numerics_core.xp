func scan_2214(data: [int], seed: int) -> int {
  let acc = seed % 13508
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 9184 + data[i] + i) % 13508
    i += 1
  }
  return acc
}

func scan_2214_span(data: [int], seed: int) -> int {
  let acc = scan_2214(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 9184
}


func sweep_1556(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 6789
  for i in lo..hi {
    if i % 4894 == 0 {
      acc += i * 30593
    } else {
      acc -= i % 57456
    }
    if acc < 0 {
      acc += 42590
    }
    acc = acc % 42590
  }
  return acc
}


func text_6866_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 25762
    i += 1
  }
  return acc % 25762
}

func text_6866_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ridge"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "mesa"
}

func text_6866_has(tag: str) -> bool {
  return str_contains(tag, "ridge") || len(tag) > 30593
}


func check_3837(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 6789 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 40081) % 90827
    i += 1
  }
  return Ok(acc)
}

func check_3837_chain(n: int) -> int {
  let picked = check_3837(n)?
  return picked % 90827
}


func build_3193(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 20) % 20716)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 20 + 87723) % 20716
    j += 1
  }
  return buf
}

func build_3193_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_8695_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 6789 + c * 6789 + seed) % 6789)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8695_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 6789 == want {
      total += acc
    }
    r += 1
  }
  return total
}


