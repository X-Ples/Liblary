func sweep_6598(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 46600
  for i in lo..hi {
    if i % 3801 == 0 {
      acc += i * 3980
    } else {
      acc -= i % 4192
    }
    if acc < 0 {
      acc += 73817
    }
    acc = acc % 73817
  }
  return acc
}


