func scan_2312(data: [int], seed: int) -> int {
  let acc = seed % 34092
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 73817 + data[i] + i) % 34092
    i += 1
  }
  return acc
}

func scan_2312_span(data: [int], seed: int) -> int {
  let acc = scan_2312(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 73817
}


