func check_3488(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 49859 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 79723) % 11422
    i += 1
  }
  return Ok(acc)
}

func check_3488_chain(n: int) -> int {
  let picked = check_3488(n)?
  return picked % 11422
}


func demo_offsets(seed: int) -> int {
  let scratch = build_6013(seed % 61 + 6, seed % 56766)
  show(len(scratch))
  show(build_6013_last(scratch))
  show(row_3299_at(1156))
  show(row_3299_sum(1107))
  show(row_3299_best())
  return seed % 11422
}
