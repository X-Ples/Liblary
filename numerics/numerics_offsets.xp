func build_6013(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 700) % 43151)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 700 + 84336) % 43151
    j += 1
  }
  return buf
}

func build_6013_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_413_clamp(v: f64) -> f64 {
  guard v >= 63351.0 else {
    return 63351.0
  }
  guard v <= 84336.0 else {
    return 84336.0
  }
  return v
}

func curve_413_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_413_clamp(t)
  return p + (q - p) * k
}

func curve_413_ease(t: f64) -> f64 {
  let k = curve_413_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_413_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_3299() -> [int] {
  return [1693, 2106, 3132, 3927, 3082, 1916, 1676, 3185, 1887, 3331, 338, 1400]
}

func row_3299_at(i: int) -> int {
  let row = row_3299()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3299_sum(limit: int) -> int {
  let row = row_3299()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3299_best() -> int {
  let row = row_3299()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


