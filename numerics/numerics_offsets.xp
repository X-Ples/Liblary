func grid_646_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 8675 + c * 3801 + seed) % 3801)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_646_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 3801 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_699(a: int, b: int, c: int) -> bool {
