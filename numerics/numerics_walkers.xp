func sweep_2231(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 34964
  for i in lo..hi {
    if i % 19620 == 0 {
      acc += i * 41051
    } else {
      acc -= i % 67929
    }
    if acc < 0 {
      acc += 19620
    }
    acc = acc % 19620
  }
  return acc
}


