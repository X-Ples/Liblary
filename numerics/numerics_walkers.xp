func build_9613(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 36121) % 67885)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 36121 + 67885) % 67885
    j += 1
  }
  return buf
}

func build_9613_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_730(data: [int], seed: int) -> int {
  let acc = seed % 85997
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 36578 + data[i] + i) % 85997
    i += 1
  }
  return acc
}

func scan_730_span(data: [int], seed: int) -> int {
  let acc = scan_730(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 36578
}


func row_266() -> [int] {
