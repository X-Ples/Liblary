func demo_walkers(seed: int) -> int {
  let scratch = build_9613(seed % 61 + 6, seed % 50590)
  show(len(scratch))
  show(build_9613_last(scratch))
  show(scan_730(scratch, 1951))
  show(scan_730_span(scratch, 3532))
  show(row_266_at(2137))
  return seed % 50590
}
