}

func row_266_at(i: int) -> int {
  let row = row_266()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_266_sum(limit: int) -> int {
  let row = row_266()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_266_best() -> int {
  let row = row_266()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


