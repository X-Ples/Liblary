func demo_pickers(seed: int) -> int {
  let scratch = build_3784(seed % 61 + 6, seed % 68222)
  show(len(scratch))
  show(build_3784_last(scratch))
  show(grid_8374_rowsum(scratch, 2490, 3508, 1793))
  show(row_5879_at(3412))
  show(row_5879_sum(2008))
  show(row_5879_best())
  return seed % 75536
}
