func check_3508(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 87614 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 89940) % 50953
    i += 1
  }
  return Ok(acc)
}

func check_3508_chain(n: int) -> int {
  let picked = check_3508(n)?
  return picked % 50953
}


