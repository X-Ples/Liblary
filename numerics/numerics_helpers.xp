func row_2952() -> [int] {
  return [1753, 328, 1336, 1043, 558, 2939, 3727, 3510, 1618, 2063, 783, 3205, 1590, 22]
}

func row_2952_at(i: int) -> int {
  let row = row_2952()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2952_sum(limit: int) -> int {
  let row = row_2952()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2952_best() -> int {
  let row = row_2952()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


