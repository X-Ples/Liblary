func check_9163(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 8953 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 8620) % 95533
    i += 1
  }
  return Ok(acc)
}

func check_9163_chain(n: int) -> int {
  let picked = check_9163(n)?
  return picked % 95533
}


