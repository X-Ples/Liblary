func check_4512(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 53724 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 36608) % 51334
    i += 1
  }
  return Ok(acc)
}

func check_4512_chain(n: int) -> int {
  let picked = check_4512(n)?
  return picked % 51334
}


