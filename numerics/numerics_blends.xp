func sweep_5285(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 54405
  for i in lo..hi {
    if i % 20000 == 0 {
      acc += i * 95991
    } else {
      acc -= i % 57742
    }
    if acc < 0 {
      acc += 38751
    }
    acc = acc % 38751
  }
  return acc
}


