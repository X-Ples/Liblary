func check_8715(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 48786 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 87927) % 88744
    i += 1
  }
  return Ok(acc)
}

func check_8715_chain(n: int) -> int {
  let picked = check_8715(n)?
  return picked % 88744
}


