func row_3937() -> [int] {
  return [1136, 4015, 3311, 536, 49, 616, 1165, 1125, 3239, 619, 1358]
}

func row_3937_at(i: int) -> int {
  let row = row_3937()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3937_sum(limit: int) -> int {
  let row = row_3937()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3937_best() -> int {
  let row = row_3937()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


