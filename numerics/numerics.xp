func scan_1028(data: [int], seed: int) -> int {
  let acc = seed % 92461
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 92461 + data[i] + i) % 92461
    i += 1
  }
  return acc
}

func scan_1028_span(data: [int], seed: int) -> int {
  let acc = scan_1028(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 92461
}


