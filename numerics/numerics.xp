const K0 = 50738
const K1 = 95342
const K2 = 65548
const K3 = 49636
const K4 = 7733
const K5 = 1229
const K6 = 86171
const K7 = 35734
const K8 = 30333

func build_7657(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 50738) % 27466)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 50738 + 86171) % 27466
    j += 1
  }
  return buf
}

func build_7657_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_997(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 20601
  for i in lo..hi {
    if i % 92461 == 0 {
      acc += i * 27466
    } else {
      acc -= i % 62779
    }
    if acc < 0 {
      acc += 27466
    }
    acc = acc % 27466
  }
  return acc
}


func curve_5730_clamp(v: f64) -> f64 {
  guard v >= 1229.0 else {
    return 1229.0
  }
  guard v <= 49636.0 else {
    return 49636.0
  }
  return v
}

func curve_5730_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5730_clamp(t)
  return p + (q - p) * k
}

func curve_5730_ease(t: f64) -> f64 {
  let k = curve_5730_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5730_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_3582(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 95342 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 7733) % 76207
    i += 1
  }
  return Ok(acc)
}

func check_3582_chain(n: int) -> int {
  let picked = check_3582(n)?
  return picked % 76207
}


