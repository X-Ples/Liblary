func build_3520(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 4143) % 92230)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 4143 + 92230) % 92230
    j += 1
  }
  return buf
}

func build_3520_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_3657_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 54520
    i += 1
  }
  return acc % 54520
}

func text_3657_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "bravo"
}

func text_3657_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 29621
}


func grid_2365_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 77388 + c * 91121 + seed) % 91121)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2365_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 91121 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_9062_clamp(v: f64) -> f64 {
  guard v >= 17973.0 else {
    return 17973.0
  }
  guard v <= 46524.0 else {
    return 46524.0
  }
  return v
}

func curve_9062_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9062_clamp(t)
  return p + (q - p) * k
}

func curve_9062_ease(t: f64) -> f64 {
  let k = curve_9062_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9062_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


