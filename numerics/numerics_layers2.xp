func demo_layers2(seed: int) -> int {
  let scratch = build_7214(seed % 61 + 6, seed % 11452)
  show(len(scratch))
  show(build_7214_last(scratch))
  show(grid_3883_rowsum(scratch, 899, 693, 2750))
  show(build_473_last(scratch))
  show(grid_1892_rowsum(scratch, 1755, 2561, 3457))
