func check_5233(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 51315 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 95777) % 33431
    i += 1
  }
  return Ok(acc)
}

func check_5233_chain(n: int) -> int {
  let picked = check_5233(n)?
  return picked % 33431
}


