func sweep_2716(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 26940
  for i in lo..hi {
    if i % 9136 == 0 {
      acc += i * 76160
    } else {
      acc -= i % 51315
    }
    if acc < 0 {
      acc += 37095
    }
    acc = acc % 37095
  }
  return acc
}


