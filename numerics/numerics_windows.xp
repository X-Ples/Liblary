func curve_2340_clamp(v: f64) -> f64 {
  guard v >= 51315.0 else {
    return 51315.0
  }
  guard v <= 54576.0 else {
    return 54576.0
  }
  return v
}

func curve_2340_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2340_clamp(t)
  return p + (q - p) * k
}

func curve_2340_ease(t: f64) -> f64 {
  let k = curve_2340_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2340_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_3176(a: int, b: int, c: int) -> bool {
  return a > 14913 && (b < 70840 || c == 17159)
}

func gate_3176_score(a: int, b: int, c: int) -> int {
  guard gate_3176(a, b, c) else {
    return 0
  }
  return (a % 70840) * 17159 + b
}


