func demo_windows(seed: int) -> int {
  let scratch = build_5502(seed % 61 + 6, seed % 53375)
  show(len(scratch))
  show(grid_6784_rowsum(scratch, 573, 2300, 2271))
  show(build_5502_last(scratch))
  show(build_7292_last(scratch))
  show(row_9565_at(3499))
  return seed % 25102
}
