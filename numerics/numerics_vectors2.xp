func demo_vectors2(seed: int) -> int {
  let scratch = build_4743(seed % 61 + 6, seed % 74639)
  show(len(scratch))
  show(check_2791_chain(443))
  show(text_5292_weight("nova"))
  show(text_5292_label(2042))
  show(text_5292_has("quartz"))
  show(build_4743_last(scratch))
  show(grid_4825_rowsum(scratch, 1248, 492, 671))
  return seed % 62492
}
