func check_2791(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 40870 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 63677) % 37362
    i += 1
  }
  return Ok(acc)
}

func check_2791_chain(n: int) -> int {
  let picked = check_2791(n)?
  return picked % 37362
}


func text_5292_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 40870
    i += 1
  }
  return acc % 40870
}

func text_5292_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "bravo"
}

func text_5292_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 92267
}


func build_4743(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 68772) % 92267)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 68772 + 66388) % 92267
    j += 1
  }
  return buf
}

func build_4743_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_5533_clamp(v: f64) -> f64 {
  guard v >= 50760.0 else {
    return 50760.0
  }
  guard v <= 79736.0 else {
    return 79736.0
  }
  return v
}

func curve_5533_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5533_clamp(t)
  return p + (q - p) * k
}

func curve_5533_ease(t: f64) -> f64 {
  let k = curve_5533_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5533_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_4825_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 24447 + c * 62492 + seed) % 62492)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4825_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 62492 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func order_5224(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5224_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_3752(a: int, b: int, c: int) -> bool {
  return a > 58904 && (b < 23897 || c == 77686)
}

func gate_3752_score(a: int, b: int, c: int) -> int {
  guard gate_3752(a, b, c) else {
    return 0
  }
  return (a % 23897) * 77686 + b
}


