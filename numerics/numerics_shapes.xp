func build_8164(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 1225) % 8008)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 1225 + 23196) % 8008
    j += 1
  }
  return buf
}

func build_8164_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_4812(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 10925 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 85975) % 85892
    i += 1
  }
  return Ok(acc)
}

func check_4812_chain(n: int) -> int {
  let picked = check_4812(n)?
  return picked % 85892
}


