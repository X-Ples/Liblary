func demo_shapes(seed: int) -> int {
  let scratch = build_8164(seed % 61 + 6, seed % 7608)
  show(len(scratch))
  show(order_7025_find(scratch, 458))
  show(sweep_7301(76, 2620))
  show(sweep_3607(2653, 3325))
  return seed % 19970
}
