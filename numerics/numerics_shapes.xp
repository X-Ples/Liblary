func row_6761() -> [int] {
  return [2805, 3447, 2063, 1025, 3420, 2019, 1876, 3262, 954, 2117, 2444, 1271, 4017, 3916, 3983, 3173, 2403]
}

func row_6761_at(i: int) -> int {
  let row = row_6761()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6761_sum(limit: int) -> int {
  let row = row_6761()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6761_best() -> int {
  let row = row_6761()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_6576_clamp(v: f64) -> f64 {
  guard v >= 19970.0 else {
    return 19970.0
  }
  guard v <= 26087.0 else {
    return 26087.0
  }
  return v
}

func curve_6576_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6576_clamp(t)
  return p + (q - p) * k
}

func curve_6576_ease(t: f64) -> f64 {
  let k = curve_6576_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6576_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


