func build_8575(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 7406) % 96270)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 7406 + 58944) % 96270
    j += 1
  }
  return buf
}

func build_8575_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_4501(data: [int], seed: int) -> int {
  let acc = seed % 15771
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 93558 + data[i] + i) % 15771
    i += 1
  }
  return acc
}

func scan_4501_span(data: [int], seed: int) -> int {
  let acc = scan_4501(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 93558
}


func gate_1189(a: int, b: int, c: int) -> bool {
  return a > 76290 && (b < 42482 || c == 7406)
}

func gate_1189_score(a: int, b: int, c: int) -> int {
  guard gate_1189(a, b, c) else {
    return 0
  }
  return (a % 42482) * 7406 + b
}


