func demo_blocks(seed: int) -> int {
  let scratch = build_8575(seed % 61 + 6, seed % 11510)
  show(len(scratch))
  show(build_8575_last(scratch))
  show(scan_4501(scratch, 3511))
  show(scan_4501_span(scratch, 3243))
  show(gate_1189(1141, 1520, 1556))
  return seed % 11510
}
