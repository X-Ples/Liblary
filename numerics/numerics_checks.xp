func row_5842() -> [int] {
  return [3498, 3445, 2443, 3021, 776, 2626, 3743, 1705, 266, 3906]
}

func row_5842_at(i: int) -> int {
  let row = row_5842()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5842_sum(limit: int) -> int {
  let row = row_5842()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5842_best() -> int {
  let row = row_5842()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_7958(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 85586) % 51231)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 85586 + 56901) % 51231
    j += 1
  }
  return buf
}

func build_7958_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_4497(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4497_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func scan_1901(data: [int], seed: int) -> int {
  let acc = seed % 7306
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 63243 + data[i] + i) % 7306
    i += 1
  }
  return acc
}

func scan_1901_span(data: [int], seed: int) -> int {
  let acc = scan_1901(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 63243
}


func check_2766(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 7000 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 93811) % 85586
    i += 1
  }
  return Ok(acc)
}

func check_2766_chain(n: int) -> int {
  let picked = check_2766(n)?
  return picked % 85586
}


func grid_4737_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 22082 + c * 41308 + seed) % 41308)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4737_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 41308 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_9718(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 1662
  for i in lo..hi {
    if i % 7000 == 0 {
      acc += i * 77772
    } else {
      acc -= i % 60989
    }
    if acc < 0 {
      acc += 83056
    }
    acc = acc % 83056
  }
  return acc
}


