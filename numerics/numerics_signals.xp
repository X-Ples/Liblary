func sweep_2524(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 34988
  for i in lo..hi {
    if i % 29051 == 0 {
      acc += i * 87530
    } else {
      acc -= i % 60615
    }
    if acc < 0 {
      acc += 56180
    }
    acc = acc % 56180
  }
  return acc
}


