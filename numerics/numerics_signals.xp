func curve_8866_clamp(v: f64) -> f64 {
  guard v >= 59789.0 else {
    return 59789.0
  }
  guard v <= 70284.0 else {
    return 70284.0
  }
  return v
}

func curve_8866_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8866_clamp(t)
  return p + (q - p) * k
}

func curve_8866_ease(t: f64) -> f64 {
  let k = curve_8866_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8866_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_4562(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 59789) % 38314)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 59789 + 43560) % 38314
    j += 1
  }
  return buf
}

func build_4562_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_1995_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 68345 + c * 28030 + seed) % 28030)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1995_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 28030 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_3144(data: [int], seed: int) -> int {
  let acc = seed % 50433
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 29051 + data[i] + i) % 50433
    i += 1
  }
  return acc
}

func scan_3144_span(data: [int], seed: int) -> int {
  let acc = scan_3144(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 29051
}


