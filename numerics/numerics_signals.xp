func demo_signals(seed: int) -> int {
  let scratch = build_4562(seed % 61 + 6, seed % 51969)
  show(len(scratch))
  show(build_4562_last(scratch))
  show(grid_1995_rowsum(scratch, 3104, 973, 2211))
  show(scan_3144(scratch, 3951))
  show(scan_3144_span(scratch, 3623))
  show(grid_4168_rowsum(scratch, 2907, 1501, 1132))
  return seed % 52782
}
