}

func row_6433_at(i: int) -> int {
  let row = row_6433()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6433_sum(limit: int) -> int {
  let row = row_6433()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6433_best() -> int {
  let row = row_6433()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_5523_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 77572
    i += 1
  }
  return acc % 77572
}

func text_5523_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "bravo"
}

func text_5523_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 43368
}


