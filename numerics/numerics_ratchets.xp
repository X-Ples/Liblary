func sweep_3751(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 92546
  for i in lo..hi {
    if i % 36519 == 0 {
      acc += i * 46508
    } else {
      acc -= i % 26479
    }
    if acc < 0 {
      acc += 64515
    }
    acc = acc % 64515
  }
  return acc
}


func row_2194() -> [int] {
  return [955, 1626, 2596, 3411, 2388, 1203, 1236, 503, 1525, 1533, 82, 171, 6, 548, 185, 2955, 2752]
}

func row_2194_at(i: int) -> int {
  let row = row_2194()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2194_sum(limit: int) -> int {
  let row = row_2194()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2194_best() -> int {
  let row = row_2194()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_3588_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 26368 + c * 91949 + seed) % 91949)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3588_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 91949 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_6110(a: int, b: int, c: int) -> bool {
  return a > 19519 && (b < 69114 || c == 6429)
}

func gate_6110_score(a: int, b: int, c: int) -> int {
  guard gate_6110(a, b, c) else {
    return 0
  }
  return (a % 69114) * 6429 + b
}


