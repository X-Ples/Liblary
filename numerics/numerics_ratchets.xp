func demo_ratchets(seed: int) -> int {
  let scratch = build_1414(seed % 61 + 6, seed % 70565)
  show(len(scratch))
  show(build_1414_last(scratch))
  show(order_1992_find(scratch, 133))
  show(order_414_find(scratch, 2436))
  show(sweep_3751(555, 3191))
  return seed % 88784
}
