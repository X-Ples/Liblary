func text_7959_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "mesa"
}

func text_7959_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 36519
}


