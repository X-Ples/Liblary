func scan_9178(data: [int], seed: int) -> int {
  let acc = seed % 24833
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 1342 + data[i] + i) % 24833
    i += 1
  }
  return acc
}

func scan_9178_span(data: [int], seed: int) -> int {
  let acc = scan_9178(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 1342
}


func sweep_9306(lo: int, hi: int) -> int {
