}


func demo_counters(seed: int) -> int {
  let scratch = build_8120(seed % 61 + 6, seed % 411)
  show(len(scratch))
  show(grid_8340_rowsum(scratch, 1225, 2490, 3774))
  show(build_8120_last(scratch))
  show(row_6907_at(1102))
  show(row_6907_sum(1165))
  return seed % 61718
}
