const K0 = 44938
const K1 = 61718
const K2 = 70152
const K3 = 22927
const K4 = 97580
const K5 = 29706
const K6 = 88434

func grid_8340_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 61272 + c * 29706 + seed) % 29706)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8340_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 29706 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_8120(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 67962) % 44938)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 67962 + 35664) % 44938
    j += 1
  }
  return buf
}

func build_8120_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_6907() -> [int] {
  return [2615, 2956, 1529, 1035, 2584, 2604, 3674, 1286, 2666, 2028, 2727, 1467, 1542, 2423, 1904, 3001, 1943, 317]
}

func row_6907_at(i: int) -> int {
  let row = row_6907()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6907_sum(limit: int) -> int {
  let row = row_6907()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6907_best() -> int {
  let row = row_6907()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


