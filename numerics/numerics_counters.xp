func check_2196(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 22927 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 4990) % 22927
    i += 1
  }
  return Ok(acc)
}

func check_2196_chain(n: int) -> int {
  let picked = check_2196(n)?
  return picked % 22927
}


