func sweep_2475(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 86398
  for i in lo..hi {
    if i % 63685 == 0 {
      acc += i * 89586
    } else {
      acc -= i % 6735
    }
    if acc < 0 {
      acc += 63685
    }
    acc = acc % 63685
  }
  return acc
}


func curve_5083_clamp(v: f64) -> f64 {
  guard v >= 7959.0 else {
    return 7959.0
  }
  guard v <= 51752.0 else {
    return 51752.0
  }
  return v
}

func curve_5083_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5083_clamp(t)
  return p + (q - p) * k
}

func curve_5083_ease(t: f64) -> f64 {
  let k = curve_5083_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5083_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


