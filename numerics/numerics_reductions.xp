func demo_reductions(seed: int) -> int {
  let scratch = build_3838(seed % 61 + 6, seed % 89552)
  show(len(scratch))
  show(grid_3906_rowsum(scratch, 2915, 489, 2568))
  show(build_3838_last(scratch))
  show(sweep_2475(1110, 3099))
  show(build_4905_last(scratch))
  return seed % 49424
}
