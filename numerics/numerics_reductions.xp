func check_9872(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 61645 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 69099) % 89586
    i += 1
  }
  return Ok(acc)
}

func check_9872_chain(n: int) -> int {
  let picked = check_9872(n)?
  return picked % 89586
}


