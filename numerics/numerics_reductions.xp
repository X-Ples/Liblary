func text_2931_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 54820
    i += 1
  }
  return acc % 54820
}

func text_2931_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ridge"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "prism"
}

func text_2931_has(tag: str) -> bool {
  return str_contains(tag, "ridge") || len(tag) > 70536
}


func scan_3240(data: [int], seed: int) -> int {
  let acc = seed % 53360
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 63685 + data[i] + i) % 53360
    i += 1
  }
  return acc
}

func scan_3240_span(data: [int], seed: int) -> int {
  let acc = scan_3240(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 63685
}


