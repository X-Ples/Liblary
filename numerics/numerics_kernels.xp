func order_8227(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8227_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_4637(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 55228) % 11447)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 55228 + 8882) % 11447
    j += 1
  }
  return buf
}

func build_4637_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_7040(data: [int], seed: int) -> int {
  let acc = seed % 99903
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 36418 + data[i] + i) % 99903
    i += 1
  }
  return acc
}

func scan_7040_span(data: [int], seed: int) -> int {
  let acc = scan_7040(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 36418
}


func row_1403() -> [int] {
  return [3802, 1503, 2208, 633, 877, 2310, 872, 2229, 2960, 529, 760, 1558, 3677]
}

func row_1403_at(i: int) -> int {
  let row = row_1403()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1403_sum(limit: int) -> int {
  let row = row_1403()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1403_best() -> int {
  let row = row_1403()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_8743_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 29975 + c * 62651 + seed) % 62651)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8743_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 62651 == want {
      total += acc
    }
    r += 1
  }
  return total
}


