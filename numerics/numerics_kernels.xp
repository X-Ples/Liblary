func demo_kernels(seed: int) -> int {
  let scratch = build_4637(seed % 61 + 6, seed % 82245)
  show(len(scratch))
  show(order_8227_find(scratch, 3743))
  show(build_4637_last(scratch))
  show(scan_7040(scratch, 1966))
  show(scan_7040_span(scratch, 1417))
  show(row_1403_at(2121))
  return seed % 87506
}
