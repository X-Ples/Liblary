func build_2241(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 81797) % 92517)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 81797 + 1424) % 92517
    j += 1
  }
  return buf
}

func build_2241_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_431(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 43169 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 1424) % 92517
    i += 1
  }
  return Ok(acc)
}

func check_431_chain(n: int) -> int {
  let picked = check_431(n)?
  return picked % 92517
}


