func curve_7227_clamp(v: f64) -> f64 {
  guard v >= 22348.0 else {
    return 22348.0
  }
  guard v <= 38369.0 else {
    return 38369.0
  }
  return v
}

func curve_7227_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7227_clamp(t)
  return p + (q - p) * k
}

func curve_7227_ease(t: f64) -> f64 {
  let k = curve_7227_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7227_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_9853(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9853_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_6897(a: int, b: int, c: int) -> bool {
  return a > 1447 && (b < 43169 || c == 39291)
}

func gate_6897_score(a: int, b: int, c: int) -> int {
  guard gate_6897(a, b, c) else {
    return 0
  }
  return (a % 43169) * 39291 + b
}


func text_8149_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 92732
    i += 1
  }
  return acc % 92732
}

func text_8149_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "ion"
}

func text_8149_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 10139
}


