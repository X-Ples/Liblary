func sweep_8886(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 99058
  for i in lo..hi {
    if i % 10139 == 0 {
      acc += i * 99058
    } else {
      acc -= i % 11508
    }
    if acc < 0 {
      acc += 1424
    }
    acc = acc % 1424
  }
  return acc
}


