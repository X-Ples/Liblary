func row_635() -> [int] {
  return [622, 2596, 2780, 3504, 3589, 2772, 1921, 1682, 636, 1941, 995, 2350, 339, 1349]
}

func row_635_at(i: int) -> int {
  let row = row_635()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_635_sum(limit: int) -> int {
  let row = row_635()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_635_best() -> int {
  let row = row_635()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


