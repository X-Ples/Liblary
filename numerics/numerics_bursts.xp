func demo_bursts(seed: int) -> int {
  let scratch = build_2241(seed % 61 + 6, seed % 99058)
  show(len(scratch))
  show(build_2241_last(scratch))
  show(check_431_chain(3260))
  show(build_8542_last(scratch))
  show(order_9853_find(scratch, 908))
  return seed % 43169
}
