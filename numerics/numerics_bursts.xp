func scan_7853(data: [int], seed: int) -> int {
  let acc = seed % 27499
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 28872 + data[i] + i) % 27499
    i += 1
  }
  return acc
}

func scan_7853_span(data: [int], seed: int) -> int {
  let acc = scan_7853(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 28872
}


