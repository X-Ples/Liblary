func sweep_4985(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 7813
  for i in lo..hi {
    if i % 76235 == 0 {
      acc += i * 63732
    } else {
      acc -= i % 5948
    }
    if acc < 0 {
      acc += 56126
    }
    acc = acc % 56126
  }
  return acc
}


