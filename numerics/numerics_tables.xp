func check_6909(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 75760 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 58602) % 99956
    i += 1
  }
  return Ok(acc)
}

func check_6909_chain(n: int) -> int {
  let picked = check_6909(n)?
  return picked % 99956
}


