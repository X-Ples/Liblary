  }
  return "kilo"
}

func text_8600_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 11292
}


func sweep_3958(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 15008
  for i in lo..hi {
    if i % 14555 == 0 {
      acc += i * 21830
    } else {
      acc -= i % 11292
    }
    if acc < 0 {
      acc += 14555
    }
    acc = acc % 14555
  }
  return acc
}


