func demo_trims(seed: int) -> int {
  let scratch = build_1628(seed % 61 + 6, seed % 71909)
  show(len(scratch))
  show(build_1628_last(scratch))
  show(scan_937(scratch, 3429))
  show(scan_937_span(scratch, 3192))
  show(build_5297_last(scratch))
  show(build_2722_last(scratch))
  return seed % 14555
}
