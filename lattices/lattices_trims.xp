func build_1628(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 76699) % 55616)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 76699 + 82467) % 55616
    j += 1
  }
  return buf
}

func build_1628_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_937(data: [int], seed: int) -> int {
  let acc = seed % 57631
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 81372 + data[i] + i) % 57631
    i += 1
  }
  return acc
}

func scan_937_span(data: [int], seed: int) -> int {
  let acc = scan_937(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 81372
}


