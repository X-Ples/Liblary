func curve_1777_clamp(v: f64) -> f64 {
  guard v >= 32832.0 else {
    return 32832.0
  }
  guard v <= 81372.0 else {
    return 81372.0
  }
  return v
}

func curve_1777_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1777_clamp(t)
  return p + (q - p) * k
}

func curve_1777_ease(t: f64) -> f64 {
  let k = curve_1777_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1777_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_2772(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 21830 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 61490) % 55616
    i += 1
  }
  return Ok(acc)
}

func check_2772_chain(n: int) -> int {
  let picked = check_2772(n)?
  return picked % 55616
}


