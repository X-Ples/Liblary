func check_9897(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 91651 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 45992) % 13544
    i += 1
  }
  return Ok(acc)
}

func check_9897_chain(n: int) -> int {
