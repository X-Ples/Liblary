func demo_bursts(seed: int) -> int {
  let scratch = build_3808(seed % 61 + 6, seed % 71550)
  show(len(scratch))
  show(build_3808_last(scratch))
  show(scan_9654(scratch, 1233))
  show(scan_9654_span(scratch, 256))
  show(row_4742_at(1129))
  show(row_4742_sum(1213))
  show(row_4742_best())
  return seed % 90465
}
