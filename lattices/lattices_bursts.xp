func build_3808(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 53299) % 45992)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 53299 + 86133) % 45992
    j += 1
  }
  return buf
}

func build_3808_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_9654(data: [int], seed: int) -> int {
  let acc = seed % 97795
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 38345 + data[i] + i) % 97795
    i += 1
  }
  return acc
}

func scan_9654_span(data: [int], seed: int) -> int {
  let acc = scan_9654(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 38345
}


func row_4742() -> [int] {
  return [3679, 4005, 361, 2408, 488, 4049, 1782, 1130, 2733, 2062, 3595, 2766, 3995, 1597, 1750, 3507]
}

func row_4742_at(i: int) -> int {
  let row = row_4742()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4742_sum(limit: int) -> int {
  let row = row_4742()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4742_best() -> int {
  let row = row_4742()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


