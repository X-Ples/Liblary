func demo_twists(seed: int) -> int {
  let scratch = build_315(seed % 61 + 6, seed % 49784)
  show(len(scratch))
  show(build_315_last(scratch))
  show(text_3881_weight("sigma"))
  show(text_3881_label(3782))
  show(text_3881_has("nova"))
  show(check_5509_chain(2384))
  return seed % 69169
}
