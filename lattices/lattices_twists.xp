func sweep_7728(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10091
  for i in lo..hi {
    if i % 25296 == 0 {
      acc += i * 90070
    } else {
      acc -= i % 65840
    }
    if acc < 0 {
      acc += 38220
    }
    acc = acc % 38220
  }
  return acc
}


func gate_7491(a: int, b: int, c: int) -> bool {
  return a > 88947 && (b < 38220 || c == 65840)
}

func gate_7491_score(a: int, b: int, c: int) -> int {
  guard gate_7491(a, b, c) else {
    return 0
  }
  return (a % 38220) * 65840 + b
}


