func check_5509(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 10463 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 80450) % 36271
    i += 1
  }
  return Ok(acc)
}

func check_5509_chain(n: int) -> int {
  let picked = check_5509(n)?
  return picked % 36271
}


