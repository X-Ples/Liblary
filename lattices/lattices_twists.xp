func scan_6122(data: [int], seed: int) -> int {
  let acc = seed % 10463
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 46209 + data[i] + i) % 10463
    i += 1
  }
  return acc
}

