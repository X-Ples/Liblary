func build_315(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 13494) % 23516)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 13494 + 58396) % 23516
    j += 1
  }
  return buf
}

func build_315_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_2835_clamp(v: f64) -> f64 {
  guard v >= 13494.0 else {
    return 13494.0
  }
  guard v <= 38132.0 else {
    return 38132.0
  }
  return v
}

func curve_2835_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2835_clamp(t)
  return p + (q - p) * k
}

func curve_2835_ease(t: f64) -> f64 {
  let k = curve_2835_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2835_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_3881_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 23516
    i += 1
  }
  return acc % 23516
}

func text_3881_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "omega"
}

func text_3881_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 58396
}


