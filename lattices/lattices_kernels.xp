  }
  return (a % 93315) * 49565 + b
}


func scan_7833(data: [int], seed: int) -> int {
  let acc = seed % 99698
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 66877 + data[i] + i) % 99698
    i += 1
  }
  return acc
}

func scan_7833_span(data: [int], seed: int) -> int {
  let acc = scan_7833(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 66877
}


