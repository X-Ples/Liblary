func demo_kernels(seed: int) -> int {
  let scratch = build_9533(seed % 61 + 6, seed % 66877)
  show(len(scratch))
  show(build_9533_last(scratch))
  show(order_3973_find(scratch, 3470))
  show(check_3032_chain(3952))
  return seed % 66877
}
