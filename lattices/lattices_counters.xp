func demo_counters(seed: int) -> int {
  let scratch = build_7382(seed % 61 + 6, seed % 38508)
  show(len(scratch))
  show(build_7382_last(scratch))
  show(sweep_311(2045, 737))
  show(gate_3117(1446, 2736, 3136))
  show(gate_3117_score(165, 3685, 2449))
  show(sweep_4973(748, 1831))
  show(sweep_7876(2872, 2961))
  return seed % 14288
}
