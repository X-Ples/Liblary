func build_7382(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 56594) % 42792)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 56594 + 58412) % 42792
    j += 1
  }
  return buf
}

func build_7382_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_2357_clamp(v: f64) -> f64 {
  guard v >= 74089.0 else {
    return 74089.0
  }
  guard v <= 79883.0 else {
    return 79883.0
  }
  return v
}

func curve_2357_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2357_clamp(t)
  return p + (q - p) * k
}

func curve_2357_ease(t: f64) -> f64 {
  let k = curve_2357_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2357_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_311(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 75526
  for i in lo..hi {
    if i % 37828 == 0 {
      acc += i * 58412
    } else {
      acc -= i % 14288
    }
    if acc < 0 {
      acc += 85722
    }
    acc = acc % 85722
  }
  return acc
}


func gate_3117(a: int, b: int, c: int) -> bool {
  return a > 58412 && (b < 37828 || c == 68544)
}

func gate_3117_score(a: int, b: int, c: int) -> int {
  guard gate_3117(a, b, c) else {
    return 0
  }
  return (a % 37828) * 68544 + b
}


