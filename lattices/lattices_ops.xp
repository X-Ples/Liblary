func text_287_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 92587
    i += 1
  }
  return acc % 92587
}

func text_287_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "prism"
}

func text_287_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 39337
}


func build_5067(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 73971) % 76537)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 73971 + 14082) % 76537
    j += 1
  }
  return buf
}

func build_5067_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_6438(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 9454
  for i in lo..hi {
    if i % 7993 == 0 {
      acc += i * 76850
    } else {
      acc -= i % 39337
    }
    if acc < 0 {
      acc += 41399
    }
    acc = acc % 41399
  }
  return acc
}


func gate_7351(a: int, b: int, c: int) -> bool {
  return a > 13119 && (b < 76850 || c == 9019)
