func curve_7141_clamp(v: f64) -> f64 {
  guard v >= 13381.0 else {
    return 13381.0
  }
  guard v <= 42450.0 else {
    return 42450.0
  }
  return v
}

func curve_7141_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7141_clamp(t)
  return p + (q - p) * k
}

func curve_7141_ease(t: f64) -> f64 {
  let k = curve_7141_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7141_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_8881() -> [int] {
  return [2086, 928, 2766, 2854, 677, 3071, 3458, 3572, 1024, 1934, 3711]
}

func row_8881_at(i: int) -> int {
  let row = row_8881()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8881_sum(limit: int) -> int {
  let row = row_8881()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8881_best() -> int {
  let row = row_8881()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


