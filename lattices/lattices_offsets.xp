func curve_5031_clamp(v: f64) -> f64 {
  guard v >= 45982.0 else {
    return 45982.0
  }
  guard v <= 66177.0 else {
    return 66177.0
  }
  return v
}

func curve_5031_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5031_clamp(t)
  return p + (q - p) * k
}

func curve_5031_ease(t: f64) -> f64 {
  let k = curve_5031_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5031_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_4314(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 26001) % 18200)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 26001 + 18200) % 18200
    j += 1
  }
  return buf
}

func build_4314_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_1875(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 26001
  for i in lo..hi {
    if i % 99908 == 0 {
      acc += i * 82519
    } else {
      acc -= i % 58227
    }
    if acc < 0 {
      acc += 33076
    }
    acc = acc % 33076
  }
  return acc
}


func text_4441_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 51432
    i += 1
  }
  return acc % 51432
}

