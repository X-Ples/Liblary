func demo_ratchets(seed: int) -> int {
  let scratch = build_4766(seed % 61 + 6, seed % 79677)
  show(len(scratch))
  show(check_1677_chain(3784))
  show(order_7148_find(scratch, 2580))
  show(build_4766_last(scratch))
  show(text_8746_weight("delta"))
  show(text_8746_label(90))
  show(text_8746_has("prism"))
  return seed % 78861
}
