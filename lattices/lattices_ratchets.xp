}

func text_8746_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 26537
}


func grid_8157_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 47530 + c * 26537 + seed) % 26537)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8157_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 26537 == want {
      total += acc
    }
    r += 1
  }
  return total
}


