func scan_6180(data: [int], seed: int) -> int {
  let acc = seed % 99410
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 1629 + data[i] + i) % 99410
    i += 1
  }
  return acc
}

