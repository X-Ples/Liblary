func row_4789() -> [int] {
  return [3452, 3929, 2656, 1284, 1566, 2617, 1465, 927, 2765, 3489, 246, 2879]
}

func row_4789_at(i: int) -> int {
  let row = row_4789()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4789_sum(limit: int) -> int {
  let row = row_4789()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4789_best() -> int {
  let row = row_4789()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


