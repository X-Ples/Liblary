func demo_quarks(seed: int) -> int {
  let scratch = build_8150(seed % 61 + 6, seed % 19518)
  show(len(scratch))
  show(build_8150_last(scratch))
  show(text_7656_weight("lumen"))
  show(text_7656_label(180))
  show(text_7656_has("delta"))
  return seed % 99410
}
