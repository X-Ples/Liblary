func build_8150(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 37078) % 669)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 37078 + 37078) % 669
    j += 1
  }
  return buf
}

func build_8150_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_7656_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 98327
    i += 1
  }
  return acc % 98327
}

func text_7656_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "omega"
}

func text_7656_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 19518
}


func gate_3548(a: int, b: int, c: int) -> bool {
  return a > 99410 && (b < 37078 || c == 38433)
}

func gate_3548_score(a: int, b: int, c: int) -> int {
  guard gate_3548(a, b, c) else {
    return 0
  }
  return (a % 37078) * 38433 + b
}


func sweep_7981(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 27515
  for i in lo..hi {
    if i % 1629 == 0 {
      acc += i * 26703
    } else {
      acc -= i % 86299
    }
    if acc < 0 {
      acc += 84459
    }
    acc = acc % 84459
  }
  return acc
}


