func demo_tables(seed: int) -> int {
  let scratch = build_1138(seed % 61 + 6, seed % 21950)
  show(len(scratch))
  show(build_1138_last(scratch))
  show(text_7423_weight("bravo"))
  show(text_7423_label(3567))
  show(text_7423_has("cargo"))
  show(build_3866_last(scratch))
  return seed % 1724
}
