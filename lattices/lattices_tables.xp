func curve_1439_clamp(v: f64) -> f64 {
  guard v >= 1900.0 else {
    return 1900.0
  }
  guard v <= 99353.0 else {
    return 99353.0
  }
  return v
}

func curve_1439_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1439_clamp(t)
  return p + (q - p) * k
}

func curve_1439_ease(t: f64) -> f64 {
  let k = curve_1439_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1439_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_249(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 93852
  for i in lo..hi {
    if i % 24319 == 0 {
      acc += i * 72527
    } else {
      acc -= i % 99353
    }
    if acc < 0 {
      acc += 73335
    }
    acc = acc % 73335
  }
  return acc
}


