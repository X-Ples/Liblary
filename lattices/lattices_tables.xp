func build_1138(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 36066) % 61875)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 36066 + 53835) % 61875
    j += 1
  }
  return buf
}

func build_1138_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_7423_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 53835
    i += 1
  }
  return acc % 53835
}

func text_7423_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "ridge"
}

func text_7423_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 99353
}


