func check_4100(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 33688 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 36066) % 24319
    i += 1
  }
  return Ok(acc)
}

func check_4100_chain(n: int) -> int {
  let picked = check_4100(n)?
  return picked % 24319
}


