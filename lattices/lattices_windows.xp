func demo_windows(seed: int) -> int {
  let scratch = build_5312(seed % 61 + 6, seed % 70991)
  show(len(scratch))
  show(build_5312_last(scratch))
  show(order_9113_find(scratch, 3884))
  show(grid_1483_rowsum(scratch, 2230, 2441, 470))
  show(grid_8991_rowsum(scratch, 72, 2308, 3112))
  return seed % 22895
}
