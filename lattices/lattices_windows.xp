func sweep_9648(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 58518
  for i in lo..hi {
    if i % 15874 == 0 {
      acc += i * 89043
    } else {
      acc -= i % 65643
    }
    if acc < 0 {
      acc += 7219
    }
    acc = acc % 7219
  }
  return acc
}


