func curve_5125_clamp(v: f64) -> f64 {
  guard v >= 14788.0 else {
    return 14788.0
  }
  guard v <= 14788.0 else {
    return 14788.0
  }
  return v
}

func curve_5125_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5125_clamp(t)
  return p + (q - p) * k
}

func curve_5125_ease(t: f64) -> f64 {
  let k = curve_5125_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5125_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func curve_9864_clamp(v: f64) -> f64 {
  guard v >= 6256.0 else {
    return 6256.0
  }
  guard v <= 22895.0 else {
    return 22895.0
  }
  return v
}

func curve_9864_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9864_clamp(t)
  return p + (q - p) * k
}

func curve_9864_ease(t: f64) -> f64 {
  let k = curve_9864_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9864_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_685(data: [int], seed: int) -> int {
  let acc = seed % 36247
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 65643 + data[i] + i) % 36247
    i += 1
  }
  return acc
}

func scan_685_span(data: [int], seed: int) -> int {
  let acc = scan_685(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 65643
}


func check_2089(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 63078 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 73581) % 76311
    i += 1
  }
  return Ok(acc)
}

func check_2089_chain(n: int) -> int {
  let picked = check_2089(n)?
  return picked % 76311
}


