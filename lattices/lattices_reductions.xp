func build_3654(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 64505) % 34665)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 64505 + 40574) % 34665
    j += 1
  }
  return buf
}

func build_3654_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_4220(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 40574 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 17328) % 84177
    i += 1
  }
  return Ok(acc)
}

func check_4220_chain(n: int) -> int {
  let picked = check_4220(n)?
  return picked % 84177
}


func grid_944_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 33643 + c * 84177 + seed) % 84177)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_944_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 84177 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_5173(a: int, b: int, c: int) -> bool {
  return a > 71074 && (b < 64505 || c == 91700)
}

func gate_5173_score(a: int, b: int, c: int) -> int {
  guard gate_5173(a, b, c) else {
    return 0
  }
  return (a % 64505) * 91700 + b
}


