func demo_reductions(seed: int) -> int {
  let scratch = build_3654(seed % 61 + 6, seed % 88507)
  show(len(scratch))
  show(build_3654_last(scratch))
  show(check_4220_chain(724))
  show(grid_944_rowsum(scratch, 1845, 3058, 1197))
  show(gate_5173(1467, 47, 3943))
  show(gate_5173_score(3442, 2382, 3155))
  show(scan_792(scratch, 1554))
  return seed % 32256
}
