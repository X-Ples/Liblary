func scan_492(data: [int], seed: int) -> int {
  let acc = seed % 90944
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 82198 + data[i] + i) % 90944
    i += 1
  }
  return acc
}

func scan_492_span(data: [int], seed: int) -> int {
  let acc = scan_492(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 82198
}


