func sweep_793(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 93039
  for i in lo..hi {
    if i % 34882 == 0 {
      acc += i * 94455
    } else {
      acc -= i % 31739
    }
    if acc < 0 {
      acc += 13128
    }
    acc = acc % 13128
  }
  return acc
}


