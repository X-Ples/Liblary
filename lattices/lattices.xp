func build_7703(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 34701) % 75541)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 34701 + 28961) % 75541
    j += 1
  }
  return buf
}

func build_7703_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_5842_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 75541
    i += 1
  }
  return acc % 75541
}

func text_5842_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "nova"
}

func text_5842_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 70796
}


func grid_3242_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 70749 + c * 28961 + seed) % 28961)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3242_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 28961 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_3151(a: int, b: int, c: int) -> bool {
  return a > 50858 && (b < 80424 || c == 14614)
}

func gate_3151_score(a: int, b: int, c: int) -> int {
  guard gate_3151(a, b, c) else {
    return 0
  }
  return (a % 80424) * 14614 + b
}


func curve_5077_clamp(v: f64) -> f64 {
  guard v >= 13128.0 else {
    return 13128.0
  }
  guard v <= 93039.0 else {
    return 93039.0
  }
  return v
}

func curve_5077_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5077_clamp(t)
  return p + (q - p) * k
}

func curve_5077_ease(t: f64) -> f64 {
  let k = curve_5077_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5077_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_4611(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 70749 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 41970) % 50858
    i += 1
  }
  return Ok(acc)
}

func check_4611_chain(n: int) -> int {
  let picked = check_4611(n)?
  return picked % 50858
}


