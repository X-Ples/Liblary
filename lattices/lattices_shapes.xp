func sweep_114(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 62071
  for i in lo..hi {
    if i % 48039 == 0 {
      acc += i * 37417
    } else {
      acc -= i % 37417
    }
    if acc < 0 {
      acc += 19519
    }
    acc = acc % 19519
  }
  return acc
}


func grid_3233_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 11932 + c * 50992 + seed) % 50992)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3233_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 50992 == want {
      total += acc
    }
    r += 1
  }
  return total
}


