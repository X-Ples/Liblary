func demo_shapes(seed: int) -> int {
  let scratch = build_8452(seed % 61 + 6, seed % 55383)
  show(len(scratch))
  show(build_8452_last(scratch))
  show(scan_7284(scratch, 3102))
  show(scan_7284_span(scratch, 3951))
  show(scan_3047(scratch, 13))
  return seed % 62071
}
