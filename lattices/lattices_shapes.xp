func build_8452(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 19519) % 19091)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 19519 + 15861) % 19091
    j += 1
  }
  return buf
}

func build_8452_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_7284(data: [int], seed: int) -> int {
  let acc = seed % 27723
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 15861 + data[i] + i) % 27723
    i += 1
  }
  return acc
}

func scan_7284_span(data: [int], seed: int) -> int {
  let acc = scan_7284(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 15861
}


