func row_1875() -> [int] {
  return [249, 2755, 1280, 3476, 955, 2061, 3721, 2715, 1288, 4081, 3503, 1194, 1413, 120, 696, 2814, 2585, 2012, 2938]
}

func row_1875_at(i: int) -> int {
  let row = row_1875()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1875_sum(limit: int) -> int {
  let row = row_1875()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1875_best() -> int {
  let row = row_1875()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


