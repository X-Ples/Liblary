func check_5592(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 91911 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 27781) % 70297
    i += 1
  }
  return Ok(acc)
}

func check_5592_chain(n: int) -> int {
  let picked = check_5592(n)?
  return picked % 70297
}


func sweep_6362(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 86216
  for i in lo..hi {
    if i % 55571 == 0 {
      acc += i * 15209
    } else {
      acc -= i % 27781
    }
    if acc < 0 {
      acc += 58440
    }
    acc = acc % 58440
  }
  return acc
}


func gate_4949(a: int, b: int, c: int) -> bool {
  return a > 55571 && (b < 82876 || c == 3418)
}

func gate_4949_score(a: int, b: int, c: int) -> int {
  guard gate_4949(a, b, c) else {
    return 0
  }
  return (a % 82876) * 3418 + b
}


