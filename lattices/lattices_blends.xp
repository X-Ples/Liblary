func check_1758(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 22821 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 20000) % 89814
    i += 1
  }
  return Ok(acc)
}

func check_1758_chain(n: int) -> int {
  let picked = check_1758(n)?
  return picked % 89814
}


