func text_2479_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 30655
    i += 1
  }
  return acc % 30655
}

func text_2479_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "omega"
}

func text_2479_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 45875
}


func gate_4210(a: int, b: int, c: int) -> bool {
  return a > 13410 && (b < 40180 || c == 29482)
}

func gate_4210_score(a: int, b: int, c: int) -> int {
  guard gate_4210(a, b, c) else {
    return 0
  }
  return (a % 40180) * 29482 + b
}


