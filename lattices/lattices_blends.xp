  guard hi > lo else {
    return 0
  }
  let acc = 30655
  for i in lo..hi {
    if i % 43946 == 0 {
      acc += i * 67063
    } else {
      acc -= i % 67063
    }
    if acc < 0 {
      acc += 4093
    }
    acc = acc % 4093
  }
  return acc
}


