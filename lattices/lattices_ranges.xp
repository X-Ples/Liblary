func demo_ranges(seed: int) -> int {
  let scratch = build_3823(seed % 61 + 6, seed % 2802)
  show(len(scratch))
  show(build_3823_last(scratch))
  show(sweep_7208(254, 2074))
  show(scan_4608(scratch, 726))
  show(scan_4608_span(scratch, 384))
  return seed % 25815
}
