func row_8354() -> [int] {
  return [606, 2731, 1238, 2578, 201, 3391, 3033, 1438, 1680, 580, 2934, 3374, 74, 3941, 3430, 1704]
}

func row_8354_at(i: int) -> int {
  let row = row_8354()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8354_sum(limit: int) -> int {
  let row = row_8354()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8354_best() -> int {
  let row = row_8354()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


