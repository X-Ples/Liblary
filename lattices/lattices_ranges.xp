func build_3823(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 97874) % 86198)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 97874 + 41083) % 86198
    j += 1
  }
  return buf
}

func build_3823_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_7208(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 27886
  for i in lo..hi {
    if i % 71444 == 0 {
      acc += i * 91776
    } else {
      acc -= i % 90384
    }
    if acc < 0 {
      acc += 13460
    }
    acc = acc % 13460
  }
  return acc
}


func scan_4608(data: [int], seed: int) -> int {
  let acc = seed % 14114
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 97874 + data[i] + i) % 14114
    i += 1
  }
  return acc
}

func scan_4608_span(data: [int], seed: int) -> int {
  let acc = scan_4608(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 97874
}


func check_1945(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 7155 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 69545) % 7155
    i += 1
  }
  return Ok(acc)
}

func check_1945_chain(n: int) -> int {
  let picked = check_1945(n)?
  return picked % 7155
}


func grid_2005_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 16270 + c * 74454 + seed) % 74454)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2005_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 74454 == want {
      total += acc
    }
    r += 1
  }
  return total
}


