func demo_signals(seed: int) -> int {
  let scratch = build_8204(seed % 61 + 6, seed % 67163)
  show(len(scratch))
  show(gate_2719(1049, 3528, 7))
  show(gate_2719_score(392, 3794, 1355))
  show(build_8204_last(scratch))
  show(build_6285_last(scratch))
  show(sweep_6805(1238, 455))
  show(check_5012_chain(2271))
  return seed % 92094
}
