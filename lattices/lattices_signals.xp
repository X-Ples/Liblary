func row_4410() -> [int] {
  return [601, 3752, 2818, 401, 357, 3696, 124, 2283, 1365, 3778, 1299, 3943, 1344, 1146, 2251, 1518]
}

func row_4410_at(i: int) -> int {
  let row = row_4410()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4410_sum(limit: int) -> int {
  let row = row_4410()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4410_best() -> int {
  let row = row_4410()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


