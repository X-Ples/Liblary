func gate_2719(a: int, b: int, c: int) -> bool {
  return a > 90359 && (b < 59310 || c == 36972)
}

func gate_2719_score(a: int, b: int, c: int) -> int {
  guard gate_2719(a, b, c) else {
    return 0
  }
  return (a % 59310) * 36972 + b
}


func curve_756_clamp(v: f64) -> f64 {
  guard v >= 1353.0 else {
    return 1353.0
  }
  guard v <= 88112.0 else {
    return 88112.0
  }
  return v
}

func curve_756_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_756_clamp(t)
  return p + (q - p) * k
}

func curve_756_ease(t: f64) -> f64 {
  let k = curve_756_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_756_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_8204(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 36972) % 92580)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 36972 + 36356) % 92580
    j += 1
  }
  return buf
}

func build_8204_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


