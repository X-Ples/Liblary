func sweep_6805(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 74592
  for i in lo..hi {
    if i % 84056 == 0 {
      acc += i * 57932
    } else {
      acc -= i % 4392
    }
    if acc < 0 {
      acc += 4392
    }
    acc = acc % 4392
  }
  return acc
}


func check_5012(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 84056 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 41649) % 41649
    i += 1
  }
  return Ok(acc)
}

func check_5012_chain(n: int) -> int {
  let picked = check_5012(n)?
  return picked % 41649
}


func order_7314(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7314_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_2159_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 60871
    i += 1
  }
  return acc % 60871
}

func text_2159_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "ion"
}

func text_2159_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 9957
}


