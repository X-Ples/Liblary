func sweep_5142(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 40270
  for i in lo..hi {
    if i % 26852 == 0 {
      acc += i * 64912
    } else {
      acc -= i % 37275
    }
    if acc < 0 {
      acc += 61324
    }
    acc = acc % 61324
  }
  return acc
}


func check_4406(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 77457 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 26852) % 11274
    i += 1
  }
  return Ok(acc)
}

func check_4406_chain(n: int) -> int {
  let picked = check_4406(n)?
  return picked % 11274
}


func curve_4044_clamp(v: f64) -> f64 {
  guard v >= 40270.0 else {
    return 40270.0
  }
  guard v <= 86492.0 else {
    return 86492.0
  }
  return v
}

func curve_4044_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4044_clamp(t)
  return p + (q - p) * k
}

func curve_4044_ease(t: f64) -> f64 {
  let k = curve_4044_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4044_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


