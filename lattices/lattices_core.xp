func row_1203() -> [int] {
  return [1176, 2170, 2105, 1319, 799, 163, 3088, 1568, 3043, 711, 2629, 523, 499, 3921, 3883, 92, 2919, 1285, 2399]
}

func row_1203_at(i: int) -> int {
  let row = row_1203()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1203_sum(limit: int) -> int {
  let row = row_1203()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1203_best() -> int {
  let row = row_1203()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


