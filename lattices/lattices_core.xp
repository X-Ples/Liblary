func demo_core(seed: int) -> int {
  let scratch = build_7941(seed % 61 + 6, seed % 99722)
  show(len(scratch))
  show(scan_5282(scratch, 1544))
  show(scan_5282_span(scratch, 1568))
  show(build_7941_last(scratch))
  show(check_5838_chain(2757))
  return seed % 48541
}
