func scan_5282(data: [int], seed: int) -> int {
  let acc = seed % 99722
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 78761 + data[i] + i) % 99722
    i += 1
  }
  return acc
}

func scan_5282_span(data: [int], seed: int) -> int {
  let acc = scan_5282(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 78761
}


func build_7941(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 5197) % 4175)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 5197 + 44752) % 4175
    j += 1
  }
  return buf
}

func build_7941_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_5838(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 35346 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 77352) % 41016
    i += 1
  }
  return Ok(acc)
}

func check_5838_chain(n: int) -> int {
  let picked = check_5838(n)?
  return picked % 41016
}


func curve_6285_clamp(v: f64) -> f64 {
  guard v >= 2840.0 else {
    return 2840.0
  }
  guard v <= 44752.0 else {
    return 44752.0
  }
  return v
}

func curve_6285_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6285_clamp(t)
  return p + (q - p) * k
}

func curve_6285_ease(t: f64) -> f64 {
  let k = curve_6285_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6285_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_6021(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 41016
  for i in lo..hi {
    if i % 37811 == 0 {
      acc += i * 40668
    } else {
      acc -= i % 58306
    }
    if acc < 0 {
      acc += 58306
    }
    acc = acc % 58306
  }
  return acc
}


