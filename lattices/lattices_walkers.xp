func row_8550_at(i: int) -> int {
  let row = row_8550()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8550_sum(limit: int) -> int {
  let row = row_8550()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8550_best() -> int {
  let row = row_8550()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_9986(data: [int], seed: int) -> int {
  let acc = seed % 27235
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 27235 + data[i] + i) % 27235
    i += 1
  }
  return acc
}

func scan_9986_span(data: [int], seed: int) -> int {
  let acc = scan_9986(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 27235
}


func sweep_5519(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 55545
  for i in lo..hi {
    if i % 34586 == 0 {
      acc += i * 9130
    } else {
      acc -= i % 9130
    }
    if acc < 0 {
      acc += 66039
    }
    acc = acc % 66039
  }
  return acc
}


