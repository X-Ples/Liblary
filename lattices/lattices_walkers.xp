func demo_walkers(seed: int) -> int {
  let scratch = build_9077(seed % 61 + 6, seed % 7886)
  show(len(scratch))
  show(build_9077_last(scratch))
  show(grid_2004_rowsum(scratch, 1769, 2927, 3921))
  show(gate_175(3312, 1635, 2752))
  show(gate_175_score(3215, 3455, 3066))
  show(grid_4603_rowsum(scratch, 2489, 836, 2512))
  return seed % 71849
}
