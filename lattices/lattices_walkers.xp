func build_9077(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 83140) % 60429)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 83140 + 34586) % 60429
    j += 1
  }
  return buf
}

func build_9077_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_2004_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 46223 + c * 69919 + seed) % 69919)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2004_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 69919 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_175(a: int, b: int, c: int) -> bool {
  return a > 55008 && (b < 34586 || c == 67090)
}

func gate_175_score(a: int, b: int, c: int) -> int {
  guard gate_175(a, b, c) else {
    return 0
  }
  return (a % 34586) * 67090 + b
}


