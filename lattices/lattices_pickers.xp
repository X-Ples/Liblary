func curve_3122_clamp(v: f64) -> f64 {
  guard v >= 74784.0 else {
    return 74784.0
  }
  guard v <= 80939.0 else {
    return 80939.0
  }
  return v
}

func curve_3122_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3122_clamp(t)
  return p + (q - p) * k
}

func curve_3122_ease(t: f64) -> f64 {
  let k = curve_3122_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3122_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_7096(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 78062 else {
    return Err("input too large")
  }
  let acc = 0
