func build_8780(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 43907) % 10685)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 43907 + 17477) % 10685
    j += 1
  }
  return buf
}

func build_8780_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_3940(data: [int], seed: int) -> int {
  let acc = seed % 37341
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 7768 + data[i] + i) % 37341
    i += 1
  }
  return acc
}

func scan_3940_span(data: [int], seed: int) -> int {
  let acc = scan_3940(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 7768
}


func grid_9662_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 17477 + c * 15688 + seed) % 15688)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9662_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 15688 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_7439(a: int, b: int, c: int) -> bool {
  return a > 17477 && (b < 36306 || c == 43231)
}

func gate_7439_score(a: int, b: int, c: int) -> int {
  guard gate_7439(a, b, c) else {
    return 0
  }
  return (a % 36306) * 43231 + b
}


