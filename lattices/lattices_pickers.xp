func demo_pickers(seed: int) -> int {
  let scratch = build_8780(seed % 61 + 6, seed % 44588)
  show(len(scratch))
  show(build_8780_last(scratch))
  show(scan_3940(scratch, 896))
  show(scan_3940_span(scratch, 426))
  show(grid_9662_rowsum(scratch, 2437, 1929, 845))
  return seed % 37341
}
