func sweep_510(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 97774
  for i in lo..hi {
    if i % 36306 == 0 {
      acc += i * 15688
    } else {
      acc -= i % 97774
    }
    if acc < 0 {
      acc += 78062
    }
    acc = acc % 78062
  }
  return acc
}


