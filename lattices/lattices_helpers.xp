func check_5516(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 19022 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 82487) % 44376
    i += 1
  }
  return Ok(acc)
}

func check_5516_chain(n: int) -> int {
  let picked = check_5516(n)?
  return picked % 44376
}


