func grid_5558_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 46253 + c * 42503 + seed) % 42503)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5558_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 42503 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_4745_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 85753
    i += 1
  }
  return acc % 85753
}

func text_4745_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "alpha"
}

func text_4745_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 35429
}


