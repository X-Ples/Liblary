const K0 = 44376
const K1 = 56018
const K2 = 30117
const K3 = 87235
const K4 = 69063
const K5 = 46253

func curve_8381_clamp(v: f64) -> f64 {
  guard v >= 19022.0 else {
    return 19022.0
  }
  guard v <= 44376.0 else {
    return 44376.0
  }
  return v
}

func curve_8381_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8381_clamp(t)
  return p + (q - p) * k
}

func curve_8381_ease(t: f64) -> f64 {
  let k = curve_8381_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8381_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_9861(a: int, b: int, c: int) -> bool {
  return a > 56018 && (b < 97685 || c == 35429)
}

func gate_9861_score(a: int, b: int, c: int) -> int {
  guard gate_9861(a, b, c) else {
    return 0
  }
  return (a % 97685) * 35429 + b
}


func build_4782(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 56018) % 30117)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 56018 + 32212) % 30117
    j += 1
  }
  return buf
}

func build_4782_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


