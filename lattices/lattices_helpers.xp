func scan_6536(data: [int], seed: int) -> int {
  let acc = seed % 30117
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 50907 + data[i] + i) % 30117
    i += 1
  }
  return acc
}

func scan_6536_span(data: [int], seed: int) -> int {
  let acc = scan_6536(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 50907
}


