func demo_helpers(seed: int) -> int {
  let scratch = build_4782(seed % 61 + 6, seed % 97685)
  show(len(scratch))
  show(gate_9861(3613, 2421, 2609))
  show(gate_9861_score(2025, 3376, 3919))
  show(build_4782_last(scratch))
  show(grid_5558_rowsum(scratch, 3647, 3520, 1666))
  show(text_4745_weight("alpha"))
  show(text_4745_label(429))
  return seed % 56018
}
