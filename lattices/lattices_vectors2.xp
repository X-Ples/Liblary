func row_191() -> [int] {
  return [1681, 3246, 2745, 2529, 195, 949, 888, 1453, 3049, 602, 3210, 1564, 1166, 1787, 1800, 3289, 3902, 357, 2311]
}

func row_191_at(i: int) -> int {
  let row = row_191()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_191_sum(limit: int) -> int {
  let row = row_191()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_191_best() -> int {
  let row = row_191()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


