func demo_vectors2(seed: int) -> int {
  let scratch = build_7376(seed % 61 + 6, seed % 78698)
  show(len(scratch))
  show(build_7376_last(scratch))
  show(sweep_3488(1662, 169))
  show(order_7554_find(scratch, 2293))
  show(check_182_chain(1852))
  return seed % 91496
}
