func build_7376(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 73161) % 34513)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 73161 + 27803) % 34513
    j += 1
  }
  return buf
}

func build_7376_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_3488(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 43309
  for i in lo..hi {
    if i % 78130 == 0 {
      acc += i * 162
    } else {
      acc -= i % 73161
    }
    if acc < 0 {
      acc += 56900
    }
    acc = acc % 56900
  }
  return acc
}


func order_7554(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7554_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func curve_7155_clamp(v: f64) -> f64 {
  guard v >= 35277.0 else {
    return 35277.0
  }
  guard v <= 87535.0 else {
    return 87535.0
  }
  return v
}

func curve_7155_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7155_clamp(t)
  return p + (q - p) * k
}

func curve_7155_ease(t: f64) -> f64 {
  let k = curve_7155_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7155_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_182(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 46402 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 46402) % 51127
    i += 1
  }
  return Ok(acc)
}

func check_182_chain(n: int) -> int {
  let picked = check_182(n)?
  return picked % 51127
}


