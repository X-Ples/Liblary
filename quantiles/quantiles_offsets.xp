func row_9299() -> [int] {
  return [3753, 371, 3822, 2645, 3645, 3551, 2217, 2252, 294, 3776, 2047, 951, 2570, 3457, 338, 3960, 3020, 2058, 1908, 1865, 2681]
}

func row_9299_at(i: int) -> int {
  let row = row_9299()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9299_sum(limit: int) -> int {
  let row = row_9299()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9299_best() -> int {
  let row = row_9299()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


