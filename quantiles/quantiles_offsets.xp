func sweep_1694(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 51994
  for i in lo..hi {
    if i % 96006 == 0 {
      acc += i * 40151
    } else {
      acc -= i % 35323
    }
    if acc < 0 {
      acc += 52493
    }
    acc = acc % 52493
  }
  return acc
}


