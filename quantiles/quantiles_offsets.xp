const K0 = 85922
const K1 = 85922
const K2 = 85877
const K3 = 16970
const K4 = 85621
const K5 = 54822
const K6 = 26127
const K7 = 63721

func order_5453(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5453_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_3148(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 52493) % 30896)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 52493 + 66379) % 30896
    j += 1
  }
  return buf
}

func build_3148_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_5483(a: int, b: int, c: int) -> bool {
  return a > 40151 && (b < 38954 || c == 85412)
}

func gate_5483_score(a: int, b: int, c: int) -> int {
  guard gate_5483(a, b, c) else {
    return 0
  }
  return (a % 38954) * 85412 + b
}


func check_2807(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 27416 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 99941) % 66379
    i += 1
  }
  return Ok(acc)
}

func check_2807_chain(n: int) -> int {
  let picked = check_2807(n)?
  return picked % 66379
}


func scan_9297(data: [int], seed: int) -> int {
  let acc = seed % 6290
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 69927 + data[i] + i) % 6290
    i += 1
  }
  return acc
}

func scan_9297_span(data: [int], seed: int) -> int {
  let acc = scan_9297(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 69927
}


func grid_2585_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 38954 + c * 35168 + seed) % 35168)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2585_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 35168 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_8799_clamp(v: f64) -> f64 {
  guard v >= 6120.0 else {
    return 6120.0
  }
  guard v <= 85922.0 else {
    return 85922.0
  }
  return v
}

func curve_8799_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8799_clamp(t)
  return p + (q - p) * k
}

func curve_8799_ease(t: f64) -> f64 {
  let k = curve_8799_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8799_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


