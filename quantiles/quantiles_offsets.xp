func demo_offsets(seed: int) -> int {
  let scratch = build_3148(seed % 61 + 6, seed % 30896)
  show(len(scratch))
  show(order_5453_find(scratch, 2025))
  show(build_3148_last(scratch))
  show(gate_5483(3387, 1703, 1036))
  show(gate_5483_score(3790, 544, 3551))
  return seed % 30896
}
