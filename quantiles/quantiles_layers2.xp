func demo_layers2(seed: int) -> int {
  let scratch = build_8720(seed % 61 + 6, seed % 9775)
  show(len(scratch))
  show(build_8720_last(scratch))
  show(order_1747_find(scratch, 2737))
  show(scan_5923(scratch, 1213))
  return seed % 9775
}
