}


func scan_5923(data: [int], seed: int) -> int {
  let acc = seed % 47406
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 47054 + data[i] + i) % 47406
    i += 1
  }
  return acc
}

func scan_5923_span(data: [int], seed: int) -> int {
  let acc = scan_5923(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 47054
}


func gate_7579(a: int, b: int, c: int) -> bool {
  return a > 74762 && (b < 62190 || c == 19970)
}

func gate_7579_score(a: int, b: int, c: int) -> int {
  guard gate_7579(a, b, c) else {
    return 0
  }
  return (a % 62190) * 19970 + b
}


