func check_1344(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 66306 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 7132) % 41903
    i += 1
  }
  return Ok(acc)
}

func check_1344_chain(n: int) -> int {
  let picked = check_1344(n)?
  return picked % 41903
}


func sweep_1976(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 71075
  for i in lo..hi {
    if i % 41903 == 0 {
      acc += i * 72544
    } else {
      acc -= i % 19970
    }
    if acc < 0 {
      acc += 61434
    }
    acc = acc % 61434
  }
  return acc
}


func grid_2868_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 9775 + c * 9775 + seed) % 9775)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2868_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 9775 == want {
      total += acc
    }
    r += 1
  }
  return total
}


