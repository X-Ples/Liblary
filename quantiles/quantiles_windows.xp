func gate_1226(a: int, b: int, c: int) -> bool {
  return a > 84420 && (b < 71530 || c == 735)
}

func gate_1226_score(a: int, b: int, c: int) -> int {
  guard gate_1226(a, b, c) else {
    return 0
  }
  return (a % 71530) * 735 + b
}


func text_1126_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 5754
    i += 1
  }
  return acc % 5754
}

func text_1126_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "mesa"
}

func text_1126_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 16141
}


func curve_6371_clamp(v: f64) -> f64 {
  guard v >= 5754.0 else {
    return 5754.0
  }
  guard v <= 11144.0 else {
    return 11144.0
  }
  return v
}

func curve_6371_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6371_clamp(t)
  return p + (q - p) * k
}

func curve_6371_ease(t: f64) -> f64 {
  let k = curve_6371_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6371_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


