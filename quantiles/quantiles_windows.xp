func sweep_9495(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 91741
  for i in lo..hi {
    if i % 84530 == 0 {
      acc += i * 54382
    } else {
      acc -= i % 73248
    }
    if acc < 0 {
      acc += 71530
    }
    acc = acc % 71530
  }
  return acc
}


