func build_1296(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 38445) % 24589)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 38445 + 85884) % 24589
    j += 1
  }
  return buf
}

func build_1296_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_8450(data: [int], seed: int) -> int {
  let acc = seed % 716
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 36079 + data[i] + i) % 716
    i += 1
  }
  return acc
}

func scan_8450_span(data: [int], seed: int) -> int {
  let acc = scan_8450(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 36079
}


