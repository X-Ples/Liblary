func demo_windows(seed: int) -> int {
  let scratch = build_1296(seed % 61 + 6, seed % 3233)
  show(len(scratch))
  show(build_1296_last(scratch))
  show(scan_8450(scratch, 963))
  show(scan_8450_span(scratch, 994))
  show(row_140_at(1418))
  show(row_140_sum(3181))
  show(row_140_best())
  return seed % 5754
}
