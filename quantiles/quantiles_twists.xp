func text_9644_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 17255
    i += 1
  }
  return acc % 17255
}

func text_9644_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "kilo"
}

func text_9644_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 8051
}


func gate_9454(a: int, b: int, c: int) -> bool {
  return a > 52298 && (b < 5415 || c == 52298)
}

func gate_9454_score(a: int, b: int, c: int) -> int {
  guard gate_9454(a, b, c) else {
    return 0
  }
  return (a % 5415) * 52298 + b
}


func scan_6102(data: [int], seed: int) -> int {
  let acc = seed % 58536
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 84035 + data[i] + i) % 58536
    i += 1
  }
  return acc
}

func scan_6102_span(data: [int], seed: int) -> int {
  let acc = scan_6102(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 84035
}


