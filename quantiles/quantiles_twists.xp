func row_9965() -> [int] {
  return [3434, 2494, 4008, 2818, 3699, 2124, 3333, 337, 1704, 809]
}

func row_9965_at(i: int) -> int {
  let row = row_9965()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9965_sum(limit: int) -> int {
  let row = row_9965()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9965_best() -> int {
  let row = row_9965()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


