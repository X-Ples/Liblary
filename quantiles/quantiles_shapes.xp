func check_3427(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 26021 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 52855) % 78156
    i += 1
  }
  return Ok(acc)
}

func check_3427_chain(n: int) -> int {
  let picked = check_3427(n)?
  return picked % 78156
}


