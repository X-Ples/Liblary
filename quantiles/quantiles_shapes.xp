func row_9469() -> [int] {
  return [3989, 4010, 458, 2643, 845, 1798, 1979, 1858, 205, 4031, 334, 1279, 3116, 2689, 1455, 772, 2948]
}

func row_9469_at(i: int) -> int {
  let row = row_9469()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9469_sum(limit: int) -> int {
  let row = row_9469()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9469_best() -> int {
  let row = row_9469()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


