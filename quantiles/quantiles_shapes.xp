func demo_shapes(seed: int) -> int {
  let scratch = build_4303(seed % 61 + 6, seed % 1505)
  show(len(scratch))
  show(scan_8873(scratch, 1294))
  show(scan_8873_span(scratch, 832))
  show(build_4303_last(scratch))
  show(grid_6935_rowsum(scratch, 387, 1634, 3359))
  return seed % 338
}
