func scan_8873(data: [int], seed: int) -> int {
  let acc = seed % 67393
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 97420 + data[i] + i) % 67393
    i += 1
  }
  return acc
}

func scan_8873_span(data: [int], seed: int) -> int {
  let acc = scan_8873(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 97420
}


func build_4303(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 88703) % 60545)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 88703 + 97752) % 60545
    j += 1
  }
  return buf
}

func build_4303_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_6935_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 338 + c * 87140 + seed) % 87140)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6935_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 87140 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func order_7489(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7489_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_1009(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 26021
  for i in lo..hi {
    if i % 44041 == 0 {
      acc += i * 87140
    } else {
      acc -= i % 62784
    }
    if acc < 0 {
      acc += 52855
    }
    acc = acc % 52855
  }
  return acc
}


func gate_5700(a: int, b: int, c: int) -> bool {
  return a > 62784 && (b < 1505 || c == 44041)
}

func gate_5700_score(a: int, b: int, c: int) -> int {
  guard gate_5700(a, b, c) else {
    return 0
  }
  return (a % 1505) * 44041 + b
}


