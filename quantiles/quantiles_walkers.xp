func curve_1985_clamp(v: f64) -> f64 {
  guard v >= 19646.0 else {
    return 19646.0
  }
  guard v <= 59414.0 else {
    return 59414.0
  }
  return v
}

func curve_1985_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1985_clamp(t)
  return p + (q - p) * k
}

func curve_1985_ease(t: f64) -> f64 {
  let k = curve_1985_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1985_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_1582() -> [int] {
  return [2446, 1091, 1046, 2352, 3340, 1524, 778, 1775, 1357, 3740, 3415, 4091, 3351, 3077, 3751, 2182]
}

func row_1582_at(i: int) -> int {
  let row = row_1582()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1582_sum(limit: int) -> int {
  let row = row_1582()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1582_best() -> int {
  let row = row_1582()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


