func demo_walkers(seed: int) -> int {
  let scratch = build_5573(seed % 61 + 6, seed % 59414)
  show(len(scratch))
  show(build_5573_last(scratch))
  show(sweep_1313(748, 888))
  show(scan_8073(scratch, 3261))
  show(scan_8073_span(scratch, 2683))
  return seed % 68141
}
