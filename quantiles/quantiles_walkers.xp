func build_5573(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 71221) % 757)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 71221 + 59414) % 757
    j += 1
  }
  return buf
}

func build_5573_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_1313(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 4953
  for i in lo..hi {
    if i % 74070 == 0 {
      acc += i * 55492
    } else {
      acc -= i % 79187
    }
    if acc < 0 {
      acc += 61326
    }
    acc = acc % 61326
  }
  return acc
}


func scan_8073(data: [int], seed: int) -> int {
  let acc = seed % 71231
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 96074 + data[i] + i) % 71231
    i += 1
  }
  return acc
}

func scan_8073_span(data: [int], seed: int) -> int {
  let acc = scan_8073(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 96074
}


