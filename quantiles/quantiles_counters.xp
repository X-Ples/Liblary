func demo_counters(seed: int) -> int {
  let scratch = build_9633(seed % 61 + 6, seed % 41612)
  show(len(scratch))
  show(build_9633_last(scratch))
  show(build_1961_last(scratch))
  show(sweep_5147(139, 3379))
  show(row_442_at(2579))
  show(row_442_sum(816))
  show(row_442_best())
  return seed % 73886
}
