func sweep_5147(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 6930
  for i in lo..hi {
    if i % 1128 == 0 {
      acc += i * 85504
    } else {
      acc -= i % 34899
    }
    if acc < 0 {
      acc += 51766
    }
    acc = acc % 51766
  }
  return acc
}


func row_442() -> [int] {
  return [2930, 2179, 1928, 3931, 3130, 915, 3295, 1087, 1662, 2281, 225]
}

func row_442_at(i: int) -> int {
  let row = row_442()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_442_sum(limit: int) -> int {
  let row = row_442()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_442_best() -> int {
  let row = row_442()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_3460(data: [int], seed: int) -> int {
  let acc = seed % 82465
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 78480 + data[i] + i) % 82465
    i += 1
  }
  return acc
}

func scan_3460_span(data: [int], seed: int) -> int {
  let acc = scan_3460(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 78480
}


