func check_9985(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 9662 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 1128) % 81316
    i += 1
  }
  return Ok(acc)
}

func check_9985_chain(n: int) -> int {
  let picked = check_9985(n)?
  return picked % 81316
}


