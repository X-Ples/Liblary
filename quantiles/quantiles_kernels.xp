const K0 = 41
const K1 = 56583
const K2 = 31620
const K3 = 52105
const K4 = 65237
const K5 = 47873
const K6 = 11445
const K7 = 74728
const K8 = 664
const K9 = 2088
const K10 = 50814

func curve_8588_clamp(v: f64) -> f64 {
  guard v >= 41.0 else {
    return 41.0
  }
  guard v <= 31620.0 else {
    return 31620.0
  }
  return v
}

func curve_8588_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8588_clamp(t)
  return p + (q - p) * k
}

func curve_8588_ease(t: f64) -> f64 {
  let k = curve_8588_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8588_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_5244(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 53628
  for i in lo..hi {
    if i % 10898 == 0 {
      acc += i * 37693
    } else {
      acc -= i % 56583
    }
    if acc < 0 {
      acc += 2088
    }
    acc = acc % 2088
  }
  return acc
}


func build_186(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 37693) % 88790)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 37693 + 26112) % 88790
    j += 1
  }
  return buf
}

func build_186_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_4780(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 11445 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 74728) % 65237
    i += 1
  }
  return Ok(acc)
}

func check_4780_chain(n: int) -> int {
  let picked = check_4780(n)?
  return picked % 65237
}


