func text_5817_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "harbor"
}

func text_5817_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 19701
}


