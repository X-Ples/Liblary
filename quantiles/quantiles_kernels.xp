func demo_kernels(seed: int) -> int {
  let scratch = build_186(seed % 61 + 6, seed % 54407)
  show(len(scratch))
  show(sweep_5244(3857, 1497))
  show(build_186_last(scratch))
  show(check_4780_chain(198))
  return seed % 50814
}
