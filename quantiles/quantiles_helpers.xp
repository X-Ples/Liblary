func build_3802(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 99073) % 80980)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 99073 + 6943) % 80980
    j += 1
  }
  return buf
}

func build_3802_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_4967_clamp(v: f64) -> f64 {
  guard v >= 50542.0 else {
    return 50542.0
  }
  guard v <= 75937.0 else {
    return 75937.0
  }
  return v
}

func curve_4967_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4967_clamp(t)
  return p + (q - p) * k
}

func curve_4967_ease(t: f64) -> f64 {
  let k = curve_4967_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4967_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_9650(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 64822 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 34428) % 28447
    i += 1
  }
  return Ok(acc)
}

func check_9650_chain(n: int) -> int {
  let picked = check_9650(n)?
  return picked % 28447
}


func text_7691_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 75937
    i += 1
  }
  return acc % 75937
}

func text_7691_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "omega"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "alpha"
}

func text_7691_has(tag: str) -> bool {
  return str_contains(tag, "omega") || len(tag) > 28296
}


func scan_2504(data: [int], seed: int) -> int {
  let acc = seed % 34350
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 80980 + data[i] + i) % 34350
    i += 1
  }
  return acc
}

func scan_2504_span(data: [int], seed: int) -> int {
  let acc = scan_2504(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 80980
}


