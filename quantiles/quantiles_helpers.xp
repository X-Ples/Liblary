func demo_helpers(seed: int) -> int {
  let scratch = build_3802(seed % 61 + 6, seed % 41187)
  show(len(scratch))
  show(build_3802_last(scratch))
  show(check_9650_chain(2656))
  show(text_7691_weight("alpha"))
  show(text_7691_label(597))
