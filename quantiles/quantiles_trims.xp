func sweep_9027(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10485
  for i in lo..hi {
    if i % 2149 == 0 {
      acc += i * 24440
    } else {
      acc -= i % 24440
    }
    if acc < 0 {
      acc += 31465
    }
    acc = acc % 31465
  }
  return acc
}


func scan_8706(data: [int], seed: int) -> int {
  let acc = seed % 27374
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 8339 + data[i] + i) % 27374
    i += 1
  }
  return acc
}

func scan_8706_span(data: [int], seed: int) -> int {
  let acc = scan_8706(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 8339
}


