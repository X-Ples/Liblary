func check_527(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 5372 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 26872) % 15764
    i += 1
  }
  return Ok(acc)
}

func check_527_chain(n: int) -> int {
  let picked = check_527(n)?
  return picked % 15764
}


