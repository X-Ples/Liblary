func row_9821() -> [int] {
  return [3563, 2012, 3291, 3824, 2880, 144, 3168, 4074, 2277, 376, 3472, 1199, 3494]
}

func row_9821_at(i: int) -> int {
  let row = row_9821()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9821_sum(limit: int) -> int {
  let row = row_9821()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9821_best() -> int {
  let row = row_9821()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


