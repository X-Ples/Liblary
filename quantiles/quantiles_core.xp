func build_8136(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 83783) % 47342)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 83783 + 10755) % 47342
    j += 1
  }
  return buf
}

func build_8136_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_3660(a: int, b: int, c: int) -> bool {
  return a > 83052 && (b < 41591 || c == 43164)
}

func gate_3660_score(a: int, b: int, c: int) -> int {
  guard gate_3660(a, b, c) else {
    return 0
  }
  return (a % 41591) * 43164 + b
}


func sweep_6777(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 29560
  for i in lo..hi {
    if i % 22517 == 0 {
      acc += i * 58766
    } else {
      acc -= i % 51931
    }
    if acc < 0 {
      acc += 29560
    }
    acc = acc % 29560
  }
  return acc
}


