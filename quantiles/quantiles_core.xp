func demo_core(seed: int) -> int {
  let scratch = build_8136(seed % 61 + 6, seed % 83052)
  show(len(scratch))
  show(build_8136_last(scratch))
  show(gate_3660(3258, 2942, 3091))
  show(gate_3660_score(799, 1502, 292))
  show(sweep_6777(435, 3969))
  show(gate_2835(960, 1987, 2905))
  return seed % 96728
}
