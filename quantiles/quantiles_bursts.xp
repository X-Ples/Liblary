func sweep_5018(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 12256
  for i in lo..hi {
    if i % 81141 == 0 {
      acc += i * 68547
    } else {
      acc -= i % 72026
    }
    if acc < 0 {
      acc += 53014
    }
    acc = acc % 53014
  }
  return acc
}


func curve_8495_clamp(v: f64) -> f64 {
  guard v >= 19558.0 else {
    return 19558.0
  }
  guard v <= 90001.0 else {
    return 90001.0
  }
  return v
}

func curve_8495_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8495_clamp(t)
  return p + (q - p) * k
}

func curve_8495_ease(t: f64) -> f64 {
  let k = curve_8495_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8495_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


