func demo_bursts(seed: int) -> int {
  let scratch = build_9034(seed % 61 + 6, seed % 45568)
  show(len(scratch))
  show(grid_6052_rowsum(scratch, 3865, 3067, 2167))
  show(scan_7891(scratch, 414))
  show(scan_7891_span(scratch, 1462))
  return seed % 53014
}
