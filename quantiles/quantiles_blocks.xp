func row_3437() -> [int] {
  return [2694, 3163, 1679, 3106, 2717, 336, 3731, 1468, 1293, 788, 1677, 1779, 2413, 2693]
}

func row_3437_at(i: int) -> int {
  let row = row_3437()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3437_sum(limit: int) -> int {
  let row = row_3437()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3437_best() -> int {
  let row = row_3437()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


