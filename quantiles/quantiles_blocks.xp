func curve_951_clamp(v: f64) -> f64 {
  guard v >= 37452.0 else {
    return 37452.0
  }
  guard v <= 91911.0 else {
    return 91911.0
  }
  return v
}

func curve_951_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_951_clamp(t)
  return p + (q - p) * k
}

func curve_951_ease(t: f64) -> f64 {
  let k = curve_951_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_951_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_8753_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 39308
    i += 1
  }
  return acc % 39308
}

func text_8753_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "sigma"
}

func text_8753_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 55825
}


