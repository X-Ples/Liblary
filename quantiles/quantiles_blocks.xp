func order_5167(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5167_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func check_5634(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 68166 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 82047) % 83564
    i += 1
  }
  return Ok(acc)
}

func check_5634_chain(n: int) -> int {
  let picked = check_5634(n)?
  return picked % 83564
}


func sweep_6864(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 18524
  for i in lo..hi {
    if i % 58637 == 0 {
      acc += i * 18399
    } else {
      acc -= i % 3953
    }
    if acc < 0 {
      acc += 89393
    }
    acc = acc % 89393
  }
  return acc
}


func grid_9105_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 27346 + c * 93399 + seed) % 93399)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9105_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 93399 == want {
      total += acc
    }
    r += 1
  }
  return total
}


