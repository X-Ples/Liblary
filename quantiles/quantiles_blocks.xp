func scan_4744(data: [int], seed: int) -> int {
  let acc = seed % 25680
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 39308 + data[i] + i) % 25680
    i += 1
  }
  return acc
}

func scan_4744_span(data: [int], seed: int) -> int {
  let acc = scan_4744(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 39308
}


