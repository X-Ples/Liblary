func demo_blocks(seed: int) -> int {
  let scratch = build_5555(seed % 61 + 6, seed % 58310)
  show(len(scratch))
  show(build_5555_last(scratch))
  show(build_5064_last(scratch))
  show(build_235_last(scratch))
  return seed % 58310
}
