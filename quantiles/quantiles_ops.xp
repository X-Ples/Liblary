func sweep_8291(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10351
  for i in lo..hi {
    if i % 29354 == 0 {
      acc += i * 21118
    } else {
      acc -= i % 63808
    }
    if acc < 0 {
      acc += 14002
    }
    acc = acc % 14002
  }
  return acc
}


func curve_2002_clamp(v: f64) -> f64 {
  guard v >= 33365.0 else {
    return 33365.0
  }
  guard v <= 95353.0 else {
    return 95353.0
  }
  return v
}

func curve_2002_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2002_clamp(t)
  return p + (q - p) * k
}

func curve_2002_ease(t: f64) -> f64 {
  let k = curve_2002_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2002_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


