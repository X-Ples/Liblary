func row_4137() -> [int] {
  return [103, 1900, 2626, 3724, 1233, 3545, 294, 1330, 920, 1400, 693, 3619, 388, 3586, 1971]
}

func row_4137_at(i: int) -> int {
  let row = row_4137()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4137_sum(limit: int) -> int {
  let row = row_4137()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4137_best() -> int {
  let row = row_4137()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


