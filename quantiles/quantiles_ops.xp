func build_9343(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 33757) % 33757)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 33757 + 86600) % 33757
    j += 1
  }
  return buf
}

func build_9343_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_7375_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 73911 + c * 91313 + seed) % 91313)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7375_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 91313 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_1423_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 55888
    i += 1
  }
  return acc % 55888
}

func text_1423_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "talus"
}

func text_1423_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 67317
}


