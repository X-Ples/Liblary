func check_772(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 23237 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 70627) % 86600
    i += 1
  }
  return Ok(acc)
}

func check_772_chain(n: int) -> int {
  let picked = check_772(n)?
  return picked % 86600
}


