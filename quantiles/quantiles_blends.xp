func row_4584() -> [int] {
  return [2218, 190, 2603, 1640, 1802, 4048, 2865, 175, 3151, 1480, 3915, 1527, 3544, 11, 2809, 957, 245, 1515, 2494]
}

func row_4584_at(i: int) -> int {
  let row = row_4584()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4584_sum(limit: int) -> int {
  let row = row_4584()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4584_best() -> int {
  let row = row_4584()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


