func demo_blends(seed: int) -> int {
  let scratch = build_8049(seed % 61 + 6, seed % 92845)
  show(len(scratch))
  show(build_8049_last(scratch))
  show(gate_6360(311, 2932, 683))
  show(gate_6360_score(2877, 961, 655))
  show(grid_9095_rowsum(scratch, 996, 569, 1206))
  show(build_7755_last(scratch))
  return seed % 42073
}
