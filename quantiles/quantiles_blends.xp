func build_8049(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 68218) % 58525)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 68218 + 60474) % 58525
    j += 1
  }
  return buf
}

func build_8049_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_6760_clamp(v: f64) -> f64 {
  guard v >= 28807.0 else {
    return 28807.0
  }
  guard v <= 80896.0 else {
    return 80896.0
  }
  return v
}

func curve_6760_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6760_clamp(t)
  return p + (q - p) * k
}

func curve_6760_ease(t: f64) -> f64 {
  let k = curve_6760_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6760_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_6360(a: int, b: int, c: int) -> bool {
  return a > 42943 && (b < 49102 || c == 43889)
}

func gate_6360_score(a: int, b: int, c: int) -> int {
  guard gate_6360(a, b, c) else {
    return 0
  }
  return (a % 49102) * 43889 + b
}


func grid_9095_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 52972 + c * 52972 + seed) % 52972)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9095_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 52972 == want {
      total += acc
    }
    r += 1
  }
  return total
}


