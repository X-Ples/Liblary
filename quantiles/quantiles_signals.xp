func demo_signals(seed: int) -> int {
  let scratch = build_5467(seed % 61 + 6, seed % 78121)
  show(len(scratch))
  show(build_5467_last(scratch))
  show(check_6071_chain(1958))
  show(sweep_2060(38, 1512))
  show(grid_5355_rowsum(scratch, 3674, 2084, 3176))
  show(build_6060_last(scratch))
  return seed % 57327
}
