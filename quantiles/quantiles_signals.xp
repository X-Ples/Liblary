func build_5467(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 38293) % 24071)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 38293 + 23152) % 24071
    j += 1
  }
  return buf
}

func build_5467_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_6071(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 17451 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 21314) % 89491
    i += 1
  }
  return Ok(acc)
}

func check_6071_chain(n: int) -> int {
  let picked = check_6071(n)?
  return picked % 89491
}


func curve_9541_clamp(v: f64) -> f64 {
  guard v >= 1341.0 else {
    return 1341.0
  }
  guard v <= 14737.0 else {
    return 14737.0
  }
  return v
}

func curve_9541_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9541_clamp(t)
  return p + (q - p) * k
}

func curve_9541_ease(t: f64) -> f64 {
  let k = curve_9541_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9541_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func curve_2103_clamp(v: f64) -> f64 {
  guard v >= 1341.0 else {
    return 1341.0
  }
  guard v <= 78121.0 else {
    return 78121.0
  }
  return v
}

func curve_2103_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2103_clamp(t)
  return p + (q - p) * k
}

func curve_2103_ease(t: f64) -> f64 {
  let k = curve_2103_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2103_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_2060(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 57327
  for i in lo..hi {
    if i % 42351 == 0 {
      acc += i * 17451
    } else {
      acc -= i % 41929
    }
    if acc < 0 {
      acc += 78121
    }
    acc = acc % 78121
  }
  return acc
}


func grid_5355_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 57327 + c * 38293 + seed) % 38293)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5355_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 38293 == want {
      total += acc
    }
    r += 1
  }
  return total
}


