func check_6449(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 13838 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 68897) % 24955
    i += 1
  }
  return Ok(acc)
}

func check_6449_chain(n: int) -> int {
  let picked = check_6449(n)?
  return picked % 24955
}


func curve_4748_clamp(v: f64) -> f64 {
  guard v >= 13838.0 else {
    return 13838.0
  }
  guard v <= 54592.0 else {
    return 54592.0
  }
  return v
}

func curve_4748_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4748_clamp(t)
  return p + (q - p) * k
}

func curve_4748_ease(t: f64) -> f64 {
  let k = curve_4748_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4748_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


