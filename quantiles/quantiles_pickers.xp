func demo_pickers(seed: int) -> int {
  let scratch = build_4392(seed % 61 + 6, seed % 38319)
  show(len(scratch))
  show(build_4392_last(scratch))
  show(grid_3954_rowsum(scratch, 3500, 1912, 18))
  show(scan_4384(scratch, 2626))
  show(scan_4384_span(scratch, 2819))
  show(order_5914_find(scratch, 3965))
  return seed % 6970
}
