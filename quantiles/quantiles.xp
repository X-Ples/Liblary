func row_1994() -> [int] {
  return [2572, 2958, 1182, 902, 2609, 384, 630, 1032, 208, 3549, 2920, 2849]
}

func row_1994_at(i: int) -> int {
  let row = row_1994()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1994_sum(limit: int) -> int {
  let row = row_1994()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1994_best() -> int {
  let row = row_1994()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


