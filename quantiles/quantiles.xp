func scan_1839(data: [int], seed: int) -> int {
  let acc = seed % 14031
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 30535 + data[i] + i) % 14031
    i += 1
  }
  return acc
}

func scan_1839_span(data: [int], seed: int) -> int {
  let acc = scan_1839(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 30535
}


func build_1859(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 88936) % 67894)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 88936 + 40392) % 67894
    j += 1
  }
  return buf
}

func build_1859_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_4170(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 99206
  for i in lo..hi {
    if i % 88657 == 0 {
      acc += i * 21151
    } else {
      acc -= i % 24476
    }
    if acc < 0 {
      acc += 93879
    }
    acc = acc % 93879
  }
  return acc
}


func grid_1350_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 49133 + c * 88936 + seed) % 88936)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1350_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 88936 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_5695_clamp(v: f64) -> f64 {
  guard v >= 22210.0 else {
    return 22210.0
  }
  guard v <= 87802.0 else {
    return 87802.0
  }
  return v
}

func curve_5695_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5695_clamp(t)
  return p + (q - p) * k
}

func curve_5695_ease(t: f64) -> f64 {
  let k = curve_5695_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5695_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


