func check_7990(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 67894 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 24476) % 36236
    i += 1
  }
  return Ok(acc)
}

func check_7990_chain(n: int) -> int {
  let picked = check_7990(n)?
  return picked % 36236
}


