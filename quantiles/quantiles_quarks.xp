func build_7417(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 27573) % 27573)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 27573 + 51868) % 27573
    j += 1
  }
  return buf
}

func build_7417_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_5709(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5709_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func grid_6684_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 23069 + c * 91701 + seed) % 91701)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6684_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 91701 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_6916_clamp(v: f64) -> f64 {
  guard v >= 1127.0 else {
    return 1127.0
  }
  guard v <= 93577.0 else {
    return 93577.0
  }
  return v
}

func curve_6916_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6916_clamp(t)
  return p + (q - p) * k
}

func curve_6916_ease(t: f64) -> f64 {
  let k = curve_6916_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6916_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_4934_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 6739
    i += 1
  }
  return acc % 6739
}

func text_4934_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "ridge"
}

func text_4934_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 85784
}


func row_865() -> [int] {
