func gate_6358(a: int, b: int, c: int) -> bool {
  return a > 1127 && (b < 42957 || c == 42957)
}

func gate_6358_score(a: int, b: int, c: int) -> int {
  guard gate_6358(a, b, c) else {
    return 0
  }
  return (a % 42957) * 42957 + b
}


func check_8311(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 12211 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 91701) % 77106
    i += 1
  }
  return Ok(acc)
}

func check_8311_chain(n: int) -> int {
  let picked = check_8311(n)?
  return picked % 77106
}


