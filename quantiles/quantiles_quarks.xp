func demo_quarks(seed: int) -> int {
  let scratch = build_7417(seed % 61 + 6, seed % 84928)
  show(len(scratch))
  show(build_7417_last(scratch))
  show(order_5709_find(scratch, 1321))
  show(grid_6684_rowsum(scratch, 3814, 1843, 3814))
  show(text_4934_weight("ridge"))
  return seed % 91701
}
