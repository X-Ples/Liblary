}

func text_6336_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "jetty"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "prism"
}

func text_6336_has(tag: str) -> bool {
  return str_contains(tag, "jetty") || len(tag) > 53608
}


func check_5863(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 71949 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 34858) % 42927
    i += 1
  }
  return Ok(acc)
}

func check_5863_chain(n: int) -> int {
  let picked = check_5863(n)?
  return picked % 42927
}


