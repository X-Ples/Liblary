func demo_checks(seed: int) -> int {
  let scratch = build_1903(seed % 61 + 6, seed % 26827)
  show(len(scratch))
  show(grid_783_rowsum(scratch, 28, 2916, 481))
  show(build_1903_last(scratch))
  show(sweep_4536(3039, 2887))
  show(sweep_2546(337, 3809))
  show(grid_2979_rowsum(scratch, 1917, 1063, 218))
  return seed % 10220
}
