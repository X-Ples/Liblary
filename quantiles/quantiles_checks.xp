func grid_783_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 85608 + c * 85608 + seed) % 85608)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_783_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 85608 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_1903(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 72845) % 26827)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 72845 + 90284) % 26827
    j += 1
  }
  return buf
}

func build_1903_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_4536(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 19694
  for i in lo..hi {
    if i % 42871 == 0 {
      acc += i * 19694
    } else {
      acc -= i % 25978
    }
    if acc < 0 {
      acc += 71949
    }
    acc = acc % 71949
  }
  return acc
}


