func scan_5061(data: [int], seed: int) -> int {
  let acc = seed % 71949
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 8760 + data[i] + i) % 71949
    i += 1
  }
  return acc
}

func scan_5061_span(data: [int], seed: int) -> int {
  let acc = scan_5061(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 8760
}


func gate_3585(a: int, b: int, c: int) -> bool {
  return a > 39947 && (b < 40832 || c == 58894)
}

func gate_3585_score(a: int, b: int, c: int) -> int {
  guard gate_3585(a, b, c) else {
    return 0
  }
  return (a % 40832) * 58894 + b
}


