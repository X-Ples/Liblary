func demo_ratchets(seed: int) -> int {
  let scratch = build_1220(seed % 61 + 6, seed % 42303)
  show(len(scratch))
  show(build_1220_last(scratch))
  show(row_329_at(933))
  show(row_329_sum(1876))
  show(row_329_best())
  return seed % 12105
}
