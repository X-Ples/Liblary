func check_5063(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 43894 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 53774) % 64434
    i += 1
  }
  return Ok(acc)
}

func check_5063_chain(n: int) -> int {
  let picked = check_5063(n)?
  return picked % 64434
}


