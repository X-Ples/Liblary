func scan_8575(data: [int], seed: int) -> int {
  let acc = seed % 12105
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 42035 + data[i] + i) % 12105
    i += 1
  }
  return acc
}

func scan_8575_span(data: [int], seed: int) -> int {
  let acc = scan_8575(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 42035
}


