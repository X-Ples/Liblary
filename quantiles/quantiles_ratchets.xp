func build_1220(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 42035) % 78491)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 42035 + 36183) % 78491
    j += 1
  }
  return buf
}

func build_1220_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_329() -> [int] {
  return [914, 206, 947, 914, 3881, 374, 3788, 1286, 1296, 3038, 527, 2572, 2473, 3832, 2237]
}

func row_329_at(i: int) -> int {
  let row = row_329()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_329_sum(limit: int) -> int {
  let row = row_329()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_329_best() -> int {
  let row = row_329()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_9519(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 43894
  for i in lo..hi {
    if i % 64434 == 0 {
      acc += i * 19860
    } else {
      acc -= i % 93625
    }
    if acc < 0 {
      acc += 43894
    }
    acc = acc % 43894
  }
  return acc
}


func curve_4469_clamp(v: f64) -> f64 {
  guard v >= 67158.0 else {
    return 67158.0
  }
  guard v <= 78491.0 else {
    return 78491.0
  }
  return v
}

func curve_4469_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4469_clamp(t)
  return p + (q - p) * k
}

func curve_4469_ease(t: f64) -> f64 {
  let k = curve_4469_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4469_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


