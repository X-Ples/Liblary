func demo_vectors2(seed: int) -> int {
  let scratch = build_1570(seed % 61 + 6, seed % 20298)
  show(len(scratch))
  show(build_1570_last(scratch))
  show(row_5717_at(3242))
  show(row_5717_sum(2556))
  show(row_5717_best())
  show(order_7518_find(scratch, 3246))
  return seed % 64860
}
