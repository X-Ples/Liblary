func scan_5000(data: [int], seed: int) -> int {
  let acc = seed % 70764
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 1813 + data[i] + i) % 70764
    i += 1
  }
  return acc
}

func scan_5000_span(data: [int], seed: int) -> int {
  let acc = scan_5000(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 1813
}


