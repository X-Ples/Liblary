func build_1570(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 94110) % 64860)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 94110 + 65814) % 64860
    j += 1
  }
  return buf
}

func build_1570_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_5717() -> [int] {
  return [304, 2522, 2893, 3567, 1609, 1485, 2502, 246, 2021, 1227, 3766, 2825, 2474, 2279, 2929, 2433, 1363, 1295, 2778, 3685, 1256]
}

func row_5717_at(i: int) -> int {
  let row = row_5717()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5717_sum(limit: int) -> int {
  let row = row_5717()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5717_best() -> int {
  let row = row_5717()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_6432_clamp(v: f64) -> f64 {
  guard v >= 59030.0 else {
    return 59030.0
  }
  guard v <= 72879.0 else {
    return 72879.0
  }
  return v
}

func curve_6432_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6432_clamp(t)
  return p + (q - p) * k
}

func curve_6432_ease(t: f64) -> f64 {
  let k = curve_6432_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6432_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_7518(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7518_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_9425_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
