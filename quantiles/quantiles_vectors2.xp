func sweep_3895(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 60353
  for i in lo..hi {
    if i % 59030 == 0 {
      acc += i * 59030
    } else {
      acc -= i % 37449
    }
    if acc < 0 {
      acc += 94110
    }
    acc = acc % 94110
  }
  return acc
}


func grid_6167_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 85496 + c * 68190 + seed) % 68190)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6167_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 68190 == want {
      total += acc
    }
    r += 1
  }
  return total
}


