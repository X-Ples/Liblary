}


func scan_8587(data: [int], seed: int) -> int {
  let acc = seed % 87381
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 66398 + data[i] + i) % 87381
    i += 1
  }
  return acc
}

func scan_8587_span(data: [int], seed: int) -> int {
  let acc = scan_8587(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 66398
}


