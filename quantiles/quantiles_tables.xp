func text_418_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 98271
    i += 1
  }
  return acc % 98271
}

func text_418_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "sigma"
}

func text_418_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 40285
}


func grid_3435_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 59901 + c * 40285 + seed) % 40285)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3435_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 40285 == want {
      total += acc
    }
    r += 1
  }
  return total
}


