func scan_8590(data: [int], seed: int) -> int {
  let acc = seed % 94569
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 48600 + data[i] + i) % 94569
    i += 1
  }
  return acc
}

func scan_8590_span(data: [int], seed: int) -> int {
  let acc = scan_8590(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 48600
}


