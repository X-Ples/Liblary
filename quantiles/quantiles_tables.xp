func demo_tables(seed: int) -> int {
  let scratch = build_266(seed % 61 + 6, seed % 40285)
  show(len(scratch))
  show(build_266_last(scratch))
  show(sweep_8746(2117, 79))
  show(build_4678_last(scratch))
  show(row_1252_at(1032))
  show(row_1252_sum(688))
  return seed % 64339
}
