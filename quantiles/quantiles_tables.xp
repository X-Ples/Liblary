func gate_6004(a: int, b: int, c: int) -> bool {
  return a > 73801 && (b < 75726 || c == 21782)
}

func gate_6004_score(a: int, b: int, c: int) -> int {
  guard gate_6004(a, b, c) else {
    return 0
  }
  return (a % 75726) * 21782 + b
}


func curve_4479_clamp(v: f64) -> f64 {
  guard v >= 52552.0 else {
    return 52552.0
  }
  guard v <= 55622.0 else {
    return 55622.0
  }
  return v
}

func curve_4479_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4479_clamp(t)
  return p + (q - p) * k
}

func curve_4479_ease(t: f64) -> f64 {
  let k = curve_4479_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4479_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_8073(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8073_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func check_1843(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 46059 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 29305) % 35727
    i += 1
  }
  return Ok(acc)
}

func check_1843_chain(n: int) -> int {
  let picked = check_1843(n)?
  return picked % 35727
}


