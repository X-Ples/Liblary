func build_266(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 73526) % 27882)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 73526 + 12120) % 27882
    j += 1
  }
  return buf
}

func build_266_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_8746(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 64339
  for i in lo..hi {
    if i % 64339 == 0 {
      acc += i * 47780
    } else {
      acc -= i % 59901
    }
    if acc < 0 {
      acc += 73801
    }
    acc = acc % 73801
  }
  return acc
}


