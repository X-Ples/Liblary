func scan_498(data: [int], seed: int) -> int {
  let acc = seed % 11179
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 56234 + data[i] + i) % 11179
    i += 1
  }
  return acc
}

func scan_498_span(data: [int], seed: int) -> int {
  let acc = scan_498(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 56234
}


func build_6705(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 51513) % 37547)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 51513 + 37547) % 37547
    j += 1
  }
  return buf
}

func build_6705_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


