func demo_reductions(seed: int) -> int {
  let scratch = build_6705(seed % 61 + 6, seed % 44126)
  show(len(scratch))
  show(scan_498(scratch, 3767))
  show(scan_498_span(scratch, 1361))
  show(build_6705_last(scratch))
  show(scan_4596(scratch, 820))
  return seed % 11179
}
