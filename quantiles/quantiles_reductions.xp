func row_837() -> [int] {
  return [3824, 2940, 749, 1530, 731, 3176, 1434, 867, 3280, 3412, 2997, 2703, 1455, 2214, 3181, 703, 820, 4007, 223, 3145]
}

func row_837_at(i: int) -> int {
  let row = row_837()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_837_sum(limit: int) -> int {
  let row = row_837()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_837_best() -> int {
  let row = row_837()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_8067(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 33030 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 78876) % 74470
    i += 1
  }
  return Ok(acc)
}

func check_8067_chain(n: int) -> int {
  let picked = check_8067(n)?
  return picked % 74470
}


