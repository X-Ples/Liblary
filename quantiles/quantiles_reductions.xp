func sweep_7019(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10910
  for i in lo..hi {
    if i % 78876 == 0 {
      acc += i * 87814
    } else {
      acc -= i % 11179
    }
    if acc < 0 {
      acc += 10785
    }
    acc = acc % 10785
  }
  return acc
}


func text_4499_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 56433
    i += 1
  }
  return acc % 56433
}

func text_4499_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "prism"
}

func text_4499_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 10785
}


