    let c = 0
    while c < cols {
      array_push(cells, (r * 71650 + c * 58535 + seed) % 58535)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6445_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
