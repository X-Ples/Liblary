func build_6423(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 7681) % 35448)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 7681 + 58535) % 35448
    j += 1
  }
  return buf
}

func build_6423_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_5995_clamp(v: f64) -> f64 {
  guard v >= 68081.0 else {
    return 68081.0
  }
  guard v <= 84321.0 else {
    return 84321.0
  }
  return v
}

func curve_5995_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5995_clamp(t)
  return p + (q - p) * k
}

func curve_5995_ease(t: f64) -> f64 {
  let k = curve_5995_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5995_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


