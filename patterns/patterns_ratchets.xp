func row_6695() -> [int] {
  return [3397, 4061, 3132, 1103, 1950, 404, 1592, 1187, 2712, 216, 2598, 2872, 2567, 2346, 2643, 3230, 436]
}

func row_6695_at(i: int) -> int {
  let row = row_6695()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6695_sum(limit: int) -> int {
  let row = row_6695()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6695_best() -> int {
  let row = row_6695()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_9843(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 85109 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 51788) % 88376
    i += 1
  }
  return Ok(acc)
}

func check_9843_chain(n: int) -> int {
  let picked = check_9843(n)?
  return picked % 88376
}


func build_6923(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 13398) % 88376)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 13398 + 88376) % 88376
    j += 1
  }
  return buf
}

func build_6923_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_8821_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 29938 + c * 65368 + seed) % 65368)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8821_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 65368 == want {
      total += acc
    }
    r += 1
  }
  return total
}


