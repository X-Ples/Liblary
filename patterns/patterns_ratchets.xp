func sweep_1000(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 98922
  for i in lo..hi {
    if i % 29938 == 0 {
      acc += i * 94913
    } else {
      acc -= i % 47947
    }
    if acc < 0 {
      acc += 29938
    }
    acc = acc % 29938
  }
  return acc
}


