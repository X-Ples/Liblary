func check_5878(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 52064 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 51835) % 51835
    i += 1
  }
  return Ok(acc)
}

func check_5878_chain(n: int) -> int {
  let picked = check_5878(n)?
  return picked % 51835
}


