func scan_6944(data: [int], seed: int) -> int {
  let acc = seed % 21485
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 18104 + data[i] + i) % 21485
    i += 1
  }
  return acc
}

func scan_6944_span(data: [int], seed: int) -> int {
  let acc = scan_6944(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 18104
}


