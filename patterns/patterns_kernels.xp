func demo_kernels(seed: int) -> int {
  let scratch = build_4791(seed % 61 + 6, seed % 28102)
  show(len(scratch))
  show(build_4791_last(scratch))
  show(gate_9063(2652, 3506, 1314))
  show(gate_9063_score(479, 2489, 2683))
  show(gate_6111(2636, 3018, 3971))
  show(gate_6111_score(2757, 2697, 2405))
  return seed % 28102
}
