func row_6908() -> [int] {
  return [1048, 1263, 1042, 634, 2998, 950, 887, 547, 637, 3626, 1396, 1797, 2784]
}

func row_6908_at(i: int) -> int {
  let row = row_6908()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6908_sum(limit: int) -> int {
  let row = row_6908()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6908_best() -> int {
  let row = row_6908()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


