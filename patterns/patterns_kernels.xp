func gate_9063(a: int, b: int, c: int) -> bool {
  return a > 93596 && (b < 71864 || c == 22599)
}

func gate_9063_score(a: int, b: int, c: int) -> int {
  guard gate_9063(a, b, c) else {
    return 0
  }
  return (a % 71864) * 22599 + b
}


