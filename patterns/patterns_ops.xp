func row_9074() -> [int] {
  return [2671, 966, 3575, 498, 1546, 1623, 2962, 3069, 1017, 168, 2532, 1628, 1375, 1664, 1939, 3782, 1592, 1440]
}

func row_9074_at(i: int) -> int {
  let row = row_9074()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9074_sum(limit: int) -> int {
  let row = row_9074()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9074_best() -> int {
  let row = row_9074()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


