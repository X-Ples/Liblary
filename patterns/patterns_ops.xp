func sweep_7154(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 34219
  for i in lo..hi {
    if i % 35663 == 0 {
      acc += i * 9404
    } else {
      acc -= i % 36338
    }
    if acc < 0 {
      acc += 2333
    }
    acc = acc % 2333
  }
  return acc
}


func build_8603(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 34219) % 34219)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 34219 + 12996) % 34219
    j += 1
  }
  return buf
}

func build_8603_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_9979(a: int, b: int, c: int) -> bool {
  return a > 78512 && (b < 80080 || c == 78512)
}

func gate_9979_score(a: int, b: int, c: int) -> int {
  guard gate_9979(a, b, c) else {
    return 0
  }
  return (a % 80080) * 78512 + b
}


func curve_5570_clamp(v: f64) -> f64 {
  guard v >= 12996.0 else {
    return 12996.0
  }
  guard v <= 78512.0 else {
    return 78512.0
  }
  return v
}

func curve_5570_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5570_clamp(t)
  return p + (q - p) * k
}

func curve_5570_ease(t: f64) -> f64 {
  let k = curve_5570_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5570_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_3607_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 34219 + c * 77253 + seed) % 77253)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3607_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 77253 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_1512(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 9763 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 50933) % 78117
    i += 1
  }
  return Ok(acc)
}

func check_1512_chain(n: int) -> int {
  let picked = check_1512(n)?
  return picked % 78117
}


