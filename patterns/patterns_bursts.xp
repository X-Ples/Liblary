func demo_bursts(seed: int) -> int {
  let scratch = build_9216(seed % 61 + 6, seed % 17298)
  show(len(scratch))
  show(build_9216_last(scratch))
  show(check_3526_chain(2625))
  show(text_6131_weight("jetty"))
  show(text_6131_label(1689))
  show(text_6131_has("jetty"))
  show(scan_7781(scratch, 1540))
  return seed % 40466
}
