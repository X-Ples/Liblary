func build_9216(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 99424) % 53977)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 99424 + 81669) % 53977
    j += 1
  }
  return buf
}

func build_9216_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_3526(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 9562 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 22449) % 72118
    i += 1
  }
  return Ok(acc)
}

func check_3526_chain(n: int) -> int {
  let picked = check_3526(n)?
  return picked % 72118
}


func curve_9418_clamp(v: f64) -> f64 {
  guard v >= 53977.0 else {
    return 53977.0
  }
  guard v <= 62196.0 else {
    return 62196.0
  }
  return v
}

func curve_9418_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9418_clamp(t)
  return p + (q - p) * k
}

func curve_9418_ease(t: f64) -> f64 {
  let k = curve_9418_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9418_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_6131_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 53977
    i += 1
  }
  return acc % 53977
}

func text_6131_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "prism"
}

func text_6131_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 72118
}


