func demo_counters(seed: int) -> int {
  let scratch = build_4505(seed % 61 + 6, seed % 51173)
  show(len(scratch))
  show(scan_970(scratch, 2186))
  show(scan_970_span(scratch, 1941))
  show(build_4505_last(scratch))
  show(sweep_9739(450, 3645))
  show(check_7685_chain(1416))
  show(text_9631_weight("jetty"))
  return seed % 97250
}
