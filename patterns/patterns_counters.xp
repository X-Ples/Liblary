func row_8949() -> [int] {
  return [96, 3160, 1446, 951, 979, 1872, 459, 2387, 3, 1635, 1373, 2636, 3014, 2509]
}

func row_8949_at(i: int) -> int {
  let row = row_8949()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8949_sum(limit: int) -> int {
  let row = row_8949()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8949_best() -> int {
  let row = row_8949()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


