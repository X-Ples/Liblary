func scan_970(data: [int], seed: int) -> int {
  let acc = seed % 7978
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 6982 + data[i] + i) % 7978
    i += 1
  }
  return acc
}

func scan_970_span(data: [int], seed: int) -> int {
  let acc = scan_970(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 6982
}


func build_4505(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 44969) % 97250)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 44969 + 13399) % 97250
    j += 1
  }
  return buf
}

func build_4505_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_9739(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 66260
  for i in lo..hi {
    if i % 44372 == 0 {
      acc += i * 44372
    } else {
      acc -= i % 13859
    }
    if acc < 0 {
      acc += 64815
    }
    acc = acc % 64815
  }
  return acc
}


func check_7685(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 6982 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 12768) % 92361
    i += 1
  }
  return Ok(acc)
}

func check_7685_chain(n: int) -> int {
  let picked = check_7685(n)?
  return picked % 92361
}


