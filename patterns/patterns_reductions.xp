func build_2949(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 53855) % 48888)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 53855 + 77630) % 48888
    j += 1
  }
  return buf
}

func build_2949_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_1172() -> [int] {
  return [3152, 2075, 1418, 1617, 140, 35, 3102, 941, 2153, 496, 2418, 3583, 3694, 1728, 2176, 781, 1049, 2403, 1137, 477]
}

func row_1172_at(i: int) -> int {
  let row = row_1172()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1172_sum(limit: int) -> int {
  let row = row_1172()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1172_best() -> int {
  let row = row_1172()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_1068_clamp(v: f64) -> f64 {
  guard v >= 32747.0 else {
    return 32747.0
  }
  guard v <= 57958.0 else {
    return 57958.0
  }
  return v
}

func curve_1068_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1068_clamp(t)
  return p + (q - p) * k
}

func curve_1068_ease(t: f64) -> f64 {
  let k = curve_1068_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1068_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


