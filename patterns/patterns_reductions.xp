func demo_reductions(seed: int) -> int {
  let scratch = build_2949(seed % 61 + 6, seed % 85871)
  show(len(scratch))
  show(build_2949_last(scratch))
  show(row_1172_at(3061))
  show(row_1172_sum(2468))
  show(row_1172_best())
  return seed % 73036
}
