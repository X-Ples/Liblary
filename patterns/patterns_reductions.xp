func text_6006_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 14193
    i += 1
  }
  return acc % 14193
}

func text_6006_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "delta"
}

func text_6006_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 63833
}


func sweep_2020(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 31702
  for i in lo..hi {
    if i % 90740 == 0 {
      acc += i * 73984
    } else {
      acc -= i % 56636
    }
    if acc < 0 {
      acc += 90740
    }
    acc = acc % 90740
  }
  return acc
}


