func check_3850(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 90740 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 63833) % 48888
    i += 1
  }
  return Ok(acc)
}

func check_3850_chain(n: int) -> int {
  let picked = check_3850(n)?
  return picked % 48888
}


