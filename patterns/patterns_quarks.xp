func demo_quarks(seed: int) -> int {
  let scratch = build_8802(seed % 61 + 6, seed % 8467)
  show(len(scratch))
  show(build_8802_last(scratch))
  show(check_6044_chain(3571))
  show(gate_653(1396, 746, 3514))
  return seed % 56730
}
