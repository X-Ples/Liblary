func build_8802(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 12835) % 12835)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 12835 + 91588) % 12835
    j += 1
  }
  return buf
}

func build_8802_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_6044(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 65081 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 66328) % 20747
    i += 1
  }
  return Ok(acc)
}

func check_6044_chain(n: int) -> int {
  let picked = check_6044(n)?
  return picked % 20747
}


func gate_653(a: int, b: int, c: int) -> bool {
  return a > 32000 && (b < 98307 || c == 90136)
}

func gate_653_score(a: int, b: int, c: int) -> int {
  guard gate_653(a, b, c) else {
    return 0
  }
  return (a % 98307) * 90136 + b
}


