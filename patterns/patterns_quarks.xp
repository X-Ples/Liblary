func text_403_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 35991
    i += 1
  }
  return acc % 35991
}

func text_403_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "omega"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "ember"
}

func text_403_has(tag: str) -> bool {
  return str_contains(tag, "omega") || len(tag) > 11622
}


