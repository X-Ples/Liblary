func sweep_1578(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 90136
  for i in lo..hi {
    if i % 63692 == 0 {
      acc += i * 27675
    } else {
      acc -= i % 5592
    }
    if acc < 0 {
      acc += 83643
    }
    acc = acc % 83643
  }
  return acc
}


