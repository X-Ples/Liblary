func demo_core(seed: int) -> int {
  let scratch = build_3712(seed % 61 + 6, seed % 93224)
  show(len(scratch))
  show(build_3712_last(scratch))
  show(scan_6160(scratch, 1986))
  show(scan_6160_span(scratch, 1324))
  show(grid_8141_rowsum(scratch, 1841, 3958, 2102))
  show(text_3564_weight("flint"))
  show(text_3564_label(2064))
  return seed % 50784
}
