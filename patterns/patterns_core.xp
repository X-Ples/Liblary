func build_3712(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 87240) % 77084)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 87240 + 96153) % 77084
    j += 1
  }
  return buf
}

func build_3712_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_6160(data: [int], seed: int) -> int {
  let acc = seed % 96153
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 12684 + data[i] + i) % 96153
    i += 1
  }
  return acc
}

func scan_6160_span(data: [int], seed: int) -> int {
  let acc = scan_6160(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 12684
}


func grid_8141_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 15498 + c * 77084 + seed) % 77084)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8141_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 77084 == want {
      total += acc
    }
    r += 1
  }
  return total
}


