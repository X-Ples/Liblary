func sweep_7437(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 45749
  for i in lo..hi {
    if i % 15588 == 0 {
      acc += i * 85106
    } else {
      acc -= i % 6701
    }
    if acc < 0 {
      acc += 6128
    }
    acc = acc % 6128
  }
  return acc
}


