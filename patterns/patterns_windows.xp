func scan_4817(data: [int], seed: int) -> int {
  let acc = seed % 24444
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 85412 + data[i] + i) % 24444
    i += 1
  }
  return acc
}

func scan_4817_span(data: [int], seed: int) -> int {
  let acc = scan_4817(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 85412
}


