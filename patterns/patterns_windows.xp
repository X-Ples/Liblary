func demo_windows(seed: int) -> int {
  let scratch = build_1643(seed % 61 + 6, seed % 8790)
  show(len(scratch))
  show(row_412_at(1123))
  show(row_412_sum(1238))
  show(row_412_best())
  show(build_1643_last(scratch))
  show(build_7664_last(scratch))
  show(build_2256_last(scratch))
  return seed % 7806
}
