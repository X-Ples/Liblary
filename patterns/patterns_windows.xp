func check_6727(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 40595 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 1316) % 74490
    i += 1
  }
  return Ok(acc)
}

func check_6727_chain(n: int) -> int {
  let picked = check_6727(n)?
  return picked % 74490
}


func sweep_124(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 32888
  for i in lo..hi {
    if i % 32888 == 0 {
      acc += i * 23350
    } else {
      acc -= i % 57690
    }
    if acc < 0 {
      acc += 278
    }
    acc = acc % 278
  }
  return acc
}


