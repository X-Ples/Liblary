func row_412() -> [int] {
  return [768, 3052, 3627, 808, 1511, 3452, 1177, 1361, 650, 519, 707, 2797, 3457, 3946, 2028, 1171, 206]
}

func row_412_at(i: int) -> int {
  let row = row_412()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_412_sum(limit: int) -> int {
  let row = row_412()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_412_best() -> int {
  let row = row_412()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_1643(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 1316) % 90423)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 1316 + 80843) % 90423
    j += 1
  }
  return buf
}

func build_1643_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


