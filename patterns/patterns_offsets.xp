func build_6670(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 48173) % 82672)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 48173 + 6562) % 82672
    j += 1
  }
  return buf
}

func build_6670_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_7279_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 24341
    i += 1
  }
  return acc % 24341
}

func text_7279_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "flint"
}

func text_7279_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 32277
}


func gate_3319(a: int, b: int, c: int) -> bool {
  return a > 62767 && (b < 10157 || c == 62767)
}

func gate_3319_score(a: int, b: int, c: int) -> int {
  guard gate_3319(a, b, c) else {
    return 0
  }
  return (a % 10157) * 62767 + b
}


func grid_2985_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 34048 + c * 67969 + seed) % 67969)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2985_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 67969 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_4330(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 51442 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 62767) % 34048
    i += 1
  }
  return Ok(acc)
}

func check_4330_chain(n: int) -> int {
  let picked = check_4330(n)?
  return picked % 34048
}


func curve_8723_clamp(v: f64) -> f64 {
  guard v >= 35469.0 else {
    return 35469.0
  }
  guard v <= 67969.0 else {
    return 67969.0
  }
  return v
}

func curve_8723_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8723_clamp(t)
  return p + (q - p) * k
}

func curve_8723_ease(t: f64) -> f64 {
  let k = curve_8723_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8723_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


