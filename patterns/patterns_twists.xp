func scan_8738(data: [int], seed: int) -> int {
  let acc = seed % 386
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 81502 + data[i] + i) % 386
    i += 1
  }
  return acc
}

func scan_8738_span(data: [int], seed: int) -> int {
  let acc = scan_8738(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 81502
}


