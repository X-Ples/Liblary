func demo_twists(seed: int) -> int {
  let scratch = build_8859(seed % 61 + 6, seed % 94830)
  show(len(scratch))
  show(gate_9890(3694, 3325, 2560))
  show(gate_9890_score(3406, 1135, 1317))
  show(build_8859_last(scratch))
  return seed % 39473
}
