      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4926_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 81390 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_9383(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 81390 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 17294) % 88726
    i += 1
  }
  return Ok(acc)
}

func check_9383_chain(n: int) -> int {
  let picked = check_9383(n)?
  return picked % 88726
}


func sweep_9734(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 81502
  for i in lo..hi {
    if i % 84774 == 0 {
      acc += i * 36994
    } else {
      acc -= i % 69496
    }
    if acc < 0 {
      acc += 31255
    }
    acc = acc % 31255
  }
  return acc
}


