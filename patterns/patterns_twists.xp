const K0 = 81390
const K1 = 69496
const K2 = 31811
const K3 = 38900
const K4 = 21594
const K5 = 89825

func gate_9890(a: int, b: int, c: int) -> bool {
  return a > 60388 && (b < 88726 || c == 7236)
}

func gate_9890_score(a: int, b: int, c: int) -> int {
  guard gate_9890(a, b, c) else {
    return 0
  }
  return (a % 88726) * 7236 + b
}


func build_8859(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 17294) % 84774)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 17294 + 38900) % 84774
    j += 1
  }
  return buf
}

func build_8859_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_8836_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 17294 + c * 24190 + seed) % 24190)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8836_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 24190 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_1733_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 96536
    i += 1
  }
  return acc % 96536
}

func text_1733_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "talus"
}

func text_1733_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 81502
}


func order_7292(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7292_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


