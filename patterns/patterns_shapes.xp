func build_8773(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 74661) % 19648)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 74661 + 3708) % 19648
    j += 1
  }
  return buf
}

func build_8773_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_7538(a: int, b: int, c: int) -> bool {
  return a > 85350 && (b < 3018 || c == 25284)
}

func gate_7538_score(a: int, b: int, c: int) -> int {
  guard gate_7538(a, b, c) else {
    return 0
  }
  return (a % 3018) * 25284 + b
}


func check_7227(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 15643 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 79912) % 3018
    i += 1
  }
  return Ok(acc)
}

func check_7227_chain(n: int) -> int {
  let picked = check_7227(n)?
  return picked % 3018
}


func sweep_6327(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 42433
  for i in lo..hi {
    if i % 11246 == 0 {
      acc += i * 95744
    } else {
      acc -= i % 94844
    }
    if acc < 0 {
      acc += 3018
    }
    acc = acc % 3018
  }
  return acc
}


func curve_601_clamp(v: f64) -> f64 {
  guard v >= 74661.0 else {
    return 74661.0
  }
  guard v <= 75811.0 else {
    return 75811.0
  }
  return v
}

func curve_601_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_601_clamp(t)
  return p + (q - p) * k
}

func curve_601_ease(t: f64) -> f64 {
  let k = curve_601_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_601_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


