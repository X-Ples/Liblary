func row_2121() -> [int] {
  return [1854, 2534, 488, 4090, 3950, 2909, 3088, 399, 830, 4041, 86, 1429, 830, 2474, 3740, 3706, 1387]
}

func row_2121_at(i: int) -> int {
  let row = row_2121()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2121_sum(limit: int) -> int {
  let row = row_2121()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2121_best() -> int {
  let row = row_2121()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


