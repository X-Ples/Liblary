func curve_3860_clamp(v: f64) -> f64 {
  guard v >= 44183.0 else {
    return 44183.0
  }
  guard v <= 77207.0 else {
    return 77207.0
  }
  return v
}

func curve_3860_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3860_clamp(t)
  return p + (q - p) * k
}

func curve_3860_ease(t: f64) -> f64 {
  let k = curve_3860_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3860_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_2913_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 33111
    i += 1
  }
  return acc % 33111
}

func text_2913_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "bravo"
}

func text_2913_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 18354
}


func build_2394(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 6501) % 31253)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 6501 + 6501) % 31253
    j += 1
  }
  return buf
}

func build_2394_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_7520_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 20550 + c * 20287 + seed) % 20287)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7520_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 20287 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_2302(data: [int], seed: int) -> int {
  let acc = seed % 64842
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 30149 + data[i] + i) % 64842
    i += 1
  }
  return acc
}

func scan_2302_span(data: [int], seed: int) -> int {
  let acc = scan_2302(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 30149
}


