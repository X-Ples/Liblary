func check_1040(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 923 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 3285) % 50779
    i += 1
  }
  return Ok(acc)
}

func check_1040_chain(n: int) -> int {
  let picked = check_1040(n)?
  return picked % 50779
}


