func check_1924(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 75158 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 75158) % 90537
    i += 1
  }
  return Ok(acc)
}

func check_1924_chain(n: int) -> int {
  let picked = check_1924(n)?
  return picked % 90537
}


