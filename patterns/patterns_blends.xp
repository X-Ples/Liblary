func scan_1670(data: [int], seed: int) -> int {
  let acc = seed % 81816
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 42704 + data[i] + i) % 81816
    i += 1
  }
  return acc
}

func scan_1670_span(data: [int], seed: int) -> int {
  let acc = scan_1670(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 42704
}


