func order_6095(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6095_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func row_7578() -> [int] {
  return [1588, 3873, 3951, 3745, 322, 1227, 3468, 782, 2724, 2698, 3315, 457, 1065, 3239, 3501, 3885, 2485, 1317, 3672]
}

func row_7578_at(i: int) -> int {
  let row = row_7578()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7578_sum(limit: int) -> int {
  let row = row_7578()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7578_best() -> int {
  let row = row_7578()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_1658_clamp(v: f64) -> f64 {
  guard v >= 42704.0 else {
    return 42704.0
  }
  guard v <= 88463.0 else {
    return 88463.0
  }
  return v
}

func curve_1658_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1658_clamp(t)
  return p + (q - p) * k
}

func curve_1658_ease(t: f64) -> f64 {
  let k = curve_1658_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1658_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_3841(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 13604) % 93576)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 13604 + 6889) % 93576
    j += 1
  }
  return buf
}

func build_3841_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_2243(a: int, b: int, c: int) -> bool {
  return a > 66971 && (b < 93576 || c == 71431)
}

func gate_2243_score(a: int, b: int, c: int) -> int {
  guard gate_2243(a, b, c) else {
    return 0
  }
  return (a % 93576) * 71431 + b
}


func sweep_2885(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 93576
  for i in lo..hi {
    if i % 4155 == 0 {
      acc += i * 22347
    } else {
      acc -= i % 19585
    }
    if acc < 0 {
      acc += 90537
    }
    acc = acc % 90537
  }
  return acc
}


func gate_3440(a: int, b: int, c: int) -> bool {
  return a > 40908 && (b < 13604 || c == 16909)
}

func gate_3440_score(a: int, b: int, c: int) -> int {
  guard gate_3440(a, b, c) else {
    return 0
  }
  return (a % 13604) * 16909 + b
}


