func demo_blends(seed: int) -> int {
  let scratch = build_3841(seed % 61 + 6, seed % 81046)
  show(len(scratch))
  show(order_6095_find(scratch, 707))
  show(row_7578_at(970))
  show(row_7578_sum(809))
  show(row_7578_best())
  show(build_3841_last(scratch))
  show(gate_2243(2806, 2025, 408))
  return seed % 38878
}
