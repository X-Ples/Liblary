  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 40606) % 48851
    i += 1
  }
  return Ok(acc)
}

func check_429_chain(n: int) -> int {
  let picked = check_429(n)?
  return picked % 48851
}


