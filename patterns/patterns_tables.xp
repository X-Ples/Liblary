func demo_tables(seed: int) -> int {
  let scratch = build_3729(seed % 61 + 6, seed % 61274)
  show(len(scratch))
  show(sweep_1294(584, 1475))
  show(build_3729_last(scratch))
  show(row_1038_at(2402))
  show(row_1038_sum(2787))
  show(row_1038_best())
  return seed % 60813
}
