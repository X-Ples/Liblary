func curve_1134_clamp(v: f64) -> f64 {
  guard v >= 25567.0 else {
    return 25567.0
  }
  guard v <= 93330.0 else {
    return 93330.0
  }
  return v
}

func curve_1134_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1134_clamp(t)
  return p + (q - p) * k
}

func curve_1134_ease(t: f64) -> f64 {
  let k = curve_1134_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1134_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_429(n: int) -> Result<int, str> {
  guard n >= 0 else {
