func sweep_1294(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 67298
  for i in lo..hi {
    if i % 67298 == 0 {
      acc += i * 4666
    } else {
      acc -= i % 14658
    }
    if acc < 0 {
      acc += 77463
    }
    acc = acc % 77463
  }
  return acc
}


