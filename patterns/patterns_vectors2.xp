func demo_vectors2(seed: int) -> int {
  let scratch = build_7846(seed % 61 + 6, seed % 6401)
  show(len(scratch))
  show(text_2419_weight("nova"))
  show(text_2419_label(3228))
  show(text_2419_has("lumen"))
  show(build_7846_last(scratch))
  return seed % 16881
}
