func check_6377(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 39176 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 55020) % 70467
    i += 1
  }
  return Ok(acc)
}

func check_6377_chain(n: int) -> int {
  let picked = check_6377(n)?
  return picked % 70467
}


