func text_2419_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 7080
    i += 1
  }
  return acc % 7080
}

func text_2419_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "omega"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "quartz"
}

func text_2419_has(tag: str) -> bool {
  return str_contains(tag, "omega") || len(tag) > 37509
}


func build_7846(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 27871) % 33862)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 27871 + 28399) % 33862
    j += 1
  }
  return buf
}

func build_7846_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


