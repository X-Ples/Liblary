func curve_1902_clamp(v: f64) -> f64 {
  guard v >= 57210.0 else {
    return 57210.0
  }
  guard v <= 70467.0 else {
    return 70467.0
  }
  return v
}

func curve_1902_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1902_clamp(t)
  return p + (q - p) * k
}

func curve_1902_ease(t: f64) -> f64 {
  let k = curve_1902_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1902_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


