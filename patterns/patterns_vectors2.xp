func gate_9286(a: int, b: int, c: int) -> bool {
  return a > 27871 && (b < 81557 || c == 55020)
}

func gate_9286_score(a: int, b: int, c: int) -> int {
  guard gate_9286(a, b, c) else {
    return 0
  }
  return (a % 81557) * 55020 + b
