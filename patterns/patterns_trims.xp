func row_2699() -> [int] {
  return [2298, 809, 2569, 1653, 3288, 4091, 668, 2919, 227, 860, 3407, 1164, 2953, 2060]
}

func row_2699_at(i: int) -> int {
  let row = row_2699()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2699_sum(limit: int) -> int {
  let row = row_2699()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2699_best() -> int {
  let row = row_2699()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_6474(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 12782) % 74794)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 12782 + 81800) % 74794
    j += 1
  }
  return buf
}

func build_6474_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_2633_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 17560
    i += 1
  }
  return acc % 17560
}

func text_2633_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "omega"
}

func text_2633_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 63585
}


func check_5598(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 82589 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 82589) % 85756
    i += 1
  }
  return Ok(acc)
}

func check_5598_chain(n: int) -> int {
  let picked = check_5598(n)?
  return picked % 85756
}


func curve_6131_clamp(v: f64) -> f64 {
  guard v >= 5656.0 else {
    return 5656.0
  }
  guard v <= 74221.0 else {
    return 74221.0
  }
  return v
}

func curve_6131_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6131_clamp(t)
  return p + (q - p) * k
}

func curve_6131_ease(t: f64) -> f64 {
  let k = curve_6131_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6131_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


