func text_3350_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 94767
    i += 1
  }
  return acc % 94767
}

func text_3350_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "talus"
}

func text_3350_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 79545
}


func scan_9634(data: [int], seed: int) -> int {
  let acc = seed % 71994
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 25736 + data[i] + i) % 71994
    i += 1
  }
  return acc
}

func scan_9634_span(data: [int], seed: int) -> int {
  let acc = scan_9634(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 25736
}


func curve_9127_clamp(v: f64) -> f64 {
  guard v >= 37020.0 else {
    return 37020.0
  }
  guard v <= 81607.0 else {
    return 81607.0
  }
  return v
}

func curve_9127_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9127_clamp(t)
  return p + (q - p) * k
}

func curve_9127_ease(t: f64) -> f64 {
  let k = curve_9127_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9127_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


