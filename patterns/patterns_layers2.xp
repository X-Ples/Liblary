func sweep_507(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 17686
  for i in lo..hi {
    if i % 58956 == 0 {
      acc += i * 62172
    } else {
      acc -= i % 53842
    }
    if acc < 0 {
      acc += 69681
    }
    acc = acc % 69681
  }
  return acc
}


