func check_5408(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 52527 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 16664) % 69681
    i += 1
  }
  return Ok(acc)
}

func check_5408_chain(n: int) -> int {
  let picked = check_5408(n)?
  return picked % 69681
}


