func scan_577(data: [int], seed: int) -> int {
  let acc = seed % 62172
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 30107 + data[i] + i) % 62172
    i += 1
  }
  return acc
}

func scan_577_span(data: [int], seed: int) -> int {
  let acc = scan_577(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 30107
}


