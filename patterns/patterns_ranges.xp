func scan_8498(data: [int], seed: int) -> int {
  let acc = seed % 98900
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 29385 + data[i] + i) % 98900
    i += 1
  }
  return acc
}

func scan_8498_span(data: [int], seed: int) -> int {
  let acc = scan_8498(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 29385
}


