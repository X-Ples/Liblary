func demo_ranges(seed: int) -> int {
  let scratch = build_9308(seed % 61 + 6, seed % 72024)
  show(len(scratch))
  show(build_9308_last(scratch))
  show(gate_8997(3438, 1234, 31))
  show(gate_8997_score(2032, 2545, 2800))
  return seed % 86591
}
