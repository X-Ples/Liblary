func build_9308(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 37817) % 29385)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 37817 + 98900) % 29385
    j += 1
  }
  return buf
}

func build_9308_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_8997(a: int, b: int, c: int) -> bool {
  return a > 50612 && (b < 89562 || c == 86591)
}

func gate_8997_score(a: int, b: int, c: int) -> int {
  guard gate_8997(a, b, c) else {
    return 0
  }
  return (a % 89562) * 86591 + b
}


