func sweep_2361(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 34694
  for i in lo..hi {
    if i % 82877 == 0 {
      acc += i * 14452
    } else {
      acc -= i % 51843
    }
    if acc < 0 {
      acc += 29385
    }
    acc = acc % 29385
  }
  return acc
}


