func check_4002(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 6742 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 86719) % 79106
    i += 1
  }
  return Ok(acc)
}

func check_4002_chain(n: int) -> int {
  let picked = check_4002(n)?
  return picked % 79106
}


func build_4963(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 81233) % 58025)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 81233 + 74169) % 58025
    j += 1
  }
  return buf
}

func build_4963_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_6465_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 20233
    i += 1
  }
  return acc % 20233
}

func text_6465_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "jetty"
}

func text_6465_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 4375
}


func row_433() -> [int] {
