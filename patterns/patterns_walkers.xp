func demo_walkers(seed: int) -> int {
  let scratch = build_4963(seed % 61 + 6, seed % 17518)
  show(len(scratch))
  show(check_4002_chain(2725))
  show(build_4963_last(scratch))
  show(text_6465_weight("harbor"))
  show(text_6465_label(1561))
  show(text_6465_has("gamma"))
  show(row_433_at(2324))
  return seed % 82473
}
