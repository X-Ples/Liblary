func check_8499(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 36455 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 84081) % 68541
    i += 1
  }
  return Ok(acc)
}

func check_8499_chain(n: int) -> int {
  let picked = check_8499(n)?
  return picked % 68541
}


func curve_583_clamp(v: f64) -> f64 {
  guard v >= 53774.0 else {
    return 53774.0
  }
  guard v <= 93569.0 else {
    return 93569.0
  }
  return v
}

func curve_583_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_583_clamp(t)
  return p + (q - p) * k
}

func curve_583_ease(t: f64) -> f64 {
  let k = curve_583_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_583_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


