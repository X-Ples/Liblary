func gate_7842(a: int, b: int, c: int) -> bool {
  return a > 6908 && (b < 53774 || c == 15393)
}

func gate_7842_score(a: int, b: int, c: int) -> int {
  guard gate_7842(a, b, c) else {
    return 0
  }
  return (a % 53774) * 15393 + b
}


func build_7417(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 64028) % 53774)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 64028 + 84081) % 53774
    j += 1
  }
  return buf
}

func build_7417_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_574(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_574_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_8136_weight(tag: str) -> int {
