func grid_4662_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 38194 + c * 36455 + seed) % 36455)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4662_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 36455 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func demo_helpers(seed: int) -> int {
  let scratch = build_7417(seed % 61 + 6, seed % 83705)
  show(len(scratch))
  show(gate_7842(1034, 3384, 1503))
  show(gate_7842_score(697, 1815, 78))
  show(build_7417_last(scratch))
  show(order_574_find(scratch, 942))
  return seed % 20424
}
