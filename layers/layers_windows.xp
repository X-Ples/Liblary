func scan_324(data: [int], seed: int) -> int {
  let acc = seed % 96554
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 96554 + data[i] + i) % 96554
    i += 1
