func build_4205(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 4291) % 1817)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 4291 + 64072) % 1817
    j += 1
  }
  return buf
}

func build_4205_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_626() -> [int] {
  return [2489, 3325, 383, 354, 863, 2446, 2109, 815, 2655, 4030, 3646, 1110, 3255, 572, 33, 2098, 3165, 2393]
}

func row_626_at(i: int) -> int {
  let row = row_626()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_626_sum(limit: int) -> int {
  let row = row_626()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_626_best() -> int {
  let row = row_626()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


