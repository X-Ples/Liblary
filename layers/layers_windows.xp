}


func sweep_8828(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 96554
  for i in lo..hi {
    if i % 16072 == 0 {
      acc += i * 69594
    } else {
      acc -= i % 1817
    }
    if acc < 0 {
      acc += 93359
    }
    acc = acc % 93359
  }
  return acc
}


