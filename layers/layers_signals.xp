func sweep_5968(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 85327
  for i in lo..hi {
    if i % 77913 == 0 {
      acc += i * 55121
    } else {
      acc -= i % 70384
    }
    if acc < 0 {
      acc += 78565
    }
    acc = acc % 78565
  }
  return acc
}


