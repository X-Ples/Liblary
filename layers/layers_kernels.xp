func demo_kernels(seed: int) -> int {
  let scratch = build_9620(seed % 61 + 6, seed % 58503)
  show(len(scratch))
  show(build_9620_last(scratch))
  show(sweep_1047(847, 764))
  show(sweep_4197(617, 3887))
  return seed % 16722
}
