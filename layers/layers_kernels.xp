func build_9620(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 9537) % 47794)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 9537 + 2281) % 47794
    j += 1
  }
  return buf
}

func build_9620_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_1047(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 47794
  for i in lo..hi {
    if i % 50367 == 0 {
      acc += i * 89368
    } else {
      acc -= i % 2281
    }
    if acc < 0 {
      acc += 67615
    }
    acc = acc % 67615
  }
  return acc
}


