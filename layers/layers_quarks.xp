func curve_9811_clamp(v: f64) -> f64 {
  guard v >= 62880.0 else {
    return 62880.0
  }
  guard v <= 84742.0 else {
    return 84742.0
  }
  return v
}

func curve_9811_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9811_clamp(t)
  return p + (q - p) * k
}

func curve_9811_ease(t: f64) -> f64 {
  let k = curve_9811_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9811_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_7359(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 63777 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 89356) % 91260
    i += 1
  }
  return Ok(acc)
}

func check_7359_chain(n: int) -> int {
  let picked = check_7359(n)?
  return picked % 91260
}


func grid_5767_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 44640 + c * 44640 + seed) % 44640)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5767_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 44640 == want {
      total += acc
    }
    r += 1
  }
  return total
}


