func scan_6081(data: [int], seed: int) -> int {
  let acc = seed % 83669
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 30885 + data[i] + i) % 83669
    i += 1
  }
  return acc
}

func scan_6081_span(data: [int], seed: int) -> int {
  let acc = scan_6081(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 30885
}


