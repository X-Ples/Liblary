const K0 = 70285
const K1 = 97805
const K2 = 51128
const K3 = 2601
const K4 = 51128
const K5 = 29490

func grid_5395_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 39465 + c * 23988 + seed) % 23988)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5395_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 23988 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_2893(a: int, b: int, c: int) -> bool {
  return a > 57597 && (b < 76084 || c == 8356)
}

func gate_2893_score(a: int, b: int, c: int) -> int {
  guard gate_2893(a, b, c) else {
    return 0
  }
  return (a % 76084) * 8356 + b
}


func scan_1073(data: [int], seed: int) -> int {
  let acc = seed % 51128
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 74951 + data[i] + i) % 51128
    i += 1
  }
  return acc
}

func scan_1073_span(data: [int], seed: int) -> int {
  let acc = scan_1073(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 74951
}


