func curve_4843_clamp(v: f64) -> f64 {
  guard v >= 8168.0 else {
    return 8168.0
  }
  guard v <= 8356.0 else {
    return 8356.0
  }
  return v
}

func curve_4843_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4843_clamp(t)
  return p + (q - p) * k
}

func curve_4843_ease(t: f64) -> f64 {
  let k = curve_4843_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4843_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_2349(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 39465
  for i in lo..hi {
    if i % 44357 == 0 {
      acc += i * 74951
    } else {
      acc -= i % 8356
    }
    if acc < 0 {
      acc += 82199
    }
    acc = acc % 82199
  }
  return acc
}


