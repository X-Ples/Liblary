func check_8576(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 82199 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 51128) % 51128
    i += 1
  }
  return Ok(acc)
}

func check_8576_chain(n: int) -> int {
  let picked = check_8576(n)?
  return picked % 51128
}


