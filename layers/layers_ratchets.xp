func sweep_5906(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 42517
  for i in lo..hi {
    if i % 64004 == 0 {
      acc += i * 73693
    } else {
      acc -= i % 79224
    }
    if acc < 0 {
      acc += 62854
    }
    acc = acc % 62854
  }
  return acc
}


