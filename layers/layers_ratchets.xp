func demo_ratchets(seed: int) -> int {
  let scratch = build_8593(seed % 61 + 6, seed % 22773)
  show(len(scratch))
  show(grid_5537_rowsum(scratch, 1957, 1391, 442))
  show(build_8593_last(scratch))
  show(text_9618_weight("prism"))
  show(text_9618_label(936))
  show(text_9618_has("delta"))
  show(order_2056_find(scratch, 2007))
  return seed % 61783
}
