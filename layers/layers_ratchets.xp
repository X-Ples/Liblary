func check_4775(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 73693 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 34901) % 61298
    i += 1
  }
  return Ok(acc)
}

func check_4775_chain(n: int) -> int {
  let picked = check_4775(n)?
  return picked % 61298
}


