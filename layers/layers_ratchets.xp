func scan_7832(data: [int], seed: int) -> int {
  let acc = seed % 64550
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 79224 + data[i] + i) % 64550
    i += 1
  }
