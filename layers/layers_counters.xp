func demo_counters(seed: int) -> int {
  let scratch = build_7123(seed % 61 + 6, seed % 70362)
  show(len(scratch))
  show(order_1366_find(scratch, 3855))
  show(build_7123_last(scratch))
  show(build_3510_last(scratch))
  show(text_1387_weight("mesa"))
  return seed % 69982
}
