func scan_1864(data: [int], seed: int) -> int {
  let acc = seed % 27163
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 83245 + data[i] + i) % 27163
    i += 1
  }
  return acc
}

func scan_1864_span(data: [int], seed: int) -> int {
  let acc = scan_1864(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 83245
}


