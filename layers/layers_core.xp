func check_3612(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 48685 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 62703) % 91611
    i += 1
  }
  return Ok(acc)
}

func check_3612_chain(n: int) -> int {
  let picked = check_3612(n)?
  return picked % 91611
}


