func gate_668(a: int, b: int, c: int) -> bool {
  return a > 9090 && (b < 27342 || c == 55039)
}

func gate_668_score(a: int, b: int, c: int) -> int {
  guard gate_668(a, b, c) else {
    return 0
  }
  return (a % 27342) * 55039 + b
}


func demo_core(seed: int) -> int {
  let scratch = build_8169(seed % 61 + 6, seed % 71861)
  show(len(scratch))
  show(build_8169_last(scratch))
  show(grid_714_rowsum(scratch, 1644, 1621, 2524))
  show(row_981_at(186))
  show(row_981_sum(3928))
  return seed % 14435
}
