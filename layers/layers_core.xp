func build_8169(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 42631) % 15163)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 42631 + 9090) % 15163
    j += 1
  }
  return buf
}

func build_8169_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_714_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 79847 + c * 98794 + seed) % 98794)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_714_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 98794 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func row_981() -> [int] {
  return [634, 3916, 2036, 3550, 3452, 1232, 3116, 1387, 3264, 2817, 2059, 3520, 3229, 877, 2081, 757, 3705, 244]
}

func row_981_at(i: int) -> int {
  let row = row_981()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_981_sum(limit: int) -> int {
  let row = row_981()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_981_best() -> int {
  let row = row_981()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_7391_clamp(v: f64) -> f64 {
  guard v >= 20430.0 else {
    return 20430.0
  }
  guard v <= 79847.0 else {
    return 79847.0
  }
  return v
}

func curve_7391_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7391_clamp(t)
  return p + (q - p) * k
}

func curve_7391_ease(t: f64) -> f64 {
  let k = curve_7391_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7391_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_7224(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 29006
  for i in lo..hi {
    if i % 83567 == 0 {
      acc += i * 55039
    } else {
      acc -= i % 3107
    }
    if acc < 0 {
      acc += 91685
    }
    acc = acc % 91685
  }
  return acc
}


