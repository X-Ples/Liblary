func build_2418(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 73200) % 37491)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 73200 + 73200) % 37491
    j += 1
  }
  return buf
}

func build_2418_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_6071() -> [int] {
  return [2032, 1582, 2126, 2012, 3820, 3259, 2489, 3445, 4002, 302, 2790, 964, 3644, 4076, 2855, 3817, 1806, 959]
}

func row_6071_at(i: int) -> int {
  let row = row_6071()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6071_sum(limit: int) -> int {
  let row = row_6071()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6071_best() -> int {
  let row = row_6071()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_3266_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 6573
    i += 1
  }
  return acc % 6573
}

func text_3266_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "bravo"
  }
  return "omega"
}

func text_3266_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 66170
}


func scan_8965(data: [int], seed: int) -> int {
  let acc = seed % 53926
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 51960 + data[i] + i) % 53926
    i += 1
  }
  return acc
}

func scan_8965_span(data: [int], seed: int) -> int {
  let acc = scan_8965(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 51960
}


func grid_3011_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 55781 + c * 37491 + seed) % 37491)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3011_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 37491 == want {
      total += acc
    }
    r += 1
  }
  return total
}


