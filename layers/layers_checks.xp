func curve_1027_clamp(v: f64) -> f64 {
  guard v >= 48155.0 else {
    return 48155.0
  }
  guard v <= 67694.0 else {
    return 67694.0
  }
  return v
}

func curve_1027_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1027_clamp(t)
  return p + (q - p) * k
}

func curve_1027_ease(t: f64) -> f64 {
  let k = curve_1027_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1027_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_1294(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 48155 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 6573) % 90818
    i += 1
  }
  return Ok(acc)
}

func check_1294_chain(n: int) -> int {
  let picked = check_1294(n)?
  return picked % 90818
}


