func sweep_6695(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 67370
  for i in lo..hi {
    if i % 95047 == 0 {
      acc += i * 81463
    } else {
      acc -= i % 39400
    }
    if acc < 0 {
      acc += 95047
    }
    acc = acc % 95047
  }
  return acc
}


