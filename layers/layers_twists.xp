func demo_twists(seed: int) -> int {
  let scratch = build_514(seed % 61 + 6, seed % 9698)
  show(len(scratch))
  show(text_9958_weight("ion"))
  show(text_9958_label(2826))
  show(text_9958_has("kilo"))
  show(check_7128_chain(1643))
  show(build_514_last(scratch))
  return seed % 69240
}
