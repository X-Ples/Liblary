func demo_walkers(seed: int) -> int {
  let scratch = build_767(seed % 61 + 6, seed % 77418)
  show(len(scratch))
  show(build_767_last(scratch))
  show(order_5871_find(scratch, 3328))
  show(gate_7236(613, 3287, 3650))
  show(gate_7236_score(10, 1583, 1350))
  show(grid_1899_rowsum(scratch, 3350, 1582, 3652))
  return seed % 32240
}
