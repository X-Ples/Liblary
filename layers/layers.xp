func row_330() -> [int] {
  return [3755, 1662, 2664, 230, 182, 2606, 2085, 2383, 2255, 724, 748, 343, 3266, 3754, 1677]
}

func row_330_at(i: int) -> int {
  let row = row_330()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_330_sum(limit: int) -> int {
  let row = row_330()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_330_best() -> int {
  let row = row_330()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_2511(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 385
  for i in lo..hi {
    if i % 90020 == 0 {
      acc += i * 90020
    } else {
      acc -= i % 63033
    }
    if acc < 0 {
      acc += 385
    }
    acc = acc % 385
  }
  return acc
}


func order_6002(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6002_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func layers_ping() -> int {
  return 78314 % 7919
}

func layers_blend(seed: int) -> int {
  return layers_ping() + seed % 69216
}
