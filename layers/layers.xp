func sweep_609(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 53879
  for i in lo..hi {
    if i % 90805 == 0 {
      acc += i * 66854
    } else {
      acc -= i % 10814
    }
    if acc < 0 {
      acc += 90805
    }
    acc = acc % 90805
  }
  return acc
}


