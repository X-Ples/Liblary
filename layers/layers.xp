func text_1791_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 28735
    i += 1
  }
  return acc % 28735
}

func text_1791_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "bravo"
}

func text_1791_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 6702
}


func scan_2506(data: [int], seed: int) -> int {
  let acc = seed % 64435
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 64435 + data[i] + i) % 64435
    i += 1
  }
  return acc
}

func scan_2506_span(data: [int], seed: int) -> int {
  let acc = scan_2506(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 64435
}


func gate_9616(a: int, b: int, c: int) -> bool {
  return a > 75794 && (b < 91658 || c == 90805)
}

func gate_9616_score(a: int, b: int, c: int) -> int {
  guard gate_9616(a, b, c) else {
    return 0
  }
  return (a % 91658) * 90805 + b
}


