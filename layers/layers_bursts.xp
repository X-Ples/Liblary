func text_5520_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 63310
    i += 1
  }
  return acc % 63310
}

func text_5520_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "sigma"
}

func text_5520_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 28716
}


func check_9411(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 11472 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 23270) % 63310
    i += 1
  }
  return Ok(acc)
}

func check_9411_chain(n: int) -> int {
  let picked = check_9411(n)?
  return picked % 63310
}


func sweep_1917(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 50168
  for i in lo..hi {
    if i % 12758 == 0 {
      acc += i * 99831
    } else {
      acc -= i % 63310
    }
    if acc < 0 {
      acc += 80254
    }
    acc = acc % 80254
  }
  return acc
}


