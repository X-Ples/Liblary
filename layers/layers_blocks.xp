    return 0
  }
  return (a % 22863) * 57377 + b
}


func demo_blocks(seed: int) -> int {
  let scratch = build_303(seed % 61 + 6, seed % 78941)
  show(len(scratch))
  show(check_7035_chain(3011))
  show(build_303_last(scratch))
  show(text_2671_weight("nova"))
  show(text_2671_label(2657))
  return seed % 97499
}
