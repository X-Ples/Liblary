const K0 = 51417
const K1 = 43014
const K2 = 65156
const K3 = 57392
const K4 = 14561
const K5 = 22863
const K6 = 72593
const K7 = 9788
const K8 = 78941
const K9 = 11194

func check_7035(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 72593 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 54724) % 61168
    i += 1
  }
  return Ok(acc)
}

func check_7035_chain(n: int) -> int {
  let picked = check_7035(n)?
  return picked % 61168
}


func curve_2760_clamp(v: f64) -> f64 {
  guard v >= 11194.0 else {
    return 11194.0
  }
  guard v <= 61168.0 else {
    return 61168.0
  }
  return v
}

func curve_2760_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2760_clamp(t)
  return p + (q - p) * k
}

func curve_2760_ease(t: f64) -> f64 {
  let k = curve_2760_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2760_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_303(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 11194) % 9788)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 11194 + 9788) % 9788
    j += 1
  }
  return buf
}

func build_303_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_2671_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 14561
    i += 1
  }
  return acc % 14561
}

func text_2671_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "mesa"
}

func text_2671_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 72593
}


func scan_6193(data: [int], seed: int) -> int {
  let acc = seed % 42310
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 9788 + data[i] + i) % 42310
    i += 1
  }
  return acc
}

func scan_6193_span(data: [int], seed: int) -> int {
  let acc = scan_6193(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 9788
}


