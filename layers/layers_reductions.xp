const K0 = 22620
const K1 = 49780
const K2 = 78429
const K3 = 62351
const K4 = 46257
const K5 = 24585

func build_1050(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 63852) % 69375)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 63852 + 46257) % 69375
    j += 1
  }
  return buf
}

func build_1050_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_5658_clamp(v: f64) -> f64 {
  guard v >= 62351.0 else {
    return 62351.0
  }
  guard v <= 79197.0 else {
    return 79197.0
  }
  return v
}

func curve_5658_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5658_clamp(t)
  return p + (q - p) * k
}

func curve_5658_ease(t: f64) -> f64 {
  let k = curve_5658_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5658_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_7490(a: int, b: int, c: int) -> bool {
  return a > 24585 && (b < 23374 || c == 66297)
}

func gate_7490_score(a: int, b: int, c: int) -> int {
  guard gate_7490(a, b, c) else {
    return 0
  }
  return (a % 23374) * 66297 + b
}


func text_6151_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 58726
    i += 1
  }
  return acc % 58726
}

func text_6151_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "alpha"
}

func text_6151_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 58726
}


