func demo_ops(seed: int) -> int {
  let scratch = build_5011(seed % 61 + 6, seed % 47188)
  show(len(scratch))
  show(build_5011_last(scratch))
  show(gate_9055(1187, 1696, 2288))
  show(gate_9055_score(2773, 2982, 718))
  show(scan_8550(scratch, 1108))
  return seed % 59999
}
