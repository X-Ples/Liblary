func sweep_4282(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 62933
  for i in lo..hi {
    if i % 57812 == 0 {
      acc += i * 69675
    } else {
      acc -= i % 59999
    }
    if acc < 0 {
      acc += 66421
    }
    acc = acc % 66421
  }
  return acc
}


