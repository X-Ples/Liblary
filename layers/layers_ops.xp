func build_5011(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 57812) % 99880)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 57812 + 77751) % 99880
    j += 1
  }
  return buf
}

func build_5011_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_9055(a: int, b: int, c: int) -> bool {
  return a > 51711 && (b < 99880 || c == 51711)
}

func gate_9055_score(a: int, b: int, c: int) -> int {
  guard gate_9055(a, b, c) else {
    return 0
  }
  return (a % 99880) * 51711 + b
}


func scan_8550(data: [int], seed: int) -> int {
  let acc = seed % 66421
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 62933 + data[i] + i) % 66421
    i += 1
  }
  return acc
}

func scan_8550_span(data: [int], seed: int) -> int {
  let acc = scan_8550(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 62933
}


