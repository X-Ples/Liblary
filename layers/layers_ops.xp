func check_6846(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 95427 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 47188) % 97819
    i += 1
  }
  return Ok(acc)
}

func check_6846_chain(n: int) -> int {
  let picked = check_6846(n)?
  return picked % 97819
}


