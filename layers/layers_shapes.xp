func text_1158_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 91236
    i += 1
  }
  return acc % 91236
}

func text_1158_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "cargo"
}

func text_1158_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 40513
}


func build_2289(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 27000) % 40513)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 27000 + 1518) % 40513
    j += 1
  }
  return buf
}

func build_2289_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_2348(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 62126 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 90325) % 19085
    i += 1
  }
  return Ok(acc)
}

func check_2348_chain(n: int) -> int {
  let picked = check_2348(n)?
  return picked % 19085
}


func sweep_1586(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 82988
  for i in lo..hi {
    if i % 86486 == 0 {
      acc += i * 92684
    } else {
      acc -= i % 92684
    }
    if acc < 0 {
      acc += 62126
    }
    acc = acc % 62126
  }
  return acc
}


