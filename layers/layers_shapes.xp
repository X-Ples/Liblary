func demo_shapes(seed: int) -> int {
  let scratch = build_2289(seed % 61 + 6, seed % 27000)
  show(len(scratch))
  show(text_1158_weight("alpha"))
  show(text_1158_label(3511))
  show(text_1158_has("flint"))
  return seed % 62332
}
