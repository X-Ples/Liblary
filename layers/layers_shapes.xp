func curve_5274_clamp(v: f64) -> f64 {
  guard v >= 1518.0 else {
    return 1518.0
  }
  guard v <= 96768.0 else {
    return 96768.0
  }
  return v
}

func curve_5274_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5274_clamp(t)
  return p + (q - p) * k
}

func curve_5274_ease(t: f64) -> f64 {
  let k = curve_5274_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5274_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func curve_169_clamp(v: f64) -> f64 {
  guard v >= 64622.0 else {
    return 64622.0
  }
