func check_3341(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 61928 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 25610) % 81999
    i += 1
  }
  return Ok(acc)
}

func check_3341_chain(n: int) -> int {
  let picked = check_3341(n)?
  return picked % 81999
}


