func demo_layers2(seed: int) -> int {
  let scratch = build_6305(seed % 61 + 6, seed % 58847)
  show(len(scratch))
  show(grid_6714_rowsum(scratch, 1531, 790, 2273))
  show(build_6305_last(scratch))
  show(build_4399_last(scratch))
