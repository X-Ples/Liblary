func curve_4926_clamp(v: f64) -> f64 {
  guard v >= 4524.0 else {
    return 4524.0
  }
  guard v <= 51320.0 else {
    return 51320.0
  }
  return v
}

func curve_4926_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4926_clamp(t)
  return p + (q - p) * k
}

func curve_4926_ease(t: f64) -> f64 {
  let k = curve_4926_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4926_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_8849(a: int, b: int, c: int) -> bool {
  return a > 98617 && (b < 4524 || c == 52872)
}

func gate_8849_score(a: int, b: int, c: int) -> int {
  guard gate_8849(a, b, c) else {
    return 0
  }
  return (a % 4524) * 52872 + b
}


func grid_8515_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 88691 + c * 52872 + seed) % 52872)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8515_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 52872 == want {
      total += acc
    }
    r += 1
  }
  return total
}


