func build_6697(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 31499) % 91531)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 31499 + 78194) % 91531
    j += 1
  }
  return buf
}

func build_6697_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_1543() -> [int] {
  return [862, 3344, 2663, 162, 1261, 2540, 457, 311, 3970, 2039, 2103, 3229, 1852, 1716, 730, 809, 2656, 1558]
}

func row_1543_at(i: int) -> int {
  let row = row_1543()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1543_sum(limit: int) -> int {
  let row = row_1543()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1543_best() -> int {
  let row = row_1543()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_7110(data: [int], seed: int) -> int {
  let acc = seed % 59269
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 96382 + data[i] + i) % 59269
    i += 1
  }
  return acc
}

func scan_7110_span(data: [int], seed: int) -> int {
  let acc = scan_7110(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 96382
}


func text_2604_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 85080
    i += 1
  }
  return acc % 85080
}

func text_2604_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "gamma"
}

func text_2604_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 38149
}


