func demo_offsets(seed: int) -> int {
  let scratch = build_4399(seed % 61 + 6, seed % 26464)
  show(len(scratch))
  show(build_4399_last(scratch))
  show(order_6764_find(scratch, 3583))
  show(row_2957_at(3819))
  return seed % 86015
}
