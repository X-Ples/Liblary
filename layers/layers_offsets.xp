}


func check_8217(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 49141 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 86588) % 5530
    i += 1
  }
  return Ok(acc)
}

func check_8217_chain(n: int) -> int {
  let picked = check_8217(n)?
  return picked % 5530
}


