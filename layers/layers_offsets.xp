func build_4399(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 30922) % 87401)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 30922 + 84742) % 87401
    j += 1
  }
  return buf
}

func build_4399_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_6764(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6764_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func row_2957() -> [int] {
  return [1851, 1725, 1663, 498, 2981, 950, 3723, 4041, 2523, 3021, 1959, 3312, 3525, 3707, 385]
}

func row_2957_at(i: int) -> int {
  let row = row_2957()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2957_sum(limit: int) -> int {
  let row = row_2957()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2957_best() -> int {
  let row = row_2957()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_2697_clamp(v: f64) -> f64 {
  guard v >= 15591.0 else {
    return 15591.0
  }
  guard v <= 26464.0 else {
    return 26464.0
  }
  return v
}

func curve_2697_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2697_clamp(t)
  return p + (q - p) * k
}

func curve_2697_ease(t: f64) -> f64 {
  let k = curve_2697_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2697_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_4854(data: [int], seed: int) -> int {
  let acc = seed % 41321
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 47689 + data[i] + i) % 41321
    i += 1
  }
  return acc
}

func scan_4854_span(data: [int], seed: int) -> int {
  let acc = scan_4854(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 47689
}


