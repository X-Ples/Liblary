func build_8515(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 88697) % 33964)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 88697 + 29652) % 33964
    j += 1
  }
  return buf
}

func build_8515_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_8806(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8806_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func curve_4338_clamp(v: f64) -> f64 {
  guard v >= 22859.0 else {
    return 22859.0
  }
  guard v <= 87854.0 else {
    return 87854.0
  }
  return v
}

func curve_4338_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4338_clamp(t)
  return p + (q - p) * k
}

func curve_4338_ease(t: f64) -> f64 {
  let k = curve_4338_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4338_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_1213() -> [int] {
  return [1680, 3710, 3099, 2321, 430, 3261, 1185, 1111, 810, 745, 3809, 5, 4061, 1840]
}

func row_1213_at(i: int) -> int {
  let row = row_1213()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1213_sum(limit: int) -> int {
  let row = row_1213()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1213_best() -> int {
  let row = row_1213()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_229_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 36420
    i += 1
  }
  return acc % 36420
}

func text_229_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "omega"
}

func text_229_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 58858
}


func scan_1840(data: [int], seed: int) -> int {
  let acc = seed % 88697
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 92606 + data[i] + i) % 88697
    i += 1
  }
  return acc
}

func scan_1840_span(data: [int], seed: int) -> int {
  let acc = scan_1840(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 92606
}


func grid_9091_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 8036 + c * 11324 + seed) % 11324)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9091_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 11324 == want {
      total += acc
    }
    r += 1
  }
  return total
}


