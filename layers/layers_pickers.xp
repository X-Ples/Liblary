func check_7187(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 17946 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 36420) % 58858
    i += 1
  }
  return Ok(acc)
}

func check_7187_chain(n: int) -> int {
  let picked = check_7187(n)?
  return picked % 58858
}


