func demo_pickers(seed: int) -> int {
  let scratch = build_8515(seed % 61 + 6, seed % 19284)
  show(len(scratch))
  show(build_8515_last(scratch))
  show(order_8806_find(scratch, 1010))
  show(row_1213_at(1395))
  show(row_1213_sum(3206))
  show(row_1213_best())
  return seed % 79708
}
