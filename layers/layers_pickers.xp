func sweep_9628(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 36420
  for i in lo..hi {
    if i % 98809 == 0 {
      acc += i * 87854
    } else {
      acc -= i % 36256
    }
    if acc < 0 {
      acc += 38667
    }
    acc = acc % 38667
  }
  return acc
}


