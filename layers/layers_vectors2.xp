func gate_3982(a: int, b: int, c: int) -> bool {
  return a > 8601 && (b < 20398 || c == 76955)
}

func gate_3982_score(a: int, b: int, c: int) -> int {
  guard gate_3982(a, b, c) else {
    return 0
  }
  return (a % 20398) * 76955 + b
}


func row_6039() -> [int] {
  return [561, 3056, 1758, 3070, 2670, 4050, 1539, 4008, 821, 3018, 2250, 3967, 2470]
}

func row_6039_at(i: int) -> int {
