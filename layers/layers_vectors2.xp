func build_8282(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 27106) % 40082)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 27106 + 84750) % 40082
    j += 1
  }
  return buf
}

func build_8282_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_390_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 29696
    i += 1
  }
  return acc % 29696
}

func text_390_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "kilo"
}

func text_390_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 18092
}


