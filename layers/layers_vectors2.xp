func demo_vectors2(seed: int) -> int {
  let scratch = build_8282(seed % 61 + 6, seed % 66983)
  show(len(scratch))
  show(build_8282_last(scratch))
  show(text_390_weight("nova"))
  show(text_390_label(1276))
  show(text_390_has("prism"))
  show(build_3904_last(scratch))
  return seed % 28037
}
