  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_5454(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 6867 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 84750) % 87571
    i += 1
  }
  return Ok(acc)
}

func check_5454_chain(n: int) -> int {
  let picked = check_5454(n)?
  return picked % 87571
}


func sweep_2115(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 8601
  for i in lo..hi {
    if i % 27106 == 0 {
      acc += i * 35143
    } else {
      acc -= i % 11317
    }
    if acc < 0 {
      acc += 4665
    }
    acc = acc % 4665
  }
  return acc
}


