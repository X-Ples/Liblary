func demo_blends(seed: int) -> int {
  let scratch = build_9433(seed % 61 + 6, seed % 56982)
  show(len(scratch))
  show(build_9433_last(scratch))
  show(scan_7029(scratch, 1689))
  show(scan_7029_span(scratch, 3704))
  return seed % 61163
}
