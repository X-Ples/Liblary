func check_5814(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 22839 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 72920) % 95897
    i += 1
  }
  return Ok(acc)
}

func check_5814_chain(n: int) -> int {
  let picked = check_5814(n)?
  return picked % 95897
}


