func row_6294() -> [int] {
  return [3363, 1123, 805, 1318, 2984, 391, 2392, 838, 560, 977, 1139, 952, 3832]
}

func row_6294_at(i: int) -> int {
  let row = row_6294()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6294_sum(limit: int) -> int {
  let row = row_6294()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6294_best() -> int {
  let row = row_6294()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


