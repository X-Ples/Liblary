func build_9433(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 72920) % 23277)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 72920 + 96428) % 23277
    j += 1
  }
  return buf
}

func build_9433_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_7029(data: [int], seed: int) -> int {
  let acc = seed % 93931
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 97429 + data[i] + i) % 93931
    i += 1
  }
  return acc
}

func scan_7029_span(data: [int], seed: int) -> int {
  let acc = scan_7029(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 97429
}


func sweep_1223(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 95897
  for i in lo..hi {
    if i % 13119 == 0 {
      acc += i * 79967
    } else {
      acc -= i % 40697
    }
    if acc < 0 {
      acc += 58835
    }
    acc = acc % 58835
  }
  return acc
}


