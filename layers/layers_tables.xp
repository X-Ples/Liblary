func sweep_5538(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 95703
  for i in lo..hi {
    if i % 10502 == 0 {
      acc += i * 15627
    } else {
      acc -= i % 46741
    }
    if acc < 0 {
      acc += 80933
    }
    acc = acc % 80933
  }
  return acc
}


func build_9551(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 49845) % 11065)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 49845 + 49693) % 11065
    j += 1
  }
  return buf
}

func build_9551_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_3484(data: [int], seed: int) -> int {
  let acc = seed % 47613
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 10502 + data[i] + i) % 47613
    i += 1
  }
  return acc
}

func scan_3484_span(data: [int], seed: int) -> int {
  let acc = scan_3484(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 10502
}


func grid_3475_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 10502 + c * 87604 + seed) % 87604)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3475_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 87604 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_401_clamp(v: f64) -> f64 {
  guard v >= 4423.0 else {
    return 4423.0
  }
  guard v <= 99736.0 else {
    return 99736.0
  }
  return v
}

func curve_401_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_401_clamp(t)
  return p + (q - p) * k
}

func curve_401_ease(t: f64) -> f64 {
  let k = curve_401_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_401_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


