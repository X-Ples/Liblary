func row_3785() -> [int] {
  return [2566, 2880, 2129, 527, 3472, 188, 1214, 3139, 1166, 360, 790, 314, 3560]
}

func row_3785_at(i: int) -> int {
  let row = row_3785()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3785_sum(limit: int) -> int {
  let row = row_3785()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3785_best() -> int {
  let row = row_3785()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


