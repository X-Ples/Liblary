func demo_helpers(seed: int) -> int {
  let scratch = build_839(seed % 61 + 6, seed % 31775)
  show(len(scratch))
  show(build_839_last(scratch))
  show(text_7395_weight("nova"))
  show(text_7395_label(1644))
  show(text_7395_has("ridge"))
  show(gate_9397(241, 3780, 2469))
  return seed % 50419
}
