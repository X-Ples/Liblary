func build_839(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 17934) % 44782)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 17934 + 7083) % 44782
    j += 1
  }
  return buf
}

func build_839_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_7395_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 40482
    i += 1
  }
  return acc % 40482
}

func text_7395_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "ember"
}

func text_7395_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 27594
}


func gate_9397(a: int, b: int, c: int) -> bool {
  return a > 27481 && (b < 12513 || c == 84001)
}

func gate_9397_score(a: int, b: int, c: int) -> int {
  guard gate_9397(a, b, c) else {
    return 0
  }
  return (a % 12513) * 84001 + b
}


func check_7937(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 17452 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 7083) % 50419
    i += 1
  }
  return Ok(acc)
}

func check_7937_chain(n: int) -> int {
  let picked = check_7937(n)?
  return picked % 50419
}


