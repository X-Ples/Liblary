func check_3904(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 52062 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 4642) % 85750
    i += 1
  }
  return Ok(acc)
}

func check_3904_chain(n: int) -> int {
  let picked = check_3904(n)?
  return picked % 85750
}


func grid_4358_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 69741 + c * 39491 + seed) % 39491)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4358_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 39491 == want {
      total += acc
    }
    r += 1
  }
  return total
}


