func sweep_1995(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 25362
  for i in lo..hi {
    if i % 4642 == 0 {
      acc += i * 74719
    } else {
      acc -= i % 25362
    }
    if acc < 0 {
      acc += 34199
    }
    acc = acc % 34199
  }
  return acc
}


