func row_313() -> [int] {
  return [2307, 2085, 3015, 1213, 2697, 196, 290, 3463, 983, 273, 2161, 339, 281, 1207, 2813]
}

func row_313_at(i: int) -> int {
  let row = row_313()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_313_sum(limit: int) -> int {
  let row = row_313()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_313_best() -> int {
  let row = row_313()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_5559(a: int, b: int, c: int) -> bool {
  return a > 99305 && (b < 38646 || c == 79943)
}

func gate_5559_score(a: int, b: int, c: int) -> int {
  guard gate_5559(a, b, c) else {
    return 0
  }
  return (a % 38646) * 79943 + b
}


func order_2828(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2828_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


