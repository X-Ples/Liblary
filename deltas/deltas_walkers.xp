func sweep_5461(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 38646
  for i in lo..hi {
    if i % 89205 == 0 {
      acc += i * 72218
    } else {
      acc -= i % 30357
    }
    if acc < 0 {
      acc += 77229
    }
    acc = acc % 77229
  }
  return acc
}


