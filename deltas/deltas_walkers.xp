func text_6537_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 72218
    i += 1
  }
  return acc % 72218
}

func text_6537_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "lumen"
}

func text_6537_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 81619
}


