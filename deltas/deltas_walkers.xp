func scan_9901(data: [int], seed: int) -> int {
  let acc = seed % 31463
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 83345 + data[i] + i) % 31463
    i += 1
  }
  return acc
}

func scan_9901_span(data: [int], seed: int) -> int {
  let acc = scan_9901(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 83345
}


