func demo_walkers(seed: int) -> int {
  let scratch = build_7243(seed % 61 + 6, seed % 78197)
  show(len(scratch))
  show(build_7243_last(scratch))
  show(grid_9832_rowsum(scratch, 114, 1358, 3926))
  show(grid_8148_rowsum(scratch, 2646, 1271, 3778))
  show(row_313_at(2622))
  show(row_313_sum(1585))
  return seed % 83345
}
