func row_5213() -> [int] {
  return [3572, 985, 1375, 2539, 3965, 1165, 2464, 3030, 550, 1308, 2556, 1090, 2481, 219, 2355, 2402, 3450, 2714, 368, 1489]
}

func row_5213_at(i: int) -> int {
  let row = row_5213()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5213_sum(limit: int) -> int {
  let row = row_5213()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5213_best() -> int {
  let row = row_5213()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


