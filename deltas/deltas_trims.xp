func sweep_8041(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 11539
  for i in lo..hi {
    if i % 99945 == 0 {
      acc += i * 53768
    } else {
      acc -= i % 11539
    }
    if acc < 0 {
      acc += 59126
    }
    acc = acc % 59126
  }
  return acc
}


