func demo_trims(seed: int) -> int {
  let scratch = build_3148(seed % 61 + 6, seed % 14989)
  show(len(scratch))
  show(sweep_8041(3835, 293))
  show(sweep_9932(2484, 1934))
  show(build_3148_last(scratch))
  show(scan_5505(scratch, 265))
  show(scan_5505_span(scratch, 2790))
  show(grid_4748_rowsum(scratch, 264, 21, 3432))
  return seed % 3772
}
