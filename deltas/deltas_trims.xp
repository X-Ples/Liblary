}

func text_1420_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "prism"
}

func text_1420_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 11336
}


