func build_3148(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 14989) % 59126)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 14989 + 3772) % 59126
    j += 1
  }
  return buf
}

func build_3148_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_5505(data: [int], seed: int) -> int {
  let acc = seed % 83344
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 59126 + data[i] + i) % 83344
    i += 1
  }
  return acc
}

func scan_5505_span(data: [int], seed: int) -> int {
  let acc = scan_5505(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 59126
}


func grid_4748_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 59126 + c * 35004 + seed) % 35004)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4748_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 35004 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_334_clamp(v: f64) -> f64 {
  guard v >= 59126.0 else {
    return 59126.0
  }
  guard v <= 83344.0 else {
    return 83344.0
  }
  return v
}

func curve_334_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_334_clamp(t)
  return p + (q - p) * k
}

func curve_334_ease(t: f64) -> f64 {
  let k = curve_334_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_334_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


