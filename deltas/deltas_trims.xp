func check_8420(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 55423 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 9393) % 43684
    i += 1
  }
  return Ok(acc)
}

func check_8420_chain(n: int) -> int {
  let picked = check_8420(n)?
  return picked % 43684
}


