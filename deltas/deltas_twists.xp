const K0 = 15368
const K1 = 31129
const K2 = 33813
const K3 = 7834
const K4 = 26682
const K5 = 8344
const K6 = 33647
const K7 = 26682

func scan_7442(data: [int], seed: int) -> int {
  let acc = seed % 21815
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 44849 + data[i] + i) % 21815
    i += 1
  }
  return acc
}

func scan_7442_span(data: [int], seed: int) -> int {
  let acc = scan_7442(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 44849
}


func build_4569(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 21815) % 32129)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 21815 + 92517) % 32129
    j += 1
  }
  return buf
}

func build_4569_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_7375_clamp(v: f64) -> f64 {
  guard v >= 36978.0 else {
    return 36978.0
  }
  guard v <= 70446.0 else {
    return 70446.0
  }
  return v
}

func curve_7375_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7375_clamp(t)
  return p + (q - p) * k
}

func curve_7375_ease(t: f64) -> f64 {
  let k = curve_7375_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7375_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_3981(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 68828
  for i in lo..hi {
    if i % 63437 == 0 {
      acc += i * 78508
    } else {
      acc -= i % 59392
    }
    if acc < 0 {
      acc += 33647
    }
    acc = acc % 33647
  }
  return acc
}


