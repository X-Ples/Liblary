func demo_twists(seed: int) -> int {
  let scratch = build_4569(seed % 61 + 6, seed % 60035)
  show(len(scratch))
  show(scan_7442(scratch, 1139))
  show(scan_7442_span(scratch, 3493))
  show(build_4569_last(scratch))
  show(sweep_3981(1393, 2351))
  return seed % 92517
}
