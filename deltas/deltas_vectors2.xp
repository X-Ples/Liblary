func build_7593(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 8018) % 64557)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 8018 + 64557) % 64557
    j += 1
  }
  return buf
}

func build_7593_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_4164(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 35726
  for i in lo..hi {
    if i % 61331 == 0 {
      acc += i * 24687
    } else {
      acc -= i % 61331
    }
    if acc < 0 {
      acc += 78469
    }
    acc = acc % 78469
  }
  return acc
}


func gate_9386(a: int, b: int, c: int) -> bool {
  return a > 32167 && (b < 34615 || c == 33203)
}

func gate_9386_score(a: int, b: int, c: int) -> int {
  guard gate_9386(a, b, c) else {
    return 0
  }
  return (a % 34615) * 33203 + b
}


func order_1874(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1874_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


