func scan_2478(data: [int], seed: int) -> int {
  let acc = seed % 50812
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 56607 + data[i] + i) % 50812
    i += 1
  }
  return acc
}

func scan_2478_span(data: [int], seed: int) -> int {
  let acc = scan_2478(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 56607
}


func demo_vectors2(seed: int) -> int {
  let scratch = build_7593(seed % 61 + 6, seed % 61262)
  show(len(scratch))
  show(build_7593_last(scratch))
  show(sweep_4164(16, 1952))
  show(gate_9386(95, 3103, 3835))
  show(gate_9386_score(1580, 3727, 2137))
  return seed % 61262
}
