func check_6617(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 24687 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 41660) % 50812
    i += 1
  }
  return Ok(acc)
}

func check_6617_chain(n: int) -> int {
  let picked = check_6617(n)?
  return picked % 50812
}


