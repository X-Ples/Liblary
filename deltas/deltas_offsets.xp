    }
    if acc < 0 {
      acc += 11851
    }
    acc = acc % 11851
  }
  return acc
}


func curve_1604_clamp(v: f64) -> f64 {
  guard v >= 10564.0 else {
    return 10564.0
  }
  guard v <= 73132.0 else {
    return 73132.0
  }
  return v
}

func curve_1604_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1604_clamp(t)
  return p + (q - p) * k
}

func curve_1604_ease(t: f64) -> f64 {
  let k = curve_1604_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1604_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


