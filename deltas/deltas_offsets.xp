func demo_offsets(seed: int) -> int {
  let scratch = build_4022(seed % 61 + 6, seed % 4373)
  show(len(scratch))
  show(gate_3646(903, 1027, 2437))
  show(gate_3646_score(1976, 2606, 1010))
  show(build_4022_last(scratch))
  show(row_3718_at(2829))
  show(row_3718_sum(694))
  return seed % 68015
}
