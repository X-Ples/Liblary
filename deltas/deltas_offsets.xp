}


func build_4022(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 64451) % 27571)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 64451 + 95948) % 27571
    j += 1
  }
  return buf
}

func build_4022_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


