func build_6516(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 99476) % 99476)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 99476 + 33928) % 99476
    j += 1
  }
  return buf
}

func build_6516_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_7990_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 43318
    i += 1
  }
  return acc % 43318
}

func text_7990_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "jetty"
}

func text_7990_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 7304
}


func grid_3369_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 33453 + c * 50404 + seed) % 50404)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3369_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 50404 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func row_8337() -> [int] {
  return [2028, 3744, 1829, 3342, 2153, 267, 1327, 1052, 1136, 1681, 2046, 3223, 1937, 1782, 293]
}

func row_8337_at(i: int) -> int {
  let row = row_8337()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8337_sum(limit: int) -> int {
  let row = row_8337()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8337_best() -> int {
  let row = row_8337()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


