func check_612(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 27572 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 99476) % 85014
    i += 1
  }
  return Ok(acc)
}

func check_612_chain(n: int) -> int {
  let picked = check_612(n)?
  return picked % 85014
}


