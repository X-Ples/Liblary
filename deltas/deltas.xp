func scan_3962(data: [int], seed: int) -> int {
  let acc = seed % 33928
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 9803 + data[i] + i) % 33928
    i += 1
  }
  return acc
}

func scan_3962_span(data: [int], seed: int) -> int {
  let acc = scan_3962(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 9803
}


