func sweep_4869(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 85014
  for i in lo..hi {
    if i % 9165 == 0 {
      acc += i * 74468
    } else {
      acc -= i % 73954
    }
    if acc < 0 {
      acc += 33190
    }
    acc = acc % 33190
  }
  return acc
}


func curve_5014_clamp(v: f64) -> f64 {
  guard v >= 9165.0 else {
    return 9165.0
  }
  guard v <= 99476.0 else {
    return 99476.0
  }
  return v
}

func curve_5014_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5014_clamp(t)
  return p + (q - p) * k
}

func curve_5014_ease(t: f64) -> f64 {
  let k = curve_5014_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5014_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


