func scan_2617(data: [int], seed: int) -> int {
  let acc = seed % 98508
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 72125 + data[i] + i) % 98508
    i += 1
  }
  return acc
}

func scan_2617_span(data: [int], seed: int) -> int {
  let acc = scan_2617(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 72125
}


func curve_3032_clamp(v: f64) -> f64 {
  guard v >= 10985.0 else {
    return 10985.0
  }
  guard v <= 32972.0 else {
    return 32972.0
  }
  return v
}

func curve_3032_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3032_clamp(t)
  return p + (q - p) * k
}

func curve_3032_ease(t: f64) -> f64 {
  let k = curve_3032_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3032_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_2079(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 2722
  for i in lo..hi {
    if i % 94364 == 0 {
      acc += i * 95064
    } else {
      acc -= i % 31478
    }
    if acc < 0 {
      acc += 9942
    }
    acc = acc % 9942
  }
  return acc
}


func gate_2892(a: int, b: int, c: int) -> bool {
  return a > 9942 && (b < 72125 || c == 95064)
}

func gate_2892_score(a: int, b: int, c: int) -> int {
  guard gate_2892(a, b, c) else {
    return 0
  }
  return (a % 72125) * 95064 + b
}


