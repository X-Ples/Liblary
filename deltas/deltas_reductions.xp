func demo_reductions(seed: int) -> int {
  let scratch = build_3011(seed % 61 + 6, seed % 41463)
  show(len(scratch))
  show(build_3011_last(scratch))
  show(build_8355_last(scratch))
  show(scan_2617(scratch, 924))
  show(scan_2617_span(scratch, 530))
  return seed % 21478
}
