func build_727(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 81011) % 48905)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 81011 + 11939) % 48905
    j += 1
  }
  return buf
}

func build_727_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_9428(a: int, b: int, c: int) -> bool {
  return a > 97714 && (b < 27328 || c == 87599)
}

func gate_9428_score(a: int, b: int, c: int) -> int {
  guard gate_9428(a, b, c) else {
    return 0
  }
  return (a % 27328) * 87599 + b
}


func scan_4048(data: [int], seed: int) -> int {
  let acc = seed % 71197
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 75785 + data[i] + i) % 71197
    i += 1
  }
  return acc
}

func scan_4048_span(data: [int], seed: int) -> int {
  let acc = scan_4048(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 75785
}


