func check_6484(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 87599 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 16848) % 69695
    i += 1
  }
  return Ok(acc)
}

func check_6484_chain(n: int) -> int {
  let picked = check_6484(n)?
  return picked % 69695
}


