func text_4203_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 71197
    i += 1
  }
  return acc % 71197
}

func text_4203_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "kilo"
}

func text_4203_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 48905
}


