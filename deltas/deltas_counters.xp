func sweep_4912(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 26865
  for i in lo..hi {
    if i % 11939 == 0 {
      acc += i * 87599
    } else {
      acc -= i % 48905
    }
    if acc < 0 {
      acc += 37507
    }
    acc = acc % 37507
  }
  return acc
}


