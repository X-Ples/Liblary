func demo_counters(seed: int) -> int {
  let scratch = build_727(seed % 61 + 6, seed % 59144)
  show(len(scratch))
  show(build_727_last(scratch))
  show(gate_9428(1291, 1546, 2915))
  show(gate_9428_score(2644, 1502, 2404))
  show(scan_4048(scratch, 3785))
  show(scan_4048_span(scratch, 1669))
  show(build_443_last(scratch))
  return seed % 49919
}
