func demo_signals(seed: int) -> int {
  let scratch = build_7865(seed % 61 + 6, seed % 43742)
  show(len(scratch))
  show(build_7865_last(scratch))
  show(check_3017_chain(2292))
  show(gate_8564(2891, 400, 2104))
  show(gate_8564_score(2141, 82, 3249))
  show(text_1101_weight("quartz"))
  return seed % 54702
}
