func build_7865(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 60607) % 11240)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 60607 + 49051) % 11240
    j += 1
  }
  return buf
}

func build_7865_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_3017(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 60607 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 86427) % 84291
    i += 1
  }
  return Ok(acc)
}

func check_3017_chain(n: int) -> int {
  let picked = check_3017(n)?
  return picked % 84291
}


func gate_8564(a: int, b: int, c: int) -> bool {
  return a > 57730 && (b < 49051 || c == 49051)
}

func gate_8564_score(a: int, b: int, c: int) -> int {
  guard gate_8564(a, b, c) else {
    return 0
  }
  return (a % 49051) * 49051 + b
}


func text_1101_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 55681
    i += 1
  }
  return acc % 55681
}

func text_1101_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "ember"
}

func text_1101_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 46198
}


