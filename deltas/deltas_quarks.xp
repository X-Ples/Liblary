func sweep_3160(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 11030
  for i in lo..hi {
    if i % 83431 == 0 {
      acc += i * 3846
    } else {
      acc -= i % 95868
    }
    if acc < 0 {
      acc += 75813
    }
    acc = acc % 75813
  }
  return acc
}


