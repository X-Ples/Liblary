func demo_quarks(seed: int) -> int {
  let scratch = build_1266(seed % 61 + 6, seed % 4035)
  show(len(scratch))
  show(build_1266_last(scratch))
  show(text_3312_weight("cargo"))
  show(text_3312_label(2697))
  show(text_3312_has("lumen"))
  show(order_1932_find(scratch, 2008))
  show(build_3402_last(scratch))
  return seed % 59424
}
