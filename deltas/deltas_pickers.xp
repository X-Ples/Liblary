func row_2881() -> [int] {
  return [3289, 473, 2036, 2528, 2968, 1460, 2360, 230, 1079, 1070, 2295]
}

func row_2881_at(i: int) -> int {
  let row = row_2881()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2881_sum(limit: int) -> int {
  let row = row_2881()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2881_best() -> int {
  let row = row_2881()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_4097(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4097_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_4733(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 89690
  for i in lo..hi {
    if i % 94605 == 0 {
      acc += i * 63396
    } else {
      acc -= i % 32293
    }
    if acc < 0 {
      acc += 82934
    }
    acc = acc % 82934
  }
  return acc
}


