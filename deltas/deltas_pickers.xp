func gate_2130(a: int, b: int, c: int) -> bool {
  return a > 7087 && (b < 50043 || c == 12639)
}

func gate_2130_score(a: int, b: int, c: int) -> int {
  guard gate_2130(a, b, c) else {
    return 0
  }
  return (a % 50043) * 12639 + b
}


