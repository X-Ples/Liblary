func demo_pickers(seed: int) -> int {
  let scratch = build_4228(seed % 61 + 6, seed % 63396)
  show(len(scratch))
  show(build_4228_last(scratch))
  show(build_522_last(scratch))
  show(build_8693_last(scratch))
  show(row_2881_at(3256))
  show(row_2881_sum(1023))
  return seed % 92078
}
