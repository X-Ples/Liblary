func demo_tables(seed: int) -> int {
  let scratch = build_4357(seed % 61 + 6, seed % 45505)
  show(len(scratch))
  show(build_4357_last(scratch))
  show(check_7988_chain(3125))
  show(scan_4601(scratch, 3146))
  show(scan_4601_span(scratch, 2712))
  return seed % 13406
}
