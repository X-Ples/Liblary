func build_4357(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 18183) % 72900)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 18183 + 43757) % 72900
    j += 1
  }
  return buf
}

func build_4357_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_7988(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 67082 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 27312) % 36484
    i += 1
  }
  return Ok(acc)
}

func check_7988_chain(n: int) -> int {
  let picked = check_7988(n)?
  return picked % 36484
}


func scan_4601(data: [int], seed: int) -> int {
  let acc = seed % 82279
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 2446 + data[i] + i) % 82279
    i += 1
  }
  return acc
}

func scan_4601_span(data: [int], seed: int) -> int {
  let acc = scan_4601(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 2446
}


