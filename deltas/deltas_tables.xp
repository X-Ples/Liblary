func order_1926(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1926_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func row_9652() -> [int] {
  return [2061, 167, 74, 1969, 1802, 2153, 465, 3219, 1294, 3424, 1455, 2554, 988, 2949, 3669, 1001]
}

func row_9652_at(i: int) -> int {
  let row = row_9652()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9652_sum(limit: int) -> int {
  let row = row_9652()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9652_best() -> int {
  let row = row_9652()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_2838_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 2446
    i += 1
  }
  return acc % 2446
}

func text_2838_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "alpha"
}

func text_2838_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 4561
}


func curve_630_clamp(v: f64) -> f64 {
  guard v >= 59666.0 else {
    return 59666.0
  }
  guard v <= 85804.0 else {
    return 85804.0
  }
  return v
}

func curve_630_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_630_clamp(t)
  return p + (q - p) * k
}

func curve_630_ease(t: f64) -> f64 {
  let k = curve_630_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_630_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


