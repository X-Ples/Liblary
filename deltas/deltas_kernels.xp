func row_1418() -> [int] {
  return [3411, 2386, 797, 3910, 3283, 1453, 222, 1604, 623, 3689, 3928, 1393, 3953, 3861]
}

func row_1418_at(i: int) -> int {
  let row = row_1418()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1418_sum(limit: int) -> int {
  let row = row_1418()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1418_best() -> int {
  let row = row_1418()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


