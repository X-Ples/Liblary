func text_3194_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 48584
    i += 1
  }
  return acc % 48584
}

func text_3194_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "jetty"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "bravo"
}

func text_3194_has(tag: str) -> bool {
  return str_contains(tag, "jetty") || len(tag) > 33787
}


func scan_2861(data: [int], seed: int) -> int {
  let acc = seed % 73137
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 57536 + data[i] + i) % 73137
    i += 1
  }
  return acc
}

func scan_2861_span(data: [int], seed: int) -> int {
  let acc = scan_2861(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 57536
}


func grid_1318_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 84587 + c * 94144 + seed) % 94144)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1318_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 94144 == want {
      total += acc
    }
    r += 1
  }
  return total
}


