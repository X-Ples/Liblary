func build_6843(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 69962) % 30210)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 69962 + 42874) % 30210
    j += 1
  }
  return buf
}

func build_6843_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_1290(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 97815 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 69962) % 67018
    i += 1
  }
  return Ok(acc)
}

func check_1290_chain(n: int) -> int {
  let picked = check_1290(n)?
  return picked % 67018
}


func order_730(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_730_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func curve_3015_clamp(v: f64) -> f64 {
  guard v >= 89274.0 else {
    return 89274.0
  }
  guard v <= 89274.0 else {
    return 89274.0
  }
  return v
}

func curve_3015_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3015_clamp(t)
  return p + (q - p) * k
}

func curve_3015_ease(t: f64) -> f64 {
  let k = curve_3015_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3015_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


