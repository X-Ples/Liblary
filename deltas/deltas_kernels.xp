func sweep_2010(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 69962
  for i in lo..hi {
    if i % 22695 == 0 {
      acc += i * 30210
    } else {
      acc -= i % 94144
    }
    if acc < 0 {
      acc += 19563
    }
    acc = acc % 19563
  }
  return acc
}


