func scan_4613(data: [int], seed: int) -> int {
  let acc = seed % 17391
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 88445 + data[i] + i) % 17391
    i += 1
  }
  return acc
}

func scan_4613_span(data: [int], seed: int) -> int {
  let acc = scan_4613(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 88445
}


