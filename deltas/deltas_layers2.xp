func demo_layers2(seed: int) -> int {
  let scratch = build_6662(seed % 61 + 6, seed % 84656)
  show(len(scratch))
  show(build_6662_last(scratch))
  show(order_7926_find(scratch, 308))
  show(build_152_last(scratch))
