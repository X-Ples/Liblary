func text_350_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 88445
    i += 1
  }
  return acc % 88445
}

func text_350_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "omega"
}

func text_350_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 70107
}


