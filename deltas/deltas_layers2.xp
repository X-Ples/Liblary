func grid_8954_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 61481 + c * 69580 + seed) % 69580)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8954_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 69580 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_8409(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 77049
  for i in lo..hi {
    if i % 66909 == 0 {
      acc += i * 52411
    } else {
      acc -= i % 65272
    }
    if acc < 0 {
      acc += 38136
    }
    acc = acc % 38136
  }
  return acc
}


