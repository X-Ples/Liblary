func text_1037_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 9455
    i += 1
  }
  return acc % 9455
}

func text_1037_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "ion"
}

func text_1037_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 71439
}


func curve_8129_clamp(v: f64) -> f64 {
  guard v >= 1542.0 else {
    return 1542.0
  }
  guard v <= 90742.0 else {
    return 90742.0
  }
  return v
}

func curve_8129_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8129_clamp(t)
  return p + (q - p) * k
}

func curve_8129_ease(t: f64) -> f64 {
  let k = curve_8129_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8129_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


