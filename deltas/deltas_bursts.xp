func check_9518(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 76741 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 31930) % 95155
    i += 1
  }
  return Ok(acc)
}

func check_9518_chain(n: int) -> int {
  let picked = check_9518(n)?
  return picked % 95155
}


