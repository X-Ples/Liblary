func gate_2879(a: int, b: int, c: int) -> bool {
  return a > 68125 && (b < 11208 || c == 95155)
}

func gate_2879_score(a: int, b: int, c: int) -> int {
  guard gate_2879(a, b, c) else {
    return 0
  }
  return (a % 11208) * 95155 + b
}


func sweep_646(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 90742
  for i in lo..hi {
    if i % 29495 == 0 {
      acc += i * 99343
    } else {
      acc -= i % 23354
    }
    if acc < 0 {
      acc += 11208
    }
    acc = acc % 11208
  }
  return acc
}


