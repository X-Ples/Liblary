func demo_bursts(seed: int) -> int {
  let scratch = build_8728(seed % 61 + 6, seed % 47102)
  show(len(scratch))
  show(grid_4030_rowsum(scratch, 1419, 3393, 2701))
  show(build_8728_last(scratch))
  show(build_5919_last(scratch))
  show(scan_171(scratch, 2929))
  show(scan_171_span(scratch, 3877))
  return seed % 90742
}
