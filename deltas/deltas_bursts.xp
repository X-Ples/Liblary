func scan_171(data: [int], seed: int) -> int {
  let acc = seed % 53831
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 53831 + data[i] + i) % 53831
    i += 1
  }
  return acc
}

func scan_171_span(data: [int], seed: int) -> int {
  let acc = scan_171(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 53831
}


func row_7228() -> [int] {
  return [2738, 979, 876, 3148, 2274, 2690, 1755, 790, 3714, 2987, 2991, 2136, 2206, 984, 1865, 2992]
}

func row_7228_at(i: int) -> int {
  let row = row_7228()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7228_sum(limit: int) -> int {
  let row = row_7228()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7228_best() -> int {
  let row = row_7228()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


