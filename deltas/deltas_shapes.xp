func check_4050(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 57602 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 69253) % 45238
    i += 1
  }
  return Ok(acc)
}

func check_4050_chain(n: int) -> int {
  let picked = check_4050(n)?
  return picked % 45238
}


