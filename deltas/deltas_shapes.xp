func grid_8990_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 15923 + c * 57602 + seed) % 57602)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8990_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 57602 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_2779(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 83712
  for i in lo..hi {
    if i % 93705 == 0 {
      acc += i * 92594
    } else {
      acc -= i % 30448
    }
    if acc < 0 {
      acc += 92428
    }
    acc = acc % 92428
  }
  return acc
}


