func demo_shapes(seed: int) -> int {
  let scratch = build_2647(seed % 61 + 6, seed % 83712)
  show(len(scratch))
  show(build_2647_last(scratch))
  show(text_8305_weight("ion"))
  show(text_8305_label(2862))
  show(text_8305_has("jetty"))
  show(build_7216_last(scratch))
  return seed % 66305
}
