  }
  return v
}

func curve_7091_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7091_clamp(t)
  return p + (q - p) * k
}

func curve_7091_ease(t: f64) -> f64 {
  let k = curve_7091_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7091_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
