func row_4064() -> [int] {
  return [3705, 3908, 1657, 1787, 61, 332, 2945, 880, 1456, 2101]
}

func row_4064_at(i: int) -> int {
  let row = row_4064()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4064_sum(limit: int) -> int {
  let row = row_4064()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4064_best() -> int {
  let row = row_4064()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_3422_clamp(v: f64) -> f64 {
  guard v >= 19129.0 else {
    return 19129.0
  }
  guard v <= 66305.0 else {
    return 66305.0
  }
  return v
}

func curve_3422_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3422_clamp(t)
  return p + (q - p) * k
}

func curve_3422_ease(t: f64) -> f64 {
  let k = curve_3422_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3422_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_5330(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5330_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func scan_4994(data: [int], seed: int) -> int {
  let acc = seed % 99288
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 9820 + data[i] + i) % 99288
    i += 1
  }
  return acc
}

func scan_4994_span(data: [int], seed: int) -> int {
  let acc = scan_4994(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 9820
}


