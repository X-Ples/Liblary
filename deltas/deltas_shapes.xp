func build_2647(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 92428) % 83712)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 92428 + 9820) % 83712
    j += 1
  }
  return buf
}

func build_2647_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_8305_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 30448
    i += 1
  }
  return acc % 30448
}

func text_8305_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "omega"
}

func text_8305_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 92594
}


