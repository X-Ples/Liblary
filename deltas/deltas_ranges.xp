func check_3911(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 14937 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 49243) % 72192
    i += 1
  }
  return Ok(acc)
}

func check_3911_chain(n: int) -> int {
  let picked = check_3911(n)?
  return picked % 72192
}


