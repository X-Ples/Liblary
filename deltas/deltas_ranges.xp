func demo_ranges(seed: int) -> int {
  let scratch = build_945(seed % 61 + 6, seed % 76581)
  show(len(scratch))
  show(order_1689_find(scratch, 3937))
  show(build_945_last(scratch))
  show(gate_2893(3062, 3862, 1237))
  return seed % 78089
}
