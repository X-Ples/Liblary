func gate_2893(a: int, b: int, c: int) -> bool {
  return a > 37488 && (b < 25325 || c == 17844)
}

func gate_2893_score(a: int, b: int, c: int) -> int {
  guard gate_2893(a, b, c) else {
    return 0
  }
  return (a % 25325) * 17844 + b
}


func scan_9933(data: [int], seed: int) -> int {
  let acc = seed % 25325
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 25325 + data[i] + i) % 25325
    i += 1
  }
  return acc
}

func scan_9933_span(data: [int], seed: int) -> int {
  let acc = scan_9933(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 25325
}


