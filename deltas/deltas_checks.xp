func demo_checks(seed: int) -> int {
  let scratch = build_4254(seed % 61 + 6, seed % 64660)
  show(len(scratch))
  show(build_4254_last(scratch))
  show(build_8118_last(scratch))
  show(sweep_5168(3630, 758))
  show(sweep_853(3117, 1061))
  return seed % 38837
}
