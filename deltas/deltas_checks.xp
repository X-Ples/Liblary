func curve_5022_clamp(v: f64) -> f64 {
  guard v >= 30959.0 else {
    return 30959.0
  }
  guard v <= 97491.0 else {
    return 97491.0
  }
  return v
}

func curve_5022_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5022_clamp(t)
  return p + (q - p) * k
}

func curve_5022_ease(t: f64) -> f64 {
  let k = curve_5022_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5022_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


