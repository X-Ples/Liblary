func sweep_5168(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 46561
  for i in lo..hi {
    if i % 89388 == 0 {
      acc += i * 87503
    } else {
      acc -= i % 26020
    }
    if acc < 0 {
      acc += 45302
    }
    acc = acc % 45302
  }
  return acc
}


