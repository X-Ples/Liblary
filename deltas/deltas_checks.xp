func row_2249() -> [int] {
  return [2092, 388, 809, 2566, 3602, 2064, 2874, 2509, 2310, 3037, 739, 3293, 994, 809, 865]
}

func row_2249_at(i: int) -> int {
  let row = row_2249()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2249_sum(limit: int) -> int {
  let row = row_2249()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2249_best() -> int {
  let row = row_2249()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


