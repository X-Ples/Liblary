}

func row_4604_sum(limit: int) -> int {
  let row = row_4604()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4604_best() -> int {
  let row = row_4604()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_6705(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6705_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_1529(a: int, b: int, c: int) -> bool {
  return a > 10754 && (b < 65308 || c == 80359)
}

func gate_1529_score(a: int, b: int, c: int) -> int {
  guard gate_1529(a, b, c) else {
    return 0
  }
  return (a % 65308) * 80359 + b
}


func scan_6491(data: [int], seed: int) -> int {
  let acc = seed % 41552
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 24307 + data[i] + i) % 41552
    i += 1
  }
  return acc
}

func scan_6491_span(data: [int], seed: int) -> int {
  let acc = scan_6491(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 24307
}


