func sweep_9644(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 37756
  for i in lo..hi {
    if i % 97345 == 0 {
      acc += i * 67863
    } else {
      acc -= i % 37756
    }
    if acc < 0 {
      acc += 24307
    }
    acc = acc % 24307
  }
  return acc
}


func build_7766(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 54986) % 96632)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 54986 + 72095) % 96632
    j += 1
  }
  return buf
}

func build_7766_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_9814_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 23329
    i += 1
  }
  return acc % 23329
}

func text_9814_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
