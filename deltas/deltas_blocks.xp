func demo_blocks(seed: int) -> int {
  let scratch = build_4526(seed % 61 + 6, seed % 65483)
  show(len(scratch))
  show(build_4526_last(scratch))
  show(scan_6561(scratch, 938))
  show(scan_6561_span(scratch, 2241))
  show(scan_3723(scratch, 2008))
  return seed % 88617
}
