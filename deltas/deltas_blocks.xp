func row_7559() -> [int] {
  return [955, 3374, 1763, 1276, 2696, 2984, 1704, 3371, 2084, 3458, 624, 3024, 2635, 2995]
}

func row_7559_at(i: int) -> int {
  let row = row_7559()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7559_sum(limit: int) -> int {
  let row = row_7559()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7559_best() -> int {
  let row = row_7559()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_1538_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 44314
    i += 1
  }
  return acc % 44314
}

func text_1538_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "mesa"
}

func text_1538_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 31965
}


