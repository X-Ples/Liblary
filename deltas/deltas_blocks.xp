func sweep_5794(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 22269
  for i in lo..hi {
    if i % 39374 == 0 {
      acc += i * 19908
    } else {
      acc -= i % 7161
    }
    if acc < 0 {
      acc += 11006
    }
    acc = acc % 11006
  }
  return acc
}


