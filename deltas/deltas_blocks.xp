func build_4526(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 75648) % 85795)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 75648 + 62934) % 85795
    j += 1
  }
  return buf
}

func build_4526_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_6561(data: [int], seed: int) -> int {
  let acc = seed % 88617
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 22269 + data[i] + i) % 88617
    i += 1
  }
  return acc
}

func scan_6561_span(data: [int], seed: int) -> int {
  let acc = scan_6561(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 22269
}


