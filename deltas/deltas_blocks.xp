func check_3888(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 32913 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 22269) % 62411
    i += 1
  }
  return Ok(acc)
}

func check_3888_chain(n: int) -> int {
  let picked = check_3888(n)?
  return picked % 62411
}


