func scan_8863(data: [int], seed: int) -> int {
  let acc = seed % 14862
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 83013 + data[i] + i) % 14862
    i += 1
  }
  return acc
}

func scan_8863_span(data: [int], seed: int) -> int {
  let acc = scan_8863(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 83013
}


