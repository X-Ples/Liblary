func demo_ops(seed: int) -> int {
  let scratch = build_2033(seed % 61 + 6, seed % 90722)
  show(len(scratch))
  show(build_2033_last(scratch))
  show(order_7038_find(scratch, 1377))
  show(check_8554_chain(3955))
  return seed % 79998
}
