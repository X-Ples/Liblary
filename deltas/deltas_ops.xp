const K0 = 67213
const K1 = 24525
const K2 = 19032
const K3 = 80309
const K4 = 20206
const K5 = 3418

func build_2033(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 53601) % 33802)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 53601 + 96023) % 33802
    j += 1
  }
  return buf
}

func build_2033_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_7038(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7038_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func check_8554(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 1722 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 81589) % 20206
    i += 1
  }
  return Ok(acc)
}

func check_8554_chain(n: int) -> int {
  let picked = check_8554(n)?
  return picked % 20206
}


func scan_2000(data: [int], seed: int) -> int {
  let acc = seed % 33802
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 90722 + data[i] + i) % 33802
    i += 1
  }
  return acc
}

func scan_2000_span(data: [int], seed: int) -> int {
  let acc = scan_2000(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 90722
}


func curve_275_clamp(v: f64) -> f64 {
  guard v >= 58616.0 else {
    return 58616.0
  }
  guard v <= 91022.0 else {
    return 91022.0
  }
  return v
}

func curve_275_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_275_clamp(t)
  return p + (q - p) * k
}

func curve_275_ease(t: f64) -> f64 {
  let k = curve_275_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_275_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


