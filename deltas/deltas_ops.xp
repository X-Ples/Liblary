func grid_495_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 19032 + c * 53601 + seed) % 53601)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_495_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 53601 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_6659_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 81423
    i += 1
  }
  return acc % 81423
}

func text_6659_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "sigma"
  }
  return "flint"
}

func text_6659_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 91022
}


func sweep_1380(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 58616
  for i in lo..hi {
    if i % 1722 == 0 {
      acc += i * 35946
    } else {
      acc -= i % 90722
    }
    if acc < 0 {
      acc += 99818
    }
    acc = acc % 99818
  }
  return acc
}


func sweep_5535(lo: int, hi: int) -> int {
