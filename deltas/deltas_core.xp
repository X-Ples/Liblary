func build_1951(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 67175) % 56122)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 67175 + 84512) % 56122
    j += 1
  }
  return buf
}

func build_1951_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_5762_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 56122
    i += 1
  }
  return acc % 56122
}

func text_5762_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "flint"
}

func text_5762_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 31194
}


func order_7423(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7423_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_8947(a: int, b: int, c: int) -> bool {
  return a > 59517 && (b < 84512 || c == 31194)
}

func gate_8947_score(a: int, b: int, c: int) -> int {
  guard gate_8947(a, b, c) else {
    return 0
  }
  return (a % 84512) * 31194 + b
}


func curve_6411_clamp(v: f64) -> f64 {
  guard v >= 31194.0 else {
    return 31194.0
  }
  guard v <= 56122.0 else {
    return 56122.0
  }
  return v
}

func curve_6411_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6411_clamp(t)
  return p + (q - p) * k
}

func curve_6411_ease(t: f64) -> f64 {
  let k = curve_6411_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6411_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_5834_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 15360 + c * 71670 + seed) % 71670)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5834_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 71670 == want {
      total += acc
    }
    r += 1
  }
  return total
}


