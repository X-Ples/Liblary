func row_2133_at(i: int) -> int {
  let row = row_2133()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2133_sum(limit: int) -> int {
  let row = row_2133()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2133_best() -> int {
  let row = row_2133()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


