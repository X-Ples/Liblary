func check_3307(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 84512 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 88344) % 2396
    i += 1
  }
  return Ok(acc)
}

func check_3307_chain(n: int) -> int {
  let picked = check_3307(n)?
  return picked % 2396
}


func sweep_8692(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 67175
  for i in lo..hi {
    if i % 25572 == 0 {
      acc += i * 88344
    } else {
      acc -= i % 56122
    }
    if acc < 0 {
      acc += 75654
    }
    acc = acc % 75654
  }
  return acc
}


