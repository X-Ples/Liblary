func text_4971_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 50833
    i += 1
  }
  return acc % 50833
}

func text_4971_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "cargo"
}

func text_4971_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 50833
}


func check_3279(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 47568 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 86280) % 86368
    i += 1
  }
  return Ok(acc)
}

func check_3279_chain(n: int) -> int {
  let picked = check_3279(n)?
  return picked % 86368
}


func grid_7210_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 20625 + c * 86280 + seed) % 86280)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7210_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 86280 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func row_2873() -> [int] {
  return [2058, 3935, 2607, 3307, 3289, 2870, 1639, 2709, 22, 1304, 287, 3737, 2731]
}

func row_2873_at(i: int) -> int {
  let row = row_2873()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2873_sum(limit: int) -> int {
  let row = row_2873()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2873_best() -> int {
  let row = row_2873()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


