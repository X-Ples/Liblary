    return 69254.0
  }
  return v
}

func curve_646_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_646_clamp(t)
  return p + (q - p) * k
}

func curve_646_ease(t: f64) -> f64 {
  let k = curve_646_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_646_step(t: f64, period: f64) -> f64 {
