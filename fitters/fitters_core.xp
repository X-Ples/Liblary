  }
  return (a % 89066) * 76743 + b
}


func scan_3450(data: [int], seed: int) -> int {
  let acc = seed % 63729
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 17195 + data[i] + i) % 63729
    i += 1
  }
  return acc
}

func scan_3450_span(data: [int], seed: int) -> int {
  let acc = scan_3450(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 17195
}


