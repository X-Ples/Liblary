func demo_core(seed: int) -> int {
  let scratch = build_3652(seed % 61 + 6, seed % 44336)
  show(len(scratch))
  show(sweep_4500(845, 47))
  show(build_3652_last(scratch))
  show(grid_2373_rowsum(scratch, 1184, 409, 1830))
  show(grid_576_rowsum(scratch, 1217, 2345, 3877))
  show(text_5531_weight("ion"))
  show(text_5531_label(1213))
  return seed % 65220
}
