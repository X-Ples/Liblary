func check_9474(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 76743 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 63729) % 84201
    i += 1
  }
  return Ok(acc)
}

func check_9474_chain(n: int) -> int {
  let picked = check_9474(n)?
  return picked % 84201
}


