func sweep_4500(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 76743
  for i in lo..hi {
    if i % 84201 == 0 {
      acc += i * 89066
    } else {
      acc -= i % 37096
    }
    if acc < 0 {
      acc += 37096
    }
    acc = acc % 37096
  }
  return acc
}


func build_3652(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 63729) % 44336)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 63729 + 63729) % 44336
    j += 1
  }
  return buf
}

func build_3652_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_2373_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 59572 + c * 65220 + seed) % 65220)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2373_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 65220 == want {
      total += acc
    }
    r += 1
  }
  return total
}


