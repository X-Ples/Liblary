func scan_9263(data: [int], seed: int) -> int {
  let acc = seed % 58607
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 41322 + data[i] + i) % 58607
    i += 1
  }
  return acc
}

func scan_9263_span(data: [int], seed: int) -> int {
  let acc = scan_9263(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 41322
}


