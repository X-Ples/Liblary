func row_439() -> [int] {
  return [1437, 314, 2146, 2209, 2786, 385, 3019, 1276, 3510, 3232, 3939, 3374, 2413]
}

func row_439_at(i: int) -> int {
  let row = row_439()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_439_sum(limit: int) -> int {
  let row = row_439()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_439_best() -> int {
  let row = row_439()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_5600_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 74017 + c * 43866 + seed) % 43866)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5600_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 43866 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_2669(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 58607 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 32432) % 20926
    i += 1
  }
  return Ok(acc)
}

func check_2669_chain(n: int) -> int {
  let picked = check_2669(n)?
  return picked % 20926
}


func build_218(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 61281) % 20926)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 61281 + 12021) % 20926
    j += 1
  }
  return buf
}

func build_218_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_9267_clamp(v: f64) -> f64 {
  guard v >= 33623.0 else {
    return 33623.0
  }
  guard v <= 61281.0 else {
    return 61281.0
  }
  return v
}

func curve_9267_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9267_clamp(t)
  return p + (q - p) * k
}

func curve_9267_ease(t: f64) -> f64 {
  let k = curve_9267_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9267_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


