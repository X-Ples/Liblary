func check_6419(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 90661 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 45705) % 4054
    i += 1
  }
  return Ok(acc)
}

func check_6419_chain(n: int) -> int {
  let picked = check_6419(n)?
  return picked % 4054
}


