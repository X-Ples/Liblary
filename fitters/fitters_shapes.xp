func curve_1091_clamp(v: f64) -> f64 {
  guard v >= 28250.0 else {
    return 28250.0
  }
  guard v <= 90349.0 else {
    return 90349.0
  }
  return v
}

func curve_1091_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1091_clamp(t)
  return p + (q - p) * k
}

func curve_1091_ease(t: f64) -> f64 {
  let k = curve_1091_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1091_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_2025(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 98093) % 46945)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 98093 + 22160) % 46945
    j += 1
  }
  return buf
}

func build_2025_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_3308(a: int, b: int, c: int) -> bool {
  return a > 10689 && (b < 10689 || c == 13281)
}

func gate_3308_score(a: int, b: int, c: int) -> int {
  guard gate_3308(a, b, c) else {
    return 0
  }
  return (a % 10689) * 13281 + b
}


