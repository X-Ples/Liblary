func sweep_3635(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 49409
  for i in lo..hi {
    if i % 72533 == 0 {
      acc += i * 58769
    } else {
      acc -= i % 69248
    }
    if acc < 0 {
      acc += 58769
    }
    acc = acc % 58769
  }
  return acc
}


