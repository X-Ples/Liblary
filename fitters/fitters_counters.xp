func row_2046_at(i: int) -> int {
  let row = row_2046()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2046_sum(limit: int) -> int {
  let row = row_2046()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2046_best() -> int {
  let row = row_2046()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_6917_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 56209
    i += 1
  }
  return acc % 56209
}

func text_6917_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "ion"
}

func text_6917_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 7927
}


