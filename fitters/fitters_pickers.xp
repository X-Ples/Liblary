func demo_pickers(seed: int) -> int {
  let scratch = build_8435(seed % 61 + 6, seed % 39754)
  show(len(scratch))
  show(build_8435_last(scratch))
  show(check_9413_chain(458))
  show(scan_1705(scratch, 695))
  show(scan_1705_span(scratch, 472))
  return seed % 53240
}
