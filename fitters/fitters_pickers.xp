func gate_3916(a: int, b: int, c: int) -> bool {
  return a > 57600 && (b < 39754 || c == 27894)
}

func gate_3916_score(a: int, b: int, c: int) -> int {
  guard gate_3916(a, b, c) else {
    return 0
  }
  return (a % 39754) * 27894 + b
}


