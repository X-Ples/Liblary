func sweep_725(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 32185
  for i in lo..hi {
    if i % 9642 == 0 {
      acc += i * 39754
    } else {
      acc -= i % 72747
    }
    if acc < 0 {
      acc += 97649
    }
    acc = acc % 97649
  }
  return acc
}


