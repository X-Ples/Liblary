func row_8723() -> [int] {
  return [860, 1714, 3976, 3487, 3696, 835, 1230, 1617, 3438, 1633, 1613, 859]
}

func row_8723_at(i: int) -> int {
  let row = row_8723()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8723_sum(limit: int) -> int {
  let row = row_8723()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8723_best() -> int {
  let row = row_8723()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_9882_clamp(v: f64) -> f64 {
  guard v >= 27894.0 else {
    return 27894.0
  }
  guard v <= 79703.0 else {
    return 79703.0
  }
  return v
}

func curve_9882_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9882_clamp(t)
  return p + (q - p) * k
}

func curve_9882_ease(t: f64) -> f64 {
  let k = curve_9882_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9882_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


