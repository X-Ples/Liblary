    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 34243 + 24264) % 57974
    j += 1
  }
  return buf
}

func build_1265_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


