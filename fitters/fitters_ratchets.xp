func scan_2102(data: [int], seed: int) -> int {
  let acc = seed % 45046
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 86134 + data[i] + i) % 45046
    i += 1
  }
  return acc
}

func scan_2102_span(data: [int], seed: int) -> int {
  let acc = scan_2102(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 86134
}


