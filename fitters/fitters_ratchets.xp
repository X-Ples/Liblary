func sweep_2428(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 19925
  for i in lo..hi {
    if i % 71741 == 0 {
      acc += i * 67979
    } else {
      acc -= i % 82004
    }
    if acc < 0 {
      acc += 45046
    }
    acc = acc % 45046
  }
  return acc
}


func curve_952_clamp(v: f64) -> f64 {
  guard v >= 34243.0 else {
    return 34243.0
  }
  guard v <= 90787.0 else {
    return 90787.0
  }
  return v
}

func curve_952_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_952_clamp(t)
  return p + (q - p) * k
}

func curve_952_ease(t: f64) -> f64 {
  let k = curve_952_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_952_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_ratchets(seed: int) -> int {
  let scratch = build_1265(seed % 61 + 6, seed % 24815)
  show(len(scratch))
  show(grid_3186_rowsum(scratch, 954, 2095, 3898))
  show(build_1265_last(scratch))
  show(grid_8416_rowsum(scratch, 1914, 1187, 2243))
  show(build_3194_last(scratch))
  show(row_7643_at(2252))
  return seed % 82004
}
