func check_6026(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 19925 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 59326) % 63190
    i += 1
  }
  return Ok(acc)
}

func check_6026_chain(n: int) -> int {
  let picked = check_6026(n)?
  return picked % 63190
}


