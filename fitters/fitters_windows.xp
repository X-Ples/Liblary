func text_7370_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 21609
    i += 1
  }
  return acc % 21609
}

func text_7370_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "talus"
}

func text_7370_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 90893
}


func sweep_1066(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 4860
  for i in lo..hi {
    if i % 31115 == 0 {
      acc += i * 45907
    } else {
      acc -= i % 51492
    }
    if acc < 0 {
      acc += 33883
    }
    acc = acc % 33883
  }
  return acc
}


func scan_5958(data: [int], seed: int) -> int {
  let acc = seed % 81538
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 90893 + data[i] + i) % 81538
    i += 1
  }
  return acc
}

func scan_5958_span(data: [int], seed: int) -> int {
  let acc = scan_5958(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 90893
}


func build_6235(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 81538) % 75775)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 81538 + 31115) % 75775
    j += 1
  }
  return buf
}

func build_6235_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


