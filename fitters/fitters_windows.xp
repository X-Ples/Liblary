func demo_windows(seed: int) -> int {
  let scratch = build_6235(seed % 61 + 6, seed % 85929)
  show(len(scratch))
  show(text_7370_weight("kilo"))
  show(text_7370_label(3593))
  show(text_7370_has("kilo"))
  show(sweep_1066(2111, 1686))
  show(scan_5958(scratch, 2045))
  return seed % 75775
}
