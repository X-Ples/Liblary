func scan_6189(data: [int], seed: int) -> int {
  let acc = seed % 10593
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 44303 + data[i] + i) % 10593
    i += 1
  }
  return acc
}

func scan_6189_span(data: [int], seed: int) -> int {
  let acc = scan_6189(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 44303
}


func curve_2048_clamp(v: f64) -> f64 {
  guard v >= 16968.0 else {
    return 16968.0
  }
  guard v <= 76203.0 else {
    return 76203.0
  }
  return v
}

func curve_2048_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2048_clamp(t)
  return p + (q - p) * k
}

func curve_2048_ease(t: f64) -> f64 {
  let k = curve_2048_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2048_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


