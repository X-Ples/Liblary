}

func row_6728_at(i: int) -> int {
  let row = row_6728()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6728_sum(limit: int) -> int {
  let row = row_6728()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6728_best() -> int {
  let row = row_6728()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_1742_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 21356
    i += 1
  }
  return acc % 21356
}

func text_1742_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "nova"
}

func text_1742_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 88228
}


func grid_7832_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 15493 + c * 25743 + seed) % 25743)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7832_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 25743 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_1243(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 23544 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 88228) % 91116
    i += 1
  }
  return Ok(acc)
}

func check_1243_chain(n: int) -> int {
  let picked = check_1243(n)?
  return picked % 91116
}


