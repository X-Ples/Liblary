func curve_1550_clamp(v: f64) -> f64 {
  guard v >= 21356.0 else {
    return 21356.0
  }
  guard v <= 90992.0 else {
    return 90992.0
  }
  return v
}

func curve_1550_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1550_clamp(t)
  return p + (q - p) * k
}

func curve_1550_ease(t: f64) -> f64 {
  let k = curve_1550_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1550_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_reductions(seed: int) -> int {
  let scratch = build_7577(seed % 61 + 6, seed % 7351)
  show(len(scratch))
  show(build_7577_last(scratch))
  show(row_6728_at(2254))
  show(row_6728_sum(2930))
  show(row_6728_best())
  show(text_1742_weight("alpha"))
  show(text_1742_label(2012))
  return seed % 90992
}
