func build_7577(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 36533) % 4933)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 36533 + 89824) % 4933
    j += 1
  }
  return buf
}

func build_7577_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_6728() -> [int] {
