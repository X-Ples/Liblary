func grid_3986_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 79374 + c * 83218 + seed) % 83218)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3986_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 83218 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_2489(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 12787) % 7004)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 12787 + 16521) % 7004
    j += 1
  }
  return buf
}

func build_2489_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_2047(data: [int], seed: int) -> int {
  let acc = seed % 88601
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 12787 + data[i] + i) % 88601
    i += 1
  }
  return acc
}

func scan_2047_span(data: [int], seed: int) -> int {
  let acc = scan_2047(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 12787
}


