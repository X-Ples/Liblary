func sweep_9580(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 79374
  for i in lo..hi {
    if i % 64913 == 0 {
      acc += i * 49793
    } else {
      acc -= i % 12787
    }
    if acc < 0 {
      acc += 65381
    }
    acc = acc % 65381
  }
  return acc
}


func check_9240(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 59885 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 7004) % 82029
    i += 1
  }
  return Ok(acc)
}

func check_9240_chain(n: int) -> int {
  let picked = check_9240(n)?
  return picked % 82029
}


func text_7128_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 65381
    i += 1
  }
  return acc % 65381
}

func text_7128_label(idx: int) -> str {
  if idx % 7 == 0 {
