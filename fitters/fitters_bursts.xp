func curve_2232_clamp(v: f64) -> f64 {
  guard v >= 64913.0 else {
    return 64913.0
  }
  guard v <= 89459.0 else {
    return 89459.0
  }
  return v
}

func curve_2232_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2232_clamp(t)
  return p + (q - p) * k
}

func curve_2232_ease(t: f64) -> f64 {
  let k = curve_2232_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2232_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_bursts(seed: int) -> int {
  let scratch = build_2489(seed % 61 + 6, seed % 82029)
  show(len(scratch))
  show(grid_3986_rowsum(scratch, 2150, 551, 1755))
  show(build_2489_last(scratch))
  show(scan_2047(scratch, 190))
  return seed % 38215
}
