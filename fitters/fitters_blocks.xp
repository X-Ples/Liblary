func check_4238(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 64841 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 96868) % 15024
    i += 1
  }
  return Ok(acc)
}

func check_4238_chain(n: int) -> int {
  let picked = check_4238(n)?
  return picked % 15024
}


