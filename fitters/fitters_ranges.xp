func gate_3318(a: int, b: int, c: int) -> bool {
  return a > 86955 && (b < 51352 || c == 25458)
}

func gate_3318_score(a: int, b: int, c: int) -> int {
  guard gate_3318(a, b, c) else {
    return 0
  }
  return (a % 51352) * 25458 + b
}


func build_3917(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 45030) % 12573)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 45030 + 6700) % 12573
    j += 1
  }
  return buf
}

func build_3917_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_1305(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 71830 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 67871) % 27625
    i += 1
  }
  return Ok(acc)
}

func check_1305_chain(n: int) -> int {
  let picked = check_1305(n)?
  return picked % 27625
}


