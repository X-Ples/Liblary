func curve_4782_clamp(v: f64) -> f64 {
  guard v >= 29936.0 else {
    return 29936.0
  }
  guard v <= 46858.0 else {
    return 46858.0
  }
  return v
}

func curve_4782_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4782_clamp(t)
  return p + (q - p) * k
}

func curve_4782_ease(t: f64) -> f64 {
  let k = curve_4782_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4782_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_2640(data: [int], seed: int) -> int {
  let acc = seed % 208
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 86955 + data[i] + i) % 208
    i += 1
  }
  return acc
}

func scan_2640_span(data: [int], seed: int) -> int {
  let acc = scan_2640(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 86955
}


