func demo_ranges(seed: int) -> int {
  let scratch = build_3917(seed % 61 + 6, seed % 67259)
  show(len(scratch))
  show(gate_3318(903, 2734, 111))
  show(gate_3318_score(826, 3131, 3319))
  show(build_3917_last(scratch))
  show(check_1305_chain(439))
  return seed % 6700
}
