func sweep_6377(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 71830
  for i in lo..hi {
    if i % 92627 == 0 {
      acc += i * 12573
    } else {
      acc -= i % 66854
    }
    if acc < 0 {
      acc += 66854
    }
    acc = acc % 66854
  }
  return acc
}


