func row_6826() -> [int] {
  return [394, 435, 1988, 2381, 77, 928, 817, 2388, 2135, 339, 254, 3699, 2349, 1206, 2140, 1299]
}

func row_6826_at(i: int) -> int {
  let row = row_6826()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6826_sum(limit: int) -> int {
  let row = row_6826()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6826_best() -> int {
  let row = row_6826()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_8410_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 34018
    i += 1
  }
  return acc % 34018
}

func text_8410_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "alpha"
}

func text_8410_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 76606
}


