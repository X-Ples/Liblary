func sweep_4434(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 89144
  for i in lo..hi {
    if i % 12294 == 0 {
      acc += i * 55868
    } else {
      acc -= i % 66286
    }
    if acc < 0 {
      acc += 31526
    }
    acc = acc % 31526
  }
  return acc
}


