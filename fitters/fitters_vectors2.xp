func scan_3053(data: [int], seed: int) -> int {
  let acc = seed % 58461
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 45670 + data[i] + i) % 58461
    i += 1
  }
  return acc
}

func scan_3053_span(data: [int], seed: int) -> int {
  let acc = scan_3053(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 45670
}


