func demo_vectors2(seed: int) -> int {
  let scratch = build_6828(seed % 61 + 6, seed % 34063)
  show(len(scratch))
  show(scan_3053(scratch, 1314))
  show(scan_3053_span(scratch, 1098))
  show(build_6828_last(scratch))
  show(scan_9807(scratch, 3316))
  show(scan_9807_span(scratch, 606))
  return seed % 44898
}
