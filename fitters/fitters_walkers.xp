func scan_9870(data: [int], seed: int) -> int {
  let acc = seed % 86749
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 62312 + data[i] + i) % 86749
    i += 1
  }
  return acc
}

func scan_9870_span(data: [int], seed: int) -> int {
  let acc = scan_9870(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 62312
}


