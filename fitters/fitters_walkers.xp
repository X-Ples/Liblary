func sweep_9215(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 66333
  for i in lo..hi {
    if i % 42051 == 0 {
      acc += i * 89994
    } else {
      acc -= i % 15720
    }
    if acc < 0 {
      acc += 97134
    }
    acc = acc % 97134
  }
  return acc
}


