func gate_1200(a: int, b: int, c: int) -> bool {
  return a > 98808 && (b < 17283 || c == 41823)
}

func gate_1200_score(a: int, b: int, c: int) -> int {
  guard gate_1200(a, b, c) else {
    return 0
  }
  return (a % 17283) * 41823 + b
}


