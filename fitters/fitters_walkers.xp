func build_2282(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 8113) % 83309)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 8113 + 17283) % 83309
    j += 1
  }
  return buf
}

func build_2282_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_4194() -> [int] {
  return [3677, 3342, 922, 592, 1025, 287, 2355, 1498, 549, 3163, 2223, 95, 2974, 3682, 2899, 895, 3606, 4001]
}

func row_4194_at(i: int) -> int {
  let row = row_4194()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4194_sum(limit: int) -> int {
  let row = row_4194()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4194_best() -> int {
  let row = row_4194()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


