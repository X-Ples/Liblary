func demo_walkers(seed: int) -> int {
  let scratch = build_2282(seed % 61 + 6, seed % 83309)
  show(len(scratch))
  show(build_2282_last(scratch))
  show(row_4194_at(1315))
  show(row_4194_sum(1926))
  return seed % 92702
}
