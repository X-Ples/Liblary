func curve_3792_clamp(v: f64) -> f64 {
  guard v >= 42051.0 else {
    return 42051.0
  }
  guard v <= 89994.0 else {
    return 89994.0
  }
  return v
}

func curve_3792_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3792_clamp(t)
  return p + (q - p) * k
}

func curve_3792_ease(t: f64) -> f64 {
  let k = curve_3792_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3792_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_5453(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 97134 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 97134) % 55241
    i += 1
  }
  return Ok(acc)
}

func check_5453_chain(n: int) -> int {
  let picked = check_5453(n)?
  return picked % 55241
}


