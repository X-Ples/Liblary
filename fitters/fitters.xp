func sweep_4615(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 28090
  for i in lo..hi {
    if i % 79960 == 0 {
      acc += i * 37820
    } else {
      acc -= i % 85576
    }
    if acc < 0 {
      acc += 38650
    }
    acc = acc % 38650
  }
  return acc
}


