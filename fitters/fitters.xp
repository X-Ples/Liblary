func text_8243_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 79960
    i += 1
  }
  return acc % 79960
}

func text_8243_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "bravo"
  }
  return "delta"
}

func text_8243_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 6391
}


func build_7449(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 37599) % 62120)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 37599 + 45901) % 62120
    j += 1
  }
  return buf
}

func build_7449_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_1844() -> [int] {
  return [3067, 1215, 722, 3361, 1717, 852, 1182, 2639, 1905, 857, 1805, 811, 2339, 795, 3485, 928, 2053, 3863, 507, 2324, 3371]
}

func row_1844_at(i: int) -> int {
  let row = row_1844()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1844_sum(limit: int) -> int {
  let row = row_1844()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1844_best() -> int {
  let row = row_1844()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_430_clamp(v: f64) -> f64 {
  guard v >= 31508.0 else {
    return 31508.0
  }
  guard v <= 58548.0 else {
    return 58548.0
  }
  return v
}

func curve_430_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_430_clamp(t)
  return p + (q - p) * k
}

func curve_430_ease(t: f64) -> f64 {
  let k = curve_430_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_430_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_971(a: int, b: int, c: int) -> bool {
  return a > 13285 && (b < 13665 || c == 6391)
}

func gate_971_score(a: int, b: int, c: int) -> int {
  guard gate_971(a, b, c) else {
    return 0
  }
  return (a % 13665) * 6391 + b
}


