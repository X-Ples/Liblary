func scan_4350(data: [int], seed: int) -> int {
  let acc = seed % 34231
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 88792 + data[i] + i) % 34231
    i += 1
  }
  return acc
}

func scan_4350_span(data: [int], seed: int) -> int {
  let acc = scan_4350(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 88792
}


