func demo_twists(seed: int) -> int {
  let scratch = build_9265(seed % 61 + 6, seed % 63862)
  show(len(scratch))
  show(check_7195_chain(3325))
  show(grid_841_rowsum(scratch, 1266, 3574, 2445))
  show(build_9265_last(scratch))
  show(order_4995_find(scratch, 3910))
  show(sweep_2312(271, 855))
  show(check_4130_chain(1554))
  return seed % 71580
}
