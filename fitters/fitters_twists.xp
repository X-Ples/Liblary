func check_7195(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 99329 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 52089) % 17616
    i += 1
  }
  return Ok(acc)
}

func check_7195_chain(n: int) -> int {
  let picked = check_7195(n)?
  return picked % 17616
}


func grid_841_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 10965 + c * 2290 + seed) % 2290)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_841_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 2290 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_9265(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 31087) % 17616)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 31087 + 4980) % 17616
    j += 1
  }
  return buf
}

func build_9265_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_4995(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4995_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_2312(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10965
  for i in lo..hi {
    if i % 66769 == 0 {
      acc += i * 85306
    } else {
      acc -= i % 76515
    }
    if acc < 0 {
      acc += 95902
    }
    acc = acc % 95902
  }
  return acc
}


