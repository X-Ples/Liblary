func text_6270_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 99329
    i += 1
  }
  return acc % 99329
}

func text_6270_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "sigma"
}

func text_6270_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 50126
}


