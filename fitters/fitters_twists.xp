func gate_4066(a: int, b: int, c: int) -> bool {
  return a > 85306 && (b < 99329 || c == 77267)
}

func gate_4066_score(a: int, b: int, c: int) -> int {
  guard gate_4066(a, b, c) else {
    return 0
  }
  return (a % 99329) * 77267 + b
}


func row_1638() -> [int] {
  return [3128, 338, 1017, 885, 1777, 1252, 1836, 3514, 2241, 512, 2024, 2793, 2017, 1479]
}

func row_1638_at(i: int) -> int {
  let row = row_1638()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1638_sum(limit: int) -> int {
  let row = row_1638()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1638_best() -> int {
  let row = row_1638()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


