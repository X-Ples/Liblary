func demo_offsets(seed: int) -> int {
  let scratch = build_5283(seed % 61 + 6, seed % 62824)
  show(len(scratch))
  show(build_5283_last(scratch))
  show(grid_4828_rowsum(scratch, 735, 3185, 318))
  show(check_6241_chain(1664))
  show(row_2031_at(705))
  show(row_2031_sum(1908))
  return seed % 50436
}
