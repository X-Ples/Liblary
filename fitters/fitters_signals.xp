func text_7342_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "harbor"
}

func text_7342_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 14757
}


