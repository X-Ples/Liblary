func demo_signals(seed: int) -> int {
  let scratch = build_414(seed % 61 + 6, seed % 8799)
  show(len(scratch))
  show(build_414_last(scratch))
  show(order_6007_find(scratch, 833))
  show(check_4323_chain(3780))
  show(order_1897_find(scratch, 2302))
  return seed % 55328
}
