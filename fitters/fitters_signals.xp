func sweep_9698(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 87932
  for i in lo..hi {
    if i % 82054 == 0 {
      acc += i * 61932
    } else {
      acc -= i % 87932
    }
    if acc < 0 {
      acc += 87932
    }
    acc = acc % 87932
  }
  return acc
}


