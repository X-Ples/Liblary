func demo_kernels(seed: int) -> int {
  let scratch = build_8569(seed % 61 + 6, seed % 54101)
  show(len(scratch))
  show(gate_5322(3562, 3255, 3042))
  show(gate_5322_score(944, 1346, 837))
  show(build_8569_last(scratch))
  show(sweep_813(993, 3797))
