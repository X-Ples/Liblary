func text_2228_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "bravo"
}

func text_2228_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 73162
}


