func row_2482() -> [int] {
  return [1202, 205, 936, 544, 2414, 3021, 2675, 1049, 2569, 2265, 3543, 172, 2172, 80, 2045, 3076, 1150, 4086]
}

func row_2482_at(i: int) -> int {
  let row = row_2482()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2482_sum(limit: int) -> int {
  let row = row_2482()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2482_best() -> int {
  let row = row_2482()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


