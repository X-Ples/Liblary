func gate_5322(a: int, b: int, c: int) -> bool {
  return a > 98450 && (b < 1088 || c == 28201)
}

func gate_5322_score(a: int, b: int, c: int) -> int {
  guard gate_5322(a, b, c) else {
    return 0
  }
  return (a % 1088) * 28201 + b
}


func build_8569(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 37873) % 45386)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 37873 + 58400) % 45386
    j += 1
  }
  return buf
}

func build_8569_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_813(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 54101
  for i in lo..hi {
    if i % 21267 == 0 {
      acc += i * 95638
    } else {
      acc -= i % 89731
    }
    if acc < 0 {
      acc += 54008
    }
    acc = acc % 54008
  }
  return acc
}


