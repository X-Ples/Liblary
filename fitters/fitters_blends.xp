func sweep_5242(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 42089
  for i in lo..hi {
    if i % 31483 == 0 {
      acc += i * 86837
    } else {
      acc -= i % 33760
    }
    if acc < 0 {
      acc += 6746
    }
    acc = acc % 6746
  }
  return acc
}


