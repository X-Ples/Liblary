func demo_blends(seed: int) -> int {
  let scratch = build_4272(seed % 61 + 6, seed % 101)
  show(len(scratch))
  show(build_4272_last(scratch))
  show(scan_9492(scratch, 1853))
  show(scan_9492_span(scratch, 815))
  return seed % 15616
}
