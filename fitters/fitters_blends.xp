func check_5120(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 101 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 41890) % 92781
    i += 1
  }
  return Ok(acc)
}

func check_5120_chain(n: int) -> int {
  let picked = check_5120(n)?
  return picked % 92781
}


