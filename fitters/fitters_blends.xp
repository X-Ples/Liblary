func build_4272(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 93729) % 22809)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 93729 + 101) % 22809
    j += 1
  }
  return buf
}

func build_4272_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_9492(data: [int], seed: int) -> int {
  let acc = seed % 45546
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 94640 + data[i] + i) % 45546
    i += 1
  }
  return acc
}

func scan_9492_span(data: [int], seed: int) -> int {
  let acc = scan_9492(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 94640
}


