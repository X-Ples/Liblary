func check_3521(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 82527 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 62906) % 65478
    i += 1
  }
  return Ok(acc)
}

func check_3521_chain(n: int) -> int {
  let picked = check_3521(n)?
  return picked % 65478
}


