func sweep_4478(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 62906
  for i in lo..hi {
    if i % 22216 == 0 {
      acc += i * 82527
    } else {
      acc -= i % 42400
    }
    if acc < 0 {
      acc += 82527
    }
    acc = acc % 82527
  }
  return acc
}


