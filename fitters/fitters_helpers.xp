  let row = row_2364()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2364_sum(limit: int) -> int {
  let row = row_2364()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
