func demo_helpers(seed: int) -> int {
  let scratch = build_4906(seed % 61 + 6, seed % 64264)
  show(len(scratch))
  show(build_4906_last(scratch))
  show(scan_8484(scratch, 3676))
  show(scan_8484_span(scratch, 3577))
  show(gate_1574(3570, 1080, 2067))
  return seed % 34900
}
