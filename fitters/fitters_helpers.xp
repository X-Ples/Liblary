func build_4906(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 33067) % 42400)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 33067 + 19098) % 42400
    j += 1
  }
  return buf
}

func build_4906_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_8484(data: [int], seed: int) -> int {
  let acc = seed % 92277
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 65478 + data[i] + i) % 92277
    i += 1
  }
  return acc
}

func scan_8484_span(data: [int], seed: int) -> int {
  let acc = scan_8484(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 65478
}


func gate_1574(a: int, b: int, c: int) -> bool {
  return a > 46834 && (b < 62906 || c == 18062)
}

func gate_1574_score(a: int, b: int, c: int) -> int {
  guard gate_1574(a, b, c) else {
    return 0
  }
  return (a % 62906) * 18062 + b
}


