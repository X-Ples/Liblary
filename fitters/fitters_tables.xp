func row_1475() -> [int] {
  return [2413, 229, 1257, 3726, 269, 3682, 3330, 3820, 720, 1548, 23, 2211, 3045, 3666]
}

func row_1475_at(i: int) -> int {
  let row = row_1475()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1475_sum(limit: int) -> int {
  let row = row_1475()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1475_best() -> int {
  let row = row_1475()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_6590(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 6718 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 52148) % 78903
    i += 1
  }
  return Ok(acc)
}

func check_6590_chain(n: int) -> int {
  let picked = check_6590(n)?
  return picked % 78903
}


func text_6996_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 94028
    i += 1
  }
  return acc % 94028
}

func text_6996_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "kilo"
}

func text_6996_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 74293
}


