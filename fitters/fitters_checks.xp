func demo_checks(seed: int) -> int {
  let scratch = build_378(seed % 61 + 6, seed % 88548)
  show(len(scratch))
  show(sweep_441(1625, 3073))
  show(order_9338_find(scratch, 2591))
  show(check_7736_chain(163))
  show(build_378_last(scratch))
  return seed % 68682
}
