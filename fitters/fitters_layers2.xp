func demo_layers2(seed: int) -> int {
  let scratch = build_840(seed % 61 + 6, seed % 63806)
  show(len(scratch))
  show(build_840_last(scratch))
  show(grid_3909_rowsum(scratch, 1418, 396, 594))
  show(order_8835_find(scratch, 2282))
  return seed % 9979
}
