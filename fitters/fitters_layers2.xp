func sweep_9615(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 27313
  for i in lo..hi {
    if i % 9979 == 0 {
      acc += i * 63806
    } else {
      acc -= i % 16575
    }
    if acc < 0 {
      acc += 8154
    }
    acc = acc % 8154
  }
  return acc
}


func check_7552(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 97902 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 97902) % 28628
    i += 1
  }
  return Ok(acc)
}

func check_7552_chain(n: int) -> int {
  let picked = check_7552(n)?
  return picked % 28628
}


