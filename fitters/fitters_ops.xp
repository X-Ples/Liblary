    acc += str_code_at(tag, i) % 30772
    i += 1
  }
  return acc % 30772
}

func text_9289_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "cargo"
}

func text_9289_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 29501
}


