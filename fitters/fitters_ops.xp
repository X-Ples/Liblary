func build_8622(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 62631) % 43803)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 62631 + 42427) % 43803
    j += 1
  }
  return buf
}

func build_8622_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_4680() -> [int] {
  return [2363, 2113, 3168, 2802, 2870, 1349, 421, 479, 3685, 41, 2857, 1446, 1551, 2730, 3174, 2279, 3685]
}

func row_4680_at(i: int) -> int {
  let row = row_4680()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4680_sum(limit: int) -> int {
  let row = row_4680()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4680_best() -> int {
  let row = row_4680()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


