func demo_layers2(seed: int) -> int {
  let scratch = build_3970(seed % 61 + 6, seed % 62913)
  show(len(scratch))
  show(build_3970_last(scratch))
  show(text_609_weight("flint"))
  show(text_609_label(654))
  show(text_609_has("omega"))
  show(text_9540_weight("ember"))
  return seed % 44952
}
