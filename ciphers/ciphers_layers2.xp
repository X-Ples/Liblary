func build_3970(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 24746) % 48272)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 24746 + 44952) % 48272
    j += 1
  }
  return buf
}

func build_3970_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_609_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 23115
    i += 1
  }
  return acc % 23115
}

func text_609_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "sigma"
  }
  return "gamma"
}

func text_609_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 62913
}


