}

func row_7712_at(i: int) -> int {
  let row = row_7712()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7712_sum(limit: int) -> int {
  let row = row_7712()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7712_best() -> int {
  let row = row_7712()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_8495(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 56441 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 31814) % 7398
    i += 1
  }
  return Ok(acc)
}

func check_8495_chain(n: int) -> int {
  let picked = check_8495(n)?
  return picked % 7398
}


