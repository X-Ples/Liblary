func check_2501(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 88443 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 39246) % 45926
    i += 1
  }
  return Ok(acc)
}

func check_2501_chain(n: int) -> int {
  let picked = check_2501(n)?
  return picked % 45926
}


