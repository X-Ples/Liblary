func build_9372(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 94599) % 77424)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 94599 + 46654) % 77424
    j += 1
  }
  return buf
}

func build_9372_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_3276(data: [int], seed: int) -> int {
  let acc = seed % 94599
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 44432 + data[i] + i) % 94599
    i += 1
  }
  return acc
}

func scan_3276_span(data: [int], seed: int) -> int {
  let acc = scan_3276(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 44432
}


