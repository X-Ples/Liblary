func sweep_9946(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 71463
  for i in lo..hi {
    if i % 39246 == 0 {
      acc += i * 26826
    } else {
      acc -= i % 90213
    }
    if acc < 0 {
      acc += 44432
    }
    acc = acc % 44432
  }
  return acc
}


func row_4590() -> [int] {
  return [2034, 3493, 1050, 2171, 2686, 1008, 3263, 3478, 40, 1943, 1443, 1130]
}

func row_4590_at(i: int) -> int {
  let row = row_4590()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4590_sum(limit: int) -> int {
  let row = row_4590()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4590_best() -> int {
  let row = row_4590()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


