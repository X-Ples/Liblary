func demo_twists(seed: int) -> int {
  let scratch = build_9372(seed % 61 + 6, seed % 25876)
  show(len(scratch))
  show(build_9372_last(scratch))
  show(scan_3276(scratch, 3000))
  show(scan_3276_span(scratch, 2430))
  return seed % 45926
}
