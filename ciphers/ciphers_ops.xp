func scan_8677(data: [int], seed: int) -> int {
  let acc = seed % 43205
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 41931 + data[i] + i) % 43205
    i += 1
  }
  return acc
}

func scan_8677_span(data: [int], seed: int) -> int {
  let acc = scan_8677(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 41931
}


func grid_5166_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 57592 + c * 13541 + seed) % 13541)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5166_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 13541 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_3231(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 43205
  for i in lo..hi {
    if i % 45940 == 0 {
      acc += i * 70372
    } else {
      acc -= i % 13541
    }
    if acc < 0 {
      acc += 41931
    }
    acc = acc % 41931
  }
  return acc
}


func build_5227(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 72009) % 51205)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 72009 + 45940) % 51205
    j += 1
  }
  return buf
}

func build_5227_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


