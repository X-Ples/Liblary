func curve_4357_clamp(v: f64) -> f64 {
  guard v >= 41343.0 else {
    return 41343.0
  }
  guard v <= 41343.0 else {
    return 41343.0
  }
  return v
}

func curve_4357_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4357_clamp(t)
  return p + (q - p) * k
}

func curve_4357_ease(t: f64) -> f64 {
  let k = curve_4357_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4357_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func curve_1335_clamp(v: f64) -> f64 {
  guard v >= 68054.0 else {
    return 68054.0
  }
  guard v <= 74017.0 else {
    return 74017.0
  }
  return v
}

func curve_1335_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1335_clamp(t)
  return p + (q - p) * k
}

func curve_1335_ease(t: f64) -> f64 {
  let k = curve_1335_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1335_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


