func demo_pickers(seed: int) -> int {
  let scratch = build_3686(seed % 61 + 6, seed % 41884)
  show(len(scratch))
  show(check_7147_chain(1071))
  show(build_3686_last(scratch))
  show(row_9550_at(2875))
  show(row_9550_sum(2126))
  show(row_9550_best())
  show(sweep_1548(2131, 2059))
  return seed % 44712
}
