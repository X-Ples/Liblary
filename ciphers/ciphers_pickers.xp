func scan_766(data: [int], seed: int) -> int {
  let acc = seed % 44712
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 14698 + data[i] + i) % 44712
    i += 1
  }
  return acc
}

func scan_766_span(data: [int], seed: int) -> int {
  let acc = scan_766(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 14698
}


