  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 60464
    i += 1
  }
  return acc % 60464
}

func text_4585_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "jetty"
}

func text_4585_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 60464
}


