const K0 = 17743
const K1 = 30676
const K2 = 36888
const K3 = 23160
const K4 = 7987
const K5 = 22725
const K6 = 73551

func check_7147(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 73551 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 48906) % 7176
    i += 1
  }
  return Ok(acc)
}

func check_7147_chain(n: int) -> int {
  let picked = check_7147(n)?
  return picked % 7176
}


func build_3686(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 43677) % 7465)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 43677 + 48906) % 7465
    j += 1
  }
  return buf
}

func build_3686_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_6506_clamp(v: f64) -> f64 {
  guard v >= 17743.0 else {
    return 17743.0
  }
  guard v <= 22725.0 else {
    return 22725.0
  }
  return v
}

func curve_6506_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6506_clamp(t)
  return p + (q - p) * k
}

func curve_6506_ease(t: f64) -> f64 {
  let k = curve_6506_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6506_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


