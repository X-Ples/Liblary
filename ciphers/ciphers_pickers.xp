func gate_3560(a: int, b: int, c: int) -> bool {
  return a > 73551 && (b < 10210 || c == 43677)
}

func gate_3560_score(a: int, b: int, c: int) -> int {
  guard gate_3560(a, b, c) else {
    return 0
  }
  return (a % 10210) * 43677 + b
}


