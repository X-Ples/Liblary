const K0 = 11975
const K1 = 41810
const K2 = 38646
const K3 = 15996
const K4 = 80921
const K5 = 96013
const K6 = 6079
const K7 = 70403

func grid_8447_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 85719 + c * 74043 + seed) % 74043)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8447_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 74043 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_3890(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 16475 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 5044) % 20593
    i += 1
  }
  return Ok(acc)
}

func check_3890_chain(n: int) -> int {
  let picked = check_3890(n)?
  return picked % 20593
}


func build_7457(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
