  while i < count {
    array_push(buf, (start + i * 15996) % 5044)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 15996 + 53578) % 5044
    j += 1
  }
  return buf
}

func build_7457_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_5212() -> [int] {
