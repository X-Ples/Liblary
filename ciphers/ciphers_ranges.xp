func text_4075_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "jetty"
}

func text_4075_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 70403
}


