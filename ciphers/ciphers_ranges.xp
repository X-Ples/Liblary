func demo_ranges(seed: int) -> int {
  let scratch = build_7457(seed % 61 + 6, seed % 38646)
  show(len(scratch))
  show(grid_8447_rowsum(scratch, 633, 880, 2804))
  show(check_3890_chain(1911))
  show(build_7457_last(scratch))
  show(row_5212_at(1431))
  return seed % 23733
}
