func row_3716() -> [int] {
  return [2598, 3597, 3990, 303, 1230, 284, 344, 2414, 3007, 1707, 479, 3578]
}

func row_3716_at(i: int) -> int {
  let row = row_3716()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3716_sum(limit: int) -> int {
  let row = row_3716()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3716_best() -> int {
  let row = row_3716()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


