func gate_8399(a: int, b: int, c: int) -> bool {
  return a > 72973 && (b < 58021 || c == 97604)
}

func gate_8399_score(a: int, b: int, c: int) -> int {
  guard gate_8399(a, b, c) else {
    return 0
  }
  return (a % 58021) * 97604 + b
}


func grid_750_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 43979 + c * 90374 + seed) % 90374)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_750_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 90374 == want {
      total += acc
    }
    r += 1
  }
  return total
}


