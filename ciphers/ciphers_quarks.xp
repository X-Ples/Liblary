    buf[j] = (buf[j] * 62497 + 58021) % 5587
    j += 1
  }
  return buf
}

func build_4103_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_1480(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 67285 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 90374) % 22239
    i += 1
  }
  return Ok(acc)
}

func check_1480_chain(n: int) -> int {
  let picked = check_1480(n)?
  return picked % 22239
}


