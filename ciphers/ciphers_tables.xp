func demo_tables(seed: int) -> int {
  let scratch = build_880(seed % 61 + 6, seed % 55103)
  show(len(scratch))
  show(grid_8055_rowsum(scratch, 3679, 2315, 2512))
  show(grid_5998_rowsum(scratch, 3041, 2605, 2848))
  show(build_880_last(scratch))
  return seed % 77829
}
