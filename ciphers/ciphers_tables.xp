func gate_7380(a: int, b: int, c: int) -> bool {
  return a > 58831 && (b < 9064 || c == 92963)
}

func gate_7380_score(a: int, b: int, c: int) -> int {
  guard gate_7380(a, b, c) else {
    return 0
  }
  return (a % 9064) * 92963 + b
}


func order_1266(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1266_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func row_4087() -> [int] {
  return [1200, 1062, 2182, 3702, 944, 476, 2514, 2908, 3008, 3582, 2694, 1026, 2038, 3526, 707]
}

func row_4087_at(i: int) -> int {
  let row = row_4087()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4087_sum(limit: int) -> int {
  let row = row_4087()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4087_best() -> int {
  let row = row_4087()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


