func build_880(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 21150) % 51493)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 21150 + 51419) % 51493
    j += 1
  }
  return buf
}

func build_880_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_9086(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 3101 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 3101) % 51493
    i += 1
  }
  return Ok(acc)
}

func check_9086_chain(n: int) -> int {
  let picked = check_9086(n)?
  return picked % 51493
}


