func sweep_3764(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 75022
  for i in lo..hi {
    if i % 21150 == 0 {
      acc += i * 12934
    } else {
      acc -= i % 3347
    }
    if acc < 0 {
      acc += 12934
    }
    acc = acc % 12934
  }
  return acc
}


func text_4021_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 55103
    i += 1
  }
  return acc % 55103
}

func text_4021_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "ember"
}

func text_4021_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 77892
}


