func check_4323(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 99065 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 90694) % 91097
    i += 1
  }
  return Ok(acc)
}

func check_4323_chain(n: int) -> int {
  let picked = check_4323(n)?
  return picked % 91097
}


