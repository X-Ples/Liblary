func grid_1302_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 56724 + c * 53970 + seed) % 53970)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1302_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 53970 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_9879(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 99065) % 57011)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 99065 + 50244) % 57011
    j += 1
  }
  return buf
}

func build_9879_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_538() -> [int] {
  return [3321, 733, 3230, 1419, 2919, 2121, 408, 1980, 829, 840, 1716, 123]
}

func row_538_at(i: int) -> int {
  let row = row_538()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_538_sum(limit: int) -> int {
  let row = row_538()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_538_best() -> int {
  let row = row_538()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_7030(a: int, b: int, c: int) -> bool {
  return a > 79221 && (b < 72152 || c == 71532)
}

func gate_7030_score(a: int, b: int, c: int) -> int {
  guard gate_7030(a, b, c) else {
    return 0
  }
  return (a % 72152) * 71532 + b
}


func scan_6649(data: [int], seed: int) -> int {
  let acc = seed % 44595
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 68830 + data[i] + i) % 44595
    i += 1
  }
  return acc
}

func scan_6649_span(data: [int], seed: int) -> int {
  let acc = scan_6649(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 68830
}


func order_571(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_571_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


