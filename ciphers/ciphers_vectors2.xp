func sweep_7212(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 99274
  for i in lo..hi {
    if i % 72152 == 0 {
      acc += i * 79221
    } else {
      acc -= i % 99065
    }
    if acc < 0 {
      acc += 40045
    }
    acc = acc % 40045
  }
  return acc
}


