func build_9459(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 39266) % 24231)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 39266 + 53914) % 24231
    j += 1
  }
  return buf
}

func build_9459_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_6213_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 53595
    i += 1
  }
  return acc % 53595
}

func text_6213_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "cargo"
}

func text_6213_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 19661
}


