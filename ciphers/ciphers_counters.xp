  }
  return acc % 39266
}


func sweep_5735(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10631
  for i in lo..hi {
    if i % 67947 == 0 {
      acc += i * 58756
    } else {
      acc -= i % 31909
    }
    if acc < 0 {
      acc += 85254
    }
    acc = acc % 85254
  }
