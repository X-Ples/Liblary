}


func check_3270(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 30804 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 29477) % 9548
    i += 1
  }
  return Ok(acc)
}

func check_3270_chain(n: int) -> int {
  let picked = check_3270(n)?
  return picked % 9548
}


func sweep_1161(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 35915
  for i in lo..hi {
    if i % 30804 == 0 {
      acc += i * 47946
    } else {
      acc -= i % 20466
    }
    if acc < 0 {
      acc += 18328
    }
    acc = acc % 18328
  }
  return acc
}


