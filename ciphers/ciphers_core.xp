func text_3351_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 10814
    i += 1
  }
  return acc % 10814
}

func text_3351_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "alpha"
}

func text_3351_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 18328
}


