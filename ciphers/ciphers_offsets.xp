func text_7133_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "harbor"
}

func text_7133_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 39480
}


