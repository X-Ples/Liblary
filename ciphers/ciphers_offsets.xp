func demo_offsets(seed: int) -> int {
  let scratch = build_7903(seed % 61 + 6, seed % 54859)
  show(len(scratch))
  show(build_7903_last(scratch))
  show(row_1959_at(602))
  show(row_1959_sum(3625))
  show(row_1959_best())
  show(sweep_2190(2688, 2081))
  show(gate_9993(2258, 3118, 1172))
  return seed % 37371
}
