func curve_1353_clamp(v: f64) -> f64 {
  guard v >= 1065.0 else {
    return 1065.0
  }
  guard v <= 95937.0 else {
    return 95937.0
  }
  return v
}

func curve_1353_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1353_clamp(t)
  return p + (q - p) * k
}

func curve_1353_ease(t: f64) -> f64 {
  let k = curve_1353_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1353_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_7903(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 36635) % 787)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 36635 + 55941) % 787
    j += 1
  }
  return buf
}

func build_7903_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_1959() -> [int] {
  return [2730, 2875, 3169, 3516, 311, 2980, 2925, 2785, 929, 2789, 2150, 2316, 1394, 3299, 2795]
}

func row_1959_at(i: int) -> int {
  let row = row_1959()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1959_sum(limit: int) -> int {
  let row = row_1959()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1959_best() -> int {
  let row = row_1959()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_2190(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 62007
  for i in lo..hi {
    if i % 85562 == 0 {
      acc += i * 36635
    } else {
      acc -= i % 73385
    }
    if acc < 0 {
      acc += 39480
    }
    acc = acc % 39480
  }
  return acc
}


func gate_9993(a: int, b: int, c: int) -> bool {
  return a > 85562 && (b < 1065 || c == 44044)
}

func gate_9993_score(a: int, b: int, c: int) -> int {
  guard gate_9993(a, b, c) else {
    return 0
  }
  return (a % 1065) * 44044 + b
}


func scan_7737(data: [int], seed: int) -> int {
  let acc = seed % 62157
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 7642 + data[i] + i) % 62157
    i += 1
  }
  return acc
}

func scan_7737_span(data: [int], seed: int) -> int {
  let acc = scan_7737(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 7642
}


