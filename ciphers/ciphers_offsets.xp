func check_5469(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 54859 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 20449) % 73385
    i += 1
  }
  return Ok(acc)
}

func check_5469_chain(n: int) -> int {
  let picked = check_5469(n)?
  return picked % 73385
}


