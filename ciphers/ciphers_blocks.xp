func scan_5548(data: [int], seed: int) -> int {
  let acc = seed % 73008
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 5547 + data[i] + i) % 73008
    i += 1
  }
  return acc
}

func scan_5548_span(data: [int], seed: int) -> int {
  let acc = scan_5548(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 5547
}


func row_2481() -> [int] {
  return [2101, 501, 2626, 3616, 357, 250, 1329, 1965, 428, 2264, 3241, 55, 4038, 1273, 425, 3730, 3203, 1553, 1300, 2362, 1630]
}

func row_2481_at(i: int) -> int {
  let row = row_2481()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2481_sum(limit: int) -> int {
  let row = row_2481()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2481_best() -> int {
  let row = row_2481()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_4938(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 322) % 5656)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 322 + 39005) % 5656
    j += 1
  }
  return buf
}

func build_4938_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_8212(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8212_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


