}

func text_3444_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "talus"
}

func text_3444_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 322
}


