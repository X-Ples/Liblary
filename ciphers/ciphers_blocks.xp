func demo_blocks(seed: int) -> int {
  let scratch = build_4938(seed % 61 + 6, seed % 5656)
  show(len(scratch))
  show(scan_5548(scratch, 875))
  show(scan_5548_span(scratch, 2034))
  show(row_2481_at(828))
  return seed % 75987
}
