func sweep_8826(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10829
  for i in lo..hi {
    if i % 43717 == 0 {
      acc += i * 39005
    } else {
      acc -= i % 1056
    }
    if acc < 0 {
      acc += 30064
    }
    acc = acc % 30064
  }
  return acc
}


func grid_3258_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 5547 + c * 28080 + seed) % 28080)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3258_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 28080 == want {
      total += acc
    }
    r += 1
  }
  return total
}


