func check_8503(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 80396 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 31087) % 1616
    i += 1
  }
  return Ok(acc)
}

func check_8503_chain(n: int) -> int {
  let picked = check_8503(n)?
  return picked % 1616
}


