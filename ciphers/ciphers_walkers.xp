func sweep_1739(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 36146
  for i in lo..hi {
    if i % 4791 == 0 {
      acc += i * 4428
    } else {
      acc -= i % 4428
    }
    if acc < 0 {
      acc += 53602
    }
    acc = acc % 53602
  }
  return acc
}


func build_8708(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 4428) % 92901)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 4428 + 34930) % 92901
    j += 1
  }
  return buf
}

func build_8708_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_3663(a: int, b: int, c: int) -> bool {
  return a > 80656 && (b < 69422 || c == 33535)
}

func gate_3663_score(a: int, b: int, c: int) -> int {
  guard gate_3663(a, b, c) else {
    return 0
  }
  return (a % 69422) * 33535 + b
}


func check_5488(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 36146 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 36146) % 4791
    i += 1
  }
  return Ok(acc)
}

func check_5488_chain(n: int) -> int {
  let picked = check_5488(n)?
  return picked % 4791
}


func scan_9468(data: [int], seed: int) -> int {
  let acc = seed % 4791
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 4954 + data[i] + i) % 4791
    i += 1
  }
  return acc
}

func scan_9468_span(data: [int], seed: int) -> int {
  let acc = scan_9468(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 4954
}


func order_4850(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4850_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


