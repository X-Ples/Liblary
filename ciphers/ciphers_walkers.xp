func demo_walkers(seed: int) -> int {
  let scratch = build_8708(seed % 61 + 6, seed % 33314)
  show(len(scratch))
  show(sweep_1739(2750, 3906))
  show(build_8708_last(scratch))
  show(gate_3663(2045, 936, 2000))
  show(gate_3663_score(1438, 2724, 3252))
  show(check_5488_chain(3113))
  return seed % 57254
}
