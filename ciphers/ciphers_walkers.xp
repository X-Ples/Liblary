func text_4341_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "bravo"
}

func text_4341_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 53602
}


