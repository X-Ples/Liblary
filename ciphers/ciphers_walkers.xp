func row_7235() -> [int] {
  return [3713, 1865, 3863, 3743, 971, 1080, 647, 1643, 1333, 3623, 1220, 778, 2751, 1712, 4075, 2976, 4086, 751]
}

func row_7235_at(i: int) -> int {
  let row = row_7235()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7235_sum(limit: int) -> int {
  let row = row_7235()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7235_best() -> int {
  let row = row_7235()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_4341_weight(tag: str) -> int {
