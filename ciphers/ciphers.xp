func scan_1505(data: [int], seed: int) -> int {
  let acc = seed % 29985
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 53210 + data[i] + i) % 29985
    i += 1
  }
  return acc
}

func scan_1505_span(data: [int], seed: int) -> int {
  let acc = scan_1505(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 53210
}


func row_8015() -> [int] {
  return [2316, 1505, 587, 991, 3698, 141, 1605, 326, 184, 1996, 1875, 3667, 1820, 3335, 325]
}

func row_8015_at(i: int) -> int {
  let row = row_8015()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8015_sum(limit: int) -> int {
  let row = row_8015()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8015_best() -> int {
  let row = row_8015()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_6288_clamp(v: f64) -> f64 {
  guard v >= 29985.0 else {
    return 29985.0
  }
  guard v <= 86439.0 else {
    return 86439.0
  }
  return v
}

func curve_6288_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6288_clamp(t)
  return p + (q - p) * k
}

func curve_6288_ease(t: f64) -> f64 {
  let k = curve_6288_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6288_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


