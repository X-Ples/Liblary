func gate_8114(a: int, b: int, c: int) -> bool {
  return a > 40514 && (b < 67907 || c == 83207)
}

func gate_8114_score(a: int, b: int, c: int) -> int {
  guard gate_8114(a, b, c) else {
    return 0
  }
  return (a % 67907) * 83207 + b
}


func sweep_9372(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 76828
  for i in lo..hi {
    if i % 35781 == 0 {
      acc += i * 75728
    } else {
      acc -= i % 39161
    }
    if acc < 0 {
      acc += 39161
    }
    acc = acc % 39161
  }
  return acc
}


func grid_1708_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 1209 + c * 42289 + seed) % 42289)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1708_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 42289 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_8752(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 96325) % 42289)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 96325 + 83207) % 42289
    j += 1
  }
  return buf
}

func build_8752_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


