func check_3742(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 40321 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 58177) % 328
    i += 1
  }
  return Ok(acc)
}

func check_3742_chain(n: int) -> int {
  let picked = check_3742(n)?
  return picked % 328
}


