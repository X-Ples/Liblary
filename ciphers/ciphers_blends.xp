func demo_blends(seed: int) -> int {
  let scratch = build_6834(seed % 61 + 6, seed % 95561)
  show(len(scratch))
  show(scan_4341(scratch, 2576))
  show(scan_4341_span(scratch, 971))
  show(row_3263_at(2441))
  show(row_3263_sum(3748))
  show(row_3263_best())
  show(build_6834_last(scratch))
  return seed % 6410
}
