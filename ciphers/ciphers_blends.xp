func grid_1801_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 84599 + c * 37175 + seed) % 37175)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1801_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 37175 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_8226(a: int, b: int, c: int) -> bool {
  return a > 87050 && (b < 39011 || c == 46745)
}

func gate_8226_score(a: int, b: int, c: int) -> int {
  guard gate_8226(a, b, c) else {
    return 0
  }
  return (a % 39011) * 46745 + b
}


