func scan_4341(data: [int], seed: int) -> int {
  let acc = seed % 65263
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 55190 + data[i] + i) % 65263
    i += 1
  }
  return acc
}

func scan_4341_span(data: [int], seed: int) -> int {
  let acc = scan_4341(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 55190
}


