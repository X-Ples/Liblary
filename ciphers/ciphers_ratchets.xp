func curve_2173_clamp(v: f64) -> f64 {
  guard v >= 11678.0 else {
    return 11678.0
  }
  guard v <= 83606.0 else {
    return 83606.0
  }
  return v
}

func curve_2173_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2173_clamp(t)
  return p + (q - p) * k
}

func curve_2173_ease(t: f64) -> f64 {
  let k = curve_2173_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2173_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_990(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 91918) % 84038)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 91918 + 60123) % 84038
    j += 1
  }
  return buf
}

func build_990_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_119(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 62970 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 52494) % 70325
    i += 1
  }
  return Ok(acc)
}

func check_119_chain(n: int) -> int {
  let picked = check_119(n)?
  return picked % 70325
}


func grid_5976_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 75348 + c * 75348 + seed) % 75348)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5976_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 75348 == want {
      total += acc
    }
    r += 1
  }
  return total
}


