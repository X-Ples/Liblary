func text_628_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 52494
    i += 1
  }
  return acc % 52494
}

func text_628_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "nova"
}

func text_628_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 17325
}


