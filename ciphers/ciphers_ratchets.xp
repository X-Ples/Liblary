func demo_ratchets(seed: int) -> int {
  let scratch = build_990(seed % 61 + 6, seed % 94368)
  show(len(scratch))
  show(build_990_last(scratch))
  show(check_119_chain(3606))
  show(grid_5976_rowsum(scratch, 2208, 1891, 2642))
  show(build_2348_last(scratch))
  show(grid_4206_rowsum(scratch, 936, 2452, 3036))
  return seed % 25633
}
