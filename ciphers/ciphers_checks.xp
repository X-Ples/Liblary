func row_3400() -> [int] {
  return [3859, 4018, 1137, 3845, 962, 1744, 2263, 3225, 1483, 2508, 1417, 2467, 537, 2881, 3059, 1665]
}

func row_3400_at(i: int) -> int {
  let row = row_3400()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3400_sum(limit: int) -> int {
  let row = row_3400()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3400_best() -> int {
  let row = row_3400()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


