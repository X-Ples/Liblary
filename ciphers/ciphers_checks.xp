func scan_3560(data: [int], seed: int) -> int {
  let acc = seed % 64326
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 5906 + data[i] + i) % 64326
    i += 1
  }
  return acc
}

func scan_3560_span(data: [int], seed: int) -> int {
  let acc = scan_3560(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 5906
}


func text_387_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 1283
    i += 1
  }
  return acc % 1283
}

func text_387_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "quartz"
}

func text_387_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 60993
}


func check_2735(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 9103 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 18614) % 10302
    i += 1
  }
  return Ok(acc)
}

func check_2735_chain(n: int) -> int {
  let picked = check_2735(n)?
  return picked % 10302
}


