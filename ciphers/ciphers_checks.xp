    let c = 0
    while c < cols {
      array_push(cells, (r * 5906 + c * 31973 + seed) % 31973)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9445_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
