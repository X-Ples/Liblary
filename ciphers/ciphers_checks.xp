func sweep_8119(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 74144
  for i in lo..hi {
    if i % 5373 == 0 {
      acc += i * 75856
    } else {
      acc -= i % 37993
    }
    if acc < 0 {
      acc += 80506
    }
    acc = acc % 80506
  }
  return acc
}


