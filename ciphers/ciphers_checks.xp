func demo_checks(seed: int) -> int {
  let scratch = build_3989(seed % 61 + 6, seed % 44160)
  show(len(scratch))
  show(scan_3560(scratch, 1131))
  show(scan_3560_span(scratch, 587))
  show(text_387_weight("nova"))
  show(text_387_label(3480))
  show(text_387_has("harbor"))
  return seed % 60993
}
