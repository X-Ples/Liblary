func build_8241(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 65121) % 93034)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 65121 + 69578) % 93034
    j += 1
  }
  return buf
}

func build_8241_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_1166_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 13521 + c * 2364 + seed) % 2364)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1166_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 2364 == want {
      total += acc
    }
    r += 1
  }
  return total
}


