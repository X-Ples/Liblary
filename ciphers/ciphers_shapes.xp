func demo_shapes(seed: int) -> int {
  let scratch = build_8241(seed % 61 + 6, seed % 86845)
  show(len(scratch))
  show(build_8241_last(scratch))
  show(grid_1166_rowsum(scratch, 2375, 2384, 283))
  show(grid_7029_rowsum(scratch, 448, 778, 3994))
  show(build_3569_last(scratch))
  return seed % 4292
}
