func text_7613_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "mesa"
}

func text_7613_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 17640
}


