func demo_helpers(seed: int) -> int {
  let scratch = build_7901(seed % 61 + 6, seed % 42538)
  show(len(scratch))
  show(build_7901_last(scratch))
  show(grid_1095_rowsum(scratch, 162, 3389, 1328))
  show(check_5270_chain(171))
  show(row_6743_at(383))
  show(row_6743_sum(2254))
  return seed % 71792
}
