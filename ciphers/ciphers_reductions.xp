func scan_7732(data: [int], seed: int) -> int {
  let acc = seed % 28114
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 66435 + data[i] + i) % 28114
    i += 1
  }
  return acc
}

func scan_7732_span(data: [int], seed: int) -> int {
  let acc = scan_7732(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 66435
}


