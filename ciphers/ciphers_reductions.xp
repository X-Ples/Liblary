func row_1563() -> [int] {
  return [3332, 2924, 1660, 361, 3177, 650, 2137, 1544, 3216, 4056, 907, 1609]
}

func row_1563_at(i: int) -> int {
  let row = row_1563()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1563_sum(limit: int) -> int {
  let row = row_1563()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1563_best() -> int {
  let row = row_1563()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


