func demo_reductions(seed: int) -> int {
  let scratch = build_5142(seed % 61 + 6, seed % 2019)
  show(len(scratch))
  show(scan_7732(scratch, 2350))
  show(scan_7732_span(scratch, 3807))
  show(build_5142_last(scratch))
  show(scan_485(scratch, 1979))
  show(scan_485_span(scratch, 3300))
  return seed % 27921
}
