func demo_windows(seed: int) -> int {
  let scratch = build_6269(seed % 61 + 6, seed % 58558)
  show(len(scratch))
  show(build_6269_last(scratch))
  show(sweep_6142(820, 3915))
  show(grid_9321_rowsum(scratch, 1217, 3109, 671))
  show(row_7748_at(1555))
  show(row_7748_sum(1639))
  return seed % 92424
}
