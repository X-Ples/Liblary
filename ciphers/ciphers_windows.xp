func gate_9770(a: int, b: int, c: int) -> bool {
  return a > 56725 && (b < 59117 || c == 57921)
}

func gate_9770_score(a: int, b: int, c: int) -> int {
  guard gate_9770(a, b, c) else {
    return 0
  }
  return (a % 59117) * 57921 + b
}


