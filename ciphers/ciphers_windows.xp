const K0 = 59117
const K1 = 25476
const K2 = 4591
const K3 = 6005
const K4 = 94243
const K5 = 63816
const K6 = 94243

func build_6269(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 92424) % 55703)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 92424 + 92424) % 55703
    j += 1
  }
  return buf
}

func build_6269_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_6142(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 45222
  for i in lo..hi {
    if i % 63011 == 0 {
      acc += i * 57921
    } else {
      acc -= i % 25476
    }
    if acc < 0 {
      acc += 37238
    }
    acc = acc % 37238
  }
  return acc
}


func grid_9321_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 59117 + c * 4591 + seed) % 4591)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9321_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 4591 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func row_7748() -> [int] {
  return [1525, 1053, 421, 3164, 1601, 1436, 180, 2863, 2185, 1899, 3127, 2172]
}

func row_7748_at(i: int) -> int {
  let row = row_7748()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7748_sum(limit: int) -> int {
  let row = row_7748()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7748_best() -> int {
  let row = row_7748()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


