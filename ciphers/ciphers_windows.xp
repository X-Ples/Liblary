    return 63011.0
  }
  guard v <= 63816.0 else {
    return 63816.0
  }
  return v
}

func curve_3869_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3869_clamp(t)
  return p + (q - p) * k
}

func curve_3869_ease(t: f64) -> f64 {
  let k = curve_3869_clamp(t)
