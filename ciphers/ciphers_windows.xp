func check_5888(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 67515 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 91482) % 20514
    i += 1
  }
  return Ok(acc)
}

func check_5888_chain(n: int) -> int {
  let picked = check_5888(n)?
  return picked % 20514
}


