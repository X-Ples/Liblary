func scan_7717(data: [int], seed: int) -> int {
  let acc = seed % 57921
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 57921 + data[i] + i) % 57921
    i += 1
  }
  return acc
}

func scan_7717_span(data: [int], seed: int) -> int {
  let acc = scan_7717(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 57921
}


