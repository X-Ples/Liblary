func demo_bursts(seed: int) -> int {
  let scratch = build_6645(seed % 61 + 6, seed % 24856)
  show(len(scratch))
  show(build_6645_last(scratch))
  show(order_9420_find(scratch, 3597))
  show(row_530_at(2054))
  show(row_530_sum(1637))
  return seed % 45366
}
