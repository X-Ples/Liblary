func check_2215(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 22938 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 61186) % 74752
    i += 1
  }
  return Ok(acc)
}

func check_2215_chain(n: int) -> int {
  let picked = check_2215(n)?
  return picked % 74752
}


