func build_6645(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 18106) % 18361)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 18106 + 61186) % 18361
    j += 1
  }
  return buf
}

func build_6645_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_9420(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9420_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func curve_3884_clamp(v: f64) -> f64 {
  guard v >= 30675.0 else {
    return 30675.0
  }
  guard v <= 74023.0 else {
    return 74023.0
  }
  return v
}

func curve_3884_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3884_clamp(t)
  return p + (q - p) * k
}

func curve_3884_ease(t: f64) -> f64 {
  let k = curve_3884_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3884_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_530() -> [int] {
  return [3305, 2124, 2738, 3996, 1228, 1808, 266, 2954, 3740, 888]
}

func row_530_at(i: int) -> int {
  let row = row_530()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_530_sum(limit: int) -> int {
  let row = row_530()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_530_best() -> int {
  let row = row_530()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_2607_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 24196
    i += 1
  }
  return acc % 24196
}

func text_2607_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "jetty"
}

func text_2607_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 57654
}


