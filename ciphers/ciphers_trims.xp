}


func row_7315() -> [int] {
  return [4061, 218, 3794, 1336, 3797, 944, 851, 2, 2146, 2121, 1009, 294, 599, 4038]
}

func row_7315_at(i: int) -> int {
  let row = row_7315()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7315_sum(limit: int) -> int {
  let row = row_7315()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7315_best() -> int {
  let row = row_7315()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


