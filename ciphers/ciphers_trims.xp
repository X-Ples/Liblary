func build_8592(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 41449) % 4578)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 41449 + 14277) % 4578
    j += 1
  }
  return buf
}

func build_8592_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_6879(n: int) -> Result<int, str> {
