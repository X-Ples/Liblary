func build_177(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 54424) % 54424)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 54424 + 64240) % 54424
    j += 1
  }
  return buf
}

func build_177_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_8215(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 70748 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 34666) % 13484
    i += 1
  }
  return Ok(acc)
}

func check_8215_chain(n: int) -> int {
  let picked = check_8215(n)?
  return picked % 13484
}


func row_7447() -> [int] {
  return [2269, 2926, 2536, 3643, 624, 1230, 2279, 2081, 2239, 265, 1138, 239, 408, 2258, 549, 137]
}

func row_7447_at(i: int) -> int {
  let row = row_7447()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7447_sum(limit: int) -> int {
  let row = row_7447()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7447_best() -> int {
  let row = row_7447()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


