func scan_6481(data: [int], seed: int) -> int {
  let acc = seed % 75174
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 47330 + data[i] + i) % 75174
    i += 1
  }
  return acc
}

func scan_6481_span(data: [int], seed: int) -> int {
  let acc = scan_6481(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 47330
}


