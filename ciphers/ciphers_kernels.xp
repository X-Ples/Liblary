func demo_kernels(seed: int) -> int {
  let scratch = build_3513(seed % 61 + 6, seed % 75174)
  show(len(scratch))
  show(order_4464_find(scratch, 1879))
  show(build_3513_last(scratch))
  show(order_8310_find(scratch, 2553))
  show(scan_6481(scratch, 2054))
  show(scan_6481_span(scratch, 1905))
  return seed % 59843
}
