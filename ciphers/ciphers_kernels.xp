func grid_2177_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 53575 + c * 36925 + seed) % 36925)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2177_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 36925 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_6599(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 27767
  for i in lo..hi {
    if i % 90356 == 0 {
      acc += i * 37476
    } else {
      acc -= i % 71192
    }
    if acc < 0 {
      acc += 24421
    }
    acc = acc % 24421
  }
  return acc
}


