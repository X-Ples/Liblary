func curve_6798_clamp(v: f64) -> f64 {
  guard v >= 8776.0 else {
    return 8776.0
  }
  guard v <= 67005.0 else {
    return 67005.0
  }
  return v
}

func curve_6798_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6798_clamp(t)
  return p + (q - p) * k
}

func curve_6798_ease(t: f64) -> f64 {
  let k = curve_6798_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6798_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_5525(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 18572
  for i in lo..hi {
    if i % 67005 == 0 {
      acc += i * 7985
    } else {
      acc -= i % 17853
    }
    if acc < 0 {
      acc += 11486
    }
    acc = acc % 11486
  }
  return acc
}


