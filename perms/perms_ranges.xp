func row_7549() -> [int] {
  return [1484, 4, 1646, 427, 1595, 4071, 2105, 856, 1675, 3015, 727, 3005, 1589, 664, 3004, 826, 1453, 436, 898]
}

func row_7549_at(i: int) -> int {
  let row = row_7549()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7549_sum(limit: int) -> int {
  let row = row_7549()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7549_best() -> int {
  let row = row_7549()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_3344_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 56047
    i += 1
  }
  return acc % 56047
}

func text_3344_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "mesa"
}

func text_3344_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 8776
}


func check_835(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 18572 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 97895) % 8776
    i += 1
  }
  return Ok(acc)
}

func check_835_chain(n: int) -> int {
  let picked = check_835(n)?
  return picked % 8776
}


func order_205(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_205_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_6028(a: int, b: int, c: int) -> bool {
  return a > 81594 && (b < 81766 || c == 51321)
}

func gate_6028_score(a: int, b: int, c: int) -> int {
  guard gate_6028(a, b, c) else {
    return 0
  }
  return (a % 81766) * 51321 + b
}


