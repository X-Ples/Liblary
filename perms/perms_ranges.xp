func scan_2177(data: [int], seed: int) -> int {
  let acc = seed % 8776
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 23230 + data[i] + i) % 8776
    i += 1
  }
  return acc
}

func scan_2177_span(data: [int], seed: int) -> int {
  let acc = scan_2177(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 23230
}


