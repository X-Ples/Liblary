func sweep_4448(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 11903
  for i in lo..hi {
    if i % 96122 == 0 {
      acc += i * 17278
    } else {
      acc -= i % 28568
    }
    if acc < 0 {
      acc += 56922
    }
    acc = acc % 56922
  }
  return acc
}


func scan_4737(data: [int], seed: int) -> int {
  let acc = seed % 17278
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 84902 + data[i] + i) % 17278
    i += 1
  }
  return acc
}

func scan_4737_span(data: [int], seed: int) -> int {
  let acc = scan_4737(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 84902
}


