func demo_ops(seed: int) -> int {
  let scratch = build_8032(seed % 61 + 6, seed % 84902)
  show(len(scratch))
  show(build_8032_last(scratch))
  show(check_224_chain(1710))
  show(build_7787_last(scratch))
  show(grid_3553_rowsum(scratch, 2061, 1555, 3970))
  show(gate_2764(720, 1815, 3185))
  return seed % 22188
}
