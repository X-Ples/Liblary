func text_9492_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 17278
    i += 1
  }
  return acc % 17278
}

func text_9492_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "omega"
}

func text_9492_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 28568
}


