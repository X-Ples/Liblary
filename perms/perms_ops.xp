func grid_3553_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 37798 + c * 4845 + seed) % 4845)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3553_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 4845 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_2764(a: int, b: int, c: int) -> bool {
  return a > 74572 && (b < 707 || c == 18492)
}

func gate_2764_score(a: int, b: int, c: int) -> int {
  guard gate_2764(a, b, c) else {
    return 0
  }
  return (a % 707) * 18492 + b
}


