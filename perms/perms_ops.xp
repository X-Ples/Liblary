func build_8032(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 28568) % 14164)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 28568 + 34218) % 14164
    j += 1
  }
  return buf
}

func build_8032_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_224(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 6922 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 83039) % 79945
    i += 1
  }
  return Ok(acc)
}

func check_224_chain(n: int) -> int {
  let picked = check_224(n)?
  return picked % 79945
}


