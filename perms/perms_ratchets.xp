func check_5127(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 33959 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 11838) % 9784
    i += 1
  }
  return Ok(acc)
}

func check_5127_chain(n: int) -> int {
  let picked = check_5127(n)?
  return picked % 9784
}


