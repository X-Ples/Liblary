}

func row_6068_at(i: int) -> int {
  let row = row_6068()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6068_sum(limit: int) -> int {
  let row = row_6068()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6068_best() -> int {
  let row = row_6068()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_212(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 45693) % 26703)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 45693 + 36956) % 26703
    j += 1
  }
  return buf
}

func build_212_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_112_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 80145 + c * 69861 + seed) % 69861)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_112_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 69861 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_2052(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 40249
  for i in lo..hi {
    if i % 15153 == 0 {
      acc += i * 34630
    } else {
      acc -= i % 33959
    }
    if acc < 0 {
      acc += 69861
    }
    acc = acc % 69861
  }
  return acc
}


