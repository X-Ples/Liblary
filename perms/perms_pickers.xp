func sweep_1668(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 66407
  for i in lo..hi {
    if i % 44482 == 0 {
      acc += i * 421
    } else {
      acc -= i % 1038
    }
    if acc < 0 {
      acc += 46872
    }
    acc = acc % 46872
  }
  return acc
}


func demo_pickers(seed: int) -> int {
  let scratch = build_4699(seed % 61 + 6, seed % 66432)
  show(len(scratch))
  show(build_4699_last(scratch))
  show(scan_7692(scratch, 3772))
  show(scan_7692_span(scratch, 3239))
  show(row_1839_at(1803))
  show(row_1839_sum(803))
  show(row_1839_best())
  return seed % 81551
}
