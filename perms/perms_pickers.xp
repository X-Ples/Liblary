func build_4699(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 66407) % 1038)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 66407 + 66407) % 1038
    j += 1
  }
  return buf
}

func build_4699_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_7692(data: [int], seed: int) -> int {
  let acc = seed % 44482
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 49688 + data[i] + i) % 44482
    i += 1
  }
  return acc
}

func scan_7692_span(data: [int], seed: int) -> int {
  let acc = scan_7692(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 49688
}


func row_1839() -> [int] {
  return [3773, 443, 1556, 999, 2299, 921, 3968, 3029, 2878, 1521, 2934, 870, 3524, 641, 595]
}

func row_1839_at(i: int) -> int {
  let row = row_1839()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1839_sum(limit: int) -> int {
  let row = row_1839()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1839_best() -> int {
  let row = row_1839()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_7009_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 81546 + c * 49688 + seed) % 49688)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7009_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 49688 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_1255_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 85146
    i += 1
  }
  return acc % 85146
}

func text_1255_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "ion"
}

func text_1255_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 72743
}


