func sweep_3861(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 85483
  for i in lo..hi {
    if i % 82378 == 0 {
      acc += i * 65043
    } else {
      acc -= i % 35574
    }
    if acc < 0 {
      acc += 3558
    }
    acc = acc % 3558
  }
  return acc
}


func gate_2589(a: int, b: int, c: int) -> bool {
  return a > 91977 && (b < 59265 || c == 52241)
}

func gate_2589_score(a: int, b: int, c: int) -> int {
  guard gate_2589(a, b, c) else {
    return 0
  }
  return (a % 59265) * 52241 + b
}


func build_980(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 52241) % 41584)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 52241 + 54703) % 41584
    j += 1
  }
  return buf
}

func build_980_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_1428_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 89674 + c * 34170 + seed) % 34170)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1428_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 34170 == want {
      total += acc
    }
    r += 1
  }
  return total
}


