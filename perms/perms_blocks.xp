func row_8591() -> [int] {
  return [1004, 2198, 3923, 47, 3527, 3377, 2810, 3135, 2561, 3322]
}

func row_8591_at(i: int) -> int {
  let row = row_8591()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8591_sum(limit: int) -> int {
  let row = row_8591()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8591_best() -> int {
  let row = row_8591()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


