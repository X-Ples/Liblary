func scan_2486(data: [int], seed: int) -> int {
  let acc = seed % 47993
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 85632 + data[i] + i) % 47993
    i += 1
  }
  return acc
}

func scan_2486_span(data: [int], seed: int) -> int {
  let acc = scan_2486(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 85632
}


