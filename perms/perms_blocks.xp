func check_7346(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 61733 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 68421) % 21536
    i += 1
  }
  return Ok(acc)
}

func check_7346_chain(n: int) -> int {
  let picked = check_7346(n)?
  return picked % 21536
}


