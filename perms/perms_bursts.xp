const K0 = 45034
const K1 = 52657
const K2 = 17219
const K3 = 84890
const K4 = 41188
const K5 = 26256

func build_7036(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 45034) % 17219)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 45034 + 89535) % 17219
    j += 1
  }
  return buf
}

func build_7036_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_8960() -> [int] {
  return [16, 1447, 3247, 2773, 988, 201, 2414, 838, 2501, 4070, 3726]
}

func row_8960_at(i: int) -> int {
  let row = row_8960()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8960_sum(limit: int) -> int {
  let row = row_8960()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8960_best() -> int {
  let row = row_8960()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_3278(data: [int], seed: int) -> int {
  let acc = seed % 89535
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 44448 + data[i] + i) % 89535
    i += 1
  }
  return acc
}

func scan_3278_span(data: [int], seed: int) -> int {
  let acc = scan_3278(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 44448
}


func check_5054(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 14330 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 41188) % 69689
    i += 1
  }
  return Ok(acc)
}

func check_5054_chain(n: int) -> int {
  let picked = check_5054(n)?
  return picked % 69689
}


