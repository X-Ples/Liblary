func demo_walkers(seed: int) -> int {
  let scratch = build_4118(seed % 61 + 6, seed % 16428)
  show(len(scratch))
  show(build_4118_last(scratch))
  show(check_6191_chain(2722))
  show(text_1570_weight("nova"))
  show(text_1570_label(973))
  return seed % 12441
}
