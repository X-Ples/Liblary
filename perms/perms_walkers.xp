func gate_1466(a: int, b: int, c: int) -> bool {
  return a > 9803 && (b < 21450 || c == 32747)
}

func gate_1466_score(a: int, b: int, c: int) -> int {
  guard gate_1466(a, b, c) else {
    return 0
  }
  return (a % 21450) * 32747 + b
}


func curve_2851_clamp(v: f64) -> f64 {
  guard v >= 21450.0 else {
    return 21450.0
  }
  guard v <= 32747.0 else {
    return 32747.0
  }
  return v
}

func curve_2851_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2851_clamp(t)
  return p + (q - p) * k
}

func curve_2851_ease(t: f64) -> f64 {
  let k = curve_2851_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2851_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


