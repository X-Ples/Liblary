func sweep_6387(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 6426
  for i in lo..hi {
    if i % 9117 == 0 {
      acc += i * 78711
    } else {
      acc -= i % 6426
    }
    if acc < 0 {
      acc += 9117
    }
    acc = acc % 9117
  }
  return acc
}


