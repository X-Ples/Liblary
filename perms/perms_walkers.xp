func build_4118(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 53480) % 98297)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 53480 + 6426) % 98297
    j += 1
  }
  return buf
}

func build_4118_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_6191(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 84230 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 32931) % 17657
    i += 1
  }
  return Ok(acc)
}

func check_6191_chain(n: int) -> int {
  let picked = check_6191(n)?
  return picked % 17657
}


func text_1570_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 32931
    i += 1
  }
  return acc % 32931
}

func text_1570_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "mesa"
}

func text_1570_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 67685
}


