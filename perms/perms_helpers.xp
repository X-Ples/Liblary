func demo_helpers(seed: int) -> int {
  let scratch = build_7991(seed % 61 + 6, seed % 35225)
  show(len(scratch))
  show(build_7991_last(scratch))
  show(grid_3918_rowsum(scratch, 619, 2169, 629))
