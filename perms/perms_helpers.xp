func build_7991(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 96308) % 86614)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 96308 + 1954) % 86614
    j += 1
  }
  return buf
}

func build_7991_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_3918_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 19317 + c * 57658 + seed) % 57658)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3918_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 57658 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_5725(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 1954 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 97204) % 82646
    i += 1
  }
  return Ok(acc)
}

func check_5725_chain(n: int) -> int {
  let picked = check_5725(n)?
  return picked % 82646
}


func text_2128_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 42312
    i += 1
  }
  return acc % 42312
}

func text_2128_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "nova"
}

func text_2128_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 40996
}


