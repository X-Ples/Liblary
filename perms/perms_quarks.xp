func grid_6647_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 44630 + c * 44308 + seed) % 44308)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6647_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 44308 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func row_3982() -> [int] {
  return [4081, 618, 2513, 3544, 770, 988, 35, 1598, 3350, 1047]
}

func row_3982_at(i: int) -> int {
  let row = row_3982()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3982_sum(limit: int) -> int {
  let row = row_3982()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3982_best() -> int {
  let row = row_3982()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


