func curve_8072_clamp(v: f64) -> f64 {
  guard v >= 8419.0 else {
    return 8419.0
  }
  guard v <= 76846.0 else {
    return 76846.0
  }
  return v
}

func curve_8072_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8072_clamp(t)
  return p + (q - p) * k
}

func curve_8072_ease(t: f64) -> f64 {
  let k = curve_8072_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8072_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_5038_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 2085
    i += 1
  }
  return acc % 2085
}

func text_5038_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "bravo"
  }
  return "delta"
}

func text_5038_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 78610
}


