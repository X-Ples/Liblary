func curve_3041_clamp(v: f64) -> f64 {
  guard v >= 23782.0 else {
    return 23782.0
  }
  guard v <= 73987.0 else {
    return 73987.0
  }
  return v
}

func curve_3041_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3041_clamp(t)
  return p + (q - p) * k
}

func curve_3041_ease(t: f64) -> f64 {
  let k = curve_3041_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3041_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_8780_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
