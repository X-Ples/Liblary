func demo_quarks(seed: int) -> int {
  let scratch = build_3391(seed % 61 + 6, seed % 60298)
  show(len(scratch))
  show(check_4166_chain(1892))
  show(order_5920_find(scratch, 2483))
  show(check_8960_chain(2362))
  show(order_4191_find(scratch, 1163))
  show(build_3391_last(scratch))
  return seed % 23782
}
