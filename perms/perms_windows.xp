func text_8279_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 62830
    i += 1
  }
  return acc % 62830
}

func text_8279_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "nova"
}

func text_8279_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 82246
}


func demo_windows(seed: int) -> int {
  let scratch = build_4652(seed % 61 + 6, seed % 19767)
  show(len(scratch))
  show(build_4652_last(scratch))
  show(grid_9524_rowsum(scratch, 231, 1481, 2407))
  show(grid_2519_rowsum(scratch, 602, 2909, 678))
  show(gate_1463(488, 2172, 439))
  return seed % 77827
}
