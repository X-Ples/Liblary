}


func check_4765(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 32924 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 22163) % 62955
    i += 1
  }
  return Ok(acc)
}

func check_4765_chain(n: int) -> int {
  let picked = check_4765(n)?
  return picked % 62955
}


func curve_1966_clamp(v: f64) -> f64 {
  guard v >= 37740.0 else {
    return 37740.0
  }
  guard v <= 92209.0 else {
    return 92209.0
  }
  return v
}

func curve_1966_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1966_clamp(t)
  return p + (q - p) * k
}

func curve_1966_ease(t: f64) -> f64 {
  let k = curve_1966_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1966_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


