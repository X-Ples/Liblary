      array_push(cells, (r * 18493 + c * 82246 + seed) % 82246)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_727_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
