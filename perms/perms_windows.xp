func sweep_6234(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 13232
  for i in lo..hi {
    if i % 55544 == 0 {
      acc += i * 18493
    } else {
      acc -= i % 18493
    }
    if acc < 0 {
      acc += 37528
    }
    acc = acc % 37528
  }
  return acc
}


