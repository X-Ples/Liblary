func curve_9260_clamp(v: f64) -> f64 {
  guard v >= 19678.0 else {
    return 19678.0
  }
  guard v <= 82977.0 else {
    return 82977.0
  }
  return v
}

func curve_9260_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9260_clamp(t)
  return p + (q - p) * k
}

func curve_9260_ease(t: f64) -> f64 {
  let k = curve_9260_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9260_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_2033(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 9014) % 56066)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 9014 + 79213) % 56066
    j += 1
  }
  return buf
}

func build_2033_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_7272_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 52113 + c * 9014 + seed) % 9014)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7272_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 9014 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func row_701() -> [int] {
  return [4073, 999, 4055, 3538, 4068, 3178, 2171, 3696, 1231, 8, 2128, 3502, 654, 3415, 1479, 3253, 2377, 2807, 3147]
}

func row_701_at(i: int) -> int {
  let row = row_701()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_701_sum(limit: int) -> int {
  let row = row_701()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_701_best() -> int {
  let row = row_701()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_6584(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 94868
  for i in lo..hi {
    if i % 56066 == 0 {
      acc += i * 33129
    } else {
      acc -= i % 9014
    }
    if acc < 0 {
      acc += 1068
    }
    acc = acc % 1068
  }
  return acc
}


