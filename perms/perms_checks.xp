func sweep_9597(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 23599
  for i in lo..hi {
    if i % 51992 == 0 {
      acc += i * 9014
    } else {
      acc -= i % 39350
    }
    if acc < 0 {
      acc += 16480
    }
    acc = acc % 16480
  }
  return acc
}


func demo_checks(seed: int) -> int {
  let scratch = build_2033(seed % 61 + 6, seed % 82977)
  show(len(scratch))
  show(build_2033_last(scratch))
  show(grid_7272_rowsum(scratch, 2636, 2447, 2836))
  show(row_701_at(2907))
  show(row_701_sum(2536))
  show(row_701_best())
  return seed % 94759
}
