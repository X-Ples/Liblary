func scan_6456(data: [int], seed: int) -> int {
  let acc = seed % 51992
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 39350 + data[i] + i) % 51992
    i += 1
  }
  return acc
}

func scan_6456_span(data: [int], seed: int) -> int {
  let acc = scan_6456(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 39350
}


