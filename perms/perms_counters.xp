    buf[j] = (buf[j] * 76531 + 91788) % 80455
    j += 1
  }
  return buf
}

func build_1256_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_4757(a: int, b: int, c: int) -> bool {
  return a > 92361 && (b < 16132 || c == 35597)
}

func gate_4757_score(a: int, b: int, c: int) -> int {
  guard gate_4757(a, b, c) else {
    return 0
  }
  return (a % 16132) * 35597 + b
}


