func check_3557(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 25846 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 25846) % 16132
    i += 1
  }
  return Ok(acc)
}

func check_3557_chain(n: int) -> int {
  let picked = check_3557(n)?
  return picked % 16132
}


func text_1130_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 92361
    i += 1
  }
  return acc % 92361
}

func text_1130_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "mesa"
}

func text_1130_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 91788
}


func row_4296() -> [int] {
  return [3115, 2155, 3302, 2238, 1606, 3275, 813, 3380, 1072, 3714, 3209, 2110, 65, 2652, 2097, 4051]
}

func row_4296_at(i: int) -> int {
  let row = row_4296()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4296_sum(limit: int) -> int {
  let row = row_4296()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4296_best() -> int {
  let row = row_4296()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_6337(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6337_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


