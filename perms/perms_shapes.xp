func scan_4431(data: [int], seed: int) -> int {
  let acc = seed % 74674
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 25125 + data[i] + i) % 74674
    i += 1
  }
  return acc
}

func scan_4431_span(data: [int], seed: int) -> int {
  let acc = scan_4431(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 25125
}


