func sweep_6340(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 16310
  for i in lo..hi {
    if i % 61326 == 0 {
      acc += i * 48656
    } else {
      acc -= i % 20637
    }
    if acc < 0 {
      acc += 33282
    }
    acc = acc % 33282
  }
  return acc
}


