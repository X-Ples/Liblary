  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 46522) % 19895
    i += 1
  }
  return Ok(acc)
}

func check_8031_chain(n: int) -> int {
  let picked = check_8031(n)?
  return picked % 19895
}


