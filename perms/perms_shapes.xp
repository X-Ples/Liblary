func demo_shapes(seed: int) -> int {
  let scratch = build_1371(seed % 61 + 6, seed % 6969)
  show(len(scratch))
  show(scan_4431(scratch, 3518))
  show(scan_4431_span(scratch, 3377))
  show(build_1371_last(scratch))
  show(build_1924_last(scratch))
  return seed % 59646
}
