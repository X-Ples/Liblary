func build_534(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 11611) % 8472)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 11611 + 48127) % 8472
    j += 1
  }
  return buf
}

func build_534_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_5823_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 18549 + c * 67292 + seed) % 67292)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5823_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 67292 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func row_3007() -> [int] {
  return [1869, 3799, 3645, 329, 712, 1495, 1432, 2847, 3008, 2232]
}

func row_3007_at(i: int) -> int {
  let row = row_3007()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3007_sum(limit: int) -> int {
  let row = row_3007()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3007_best() -> int {
  let row = row_3007()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_720(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 9807 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 8264) % 33063
    i += 1
  }
  return Ok(acc)
}

func check_720_chain(n: int) -> int {
  let picked = check_720(n)?
  return picked % 33063
}


