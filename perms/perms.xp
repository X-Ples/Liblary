func text_600_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 18549
    i += 1
  }
  return acc % 18549
}

func text_600_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "delta"
}

func text_600_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 9807
}


func gate_7616(a: int, b: int, c: int) -> bool {
  return a > 88520 && (b < 46655 || c == 5046)
}

func gate_7616_score(a: int, b: int, c: int) -> int {
  guard gate_7616(a, b, c) else {
    return 0
  }
  return (a % 46655) * 5046 + b
}


