}


func check_3960(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 99831 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 57533) % 33659
    i += 1
  }
  return Ok(acc)
}

func check_3960_chain(n: int) -> int {
  let picked = check_3960(n)?
  return picked % 33659
}


func curve_462_clamp(v: f64) -> f64 {
  guard v >= 63457.0 else {
    return 63457.0
  }
  guard v <= 69711.0 else {
    return 69711.0
  }
  return v
}

func curve_462_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_462_clamp(t)
  return p + (q - p) * k
}

func curve_462_ease(t: f64) -> f64 {
  let k = curve_462_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_462_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


