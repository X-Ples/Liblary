func demo_core(seed: int) -> int {
  let scratch = build_8029(seed % 61 + 6, seed % 82586)
  show(len(scratch))
  show(build_8029_last(scratch))
  show(order_7796_find(scratch, 2758))
  show(scan_5795(scratch, 66))
  show(scan_5795_span(scratch, 3209))
  show(sweep_8205(1104, 3111))
  return seed % 70098
}
