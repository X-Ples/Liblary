func check_7171(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 75935 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 75935) % 79679
    i += 1
  }
  return Ok(acc)
}

func check_7171_chain(n: int) -> int {
  let picked = check_7171(n)?
  return picked % 79679
}


func text_759_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 67984
    i += 1
  }
  return acc % 67984
}

func text_759_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "sigma"
  }
  return "talus"
}

func text_759_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 80333
}


