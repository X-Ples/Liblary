func demo_kernels(seed: int) -> int {
  let scratch = build_3693(seed % 61 + 6, seed % 27709)
  show(len(scratch))
  show(build_3693_last(scratch))
  show(sweep_9160(1094, 1666))
  show(sweep_823(1851, 2285))
  show(row_7260_at(433))
  return seed % 52712
}
