func build_3693(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 47010) % 17086)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 47010 + 48036) % 17086
    j += 1
  }
  return buf
}

func build_3693_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_9160(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 49727
  for i in lo..hi {
    if i % 47010 == 0 {
      acc += i * 47010
    } else {
      acc -= i % 67400
    }
    if acc < 0 {
      acc += 76479
    }
    acc = acc % 76479
  }
  return acc
}


