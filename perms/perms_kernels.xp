func check_4346(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 33816 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 4741) % 67400
    i += 1
  }
  return Ok(acc)
}

func check_4346_chain(n: int) -> int {
  let picked = check_4346(n)?
  return picked % 67400
}


