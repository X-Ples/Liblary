func sweep_2021(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 64579
  for i in lo..hi {
    if i % 72357 == 0 {
      acc += i * 11898
    } else {
      acc -= i % 94196
    }
    if acc < 0 {
      acc += 44968
    }
    acc = acc % 44968
  }
  return acc
}


func build_4010(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 18082) % 41855)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 18082 + 94898) % 41855
    j += 1
  }
  return buf
}

func build_4010_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_6929_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 47187
    i += 1
  }
  return acc % 47187
}

func text_6929_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "ridge"
}

func text_6929_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 44968
}


func row_7449() -> [int] {
  return [3381, 1232, 1922, 3585, 1678, 1694, 2126, 974, 3362, 701, 1645, 2919, 3379, 2151, 1483]
}

func row_7449_at(i: int) -> int {
  let row = row_7449()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7449_sum(limit: int) -> int {
  let row = row_7449()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7449_best() -> int {
  let row = row_7449()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_7669(data: [int], seed: int) -> int {
  let acc = seed % 28773
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 47187 + data[i] + i) % 28773
    i += 1
  }
  return acc
}

func scan_7669_span(data: [int], seed: int) -> int {
  let acc = scan_7669(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 47187
}


func curve_3948_clamp(v: f64) -> f64 {
  guard v >= 32401.0 else {
    return 32401.0
  }
  guard v <= 47187.0 else {
    return 47187.0
  }
  return v
}

func curve_3948_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3948_clamp(t)
  return p + (q - p) * k
}

func curve_3948_ease(t: f64) -> f64 {
  let k = curve_3948_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3948_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_3429(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3429_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


