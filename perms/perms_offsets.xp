func demo_offsets(seed: int) -> int {
  let scratch = build_4010(seed % 61 + 6, seed % 72357)
  show(len(scratch))
  show(sweep_2021(722, 726))
  show(build_4010_last(scratch))
  show(text_6929_weight("prism"))
  show(text_6929_label(3088))
  show(text_6929_has("ember"))
  return seed % 18757
}
