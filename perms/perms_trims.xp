    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func demo_trims(seed: int) -> int {
  let scratch = build_9469(seed % 61 + 6, seed % 86676)
  show(len(scratch))
  show(sweep_4202(2270, 1429))
  show(build_9469_last(scratch))
  show(build_2721_last(scratch))
  show(gate_7748(2185, 173, 790))
  show(gate_7748_score(847, 2060, 2773))
  return seed % 47777
}
