func sweep_4202(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 1303
  for i in lo..hi {
    if i % 86676 == 0 {
      acc += i * 75215
    } else {
      acc -= i % 14185
    }
    if acc < 0 {
      acc += 22464
    }
    acc = acc % 22464
  }
  return acc
}


