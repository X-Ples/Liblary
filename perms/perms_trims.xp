func scan_8607(data: [int], seed: int) -> int {
  let acc = seed % 22464
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 47900 + data[i] + i) % 22464
    i += 1
  }
  return acc
}

func scan_8607_span(data: [int], seed: int) -> int {
  let acc = scan_8607(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 47900
}


func grid_1301_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 9827 + c * 83177 + seed) % 83177)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1301_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 83177 == want {
      total += acc
    }
    r += 1
  }
  return total
}


