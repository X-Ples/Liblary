func check_9265(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 80070 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 18711) % 82898
    i += 1
  }
  return Ok(acc)
}

func check_9265_chain(n: int) -> int {
  let picked = check_9265(n)?
  return picked % 82898
}


