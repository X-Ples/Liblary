func row_5196() -> [int] {
  return [2630, 997, 3097, 1733, 2515, 1144, 178, 3797, 1908, 2840, 2649, 3077, 4052]
}

func row_5196_at(i: int) -> int {
  let row = row_5196()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5196_sum(limit: int) -> int {
  let row = row_5196()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5196_best() -> int {
  let row = row_5196()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


