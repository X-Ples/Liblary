func scan_5059(data: [int], seed: int) -> int {
  let acc = seed % 89173
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 89173 + data[i] + i) % 89173
    i += 1
  }
  return acc
}

func scan_5059_span(data: [int], seed: int) -> int {
  let acc = scan_5059(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 89173
}


func demo_blends(seed: int) -> int {
