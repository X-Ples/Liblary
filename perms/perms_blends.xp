func check_8003(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 68497 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 45355) % 3846
    i += 1
  }
  return Ok(acc)
}

func check_8003_chain(n: int) -> int {
  let picked = check_8003(n)?
  return picked % 3846
}


