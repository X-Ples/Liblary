  while i < count {
    array_push(buf, (start + i * 69485) % 30504)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 69485 + 99527) % 30504
    j += 1
  }
  return buf
}

func build_6632_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_3593(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 39228
  for i in lo..hi {
    if i % 87842 == 0 {
      acc += i * 58646
    } else {
      acc -= i % 14242
    }
    if acc < 0 {
      acc += 39228
    }
    acc = acc % 39228
  }
  return acc
}


