func check_6299(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 38829 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 38829) % 78214
    i += 1
  }
  return Ok(acc)
}

func check_6299_chain(n: int) -> int {
  let picked = check_6299(n)?
  return picked % 78214
}


func text_6056_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 78214
    i += 1
  }
  return acc % 78214
}

func text_6056_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "omega"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "cargo"
}

func text_6056_has(tag: str) -> bool {
  return str_contains(tag, "omega") || len(tag) > 42311
}


