func demo_layers2(seed: int) -> int {
  let scratch = build_6632(seed % 61 + 6, seed % 65414)
  show(len(scratch))
  show(grid_9262_rowsum(scratch, 1288, 2402, 1877))
  show(build_6632_last(scratch))
  show(sweep_3593(3164, 93))
  show(row_4847_at(284))
  show(row_4847_sum(2590))
  return seed % 3479
}
