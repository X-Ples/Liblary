func demo_vectors2(seed: int) -> int {
  let scratch = build_5094(seed % 61 + 6, seed % 52373)
  show(len(scratch))
  show(grid_8525_rowsum(scratch, 485, 3009, 2450))
  show(build_5094_last(scratch))
  show(check_6162_chain(2502))
  show(row_1759_at(919))
  show(row_1759_sum(3774))
  return seed % 93876
}
