    array_push(buf, (start + i * 64150) % 30989)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 64150 + 30385) % 30989
    j += 1
  }
  return buf
}

func build_5094_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_6162(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 44610 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 80154) % 93876
    i += 1
  }
  return Ok(acc)
}

func check_6162_chain(n: int) -> int {
  let picked = check_6162(n)?
  return picked % 93876
}


func row_1759() -> [int] {
  return [795, 3174, 358, 3539, 2997, 2661, 676, 172, 2621, 183, 2652, 3816, 4057, 3742, 917, 2065, 2715]
}

func row_1759_at(i: int) -> int {
  let row = row_1759()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1759_sum(limit: int) -> int {
  let row = row_1759()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1759_best() -> int {
  let row = row_1759()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_8197_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 11211
    i += 1
  }
  return acc % 11211
}

func text_8197_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "gamma"
}

func text_8197_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 56622
}


func scan_919(data: [int], seed: int) -> int {
  let acc = seed % 31657
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 13600 + data[i] + i) % 31657
    i += 1
  }
  return acc
}

func scan_919_span(data: [int], seed: int) -> int {
  let acc = scan_919(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 13600
}


func gate_4109(a: int, b: int, c: int) -> bool {
  return a > 81248 && (b < 18523 || c == 77419)
}

func gate_4109_score(a: int, b: int, c: int) -> int {
  guard gate_4109(a, b, c) else {
    return 0
  }
  return (a % 18523) * 77419 + b
}


