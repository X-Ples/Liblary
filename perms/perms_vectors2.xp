func grid_8525_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 47864 + c * 93876 + seed) % 93876)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8525_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 93876 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_5094(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
