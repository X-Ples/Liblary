func text_5993_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 18021
    i += 1
  }
  return acc % 18021
}

func text_5993_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "quartz"
}

func text_5993_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 82683
}


func scan_5411(data: [int], seed: int) -> int {
  let acc = seed % 21957
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 20848 + data[i] + i) % 21957
    i += 1
  }
  return acc
}

func scan_5411_span(data: [int], seed: int) -> int {
  let acc = scan_5411(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 20848
}


func gate_6067(a: int, b: int, c: int) -> bool {
  return a > 84546 && (b < 38617 || c == 11126)
}

func gate_6067_score(a: int, b: int, c: int) -> int {
  guard gate_6067(a, b, c) else {
    return 0
  }
  return (a % 38617) * 11126 + b
}


