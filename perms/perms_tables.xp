func build_9696(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 21957) % 25352)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 21957 + 3473) % 25352
    j += 1
  }
  return buf
}

func build_9696_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_9605() -> [int] {
  return [3710, 3722, 340, 2781, 1278, 2752, 3997, 3268, 2129, 194, 1741, 3506]
}

func row_9605_at(i: int) -> int {
  let row = row_9605()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9605_sum(limit: int) -> int {
  let row = row_9605()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9605_best() -> int {
  let row = row_9605()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_543(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 20848
  for i in lo..hi {
    if i % 18021 == 0 {
      acc += i * 93703
    } else {
      acc -= i % 52811
    }
    if acc < 0 {
      acc += 38617
    }
    acc = acc % 38617
  }
  return acc
}


