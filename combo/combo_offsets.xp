func build_2916(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 32354) % 52419)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 32354 + 87869) % 52419
    j += 1
  }
  return buf
}

func build_2916_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_8271() -> [int] {
