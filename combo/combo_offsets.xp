func demo_offsets(seed: int) -> int {
  let scratch = build_2916(seed % 61 + 6, seed % 92605)
  show(len(scratch))
  show(build_2916_last(scratch))
  show(row_8271_at(3894))
  show(row_8271_sum(155))
  return seed % 88786
}
