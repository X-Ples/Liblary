func sweep_5398(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 63745
  for i in lo..hi {
    if i % 88426 == 0 {
      acc += i * 18422
    } else {
      acc -= i % 65858
    }
    if acc < 0 {
      acc += 93389
    }
    acc = acc % 93389
  }
  return acc
}


func curve_3816_clamp(v: f64) -> f64 {
  guard v >= 82009.0 else {
    return 82009.0
  }
  guard v <= 92605.0 else {
    return 92605.0
  }
  return v
}

func curve_3816_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3816_clamp(t)
  return p + (q - p) * k
}

func curve_3816_ease(t: f64) -> f64 {
  let k = curve_3816_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3816_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_9941(data: [int], seed: int) -> int {
  let acc = seed % 92605
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 53513 + data[i] + i) % 92605
    i += 1
  }
  return acc
}

func scan_9941_span(data: [int], seed: int) -> int {
  let acc = scan_9941(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 53513
}


