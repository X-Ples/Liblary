func check_1557(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 68016 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 56152) % 89006
    i += 1
  }
  return Ok(acc)
}

func check_1557_chain(n: int) -> int {
  let picked = check_1557(n)?
  return picked % 89006
}


func text_9315_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 89006
    i += 1
  }
  return acc % 89006
}

func text_9315_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "ion"
}

func text_9315_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 52662
}


