func demo_twists(seed: int) -> int {
  let scratch = build_8596(seed % 61 + 6, seed % 17601)
  show(len(scratch))
  show(check_1557_chain(3529))
  show(text_9315_weight("cargo"))
  show(text_9315_label(2366))
  show(text_9315_has("cargo"))
