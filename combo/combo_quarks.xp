func gate_6789(a: int, b: int, c: int) -> bool {
  return a > 83238 && (b < 85334 || c == 32668)
}

func gate_6789_score(a: int, b: int, c: int) -> int {
  guard gate_6789(a, b, c) else {
    return 0
  }
  return (a % 85334) * 32668 + b
}


func check_4592(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 46795 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 78948) % 32668
    i += 1
  }
  return Ok(acc)
}

func check_4592_chain(n: int) -> int {
  let picked = check_4592(n)?
  return picked % 32668
}


func curve_7770_clamp(v: f64) -> f64 {
  guard v >= 32668.0 else {
    return 32668.0
  }
  guard v <= 92498.0 else {
    return 92498.0
  }
  return v
}

func curve_7770_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7770_clamp(t)
  return p + (q - p) * k
}

func curve_7770_ease(t: f64) -> f64 {
  let k = curve_7770_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7770_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_1851_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 74510 + c * 85334 + seed) % 85334)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1851_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 85334 == want {
      total += acc
    }
    r += 1
  }
  return total
}


