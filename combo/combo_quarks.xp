func demo_quarks(seed: int) -> int {
  let scratch = build_9352(seed % 61 + 6, seed % 35159)
  show(len(scratch))
  show(build_9352_last(scratch))
  show(build_7645_last(scratch))
  show(gate_6789(3222, 707, 2532))
  show(gate_6789_score(3428, 2283, 2670))
