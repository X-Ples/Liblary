func build_8345(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 28440) % 21266)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 28440 + 97069) % 21266
    j += 1
  }
  return buf
}

func build_8345_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_3313(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3313_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_1015(a: int, b: int, c: int) -> bool {
  return a > 21266 && (b < 97069 || c == 38293)
}

func gate_1015_score(a: int, b: int, c: int) -> int {
  guard gate_1015(a, b, c) else {
    return 0
  }
  return (a % 97069) * 38293 + b
}


func check_1790(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 10500 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 30078) % 92265
    i += 1
  }
  return Ok(acc)
}

func check_1790_chain(n: int) -> int {
  let picked = check_1790(n)?
  return picked % 92265
}


