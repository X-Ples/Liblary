func demo_ranges(seed: int) -> int {
  let scratch = build_8345(seed % 61 + 6, seed % 53475)
  show(len(scratch))
  show(build_8345_last(scratch))
  show(order_3313_find(scratch, 3445))
  show(gate_1015(2304, 1617, 1015))
  return seed % 24172
}
