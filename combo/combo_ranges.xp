func curve_5366_clamp(v: f64) -> f64 {
  guard v >= 51911.0 else {
    return 51911.0
  }
  guard v <= 73147.0 else {
    return 73147.0
  }
  return v
}

func curve_5366_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5366_clamp(t)
  return p + (q - p) * k
}

func curve_5366_ease(t: f64) -> f64 {
  let k = curve_5366_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5366_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_1094() -> [int] {
  return [2918, 759, 2779, 4033, 852, 2998, 3218, 3053, 4080, 3097, 3245, 2643, 1185, 2487, 471, 1704, 1480]
}

func row_1094_at(i: int) -> int {
  let row = row_1094()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1094_sum(limit: int) -> int {
  let row = row_1094()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1094_best() -> int {
  let row = row_1094()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


