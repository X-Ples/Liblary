func demo_blends(seed: int) -> int {
  let scratch = build_2115(seed % 61 + 6, seed % 76857)
  show(len(scratch))
  show(scan_337(scratch, 2956))
  show(scan_337_span(scratch, 2108))
  show(build_2115_last(scratch))
