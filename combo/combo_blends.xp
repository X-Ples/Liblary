func scan_337(data: [int], seed: int) -> int {
  let acc = seed % 70942
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 83258 + data[i] + i) % 70942
    i += 1
  }
  return acc
}

func scan_337_span(data: [int], seed: int) -> int {
  let acc = scan_337(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 83258
}


