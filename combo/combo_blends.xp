func sweep_6855(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 83258
  for i in lo..hi {
    if i % 4350 == 0 {
      acc += i * 31926
    } else {
      acc -= i % 12361
    }
    if acc < 0 {
      acc += 86016
    }
    acc = acc % 86016
  }
  return acc
}


