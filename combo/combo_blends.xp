func text_8172_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "lumen"
}

func text_8172_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 76857
}


