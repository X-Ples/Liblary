func curve_5821_clamp(v: f64) -> f64 {
  guard v >= 65815.0 else {
    return 65815.0
  }
  guard v <= 72509.0 else {
    return 72509.0
  }
  return v
}

func curve_5821_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5821_clamp(t)
  return p + (q - p) * k
}

func curve_5821_ease(t: f64) -> f64 {
  let k = curve_5821_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5821_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


