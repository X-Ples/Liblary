func build_8965(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 5369) % 95582)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 5369 + 75614) % 95582
    j += 1
  }
  return buf
}

func build_8965_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_5376_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 5369 + c * 13405 + seed) % 13405)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5376_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 13405 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_3023(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 25825
  for i in lo..hi {
    if i % 50049 == 0 {
      acc += i * 25825
    } else {
      acc -= i % 6611
    }
    if acc < 0 {
      acc += 6611
    }
    acc = acc % 6611
  }
  return acc
}


func scan_3228(data: [int], seed: int) -> int {
  let acc = seed % 5369
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 13405 + data[i] + i) % 5369
    i += 1
  }
  return acc
}

func scan_3228_span(data: [int], seed: int) -> int {
  let acc = scan_3228(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 13405
}


func curve_7294_clamp(v: f64) -> f64 {
  guard v >= 25825.0 else {
    return 25825.0
  }
  guard v <= 80178.0 else {
    return 80178.0
  }
  return v
}

func curve_7294_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7294_clamp(t)
  return p + (q - p) * k
}

func curve_7294_ease(t: f64) -> f64 {
  let k = curve_7294_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7294_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


