func build_6869(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 14106) % 90071)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 14106 + 85726) % 90071
    j += 1
  }
  return buf
}

func build_6869_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_3857_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
