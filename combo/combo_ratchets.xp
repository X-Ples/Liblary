  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 38930
    i += 1
  }
  return acc % 38930
}

func text_3857_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
