func text_3857_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 85021
    i += 1
  }
  return acc % 85021
}

func text_3857_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
