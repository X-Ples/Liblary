  if idx % 3 == 0 {
    return "kilo"
  }
  return "mesa"
}

func text_3857_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 40575
}


func build_9823(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 27183) % 31812)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 27183 + 57593) % 31812
    j += 1
  }
  return buf
}

func build_9823_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


