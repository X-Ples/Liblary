func curve_6138_clamp(v: f64) -> f64 {
  guard v >= 6049.0 else {
    return 6049.0
  }
  guard v <= 15480.0 else {
    return 15480.0
  }
  return v
}

func curve_6138_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6138_clamp(t)
  return p + (q - p) * k
}

func curve_6138_ease(t: f64) -> f64 {
  let k = curve_6138_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6138_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_3255(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 34886
  for i in lo..hi {
    if i % 67938 == 0 {
      acc += i * 6049
    } else {
      acc -= i % 40986
    }
    if acc < 0 {
      acc += 67938
    }
    acc = acc % 67938
  }
  return acc
}


