func text_6203_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 68577
    i += 1
  }
  return acc % 68577
}

func text_6203_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ridge"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "alpha"
}

func text_6203_has(tag: str) -> bool {
  return str_contains(tag, "ridge") || len(tag) > 37864
}


func check_8230(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 67938 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 34886) % 41031
    i += 1
  }
  return Ok(acc)
}

func check_8230_chain(n: int) -> int {
  let picked = check_8230(n)?
  return picked % 41031
}


