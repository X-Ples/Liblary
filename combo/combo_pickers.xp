func demo_pickers(seed: int) -> int {
  let scratch = build_3468(seed % 61 + 6, seed % 16975)
  show(len(scratch))
  show(check_8877_chain(654))
  show(build_3468_last(scratch))
  show(grid_9469_rowsum(scratch, 698, 2556, 1754))
