const K0 = 16975
const K1 = 79572
const K2 = 62454
const K3 = 21119
const K4 = 95452
const K5 = 42627

func check_8877(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 19950 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 12109) % 16975
    i += 1
  }
  return Ok(acc)
}

func check_8877_chain(n: int) -> int {
  let picked = check_8877(n)?
  return picked % 16975
}


func build_3468(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 13927) % 54144)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 13927 + 12109) % 54144
    j += 1
  }
  return buf
}

func build_3468_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_9469_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 13927 + c * 95452 + seed) % 95452)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9469_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 95452 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_805_clamp(v: f64) -> f64 {
  guard v >= 13927.0 else {
    return 13927.0
  }
  guard v <= 75399.0 else {
    return 75399.0
  }
  return v
}

func curve_805_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_805_clamp(t)
  return p + (q - p) * k
}

func curve_805_ease(t: f64) -> f64 {
  let k = curve_805_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_805_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_8609_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 42459
    i += 1
  }
  return acc % 42459
}

func text_8609_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "ion"
}

func text_8609_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 19950
}


func gate_1359(a: int, b: int, c: int) -> bool {
  return a > 13927 && (b < 75399 || c == 1030)
}

func gate_1359_score(a: int, b: int, c: int) -> int {
  guard gate_1359(a, b, c) else {
    return 0
  }
  return (a % 75399) * 1030 + b
}


