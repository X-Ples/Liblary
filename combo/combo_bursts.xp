    array_push(buf, (start + i * 43778) % 53923)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 43778 + 19731) % 53923
    j += 1
  }
  return buf
}

func build_9022_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_1152_clamp(v: f64) -> f64 {
  guard v >= 30204.0 else {
    return 30204.0
  }
  guard v <= 67352.0 else {
    return 67352.0
  }
  return v
}

func curve_1152_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1152_clamp(t)
  return p + (q - p) * k
}

func curve_1152_ease(t: f64) -> f64 {
  let k = curve_1152_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1152_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_3759(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 24924
  for i in lo..hi {
    if i % 91241 == 0 {
      acc += i * 24924
    } else {
      acc -= i % 31449
    }
    if acc < 0 {
      acc += 30204
    }
    acc = acc % 30204
  }
  return acc
}


