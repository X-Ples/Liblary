func scan_1453(data: [int], seed: int) -> int {
  let acc = seed % 13614
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 30763 + data[i] + i) % 13614
    i += 1
  }
  return acc
}

func scan_1453_span(data: [int], seed: int) -> int {
  let acc = scan_1453(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 30763
}


func build_9022(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
