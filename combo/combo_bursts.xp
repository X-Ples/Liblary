func demo_bursts(seed: int) -> int {
  let scratch = build_9022(seed % 61 + 6, seed % 92538)
  show(len(scratch))
  show(scan_1453(scratch, 2537))
  show(scan_1453_span(scratch, 3235))
  show(build_9022_last(scratch))
  return seed % 30204
}
