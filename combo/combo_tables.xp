const K0 = 90505
const K1 = 73136
const K2 = 28936
const K3 = 59930
const K4 = 96960
const K5 = 72759

func build_9041(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 59930) % 97808)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 59930 + 28936) % 97808
    j += 1
  }
  return buf
}

func build_9041_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_3636(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 22961
  for i in lo..hi {
    if i % 73136 == 0 {
      acc += i * 66949
    } else {
      acc -= i % 72759
    }
    if acc < 0 {
      acc += 59930
    }
    acc = acc % 59930
  }
  return acc
}


