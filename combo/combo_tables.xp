func demo_tables(seed: int) -> int {
  let scratch = build_9041(seed % 61 + 6, seed % 28936)
  show(len(scratch))
  show(build_9041_last(scratch))
  show(sweep_3636(3099, 1756))
  show(build_5765_last(scratch))
  return seed % 97808
}
