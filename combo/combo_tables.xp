func row_493() -> [int] {
  return [2389, 1418, 872, 2190, 2317, 2397, 45, 2486, 3225, 196]
}

func row_493_at(i: int) -> int {
  let row = row_493()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_493_sum(limit: int) -> int {
  let row = row_493()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_493_best() -> int {
  let row = row_493()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


