func check_4540(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 77877 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 30260) % 67838
    i += 1
  }
  return Ok(acc)
}

func check_4540_chain(n: int) -> int {
  let picked = check_4540(n)?
  return picked % 67838
}


