func scan_1505(data: [int], seed: int) -> int {
  let acc = seed % 72738
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 72457 + data[i] + i) % 72738
    i += 1
  }
  return acc
}

func scan_1505_span(data: [int], seed: int) -> int {
  let acc = scan_1505(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 72457
}


