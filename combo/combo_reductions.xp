func demo_reductions(seed: int) -> int {
  let scratch = build_8729(seed % 61 + 6, seed % 77351)
  show(len(scratch))
  show(build_8729_last(scratch))
  show(build_3487_last(scratch))
  show(grid_6093_rowsum(scratch, 1489, 1060, 2842))
  show(build_9700_last(scratch))
  show(check_408_chain(153))
  return seed % 74448
}
