func row_9446() -> [int] {
  return [479, 71, 2083, 3566, 2729, 450, 617, 1268, 3085, 1758, 2052, 998, 3701, 3343]
}

func row_9446_at(i: int) -> int {
  let row = row_9446()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9446_sum(limit: int) -> int {
  let row = row_9446()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9446_best() -> int {
  let row = row_9446()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


