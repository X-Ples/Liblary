func build_8729(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 14273) % 57437)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 14273 + 41762) % 57437
    j += 1
  }
  return buf
}

func build_8729_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


