func check_408(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 87963 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 42756) % 41762
    i += 1
  }
  return Ok(acc)
}

func check_408_chain(n: int) -> int {
  let picked = check_408(n)?
  return picked % 41762
}


func curve_9871_clamp(v: f64) -> f64 {
  guard v >= 41762.0 else {
    return 41762.0
  }
  guard v <= 42756.0 else {
    return 42756.0
  }
  return v
}

func curve_9871_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9871_clamp(t)
  return p + (q - p) * k
}

func curve_9871_ease(t: f64) -> f64 {
  let k = curve_9871_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9871_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_2962(data: [int], seed: int) -> int {
  let acc = seed % 74448
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 50482 + data[i] + i) % 74448
    i += 1
  }
  return acc
}

func scan_2962_span(data: [int], seed: int) -> int {
  let acc = scan_2962(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 50482
}


func sweep_1497(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 72451
  for i in lo..hi {
    if i % 14273 == 0 {
      acc += i * 42756
    } else {
      acc -= i % 39594
    }
    if acc < 0 {
      acc += 41762
    }
    acc = acc % 41762
  }
  return acc
}


func text_1135_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 74451
    i += 1
  }
  return acc % 74451
}

func text_1135_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "bravo"
  }
  return "ember"
}

func text_1135_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 20905
}


func order_8392(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8392_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


