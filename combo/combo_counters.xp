func sweep_6907(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 37114
  for i in lo..hi {
    if i % 3244 == 0 {
      acc += i * 28796
    } else {
      acc -= i % 90416
    }
    if acc < 0 {
      acc += 59546
    }
    acc = acc % 59546
  }
  return acc
}


