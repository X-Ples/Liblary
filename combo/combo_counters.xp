func demo_counters(seed: int) -> int {
  let scratch = build_5191(seed % 61 + 6, seed % 4387)
  show(len(scratch))
  show(grid_8159_rowsum(scratch, 581, 155, 3475))
  show(build_5191_last(scratch))
  show(scan_3799(scratch, 1538))
  show(scan_3799_span(scratch, 2902))
  return seed % 64212
}
