func scan_7247(data: [int], seed: int) -> int {
  let acc = seed % 79468
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 8679 + data[i] + i) % 79468
    i += 1
  }
  return acc
}

func scan_7247_span(data: [int], seed: int) -> int {
  let acc = scan_7247(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 8679
}


