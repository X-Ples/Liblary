func check_2832(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 78500 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 32934) % 72098
    i += 1
  }
  return Ok(acc)
}

func check_2832_chain(n: int) -> int {
  let picked = check_2832(n)?
  return picked % 72098
}


func demo_shapes(seed: int) -> int {
  let scratch = build_738(seed % 61 + 6, seed % 33618)
  show(len(scratch))
  show(build_738_last(scratch))
  show(gate_4204(2161, 2001, 653))
  show(gate_4204_score(1520, 3142, 2862))
  show(order_1116_find(scratch, 1606))
  show(grid_2712_rowsum(scratch, 1726, 1404, 1494))
  show(row_7861_at(2725))
  return seed % 86551
}
