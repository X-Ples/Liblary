func build_738(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 31545) % 41508)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 31545 + 33280) % 41508
    j += 1
  }
  return buf
}

func build_738_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_4204(a: int, b: int, c: int) -> bool {
  return a > 33299 && (b < 39170 || c == 31545)
}

func gate_4204_score(a: int, b: int, c: int) -> int {
  guard gate_4204(a, b, c) else {
    return 0
  }
  return (a % 39170) * 31545 + b
}


func order_1116(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1116_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func grid_2712_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 43048 + c * 63216 + seed) % 63216)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2712_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 63216 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func row_7861() -> [int] {
  return [3610, 2640, 2310, 2737, 2958, 3542, 3259, 980, 21, 638, 295, 1430, 992, 3013, 2752, 102, 3292, 3941, 525, 374]
}

func row_7861_at(i: int) -> int {
  let row = row_7861()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7861_sum(limit: int) -> int {
  let row = row_7861()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7861_best() -> int {
  let row = row_7861()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_3285_clamp(v: f64) -> f64 {
  guard v >= 31545.0 else {
    return 31545.0
  }
  guard v <= 86551.0 else {
    return 86551.0
  }
  return v
}

func curve_3285_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3285_clamp(t)
  return p + (q - p) * k
}

func curve_3285_ease(t: f64) -> f64 {
  let k = curve_3285_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3285_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


