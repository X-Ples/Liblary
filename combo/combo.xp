func text_4970_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 21964
    i += 1
  }
  return acc % 21964
}

func text_4970_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "ion"
}

func text_4970_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 96896
}


func row_8701() -> [int] {
  return [1118, 584, 1625, 3735, 3409, 2225, 99, 1722, 1205, 3344, 3768, 3519, 1323, 3112, 1889]
}

func row_8701_at(i: int) -> int {
  let row = row_8701()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8701_sum(limit: int) -> int {
  let row = row_8701()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8701_best() -> int {
  let row = row_8701()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


