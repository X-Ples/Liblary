func gate_1068(a: int, b: int, c: int) -> bool {
  return a > 67389 && (b < 30577 || c == 62595)
}

func gate_1068_score(a: int, b: int, c: int) -> int {
  guard gate_1068(a, b, c) else {
    return 0
  }
  return (a % 30577) * 62595 + b
}


func grid_7351_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 84081 + c * 67389 + seed) % 67389)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7351_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 67389 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_488_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 39020
    i += 1
  }
  return acc % 39020
}

func text_488_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "prism"
  }
