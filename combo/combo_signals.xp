func check_1564(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 44796 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 90648) % 30577
    i += 1
  }
  return Ok(acc)
}

func check_1564_chain(n: int) -> int {
  let picked = check_1564(n)?
  return picked % 30577
}


func demo_signals(seed: int) -> int {
  let scratch = build_4891(seed % 61 + 6, seed % 36202)
  show(len(scratch))
  show(order_6921_find(scratch, 3073))
  show(build_4891_last(scratch))
  show(build_988_last(scratch))
  show(gate_1068(3103, 2593, 3049))
  show(gate_1068_score(631, 2974, 1153))
  return seed % 44796
}
