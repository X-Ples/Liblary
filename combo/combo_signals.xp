}

func text_488_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 62595
}


func curve_6666_clamp(v: f64) -> f64 {
  guard v >= 18208.0 else {
    return 18208.0
  }
  guard v <= 39020.0 else {
    return 39020.0
  }
  return v
}

func curve_6666_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6666_clamp(t)
  return p + (q - p) * k
}

func curve_6666_ease(t: f64) -> f64 {
  let k = curve_6666_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6666_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


