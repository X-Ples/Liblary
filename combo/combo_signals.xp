func scan_750(data: [int], seed: int) -> int {
  let acc = seed % 62901
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 44796 + data[i] + i) % 62901
    i += 1
  }
  return acc
}

func scan_750_span(data: [int], seed: int) -> int {
  let acc = scan_750(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 44796
}


