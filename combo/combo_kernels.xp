func sweep_6852(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 36410
  for i in lo..hi {
    if i % 36410 == 0 {
      acc += i * 81641
    } else {
      acc -= i % 35504
    }
    if acc < 0 {
      acc += 30165
    }
    acc = acc % 30165
  }
  return acc
}


func gate_8025(a: int, b: int, c: int) -> bool {
  return a > 97589 && (b < 36384 || c == 73763)
}

func gate_8025_score(a: int, b: int, c: int) -> int {
  guard gate_8025(a, b, c) else {
    return 0
  }
  return (a % 36384) * 73763 + b
}


