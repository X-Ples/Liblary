const K0 = 39146
const K1 = 81641
const K2 = 910
const K3 = 90854
const K4 = 90854
const K5 = 44017

func curve_4543_clamp(v: f64) -> f64 {
  guard v >= 63443.0 else {
    return 63443.0
  }
  guard v <= 90854.0 else {
    return 90854.0
  }
  return v
}

func curve_4543_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4543_clamp(t)
  return p + (q - p) * k
}

func curve_4543_ease(t: f64) -> f64 {
  let k = curve_4543_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4543_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_4951(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 30165
  for i in lo..hi {
    if i % 55441 == 0 {
      acc += i * 81641
    } else {
      acc -= i % 79323
    }
    if acc < 0 {
      acc += 47728
    }
    acc = acc % 47728
  }
  return acc
}


func build_8247(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 30165) % 73763)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 30165 + 910) % 73763
    j += 1
  }
  return buf
}

func build_8247_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_3626_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 910 + c * 97589 + seed) % 97589)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3626_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 97589 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_8185(data: [int], seed: int) -> int {
  let acc = seed % 50839
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 35504 + data[i] + i) % 50839
    i += 1
  }
  return acc
}

func scan_8185_span(data: [int], seed: int) -> int {
  let acc = scan_8185(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 35504
}


func row_1396() -> [int] {
  return [660, 3711, 2346, 1527, 2559, 2304, 962, 409, 4007, 526, 1411, 535, 304, 3678, 2328, 1029]
}

func row_1396_at(i: int) -> int {
  let row = row_1396()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1396_sum(limit: int) -> int {
  let row = row_1396()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1396_best() -> int {
  let row = row_1396()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


