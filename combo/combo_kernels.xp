func demo_kernels(seed: int) -> int {
  let scratch = build_8247(seed % 61 + 6, seed % 39146)
  show(len(scratch))
  show(sweep_4951(1292, 1996))
  show(build_8247_last(scratch))
  show(grid_3626_rowsum(scratch, 185, 1631, 433))
  show(scan_8185(scratch, 806))
  return seed % 75384
}
