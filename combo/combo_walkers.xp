func text_4040_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 60375
    i += 1
  }
  return acc % 60375
}

func text_4040_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "sigma"
  }
  return "delta"
}

func text_4040_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 56735
}


func build_7342(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 59549) % 2409)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 59549 + 61570) % 2409
    j += 1
  }
  return buf
}

func build_7342_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_105_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 63791 + c * 3006 + seed) % 3006)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_105_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 3006 == want {
      total += acc
    }
    r += 1
  }
  return total
}


