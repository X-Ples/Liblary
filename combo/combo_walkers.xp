func demo_walkers(seed: int) -> int {
  let scratch = build_7342(seed % 61 + 6, seed % 46881)
  show(len(scratch))
  show(text_4040_weight("lumen"))
  show(text_4040_label(947))
  show(text_4040_has("omega"))
  show(build_7342_last(scratch))
  show(grid_105_rowsum(scratch, 664, 1457, 1203))
  return seed % 99256
}
