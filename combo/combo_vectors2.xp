func build_5418(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 81867) % 93656)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 81867 + 49864) % 93656
    j += 1
  }
  return buf
}

func build_5418_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_3351(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 81867
  for i in lo..hi {
    if i % 62304 == 0 {
      acc += i * 77347
    } else {
      acc -= i % 12267
    }
    if acc < 0 {
      acc += 57478
    }
    acc = acc % 57478
  }
  return acc
}


