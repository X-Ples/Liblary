func gate_1630(a: int, b: int, c: int) -> bool {
  return a > 10823 && (b < 54954 || c == 85116)
}

func gate_1630_score(a: int, b: int, c: int) -> int {
  guard gate_1630(a, b, c) else {
    return 0
  }
  return (a % 54954) * 85116 + b
}


func scan_9554(data: [int], seed: int) -> int {
  let acc = seed % 38508
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 2868 + data[i] + i) % 38508
    i += 1
  }
  return acc
}

func scan_9554_span(data: [int], seed: int) -> int {
  let acc = scan_9554(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 2868
}


func order_2787(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2787_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


