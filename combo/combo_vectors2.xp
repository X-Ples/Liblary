func demo_vectors2(seed: int) -> int {
  let scratch = build_5418(seed % 61 + 6, seed % 46891)
  show(len(scratch))
  show(build_5418_last(scratch))
  show(sweep_3351(3605, 2960))
  show(sweep_7179(699, 2106))
  show(gate_1630(3712, 1107, 1013))
  show(gate_1630_score(1230, 1379, 170))
  return seed % 22039
}
