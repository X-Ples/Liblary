    }
  }
  return best
}


func sweep_5434(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 95860
  for i in lo..hi {
    if i % 34002 == 0 {
      acc += i * 95860
    } else {
      acc -= i % 17870
    }
    if acc < 0 {
      acc += 51052
    }
    acc = acc % 51052
  }
  return acc
}


