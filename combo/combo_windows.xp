func demo_windows(seed: int) -> int {
  let scratch = build_595(seed % 61 + 6, seed % 59362)
  show(len(scratch))
  show(gate_4993(3341, 1547, 1499))
  show(gate_4993_score(878, 1015, 1723))
  show(build_595_last(scratch))
  show(scan_5176(scratch, 2977))
  return seed % 35812
}
