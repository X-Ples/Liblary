func check_4809(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 53370 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 4168) % 4168
    i += 1
  }
  return Ok(acc)
}

func check_4809_chain(n: int) -> int {
  let picked = check_4809(n)?
  return picked % 4168
}


