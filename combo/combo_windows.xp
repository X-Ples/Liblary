func gate_4993(a: int, b: int, c: int) -> bool {
  return a > 91934 && (b < 6875 || c == 36986)
}

func gate_4993_score(a: int, b: int, c: int) -> int {
  guard gate_4993(a, b, c) else {
    return 0
  }
  return (a % 6875) * 36986 + b
}


func curve_2009_clamp(v: f64) -> f64 {
  guard v >= 11088.0 else {
    return 11088.0
  }
  guard v <= 98751.0 else {
    return 98751.0
  }
  return v
}

func curve_2009_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2009_clamp(t)
  return p + (q - p) * k
}

func curve_2009_ease(t: f64) -> f64 {
  let k = curve_2009_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2009_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_595(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 44094) % 17378)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 44094 + 91934) % 17378
    j += 1
  }
  return buf
}

func build_595_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_5176(data: [int], seed: int) -> int {
  let acc = seed % 45877
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 98991 + data[i] + i) % 45877
    i += 1
  }
  return acc
}

func scan_5176_span(data: [int], seed: int) -> int {
  let acc = scan_5176(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 98991
}


