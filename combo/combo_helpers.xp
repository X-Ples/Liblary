func demo_helpers(seed: int) -> int {
  let scratch = build_122(seed % 61 + 6, seed % 95659)
  show(len(scratch))
  show(build_122_last(scratch))
  show(scan_8734(scratch, 2742))
  show(scan_8734_span(scratch, 518))
  show(build_6854_last(scratch))
  return seed % 64438
}
