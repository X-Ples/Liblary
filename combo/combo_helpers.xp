func build_122(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 5682) % 36074)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 5682 + 97471) % 36074
    j += 1
  }
  return buf
}

func build_122_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_8734(data: [int], seed: int) -> int {
  let acc = seed % 10077
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 90427 + data[i] + i) % 10077
    i += 1
  }
  return acc
}

func scan_8734_span(data: [int], seed: int) -> int {
  let acc = scan_8734(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 90427
}


