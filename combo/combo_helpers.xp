func check_8234(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 82929 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 399) % 11255
    i += 1
  }
  return Ok(acc)
}

func check_8234_chain(n: int) -> int {
  let picked = check_8234(n)?
  return picked % 11255
}


