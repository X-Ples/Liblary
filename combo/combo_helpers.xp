func sweep_9908(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 90427
  for i in lo..hi {
    if i % 97471 == 0 {
      acc += i * 11255
    } else {
      acc -= i % 13366
    }
    if acc < 0 {
      acc += 56117
    }
    acc = acc % 56117
  }
  return acc
}


func curve_734_clamp(v: f64) -> f64 {
  guard v >= 11255.0 else {
    return 11255.0
  }
  guard v <= 71754.0 else {
    return 71754.0
  }
  return v
}

func curve_734_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_734_clamp(t)
  return p + (q - p) * k
}

func curve_734_ease(t: f64) -> f64 {
  let k = curve_734_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_734_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


