func row_7998() -> [int] {
  return [440, 2814, 2807, 2869, 3560, 1535, 2361, 4080, 938, 405, 3961, 1674, 411, 2065, 2239, 4039, 1572, 1447, 1699, 348]
}

func row_7998_at(i: int) -> int {
  let row = row_7998()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7998_sum(limit: int) -> int {
  let row = row_7998()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7998_best() -> int {
  let row = row_7998()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


