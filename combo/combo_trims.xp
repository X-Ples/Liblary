func demo_trims(seed: int) -> int {
  let scratch = build_6395(seed % 61 + 6, seed % 66429)
  show(len(scratch))
  show(build_6395_last(scratch))
  show(check_2962_chain(1474))
  show(check_7648_chain(3929))
  show(order_4412_find(scratch, 2473))
  show(order_1096_find(scratch, 3266))
  return seed % 48815
}
