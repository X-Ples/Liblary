func build_6395(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 45268) % 81378)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 45268 + 45268) % 81378
    j += 1
  }
  return buf
}

func build_6395_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_2962(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 28195 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 83961) % 31355
    i += 1
  }
  return Ok(acc)
}

func check_2962_chain(n: int) -> int {
  let picked = check_2962(n)?
  return picked % 31355
}


