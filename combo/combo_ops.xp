func demo_ops(seed: int) -> int {
  let scratch = build_8743(seed % 61 + 6, seed % 88993)
  show(len(scratch))
  show(build_8743_last(scratch))
  show(sweep_627(1466, 2311))
  show(grid_4265_rowsum(scratch, 3680, 425, 2516))
  show(text_5643_weight("prism"))
  return seed % 40583
}
