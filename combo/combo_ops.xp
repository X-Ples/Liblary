func build_8743(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 62640) % 22826)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 62640 + 22826) % 22826
    j += 1
  }
  return buf
}

func build_8743_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_627(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 99346
  for i in lo..hi {
    if i % 96209 == 0 {
      acc += i * 53650
    } else {
      acc -= i % 32511
    }
    if acc < 0 {
      acc += 54589
    }
    acc = acc % 54589
  }
  return acc
}


func grid_4265_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 4473 + c * 96209 + seed) % 96209)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4265_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 96209 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_8439_clamp(v: f64) -> f64 {
  guard v >= 31199.0 else {
    return 31199.0
  }
  guard v <= 94300.0 else {
    return 94300.0
  }
  return v
}

func curve_8439_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8439_clamp(t)
  return p + (q - p) * k
}

func curve_8439_ease(t: f64) -> f64 {
  let k = curve_8439_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8439_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_5643_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 79443
    i += 1
  }
  return acc % 79443
}

func text_5643_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "omega"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "kilo"
}

func text_5643_has(tag: str) -> bool {
  return str_contains(tag, "omega") || len(tag) > 17304
}


