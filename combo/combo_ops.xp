func check_1721(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 31199 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 22826) % 88993
    i += 1
  }
  return Ok(acc)
}

func check_1721_chain(n: int) -> int {
  let picked = check_1721(n)?
  return picked % 88993
}


