const M_PI = 3.141592653589793
const M_TAU = 6.283185307179586
const M_HALF_PI = 1.5707963267948966
const M_DEG2RAD = 0.017453292519943295
const M_RAD2DEG = 57.29577951308232
const M_EPS = 0.000001
const M_GOLDEN = 1.618033988749895

func clamp(v: f64, lo: f64, hi: f64) -> f64 {
if v < lo {
return lo
}
if v > hi {
return hi
}
return v
}

func clamp01(v: f64) -> f64 {
return clamp(v, 0.0, 1.0)
}

func saturate(v: f64) -> f64 {
return clamp(v, 0.0, 1.0)
}

func lerp(a: f64, b: f64, t: f64) -> f64 {
return a + (b - a) * t
}

func inv_lerp(a: f64, b: f64, v: f64) -> f64 {
guard b != a else {
return 0.0
}
return (v - a) / (b - a)
}

func remap(in_lo: f64, in_hi: f64, out_lo: f64, out_hi: f64, v: f64) -> f64 {
let t = inv_lerp(in_lo, in_hi, v)
return out_lo + (out_hi - out_lo) * t
}

func smoothstep(e0: f64, e1: f64, x: f64) -> f64 {
guard e1 != e0 else {
return 0.0
}
let t = clamp01((x - e0) / (e1 - e0))
return t * t * (3.0 - 2.0 * t)
}

func smootherstep(e0: f64, e1: f64, x: f64) -> f64 {
guard e1 != e0 else {
return 0.0
}
let t = clamp01((x - e0) / (e1 - e0))
return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
}

func fade(t: f64) -> f64 {
return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
}

func dist2(x1: f64, y1: f64, x2: f64, y2: f64) -> f64 {
let dx = x2 - x1
let dy = y2 - y1
return dx * dx + dy * dy
}

func dist(x1: f64, y1: f64, x2: f64, y2: f64) -> f64 {
let dx = x2 - x1
let dy = y2 - y1
return sqrt(dx * dx + dy * dy)
}

func deg_to_rad(deg: f64) -> f64 {
return deg * M_DEG2RAD
}

func rad_to_deg(rad: f64) -> f64 {
return rad * M_RAD2DEG
}

func almost_eq(a: f64, b: f64) -> bool {
return abs(a - b) <= M_EPS
}

func almost_eq_tol(a: f64, b: f64, tol: f64) -> bool {
return abs(a - b) <= tol
}

func approx_zero(v: f64) -> bool {
return abs(v) <= M_EPS
}

func snap(v: f64, step: f64) -> f64 {
guard step != 0.0 else {
return v
}
return floor(v / step + 0.5) * step
}

func wrap(v: f64, lo: f64, hi: f64) -> f64 {
let span = hi - lo
guard span != 0.0 else {
return lo
}
let r = v - lo
let k = floor(r / span)
return lo + (r - k * span)
}

func ping_pong(t: f64, length: f64) -> f64 {
guard length != 0.0 else {
return 0.0
}
let cycle = 2.0 * length
let l = t - floor(t / cycle) * cycle
if l > length {
return cycle - l
}
return l
}

func ease_in_quad(t: f64) -> f64 {
let u = clamp01(t)
return u * u
}

func ease_out_quad(t: f64) -> f64 {
let u = clamp01(t)
let s = 1.0 - u
return 1.0 - s * s
}

func ease_in_cubic(t: f64) -> f64 {
let u = clamp01(t)
return u * u * u
}

func ease_out_cubic(t: f64) -> f64 {
let u = 1.0 - clamp01(t)
return 1.0 - u * u * u
}

func ease_in_out(t: f64) -> f64 {
let u = clamp01(t)
if u < 0.5 {
return 2.0 * u * u
}
let s = 1.0 - u
return 1.0 - 2.0 * s * s
}

func ease_in_out_cubic(t: f64) -> f64 {
let u = clamp01(t)
if u < 0.5 {
return 4.0 * u * u * u
}
let s = 1.0 - u
return 1.0 - 4.0 * s * s * s
}

func ease_out_bounce(t: f64) -> f64 {
let u = clamp01(t)
let n1 = 7.5625
let d1 = 2.75
if u < 1.0 / d1 {
return n1 * u * u
}
if u < 2.0 / d1 {
let s = u - 1.5
return n1 * (s / 1.0) * (s / 1.0) + 0.75
}
if u < 2.5 / d1 {
let s = u - 2.25
return n1 * (s / 0.5) * (s / 0.5) + 0.9375
}
let s = u - 2.625
return n1 * (s / 0.25) * (s / 0.25) + 0.984375
}

func norm(v: f64, lo: f64, hi: f64) -> f64 {
return inv_lerp(lo, hi, v)
}

func lerp_clamped(a: f64, b: f64, t: f64) -> f64 {
return lerp(a, b, clamp01(t))
}

func inv_lerp_clamped(a: f64, b: f64, v: f64) -> f64 {
return clamp01(inv_lerp(a, b, v))
}

func remap_clamped(in_lo: f64, in_hi: f64, out_lo: f64, out_hi: f64, v: f64) -> f64 {
let t = clamp01(inv_lerp(in_lo, in_hi, v))
return out_lo + (out_hi - out_lo) * t
}

func angle_of(x: f64, y: f64) -> f64 {
return atan2(y, x)
}

func from_angle(a: f64, radius: f64) -> f64 {
return cos(a) * radius
}

func from_angle_y(a: f64, radius: f64) -> f64 {
return sin(a) * radius
}

func angle_delta(a: f64, b: f64) -> f64 {
let d = wrap(b - a, -M_PI, M_PI)
return d
}

func lerp_angle(a: f64, b: f64, t: f64) -> f64 {
let d = angle_delta(a, b)
return a + d * clamp01(t)
}

func reflect(incident: f64, normal: f64) -> f64 {
let d = incident * normal
return 2.0 * normal * d - incident
}

func det2(a: f64, b: f64, c: f64, d: f64) -> f64 {
return a * d - b * c
}

func trace2(a: f64, b: f64, c: f64, d: f64) -> f64 {
return a + d
}

func mat2_apply_x(a: f64, b: f64, c: f64, d: f64, x: f64, y: f64) -> f64 {
return a * x + b * y
}

func mat2_apply_y(a: f64, b: f64, c: f64, d: f64, x: f64, y: f64) -> f64 {
return c * x + d * y
}

func circle_area(r: f64) -> f64 {
return M_PI * r * r
}

func circle_circum(r: f64) -> f64 {
return M_TAU * r
}

func sphere_volume(r: f64) -> f64 {
return 4.0 / 3.0 * M_PI * r * r * r
}

func sphere_surface(r: f64) -> f64 {
return 4.0 * M_PI * r * r
}

func hypotenuse(a: f64, b: f64) -> f64 {
return sqrt(a * a + b * b)
}

func law_of_cosines(a: f64, b: f64, cos_c: f64) -> f64 {
return sqrt(a * a + b * b - 2.0 * a * b * cos_c)
}

func law_of_sines_angle(side: f64, other: f64, sin_other: f64) -> f64 {
guard other != 0.0 else {
return 0.0
}
return asin_approx(side * sin_other / other)
}

func asin_approx(x: f64) -> f64 {
let u = clamp(x, -1.0, 1.0)
return atan2(u, sqrt(1.0 - u * u))
}

func triangle_area(base: f64, height: f64) -> f64 {
return 0.5 * base * height
}

func polygon_shoelace_term(x1: f64, y1: f64, x2: f64, y2: f64) -> f64 {
return det2(x1, y1, x2, y2)
}

func average2(a: f64, b: f64) -> f64 {
return (a + b) / 2.0
}

func average3(a: f64, b: f64, c: f64) -> f64 {
return (a + b + c) / 3.0
}

func midpoint(a: f64, b: f64) -> f64 {
return (a + b) / 2.0
}

func percent(part: f64, whole: f64) -> f64 {
guard whole != 0.0 else {
return 0.0
}
return part / whole * 100.0
}

func sign_f(x: f64) -> f64 {
if x > 0.0 {
return 1.0
}
if x < 0.0 {
return -1.0
}
return 0.0
}

func step_edge(edge: f64, x: f64) -> f64 {
if x < edge {
return 0.0
}
return 1.0
}

func frac_part(x: f64) -> f64 {
return x - floor(x)
}

func recip(x: f64) -> f64 {
guard x != 0.0 else {
return 0.0
}
return 1.0 / x
}

func sq(x: f64) -> f64 {
return x * x
}

func cube(x: f64) -> f64 {
return x * x * x
}

func abs_f(x: f64) -> f64 {
if x < 0.0 {
return -x
}
return x
}

func max_f(a: f64, b: f64) -> f64 {
if a > b {
return a
}
return b
}

func min_f(a: f64, b: f64) -> f64 {
if a < b {
return a
}
return b
}

func move_towards(current: f64, target: f64, max_delta: f64) -> f64 {
guard max_delta >= 0.0 else {
return current
}
let d = target - current
if abs_f(d) <= max_delta {
return target
}
return current + sign_f(d) * max_delta
}

func damp(a: f64, b: f64, smoothing: f64, dt: f64) -> f64 {
guard dt != 0.0 else {
return a
}
let k = 1.0 - pow(smoothing, dt)
return a + (b - a) * k
}

func clamp_i(v: int, lo: int, hi: int) -> int {
if v < lo {
return lo
}
if v > hi {
return hi
}
return v
}

func abs_i(x: int) -> int {
if x < 0 {
return -x
}
return x
}

func sign_i(x: int) -> int {
if x > 0 {
return 1
}
if x < 0 {
return -1
}
return 0
}

func max3_i(a: int, b: int, c: int) -> int {
if a >= b && a >= c {
return a
}
if b >= c {
return b
}
return c
}

func min3_i(a: int, b: int, c: int) -> int {
if a <= b && a <= c {
return a
}
if b <= c {
return b
}
return c
}

func is_even(x: int) -> bool {
return x % 2 == 0
}

func is_odd(x: int) -> bool {
return x % 2 != 0
}

func tri_num(n: int) -> int {
if n < 0 {
return 0
}
return n * (n + 1) / 2
}

func wrap_i(v: int, n: int) -> int {
guard n != 0 else {
return 0
}
let r = v % n
if r < 0 {
return r + n
}
return r
}

func digit_count(n: int) -> int {
let x = abs_i(n)
let count = 1
while x >= 10 {
x = x / 10
count = count + 1
}
return count
}

func digit_sum(n: int) -> int {
let x = abs_i(n)
let acc = 0
while x > 0 {
acc = acc + x % 10
x = x / 10
}
return acc
}

func reverse_digits(n: int) -> int {
let x = abs_i(n)
let acc = 0
while x > 0 {
acc = acc * 10 + x % 10
x = x / 10
}
return acc
}

func gcd_i(a: int, b: int) -> int {
let x = abs_i(a)
let y = abs_i(b)
while y != 0 {
let t = x % y
x = y
y = t
}
return x
}

func lcm_i(a: int, b: int) -> int {
guard a != 0 && b != 0 else {
return 0
}
return abs_i(a) / gcd_i(a, b) * abs_i(b)
}

func pow_mod(base: int, exp: int, m: int) -> int {
guard m > 1 && exp >= 0 else {
return 0
}
let acc = 1
let b = base % m
let e = exp
while e > 0 {
if is_odd(e) {
acc = acc * b % m
}
b = b * b % m
e = e / 2
}
return acc
}

func lerp_i(a: int, b: int, t: int, scale: int) -> int {
guard scale > 0 else {
return a
}
return a + (b - a) * t / scale
}

func average_i(a: int, b: int) -> int {
return (a + b) / 2
}
