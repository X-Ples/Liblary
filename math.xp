pub const PI: f64        = @pi;
pub const TAU: f64       = @tau;
pub const E: f64         = @euler;
pub const PHI: f64       = @phi;
pub const HALF_PI: f64   = 1.5707963267948966;
pub const QUARTER_PI: f64 = 0.7853981633974483;
pub const INV_PI: f64    = 0.3183098861837907;
pub const SQRT2: f64     = 1.4142135623730951;
pub const SQRT3: f64     = 1.7320508075688772;
pub const SQRT_PI: f64   = 1.7724538509055159;
pub const LN2: f64       = 0.6931471805599453;
pub const LN10: f64      = 2.302585092994046;
pub const LOG2_E: f64    = 1.4426950408889634;
pub const LOG10_E: f64   = 0.4342944819032518;
pub const EULER_GAMMA: f64 = 0.5772156649015329; 
pub const DEG2RAD: f64   = 0.017453292519943295;
pub const RAD2DEG: f64   = 57.29577951308232;
pub const EPSILON: f64   = 2.220446049250313e-16;
pub const EARTH_RADIUS_KM: f64 = 6371.0088;
pub const C_LIGHT: f64   = 299792458.0;
pub const G_GRAV: f64    = 6.6743e-11;
pub const G_EARTH: f64   = 9.80665;
pub const PLANCK: f64    = 6.62607015e-34;
pub const BOLTZMANN: f64 = 1.380649e-23;
pub const AVOGADRO: f64  = 6.02214076e23;
pub const I64_MAX: i64   = 9223372036854775807;


pub fn sign(x: f64) -> f64 {
    if x > 0.0 { return 1.0; }
    if x < 0.0 { return -1.0; }
    return 0.0;
}

pub fn sign_i(x: i64) -> i64 {
    if x > 0 { return 1; }
    if x < 0 { return -1; }
    return 0;
}

pub fn square(x: f64) -> f64 { return x * x; }
pub fn cube(x: f64) -> f64 { return x * x * x; }

pub fn clamp(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

pub fn clamp_i(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

pub fn saturate(x: f64) -> f64 { return clamp(x, 0.0, 1.0); }

pub fn trunc(x: f64) -> f64 {
    if x < 0.0 { return ceil(x); }
    return floor(x);
}

pub fn fract(x: f64) -> f64 { return x - floor(x); }

pub fn fmod(a: f64, b: f64) -> f64 { return a - b * floor(a / b); }

pub fn mod_i(a: i64, b: i64) -> i64 {
    r := a % b;
    if r != 0 && ((r < 0) != (b < 0)) {
        r = r + b;
    }
    return r;
}

pub fn wrap_range(x: f64, lo: f64, hi: f64) -> f64 {
    return lo + fmod(x - lo, hi - lo);
}

pub fn round_to(x: f64, digits: i64) -> f64 {
    p := pow(10.0, digits as f64);
    return round(x * p) / p;
}

pub fn round_to_multiple(x: f64, step: f64) -> f64 { return round(x / step) * step; }

pub fn approx_eq(a: f64, b: f64, tol: f64) -> bool { return abs(a - b) <= tol; }

pub fn is_nan(x: f64) -> bool { return x != x; }

pub fn is_inf(x: f64) -> bool { return x > 1.7976931348623157e308 || x < -1.7976931348623157e308; }

pub fn is_finite(x: f64) -> bool { return !is_nan(x) && !is_inf(x); }

pub fn hypot(a: f64, b: f64) -> f64 {
    ax := abs(a);
    ay := abs(b);
    big := max(ax, ay);
    if big == 0.0 { return 0.0; }
    sm := min(ax, ay) / big;
    return big * sqrt(1.0 + sm * sm);
}

pub fn hypot3(a: f64, b: f64, c: f64) -> f64 { return sqrt(a * a + b * b + c * c); }

pub fn cbrt(x: f64) -> f64 {
    if x < 0.0 { return -pow(-x, 1.0 / 3.0); }
    return pow(x, 1.0 / 3.0);
}

pub fn root_n(x: f64, n: i64) -> Result<f64, string> {
    if n == 0 { return Err("root_n: n tidak boleh 0"); }
    if x < 0.0 {
        if n % 2 == 0 { return Err("root_n: akar genap dari bilangan negatif"); }
        return Ok(-pow(-x, 1.0 / (n as f64)));
    }
    return Ok(pow(x, 1.0 / (n as f64)));
}

pub fn safe_sqrt(x: f64) -> Result<f64, string> {
    if x < 0.0 { return Err("safe_sqrt: input negatif"); }
    return Ok(sqrt(x));
}

pub fn safe_ln(x: f64) -> Result<f64, string> {
    if x <= 0.0 { return Err("safe_ln: input harus > 0"); }
    return Ok(ln(x));
}

pub fn safe_div(a: f64, b: f64) -> Result<f64, string> {
    if b == 0.0 { return Err("safe_div: pembagian dengan nol"); }
    return Ok(a / b);
}

pub fn log_base(x: f64, base: f64) -> Result<f64, string> {
    if x <= 0.0 { return Err("log_base: x harus > 0"); }
    if base <= 0.0 || base == 1.0 { return Err("log_base: basis tidak valid"); }
    return Ok(ln(x) / ln(base));
}

pub fn log1p(x: f64) -> f64 {
    if abs(x) < 1e-5 { return x - x * x / 2.0 + x * x * x / 3.0; }
    return ln(1.0 + x);
}

pub fn expm1(x: f64) -> f64 {
    if abs(x) < 1e-5 { return x + x * x / 2.0 + x * x * x / 6.0; }
    return exp(x) - 1.0;
}

pub fn lerp(a: f64, b: f64, t: f64) -> f64 { return a + (b - a) * t; }

pub fn inverse_lerp(a: f64, b: f64, v: f64) -> Result<f64, string> {
    if a == b { return Err("inverse_lerp: a == b"); }
    return Ok((v - a) / (b - a));
}

pub fn remap(v: f64, in_lo: f64, in_hi: f64, out_lo: f64, out_hi: f64) -> Result<f64, string> {
    t := inverse_lerp(in_lo, in_hi, v)?;
    return Ok(lerp(out_lo, out_hi, t));
}

pub fn step(edge: f64, x: f64) -> f64 {
    if x < edge { return 0.0; }
    return 1.0;
}

pub fn smoothstep(e0: f64, e1: f64, x: f64) -> f64 {
    t := clamp((x - e0) / (e1 - e0), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

pub fn smootherstep(e0: f64, e1: f64, x: f64) -> f64 {
    t := clamp((x - e0) / (e1 - e0), 0.0, 1.0);
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

pub fn ease_in_quad(t: f64) -> f64 { return t * t; }
pub fn ease_out_quad(t: f64) -> f64 { return t * (2.0 - t); }
pub fn ease_in_out_cubic(t: f64) -> f64 {
    if t < 0.5 { return 4.0 * t * t * t; }
    u := -2.0 * t + 2.0;
    return 1.0 - u * u * u / 2.0;
}

pub fn sigmoid(x: f64) -> f64 {
    if x >= 0.0 { return 1.0 / (1.0 + exp(-x)); }
    e := exp(x);
    return e / (1.0 + e);
}
pub fn logit(p: f64) -> Result<f64, string> {
    if p <= 0.0 || p >= 1.0 { return Err("logit: p harus di (0,1)"); }
    return Ok(ln(p / (1.0 - p)));
}
pub fn relu(x: f64) -> f64 { return max(0.0, x); }
pub fn leaky_relu(x: f64, a: f64) -> f64 {
    if x >= 0.0 { return x; }
    return a * x;
}
pub fn softplus(x: f64) -> f64 {
    if x > 30.0 { return x; }
    return ln(1.0 + exp(x));
}

pub fn fast_sin(x: f64) -> f64  { return __builtin_fast_sin(x); }
pub fn fast_cos(x: f64) -> f64  { return __builtin_fast_cos(x); }
pub fn fast_tan(x: f64) -> f64  { return __builtin_fast_tan(x); }
pub fn fast_sqrt(x: f64) -> f64 { return __builtin_fast_sqrt(x); }
pub fn fast_ln(x: f64) -> f64   { return __builtin_fast_ln(x); }
pub fn fast_exp(x: f64) -> f64  { return __builtin_fast_exp(x); }
pub fn fast_log(x: f64) -> f64  { return __builtin_fast_log(x); }


pub fn radians(deg: f64) -> f64 { return deg * DEG2RAD; }
pub fn degrees(rad: f64) -> f64 { return rad * RAD2DEG; }

pub fn sec(x: f64) -> f64 { return 1.0 / cos(x); }
pub fn csc(x: f64) -> f64 { return 1.0 / sin(x); }
pub fn cot(x: f64) -> f64 { return cos(x) / sin(x); }

pub fn sinc(x: f64) -> f64 {
    if abs(x) < 1e-8 { return 1.0; }
    return sin(x) / x;
}

pub fn sinh(x: f64) -> f64 {
    if abs(x) < 1e-5 { return x + x * x * x / 6.0; }
    return (exp(x) - exp(-x)) / 2.0;
}

pub fn cosh(x: f64) -> f64 { return (exp(x) + exp(-x)) / 2.0; }

pub fn tanh(x: f64) -> f64 {
    if x > 20.0 { return 1.0; }
    if x < -20.0 { return -1.0; }
    e2 := exp(2.0 * x);
    return (e2 - 1.0) / (e2 + 1.0);
}

pub fn asinh(x: f64) -> f64 {
    if x < 0.0 { return -asinh(-x); }
    return ln(x + sqrt(x * x + 1.0));
}

pub fn acosh(x: f64) -> Result<f64, string> {
    if x < 1.0 { return Err("acosh: x harus >= 1"); }
    return Ok(ln(x + sqrt(x * x - 1.0)));
}

pub fn atanh(x: f64) -> Result<f64, string> {
    if x <= -1.0 || x >= 1.0 { return Err("atanh: x harus di (-1,1)"); }
    return Ok(0.5 * ln((1.0 + x) / (1.0 - x)));
}

pub fn normalize_angle(rad: f64) -> f64 { return rad - TAU * floor((rad + PI) / TAU); }

pub fn angle_diff(a: f64, b: f64) -> f64 { return normalize_angle(b - a); }

pub fn lerp_angle(a: f64, b: f64, t: f64) -> f64 { return a + angle_diff(a, b) * t; }

pub fn versin(x: f64) -> f64 { return 1.0 - cos(x); }
pub fn haversin(x: f64) -> f64 { s := sin(x / 2.0); return s * s; }


pub fn gcd(a: i64, b: i64) -> i64 {
    x := abs(a);
    y := abs(b);
    loop y != 0 {
        t := y;
        y = x % y;
        x = t;
    }
    return x;
}

pub fn lcm(a: i64, b: i64) -> i64 {
    if a == 0 || b == 0 { return 0; }
    return abs((a / gcd(a, b)) * b);
}

pub fn gcd_many(xs) -> i64 {
    g := 0;
    n := len(xs) as i64;
    for i in 0..n { g = gcd(g, xs[i]); }
    return g;
}

pub struct Egcd { g: i64; x: i64; y: i64; }

pub fn ext_gcd(a: i64, b: i64) -> Egcd {
    old_r := a; r := b;
    old_s := 1; s := 0;
    old_t := 0; t := 1;
    loop r != 0 {
        q := old_r / r;
        tmp := r;      r = old_r - q * r;      old_r = tmp;
        tmp = s;       s = old_s - q * s;      old_s = tmp;
        tmp = t;       t = old_t - q * t;      old_t = tmp;
    }
    res := Egcd { g: old_r, x: old_s, y: old_t };
    return res;
}

pub fn mod_inverse(a: i64, m: i64) -> Result<i64, string> {
    if m <= 1 { return Err("mod_inverse: modulus harus > 1"); }
    e := ext_gcd(mod_i(a, m), m);
    if e.g != 1 { return Err("mod_inverse: a dan m tidak koprima"); }
    return Ok(mod_i(e.x, m));
}

pub fn mul_mod(a: i64, b: i64, m: i64) -> i64 {
    res := 0;
    x := mod_i(a, m);
    y := mod_i(b, m);
    loop y > 0 {
        if y % 2 == 1 { res = (res + x) % m; }
        x = (x * 2) % m;
        y = y / 2;
    }
    return res;
}

pub fn pow_mod(base: i64, exp_: i64, m: i64) -> Result<i64, string> {
    if m <= 0 { return Err("pow_mod: modulus harus > 0"); }
    if exp_ < 0 { return Err("pow_mod: eksponen negatif"); }
    if m == 1 { return Ok(0); }
    res := 1;
    b := mod_i(base, m);
    e := exp_;
    loop e > 0 {
        if e % 2 == 1 { res = mul_mod(res, b, m); }
        b = mul_mod(b, b, m);
        e = e / 2;
    }
    return Ok(res);
}

pub fn pow_int(base: i64, exp_: i64) -> Result<i64, string> {
    if exp_ < 0 { return Err("pow_int: eksponen negatif"); }
    r := 1;
    b := base;
    e := exp_;
    loop e > 0 {
        if e % 2 == 1 { r = r * b; }
        e = e / 2;
        if e > 0 { b = b * b; }
    }
    return Ok(r);
}

pub fn isqrt(n: i64) -> Result<i64, string> {
    if n < 0 { return Err("isqrt: n negatif"); }
    if n < 2 { return Ok(n); }
    x := floor(sqrt(n as f64)) as i64;
    loop x * x > n { x -= 1; }
    loop (x + 1) * (x + 1) <= n { x += 1; }
    return Ok(x);
}

pub fn is_perfect_square(n: i64) -> bool {
    if n < 0 { return false; }
    match isqrt(n) {
        Ok(r) => { return r * r == n; }
        Err(e) => { return false; }
    }
}

pub fn is_prime(n: i64) -> bool {
    if n < 2 { return false; }
    if n < 4 { return true; }
    if n % 2 == 0 || n % 3 == 0 { return false; }
    i := 5;
    loop i * i <= n {
        if n % i == 0 || n % (i + 2) == 0 { return false; }
        i += 6;
    }
    return true;
}

pub fn next_prime(n: i64) -> i64 {
    c := n + 1;
    if c < 2 { c = 2; }
    loop !is_prime(c) { c += 1; }
    return c;
}

pub fn prev_prime(n: i64) -> Result<i64, string> {
    c := n - 1;
    loop c >= 2 {
        if is_prime(c) { return Ok(c); }
        c -= 1;
    }
    return Err("prev_prime: tidak ada prima lebih kecil");
}

pub fn primes_up_to(n: i64) {
    out := [];
    if n < 2 { return out; }
    flags := [];
    for i in 0..(n + 1) { push(flags, true); }
    flags[0] = false;
    flags[1] = false;
    p := 2;
    loop p * p <= n {
        if flags[p] {
            k := p * p;
            loop k <= n { flags[k] = false; k += p; }
        }
        p += 1;
    }
    for i in 2..(n + 1) {
        if flags[i] { push(out, i); }
    }
    return out;
}

pub fn prime_count(n: i64) -> i64 { return len(primes_up_to(n)) as i64; }

pub fn prime_factors(n: i64) {
    out := [];
    m := n;
    if m < 2 { return out; }
    loop m % 2 == 0 { push(out, 2); m = m / 2; }
    d := 3;
    loop d * d <= m {
        loop m % d == 0 { push(out, d); m = m / d; }
        d += 2;
    }
    if m > 1 { push(out, m); }
    return out;
}

pub fn euler_phi(n: i64) -> i64 {
    if n < 1 { return 0; }
    result := n;
    m := n;
    p := 2;
    loop p * p <= m {
        if m % p == 0 {
            loop m % p == 0 { m = m / p; }
            result = result - result / p;
        }
        p += 1;
    }
    if m > 1 { result = result - result / m; }
    return result;
}

pub fn divisors(n: i64) {
    out := [];
    if n < 1 { return out; }
    for i in 1..(n + 1) {
        if i * i > n { break; }
        if n % i == 0 {
            push(out, i);
            if i * i != n { push(out, n / i); }
        }
    }
    return sorted(out);
}

pub fn divisor_count(n: i64) -> i64 { return len(divisors(n)) as i64; }
pub fn divisor_sum(n: i64) -> i64 { return sum(divisors(n)); }

pub fn is_perfect_number(n: i64) -> bool {
    if n < 2 { return false; }
    return divisor_sum(n) == 2 * n;
}

pub fn digit_sum(n: i64) -> i64 {
    m := abs(n);
    s := 0;
    loop m > 0 { s += m % 10; m = m / 10; }
    return s;
}

pub fn digit_count(n: i64) -> i64 {
    if n == 0 { return 1; }
    m := abs(n);
    c := 0;
    loop m > 0 { c += 1; m = m / 10; }
    return c;
}

pub fn reverse_digits(n: i64) -> i64 {
    m := abs(n);
    r := 0;
    loop m > 0 { r = r * 10 + m % 10; m = m / 10; }
    return sign_i(n) * r;
}

pub fn is_palindrome_num(n: i64) -> bool {
    if n < 0 { return false; }
    return n == reverse_digits(n);
}

pub fn collatz_steps(n: i64) -> Result<i64, string> {
    if n < 1 { return Err("collatz_steps: n harus >= 1"); }
    x := n;
    steps := 0;
    loop x != 1 {
        if x % 2 == 0 { x = x / 2; } else { x = 3 * x + 1; }
        steps += 1;
    }
    return Ok(steps);
}

pub fn fibonacci(n: i64) -> Result<i64, string> {
    if n < 0 { return Err("fibonacci: n negatif"); }
    if n > 92 { return Err("fibonacci: n > 92 overflow i64"); }
    a := 0;
    b := 1;
    for i in 0..n { t := a + b; a = b; b = t; }
    return Ok(a);
}

pub fn fibonacci_f64(n: f64) -> f64 { return round(pow(PHI, n) / SQRT5()); }
fn SQRT5() -> f64 { return 2.23606797749979; }


pub fn factorial(n: i64) -> Result<i64, string> {
    if n < 0 { return Err("factorial: n negatif"); }
    if n > 20 { return Err("factorial: n > 20 overflow i64 (pakai factorial_f64)"); }
    r := 1;
    for i in 2..(n + 1) { r = r * i; }
    return Ok(r);
}

pub fn factorial_f64(n: i64) -> Result<f64, string> {
    if n < 0 { return Err("factorial_f64: n negatif"); }
    if n > 170 { return Err("factorial_f64: n > 170 overflow f64"); }
    return Ok(round(gamma((n as f64) + 1.0)));
}

pub fn double_factorial(n: i64) -> Result<i64, string> {
    if n < 0 { return Err("double_factorial: n negatif"); }
    r := 1;
    k := n;
    loop k > 1 { r = r * k; k -= 2; }
    return Ok(r);
}

pub fn binomial(n: i64, k: i64) -> Result<i64, string> {
    if n < 0 || k < 0 || k > n { return Err("binomial: butuh 0 <= k <= n"); }
    kk := min(k, n - k);
    r := 1;
    for i in 0..kk {
        r = r * (n - i) / (i + 1);
    }
    return Ok(r);
}

pub fn permutations(n: i64, k: i64) -> Result<i64, string> {
    if n < 0 || k < 0 || k > n { return Err("permutations: butuh 0 <= k <= n"); }
    r := 1;
    for i in 0..k { r = r * (n - i); }
    return Ok(r);
}

pub fn catalan(n: i64) -> Result<i64, string> {
    if n < 0 { return Err("catalan: n negatif"); }
    if n > 33 { return Err("catalan: n > 33 overflow i64"); }
    c := binomial(2 * n, n)?;
    return Ok(c / (n + 1));
}

pub fn stirling2(n: i64, k: i64) -> Result<i64, string> {
    if n < 0 || k < 0 || k > n { return Err("stirling2: butuh 0 <= k <= n"); }
    if n == 0 && k == 0 { return Ok(1); }
    if k == 0 { return Ok(0); }
    prev := [];
    for j in 0..(k + 1) { push(prev, 0); }
    prev[0] = 1;
    for i in 1..(n + 1) {
        cur := [];
        for j in 0..(k + 1) { push(cur, 0); }
        for j in 1..(k + 1) { cur[j] = (j * prev[j]) + prev[j - 1]; }
        for j in 0..(k + 1) { prev[j] = cur[j]; }
    }
    return Ok(prev[k]);
}

pub fn pascal_row(n: i64) {
    row := [];
    push(row, 1);
    for i in 0..n {
        nxt := [];
        push(nxt, 1);
        m := len(row) as i64;
        for j in 1..m { push(nxt, row[j - 1] + row[j]); }
        push(nxt, 1);
        row = nxt;
    }
    return row;
}

pub fn ln_gamma(x: f64) -> f64 {
    if x < 0.5 {
        return ln(PI / abs(sin(PI * x))) - ln_gamma(1.0 - x);
    }
    c := [0.99999999999980993, 676.5203681218851, -1259.1392167224028,
          771.32342877765313, -176.61502916214059, 12.507343278686905,
          -0.13857109526572012, 0.0000099843695780195716,
          0.00000015056327351493116];
    z := x - 1.0;
    a := c[0];
    for i in 1..9 { a += c[i] / (z + (i as f64)); }
    t := z + 7.5;
    return 0.5 * ln(TAU) + (z + 0.5) * ln(t) - t + ln(a);
}

pub fn gamma(x: f64) -> f64 {
    if x < 0.5 { return PI / (sin(PI * x) * gamma(1.0 - x)); }
    return exp(ln_gamma(x));
}

pub fn beta(a: f64, b: f64) -> f64 {
    return exp(ln_gamma(a) + ln_gamma(b) - ln_gamma(a + b));
}

pub fn erf(x: f64) -> f64 {
    ax := abs(x);
    if ax > 6.0 { return sign(x); }
    term := ax;
    total := ax;
    x2 := 2.0 * ax * ax;
    n := 0;
    loop n < 300 {
        term = term * x2 / ((2 * n + 3) as f64);
        total += term;
        if term < 1e-17 * total { break; }
        n += 1;
    }
    r := (2.0 / SQRT_PI) * exp(-ax * ax) * total;
    return sign(x) * r;
}

pub fn erfc(x: f64) -> f64 { return 1.0 - erf(x); }

pub fn digamma(x: f64) -> f64 {
    v := x;
    r := 0.0;
    loop v < 6.0 { r -= 1.0 / v; v += 1.0; }
    f := 1.0 / (v * v);
    return r + ln(v) - 0.5 / v
        - f * (1.0/12.0 - f * (1.0/120.0 - f * (1.0/252.0 - f * (1.0/240.0 - f / 132.0))));
}

pub fn zeta(s: f64) -> Result<f64, string> {
    if s <= 1.0 { return Err("zeta: s harus > 1"); }
    n := 20;
    total := 0.0;
    for k in 1..n { total += pow(k as f64, -s); }
    nn := n as f64;
    total += pow(nn, 1.0 - s) / (s - 1.0) + 0.5 * pow(nn, -s)
           + s * pow(nn, -s - 1.0) / 12.0
           - s * (s + 1.0) * (s + 2.0) * pow(nn, -s - 3.0) / 720.0;
    return Ok(total);
}

pub fn lambert_w(x: f64) -> Result<f64, string> {
    if x < -0.36787944117144233 { return Err("lambert_w: x < -1/e"); }
    if x == 0.0 { return Ok(0.0); }
    w := 0.0;
    if x < 1.0 { w = x; } else { w = ln(x); if w < 1.0 { w = 1.0; } }
    for i in 0..64 {
        ew := exp(w);
        f := w * ew - x;
        d := ew * (w + 1.0) - (w + 2.0) * f / (2.0 * w + 2.0);
        if d == 0.0 { break; }
        nw := w - f / d;
        if abs(nw - w) < 1e-14 { w = nw; break; }
        w = nw;
    }
    return Ok(w);
}

pub fn gaussian(x: f64, mu: f64, sigma: f64) -> f64 {
    z := (x - mu) / sigma;
    return exp(-0.5 * z * z) / (sigma * sqrt(TAU));
}

pub fn legendre(n: i64, x: f64) -> f64 {
    if n == 0 { return 1.0; }
    if n == 1 { return x; }
    p0 := 1.0;
    p1 := x;
    for k in 2..(n + 1) {
        kf := k as f64;
        p2 := ((2.0 * kf - 1.0) * x * p1 - (kf - 1.0) * p0) / kf;
        p0 = p1;
        p1 = p2;
    }
    return p1;
}

pub fn chebyshev_t(n: i64, x: f64) -> f64 {
    if n == 0 { return 1.0; }
    if n == 1 { return x; }
    t0 := 1.0;
    t1 := x;
    for k in 2..(n + 1) {
        t2 := 2.0 * x * t1 - t0;
        t0 = t1;
        t1 = t2;
    }
    return t1;
}

pub fn sorted(xs) {
    n := len(xs) as i64;
    out := [];
    for i in 0..n { push(out, xs[i]); }
    for i in 1..n {
        key := out[i];
        j := i;
        loop j > 0 {
            if out[j - 1] <= key { break; }
            out[j] = out[j - 1];
            j -= 1;
        }
        out[j] = key;
    }
    return out;
}

pub fn min_of(xs) -> Result<f64, string> {
    n := len(xs) as i64;
    if n == 0 { return Err("min_of: array kosong"); }
    m := xs[0];
    for i in 1..n { if xs[i] < m { m = xs[i]; } }
    return Ok(m);
}

pub fn max_of(xs) -> Result<f64, string> {
    n := len(xs) as i64;
    if n == 0 { return Err("max_of: array kosong"); }
    m := xs[0];
    for i in 1..n { if xs[i] > m { m = xs[i]; } }
    return Ok(m);
}

pub fn range_of(xs) -> Result<f64, string> {
    lo := min_of(xs)?;
    hi := max_of(xs)?;
    return Ok(hi - lo);
}

pub fn mean(xs) -> Result<f64, string> {
    n := len(xs) as i64;
    if n == 0 { return Err("mean: array kosong"); }
    return Ok(sum(xs) / (n as f64));
}

pub fn geometric_mean(xs) -> Result<f64, string> {
    n := len(xs) as i64;
    if n == 0 { return Err("geometric_mean: array kosong"); }
    acc := 0.0;
    for i in 0..n {
        if xs[i] <= 0.0 { return Err("geometric_mean: semua nilai harus > 0"); }
        acc += ln(xs[i]);
    }
    return Ok(exp(acc / (n as f64)));
}

pub fn harmonic_mean(xs) -> Result<f64, string> {
    n := len(xs) as i64;
    if n == 0 { return Err("harmonic_mean: array kosong"); }
    acc := 0.0;
    for i in 0..n {
        if xs[i] == 0.0 { return Err("harmonic_mean: ada nilai 0"); }
        acc += 1.0 / xs[i];
    }
    return Ok((n as f64) / acc);
}

pub fn rms(xs) -> Result<f64, string> {
    n := len(xs) as i64;
    if n == 0 { return Err("rms: array kosong"); }
    acc := 0.0;
    for i in 0..n { acc += xs[i] * xs[i]; }
    return Ok(sqrt(acc / (n as f64)));
}

pub fn median(xs) -> Result<f64, string> {
    n := len(xs) as i64;
    if n == 0 { return Err("median: array kosong"); }
    s := sorted(xs);
    if n % 2 == 1 { return Ok(s[n / 2]); }
    return Ok((s[n / 2 - 1] + s[n / 2]) / 2.0);
}

pub fn percentile(xs, p: f64) -> Result<f64, string> {
    n := len(xs) as i64;
    if n == 0 { return Err("percentile: array kosong"); }
    if p < 0.0 || p > 100.0 { return Err("percentile: p harus di [0,100]"); }
    s := sorted(xs);
    rank := (p / 100.0) * ((n - 1) as f64);
    lo := floor(rank) as i64;
    hi := ceil(rank) as i64;
    frac := rank - (lo as f64);
    return Ok(s[lo] + (s[hi] - s[lo]) * frac);
}

pub fn iqr(xs) -> Result<f64, string> {
    q1 := percentile(xs, 25.0)?;
    q3 := percentile(xs, 75.0)?;
    return Ok(q3 - q1);
}

pub fn variance(xs, sample: bool) -> Result<f64, string> {
    n := len(xs) as i64;
    if n == 0 { return Err("variance: array kosong"); }
    if sample && n < 2 { return Err("variance: sampel butuh >= 2 data"); }
    m := mean(xs)?;
    acc := 0.0;
    for i in 0..n { d := xs[i] - m; acc += d * d; }
    denom := n as f64;
    if sample { denom = denom - 1.0; }
    return Ok(acc / denom);
}

pub fn std_dev(xs, sample: bool) -> Result<f64, string> {
    v := variance(xs, sample)?;
    return Ok(sqrt(v));
}

pub fn skewness(xs) -> Result<f64, string> {
    n := len(xs) as i64;
    m := mean(xs)?;
    s := std_dev(xs, false)?;
    if s == 0.0 { return Err("skewness: simpangan baku 0"); }
    acc := 0.0;
    for i in 0..n { z := (xs[i] - m) / s; acc += z * z * z; }
    return Ok(acc / (n as f64));
}

pub fn kurtosis(xs) -> Result<f64, string> {
    n := len(xs) as i64;
    m := mean(xs)?;
    s := std_dev(xs, false)?;
    if s == 0.0 { return Err("kurtosis: simpangan baku 0"); }
    acc := 0.0;
    for i in 0..n { z := (xs[i] - m) / s; acc += z * z * z * z; }
    return Ok(acc / (n as f64) - 3.0);
}

pub fn covariance(xs, ys, sample: bool) -> Result<f64, string> {
    n := len(xs) as i64;
    if n != (len(ys) as i64) { return Err("covariance: panjang array beda"); }
    if n == 0 { return Err("covariance: array kosong"); }
    if sample && n < 2 { return Err("covariance: sampel butuh >= 2 data"); }
    mx := mean(xs)?;
    my := mean(ys)?;
    acc := 0.0;
    for i in 0..n { acc += (xs[i] - mx) * (ys[i] - my); }
    denom := n as f64;
    if sample { denom = denom - 1.0; }
    return Ok(acc / denom);
}

pub fn correlation(xs, ys) -> Result<f64, string> {
    c := covariance(xs, ys, false)?;
    sx := std_dev(xs, false)?;
    sy := std_dev(ys, false)?;
    if sx == 0.0 || sy == 0.0 { return Err("correlation: varians 0"); }
    return Ok(c / (sx * sy));
}

pub struct LinReg { slope: f64; intercept: f64; r2: f64; }

pub fn linear_regression(xs, ys) -> Result<LinReg, string> {
    n := len(xs) as i64;
    if n != (len(ys) as i64) { return Err("linear_regression: panjang array beda"); }
    if n < 2 { return Err("linear_regression: butuh >= 2 titik"); }
    mx := mean(xs)?;
    my := mean(ys)?;
    sxx := 0.0;
    sxy := 0.0;
    syy := 0.0;
    for i in 0..n {
        dx := xs[i] - mx;
        dy := ys[i] - my;
        sxx += dx * dx;
        sxy += dx * dy;
        syy += dy * dy;
    }
    if sxx == 0.0 { return Err("linear_regression: semua x sama"); }
    slope := sxy / sxx;
    r2 := 1.0;
    if syy != 0.0 { r2 = (sxy * sxy) / (sxx * syy); }
    fit := LinReg { slope: slope, intercept: my - slope * mx, r2: r2 };
    return Ok(fit);
}

pub fn zscores(xs) {
    n := len(xs) as i64;
    out := [];
    m := 0.0;
    s := 0.0;
    match mean(xs) { Ok(v) => { m = v; } Err(e) => { return out; } }
    match std_dev(xs, false) { Ok(v) => { s = v; } Err(e) => { return out; } }
    for i in 0..n {
        if s == 0.0 { push(out, 0.0); } else { push(out, (xs[i] - m) / s); }
    }
    return out;
}

pub fn normalize_minmax(xs) {
    n := len(xs) as i64;
    out := [];
    lo := 0.0;
    hi := 0.0;
    match min_of(xs) { Ok(v) => { lo = v; } Err(e) => { return out; } }
    match max_of(xs) { Ok(v) => { hi = v; } Err(e) => { return out; } }
    for i in 0..n {
        if hi == lo { push(out, 0.0); } else { push(out, (xs[i] - lo) / (hi - lo)); }
    }
    return out;
}

pub fn cumsum(xs) {
    n := len(xs) as i64;
    out := [];
    acc := 0.0;
    for i in 0..n { acc += xs[i]; push(out, acc); }
    return out;
}

pub fn moving_average(xs, window: i64) {
    n := len(xs) as i64;
    out := [];
    if window < 1 || window > n { return out; }
    acc := 0.0;
    for i in 0..window { acc += xs[i]; }
    push(out, acc / (window as f64));
    for i in window..n {
        acc += xs[i] - xs[i - window];
        push(out, acc / (window as f64));
    }
    return out;
}

pub fn normal_pdf(x: f64, mu: f64, sigma: f64) -> f64 { return gaussian(x, mu, sigma); }

pub fn normal_cdf(x: f64, mu: f64, sigma: f64) -> f64 {
    return 0.5 * (1.0 + erf((x - mu) / (sigma * SQRT2)));
}

pub fn exponential_pdf(x: f64, lambda: f64) -> f64 {
    if x < 0.0 { return 0.0; }
    return lambda * exp(-lambda * x);
}

pub fn exponential_cdf(x: f64, lambda: f64) -> f64 {
    if x < 0.0 { return 0.0; }
    return 1.0 - exp(-lambda * x);
}

pub fn poisson_pmf(k: i64, lambda: f64) -> f64 {
    if k < 0 { return 0.0; }
    kf := k as f64;
    return exp(kf * ln(lambda) - lambda - ln_gamma(kf + 1.0));
}

pub fn binomial_pmf(k: i64, n: i64, p: f64) -> f64 {
    if k < 0 || k > n { return 0.0; }
    nf := n as f64;
    kf := k as f64;
    lc := ln_gamma(nf + 1.0) - ln_gamma(kf + 1.0) - ln_gamma(nf - kf + 1.0);
    return exp(lc + kf * ln(p) + (nf - kf) * ln(1.0 - p));
}

pub fn uniform_pdf(x: f64, a: f64, b: f64) -> f64 {
    if x < a || x > b { return 0.0; }
    return 1.0 / (b - a);
}

pub fn vec_dot(a: vec3, b: vec3) -> f64 { return a .x b; }
pub fn vec_len(a: vec3) -> f64 { return sqrt(a .x a); }
pub fn vec_len_sq(a: vec3) -> f64 { return a .x a; }
pub fn vec_dist(a: vec3, b: vec3) -> f64 { d := b - a; return sqrt(d .x d); }

pub fn vec_cross(a: vec3, b: vec3) -> vec3 {
    return [a.y * b.z - a.z * b.y,
            a.z * b.x - a.x * b.z,
            a.x * b.y - a.y * b.x];
}

pub fn vec_normalize(a: vec3) -> Result<vec3, string> {
    l := sqrt(a .x a);
    if l == 0.0 { return Err("vec_normalize: vektor nol"); }
    return Ok(a / l);
}

pub fn vec_lerp(a: vec3, b: vec3, t: f64) -> vec3 { return a + (b - a) * t; }

pub fn vec_reflect(v: vec3, n: vec3) -> vec3 { return v - n * (2.0 * (v .x n)); }

pub fn vec_project(a: vec3, onto: vec3) -> Result<vec3, string> {
    d := onto .x onto;
    if d == 0.0 { return Err("vec_project: vektor tujuan nol"); }
    return Ok(onto * ((a .x onto) / d));
}

pub fn vec_angle(a: vec3, b: vec3) -> Result<f64, string> {
    la := sqrt(a .x a);
    lb := sqrt(b .x b);
    if la == 0.0 || lb == 0.0 { return Err("vec_angle: vektor nol"); }
    return Ok(acos(clamp((a .x b) / (la * lb), -1.0, 1.0)));
}

pub fn triple_product(a: vec3, b: vec3, c: vec3) -> f64 { return a .x vec_cross(b, c); }

pub fn vec2_dot(a: vec2, b: vec2) -> f64 { return a .x b; }
pub fn vec2_len(a: vec2) -> f64 { return sqrt(a .x a); }
pub fn vec2_cross(a: vec2, b: vec2) -> f64 { return a.x * b.y - a.y * b.x; }
pub fn vec2_dist(a: vec2, b: vec2) -> f64 { d := b - a; return sqrt(d .x d); }
pub fn vec2_angle(a: vec2) -> f64 { return atan2(a.y, a.x); }
pub fn vec2_perp(a: vec2) -> vec2 { return [-a.y, a.x]; }

pub fn vec2_rotate(v: vec2, theta: f64) -> vec2 {
    c := cos(theta);
    s := sin(theta);
    return [v.x * c - v.y * s, v.x * s + v.y * c];
}

pub fn vec2_from_polar(r: f64, theta: f64) -> vec2 { return [r * cos(theta), r * sin(theta)]; }

pub fn vec2_normalize(a: vec2) -> Result<vec2, string> {
    l := sqrt(a .x a);
    if l == 0.0 { return Err("vec2_normalize: vektor nol"); }
    return Ok(a / l);
}

pub fn vec4_dot(a: vec4, b: vec4) -> f64 { return a .x b; }
pub fn vec4_len(a: vec4) -> f64 { return sqrt(a .x a); }

pub fn dot_arr(a, b) -> Result<f64, string> {
    n := len(a) as i64;
    if n != (len(b) as i64) { return Err("dot_arr: dimensi beda"); }
    acc := 0.0;
    for i in 0..n { acc += a[i] * b[i]; }
    return Ok(acc);
}

pub fn norm_arr(a) -> f64 {
    n := len(a) as i64;
    acc := 0.0;
    for i in 0..n { acc += a[i] * a[i]; }
    return sqrt(acc);
}

pub fn norm1_arr(a) -> f64 {
    n := len(a) as i64;
    acc := 0.0;
    for i in 0..n { acc += abs(a[i]); }
    return acc;
}

pub fn norm_inf_arr(a) -> f64 {
    n := len(a) as i64;
    m := 0.0;
    for i in 0..n { if abs(a[i]) > m { m = abs(a[i]); } }
    return m;
}

pub fn dist_arr(a, b) -> Result<f64, string> {
    n := len(a) as i64;
    if n != (len(b) as i64) { return Err("dist_arr: dimensi beda"); }
    acc := 0.0;
    for i in 0..n { d := a[i] - b[i]; acc += d * d; }
    return Ok(sqrt(acc));
}

pub fn add_arr(a, b) {
    n := len(a) as i64;
    out := [];
    for i in 0..n { push(out, a[i] + b[i]); }
    return out;
}

pub fn sub_arr(a, b) {
    n := len(a) as i64;
    out := [];
    for i in 0..n { push(out, a[i] - b[i]); }
    return out;
}

pub fn scale_arr(a, s: f64) {
    n := len(a) as i64;
    out := [];
    for i in 0..n { push(out, a[i] * s); }
    return out;
}

pub fn cosine_similarity(a, b) -> Result<f64, string> {
    d := dot_arr(a, b)?;
    na := norm_arr(a);
    nb := norm_arr(b);
    if na == 0.0 || nb == 0.0 { return Err("cosine_similarity: vektor nol"); }
    return Ok(d / (na * nb));
}


pub struct Complex { re: f64; im: f64; }

pub fn c_new(re: f64, im: f64) -> Complex {
    z := Complex { re: re, im: im };
    return z;
}

pub fn c_from_polar(r: f64, theta: f64) -> Complex {
    z := Complex { re: r * cos(theta), im: r * sin(theta) };
    return z;
}

pub fn c_add(a: Complex, b: Complex) -> Complex {
    z := Complex { re: a.re + b.re, im: a.im + b.im };
    return z;
}

pub fn c_sub(a: Complex, b: Complex) -> Complex {
    z := Complex { re: a.re - b.re, im: a.im - b.im };
    return z;
}

pub fn c_mul(a: Complex, b: Complex) -> Complex {
    z := Complex { re: a.re * b.re - a.im * b.im, im: a.re * b.im + a.im * b.re };
    return z;
}

pub fn c_scale(a: Complex, s: f64) -> Complex {
    z := Complex { re: a.re * s, im: a.im * s };
    return z;
}

pub fn c_conj(a: Complex) -> Complex {
    z := Complex { re: a.re, im: -a.im };
    return z;
}

pub fn c_abs(a: Complex) -> f64 { return hypot(a.re, a.im); }
pub fn c_arg(a: Complex) -> f64 { return atan2(a.im, a.re); }

pub fn c_div(a: Complex, b: Complex) -> Result<Complex, string> {
    d := b.re * b.re + b.im * b.im;
    if d == 0.0 { return Err("c_div: pembagian dengan nol"); }
    z := Complex { re: (a.re * b.re + a.im * b.im) / d, im: (a.im * b.re - a.re * b.im) / d };
    return Ok(z);
}

pub fn c_exp(a: Complex) -> Complex {
    m := exp(a.re);
    z := Complex { re: m * cos(a.im), im: m * sin(a.im) };
    return z;
}

pub fn c_ln(a: Complex) -> Result<Complex, string> {
    r := c_abs(a);
    if r == 0.0 { return Err("c_ln: ln(0) tak terdefinisi"); }
    z := Complex { re: ln(r), im: c_arg(a) };
    return Ok(z);
}

pub fn c_sqrt(a: Complex) -> Complex {
    r := c_abs(a);
    th := c_arg(a) / 2.0;
    z := Complex { re: sqrt(r) * cos(th), im: sqrt(r) * sin(th) };
    return z;
}

pub fn c_pow_int(a: Complex, n: i64) -> Result<Complex, string> {
    r := c_abs(a);
    if r == 0.0 {
        if n > 0 { return Ok(c_new(0.0, 0.0)); }
        return Err("c_pow_int: 0^n dengan n <= 0");
    }
    nf := n as f64;
    return Ok(c_from_polar(pow(r, nf), nf * c_arg(a)));
}

pub fn c_sin(a: Complex) -> Complex { return c_new(sin(a.re) * cosh(a.im), cos(a.re) * sinh(a.im)); }
pub fn c_cos(a: Complex) -> Complex { return c_new(cos(a.re) * cosh(a.im), -sin(a.re) * sinh(a.im)); }

pub fn solve_quadratic(a: f64, b: f64, c: f64) -> Result<[Complex; 2], string> {
    if a == 0.0 { return Err("solve_quadratic: a = 0 (bukan kuadrat)"); }
    disc := b * b - 4.0 * c * a;
    if disc >= 0.0 {
        q := -0.5 * (b + sign(b + 0.0000000000000001) * sqrt(disc));
        r1 := q / a;
        r2 := 0.0;
        if q != 0.0 { r2 = c / q; } else { r2 = r1; }
        return Ok([c_new(r1, 0.0), c_new(r2, 0.0)]);
    }
    sq := sqrt(-disc) / (2.0 * a);
    re := -b / (2.0 * a);
    return Ok([c_new(re, sq), c_new(re, -sq)]);
}

pub fn mat_identity(n: i64) {
    m := [];
    for i in 0..n {
        for j in 0..n {
            if i == j { push(m, 1.0); } else { push(m, 0.0); }
        }
    }
    return m;
}

pub fn mat_zeros(rows: i64, cols: i64) {
    m := [];
    for i in 0..(rows * cols) { push(m, 0.0); }
    return m;
}

pub fn mat_trace(a, n: i64) -> f64 {
    t := 0.0;
    for i in 0..n { t += a[i * n + i]; }
    return t;
}

pub fn mat_transpose(a, rows: i64, cols: i64) {
    out := [];
    for j in 0..cols {
        for i in 0..rows { push(out, a[i * cols + j]); }
    }
    return out;
}

pub fn mat_mul_flat(a, b, r: i64, k: i64, c: i64) {
    out := [];
    for i in 0..r {
        for j in 0..c {
            acc := 0.0;
            for t in 0..k { acc += a[i * k + t] * b[t * c + j]; }
            push(out, acc);
        }
    }
    return out;
}

pub fn mat_vec_mul(a, v, rows: i64, cols: i64) {
    out := [];
    for i in 0..rows {
        acc := 0.0;
        for j in 0..cols { acc += a[i * cols + j] * v[j]; }
        push(out, acc);
    }
    return out;
}

pub fn mat_scale(a, s: f64) {
    n := len(a) as i64;
    out := [];
    for i in 0..n { push(out, a[i] * s); }
    return out;
}

pub fn mat_det(a, n: i64) -> f64 {
    m := [];
    for i in 0..(n * n) { push(m, a[i]); }
    det := 1.0;
    for c in 0..n {
        p := c;
        best := abs(m[c * n + c]);
        for r in (c + 1)..n {
            v := abs(m[r * n + c]);
            if v > best { best = v; p = r; }
        }
        if best < 1e-300 { return 0.0; }
        if p != c {
            for k in 0..n {
                t := m[c * n + k];
                m[c * n + k] = m[p * n + k];
                m[p * n + k] = t;
            }
            det = -det;
        }
        det = det * m[c * n + c];
        for r in (c + 1)..n {
            f := m[r * n + c] / m[c * n + c];
            for k in c..n { m[r * n + k] -= f * m[c * n + k]; }
        }
    }
    return det;
}

pub fn solve_linear(a, b, n: i64) {
    m := [];
    for i in 0..n {
        for j in 0..n { push(m, a[i * n + j]); }
        push(m, b[i]);
    }
    w := n + 1;
    for c in 0..n {
        p := c;
        best := abs(m[c * w + c]);
        for r in (c + 1)..n {
            v := abs(m[r * w + c]);
            if v > best { best = v; p = r; }
        }
        if best < 1e-12 { return Err("solve_linear: matriks singular"); }
        if p != c {
            for k in 0..w {
                t := m[c * w + k];
                m[c * w + k] = m[p * w + k];
                m[p * w + k] = t;
            }
        }
        for r in (c + 1)..n {
            f := m[r * w + c] / m[c * w + c];
            for k in c..w { m[r * w + k] -= f * m[c * w + k]; }
        }
    }
    x := [];
    for i in 0..n { push(x, 0.0); }
    i := n - 1;
    loop i >= 0 {
        acc := m[i * w + n];
        for j in (i + 1)..n { acc -= m[i * w + j] * x[j]; }
        x[i] = acc / m[i * w + i];
        i -= 1;
    }
    return Ok(x);
}

pub fn mat_inverse(a, n: i64) {
    w := 2 * n;
    m := [];
    for i in 0..n {
        for j in 0..n { push(m, a[i * n + j]); }
        for j in 0..n {
            if i == j { push(m, 1.0); } else { push(m, 0.0); }
        }
    }
    for c in 0..n {
        p := c;
        best := abs(m[c * w + c]);
        for r in (c + 1)..n {
            v := abs(m[r * w + c]);
            if v > best { best = v; p = r; }
        }
        if best < 1e-12 { return Err("mat_inverse: matriks singular"); }
        if p != c {
            for k in 0..w {
                t := m[c * w + k];
                m[c * w + k] = m[p * w + k];
                m[p * w + k] = t;
            }
        }
        piv := m[c * w + c];
        for k in 0..w { m[c * w + k] = m[c * w + k] / piv; }
        for r in 0..n {
            if r != c {
                f := m[r * w + c];
                for k in 0..w { m[r * w + k] -= f * m[c * w + k]; }
            }
        }
    }
    out := [];
    for i in 0..n {
        for j in 0..n { push(out, m[i * w + n + j]); }
    }
    return Ok(out);
}

pub fn mat_pow(a, n: i64, p: i64) {
    if p < 0 { return Err("mat_pow: pangkat negatif (pakai mat_inverse dulu)"); }
    result := mat_identity(n);
    base := a;
    e := p;
    loop e > 0 {
        if e % 2 == 1 { result = mat_mul_flat(result, base, n, n, n); }
        e = e / 2;
        if e > 0 { base = mat_mul_flat(base, base, n, n, n); }
    }
    return Ok(result);
}

pub fn mat_rotation2(theta: f64) {
    c := cos(theta);
    s := sin(theta);
    return [c, -s, s, c];
}

pub fn mat_rotation_z3(theta: f64) {
    c := cos(theta);
    s := sin(theta);
    return [c, -s, 0.0, s, c, 0.0, 0.0, 0.0, 1.0];
}

pub fn mat_translation2(tx: f64, ty: f64) {
    return [1.0, 0.0, tx, 0.0, 1.0, ty, 0.0, 0.0, 1.0];
}

pub fn mat_scaling2(sx: f64, sy: f64) {
    return [sx, 0.0, 0.0, 0.0, sy, 0.0, 0.0, 0.0, 1.0];
}

pub fn power_iteration(a, n: i64, iters: i64) -> f64 {
    v := [];
    for i in 0..n { push(v, 1.0); }
    lambda := 0.0;
    for it in 0..iters {
        w := mat_vec_mul(a, v, n, n);
        nrm := norm_arr(w);
        if nrm == 0.0 { return 0.0; }
        for i in 0..n { v[i] = w[i] / nrm; }
        lambda = nrm;
    }
  
    av := mat_vec_mul(a, v, n, n);
    acc := 0.0;
    for i in 0..n { acc += v[i] * av[i]; }
    return acc;
}

pub fn derivative(f, x: f64, h: f64) -> f64 {
    return (f(x + h) - f(x - h)) / (2.0 * h);
}

pub fn derivative2(f, x: f64, h: f64) -> f64 {
    return (f(x + h) - 2.0 * f(x) + f(x - h)) / (h * h);
}

pub fn gradient(f, x, h: f64) {
    n := len(x) as i64;
    g := [];
    for i in 0..n {
        xp := [];
        xm := [];
        for j in 0..n { push(xp, x[j]); push(xm, x[j]); }
        xp[i] = x[i] + h;
        xm[i] = x[i] - h;
        push(g, (f(xp) - f(xm)) / (2.0 * h));
    }
    return g;
}

pub fn integrate_trapezoid(f, a: f64, b: f64, n: i64) -> Result<f64, string> {
    if n < 1 { return Err("integrate_trapezoid: n harus >= 1"); }
    h := (b - a) / (n as f64);
    acc := 0.5 * (f(a) + f(b));
    for i in 1..n { acc += f(a + (i as f64) * h); }
    return Ok(acc * h);
}

pub fn integrate_simpson(f, a: f64, b: f64, n: i64) -> Result<f64, string> {
    if n < 2 { return Err("integrate_simpson: n harus >= 2"); }
    m := n;
    if m % 2 != 0 { m += 1; }
    h := (b - a) / (m as f64);
    acc := f(a) + f(b);
    for i in 1..m {
        w := 2.0;
        if i % 2 == 1 { w = 4.0; }
        acc += w * f(a + (i as f64) * h);
    }
    return Ok(acc * h / 3.0);
}

pub fn integrate_gauss5(f, a: f64, b: f64) -> f64 {
    xs := [0.0, -0.5384693101056831, 0.5384693101056831, -0.9061798459386640, 0.9061798459386640];
    ws := [0.5688888888888889, 0.4786286704993665, 0.4786286704993665, 0.2369268850561891, 0.2369268850561891];
    c := (b - a) / 2.0;
    d := (b + a) / 2.0;
    acc := 0.0;
    for i in 0..5 { acc += ws[i] * f(c * xs[i] + d); }
    return acc * c;
}

pub fn integrate_adaptive(f, a: f64, b: f64, tol: f64) -> f64 {
    m := (a + b) / 2.0;
    whole := (b - a) / 6.0 * (f(a) + 4.0 * f(m) + f(b));
    return adaptive_rec(f, a, b, tol, whole, 0);
}

fn adaptive_rec(f, a: f64, b: f64, tol: f64, whole: f64, depth: i64) -> f64 {
    m := (a + b) / 2.0;
    lm := (a + m) / 2.0;
    rm := (m + b) / 2.0;
    left := (m - a) / 6.0 * (f(a) + 4.0 * f(lm) + f(m));
    right := (b - m) / 6.0 * (f(m) + 4.0 * f(rm) + f(b));
    delta := left + right - whole;
    if depth >= 40 || abs(delta) <= 15.0 * tol { return left + right + delta / 15.0; }
    return adaptive_rec(f, a, m, tol / 2.0, left, depth + 1)
         + adaptive_rec(f, m, b, tol / 2.0, right, depth + 1);
}

pub fn root_bisect(f, a: f64, b: f64, tol: f64) -> Result<f64, string> {
    lo := a;
    hi := b;
    flo := f(lo);
    fhi := f(hi);
    if flo == 0.0 { return Ok(lo); }
    if fhi == 0.0 { return Ok(hi); }
    if flo * fhi > 0.0 { return Err("root_bisect: f(a) dan f(b) harus beda tanda"); }
    iter := 0;
    loop iter < 200 {
        mid := (lo + hi) / 2.0;
        fm := f(mid);
        if fm == 0.0 || (hi - lo) / 2.0 < tol { return Ok(mid); }
        if flo * fm < 0.0 { hi = mid; } else { lo = mid; flo = fm; }
        iter += 1;
    }
    return Ok((lo + hi) / 2.0);
}

pub fn root_newton(f, x0: f64, tol: f64, max_iter: i64) -> Result<f64, string> {
    x := x0;
    for i in 0..max_iter {
        fx := f(x);
        if abs(fx) < tol { return Ok(x); }
        d := derivative(f, x, 0.000001);
        if d == 0.0 { return Err("root_newton: turunan nol"); }
        nx := x - fx / d;
        if abs(nx - x) < tol { return Ok(nx); }
        x = nx;
    }
    return Err("root_newton: tidak konvergen");
}

pub fn root_secant(f, x0: f64, x1: f64, tol: f64, max_iter: i64) -> Result<f64, string> {
    a := x0;
    b := x1;
    fa := f(a);
    fb := f(b);
    for i in 0..max_iter {
        if abs(fb - fa) < 1e-300 { return Err("root_secant: pembagi nol"); }
        c := b - fb * (b - a) / (fb - fa);
        if abs(c - b) < tol { return Ok(c); }
        a = b; fa = fb;
        b = c; fb = f(c);
    }
    return Err("root_secant: tidak konvergen");
}

pub fn minimize_golden(f, a: f64, b: f64, tol: f64) -> f64 {
    gr := 0.6180339887498949;
    lo := a;
    hi := b;
    c := hi - gr * (hi - lo);
    d := lo + gr * (hi - lo);
    fc := f(c);
    fd := f(d);
    loop abs(hi - lo) > tol {
        if fc < fd {
            hi = d; d = c; fd = fc;
            c = hi - gr * (hi - lo); fc = f(c);
        } else {
            lo = c; c = d; fc = fd;
            d = lo + gr * (hi - lo); fd = f(d);
        }
    }
    return (lo + hi) / 2.0;
}

pub fn rk4_step(f, x: f64, y: f64, h: f64) -> f64 {
    k1 := f(x, y);
    k2 := f(x + h / 2.0, y + h * k1 / 2.0);
    k3 := f(x + h / 2.0, y + h * k2 / 2.0);
    k4 := f(x + h, y + h * k3);
    return y + (h / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4);
}

pub fn euler_step(f, x: f64, y: f64, h: f64) -> f64 { return y + h * f(x, y); }

pub fn ode_rk4(f, x0: f64, y0: f64, h: f64, n: i64) {
    ys := [];
    x := x0;
    y := y0;
    push(ys, y);
    for i in 0..n {
        y = rk4_step(f, x, y, h);
        x += h;
        push(ys, y);
    }
    return ys;
}

pub fn poly_eval(coeffs, x: f64) -> f64 {
    n := len(coeffs) as i64;
    r := 0.0;
    i := n - 1;
    loop i >= 0 { r = r * x + coeffs[i]; i -= 1; }
    return r;
}

pub fn poly_derivative(coeffs) {
    n := len(coeffs) as i64;
    out := [];
    for i in 1..n { push(out, coeffs[i] * (i as f64)); }
    return out;
}

pub fn poly_integral(coeffs, c0: f64) {
    n := len(coeffs) as i64;
    out := [];
    push(out, c0);
    for i in 0..n { push(out, coeffs[i] / ((i + 1) as f64)); }
    return out;
}

pub fn poly_mul(a, b) {
    na := len(a) as i64;
    nb := len(b) as i64;
    out := [];
    for i in 0..(na + nb - 1) { push(out, 0.0); }
    for i in 0..na {
        for j in 0..nb { out[i + j] += a[i] * b[j]; }
    }
    return out;
}

pub fn poly_add(a, b) {
    na := len(a) as i64;
    nb := len(b) as i64;
    n := max(na, nb);
    out := [];
    for i in 0..n {
        v := 0.0;
        if i < na { v += a[i]; }
        if i < nb { v += b[i]; }
        push(out, v);
    }
    return out;
}

pub fn lagrange(xs, ys, x: f64) -> f64 {
    n := len(xs) as i64;
    total := 0.0;
    for i in 0..n {
        term := ys[i];
        for j in 0..n {
            if j != i { term = term * (x - xs[j]) / (xs[i] - xs[j]); }
        }
        total += term;
    }
    return total;
}

pub fn interp_linear(xs, ys, x: f64) -> Result<f64, string> {
    n := len(xs) as i64;
    if n < 2 { return Err("interp_linear: butuh >= 2 titik"); }
    if x < xs[0] || x > xs[n - 1] { return Err("interp_linear: x di luar rentang"); }
    for i in 1..n {
        if x <= xs[i] {
            t := (x - xs[i - 1]) / (xs[i] - xs[i - 1]);
            return Ok(lerp(ys[i - 1], ys[i], t));
        }
    }
    return Ok(ys[n - 1]);
}

pub fn sum_series(f, a: i64, b: i64) -> f64 {
    acc := 0.0;
    for k in a..(b + 1) { acc += f(k as f64); }
    return acc;
}

pub fn product_series(f, a: i64, b: i64) -> f64 {
    acc := 1.0;
    for k in a..(b + 1) { acc = acc * f(k as f64); }
    return acc;
}

pub fn circle_area(r: f64) -> f64 { return PI * r * r; }
pub fn circle_circumference(r: f64) -> f64 { return TAU * r; }
pub fn sphere_volume(r: f64) -> f64 { return 4.0 / 3.0 * PI * r * r * r; }
pub fn sphere_area(r: f64) -> f64 { return 4.0 * PI * r * r; }
pub fn cylinder_volume(r: f64, h: f64) -> f64 { return PI * r * r * h; }
pub fn cone_volume(r: f64, h: f64) -> f64 { return PI * r * r * h / 3.0; }
pub fn ellipse_area(a: f64, b: f64) -> f64 { return PI * a * b; }

pub fn ellipse_perimeter(a: f64, b: f64) -> f64 {
    h := ((a - b) * (a - b)) / ((a + b) * (a + b));
    return PI * (a + b) * (1.0 + 3.0 * h / (10.0 + sqrt(4.0 - 3.0 * h)));
}

pub fn triangle_area_heron(a: f64, b: f64, c: f64) -> Result<f64, string> {
    if a <= 0.0 || b <= 0.0 || c <= 0.0 { return Err("heron: sisi harus > 0"); }
    if a + b <= c || a + c <= b || b + c <= a { return Err("heron: ketaksamaan segitiga dilanggar"); }
    s := (a + b + c) / 2.0;
    return Ok(sqrt(s * (s - a) * (s - b) * (s - c)));
}

pub fn triangle_area_pts(x1: f64, y1: f64, x2: f64, y2: f64, x3: f64, y3: f64) -> f64 {
    return abs(x1 * (y2 - y3) + x2 * (y3 - y1) + x3 * (y1 - y2)) / 2.0;
}

pub fn distance2d(x1: f64, y1: f64, x2: f64, y2: f64) -> f64 { return hypot(x2 - x1, y2 - y1); }

pub fn distance3d(x1: f64, y1: f64, z1: f64, x2: f64, y2: f64, z2: f64) -> f64 {
    return hypot3(x2 - x1, y2 - y1, z2 - z1);
}

pub fn manhattan(x1: f64, y1: f64, x2: f64, y2: f64) -> f64 { return abs(x2 - x1) + abs(y2 - y1); }

pub fn polygon_area(xs, ys) -> Result<f64, string> {
    n := len(xs) as i64;
    if n < 3 || n != (len(ys) as i64) { return Err("polygon_area: butuh >= 3 titik, xs/ys sama panjang"); }
    acc := 0.0;
    for i in 0..n {
        j := (i + 1) % n;
        acc += xs[i] * ys[j] - xs[j] * ys[i];
    }
    return Ok(abs(acc) / 2.0);
}

pub fn polygon_perimeter(xs, ys) -> f64 {
    n := len(xs) as i64;
    acc := 0.0;
    for i in 0..n {
        j := (i + 1) % n;
        acc += hypot(xs[j] - xs[i], ys[j] - ys[i]);
    }
    return acc;
}

pub fn regular_polygon_area(n: i64, side: f64) -> f64 {
    return (n as f64) * side * side / (4.0 * tan(PI / (n as f64)));
}

pub fn point_in_circle(px: f64, py: f64, cx: f64, cy: f64, r: f64) -> bool {
    dx := px - cx;
    dy := py - cy;
    return dx * dx + dy * dy <= r * r;
}

pub fn haversine_km(lat1: f64, lon1: f64, lat2: f64, lon2: f64) -> f64 {
    p1 := lat1 * DEG2RAD;
    p2 := lat2 * DEG2RAD;
    dphi := (lat2 - lat1) * DEG2RAD;
    dlam := (lon2 - lon1) * DEG2RAD;
    a := haversin(dphi) + cos(p1) * cos(p2) * haversin(dlam);
    return 2.0 * EARTH_RADIUS_KM * asin(min(1.0, sqrt(a)));
}

pub fn to_polar(x: f64, y: f64) -> vec2 { return [hypot(x, y), atan2(y, x)]; }
pub fn to_cartesian(r: f64, theta: f64) -> vec2 { return [r * cos(theta), r * sin(theta)]; }

pub fn to_spherical(x: f64, y: f64, z: f64) -> vec3 {
    r := hypot3(x, y, z);
    if r == 0.0 { return [0.0, 0.0, 0.0]; }
    return [r, acos(z / r), atan2(y, x)];
}

pub fn rng_next(state: u64) -> u64 {
    s := state;
    s *% 6364136223846793005;
    s +% 1442695040888963407;
    return s;
}

pub fn rng_f64(state: u64) -> f64 {
    return ((state / 2048) as f64) / 9007199254740992.0;
}

pub fn rng_range(state: u64, lo: f64, hi: f64) -> f64 { return lo + (hi - lo) * rng_f64(state); }

pub fn rng_int(state: u64, lo: i64, hi: i64) -> i64 {
    span := (hi - lo + 1) as u64;
    return lo + (((state / 2048) % span) as i64);
}

pub fn rng_normal(s1: u64, s2: u64) -> f64 {
    u1 := max(rng_f64(s1), 1e-300);
    u2 := rng_f64(s2);
    return sqrt(-2.0 * ln(u1)) * cos(TAU * u2);
}

pub fn random_range(lo: f64, hi: f64) -> f64 { return lo + (hi - lo) * random_f64(); }

pub fn random_int(lo: i64, hi: i64) -> i64 {
    return lo + floor(random_f64() * ((hi - lo + 1) as f64)) as i64;
}

pub fn random_bool(p: f64) -> bool { return random_f64() < p; }

pub fn random_normal(mu: f64, sigma: f64) -> f64 {
    u1 := max(random_f64(), 1e-300);
    u2 := random_f64();
    return mu + sigma * sqrt(-2.0 * ln(u1)) * cos(TAU * u2);
}

pub fn random_exponential(lambda: f64) -> f64 {
    u := max(random_f64(), 1e-300);
    return -ln(u) / lambda;
}

pub fn shuffle(xs) {
    n := len(xs) as i64;
    out := [];
    for i in 0..n { push(out, xs[i]); }
    i := n - 1;
    loop i > 0 {
        j := random_int(0, i);
        t := out[i];
        out[i] = out[j];
        out[j] = t;
        i -= 1;
    }
    return out;
}

pub fn monte_carlo_pi(samples: i64) -> f64 {
    inside := 0;
    for i in 0..samples {
        x := random_f64();
        y := random_f64();
        if x * x + y * y <= 1.0 { inside += 1; }
    }
    return 4.0 * (inside as f64) / (samples as f64);
}

pub fn compound_interest(principal: f64, rate: f64, n_per_year: f64, years: f64) -> f64 {
    return principal * pow(1.0 + rate / n_per_year, n_per_year * years);
}

pub fn continuous_compound(principal: f64, rate: f64, years: f64) -> f64 {
    return principal * exp(rate * years);
}

pub fn future_value_annuity(pmt: f64, rate: f64, n: i64) -> f64 {
    if rate == 0.0 { return pmt * (n as f64); }
    return pmt * (pow(1.0 + rate, n as f64) - 1.0) / rate;
}

pub fn present_value(fv: f64, rate: f64, n: i64) -> f64 { return fv / pow(1.0 + rate, n as f64); }

pub fn loan_payment(principal: f64, rate_per_period: f64, n: i64) -> Result<f64, string> {
    if n <= 0 { return Err("loan_payment: n harus > 0"); }
    if rate_per_period == 0.0 { return Ok(principal / (n as f64)); }
    r := rate_per_period;
    return Ok(principal * r / (1.0 - pow(1.0 + r, -(n as f64))));
}

pub fn cagr(start: f64, end_: f64, years: f64) -> Result<f64, string> {
    if start <= 0.0 || years <= 0.0 { return Err("cagr: start dan years harus > 0"); }
    return Ok(pow(end_ / start, 1.0 / years) - 1.0);
}

pub fn npv(rate: f64, cashflows) -> f64 {
    n := len(cashflows) as i64;
    acc := 0.0;
    for t in 0..n { acc += cashflows[t] / pow(1.0 + rate, t as f64); }
    return acc;
}

pub fn irr(cashflows) -> Result<f64, string> {
    lo := -0.99;
    hi := 10.0;
    flo := npv(lo, cashflows);
    fhi := npv(hi, cashflows);
    if flo * fhi > 0.0 { return Err("irr: tidak ada akar di rentang [-99%, 1000%]"); }
    for i in 0..200 {
        mid := (lo + hi) / 2.0;
        fm := npv(mid, cashflows);
        if abs(fm) < 1e-10 { return Ok(mid); }
        if flo * fm < 0.0 { hi = mid; } else { lo = mid; flo = fm; }
    }
    return Ok((lo + hi) / 2.0);
}

pub fn c_to_f(c: f64) -> f64 { return c * 9.0 / 5.0 + 32.0; }
pub fn f_to_c(f: f64) -> f64 { return (f - 32.0) * 5.0 / 9.0; }
pub fn c_to_k(c: f64) -> f64 { return c + 273.15; }
pub fn k_to_c(k: f64) -> f64 { return k - 273.15; }
pub fn km_to_mi(km: f64) -> f64 { return km * 0.621371192237334; }
pub fn mi_to_km(mi: f64) -> f64 { return mi / 0.621371192237334; }
pub fn m_to_ft(m: f64) -> f64 { return m * 3.280839895013123; }
pub fn ft_to_m(ft: f64) -> f64 { return ft / 3.280839895013123; }
pub fn kg_to_lb(kg: f64) -> f64 { return kg * 2.2046226218487757; }
pub fn lb_to_kg(lb: f64) -> f64 { return lb / 2.2046226218487757; }
pub fn kmh_to_ms(v: f64) -> f64 { return v / 3.6; }
pub fn ms_to_kmh(v: f64) -> f64 { return v * 3.6; }
pub fn kinetic_energy(m: f64, v: f64) -> f64 { return 0.5 * m * v * v; }
pub fn potential_energy(m: f64, h: f64) -> f64 { return m * G_EARTH * h; }
pub fn gravity_force(m1: f64, m2: f64, r: f64) -> f64 { return G_GRAV * m1 * m2 / (r * r); }
pub fn escape_velocity(mass: f64, radius: f64) -> f64 { return sqrt(2.0 * G_GRAV * mass / radius); }
pub fn projectile_range(v0: f64, angle_rad: f64) -> f64 { return v0 * v0 * sin(2.0 * angle_rad) / G_EARTH; }
pub fn pendulum_period(length_m: f64) -> f64 { return TAU * sqrt(length_m / G_EARTH); }
pub fn lorentz_gamma(v: f64) -> Result<f64, string> {
    if abs(v) >= C_LIGHT { return Err("lorentz_gamma: |v| harus < c"); }
    b := v / C_LIGHT;
    return Ok(1.0 / sqrt(1.0 - b * b));
}

pub fn linspace(a: f64, b: f64, n: i64) {
    out := [];
    if n < 1 { return out; }
    if n == 1 { push(out, a); return out; }
    step_ := (b - a) / ((n - 1) as f64);
    for i in 0..n { push(out, a + (i as f64) * step_); }
    return out;
}

pub fn arange(a: f64, b: f64, step_: f64) {
    out := [];
    if step_ == 0.0 { return out; }
    x := a;
    if step_ > 0.0 {
        loop x < b { push(out, x); x += step_; }
    } else {
        loop x > b { push(out, x); x += step_; }
    }
    return out;
}

pub fn logspace(a_exp: f64, b_exp: f64, n: i64) {
    exps := linspace(a_exp, b_exp, n);
    out := [];
    for i in 0..n { push(out, pow(10.0, exps[i])); }
    return out;
}

pub fn arithmetic_sum(first: f64, last: f64, n: i64) -> f64 { return (n as f64) * (first + last) / 2.0; }

pub fn geometric_sum(first: f64, ratio: f64, n: i64) -> f64 {
    if ratio == 1.0 { return first * (n as f64); }
    return first * (1.0 - pow(ratio, n as f64)) / (1.0 - ratio);
}

pub fn geometric_sum_inf(first: f64, ratio: f64) -> Result<f64, string> {
    if abs(ratio) >= 1.0 { return Err("geometric_sum_inf: |r| harus < 1"); }
    return Ok(first / (1.0 - ratio));
}

pub fn harmonic_number(n: i64) -> f64 {
    acc := 0.0;
    for k in 1..(n + 1) { acc += 1.0 / (k as f64); }
    return acc;
}

pub fn triangular(n: i64) -> i64 { return n * (n + 1) / 2; }
pub fn sum_squares(n: i64) -> i64 { return n * (n + 1) * (2 * n + 1) / 6; }
pub fn sum_cubes(n: i64) -> i64 { t := triangular(n); return t * t; }
