func demo_kernels(seed: int) -> int {
  let scratch = build_7988(seed % 61 + 6, seed % 55086)
  show(len(scratch))
  show(build_7988_last(scratch))
  show(sweep_2340(1719, 2346))
  show(scan_8502(scratch, 3011))
  show(scan_8502_span(scratch, 2200))
  show(check_4963_chain(1477))
  show(sweep_3540(1134, 3701))
  return seed % 40509
}
