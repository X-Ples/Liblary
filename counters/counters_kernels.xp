func build_7988(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 82316) % 41500)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 82316 + 61583) % 41500
    j += 1
  }
  return buf
}

func build_7988_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_2340(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 76298
  for i in lo..hi {
    if i % 82443 == 0 {
      acc += i * 7570
    } else {
      acc -= i % 89411
    }
    if acc < 0 {
      acc += 41500
    }
    acc = acc % 41500
  }
  return acc
}


func scan_8502(data: [int], seed: int) -> int {
  let acc = seed % 59349
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 25035 + data[i] + i) % 59349
    i += 1
  }
  return acc
}

func scan_8502_span(data: [int], seed: int) -> int {
  let acc = scan_8502(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 25035
}


func check_4963(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 55086 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 13758) % 59349
    i += 1
  }
  return Ok(acc)
}

func check_4963_chain(n: int) -> int {
  let picked = check_4963(n)?
  return picked % 59349
}


func curve_3441_clamp(v: f64) -> f64 {
  guard v >= 11633.0 else {
    return 11633.0
  }
  guard v <= 40509.0 else {
    return 40509.0
  }
  return v
}

func curve_3441_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3441_clamp(t)
  return p + (q - p) * k
}

func curve_3441_ease(t: f64) -> f64 {
  let k = curve_3441_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3441_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


