func sweep_7473(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 78079
  for i in lo..hi {
    if i % 56521 == 0 {
      acc += i * 56135
    } else {
      acc -= i % 50299
    }
    if acc < 0 {
      acc += 23568
    }
    acc = acc % 23568
  }
  return acc
}


func row_4673() -> [int] {
  return [3125, 2018, 1913, 487, 2939, 899, 417, 3313, 1138, 870, 3730]
}

func row_4673_at(i: int) -> int {
  let row = row_4673()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4673_sum(limit: int) -> int {
  let row = row_4673()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4673_best() -> int {
  let row = row_4673()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_5988_clamp(v: f64) -> f64 {
  guard v >= 49276.0 else {
    return 49276.0
  }
  guard v <= 85526.0 else {
    return 85526.0
  }
  return v
}

func curve_5988_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5988_clamp(t)
  return p + (q - p) * k
}

func curve_5988_ease(t: f64) -> f64 {
  let k = curve_5988_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5988_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_7734(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 56521) % 35578)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 56521 + 99964) % 35578
    j += 1
  }
  return buf
}

func build_7734_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_8029(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8029_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func scan_9143(data: [int], seed: int) -> int {
  let acc = seed % 50299
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 78079 + data[i] + i) % 50299
    i += 1
  }
  return acc
}

func scan_9143_span(data: [int], seed: int) -> int {
  let acc = scan_9143(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 78079
}


