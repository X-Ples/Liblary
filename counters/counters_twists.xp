func check_6213(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 66266 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 99964) % 99964
    i += 1
  }
  return Ok(acc)
}

func check_6213_chain(n: int) -> int {
  let picked = check_6213(n)?
  return picked % 99964
}


