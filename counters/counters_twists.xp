func demo_twists(seed: int) -> int {
  let scratch = build_7734(seed % 61 + 6, seed % 11762)
  show(len(scratch))
  show(sweep_7473(1306, 2254))
  show(row_4673_at(80))
  show(row_4673_sum(2166))
  show(row_4673_best())
  show(build_7734_last(scratch))
  return seed % 37869
}
