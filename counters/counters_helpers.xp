func text_6032_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 18701
    i += 1
  }
  return acc % 18701
}

func text_6032_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "ion"
}

func text_6032_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 7893
}


func sweep_222(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 35370
  for i in lo..hi {
    if i % 56549 == 0 {
      acc += i * 93874
    } else {
      acc -= i % 98498
    }
    if acc < 0 {
      acc += 40783
    }
    acc = acc % 40783
  }
  return acc
}


