func demo_bursts(seed: int) -> int {
  let scratch = build_560(seed % 61 + 6, seed % 78433)
  show(len(scratch))
  show(grid_3951_rowsum(scratch, 3752, 2226, 1655))
  show(gate_6376(2176, 3818, 3119))
  show(gate_6376_score(2775, 3960, 2564))
  return seed % 78433
}
