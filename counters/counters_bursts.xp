func row_6386() -> [int] {
  return [3935, 1554, 645, 2850, 1767, 2740, 3912, 3346, 1059, 1526, 2339, 3064, 3017, 1463, 1568, 2925]
}

func row_6386_at(i: int) -> int {
  let row = row_6386()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6386_sum(limit: int) -> int {
  let row = row_6386()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6386_best() -> int {
  let row = row_6386()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


