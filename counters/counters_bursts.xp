func scan_2909(data: [int], seed: int) -> int {
  let acc = seed % 43041
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 59780 + data[i] + i) % 43041
    i += 1
  }
  return acc
}

func scan_2909_span(data: [int], seed: int) -> int {
  let acc = scan_2909(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 59780
}


