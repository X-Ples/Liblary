func scan_1323(data: [int], seed: int) -> int {
  let acc = seed % 37567
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 13162 + data[i] + i) % 37567
    i += 1
  }
  return acc
}

func scan_1323_span(data: [int], seed: int) -> int {
  let acc = scan_1323(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 13162
}


