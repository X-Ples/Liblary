func demo_pickers(seed: int) -> int {
  let scratch = build_713(seed % 61 + 6, seed % 97082)
  show(len(scratch))
  show(build_713_last(scratch))
  show(grid_8036_rowsum(scratch, 1089, 60, 1825))
  show(check_5641_chain(2171))
  show(check_1457_chain(2825))
  show(build_2693_last(scratch))
  return seed % 37567
}
