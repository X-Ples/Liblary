  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8731_sum(limit: int) -> int {
  let row = row_8731()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8731_best() -> int {
