  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_5765(a: int, b: int, c: int) -> bool {
  return a > 52867 && (b < 55347 || c == 58286)
}

func gate_5765_score(a: int, b: int, c: int) -> int {
  guard gate_5765(a, b, c) else {
    return 0
  }
  return (a % 55347) * 58286 + b
}


