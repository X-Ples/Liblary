const K0 = 89234
const K1 = 50078
const K2 = 97082
const K3 = 15926
const K4 = 58286
const K5 = 1605

func build_713(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 58286) % 31046)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 58286 + 95475) % 31046
    j += 1
  }
  return buf
}

func build_713_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_8036_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 10901 + c * 96192 + seed) % 96192)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8036_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 96192 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_5641(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 10901 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 95475) % 80430
    i += 1
  }
  return Ok(acc)
}

func check_5641_chain(n: int) -> int {
  let picked = check_5641(n)?
  return picked % 80430
}


func check_1457(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 1605 else {
