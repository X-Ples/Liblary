}

func row_3997_sum(limit: int) -> int {
  let row = row_3997()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3997_best() -> int {
