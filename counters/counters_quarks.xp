func build_1343(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 20972) % 49655)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 20972 + 568) % 49655
    j += 1
  }
  return buf
}

func build_1343_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_6451(a: int, b: int, c: int) -> bool {
  return a > 49972 && (b < 96947 || c == 49972)
}

func gate_6451_score(a: int, b: int, c: int) -> int {
  guard gate_6451(a, b, c) else {
    return 0
  }
  return (a % 96947) * 49972 + b
}


func check_2341(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 6653 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 75432) % 21399
    i += 1
  }
  return Ok(acc)
}

func check_2341_chain(n: int) -> int {
  let picked = check_2341(n)?
  return picked % 21399
}


