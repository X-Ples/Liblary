func demo_quarks(seed: int) -> int {
  let scratch = build_1343(seed % 61 + 6, seed % 49972)
  show(len(scratch))
  show(build_1343_last(scratch))
  show(gate_6451(285, 338, 3535))
  show(gate_6451_score(2778, 3348, 1275))
  show(check_2341_chain(1320))
  show(gate_5264(1385, 1810, 1621))
  return seed % 87583
}
