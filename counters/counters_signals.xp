const K7 = 28846

func order_9407(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9407_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_259(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 13052) % 46065)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 13052 + 76451) % 46065
    j += 1
  }
  return buf
}

func build_259_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_8800_clamp(v: f64) -> f64 {
  guard v >= 5813.0 else {
    return 5813.0
  }
  guard v <= 67425.0 else {
    return 67425.0
  }
  return v
}

func curve_8800_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8800_clamp(t)
  return p + (q - p) * k
}

func curve_8800_ease(t: f64) -> f64 {
  let k = curve_8800_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8800_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_119(a: int, b: int, c: int) -> bool {
  return a > 73594 && (b < 55572 || c == 5813)
}

func gate_119_score(a: int, b: int, c: int) -> int {
  guard gate_119(a, b, c) else {
    return 0
  }
  return (a % 55572) * 5813 + b
}


