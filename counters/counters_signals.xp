func check_7897(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 55572 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 55572) % 85657
    i += 1
  }
  return Ok(acc)
}

func check_7897_chain(n: int) -> int {
  let picked = check_7897(n)?
  return picked % 85657
}


