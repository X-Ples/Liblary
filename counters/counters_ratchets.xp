func scan_1989(data: [int], seed: int) -> int {
  let acc = seed % 15183
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 79289 + data[i] + i) % 15183
    i += 1
  }
  return acc
}

func scan_1989_span(data: [int], seed: int) -> int {
  let acc = scan_1989(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 79289
}


func grid_3427_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 17342 + c * 17342 + seed) % 17342)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3427_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 17342 == want {
      total += acc
    }
    r += 1
  }
  return total
}


