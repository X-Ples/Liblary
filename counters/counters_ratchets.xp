func curve_6683_clamp(v: f64) -> f64 {
  guard v >= 3927.0 else {
    return 3927.0
  }
  guard v <= 4176.0 else {
    return 4176.0
  }
  return v
}

func curve_6683_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6683_clamp(t)
  return p + (q - p) * k
}

func curve_6683_ease(t: f64) -> f64 {
  let k = curve_6683_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6683_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_9264(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 4176 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 15742) % 11228
    i += 1
  }
  return Ok(acc)
}

func check_9264_chain(n: int) -> int {
  let picked = check_9264(n)?
  return picked % 11228
}


