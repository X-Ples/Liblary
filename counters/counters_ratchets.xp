func build_8583(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 79289) % 94875)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 79289 + 50070) % 94875
    j += 1
  }
  return buf
}

func build_8583_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_5373(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 6921
  for i in lo..hi {
    if i % 6738 == 0 {
      acc += i * 61402
    } else {
      acc -= i % 54898
    }
    if acc < 0 {
      acc += 6738
    }
    acc = acc % 6738
  }
  return acc
}


