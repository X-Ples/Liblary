func demo_ratchets(seed: int) -> int {
  let scratch = build_8583(seed % 61 + 6, seed % 7387)
  show(len(scratch))
  show(build_8583_last(scratch))
  show(sweep_5373(154, 985))
  show(gate_1519(454, 2025, 2551))
  show(gate_1519_score(17, 2760, 945))
  return seed % 26396
}
