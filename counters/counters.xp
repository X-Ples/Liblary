func sweep_1386(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 56387
  for i in lo..hi {
    if i % 14818 == 0 {
      acc += i * 86513
    } else {
      acc -= i % 58039
    }
    if acc < 0 {
      acc += 52261
    }
    acc = acc % 52261
  }
  return acc
}


