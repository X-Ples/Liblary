  return [227, 727, 680, 1498, 547, 515, 594, 1495, 621, 183, 777, 1130, 2170, 3641, 1059, 2318]
}

func row_7803_at(i: int) -> int {
  let row = row_7803()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7803_sum(limit: int) -> int {
  let row = row_7803()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7803_best() -> int {
  let row = row_7803()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_4437(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4437_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func scan_4332(data: [int], seed: int) -> int {
  let acc = seed % 54306
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 87056 + data[i] + i) % 54306
    i += 1
  }
  return acc
}

func scan_4332_span(data: [int], seed: int) -> int {
  let acc = scan_4332(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 87056
}


