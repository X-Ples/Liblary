func build_1681(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 58039) % 89464)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 58039 + 87056) % 89464
    j += 1
  }
  return buf
}

func build_1681_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_7862_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 74609 + c * 86513 + seed) % 86513)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7862_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 86513 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_1591(a: int, b: int, c: int) -> bool {
  return a > 86513 && (b < 61002 || c == 52261)
}

func gate_1591_score(a: int, b: int, c: int) -> int {
  guard gate_1591(a, b, c) else {
    return 0
  }
  return (a % 61002) * 52261 + b
}


