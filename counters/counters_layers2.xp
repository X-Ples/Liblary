func sweep_5322(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 74567
  for i in lo..hi {
    if i % 81857 == 0 {
      acc += i * 60209
    } else {
      acc -= i % 40822
    }
    if acc < 0 {
      acc += 41693
    }
    acc = acc % 41693
  }
  return acc
}


func grid_3226_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 60209 + c * 33675 + seed) % 33675)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3226_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 33675 == want {
      total += acc
    }
    r += 1
  }
  return total
}


