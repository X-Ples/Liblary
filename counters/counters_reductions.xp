func demo_reductions(seed: int) -> int {
  let scratch = build_1304(seed % 61 + 6, seed % 29592)
  show(len(scratch))
  show(build_1304_last(scratch))
  show(scan_2525(scratch, 3996))
  show(scan_2525_span(scratch, 2242))
  show(sweep_8441(3737, 3606))
  return seed % 13366
}
