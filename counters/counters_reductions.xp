func build_1304(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 55364) % 74966)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 55364 + 28094) % 74966
    j += 1
  }
  return buf
}

func build_1304_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_2525(data: [int], seed: int) -> int {
  let acc = seed % 36547
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 94249 + data[i] + i) % 36547
    i += 1
  }
  return acc
}

func scan_2525_span(data: [int], seed: int) -> int {
  let acc = scan_2525(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 94249
}


func sweep_8441(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 55364
  for i in lo..hi {
    if i % 70520 == 0 {
      acc += i * 15679
    } else {
      acc -= i % 13757
    }
    if acc < 0 {
      acc += 12106
    }
    acc = acc % 12106
  }
  return acc
}


func check_8331(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 49310 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 94249) % 49966
    i += 1
  }
  return Ok(acc)
}

func check_8331_chain(n: int) -> int {
  let picked = check_8331(n)?
  return picked % 49966
}


func text_6930_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 55364
    i += 1
  }
  return acc % 55364
}

func text_6930_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "kilo"
}

func text_6930_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 81028
}


func curve_1999_clamp(v: f64) -> f64 {
  guard v >= 13366.0 else {
    return 13366.0
  }
  guard v <= 49966.0 else {
    return 49966.0
  }
  return v
}

func curve_1999_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1999_clamp(t)
  return p + (q - p) * k
}

func curve_1999_ease(t: f64) -> f64 {
  let k = curve_1999_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1999_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_7163_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 8319 + c * 38251 + seed) % 38251)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7163_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 38251 == want {
      total += acc
    }
    r += 1
  }
  return total
}


