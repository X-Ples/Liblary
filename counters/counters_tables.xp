func build_5173(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 63747) % 72412)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 63747 + 63747) % 72412
    j += 1
  }
  return buf
}

func build_5173_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_8260(a: int, b: int, c: int) -> bool {
  return a > 23877 && (b < 25969 || c == 62310)
}

func gate_8260_score(a: int, b: int, c: int) -> int {
  guard gate_8260(a, b, c) else {
    return 0
  }
  return (a % 25969) * 62310 + b
}


func grid_2697_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 38585 + c * 63747 + seed) % 63747)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2697_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 63747 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_3250(data: [int], seed: int) -> int {
  let acc = seed % 72973
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 62310 + data[i] + i) % 72973
    i += 1
  }
  return acc
}

func scan_3250_span(data: [int], seed: int) -> int {
  let acc = scan_3250(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 62310
}


