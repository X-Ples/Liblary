func demo_tables(seed: int) -> int {
  let scratch = build_5173(seed % 61 + 6, seed % 878)
  show(len(scratch))
  show(build_5173_last(scratch))
  show(gate_8260(2058, 3607, 771))
  show(gate_8260_score(41, 3176, 1711))
  show(grid_2697_rowsum(scratch, 3698, 1634, 2612))
  show(scan_3250(scratch, 3245))
  return seed % 878
}
