func demo_offsets(seed: int) -> int {
  let scratch = build_1765(seed % 61 + 6, seed % 80271)
  show(len(scratch))
  show(build_1765_last(scratch))
  show(build_2845_last(scratch))
  show(row_3376_at(1702))
  return seed % 66251
}
