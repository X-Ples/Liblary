func text_8313_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 17516
    i += 1
  }
  return acc % 17516
}

func text_8313_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "jetty"
}

func text_8313_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 7001
}


