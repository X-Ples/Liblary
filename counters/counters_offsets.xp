func sweep_3352(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 91400
  for i in lo..hi {
    if i % 25313 == 0 {
      acc += i * 1875
    } else {
      acc -= i % 99808
    }
    if acc < 0 {
      acc += 89448
    }
    acc = acc % 89448
  }
  return acc
}


func curve_7012_clamp(v: f64) -> f64 {
  guard v >= 80271.0 else {
    return 80271.0
  }
  guard v <= 89448.0 else {
    return 89448.0
  }
  return v
}

func curve_7012_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7012_clamp(t)
  return p + (q - p) * k
}

func curve_7012_ease(t: f64) -> f64 {
  let k = curve_7012_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7012_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_6976(a: int, b: int, c: int) -> bool {
  return a > 17516 && (b < 73188 || c == 58857)
}

func gate_6976_score(a: int, b: int, c: int) -> int {
  guard gate_6976(a, b, c) else {
    return 0
  }
  return (a % 73188) * 58857 + b
}


