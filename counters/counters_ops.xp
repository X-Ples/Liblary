func check_4713(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 15626 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 84269) % 26591
    i += 1
  }
  return Ok(acc)
}

func check_4713_chain(n: int) -> int {
  let picked = check_4713(n)?
  return picked % 26591
}


