  }
  return acc % 92188
}

func text_1832_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "cargo"
}

func text_1832_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 6306
}


