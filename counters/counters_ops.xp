func curve_5130_clamp(v: f64) -> f64 {
  guard v >= 92188.0 else {
    return 92188.0
  }
  guard v <= 94499.0 else {
    return 94499.0
  }
  return v
}

func curve_5130_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5130_clamp(t)
  return p + (q - p) * k
}

func curve_5130_ease(t: f64) -> f64 {
  let k = curve_5130_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5130_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
