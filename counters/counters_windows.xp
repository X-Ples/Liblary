func demo_windows(seed: int) -> int {
  let scratch = build_5098(seed % 61 + 6, seed % 16483)
  show(len(scratch))
  show(build_5098_last(scratch))
  show(gate_9594(3554, 849, 1749))
  show(gate_9594_score(2318, 1672, 3534))
  show(check_6680_chain(2127))
  return seed % 23674
