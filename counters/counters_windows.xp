func build_5098(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 4883) % 73222)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 4883 + 16483) % 73222
    j += 1
  }
  return buf
}

func build_5098_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_9241_clamp(v: f64) -> f64 {
  guard v >= 38107.0 else {
    return 38107.0
  }
  guard v <= 65670.0 else {
    return 65670.0
  }
  return v
}

func curve_9241_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9241_clamp(t)
  return p + (q - p) * k
}

func curve_9241_ease(t: f64) -> f64 {
  let k = curve_9241_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9241_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_9594(a: int, b: int, c: int) -> bool {
  return a > 51056 && (b < 68438 || c == 68438)
}

func gate_9594_score(a: int, b: int, c: int) -> int {
  guard gate_9594(a, b, c) else {
    return 0
  }
  return (a % 68438) * 68438 + b
}


func check_6680(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 65670 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 81723) % 56622
    i += 1
  }
  return Ok(acc)
}

func check_6680_chain(n: int) -> int {
  let picked = check_6680(n)?
  return picked % 56622
}


