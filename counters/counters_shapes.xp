func scan_1160(data: [int], seed: int) -> int {
  let acc = seed % 48600
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 39089 + data[i] + i) % 48600
    i += 1
  }
  return acc
}

func scan_1160_span(data: [int], seed: int) -> int {
  let acc = scan_1160(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 39089
}


func text_7818_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 92453
    i += 1
  }
  return acc % 92453
}

func text_7818_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "sigma"
}

func text_7818_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 77427
}


