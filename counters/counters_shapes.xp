func demo_shapes(seed: int) -> int {
  let scratch = build_4851(seed % 61 + 6, seed % 37887)
  show(len(scratch))
  show(build_4851_last(scratch))
  show(order_8830_find(scratch, 3635))
  show(check_6797_chain(1117))
  show(grid_8462_rowsum(scratch, 2770, 1789, 243))
  return seed % 13669
}
