func build_4851(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 11805) % 14300)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 11805 + 48600) % 14300
    j += 1
  }
  return buf
}

func build_4851_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_8830(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8830_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func check_6797(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 50770 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 1416) % 75139
    i += 1
  }
  return Ok(acc)
}

func check_6797_chain(n: int) -> int {
  let picked = check_6797(n)?
  return picked % 75139
}


func grid_8462_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 14300 + c * 1416 + seed) % 1416)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8462_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 1416 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func row_3764() -> [int] {
  return [3992, 2678, 2612, 3874, 962, 3053, 1176, 1411, 2550, 2388]
}

func row_3764_at(i: int) -> int {
  let row = row_3764()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3764_sum(limit: int) -> int {
  let row = row_3764()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3764_best() -> int {
  let row = row_3764()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


