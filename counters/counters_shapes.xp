func sweep_2524(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 75139
  for i in lo..hi {
    if i % 12599 == 0 {
      acc += i * 46818
    } else {
      acc -= i % 75139
    }
    if acc < 0 {
      acc += 11805
    }
    acc = acc % 11805
  }
  return acc
}


