func curve_2517_clamp(v: f64) -> f64 {
  guard v >= 42088.0 else {
    return 42088.0
  }
  guard v <= 94900.0 else {
    return 94900.0
  }
  return v
}

func curve_2517_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2517_clamp(t)
  return p + (q - p) * k
}

func curve_2517_ease(t: f64) -> f64 {
  let k = curve_2517_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2517_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_vectors2(seed: int) -> int {
  let scratch = build_7069(seed % 61 + 6, seed % 27082)
  show(len(scratch))
  show(build_7069_last(scratch))
  show(sweep_679(3035, 2044))
  show(gate_5209(665, 2049, 255))
  show(gate_5209_score(579, 717, 2742))
  show(sweep_1612(1845, 3207))
  return seed % 79480
}
