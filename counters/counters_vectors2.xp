func scan_4838(data: [int], seed: int) -> int {
  let acc = seed % 67900
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 27082 + data[i] + i) % 67900
    i += 1
  }
  return acc
}

func scan_4838_span(data: [int], seed: int) -> int {
  let acc = scan_4838(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 27082
}


