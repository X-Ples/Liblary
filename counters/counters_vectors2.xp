func build_7069(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 88802) % 14861)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 88802 + 92491) % 14861
    j += 1
  }
  return buf
}

func build_7069_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_679(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 89662
  for i in lo..hi {
    if i % 35672 == 0 {
      acc += i * 30462
    } else {
      acc -= i % 81611
    }
    if acc < 0 {
      acc += 26198
    }
    acc = acc % 26198
  }
  return acc
}


func gate_5209(a: int, b: int, c: int) -> bool {
  return a > 42088 && (b < 42088 || c == 27082)
}

func gate_5209_score(a: int, b: int, c: int) -> int {
  guard gate_5209(a, b, c) else {
    return 0
  }
  return (a % 42088) * 27082 + b
}


