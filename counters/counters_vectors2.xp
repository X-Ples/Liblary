func text_7766_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 49207
    i += 1
  }
  return acc % 49207
}

func text_7766_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "gamma"
}

func text_7766_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 42088
}


func grid_5945_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 79678 + c * 7345 + seed) % 7345)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5945_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 7345 == want {
      total += acc
    }
    r += 1
  }
  return total
}


