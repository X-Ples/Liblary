func check_6668(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 94900 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 67900) % 67900
    i += 1
  }
  return Ok(acc)
}

func check_6668_chain(n: int) -> int {
