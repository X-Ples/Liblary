func gate_6477(a: int, b: int, c: int) -> bool {
  return a > 83459 && (b < 98991 || c == 37848)
}

func gate_6477_score(a: int, b: int, c: int) -> int {
  guard gate_6477(a, b, c) else {
    return 0
  }
  return (a % 98991) * 37848 + b
}


func check_227(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 37848 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 17799) % 38043
    i += 1
  }
  return Ok(acc)
}

func check_227_chain(n: int) -> int {
  let picked = check_227(n)?
  return picked % 38043
}


func curve_9180_clamp(v: f64) -> f64 {
  guard v >= 13082.0 else {
    return 13082.0
  }
  guard v <= 35097.0 else {
    return 35097.0
  }
  return v
}

func curve_9180_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9180_clamp(t)
  return p + (q - p) * k
}

func curve_9180_ease(t: f64) -> f64 {
  let k = curve_9180_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9180_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


