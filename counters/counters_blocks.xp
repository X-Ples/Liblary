func demo_blocks(seed: int) -> int {
  let scratch = build_9680(seed % 61 + 6, seed % 83459)
  show(len(scratch))
  show(build_9680_last(scratch))
  show(text_2838_weight("nova"))
  show(text_2838_label(3286))
  show(text_2838_has("ember"))
  show(build_6996_last(scratch))
  return seed % 38043
}
