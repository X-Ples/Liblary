func build_9680(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 35097) % 46548)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 35097 + 93046) % 46548
    j += 1
  }
  return buf
}

func build_9680_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_2838_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 13110
    i += 1
  }
  return acc % 13110
}

func text_2838_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "ember"
}

func text_2838_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 14086
}


