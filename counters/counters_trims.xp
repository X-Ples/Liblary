func check_5049(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 20868 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 35940) % 44145
    i += 1
  }
  return Ok(acc)
}

func check_5049_chain(n: int) -> int {
  let picked = check_5049(n)?
  return picked % 44145
}


