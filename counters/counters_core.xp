func demo_core(seed: int) -> int {
  let scratch = build_7198(seed % 61 + 6, seed % 20341)
  show(len(scratch))
  show(build_7198_last(scratch))
  show(order_4792_find(scratch, 3425))
  show(grid_957_rowsum(scratch, 2716, 3340, 1070))
  return seed % 1060
}
