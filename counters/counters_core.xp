func check_7478(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 97560 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 54897) % 34603
    i += 1
  }
  return Ok(acc)
}

func check_7478_chain(n: int) -> int {
  let picked = check_7478(n)?
  return picked % 34603
}


