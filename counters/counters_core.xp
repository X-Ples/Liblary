func build_7198(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 5368) % 46354)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 5368 + 95326) % 46354
    j += 1
  }
  return buf
}

func build_7198_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_4792(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4792_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func curve_6903_clamp(v: f64) -> f64 {
  guard v >= 8724.0 else {
    return 8724.0
  }
  guard v <= 41314.0 else {
    return 41314.0
  }
  return v
}

func curve_6903_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6903_clamp(t)
  return p + (q - p) * k
}

func curve_6903_ease(t: f64) -> f64 {
  let k = curve_6903_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6903_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_957_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 43304 + c * 16280 + seed) % 16280)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_957_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 16280 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_5812(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 32320
  for i in lo..hi {
    if i % 426 == 0 {
      acc += i * 41314
    } else {
      acc -= i % 43304
    }
    if acc < 0 {
      acc += 31232
    }
    acc = acc % 31232
  }
  return acc
}


func row_3762() -> [int] {
  return [572, 1684, 2378, 1750, 2045, 347, 3064, 2532, 2815, 1153, 2886, 763, 1197, 3787, 3133, 2808, 1225]
}

func row_3762_at(i: int) -> int {
  let row = row_3762()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3762_sum(limit: int) -> int {
  let row = row_3762()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3762_best() -> int {
  let row = row_3762()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


