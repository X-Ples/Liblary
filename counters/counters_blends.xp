func gate_8017(a: int, b: int, c: int) -> bool {
  return a > 87148 && (b < 35194 || c == 35194)
}

func gate_8017_score(a: int, b: int, c: int) -> int {
  guard gate_8017(a, b, c) else {
    return 0
  }
  return (a % 35194) * 35194 + b
}


