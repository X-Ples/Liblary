  return total
}


func demo_blends(seed: int) -> int {
  let scratch = build_7382(seed % 61 + 6, seed % 3105)
  show(len(scratch))
  show(check_3615_chain(2680))
  show(build_7382_last(scratch))
  show(grid_8048_rowsum(scratch, 1671, 2675, 3687))
  show(order_7943_find(scratch, 3297))
  return seed % 1228
}
