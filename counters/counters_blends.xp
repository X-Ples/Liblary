func sweep_5907(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 49038
  for i in lo..hi {
    if i % 5172 == 0 {
      acc += i * 21425
    } else {
      acc -= i % 48099
    }
    if acc < 0 {
      acc += 16757
    }
    acc = acc % 16757
  }
  return acc
}


