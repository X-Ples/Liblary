func scan_2893(data: [int], seed: int) -> int {
  let acc = seed % 87021
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 1335 + data[i] + i) % 87021
    i += 1
  }
  return acc
}

func scan_2893_span(data: [int], seed: int) -> int {
  let acc = scan_2893(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 1335
}


