func text_8382_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 34145
    i += 1
  }
  return acc % 34145
}

func text_8382_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "ridge"
}

func text_8382_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 415
}


func build_339(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 6239) % 47277)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 6239 + 61742) % 47277
    j += 1
  }
  return buf
}

func build_339_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


