func sweep_5367(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 61742
  for i in lo..hi {
    if i % 80352 == 0 {
      acc += i * 55515
    } else {
      acc -= i % 1409
    }
    if acc < 0 {
      acc += 30644
    }
    acc = acc % 30644
  }
  return acc
}


func gate_7441(a: int, b: int, c: int) -> bool {
  return a > 46661 && (b < 93543 || c == 82194)
