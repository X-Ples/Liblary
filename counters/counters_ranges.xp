func check_987(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 16105 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 61742) % 34145
    i += 1
  }
  return Ok(acc)
}

func check_987_chain(n: int) -> int {
  let picked = check_987(n)?
  return picked % 34145
}


func row_4164() -> [int] {
  return [3943, 320, 1719, 2190, 1338, 3358, 397, 3889, 4001, 355, 3990, 2679, 1570, 362, 1465, 1481, 1550]
}

func row_4164_at(i: int) -> int {
  let row = row_4164()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4164_sum(limit: int) -> int {
  let row = row_4164()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4164_best() -> int {
  let row = row_4164()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_9553_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 1409 + c * 90613 + seed) % 90613)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9553_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 90613 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_9636(data: [int], seed: int) -> int {
  let acc = seed % 34145
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 15668 + data[i] + i) % 34145
    i += 1
  }
  return acc
}

func scan_9636_span(data: [int], seed: int) -> int {
  let acc = scan_9636(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 15668
}


func order_7225(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7225_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


