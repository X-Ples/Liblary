func scan_9081(data: [int], seed: int) -> int {
  let acc = seed % 64470
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 58993 + data[i] + i) % 64470
    i += 1
  }
  return acc
}

func scan_9081_span(data: [int], seed: int) -> int {
  let acc = scan_9081(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 58993
}


func check_4443(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 41979 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 23787) % 669
    i += 1
  }
  return Ok(acc)
}

func check_4443_chain(n: int) -> int {
  let picked = check_4443(n)?
  return picked % 669
}


