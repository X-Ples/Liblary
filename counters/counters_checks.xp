func demo_checks(seed: int) -> int {
  let scratch = build_7507(seed % 61 + 6, seed % 64470)
  show(len(scratch))
  show(scan_9081(scratch, 1741))
  show(scan_9081_span(scratch, 2486))
  show(check_4443_chain(3368))
  show(check_1269_chain(2951))
  show(build_7507_last(scratch))
  show(grid_4637_rowsum(scratch, 620, 243, 3546))
  return seed % 50803
}
