func row_9979() -> [int] {
  return [685, 149, 1973, 1720, 344, 1533, 3396, 2670, 1172, 3426, 2190, 3174, 3496, 3744, 2392, 1955, 2501, 2593]
}

func row_9979_at(i: int) -> int {
  let row = row_9979()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9979_sum(limit: int) -> int {
  let row = row_9979()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9979_best() -> int {
  let row = row_9979()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_5603(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5603_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_1345(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 33093
  for i in lo..hi {
    if i % 68910 == 0 {
      acc += i * 33093
    } else {
      acc -= i % 34331
    }
    if acc < 0 {
      acc += 17865
    }
    acc = acc % 17865
  }
  return acc
}


