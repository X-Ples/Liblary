func demo_counters(seed: int) -> int {
  let scratch = build_2356(seed % 61 + 6, seed % 59697)
  show(len(scratch))
  show(build_2356_last(scratch))
  show(grid_820_rowsum(scratch, 3357, 3267, 241))
  show(sweep_2805(2233, 1422))
  show(grid_9517_rowsum(scratch, 2222, 860, 779))
  return seed % 89754
}
