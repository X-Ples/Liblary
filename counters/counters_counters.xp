func check_3724(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 51451 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 41929) % 45490
    i += 1
  }
  return Ok(acc)
}

func check_3724_chain(n: int) -> int {
  let picked = check_3724(n)?
  return picked % 45490
}


