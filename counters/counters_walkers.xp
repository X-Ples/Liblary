  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_1608(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 1309 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 66342) % 28207
    i += 1
  }
  return Ok(acc)
}

func check_1608_chain(n: int) -> int {
  let picked = check_1608(n)?
  return picked % 28207
}


