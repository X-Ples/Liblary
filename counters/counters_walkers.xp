func scan_7646(data: [int], seed: int) -> int {
  let acc = seed % 87722
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 52884 + data[i] + i) % 87722
    i += 1
  }
  return acc
}

func scan_7646_span(data: [int], seed: int) -> int {
  let acc = scan_7646(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 52884
}


