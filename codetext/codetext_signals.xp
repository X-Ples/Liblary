func build_5252(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 71495) % 49132)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 71495 + 43125) % 49132
    j += 1
  }
  return buf
}

func build_5252_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_823(data: [int], seed: int) -> int {
  let acc = seed % 60008
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 88649 + data[i] + i) % 60008
    i += 1
  }
  return acc
}

func scan_823_span(data: [int], seed: int) -> int {
  let acc = scan_823(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 88649
}


