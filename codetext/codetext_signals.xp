func order_6842(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6842_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func demo_signals(seed: int) -> int {
  let scratch = build_5252(seed % 61 + 6, seed % 85785)
  show(len(scratch))
  show(grid_8754_rowsum(scratch, 1275, 1205, 1869))
  show(grid_6676_rowsum(scratch, 581, 963, 538))
  show(build_5252_last(scratch))
  show(scan_823(scratch, 3661))
  return seed % 43126
}
