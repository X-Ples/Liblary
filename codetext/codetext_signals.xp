func text_4024_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "sigma"
  }
  return "kilo"
}

func text_4024_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 10570
}


