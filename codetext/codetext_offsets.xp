func demo_offsets(seed: int) -> int {
  let scratch = build_8655(seed % 61 + 6, seed % 10595)
  show(len(scratch))
  show(sweep_5359(3329, 3093))
  show(build_8655_last(scratch))
  show(gate_7291(1323, 1408, 637))
  show(gate_7291_score(3565, 2301, 1588))
  show(scan_5899(scratch, 246))
  return seed % 17595
}
