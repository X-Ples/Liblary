func sweep_5359(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 44270
  for i in lo..hi {
    if i % 47228 == 0 {
      acc += i * 10595
    } else {
      acc -= i % 48616
    }
    if acc < 0 {
      acc += 40691
    }
    acc = acc % 40691
  }
  return acc
}


func build_8655(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 87327) % 84046)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 87327 + 11744) % 84046
    j += 1
  }
  return buf
}

func build_8655_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_7291(a: int, b: int, c: int) -> bool {
  return a > 33310 && (b < 4800 || c == 76191)
}

func gate_7291_score(a: int, b: int, c: int) -> int {
  guard gate_7291(a, b, c) else {
    return 0
  }
  return (a % 4800) * 76191 + b
}


func scan_5899(data: [int], seed: int) -> int {
  let acc = seed % 17595
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 4800 + data[i] + i) % 17595
    i += 1
  }
  return acc
}

func scan_5899_span(data: [int], seed: int) -> int {
  let acc = scan_5899(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 4800
}


func grid_1236_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 47228 + c * 17593 + seed) % 17593)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1236_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 17593 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func order_4341(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4341_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_4013_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 17595
    i += 1
  }
  return acc % 17595
}

func text_4013_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "ridge"
}

func text_4013_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 48616
}


