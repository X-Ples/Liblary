func row_6473() -> [int] {
  return [3743, 724, 2027, 2400, 3943, 2510, 681, 2383, 617, 137, 3199, 2648, 206, 3101, 1150, 3291, 3027]
}

func row_6473_at(i: int) -> int {
  let row = row_6473()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6473_sum(limit: int) -> int {
  let row = row_6473()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6473_best() -> int {
  let row = row_6473()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


