func scan_4518(data: [int], seed: int) -> int {
  let acc = seed % 36647
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 18796 + data[i] + i) % 36647
    i += 1
  }
  return acc
}

func scan_4518_span(data: [int], seed: int) -> int {
  let acc = scan_4518(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 18796
}


func build_353(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 45220) % 49327)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 45220 + 34986) % 49327
    j += 1
  }
  return buf
}

func build_353_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_4174(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 57767
  for i in lo..hi {
    if i % 25537 == 0 {
      acc += i * 57767
    } else {
      acc -= i % 31359
    }
    if acc < 0 {
      acc += 95412
    }
    acc = acc % 95412
  }
  return acc
}


