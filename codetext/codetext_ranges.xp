func demo_ranges(seed: int) -> int {
  let scratch = build_353(seed % 61 + 6, seed % 18796)
  show(len(scratch))
  show(scan_4518(scratch, 3629))
  show(scan_4518_span(scratch, 1894))
  show(build_353_last(scratch))
  show(sweep_4174(3659, 3035))
  return seed % 49327
}
