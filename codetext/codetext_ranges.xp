func check_3761(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 82479 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 34986) % 13318
    i += 1
  }
  return Ok(acc)
}

func check_3761_chain(n: int) -> int {
  let picked = check_3761(n)?
  return picked % 13318
}


