func scan_2279(data: [int], seed: int) -> int {
  let acc = seed % 49852
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 54674 + data[i] + i) % 49852
    i += 1
  }
  return acc
}

func scan_2279_span(data: [int], seed: int) -> int {
  let acc = scan_2279(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 54674
}


