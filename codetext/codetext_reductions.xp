func demo_reductions(seed: int) -> int {
  let scratch = build_1163(seed % 61 + 6, seed % 94396)
  show(len(scratch))
  show(sweep_564(1231, 1411))
  show(build_1163_last(scratch))
  show(build_7993_last(scratch))
  return seed % 45325
}
