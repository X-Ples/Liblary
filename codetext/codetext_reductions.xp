func row_2310() -> [int] {
  return [1427, 1895, 1091, 963, 4028, 629, 3656, 4088, 166, 3432, 112, 1013, 1113, 3963, 1029, 2381, 1042, 700, 2719, 1003]
}

func row_2310_at(i: int) -> int {
  let row = row_2310()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2310_sum(limit: int) -> int {
  let row = row_2310()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2310_best() -> int {
  let row = row_2310()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


