func sweep_564(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 76040
  for i in lo..hi {
    if i % 97603 == 0 {
      acc += i * 41287
    } else {
      acc -= i % 21470
    }
    if acc < 0 {
      acc += 87878
    }
    acc = acc % 87878
  }
  return acc
}


func build_1163(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 86513) % 65540)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 86513 + 21470) % 65540
    j += 1
  }
  return buf
}

func build_1163_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


