func build_4877(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 76644) % 64821)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 76644 + 67631) % 64821
    j += 1
  }
  return buf
}

func build_4877_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_2211() -> [int] {
  return [3406, 953, 1902, 2319, 2392, 2223, 1278, 743, 442, 3480, 799]
}

func row_2211_at(i: int) -> int {
  let row = row_2211()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2211_sum(limit: int) -> int {
  let row = row_2211()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2211_best() -> int {
  let row = row_2211()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_2614_clamp(v: f64) -> f64 {
  guard v >= 54053.0 else {
    return 54053.0
  }
  guard v <= 64423.0 else {
    return 64423.0
  }
  return v
}

func curve_2614_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2614_clamp(t)
  return p + (q - p) * k
}

func curve_2614_ease(t: f64) -> f64 {
  let k = curve_2614_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2614_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_1930_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 670 + c * 25749 + seed) % 25749)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1930_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 25749 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_506_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 13470
    i += 1
  }
  return acc % 13470
}

func text_506_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "alpha"
}

func text_506_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 25401
}


func scan_967(data: [int], seed: int) -> int {
  let acc = seed % 84610
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 31049 + data[i] + i) % 84610
    i += 1
  }
  return acc
}

func scan_967_span(data: [int], seed: int) -> int {
  let acc = scan_967(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 31049
}


