func sweep_4036(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 66150
  for i in lo..hi {
    if i % 15286 == 0 {
      acc += i * 87749
    } else {
      acc -= i % 76644
    }
    if acc < 0 {
      acc += 670
    }
    acc = acc % 670
  }
  return acc
}


