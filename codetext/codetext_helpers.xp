func build_463(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 57627) % 15605)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 57627 + 36641) % 15605
    j += 1
  }
  return buf
}

func build_463_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_4836(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4836_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func grid_2957_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 12410 + c * 3039 + seed) % 3039)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2957_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 3039 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_1774_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 79859
    i += 1
  }
  return acc % 79859
}

func text_1774_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ridge"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "talus"
}

func text_1774_has(tag: str) -> bool {
  return str_contains(tag, "ridge") || len(tag) > 45361
}


func gate_5683(a: int, b: int, c: int) -> bool {
  return a > 43629 && (b < 36641 || c == 43629)
}

func gate_5683_score(a: int, b: int, c: int) -> int {
  guard gate_5683(a, b, c) else {
    return 0
  }
  return (a % 36641) * 43629 + b
}


