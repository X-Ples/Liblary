func demo_helpers(seed: int) -> int {
  let scratch = build_463(seed % 61 + 6, seed % 99312)
  show(len(scratch))
  show(build_463_last(scratch))
  show(order_4836_find(scratch, 2685))
  show(grid_2957_rowsum(scratch, 2410, 263, 3955))
  show(text_1774_weight("delta"))
  return seed % 5242
}
