func scan_4092(data: [int], seed: int) -> int {
  let acc = seed % 99312
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 84511 + data[i] + i) % 99312
    i += 1
  }
  return acc
}

