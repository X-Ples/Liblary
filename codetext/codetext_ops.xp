func check_4618(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 50735 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 48359) % 99420
    i += 1
  }
  return Ok(acc)
}

func check_4618_chain(n: int) -> int {
  let picked = check_4618(n)?
  return picked % 99420
}


