func sweep_7776(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 86103
  for i in lo..hi {
    if i % 80344 == 0 {
      acc += i * 50735
    } else {
      acc -= i % 16223
    }
    if acc < 0 {
      acc += 80344
    }
    acc = acc % 80344
  }
  return acc
}


