func demo_ratchets(seed: int) -> int {
  let scratch = build_3389(seed % 61 + 6, seed % 3813)
  show(len(scratch))
  show(check_3727_chain(2771))
  show(scan_1365(scratch, 751))
  show(scan_1365_span(scratch, 2418))
  show(build_3389_last(scratch))
  show(order_5263_find(scratch, 3634))
  return seed % 45646
}
