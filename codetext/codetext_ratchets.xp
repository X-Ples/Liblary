func check_3727(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 45417 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 94733) % 89037
    i += 1
  }
  return Ok(acc)
}

func check_3727_chain(n: int) -> int {
  let picked = check_3727(n)?
  return picked % 89037
}


func scan_1365(data: [int], seed: int) -> int {
  let acc = seed % 3813
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 20497 + data[i] + i) % 3813
    i += 1
  }
  return acc
}

func scan_1365_span(data: [int], seed: int) -> int {
  let acc = scan_1365(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 20497
}


func curve_1434_clamp(v: f64) -> f64 {
  guard v >= 35443.0 else {
    return 35443.0
  }
  guard v <= 45417.0 else {
    return 45417.0
  }
  return v
}

func curve_1434_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1434_clamp(t)
  return p + (q - p) * k
}

func curve_1434_ease(t: f64) -> f64 {
  let k = curve_1434_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1434_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_3389(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 94673) % 89887)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 94673 + 89887) % 89887
    j += 1
  }
  return buf
}

func build_3389_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_5263(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5263_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func grid_8543_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 94733 + c * 3813 + seed) % 3813)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8543_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 3813 == want {
      total += acc
    }
    r += 1
  }
  return total
}


