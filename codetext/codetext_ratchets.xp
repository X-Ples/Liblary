func sweep_2682(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 50483
  for i in lo..hi {
    if i % 75436 == 0 {
      acc += i * 72105
    } else {
      acc -= i % 50483
    }
    if acc < 0 {
      acc += 61209
    }
    acc = acc % 61209
  }
  return acc
}


