func demo_checks(seed: int) -> int {
  let scratch = build_517(seed % 61 + 6, seed % 86171)
  show(len(scratch))
  show(grid_9483_rowsum(scratch, 43, 3675, 3583))
  show(gate_2201(2610, 586, 3736))
  show(gate_2201_score(44, 3529, 3825))
  show(scan_5876(scratch, 2119))
  show(scan_5876_span(scratch, 2907))
  return seed % 31960
}
