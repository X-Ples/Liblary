func text_4971_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "talus"
}

func text_4971_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 78738
}


func order_8386(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8386_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


