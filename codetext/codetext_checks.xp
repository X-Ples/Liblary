func grid_9483_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 81683 + c * 84722 + seed) % 84722)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9483_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 84722 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_2201(a: int, b: int, c: int) -> bool {
  return a > 84722 && (b < 90315 || c == 91545)
}

func gate_2201_score(a: int, b: int, c: int) -> int {
  guard gate_2201(a, b, c) else {
    return 0
  }
  return (a % 90315) * 91545 + b
}


func scan_5876(data: [int], seed: int) -> int {
  let acc = seed % 86260
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 12881 + data[i] + i) % 86260
    i += 1
  }
  return acc
}

func scan_5876_span(data: [int], seed: int) -> int {
  let acc = scan_5876(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 12881
}


