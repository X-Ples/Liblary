  while i < count {
    array_push(buf, (start + i * 55561) % 84722)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 55561 + 67487) % 84722
    j += 1
  }
  return buf
}

func build_517_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_1683_clamp(v: f64) -> f64 {
  guard v >= 54151.0 else {
    return 54151.0
  }
  guard v <= 61184.0 else {
    return 61184.0
  }
  return v
}

func curve_1683_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1683_clamp(t)
  return p + (q - p) * k
}

func curve_1683_ease(t: f64) -> f64 {
  let k = curve_1683_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1683_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


