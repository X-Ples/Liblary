func build_7047(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 84153) % 39327)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 84153 + 80277) % 39327
    j += 1
  }
  return buf
}

func build_7047_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_2111(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 74127 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 54207) % 81105
    i += 1
  }
  return Ok(acc)
}

func check_2111_chain(n: int) -> int {
  let picked = check_2111(n)?
  return picked % 81105
}


func row_4219() -> [int] {
  return [2710, 735, 3160, 643, 1530, 316, 170, 1144, 2121, 86, 2683, 1380]
}

func row_4219_at(i: int) -> int {
  let row = row_4219()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4219_sum(limit: int) -> int {
  let row = row_4219()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4219_best() -> int {
  let row = row_4219()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


