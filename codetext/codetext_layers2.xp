func curve_3457_clamp(v: f64) -> f64 {
  guard v >= 14349.0 else {
    return 14349.0
  }
  guard v <= 24356.0 else {
    return 24356.0
  }
  return v
}

func curve_3457_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3457_clamp(t)
  return p + (q - p) * k
}

func curve_3457_ease(t: f64) -> f64 {
  let k = curve_3457_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3457_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_layers2(seed: int) -> int {
  let scratch = build_7047(seed % 61 + 6, seed % 81105)
  show(len(scratch))
  show(build_7047_last(scratch))
  show(check_2111_chain(716))
  show(row_4219_at(2174))
  show(row_4219_sum(2398))
  show(row_4219_best())
  return seed % 74127
}
