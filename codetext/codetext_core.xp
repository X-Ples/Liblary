func build_4133(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 51961) % 11068)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 51961 + 71616) % 11068
    j += 1
  }
  return buf
}

func build_4133_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_5928(data: [int], seed: int) -> int {
  let acc = seed % 43522
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 41410 + data[i] + i) % 43522
    i += 1
  }
  return acc
}

func scan_5928_span(data: [int], seed: int) -> int {
  let acc = scan_5928(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 41410
}


func sweep_6488(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 76261
  for i in lo..hi {
    if i % 40918 == 0 {
      acc += i * 89157
    } else {
      acc -= i % 51666
    }
    if acc < 0 {
      acc += 69534
    }
    acc = acc % 69534
  }
  return acc
}


func check_3355(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 43522 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 89157) % 13333
    i += 1
  }
  return Ok(acc)
}

func check_3355_chain(n: int) -> int {
  let picked = check_3355(n)?
  return picked % 13333
}


