func curve_9504_clamp(v: f64) -> f64 {
  guard v >= 31968.0 else {
    return 31968.0
  }
  guard v <= 95905.0 else {
    return 95905.0
  }
  return v
}

func curve_9504_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9504_clamp(t)
  return p + (q - p) * k
}

func curve_9504_ease(t: f64) -> f64 {
  let k = curve_9504_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9504_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_core(seed: int) -> int {
  let scratch = build_4133(seed % 61 + 6, seed % 22626)
  show(len(scratch))
  show(build_4133_last(scratch))
  show(scan_5928(scratch, 3719))
  show(scan_5928_span(scratch, 1158))
  return seed % 69534
}
