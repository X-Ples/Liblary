func sweep_1471(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 55652
  for i in lo..hi {
    if i % 57883 == 0 {
      acc += i * 70155
    } else {
      acc -= i % 54500
    }
    if acc < 0 {
      acc += 42415
    }
    acc = acc % 42415
  }
  return acc
}


func text_9517_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 15661
    i += 1
  }
  return acc % 15661
}

func text_9517_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "alpha"
}

func text_9517_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 50024
}


func build_3731(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 4597) % 45219)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 4597 + 55652) % 45219
    j += 1
  }
  return buf
}

func build_3731_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


