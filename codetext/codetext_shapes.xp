func scan_3403(data: [int], seed: int) -> int {
  let acc = seed % 51282
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 61408 + data[i] + i) % 51282
    i += 1
  }
  return acc
}

func scan_3403_span(data: [int], seed: int) -> int {
  let acc = scan_3403(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 61408
}


