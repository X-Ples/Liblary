func check_1292(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 57883 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 61408) % 5923
    i += 1
  }
  return Ok(acc)
}

func check_1292_chain(n: int) -> int {
  let picked = check_1292(n)?
  return picked % 5923
}


