func check_9804(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 57259 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 12297) % 61643
    i += 1
  }
  return Ok(acc)
}

func check_9804_chain(n: int) -> int {
  let picked = check_9804(n)?
  return picked % 61643
}


