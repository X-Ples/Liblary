func demo_kernels(seed: int) -> int {
  let scratch = build_4781(seed % 61 + 6, seed % 36925)
  show(len(scratch))
  show(build_4781_last(scratch))
  show(gate_5991(3838, 38, 912))
  show(gate_5991_score(3664, 368, 1207))
  show(build_4619_last(scratch))
  show(order_7393_find(scratch, 765))
  return seed % 8100
}
