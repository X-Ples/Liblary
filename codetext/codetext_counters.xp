func scan_8774(data: [int], seed: int) -> int {
  let acc = seed % 25341
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 3413 + data[i] + i) % 25341
    i += 1
  }
  return acc
}

func scan_8774_span(data: [int], seed: int) -> int {
  let acc = scan_8774(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 3413
}


