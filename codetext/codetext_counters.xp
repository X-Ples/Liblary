func build_2468(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 55937) % 55937)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 55937 + 96252) % 55937
    j += 1
  }
  return buf
}

func build_2468_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_3921_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 96252 + c * 64921 + seed) % 64921)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3921_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 64921 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_4304_clamp(v: f64) -> f64 {
  guard v >= 9942.0 else {
    return 9942.0
  }
  guard v <= 92389.0 else {
    return 92389.0
  }
  return v
}

func curve_4304_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4304_clamp(t)
  return p + (q - p) * k
}

func curve_4304_ease(t: f64) -> f64 {
  let k = curve_4304_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4304_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


