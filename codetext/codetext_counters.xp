func text_5616_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 53629
    i += 1
  }
  return acc % 53629
}

func text_5616_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "lumen"
}

func text_5616_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 37142
}


