func scan_6372(data: [int], seed: int) -> int {
  let acc = seed % 75762
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 65791 + data[i] + i) % 75762
    i += 1
  }
  return acc
}

func scan_6372_span(data: [int], seed: int) -> int {
  let acc = scan_6372(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 65791
}


