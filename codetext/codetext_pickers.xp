func check_3933(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 72626 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 43860) % 13826
    i += 1
  }
  return Ok(acc)
}

func check_3933_chain(n: int) -> int {
  let picked = check_3933(n)?
  return picked % 13826
}


func curve_5943_clamp(v: f64) -> f64 {
  guard v >= 20287.0 else {
    return 20287.0
  }
  guard v <= 36080.0 else {
    return 36080.0
  }
  return v
}

func curve_5943_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5943_clamp(t)
  return p + (q - p) * k
}

func curve_5943_ease(t: f64) -> f64 {
  let k = curve_5943_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5943_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


