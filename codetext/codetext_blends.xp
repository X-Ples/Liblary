func demo_blends(seed: int) -> int {
  let scratch = build_5419(seed % 61 + 6, seed % 26236)
  show(len(scratch))
  show(build_5419_last(scratch))
  show(sweep_7219(1244, 3997))
  show(gate_4860(2011, 1246, 3256))
  show(gate_4860_score(3473, 2111, 768))
  show(sweep_9114(2023, 3814))
  return seed % 55888
}
