func scan_8423(data: [int], seed: int) -> int {
  let acc = seed % 83635
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 60367 + data[i] + i) % 83635
    i += 1
  }
  return acc
}

func scan_8423_span(data: [int], seed: int) -> int {
  let acc = scan_8423(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 60367
}


