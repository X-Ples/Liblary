func build_5419(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 53779) % 79457)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 53779 + 77371) % 79457
    j += 1
  }
  return buf
}

func build_5419_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_7219(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 47522
  for i in lo..hi {
    if i % 39695 == 0 {
      acc += i * 15428
    } else {
      acc -= i % 83635
    }
    if acc < 0 {
      acc += 26236
    }
    acc = acc % 26236
  }
  return acc
}


func gate_4860(a: int, b: int, c: int) -> bool {
  return a > 77371 && (b < 15428 || c == 2555)
}

func gate_4860_score(a: int, b: int, c: int) -> int {
  guard gate_4860(a, b, c) else {
    return 0
  }
  return (a % 15428) * 2555 + b
}


