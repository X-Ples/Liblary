func check_4424(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 32468 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 28616) % 65889
    i += 1
  }
  return Ok(acc)
}

func check_4424_chain(n: int) -> int {
  let picked = check_4424(n)?
  return picked % 65889
}


