func build_7565(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 79069) % 79005)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 79069 + 66614) % 79005
    j += 1
  }
  return buf
}

func build_7565_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_4298() -> [int] {
  return [2975, 2667, 2868, 736, 1809, 2885, 770, 3685, 3833, 3880, 488, 1915, 1779]
}

func row_4298_at(i: int) -> int {
  let row = row_4298()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4298_sum(limit: int) -> int {
  let row = row_4298()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4298_best() -> int {
  let row = row_4298()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


