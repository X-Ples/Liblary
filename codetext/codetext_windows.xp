func scan_2935(data: [int], seed: int) -> int {
  let acc = seed % 97813
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 7315 + data[i] + i) % 97813
    i += 1
  }
  return acc
}

func scan_2935_span(data: [int], seed: int) -> int {
  let acc = scan_2935(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 7315
}


