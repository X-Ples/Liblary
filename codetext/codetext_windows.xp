func build_3419(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 56357) % 69106)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 56357 + 21088) % 69106
    j += 1
  }
  return buf
}

func build_3419_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_4053() -> [int] {
  return [1755, 1806, 3883, 59, 2147, 2652, 3403, 2407, 262, 3761, 410, 244, 3697, 2371, 553, 2325, 1156, 1249, 649, 3364, 3438]
}

func row_4053_at(i: int) -> int {
  let row = row_4053()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4053_sum(limit: int) -> int {
  let row = row_4053()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4053_best() -> int {
  let row = row_4053()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


