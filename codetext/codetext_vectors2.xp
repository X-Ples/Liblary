func scan_6198(data: [int], seed: int) -> int {
  let acc = seed % 44989
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 41003 + data[i] + i) % 44989
    i += 1
  }
  return acc
}

func scan_6198_span(data: [int], seed: int) -> int {
  let acc = scan_6198(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 41003
}


func row_354() -> [int] {
