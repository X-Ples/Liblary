func row_354_at(i: int) -> int {
  let row = row_354()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_354_sum(limit: int) -> int {
  let row = row_354()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_354_best() -> int {
  let row = row_354()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_3599(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 12218) % 2993)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 12218 + 12264) % 2993
    j += 1
  }
  return buf
}

func build_3599_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_5573(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 2993
  for i in lo..hi {
    if i % 22208 == 0 {
      acc += i * 60816
    } else {
      acc -= i % 60816
    }
    if acc < 0 {
      acc += 15996
    }
    acc = acc % 15996
  }
  return acc
}


