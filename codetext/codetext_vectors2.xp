func curve_916_clamp(v: f64) -> f64 {
  guard v >= 41003.0 else {
    return 41003.0
  }
  guard v <= 43562.0 else {
    return 43562.0
  }
  return v
}

func curve_916_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_916_clamp(t)
  return p + (q - p) * k
}

func curve_916_ease(t: f64) -> f64 {
  let k = curve_916_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_916_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func curve_3467_clamp(v: f64) -> f64 {
  guard v >= 2993.0 else {
