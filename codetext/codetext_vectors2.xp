func demo_vectors2(seed: int) -> int {
  let scratch = build_3599(seed % 61 + 6, seed % 90773)
  show(len(scratch))
  show(scan_6198(scratch, 279))
  show(scan_6198_span(scratch, 2793))
  show(row_354_at(1416))
  show(row_354_sum(1486))
  show(row_354_best())
  return seed % 60816
}
