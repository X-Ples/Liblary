const K0 = 56937
const K1 = 66263
const K2 = 96519
const K3 = 40592
const K4 = 18143
const K5 = 72370
const K6 = 62366

func grid_1347_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 18143 + c * 1745 + seed) % 1745)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1347_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 1745 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_7941(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 68166) % 36473)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 68166 + 66263) % 36473
    j += 1
  }
  return buf
}

func build_7941_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_7141(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7141_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_678(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 35907
  for i in lo..hi {
    if i % 61636 == 0 {
      acc += i * 52396
    } else {
      acc -= i % 1745
    }
    if acc < 0 {
      acc += 61223
    }
    acc = acc % 61223
  }
  return acc
}


