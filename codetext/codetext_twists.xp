func row_6149() -> [int] {
  return [3866, 1844, 1547, 616, 282, 1122, 1980, 604, 2282, 3679, 3481, 668, 536, 2934, 1319, 2704, 469, 3502, 750]
}

func row_6149_at(i: int) -> int {
  let row = row_6149()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6149_sum(limit: int) -> int {
  let row = row_6149()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6149_best() -> int {
  let row = row_6149()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


