func demo_twists(seed: int) -> int {
  let scratch = build_7941(seed % 61 + 6, seed % 1745)
  show(len(scratch))
  show(grid_1347_rowsum(scratch, 449, 380, 3086))
  show(build_7941_last(scratch))
  show(order_7141_find(scratch, 3358))
  show(sweep_678(1896, 3948))
  return seed % 1745
}
