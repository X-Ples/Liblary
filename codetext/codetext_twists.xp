func curve_5345_clamp(v: f64) -> f64 {
  guard v >= 40592.0 else {
    return 40592.0
  }
  guard v <= 52396.0 else {
    return 52396.0
  }
  return v
}

func curve_5345_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5345_clamp(t)
  return p + (q - p) * k
}

func curve_5345_ease(t: f64) -> f64 {
  let k = curve_5345_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5345_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_8636_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 35907
    i += 1
  }
  return acc % 35907
}

func text_8636_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "quartz"
}

func text_8636_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 62366
}


func check_5672(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 36473 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 96519) % 68166
    i += 1
  }
  return Ok(acc)
}

func check_5672_chain(n: int) -> int {
  let picked = check_5672(n)?
  return picked % 68166
}


