func build_5967(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 60487) % 29178)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 60487 + 7685) % 29178
    j += 1
  }
  return buf
}

func build_5967_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_4831(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 96335
  for i in lo..hi {
    if i % 8500 == 0 {
      acc += i * 68891
    } else {
      acc -= i % 31654
    }
    if acc < 0 {
      acc += 10862
    }
    acc = acc % 10862
  }
  return acc
}


func grid_3432_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 22814 + c * 71394 + seed) % 71394)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3432_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 71394 == want {
      total += acc
    }
    r += 1
  }
  return total
}


