}

func row_2915_sum(limit: int) -> int {
  let row = row_2915()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2915_best() -> int {
  let row = row_2915()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_1258(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 20802 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 63625) % 9245
    i += 1
  }
  return Ok(acc)
}

func check_1258_chain(n: int) -> int {
  let picked = check_1258(n)?
  return picked % 9245
}


