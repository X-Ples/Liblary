func row_2451() -> [int] {
  return [1568, 2969, 842, 578, 3451, 3737, 1354, 3923, 3893, 1782]
}

func row_2451_at(i: int) -> int {
  let row = row_2451()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2451_sum(limit: int) -> int {
  let row = row_2451()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2451_best() -> int {
  let row = row_2451()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


