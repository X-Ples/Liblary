func scan_1952(data: [int], seed: int) -> int {
  let acc = seed % 42981
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 92840 + data[i] + i) % 42981
    i += 1
  }
  return acc
}

func scan_1952_span(data: [int], seed: int) -> int {
  let acc = scan_1952(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 92840
}


