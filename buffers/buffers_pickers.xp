func build_1694(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 46093) % 60218)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 46093 + 89738) % 60218
    j += 1
  }
  return buf
}

func build_1694_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_956(data: [int], seed: int) -> int {
  let acc = seed % 78172
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 94623 + data[i] + i) % 78172
    i += 1
  }
  return acc
}

func scan_956_span(data: [int], seed: int) -> int {
  let acc = scan_956(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 94623
}


