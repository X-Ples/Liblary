func demo_pickers(seed: int) -> int {
  let scratch = build_1694(seed % 61 + 6, seed % 12023)
  show(len(scratch))
  show(build_1694_last(scratch))
  show(scan_956(scratch, 3111))
  show(scan_956_span(scratch, 691))
  show(row_2674_at(3308))
  return seed % 38206
}
