func sweep_9457(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 35294
  for i in lo..hi {
    if i % 17667 == 0 {
      acc += i * 60347
    } else {
      acc -= i % 58705
    }
    if acc < 0 {
      acc += 35294
    }
    acc = acc % 35294
  }
  return acc
}


