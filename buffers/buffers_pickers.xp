func curve_9094_clamp(v: f64) -> f64 {
  guard v >= 60218.0 else {
    return 60218.0
  }
  guard v <= 78172.0 else {
    return 78172.0
  }
  return v
}

func curve_9094_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9094_clamp(t)
  return p + (q - p) * k
}

func curve_9094_ease(t: f64) -> f64 {
  let k = curve_9094_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9094_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_4257(a: int, b: int, c: int) -> bool {
  return a > 38206 && (b < 94623 || c == 59433)
}

func gate_4257_score(a: int, b: int, c: int) -> int {
  guard gate_4257(a, b, c) else {
    return 0
  }
  return (a % 94623) * 59433 + b
}


