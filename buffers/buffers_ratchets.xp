func build_2254(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 28703) % 97288)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 28703 + 43915) % 97288
    j += 1
  }
  return buf
}

func build_2254_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_8199_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 41867
    i += 1
  }
  return acc % 41867
}

func text_8199_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "harbor"
}

func text_8199_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 42576
}


func curve_1205_clamp(v: f64) -> f64 {
  guard v >= 35999.0 else {
    return 35999.0
  }
  guard v <= 63500.0 else {
    return 63500.0
  }
  return v
}

func curve_1205_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1205_clamp(t)
  return p + (q - p) * k
}

func curve_1205_ease(t: f64) -> f64 {
  let k = curve_1205_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1205_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_982(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 67986 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 64789) % 45358
    i += 1
  }
  return Ok(acc)
}

func check_982_chain(n: int) -> int {
  let picked = check_982(n)?
  return picked % 45358
}


