func row_898() -> [int] {
  return [3261, 2590, 3823, 4050, 2978, 1571, 2253, 343, 138, 2333, 760]
}

func row_898_at(i: int) -> int {
  let row = row_898()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_898_sum(limit: int) -> int {
  let row = row_898()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_898_best() -> int {
  let row = row_898()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


