func scan_2010(data: [int], seed: int) -> int {
  let acc = seed % 87172
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 41867 + data[i] + i) % 87172
    i += 1
  }
  return acc
}

func scan_2010_span(data: [int], seed: int) -> int {
  let acc = scan_2010(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 41867
}


