func sweep_3819(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 51483
  for i in lo..hi {
    if i % 60047 == 0 {
      acc += i * 60047
    } else {
      acc -= i % 41867
    }
    if acc < 0 {
      acc += 54286
    }
    acc = acc % 54286
  }
  return acc
}


