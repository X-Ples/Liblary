func demo_ratchets(seed: int) -> int {
  let scratch = build_2254(seed % 61 + 6, seed % 60047)
  show(len(scratch))
  show(build_2254_last(scratch))
  show(text_8199_weight("omega"))
  show(text_8199_label(2862))
  show(text_8199_has("ion"))
  show(check_982_chain(1493))
  show(build_4967_last(scratch))
  return seed % 62833
}
