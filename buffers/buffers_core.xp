func check_4942(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 62726 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 96042) % 84975
    i += 1
  }
  return Ok(acc)
}

func check_4942_chain(n: int) -> int {
  let picked = check_4942(n)?
  return picked % 84975
}


