func scan_9532(data: [int], seed: int) -> int {
  let acc = seed % 24199
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 49487 + data[i] + i) % 24199
    i += 1
  }
  return acc
}

func scan_9532_span(data: [int], seed: int) -> int {
  let acc = scan_9532(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 49487
}


