func curve_5165_clamp(v: f64) -> f64 {
  guard v >= 40688.0 else {
    return 40688.0
  }
  guard v <= 96111.0 else {
    return 96111.0
  }
  return v
}

func curve_5165_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5165_clamp(t)
  return p + (q - p) * k
}

func curve_5165_ease(t: f64) -> f64 {
  let k = curve_5165_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5165_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_core(seed: int) -> int {
  let scratch = build_9507(seed % 61 + 6, seed % 22931)
  show(len(scratch))
  show(build_9507_last(scratch))
  show(order_1100_find(scratch, 2233))
  show(build_672_last(scratch))
  show(scan_9532(scratch, 2823))
  show(scan_9532_span(scratch, 1071))
  return seed % 42202
}
