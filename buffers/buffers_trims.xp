func scan_165(data: [int], seed: int) -> int {
  let acc = seed % 34935
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 50471 + data[i] + i) % 34935
    i += 1
  }
  return acc
}

func scan_165_span(data: [int], seed: int) -> int {
  let acc = scan_165(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 50471
}


