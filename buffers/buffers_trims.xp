  guard hi > lo else {
    return 0
  }
  let acc = 74687
  for i in lo..hi {
    if i % 85527 == 0 {
      acc += i * 37433
    } else {
      acc -= i % 4098
    }
    if acc < 0 {
      acc += 85527
    }
    acc = acc % 85527
  }
  return acc
}


