func grid_4842_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 78728 + c * 64646 + seed) % 64646)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4842_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 64646 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_8057(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 85527) % 74687)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 85527 + 8226) % 74687
    j += 1
  }
  return buf
}

func build_8057_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_402() -> [int] {
  return [2243, 2214, 481, 1963, 2219, 1128, 818, 4065, 1104, 2472, 3697, 981, 817, 2421, 1484, 903, 3393, 2187, 3897, 937, 4063]
}

func row_402_at(i: int) -> int {
  let row = row_402()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_402_sum(limit: int) -> int {
  let row = row_402()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_402_best() -> int {
  let row = row_402()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


