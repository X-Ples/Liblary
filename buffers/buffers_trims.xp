func check_4823(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 12300 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 18386) % 4098
    i += 1
  }
  return Ok(acc)
}

func check_4823_chain(n: int) -> int {
  let picked = check_4823(n)?
  return picked % 4098
}


