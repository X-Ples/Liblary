func demo_trims(seed: int) -> int {
  let scratch = build_8057(seed % 61 + 6, seed % 39206)
  show(len(scratch))
  show(grid_4842_rowsum(scratch, 3715, 3671, 102))
  show(build_8057_last(scratch))
  show(row_402_at(3394))
  show(row_402_sum(1600))
  return seed % 74687
}
