func curve_3222_clamp(v: f64) -> f64 {
  guard v >= 10040.0 else {
    return 10040.0
  }
  guard v <= 20868.0 else {
    return 20868.0
  }
  return v
}

func curve_3222_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3222_clamp(t)
  return p + (q - p) * k
}

func curve_3222_ease(t: f64) -> f64 {
  let k = curve_3222_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3222_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_6726_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 39206
    i += 1
  }
  return acc % 39206
}

func text_6726_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "gamma"
}

func text_6726_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 33975
}


