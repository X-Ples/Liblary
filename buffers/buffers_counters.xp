func check_4413(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 4044 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 75992) % 64339
    i += 1
  }
  return Ok(acc)
}

func check_4413_chain(n: int) -> int {
  let picked = check_4413(n)?
  return picked % 64339
}


