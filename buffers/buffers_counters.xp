const K0 = 75992
const K1 = 69916
const K2 = 81720
const K3 = 69916
const K4 = 96533
const K5 = 31345
const K6 = 64339

func scan_9441(data: [int], seed: int) -> int {
  let acc = seed % 40787
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 69916 + data[i] + i) % 40787
    i += 1
  }
  return acc
}

func scan_9441_span(data: [int], seed: int) -> int {
  let acc = scan_9441(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 69916
}


func build_3301(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 69916) % 75479)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 69916 + 75992) % 75479
    j += 1
  }
  return buf
}

func build_3301_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_5140(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5140_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


