func curve_8449_clamp(v: f64) -> f64 {
  guard v >= 16929.0 else {
    return 16929.0
  }
  guard v <= 38246.0 else {
    return 38246.0
  }
  return v
}

func curve_8449_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8449_clamp(t)
  return p + (q - p) * k
}

func curve_8449_ease(t: f64) -> f64 {
  let k = curve_8449_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8449_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


