func demo_tables(seed: int) -> int {
  let scratch = build_768(seed % 61 + 6, seed % 32243)
  show(len(scratch))
  show(text_9537_weight("harbor"))
  show(text_9537_label(1867))
  show(text_9537_has("talus"))
  show(text_3991_weight("omega"))
  show(text_3991_label(830))
