func text_9537_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 34420
    i += 1
  }
  return acc % 34420
}

func text_9537_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "mesa"
}

func text_9537_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 5704
}


