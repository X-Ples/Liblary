func sweep_8392(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 41793
  for i in lo..hi {
    if i % 32448 == 0 {
      acc += i * 9088
    } else {
      acc -= i % 9088
    }
    if acc < 0 {
      acc += 29799
    }
    acc = acc % 29799
  }
  return acc
}


