func build_768(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 5704) % 82282)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 5704 + 58330) % 82282
    j += 1
  }
  return buf
}

func build_768_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_2765(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 97696 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 59788) % 58330
    i += 1
  }
  return Ok(acc)
}

func check_2765_chain(n: int) -> int {
  let picked = check_2765(n)?
  return picked % 58330
}


