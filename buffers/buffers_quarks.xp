func demo_quarks(seed: int) -> int {
  let scratch = build_1990(seed % 61 + 6, seed % 69998)
  show(len(scratch))
  show(build_1990_last(scratch))
  show(gate_8475(1598, 999, 2744))
  show(gate_8475_score(667, 1978, 1525))
  show(text_9678_weight("ember"))
  return seed % 14232
}
