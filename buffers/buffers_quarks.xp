func check_4199(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 77699 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 88670) % 44005
    i += 1
  }
  return Ok(acc)
}

func check_4199_chain(n: int) -> int {
  let picked = check_4199(n)?
  return picked % 44005
}


