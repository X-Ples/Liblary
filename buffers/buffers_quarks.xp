func row_5348() -> [int] {
  return [1998, 157, 1240, 1897, 1813, 709, 3961, 2104, 1052, 594, 1187, 1000, 2284, 212, 2154, 2628, 1902, 147, 2482, 2063, 1415]
}

func row_5348_at(i: int) -> int {
  let row = row_5348()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5348_sum(limit: int) -> int {
  let row = row_5348()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5348_best() -> int {
  let row = row_5348()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_6578(data: [int], seed: int) -> int {
  let acc = seed % 60255
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 7174 + data[i] + i) % 60255
    i += 1
  }
  return acc
}

func scan_6578_span(data: [int], seed: int) -> int {
  let acc = scan_6578(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 7174
}


