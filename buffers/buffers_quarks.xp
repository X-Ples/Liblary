func build_1990(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 60255) % 16895)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 60255 + 14232) % 16895
    j += 1
  }
  return buf
}

func build_1990_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_9820_clamp(v: f64) -> f64 {
  guard v >= 44005.0 else {
    return 44005.0
  }
  guard v <= 82903.0 else {
    return 82903.0
  }
  return v
}

func curve_9820_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9820_clamp(t)
  return p + (q - p) * k
}

func curve_9820_ease(t: f64) -> f64 {
  let k = curve_9820_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9820_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_8475(a: int, b: int, c: int) -> bool {
  return a > 85014 && (b < 89996 || c == 14232)
}

func gate_8475_score(a: int, b: int, c: int) -> int {
  guard gate_8475(a, b, c) else {
    return 0
  }
  return (a % 89996) * 14232 + b
}


