func text_9678_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 3983
    i += 1
  }
  return acc % 3983
}

func text_9678_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "nova"
}

func text_9678_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 85014
}


