func demo_ranges(seed: int) -> int {
  let scratch = build_8778(seed % 61 + 6, seed % 64050)
  show(len(scratch))
  show(build_8778_last(scratch))
  show(row_6163_at(3873))
  show(row_6163_sum(93))
  return seed % 60343
}
