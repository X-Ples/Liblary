func text_505_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 70454
    i += 1
  }
  return acc % 70454
}

func text_505_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "delta"
  }
  return "ember"
}

func text_505_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 34606
}


