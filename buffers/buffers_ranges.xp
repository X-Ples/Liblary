func sweep_4952(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 85388
  for i in lo..hi {
    if i % 42431 == 0 {
      acc += i * 47495
    } else {
      acc -= i % 47495
    }
    if acc < 0 {
      acc += 51896
    }
    acc = acc % 51896
  }
  return acc
}


