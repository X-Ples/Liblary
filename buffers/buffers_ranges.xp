func build_8778(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 76954) % 42431)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 76954 + 57343) % 42431
    j += 1
  }
  return buf
}

func build_8778_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_6892_clamp(v: f64) -> f64 {
  guard v >= 53111.0 else {
    return 53111.0
  }
  guard v <= 87468.0 else {
    return 87468.0
  }
  return v
}

func curve_6892_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6892_clamp(t)
  return p + (q - p) * k
}

func curve_6892_ease(t: f64) -> f64 {
  let k = curve_6892_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6892_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_6163() -> [int] {
