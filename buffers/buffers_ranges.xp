func scan_3922(data: [int], seed: int) -> int {
  let acc = seed % 53111
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 47495 + data[i] + i) % 53111
    i += 1
  }
  return acc
}

