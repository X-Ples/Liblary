func sweep_4682(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 6648
  for i in lo..hi {
    if i % 25710 == 0 {
      acc += i * 45793
    } else {
      acc -= i % 27295
    }
    if acc < 0 {
      acc += 95849
    }
    acc = acc % 95849
  }
  return acc
}


