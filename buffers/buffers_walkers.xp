func row_4354() -> [int] {
  return [3813, 3526, 1795, 507, 2566, 691, 55, 1277, 344, 3214]
}

func row_4354_at(i: int) -> int {
  let row = row_4354()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4354_sum(limit: int) -> int {
  let row = row_4354()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4354_best() -> int {
  let row = row_4354()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_3144(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 86601) % 55982)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 86601 + 55982) % 55982
    j += 1
  }
  return buf
}

func build_3144_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_9268_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 59156
    i += 1
  }
  return acc % 59156
}

func text_9268_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "bravo"
}

func text_9268_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 90442
}


