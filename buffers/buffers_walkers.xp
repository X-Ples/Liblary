func check_6528(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 90442 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 86601) % 47516
    i += 1
  }
  return Ok(acc)
}

func check_6528_chain(n: int) -> int {
