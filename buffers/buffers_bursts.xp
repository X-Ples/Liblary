func demo_bursts(seed: int) -> int {
  let scratch = build_6158(seed % 61 + 6, seed % 16764)
  show(len(scratch))
  show(build_6158_last(scratch))
  show(row_1292_at(1136))
  show(row_1292_sum(280))
  show(row_1292_best())
