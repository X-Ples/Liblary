func build_6158(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 16764) % 93279)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 16764 + 81770) % 93279
    j += 1
  }
  return buf
}

func build_6158_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_1292() -> [int] {
  return [2224, 3661, 9, 2432, 1682, 1915, 3978, 1845, 1167, 2626, 539, 1225, 3658, 2489, 1976, 4038]
}

func row_1292_at(i: int) -> int {
  let row = row_1292()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1292_sum(limit: int) -> int {
  let row = row_1292()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1292_best() -> int {
  let row = row_1292()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_2993(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 45653
  for i in lo..hi {
    if i % 49900 == 0 {
      acc += i * 92343
    } else {
      acc -= i % 92658
    }
    if acc < 0 {
      acc += 84293
    }
    acc = acc % 84293
  }
  return acc
}


