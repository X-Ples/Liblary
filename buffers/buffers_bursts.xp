func curve_2658_clamp(v: f64) -> f64 {
  guard v >= 54059.0 else {
    return 54059.0
  }
  guard v <= 61217.0 else {
    return 61217.0
  }
  return v
}

func curve_2658_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2658_clamp(t)
  return p + (q - p) * k
}

func curve_2658_ease(t: f64) -> f64 {
  let k = curve_2658_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2658_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_2307(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 76009 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 16764) % 93279
    i += 1
  }
  return Ok(acc)
}

func check_2307_chain(n: int) -> int {
  let picked = check_2307(n)?
  return picked % 93279
}


