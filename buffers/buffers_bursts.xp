  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 45653
    i += 1
  }
  return acc % 45653
}

func text_747_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "sigma"
  }
  return "mesa"
}

func text_747_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 98613
}


