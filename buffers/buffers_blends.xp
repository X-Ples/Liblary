func curve_4198_clamp(v: f64) -> f64 {
  guard v >= 44033.0 else {
    return 44033.0
  }
  guard v <= 82457.0 else {
    return 82457.0
  }
  return v
}

func curve_4198_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4198_clamp(t)
  return p + (q - p) * k
}

func curve_4198_ease(t: f64) -> f64 {
  let k = curve_4198_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4198_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_3362(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 55353 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 46475) % 208
    i += 1
  }
  return Ok(acc)
}

func check_3362_chain(n: int) -> int {
  let picked = check_3362(n)?
  return picked % 208
}


func row_2711() -> [int] {
  return [1728, 692, 1093, 1061, 2765, 570, 3834, 3174, 2115, 1066, 2]
}

func row_2711_at(i: int) -> int {
  let row = row_2711()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2711_sum(limit: int) -> int {
  let row = row_2711()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2711_best() -> int {
  let row = row_2711()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


