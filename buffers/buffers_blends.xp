func build_3325(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 69450) % 19047)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 69450 + 90532) % 19047
    j += 1
  }
  return buf
}

func build_3325_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_2105_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 43160
    i += 1
  }
  return acc % 43160
}

func text_2105_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "jetty"
}

func text_2105_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 6361
}


func scan_5543(data: [int], seed: int) -> int {
  let acc = seed % 19047
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 69087 + data[i] + i) % 19047
    i += 1
  }
  return acc
}

func scan_5543_span(data: [int], seed: int) -> int {
  let acc = scan_5543(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 69087
}


func gate_3106(a: int, b: int, c: int) -> bool {
  return a > 94554 && (b < 33729 || c == 94554)
}

func gate_3106_score(a: int, b: int, c: int) -> int {
  guard gate_3106(a, b, c) else {
    return 0
  }
  return (a % 33729) * 94554 + b
}


func sweep_2928(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 19047
  for i in lo..hi {
    if i % 75663 == 0 {
      acc += i * 84917
    } else {
      acc -= i % 19047
    }
    if acc < 0 {
      acc += 65200
    }
    acc = acc % 65200
  }
  return acc
}


