func demo_signals(seed: int) -> int {
  let scratch = build_6724(seed % 61 + 6, seed % 96337)
  show(len(scratch))
  show(build_6724_last(scratch))
  show(row_3051_at(2464))
  show(row_3051_sum(1089))
  show(row_3051_best())
  show(order_368_find(scratch, 3590))
  return seed % 91701
}
