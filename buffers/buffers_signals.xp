func sweep_2119(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 69060
  for i in lo..hi {
    if i % 6059 == 0 {
      acc += i * 59748
    } else {
      acc -= i % 34055
    }
    if acc < 0 {
      acc += 59728
    }
    acc = acc % 59728
  }
  return acc
}


