func check_6393(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 59748 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 45760) % 38169
    i += 1
  }
  return Ok(acc)
}

func check_6393_chain(n: int) -> int {
  let picked = check_6393(n)?
  return picked % 38169
}


