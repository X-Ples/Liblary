func grid_6524_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 35094 + c * 96279 + seed) % 96279)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6524_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 96279 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_9876(data: [int], seed: int) -> int {
  let acc = seed % 29619
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 55882 + data[i] + i) % 29619
    i += 1
  }
  return acc
}

func scan_9876_span(data: [int], seed: int) -> int {
  let acc = scan_9876(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 55882
}


