func sweep_2081(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 27493
  for i in lo..hi {
    if i % 19795 == 0 {
      acc += i * 18785
    } else {
      acc -= i % 94225
    }
    if acc < 0 {
      acc += 20125
    }
    acc = acc % 20125
  }
  return acc
}


func build_4153(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 13954) % 834)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 13954 + 20125) % 834
    j += 1
  }
  return buf
}

func build_4153_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_4772_weight(tag: str) -> int {
  let n = len(tag)
