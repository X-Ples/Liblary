func row_5286() -> [int] {
  return [2395, 2370, 585, 3062, 1093, 2772, 1926, 2908, 928, 2052, 293, 1806, 2692, 3971, 1583, 1722]
}

func row_5286_at(i: int) -> int {
  let row = row_5286()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5286_sum(limit: int) -> int {
  let row = row_5286()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5286_best() -> int {
  let row = row_5286()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_1837(count: int, start: int) -> [int] {
