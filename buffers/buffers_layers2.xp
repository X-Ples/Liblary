    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 86241 + data[i] + i) % 99473
    i += 1
  }
  return acc
}

func scan_699_span(data: [int], seed: int) -> int {
  let acc = scan_699(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 86241
}


