func curve_5170_clamp(v: f64) -> f64 {
  guard v >= 59130.0 else {
    return 59130.0
  }
  guard v <= 86241.0 else {
    return 86241.0
  }
  return v
}

func curve_5170_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5170_clamp(t)
  return p + (q - p) * k
}

func curve_5170_ease(t: f64) -> f64 {
  let k = curve_5170_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5170_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_699(data: [int], seed: int) -> int {
  let acc = seed % 99473
  let n = len(data)
