func grid_8330_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 25667 + c * 30897 + seed) % 30897)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8330_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 30897 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func demo_vectors2(seed: int) -> int {
  let scratch = build_1666(seed % 61 + 6, seed % 17480)
  show(len(scratch))
  show(row_290_at(213))
  show(row_290_sum(3005))
  show(row_290_best())
  show(build_1666_last(scratch))
  return seed % 46973
}
