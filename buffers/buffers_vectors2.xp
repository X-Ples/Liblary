func row_290() -> [int] {
  return [1084, 3696, 2632, 3473, 1146, 3699, 3231, 2260, 465, 3206, 926, 3455, 2169, 2871, 3497, 2388, 2796, 2748, 3948, 3115]
}

func row_290_at(i: int) -> int {
  let row = row_290()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_290_sum(limit: int) -> int {
  let row = row_290()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_290_best() -> int {
  let row = row_290()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_1666(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 46973) % 67600)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 46973 + 38429) % 67600
    j += 1
  }
  return buf
}

func build_1666_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


