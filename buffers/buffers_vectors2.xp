func gate_244(a: int, b: int, c: int) -> bool {
  return a > 38429 && (b < 80155 || c == 6127)
}

func gate_244_score(a: int, b: int, c: int) -> int {
  guard gate_244(a, b, c) else {
    return 0
  }
  return (a % 80155) * 6127 + b
}


func sweep_7255(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 17480
  for i in lo..hi {
    if i % 67600 == 0 {
      acc += i * 38429
    } else {
      acc -= i % 86139
    }
    if acc < 0 {
      acc += 82791
    }
    acc = acc % 82791
  }
  return acc
}


func curve_7443_clamp(v: f64) -> f64 {
  guard v >= 58788.0 else {
    return 58788.0
  }
  guard v <= 82232.0 else {
    return 82232.0
  }
  return v
}

func curve_7443_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7443_clamp(t)
  return p + (q - p) * k
}

func curve_7443_ease(t: f64) -> f64 {
  let k = curve_7443_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7443_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


