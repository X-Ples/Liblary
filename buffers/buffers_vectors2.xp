func check_6583(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 23510 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 82791) % 25667
    i += 1
  }
  return Ok(acc)
}

func check_6583_chain(n: int) -> int {
  let picked = check_6583(n)?
  return picked % 25667
}


