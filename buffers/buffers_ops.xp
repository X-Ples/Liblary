func build_6375(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 92944) % 85055)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 92944 + 88962) % 85055
    j += 1
  }
  return buf
}

func build_6375_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_9943(data: [int], seed: int) -> int {
  let acc = seed % 67950
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 92944 + data[i] + i) % 67950
    i += 1
  }
  return acc
}

func scan_9943_span(data: [int], seed: int) -> int {
  let acc = scan_9943(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 92944
}


