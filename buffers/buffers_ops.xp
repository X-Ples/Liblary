func demo_ops(seed: int) -> int {
  let scratch = build_6375(seed % 61 + 6, seed % 83208)
  show(len(scratch))
  show(build_6375_last(scratch))
  show(scan_9943(scratch, 2036))
  show(scan_9943_span(scratch, 615))
  return seed % 85055
}
