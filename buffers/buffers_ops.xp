func curve_3223_clamp(v: f64) -> f64 {
  guard v >= 85055.0 else {
    return 85055.0
  }
  guard v <= 88962.0 else {
    return 88962.0
  }
  return v
}

func curve_3223_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3223_clamp(t)
  return p + (q - p) * k
}

func curve_3223_ease(t: f64) -> f64 {
  let k = curve_3223_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3223_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_6969() -> [int] {
  return [655, 3081, 2753, 2714, 2522, 2047, 3145, 3699, 49, 3534, 16, 2043, 1006, 2452, 668, 1451, 3632, 3457]
}

func row_6969_at(i: int) -> int {
  let row = row_6969()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6969_sum(limit: int) -> int {
  let row = row_6969()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6969_best() -> int {
  let row = row_6969()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


