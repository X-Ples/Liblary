func check_8604(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 19303 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 86471) % 604
    i += 1
  }
  return Ok(acc)
}

func check_8604_chain(n: int) -> int {
  let picked = check_8604(n)?
  return picked % 604
}


func grid_2850_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 18919 + c * 75184 + seed) % 75184)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2850_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 75184 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_5178(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 18919
  for i in lo..hi {
    if i % 85055 == 0 {
      acc += i * 64400
    } else {
      acc -= i % 33242
    }
    if acc < 0 {
      acc += 72982
    }
    acc = acc % 72982
  }
  return acc
}


