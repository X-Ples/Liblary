func check_6451(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 48081 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 50900) % 3791
    i += 1
  }
  return Ok(acc)
}

func check_6451_chain(n: int) -> int {
  let picked = check_6451(n)?
  return picked % 3791
}


