func row_8620() -> [int] {
  return [2667, 271, 2027, 975, 265, 2967, 2119, 2578, 2995, 894, 1043]
}

func row_8620_at(i: int) -> int {
  let row = row_8620()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8620_sum(limit: int) -> int {
  let row = row_8620()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8620_best() -> int {
  let row = row_8620()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func demo_checks(seed: int) -> int {
  let scratch = build_2925(seed % 61 + 6, seed % 44742)
  show(len(scratch))
  show(build_2925_last(scratch))
  show(sweep_2762(2573, 2290))
  show(text_6721_weight("cargo"))
  return seed % 61403
}
