func build_2925(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 48081) % 68307)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 48081 + 95635) % 68307
    j += 1
  }
  return buf
}

func build_2925_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_2762(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 50900
  for i in lo..hi {
    if i % 95116 == 0 {
      acc += i * 46203
    } else {
      acc -= i % 65350
    }
    if acc < 0 {
      acc += 72843
    }
    acc = acc % 72843
  }
  return acc
}


func text_6721_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 86517
    i += 1
  }
  return acc % 86517
}

func text_6721_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "omega"
}

func text_6721_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 97683
}


func order_6317(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6317_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


