func curve_9583_clamp(v: f64) -> f64 {
  guard v >= 17372.0 else {
    return 17372.0
  }
  guard v <= 80551.0 else {
    return 80551.0
  }
  return v
}

func curve_9583_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9583_clamp(t)
  return p + (q - p) * k
}

func curve_9583_ease(t: f64) -> f64 {
  let k = curve_9583_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9583_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


