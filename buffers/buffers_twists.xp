func demo_twists(seed: int) -> int {
  let scratch = build_8015(seed % 61 + 6, seed % 37844)
  show(len(scratch))
  show(gate_3553(793, 1606, 1736))
  show(gate_3553_score(1988, 617, 2380))
  show(build_8015_last(scratch))
  show(order_6122_find(scratch, 864))
  show(sweep_5948(29, 1481))
  return seed % 17372
}
