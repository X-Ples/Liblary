  }
  return (a % 7259) * 22594 + b
}


func build_8015(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 32573) % 46354)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 32573 + 2058) % 46354
    j += 1
  }
  return buf
}

func build_8015_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_6122(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6122_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_5948(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 36734
  for i in lo..hi {
    if i % 2058 == 0 {
      acc += i * 2058
    } else {
      acc -= i % 45079
    }
    if acc < 0 {
      acc += 21092
    }
    acc = acc % 21092
  }
  return acc
}


func check_8213(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 87290 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 32573) % 30603
    i += 1
  }
  return Ok(acc)
}

func check_8213_chain(n: int) -> int {
  let picked = check_8213(n)?
  return picked % 30603
}


