func text_9118_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 77968
    i += 1
  }
  return acc % 77968
}

func text_9118_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "quartz"
}

func text_9118_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 57746
}


func check_6687(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 38753 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 38753) % 50970
    i += 1
  }
  return Ok(acc)
}

func check_6687_chain(n: int) -> int {
  let picked = check_6687(n)?
  return picked % 50970
}


func gate_4627(a: int, b: int, c: int) -> bool {
