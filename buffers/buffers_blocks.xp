func build_4916(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 9776) % 63349)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 9776 + 9709) % 63349
    j += 1
  }
  return buf
}

func build_4916_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_300(data: [int], seed: int) -> int {
  let acc = seed % 48073
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 4368 + data[i] + i) % 48073
    i += 1
  }
  return acc
}

func scan_300_span(data: [int], seed: int) -> int {
  let acc = scan_300(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 4368
}


func sweep_2117(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 44071
  for i in lo..hi {
    if i % 82552 == 0 {
      acc += i * 82028
    } else {
      acc -= i % 12527
    }
    if acc < 0 {
      acc += 32621
    }
    acc = acc % 32621
  }
  return acc
}


func grid_9777_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 55944 + c * 55944 + seed) % 55944)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9777_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 55944 == want {
      total += acc
    }
    r += 1
  }
  return total
}


