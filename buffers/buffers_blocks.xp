func demo_blocks(seed: int) -> int {
  let scratch = build_4916(seed % 61 + 6, seed % 82552)
  show(len(scratch))
  show(build_4916_last(scratch))
  show(scan_300(scratch, 1806))
  show(scan_300_span(scratch, 1701))
  show(sweep_2117(1134, 194))
  show(grid_9777_rowsum(scratch, 3357, 1774, 2843))
  return seed % 64096
}
