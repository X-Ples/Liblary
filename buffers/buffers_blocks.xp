func check_8431(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 94778 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 9709) % 44071
    i += 1
  }
  return Ok(acc)
}

func check_8431_chain(n: int) -> int {
  let picked = check_8431(n)?
  return picked % 44071
}


