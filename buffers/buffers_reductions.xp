func curve_4492_clamp(v: f64) -> f64 {
  guard v >= 51565.0 else {
    return 51565.0
  }
  guard v <= 93778.0 else {
    return 93778.0
  }
  return v
}

func curve_4492_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4492_clamp(t)
  return p + (q - p) * k
}

func curve_4492_ease(t: f64) -> f64 {
  let k = curve_4492_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4492_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_2755(a: int, b: int, c: int) -> bool {
  return a > 14622 && (b < 59234 || c == 27890)
}

func gate_2755_score(a: int, b: int, c: int) -> int {
  guard gate_2755(a, b, c) else {
    return 0
  }
  return (a % 59234) * 27890 + b
}


func build_1679(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 27890) % 97214)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 27890 + 93778) % 97214
    j += 1
  }
  return buf
}

func build_1679_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_701_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 93778 + c * 14622 + seed) % 14622)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_701_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 14622 == want {
      total += acc
    }
    r += 1
  }
  return total
}


