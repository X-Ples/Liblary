func row_8120() -> [int] {
  return [1649, 3598, 2492, 1545, 288, 1642, 3439, 445, 3321, 2043, 930]
}

func row_8120_at(i: int) -> int {
  let row = row_8120()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8120_sum(limit: int) -> int {
  let row = row_8120()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8120_best() -> int {
  let row = row_8120()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


