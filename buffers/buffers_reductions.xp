func sweep_3138(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 84788
  for i in lo..hi {
    if i % 25217 == 0 {
      acc += i * 64356
    } else {
      acc -= i % 89791
    }
    if acc < 0 {
      acc += 14622
    }
    acc = acc % 14622
  }
  return acc
}


func text_4697_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 21813
    i += 1
  }
  return acc % 21813
}

func text_4697_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "nova"
}

func text_4697_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 14622
}


