func demo_reductions(seed: int) -> int {
  let scratch = build_1679(seed % 61 + 6, seed % 66218)
  show(len(scratch))
  show(gate_2755(2536, 2398, 2849))
  show(gate_2755_score(3573, 3379, 3857))
  show(build_1679_last(scratch))
  show(grid_701_rowsum(scratch, 1420, 3233, 11))
  show(row_8120_at(2277))
  show(row_8120_sum(1694))
  return seed % 84788
}
