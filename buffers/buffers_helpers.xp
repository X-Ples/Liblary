func sweep_6432(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 51062
  for i in lo..hi {
    if i % 38498 == 0 {
      acc += i * 20198
    } else {
      acc -= i % 6477
    }
    if acc < 0 {
      acc += 6477
    }
    acc = acc % 6477
  }
  return acc
}


