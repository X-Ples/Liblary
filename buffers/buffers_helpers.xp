func row_1085() -> [int] {
  return [1644, 519, 1787, 1412, 3541, 426, 3931, 3689, 3821, 766, 275, 3363, 2413, 735, 438, 1678, 2574, 1626, 3464, 826, 1383]
}

func row_1085_at(i: int) -> int {
  let row = row_1085()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1085_sum(limit: int) -> int {
  let row = row_1085()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1085_best() -> int {
  let row = row_1085()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_8170(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 55951) % 38498)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 55951 + 643) % 38498
    j += 1
  }
  return buf
}

func build_8170_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_6265(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 55951 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 89383) % 28233
    i += 1
  }
  return Ok(acc)
}

func check_6265_chain(n: int) -> int {
  let picked = check_6265(n)?
  return picked % 28233
}


func gate_3400(a: int, b: int, c: int) -> bool {
  return a > 95784 && (b < 20198 || c == 6477)
}

func gate_3400_score(a: int, b: int, c: int) -> int {
  guard gate_3400(a, b, c) else {
    return 0
  }
  return (a % 20198) * 6477 + b
}


func grid_1379_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 98316 + c * 20198 + seed) % 20198)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1379_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 20198 == want {
      total += acc
    }
    r += 1
  }
  return total
}


