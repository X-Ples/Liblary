func sweep_2025(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 88486
  for i in lo..hi {
    if i % 84088 == 0 {
      acc += i * 84088
    } else {
      acc -= i % 63140
    }
    if acc < 0 {
      acc += 13265
    }
    acc = acc % 13265
  }
  return acc
}


func scan_6807(data: [int], seed: int) -> int {
  let acc = seed % 22745
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 80753 + data[i] + i) % 22745
    i += 1
  }
  return acc
}

func scan_6807_span(data: [int], seed: int) -> int {
  let acc = scan_6807(data, seed)
  guard acc > 0 else {
