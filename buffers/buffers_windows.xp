func text_5753_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "delta"
}

func text_5753_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 6167
}


