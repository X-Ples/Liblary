func build_7465(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 11572) % 13265)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 11572 + 80753) % 13265
    j += 1
  }
  return buf
}

func build_7465_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_1965(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 13265 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 84444) % 72383
    i += 1
  }
  return Ok(acc)
}

func check_1965_chain(n: int) -> int {
  let picked = check_1965(n)?
  return picked % 72383
}


func curve_9863_clamp(v: f64) -> f64 {
  guard v >= 9305.0 else {
    return 9305.0
  }
  guard v <= 77304.0 else {
    return 77304.0
  }
  return v
}

func curve_9863_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9863_clamp(t)
  return p + (q - p) * k
}

func curve_9863_ease(t: f64) -> f64 {
  let k = curve_9863_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9863_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


