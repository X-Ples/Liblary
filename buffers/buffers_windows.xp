func demo_windows(seed: int) -> int {
  let scratch = build_7465(seed % 61 + 6, seed % 63140)
  show(len(scratch))
  show(build_7465_last(scratch))
  show(check_1965_chain(1656))
  show(grid_7842_rowsum(scratch, 3397, 2099, 1118))
  show(build_1732_last(scratch))
  show(build_1076_last(scratch))
  return seed % 52169
}
