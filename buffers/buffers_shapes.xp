func demo_shapes(seed: int) -> int {
  let scratch = build_9898(seed % 61 + 6, seed % 26551)
  show(len(scratch))
  show(build_9898_last(scratch))
  show(scan_4599(scratch, 2413))
  show(scan_4599_span(scratch, 2735))
  return seed % 3197
}
