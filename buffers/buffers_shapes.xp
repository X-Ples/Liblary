func build_9898(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 78038) % 21339)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 78038 + 16817) % 21339
    j += 1
  }
  return buf
}

func build_9898_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_4599(data: [int], seed: int) -> int {
  let acc = seed % 16817
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 19301 + data[i] + i) % 16817
    i += 1
  }
  return acc
}

func scan_4599_span(data: [int], seed: int) -> int {
  let acc = scan_4599(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 19301
}


