func row_7008() -> [int] {
  return [3662, 3514, 696, 2572, 4015, 4091, 2785, 2217, 3416, 3538, 828, 1205]
}

func row_7008_at(i: int) -> int {
  let row = row_7008()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7008_sum(limit: int) -> int {
  let row = row_7008()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7008_best() -> int {
  let row = row_7008()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


