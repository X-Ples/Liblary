func grid_9769_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 61827 + c * 96905 + seed) % 96905)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9769_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 96905 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_2468(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 93390) % 61827)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 93390 + 9596) % 61827
    j += 1
  }
  return buf
}

func build_2468_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_5764(data: [int], seed: int) -> int {
  let acc = seed % 53054
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 26169 + data[i] + i) % 53054
    i += 1
  }
  return acc
}

func scan_5764_span(data: [int], seed: int) -> int {
  let acc = scan_5764(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 26169
}


func gate_2125(a: int, b: int, c: int) -> bool {
  return a > 22318 && (b < 61827 || c == 61827)
}

func gate_2125_score(a: int, b: int, c: int) -> int {
  guard gate_2125(a, b, c) else {
    return 0
  }
  return (a % 61827) * 61827 + b
}


func sweep_2504(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 37369
  for i in lo..hi {
    if i % 65108 == 0 {
      acc += i * 96905
    } else {
      acc -= i % 71964
    }
    if acc < 0 {
      acc += 37703
    }
    acc = acc % 37703
  }
  return acc
}


func gate_7388(a: int, b: int, c: int) -> bool {
