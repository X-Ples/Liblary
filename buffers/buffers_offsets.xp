func demo_offsets(seed: int) -> int {
  let scratch = build_2468(seed % 61 + 6, seed % 86894)
  show(len(scratch))
  show(grid_9769_rowsum(scratch, 873, 2748, 3261))
  show(build_2468_last(scratch))
  show(scan_5764(scratch, 25))
  show(scan_5764_span(scratch, 405))
  show(gate_2125(2813, 1064, 1569))
  return seed % 66673
}
