func demo_offsets(seed: int) -> int {
  let scratch = build_4274(seed % 61 + 6, seed % 69905)
  show(len(scratch))
  show(build_4274_last(scratch))
  show(scan_1118(scratch, 1232))
  show(scan_1118_span(scratch, 706))
  show(build_8900_last(scratch))
  return seed % 54795
}
