func build_4274(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 43573) % 58770)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 43573 + 69905) % 58770
    j += 1
  }
  return buf
}

func build_4274_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_1118(data: [int], seed: int) -> int {
  let acc = seed % 11245
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 10056 + data[i] + i) % 11245
    i += 1
  }
  return acc
}

func scan_1118_span(data: [int], seed: int) -> int {
  let acc = scan_1118(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 10056
}


