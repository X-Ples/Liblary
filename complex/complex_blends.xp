func build_6305(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 53674) % 87104)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 53674 + 50638) % 87104
    j += 1
  }
  return buf
}

func build_6305_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_6167(data: [int], seed: int) -> int {
  let acc = seed % 41081
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 41357 + data[i] + i) % 41081
    i += 1
  }
  return acc
}

func scan_6167_span(data: [int], seed: int) -> int {
  let acc = scan_6167(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 41357
}


