func curve_2055_clamp(v: f64) -> f64 {
  guard v >= 76341.0 else {
    return 76341.0
  }
  guard v <= 77973.0 else {
    return 77973.0
  }
  return v
}

func curve_2055_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2055_clamp(t)
  return p + (q - p) * k
}

func curve_2055_ease(t: f64) -> f64 {
  let k = curve_2055_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2055_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_5433(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 945
  for i in lo..hi {
    if i % 36071 == 0 {
      acc += i * 970
    } else {
      acc -= i % 17586
    }
    if acc < 0 {
      acc += 77973
    }
    acc = acc % 77973
  }
  return acc
}


func grid_7192_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 66778 + c * 945 + seed) % 945)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7192_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 945 == want {
      total += acc
    }
    r += 1
  }
  return total
}


