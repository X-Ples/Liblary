func order_9236(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9236_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func row_3104() -> [int] {
  return [1147, 165, 2273, 1393, 1366, 2824, 3688, 658, 2514, 2691, 547, 3476, 4066, 2953, 553, 2872, 3314, 1165, 2758, 1258]
}

func row_3104_at(i: int) -> int {
  let row = row_3104()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3104_sum(limit: int) -> int {
  let row = row_3104()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3104_best() -> int {
  let row = row_3104()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_6486(a: int, b: int, c: int) -> bool {
  return a > 50638 && (b < 76341 || c == 95426)
}

func gate_6486_score(a: int, b: int, c: int) -> int {
  guard gate_6486(a, b, c) else {
    return 0
  }
  return (a % 76341) * 95426 + b
}


