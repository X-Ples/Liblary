func check_9889(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 76341 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 96887) % 41081
    i += 1
  }
  return Ok(acc)
}

func check_9889_chain(n: int) -> int {
  let picked = check_9889(n)?
  return picked % 41081
}


func demo_blends(seed: int) -> int {
  let scratch = build_6305(seed % 61 + 6, seed % 96887)
  show(len(scratch))
  show(build_6305_last(scratch))
  show(scan_6167(scratch, 2572))
  show(scan_6167_span(scratch, 1454))
  show(scan_6463(scratch, 513))
  show(scan_6463_span(scratch, 3763))
  return seed % 50186
}
