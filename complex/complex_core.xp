func build_5506(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 5993) % 44164)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 5993 + 7040) % 44164
    j += 1
  }
  return buf
}

func build_5506_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_9876(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 53490
  for i in lo..hi {
    if i % 17573 == 0 {
      acc += i * 50556
    } else {
      acc -= i % 90141
    }
    if acc < 0 {
      acc += 66113
    }
    acc = acc % 66113
  }
  return acc
}


func grid_500_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 71372 + c * 56634 + seed) % 56634)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_500_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 56634 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_6680_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 96738
    i += 1
  }
  return acc % 96738
}

func text_6680_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "sigma"
}

func text_6680_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 49977
}


func order_908(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_908_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


