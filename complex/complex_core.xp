func demo_core(seed: int) -> int {
  let scratch = build_5506(seed % 61 + 6, seed % 50556)
  show(len(scratch))
  show(build_5506_last(scratch))
  show(sweep_9876(2395, 3119))
  show(grid_500_rowsum(scratch, 551, 3599, 2397))
  show(text_6680_weight("lumen"))
  return seed % 7040
}
