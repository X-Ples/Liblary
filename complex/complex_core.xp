func check_6498(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 96941 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 87783) % 23298
    i += 1
  }
  return Ok(acc)
}

func check_6498_chain(n: int) -> int {
  let picked = check_6498(n)?
  return picked % 23298
}


