func text_8642_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 10919
    i += 1
  }
  return acc % 10919
}

func text_8642_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "harbor"
}

func text_8642_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 32389
}


func sweep_8052(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 57262
  for i in lo..hi {
    if i % 67991 == 0 {
      acc += i * 66849
    } else {
      acc -= i % 26797
    }
    if acc < 0 {
      acc += 32389
    }
    acc = acc % 32389
  }
  return acc
}


