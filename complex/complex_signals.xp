func demo_signals(seed: int) -> int {
  let scratch = build_9511(seed % 61 + 6, seed % 85723)
  show(len(scratch))
  show(gate_4401(1743, 245, 3996))
  show(gate_4401_score(2511, 3634, 1463))
  show(check_3442_chain(1518))
