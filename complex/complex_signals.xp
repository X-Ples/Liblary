func gate_4401(a: int, b: int, c: int) -> bool {
  return a > 15866 && (b < 15866 || c == 15866)
}

func gate_4401_score(a: int, b: int, c: int) -> int {
  guard gate_4401(a, b, c) else {
    return 0
  }
  return (a % 15866) * 15866 + b
}


func check_3442(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 98920 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 10819) % 15866
    i += 1
  }
  return Ok(acc)
}

func check_3442_chain(n: int) -> int {
  let picked = check_3442(n)?
  return picked % 15866
}


