func sweep_7933(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 67322
  for i in lo..hi {
    if i % 14289 == 0 {
      acc += i * 96951
    } else {
      acc -= i % 15866
    }
    if acc < 0 {
      acc += 15866
    }
    acc = acc % 15866
  }
  return acc
}


