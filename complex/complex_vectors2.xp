func build_9711(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 39577) % 18953)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 39577 + 39358) % 18953
    j += 1
  }
  return buf
}

func build_9711_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_4354() -> [int] {
