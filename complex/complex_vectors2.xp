func sweep_5895(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 484
  for i in lo..hi {
    if i % 43880 == 0 {
      acc += i * 8692
    } else {
      acc -= i % 61124
    }
    if acc < 0 {
      acc += 8692
    }
    acc = acc % 8692
  }
  return acc
}


func demo_vectors2(seed: int) -> int {
  let scratch = build_9711(seed % 61 + 6, seed % 484)
  show(len(scratch))
  show(build_9711_last(scratch))
  show(row_4354_at(1915))
  show(row_4354_sum(1832))
  show(row_4354_best())
  show(check_2180_chain(3050))
  return seed % 35960
}
