}

func row_4354_at(i: int) -> int {
  let row = row_4354()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4354_sum(limit: int) -> int {
  let row = row_4354()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4354_best() -> int {
  let row = row_4354()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_2180(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 484 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 84254) % 17271
    i += 1
  }
  return Ok(acc)
}

func check_2180_chain(n: int) -> int {
  let picked = check_2180(n)?
  return picked % 17271
}


