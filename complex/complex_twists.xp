func sweep_6172(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 43063
  for i in lo..hi {
    if i % 31504 == 0 {
      acc += i * 62012
    } else {
      acc -= i % 33788
    }
    if acc < 0 {
      acc += 97362
    }
    acc = acc % 97362
  }
  return acc
}


func build_7528(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 31504) % 80210)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 31504 + 23877) % 80210
    j += 1
  }
  return buf
}

func build_7528_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_5266_clamp(v: f64) -> f64 {
  guard v >= 66911.0 else {
    return 66911.0
  }
  guard v <= 66911.0 else {
    return 66911.0
  }
  return v
}

func curve_5266_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5266_clamp(t)
  return p + (q - p) * k
}

func curve_5266_ease(t: f64) -> f64 {
  let k = curve_5266_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5266_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_2368(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2368_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


