func text_2963_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 3945
    i += 1
  }
  return acc % 3945
}

func text_2963_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "mesa"
}

func text_2963_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 90588
}


func grid_4397_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 3945 + c * 80301 + seed) % 80301)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4397_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 80301 == want {
      total += acc
    }
    r += 1
  }
  return total
}


