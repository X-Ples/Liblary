  while i < n {
    acc = (acc * 81246 + data[i] + i) % 37686
    i += 1
  }
  return acc
}

func scan_7498_span(data: [int], seed: int) -> int {
  let acc = scan_7498(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 81246
}


func row_6235() -> [int] {
  return [283, 1349, 1328, 3529, 1400, 2909, 54, 1947, 1293, 3161, 1145, 2629, 1440, 2189, 4033, 894, 3760, 2737]
}

func row_6235_at(i: int) -> int {
  let row = row_6235()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6235_sum(limit: int) -> int {
  let row = row_6235()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6235_best() -> int {
  let row = row_6235()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


