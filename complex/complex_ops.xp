func sweep_589(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 98207
  for i in lo..hi {
    if i % 32943 == 0 {
      acc += i * 35307
    } else {
      acc -= i % 64276
    }
    if acc < 0 {
      acc += 96937
    }
    acc = acc % 96937
  }
  return acc
}


func grid_3070_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 62926 + c * 25665 + seed) % 25665)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3070_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 25665 == want {
      total += acc
    }
    r += 1
  }
  return total
}


