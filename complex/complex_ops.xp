}


func scan_2517(data: [int], seed: int) -> int {
  let acc = seed % 87932
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 84234 + data[i] + i) % 87932
    i += 1
  }
  return acc
}

func scan_2517_span(data: [int], seed: int) -> int {
  let acc = scan_2517(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 84234
}


func build_5364(count: int, start: int) -> [int] {
