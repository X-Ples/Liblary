func check_3519(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 64276 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 54078) % 43387
    i += 1
  }
  return Ok(acc)
}

func check_3519_chain(n: int) -> int {
  let picked = check_3519(n)?
  return picked % 43387
}


