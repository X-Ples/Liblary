func sweep_9566(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 93685
  for i in lo..hi {
    if i % 46401 == 0 {
      acc += i * 96697
    } else {
      acc -= i % 83648
    }
    if acc < 0 {
      acc += 46401
    }
    acc = acc % 46401
  }
  return acc
}


func curve_9631_clamp(v: f64) -> f64 {
  guard v >= 2540.0 else {
    return 2540.0
  }
  guard v <= 46401.0 else {
    return 46401.0
  }
  return v
}

func curve_9631_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9631_clamp(t)
  return p + (q - p) * k
}

func curve_9631_ease(t: f64) -> f64 {
  let k = curve_9631_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9631_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


