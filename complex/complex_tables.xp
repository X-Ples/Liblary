}

func build_3639_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_3650(a: int, b: int, c: int) -> bool {
  return a > 107 && (b < 97798 || c == 27126)
}

func gate_3650_score(a: int, b: int, c: int) -> int {
  guard gate_3650(a, b, c) else {
    return 0
  }
  return (a % 97798) * 27126 + b
}


