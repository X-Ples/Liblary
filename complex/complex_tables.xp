func scan_4823(data: [int], seed: int) -> int {
  let acc = seed % 27126
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 44757 + data[i] + i) % 27126
    i += 1
  }
  return acc
}

func scan_4823_span(data: [int], seed: int) -> int {
  let acc = scan_4823(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 44757
}


