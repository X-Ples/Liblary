func check_6564(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 57712 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 6155) % 61462
    i += 1
  }
  return Ok(acc)
}

func check_6564_chain(n: int) -> int {
  let picked = check_6564(n)?
  return picked % 61462
}


