func scan_8044(data: [int], seed: int) -> int {
  let acc = seed % 19129
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 52272 + data[i] + i) % 19129
    i += 1
  }
  return acc
}

func scan_8044_span(data: [int], seed: int) -> int {
  let acc = scan_8044(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 52272
}


