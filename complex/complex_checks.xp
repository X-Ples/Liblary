func demo_checks(seed: int) -> int {
  let scratch = build_5834(seed % 61 + 6, seed % 96905)
  show(len(scratch))
  show(build_5834_last(scratch))
  show(order_9350_find(scratch, 3632))
  show(grid_8402_rowsum(scratch, 1197, 850, 2468))
  show(gate_8356(1938, 3827, 379))
  return seed % 31992
}
