func row_5871() -> [int] {
  return [3041, 1691, 3193, 3253, 3173, 1631, 771, 2387, 1821, 1331]
}

func row_5871_at(i: int) -> int {
  let row = row_5871()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5871_sum(limit: int) -> int {
  let row = row_5871()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5871_best() -> int {
  let row = row_5871()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


