func sweep_7160(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 68983
  for i in lo..hi {
    if i % 37226 == 0 {
      acc += i * 85067
    } else {
      acc -= i % 85067
    }
    if acc < 0 {
      acc += 73844
    }
    acc = acc % 73844
  }
  return acc
}


