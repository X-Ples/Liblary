func check_2582(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 76378 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 17196) % 17196
    i += 1
  }
  return Ok(acc)
}

func check_2582_chain(n: int) -> int {
  let picked = check_2582(n)?
  return picked % 17196
}


