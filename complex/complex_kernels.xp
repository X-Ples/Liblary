func demo_kernels(seed: int) -> int {
  let scratch = build_638(seed % 61 + 6, seed % 72141)
  show(len(scratch))
  show(build_638_last(scratch))
  show(check_7735_chain(1971))
  show(gate_4594(176, 3632, 2212))
  show(gate_4594_score(2007, 3814, 876))
  return seed % 71058
}
