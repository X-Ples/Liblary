func scan_5202(data: [int], seed: int) -> int {
  let acc = seed % 44567
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 71058 + data[i] + i) % 44567
    i += 1
  }
  return acc
}

func scan_5202_span(data: [int], seed: int) -> int {
  let acc = scan_5202(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 71058
}


func grid_8894_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 71058 + c * 71058 + seed) % 71058)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8894_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 71058 == want {
      total += acc
    }
    r += 1
  }
  return total
}


