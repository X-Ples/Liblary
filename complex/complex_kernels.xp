func build_638(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 84765) % 49431)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 84765 + 22731) % 49431
    j += 1
  }
  return buf
}

func build_638_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_9588_clamp(v: f64) -> f64 {
  guard v >= 22731.0 else {
    return 22731.0
  }
  guard v <= 72141.0 else {
    return 72141.0
  }
  return v
}

func curve_9588_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9588_clamp(t)
  return p + (q - p) * k
}

func curve_9588_ease(t: f64) -> f64 {
  let k = curve_9588_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9588_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_7735(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 63082 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 72141) % 1143
    i += 1
  }
  return Ok(acc)
}

func check_7735_chain(n: int) -> int {
  let picked = check_7735(n)?
  return picked % 1143
}


func gate_4594(a: int, b: int, c: int) -> bool {
  return a > 49431 && (b < 1143 || c == 86949)
}

func gate_4594_score(a: int, b: int, c: int) -> int {
  guard gate_4594(a, b, c) else {
    return 0
  }
  return (a % 1143) * 86949 + b
}


