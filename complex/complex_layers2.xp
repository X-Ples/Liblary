func demo_layers2(seed: int) -> int {
  let scratch = build_8817(seed % 61 + 6, seed % 39133)
  show(len(scratch))
  show(build_8817_last(scratch))
  show(scan_9187(scratch, 3489))
  show(scan_9187_span(scratch, 2968))
  return seed % 44546
}
