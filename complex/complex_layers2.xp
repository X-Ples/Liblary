const K0 = 97262
const K1 = 36800
const K2 = 93634
const K3 = 19780
const K4 = 187
const K5 = 40456
const K6 = 44546
const K7 = 86312

func build_8817(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 47300) % 36800)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 47300 + 44546) % 36800
    j += 1
  }
  return buf
}

func build_8817_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_9187(data: [int], seed: int) -> int {
  let acc = seed % 9941
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 44546 + data[i] + i) % 9941
    i += 1
  }
  return acc
}

func scan_9187_span(data: [int], seed: int) -> int {
  let acc = scan_9187(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 44546
}


func text_6588_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 5990
    i += 1
  }
  return acc % 5990
}

func text_6588_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "sigma"
  }
  return "lumen"
}

func text_6588_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 97333
}


func grid_1763_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 2545 + c * 86312 + seed) % 86312)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1763_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 86312 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_3614(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 187 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 86312) % 86312
    i += 1
  }
  return Ok(acc)
}

func check_3614_chain(n: int) -> int {
  let picked = check_3614(n)?
  return picked % 86312
}


func curve_6147_clamp(v: f64) -> f64 {
  guard v >= 40100.0 else {
    return 40100.0
  }
  guard v <= 97333.0 else {
    return 97333.0
  }
  return v
}

func curve_6147_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6147_clamp(t)
  return p + (q - p) * k
}

func curve_6147_ease(t: f64) -> f64 {
  let k = curve_6147_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6147_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


