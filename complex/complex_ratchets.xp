func scan_5528(data: [int], seed: int) -> int {
  let acc = seed % 35991
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 17654 + data[i] + i) % 35991
    i += 1
  }
  return acc
}

func scan_5528_span(data: [int], seed: int) -> int {
  let acc = scan_5528(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 17654
}


func order_7241(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7241_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_4245(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 14839
  for i in lo..hi {
    if i % 41616 == 0 {
      acc += i * 17939
    } else {
      acc -= i % 96487
    }
    if acc < 0 {
      acc += 38669
    }
    acc = acc % 38669
  }
  return acc
}


func text_1443_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 6179
    i += 1
  }
  return acc % 6179
}

func text_1443_label(idx: int) -> str {
  if idx % 7 == 0 {
