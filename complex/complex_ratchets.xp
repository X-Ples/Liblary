func demo_ratchets(seed: int) -> int {
  let scratch = build_1338(seed % 61 + 6, seed % 6524)
  show(len(scratch))
  show(scan_5528(scratch, 2252))
  show(scan_5528_span(scratch, 220))
  show(order_7241_find(scratch, 297))
  show(sweep_4245(410, 1907))
  return seed % 60707
}
