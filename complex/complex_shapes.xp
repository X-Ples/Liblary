func gate_3029(a: int, b: int, c: int) -> bool {
  return a > 30698 && (b < 30698 || c == 28937)
}

func gate_3029_score(a: int, b: int, c: int) -> int {
  guard gate_3029(a, b, c) else {
    return 0
  }
  return (a % 30698) * 28937 + b
}


func curve_9119_clamp(v: f64) -> f64 {
  guard v >= 4405.0 else {
    return 4405.0
  }
  guard v <= 71156.0 else {
    return 71156.0
  }
  return v
}

func curve_9119_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9119_clamp(t)
  return p + (q - p) * k
}

func curve_9119_ease(t: f64) -> f64 {
  let k = curve_9119_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9119_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_3103(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3103_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


