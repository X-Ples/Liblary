func scan_821(data: [int], seed: int) -> int {
  let acc = seed % 12266
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 28937 + data[i] + i) % 12266
    i += 1
  }
  return acc
}

func scan_821_span(data: [int], seed: int) -> int {
  let acc = scan_821(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 28937
}


