func row_359() -> [int] {
  return [2648, 6, 2586, 3154, 279, 324, 11, 2016, 3109, 1636, 1303, 911]
}

func row_359_at(i: int) -> int {
  let row = row_359()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_359_sum(limit: int) -> int {
  let row = row_359()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_359_best() -> int {
  let row = row_359()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


