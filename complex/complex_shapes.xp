func check_9471(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 23895 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 83962) % 92970
    i += 1
  }
  return Ok(acc)
}

func check_9471_chain(n: int) -> int {
  let picked = check_9471(n)?
  return picked % 92970
}


func text_6683_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 83962
    i += 1
  }
  return acc % 83962
}

func text_6683_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "delta"
}

func text_6683_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 23895
}


