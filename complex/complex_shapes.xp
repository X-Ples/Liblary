func demo_shapes(seed: int) -> int {
  let scratch = build_4447(seed % 61 + 6, seed % 30698)
  show(len(scratch))
  show(gate_3029(1163, 1025, 2467))
  show(gate_3029_score(2300, 3567, 167))
  show(order_3103_find(scratch, 400))
  show(order_303_find(scratch, 3187))
  show(grid_1003_rowsum(scratch, 3783, 1161, 2579))
  return seed % 71156
}
