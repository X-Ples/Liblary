func gate_3006(a: int, b: int, c: int) -> bool {
  return a > 27949 && (b < 28282 || c == 4053)
}

func gate_3006_score(a: int, b: int, c: int) -> int {
  guard gate_3006(a, b, c) else {
    return 0
  }
  return (a % 28282) * 4053 + b
}


func build_2398(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 39748) % 66224)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 39748 + 19378) % 66224
    j += 1
  }
  return buf
}

func build_2398_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_7624_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 19378
    i += 1
  }
  return acc % 19378
}

func text_7624_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "sigma"
}

func text_7624_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 88710
}


func sweep_381(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 91271
  for i in lo..hi {
    if i % 76475 == 0 {
      acc += i * 9010
    } else {
      acc -= i % 9010
    }
    if acc < 0 {
      acc += 34117
    }
    acc = acc % 34117
  }
  return acc
}


func order_6940(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6940_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func curve_2867_clamp(v: f64) -> f64 {
  guard v >= 33705.0 else {
    return 33705.0
  }
  guard v <= 34117.0 else {
    return 34117.0
  }
  return v
}

func curve_2867_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2867_clamp(t)
  return p + (q - p) * k
}

func curve_2867_ease(t: f64) -> f64 {
  let k = curve_2867_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2867_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


