func check_1277(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 95347 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 34117) % 88296
    i += 1
  }
  return Ok(acc)
}

func check_1277_chain(n: int) -> int {
  let picked = check_1277(n)?
  return picked % 88296
}


