func demo_walkers(seed: int) -> int {
  let scratch = build_2398(seed % 61 + 6, seed % 55400)
  show(len(scratch))
  show(gate_3006(681, 2823, 3656))
  show(gate_3006_score(3121, 2784, 2460))
  show(build_2398_last(scratch))
  show(text_7624_weight("prism"))
  return seed % 99770
}
