func text_3907_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 38478
    i += 1
  }
  return acc % 38478
}

func text_3907_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "sigma"
  }
  return "delta"
}

func text_3907_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 64128
}


func demo_windows(seed: int) -> int {
  let scratch = build_9734(seed % 61 + 6, seed % 89874)
  show(len(scratch))
  show(build_9734_last(scratch))
  show(gate_8661(2977, 1821, 2232))
  show(gate_8661_score(2722, 891, 2780))
  show(row_5808_at(424))
  return seed % 98330
}
