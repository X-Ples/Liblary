func build_9734(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 89433) % 26693)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 89433 + 6000) % 26693
    j += 1
  }
  return buf
}

func build_9734_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_8661(a: int, b: int, c: int) -> bool {
  return a > 98330 && (b < 51955 || c == 38478)
}

func gate_8661_score(a: int, b: int, c: int) -> int {
  guard gate_8661(a, b, c) else {
    return 0
  }
  return (a % 51955) * 38478 + b
}


func row_5808() -> [int] {
  return [2535, 1750, 777, 3321, 710, 649, 2541, 3193, 2022, 3455, 1468]
}

func row_5808_at(i: int) -> int {
  let row = row_5808()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5808_sum(limit: int) -> int {
  let row = row_5808()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5808_best() -> int {
  let row = row_5808()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


