func sweep_7494(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 57927
  for i in lo..hi {
    if i % 89955 == 0 {
      acc += i * 57927
    } else {
      acc -= i % 95889
    }
    if acc < 0 {
      acc += 77237
    }
    acc = acc % 77237
  }
  return acc
}


