func demo_helpers(seed: int) -> int {
  let scratch = build_4637(seed % 61 + 6, seed % 35436)
  show(len(scratch))
  show(build_4637_last(scratch))
  show(grid_9760_rowsum(scratch, 2048, 1349, 1347))
  show(grid_7338_rowsum(scratch, 2930, 2506, 2792))
  return seed % 19208
}
