func demo_bursts(seed: int) -> int {
  let scratch = build_8773(seed % 61 + 6, seed % 49337)
  show(len(scratch))
  show(build_8773_last(scratch))
  show(order_2095_find(scratch, 483))
  show(scan_3433(scratch, 2345))
  show(scan_3433_span(scratch, 3898))
  show(grid_9831_rowsum(scratch, 1498, 1282, 404))
  show(order_1764_find(scratch, 2180))
  return seed % 64276
}
