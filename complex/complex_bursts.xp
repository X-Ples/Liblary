func build_8773(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 89406) % 27272)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 89406 + 19900) % 27272
    j += 1
  }
  return buf
}

func build_8773_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_2095(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2095_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func scan_3433(data: [int], seed: int) -> int {
  let acc = seed % 76835
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 65518 + data[i] + i) % 76835
    i += 1
  }
  return acc
}

func scan_3433_span(data: [int], seed: int) -> int {
  let acc = scan_3433(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 65518
}


func grid_9831_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 27272 + c * 92407 + seed) % 92407)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9831_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 92407 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_3740_clamp(v: f64) -> f64 {
  guard v >= 19900.0 else {
    return 19900.0
  }
  guard v <= 76249.0 else {
    return 76249.0
  }
  return v
}

func curve_3740_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3740_clamp(t)
  return p + (q - p) * k
}

func curve_3740_ease(t: f64) -> f64 {
  let k = curve_3740_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3740_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


