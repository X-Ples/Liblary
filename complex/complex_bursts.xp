func check_1604(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 89406 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 13571) % 23317
    i += 1
  }
  return Ok(acc)
}

func check_1604_chain(n: int) -> int {
  let picked = check_1604(n)?
  return picked % 23317
}


