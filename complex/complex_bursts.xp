func row_2824() -> [int] {
  return [2618, 145, 3177, 1345, 3013, 4059, 1044, 1702, 1571, 2279]
}

func row_2824_at(i: int) -> int {
  let row = row_2824()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2824_sum(limit: int) -> int {
  let row = row_2824()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2824_best() -> int {
  let row = row_2824()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_8458(a: int, b: int, c: int) -> bool {
  return a > 56809 && (b < 85631 || c == 11333)
}

func gate_8458_score(a: int, b: int, c: int) -> int {
  guard gate_8458(a, b, c) else {
    return 0
  }
  return (a % 85631) * 11333 + b
}


