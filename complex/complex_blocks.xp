func curve_3653_clamp(v: f64) -> f64 {
  guard v >= 46910.0 else {
    return 46910.0
  }
  guard v <= 53836.0 else {
    return 53836.0
  }
  return v
}

func curve_3653_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3653_clamp(t)
  return p + (q - p) * k
}

func curve_3653_ease(t: f64) -> f64 {
  let k = curve_3653_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3653_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_blocks(seed: int) -> int {
  let scratch = build_8354(seed % 61 + 6, seed % 53836)
  show(len(scratch))
  show(build_8354_last(scratch))
  show(scan_5545(scratch, 2567))
  show(scan_5545_span(scratch, 2727))
  show(sweep_6714(3699, 1708))
  return seed % 46910
}
