func build_8354(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 99631) % 98138)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 99631 + 85301) % 98138
    j += 1
  }
  return buf
}

func build_8354_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_5545(data: [int], seed: int) -> int {
  let acc = seed % 12241
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 64714 + data[i] + i) % 12241
    i += 1
  }
  return acc
}

func scan_5545_span(data: [int], seed: int) -> int {
  let acc = scan_5545(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 64714
}


func sweep_6714(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 20230
  for i in lo..hi {
    if i % 52789 == 0 {
      acc += i * 85301
    } else {
      acc -= i % 29217
    }
    if acc < 0 {
      acc += 66035
    }
    acc = acc % 66035
  }
  return acc
}


