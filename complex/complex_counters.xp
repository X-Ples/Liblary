  while i < n {
    acc = (acc * 26577 + data[i] + i) % 54193
    i += 1
  }
  return acc
}

func scan_4198_span(data: [int], seed: int) -> int {
  let acc = scan_4198(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 26577
}


