func text_5133_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 15525
    i += 1
  }
  return acc % 15525
}

func text_5133_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "alpha"
}

func text_5133_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 54700
}


func build_8505(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 79253) % 69086)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 79253 + 10248) % 69086
    j += 1
  }
  return buf
}

func build_8505_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


