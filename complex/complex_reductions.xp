func sweep_844(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 81348
  for i in lo..hi {
    if i % 35510 == 0 {
      acc += i * 35510
    } else {
      acc -= i % 38323
    }
    if acc < 0 {
      acc += 94264
    }
    acc = acc % 94264
  }
  return acc
}


