func demo_reductions(seed: int) -> int {
  let scratch = build_3221(seed % 61 + 6, seed % 17891)
  show(len(scratch))
  show(scan_2386(scratch, 2390))
  show(scan_2386_span(scratch, 3725))
  show(gate_9658(1706, 2189, 1409))
  show(gate_9658_score(2928, 2526, 2928))
  show(build_3221_last(scratch))
  return seed % 81348
}
