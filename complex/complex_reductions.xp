func scan_2386(data: [int], seed: int) -> int {
  let acc = seed % 77549
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 30957 + data[i] + i) % 77549
    i += 1
  }
  return acc
}

func scan_2386_span(data: [int], seed: int) -> int {
  let acc = scan_2386(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 30957
}


