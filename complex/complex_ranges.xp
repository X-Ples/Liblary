func row_3542() -> [int] {
  return [3611, 1221, 2980, 3383, 1475, 411, 1508, 1851, 3023, 1089, 381, 3028, 966]
}

func row_3542_at(i: int) -> int {
  let row = row_3542()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3542_sum(limit: int) -> int {
  let row = row_3542()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3542_best() -> int {
  let row = row_3542()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


