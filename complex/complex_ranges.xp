func scan_5271(data: [int], seed: int) -> int {
  let acc = seed % 36051
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 57061 + data[i] + i) % 36051
    i += 1
  }
  return acc
}

func scan_5271_span(data: [int], seed: int) -> int {
  let acc = scan_5271(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 57061
}


func check_5870(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 10792 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 10792) % 55915
    i += 1
  }
  return Ok(acc)
}

func check_5870_chain(n: int) -> int {
  let picked = check_5870(n)?
  return picked % 55915
}


func sweep_6905(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 53313
  for i in lo..hi {
    if i % 10792 == 0 {
      acc += i * 71705
    } else {
      acc -= i % 98133
    }
    if acc < 0 {
      acc += 32270
    }
    acc = acc % 32270
  }
  return acc
}


