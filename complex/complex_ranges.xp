func demo_ranges(seed: int) -> int {
  let scratch = build_2000(seed % 61 + 6, seed % 95962)
  show(len(scratch))
  show(build_2000_last(scratch))
  show(gate_338(792, 2008, 955))
  show(gate_338_score(665, 3940, 1883))
  show(grid_9107_rowsum(scratch, 1949, 862, 1649))
  show(grid_406_rowsum(scratch, 187, 215, 2661))
  return seed % 63510
}
