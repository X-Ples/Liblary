func curve_4650_clamp(v: f64) -> f64 {
  guard v >= 70183.0 else {
    return 70183.0
  }
  guard v <= 76424.0 else {
    return 76424.0
  }
  return v
}

func curve_4650_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4650_clamp(t)
  return p + (q - p) * k
}

func curve_4650_ease(t: f64) -> f64 {
  let k = curve_4650_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4650_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_2000(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 29779) % 32270)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 29779 + 53313) % 32270
    j += 1
  }
  return buf
}

func build_2000_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_338(a: int, b: int, c: int) -> bool {
  return a > 57061 && (b < 95962 || c == 39557)
}

func gate_338_score(a: int, b: int, c: int) -> int {
  guard gate_338(a, b, c) else {
    return 0
  }
  return (a % 95962) * 39557 + b
}


