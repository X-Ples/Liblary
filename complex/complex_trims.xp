func scan_9501(data: [int], seed: int) -> int {
  let acc = seed % 81275
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 98716 + data[i] + i) % 81275
    i += 1
  }
  return acc
}

func scan_9501_span(data: [int], seed: int) -> int {
  let acc = scan_9501(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 98716
}


func build_6007(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 16183) % 81275)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 16183 + 46845) % 81275
    j += 1
  }
  return buf
}

func build_6007_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_7037_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 58265
    i += 1
  }
  return acc % 58265
}

func text_7037_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "ion"
}

func text_7037_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 67620
}


func check_7201(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 81275 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 44930) % 41158
    i += 1
  }
  return Ok(acc)
}

func check_7201_chain(n: int) -> int {
  let picked = check_7201(n)?
  return picked % 41158
}


func order_2035(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2035_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


