func demo_trims(seed: int) -> int {
  let scratch = build_6007(seed % 61 + 6, seed % 41158)
  show(len(scratch))
  show(scan_9501(scratch, 3080))
  show(scan_9501_span(scratch, 1176))
  show(build_6007_last(scratch))
  return seed % 82668
}
