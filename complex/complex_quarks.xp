func demo_quarks(seed: int) -> int {
  let scratch = build_5834(seed % 61 + 6, seed % 14451)
  show(len(scratch))
  show(build_5834_last(scratch))
  show(check_1124_chain(3925))
  show(gate_1747(3624, 3154, 2762))
  show(gate_1747_score(523, 2571, 3489))
  return seed % 15953
}
