func build_5834(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 68791) % 54683)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 68791 + 15953) % 54683
    j += 1
  }
  return buf
}

func build_5834_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_1124(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 53180 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 15953) % 62519
    i += 1
  }
  return Ok(acc)
}

func check_1124_chain(n: int) -> int {
  let picked = check_1124(n)?
  return picked % 62519
}


func gate_1747(a: int, b: int, c: int) -> bool {
  return a > 71972 && (b < 30142 || c == 51849)
}

func gate_1747_score(a: int, b: int, c: int) -> int {
  guard gate_1747(a, b, c) else {
    return 0
  }
  return (a % 30142) * 51849 + b
}


