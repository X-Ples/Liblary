func grid_2479_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 87230 + c * 87230 + seed) % 87230)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2479_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 87230 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_7548_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 71972
    i += 1
  }
  return acc % 71972
}

func text_7548_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "nova"
}

func text_7548_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 85937
}


func grid_3401_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 59438 + c * 30142 + seed) % 30142)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3401_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 30142 == want {
      total += acc
    }
    r += 1
  }
  return total
}


