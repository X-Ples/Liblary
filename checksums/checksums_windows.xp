func text_6108_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 25018
    i += 1
  }
  return acc % 25018
}

func text_6108_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "jetty"
}

func text_6108_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 62606
}


