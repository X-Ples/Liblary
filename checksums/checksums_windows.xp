      best = row[i]
    }
  }
  return best
}


func build_1058(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 25018) % 13595)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 25018 + 25018) % 13595
    j += 1
  }
  return buf
}

func build_1058_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_1844(data: [int], seed: int) -> int {
  let acc = seed % 43851
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 81812 + data[i] + i) % 43851
    i += 1
  }
  return acc
}

func scan_1844_span(data: [int], seed: int) -> int {
  let acc = scan_1844(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 81812
}


func order_6384(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6384_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


