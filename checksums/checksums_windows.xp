func demo_windows(seed: int) -> int {
  let scratch = build_1058(seed % 61 + 6, seed % 81906)
  show(len(scratch))
  show(row_9230_at(1556))
  show(row_9230_sum(2957))
  show(row_9230_best())
  show(build_1058_last(scratch))
  show(scan_1844(scratch, 1229))
