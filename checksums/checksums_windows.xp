func check_967(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 30262 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 85401) % 13595
    i += 1
  }
  return Ok(acc)
}

func check_967_chain(n: int) -> int {
