func build_5241(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 20044) % 18950)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 20044 + 60969) % 18950
    j += 1
  }
  return buf
}

func build_5241_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_6339(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 22013
  for i in lo..hi {
    if i % 67116 == 0 {
      acc += i * 22013
    } else {
      acc -= i % 84811
    }
    if acc < 0 {
      acc += 29115
    }
    acc = acc % 29115
  }
  return acc
}


func check_6292(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 69836 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 73455) % 29115
    i += 1
  }
  return Ok(acc)
}

func check_6292_chain(n: int) -> int {
  let picked = check_6292(n)?
  return picked % 29115
}


