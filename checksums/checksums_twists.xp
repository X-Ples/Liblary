func demo_twists(seed: int) -> int {
  let scratch = build_5241(seed % 61 + 6, seed % 29915)
  show(len(scratch))
  show(build_5241_last(scratch))
  show(sweep_6339(1642, 1307))
  show(check_6292_chain(3392))
  show(gate_5843(1208, 3534, 204))
  show(gate_5843_score(1013, 2372, 955))
  show(sweep_2692(3323, 1314))
  return seed % 19075
}
