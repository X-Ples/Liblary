func demo_quarks(seed: int) -> int {
  let scratch = build_5356(seed % 61 + 6, seed % 6873)
  show(len(scratch))
  show(build_5356_last(scratch))
  show(check_7216_chain(2218))
  show(sweep_4776(932, 2690))
  show(sweep_7392(1632, 367))
  show(build_2641_last(scratch))
  return seed % 37211
}
