func scan_7749(data: [int], seed: int) -> int {
  let acc = seed % 11496
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 23760 + data[i] + i) % 11496
    i += 1
  }
  return acc
}

func scan_7749_span(data: [int], seed: int) -> int {
  let acc = scan_7749(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 23760
}


