func curve_9190_clamp(v: f64) -> f64 {
  guard v >= 93602.0 else {
    return 93602.0
  }
  guard v <= 95642.0 else {
    return 95642.0
  }
  return v
}

func curve_9190_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9190_clamp(t)
  return p + (q - p) * k
}

func curve_9190_ease(t: f64) -> f64 {
  let k = curve_9190_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9190_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_5356(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 95642) % 48073)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 95642 + 44022) % 48073
    j += 1
  }
  return buf
}

func build_5356_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_7216(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 25067 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 37211) % 25067
    i += 1
  }
  return Ok(acc)
}

func check_7216_chain(n: int) -> int {
  let picked = check_7216(n)?
  return picked % 25067
}


func sweep_4776(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 9153
  for i in lo..hi {
    if i % 37211 == 0 {
      acc += i * 14939
    } else {
      acc -= i % 37211
    }
    if acc < 0 {
      acc += 7612
    }
    acc = acc % 7612
  }
  return acc
}


