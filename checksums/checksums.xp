func sweep_9704(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 70462
  for i in lo..hi {
    if i % 64330 == 0 {
      acc += i * 64017
    } else {
      acc -= i % 52333
    }
    if acc < 0 {
      acc += 30445
    }
    acc = acc % 30445
  }
  return acc
}


