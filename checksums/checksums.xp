func check_5936(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 30445 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 86636) % 7272
    i += 1
  }
  return Ok(acc)
}

func check_5936_chain(n: int) -> int {
  let picked = check_5936(n)?
  return picked % 7272
}


func scan_5107(data: [int], seed: int) -> int {
  let acc = seed % 86751
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 30445 + data[i] + i) % 86751
    i += 1
  }
  return acc
}

func scan_5107_span(data: [int], seed: int) -> int {
  let acc = scan_5107(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 30445
}


func text_7586_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 48198
    i += 1
  }
  return acc % 48198
}

func text_7586_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "jetty"
}

func text_7586_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 76072
}


func build_6194(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 76072) % 23462)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 76072 + 75074) % 23462
    j += 1
  }
  return buf
}

func build_6194_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_6001() -> [int] {
  return [776, 2522, 3790, 1905, 2201, 2815, 3427, 2867, 2588, 3535, 622, 141, 2164, 36, 1878, 114, 174, 868, 516]
}

func row_6001_at(i: int) -> int {
  let row = row_6001()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6001_sum(limit: int) -> int {
  let row = row_6001()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6001_best() -> int {
  let row = row_6001()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_1178(a: int, b: int, c: int) -> bool {
  return a > 72055 && (b < 48198 || c == 27176)
}

func gate_1178_score(a: int, b: int, c: int) -> int {
  guard gate_1178(a, b, c) else {
    return 0
  }
  return (a % 48198) * 27176 + b
}


func order_5711(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5711_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


