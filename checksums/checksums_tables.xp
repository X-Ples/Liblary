func text_7968_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 28257
    i += 1
  }
  return acc % 28257
}

func text_7968_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "lumen"
}

func text_7968_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 565
}


