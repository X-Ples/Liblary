func gate_6017(a: int, b: int, c: int) -> bool {
  return a > 55832 && (b < 34636 || c == 2889)
}

func gate_6017_score(a: int, b: int, c: int) -> int {
  guard gate_6017(a, b, c) else {
    return 0
  }
  return (a % 34636) * 2889 + b
}


func build_6445(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 79695) % 13459)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 79695 + 36963) % 13459
    j += 1
  }
  return buf
}

func build_6445_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_8745(data: [int], seed: int) -> int {
  let acc = seed % 90709
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 87235 + data[i] + i) % 90709
    i += 1
  }
  return acc
}

func scan_8745_span(data: [int], seed: int) -> int {
  let acc = scan_8745(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 87235
}


func order_1808(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1808_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_2595(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 90709
  for i in lo..hi {
    if i % 22120 == 0 {
      acc += i * 90709
    } else {
      acc -= i % 28530
    }
    if acc < 0 {
      acc += 97704
    }
    acc = acc % 97704
  }
  return acc
}


func check_688(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 4594 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 12613) % 87235
    i += 1
  }
  return Ok(acc)
}

func check_688_chain(n: int) -> int {
  let picked = check_688(n)?
  return picked % 87235
}


