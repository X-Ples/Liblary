func demo_trims(seed: int) -> int {
  let scratch = build_6445(seed % 61 + 6, seed % 97704)
  show(len(scratch))
  show(gate_6017(3138, 1652, 326))
  show(gate_6017_score(3751, 655, 3788))
  show(build_6445_last(scratch))
  show(scan_8745(scratch, 333))
  return seed % 86214
}
