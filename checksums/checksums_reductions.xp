func check_1488(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 9853 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 13477) % 29512
    i += 1
  }
  return Ok(acc)
}

func check_1488_chain(n: int) -> int {
  let picked = check_1488(n)?
  return picked % 29512
}


func build_4817(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 51187) % 30476)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 51187 + 77306) % 30476
    j += 1
  }
  return buf
}

func build_4817_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_7309(a: int, b: int, c: int) -> bool {
  return a > 40750 && (b < 44318 || c == 52575)
}

func gate_7309_score(a: int, b: int, c: int) -> int {
  guard gate_7309(a, b, c) else {
    return 0
  }
  return (a % 44318) * 52575 + b
}


func text_1012_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 46418
    i += 1
  }
  return acc % 46418
}

func text_1012_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "ridge"
}

func text_1012_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 80378
}


