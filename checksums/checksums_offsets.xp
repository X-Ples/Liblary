func build_7988(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 8506) % 3944)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 8506 + 35332) % 3944
    j += 1
  }
  return buf
}

func build_7988_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_6121(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 79753
  for i in lo..hi {
    if i % 81177 == 0 {
      acc += i * 47212
    } else {
      acc -= i % 20222
    }
    if acc < 0 {
      acc += 4656
    }
    acc = acc % 4656
  }
  return acc
}


func grid_6508_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 8506 + c * 5065 + seed) % 5065)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6508_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 5065 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_9388_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 26654
    i += 1
  }
  return acc % 26654
}

func text_9388_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "jetty"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "mesa"
}

func text_9388_has(tag: str) -> bool {
  return str_contains(tag, "jetty") || len(tag) > 33503
}


func row_5906() -> [int] {
  return [3907, 1458, 3217, 2388, 2210, 3956, 1766, 422, 3242, 4055, 2806, 2798, 1263, 841, 3180, 520, 3037]
}

func row_5906_at(i: int) -> int {
  let row = row_5906()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5906_sum(limit: int) -> int {
  let row = row_5906()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5906_best() -> int {
  let row = row_5906()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


