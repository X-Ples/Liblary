  return p + (q - p) * k
}

func curve_8986_ease(t: f64) -> f64 {
  let k = curve_8986_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8986_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_offsets(seed: int) -> int {
  let scratch = build_7988(seed % 61 + 6, seed % 26654)
  show(len(scratch))
  show(build_7988_last(scratch))
  show(sweep_6121(2802, 1741))
  show(grid_6508_rowsum(scratch, 1075, 3990, 822))
  return seed % 44626
}
