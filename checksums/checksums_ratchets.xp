const K0 = 67798
const K1 = 85059
const K2 = 85059
const K3 = 85577
const K4 = 10189
const K5 = 60459

func build_3202(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 53845) % 53845)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 53845 + 14465) % 53845
    j += 1
  }
  return buf
}

func build_3202_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_1730_clamp(v: f64) -> f64 {
  guard v >= 2628.0 else {
    return 2628.0
  }
  guard v <= 36751.0 else {
    return 36751.0
  }
  return v
}

func curve_1730_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1730_clamp(t)
  return p + (q - p) * k
}

func curve_1730_ease(t: f64) -> f64 {
  let k = curve_1730_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1730_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_9485() -> [int] {
  return [2259, 2284, 3852, 1444, 3861, 3200, 805, 405, 2371, 1731, 2268, 3570]
}

func row_9485_at(i: int) -> int {
  let row = row_9485()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9485_sum(limit: int) -> int {
  let row = row_9485()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9485_best() -> int {
  let row = row_9485()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_892(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 85059 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 36751) % 10189
    i += 1
  }
  return Ok(acc)
}

func check_892_chain(n: int) -> int {
  let picked = check_892(n)?
  return picked % 10189
}


func scan_8026(data: [int], seed: int) -> int {
  let acc = seed % 91661
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 2628 + data[i] + i) % 91661
    i += 1
  }
  return acc
}

func scan_8026_span(data: [int], seed: int) -> int {
  let acc = scan_8026(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 2628
}


func grid_8801_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 2628 + c * 10189 + seed) % 10189)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8801_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 10189 == want {
      total += acc
    }
    r += 1
  }
  return total
}


