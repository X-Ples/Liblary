func demo_ratchets(seed: int) -> int {
  let scratch = build_3202(seed % 61 + 6, seed % 60459)
  show(len(scratch))
  show(build_3202_last(scratch))
  show(row_9485_at(1483))
  show(row_9485_sum(2989))
  show(row_9485_best())
  show(check_892_chain(1982))
  return seed % 4097
}
