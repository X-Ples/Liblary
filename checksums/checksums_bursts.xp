func curve_408_clamp(v: f64) -> f64 {
  guard v >= 61429.0 else {
    return 61429.0
  }
  guard v <= 90117.0 else {
    return 90117.0
  }
  return v
}

func curve_408_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_408_clamp(t)
  return p + (q - p) * k
}

func curve_408_ease(t: f64) -> f64 {
  let k = curve_408_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_408_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_5240(a: int, b: int, c: int) -> bool {
  return a > 91907 && (b < 69091 || c == 91907)
}

func gate_5240_score(a: int, b: int, c: int) -> int {
  guard gate_5240(a, b, c) else {
    return 0
  }
  return (a % 69091) * 91907 + b
}


func build_4430(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 97334) % 95014)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 97334 + 58358) % 95014
    j += 1
  }
  return buf
}

func build_4430_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


