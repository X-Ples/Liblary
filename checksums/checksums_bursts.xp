}


func scan_4686(data: [int], seed: int) -> int {
  let acc = seed % 69091
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 11378 + data[i] + i) % 69091
    i += 1
  }
  return acc
}

func scan_4686_span(data: [int], seed: int) -> int {
  let acc = scan_4686(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 11378
}


