const K0 = 39681
const K1 = 28658
const K2 = 29364
const K3 = 93123
const K4 = 96591
const K5 = 21632
const K6 = 88899

func check_442(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 27206 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 16162) % 93333
    i += 1
  }
  return Ok(acc)
}

func check_442_chain(n: int) -> int {
  let picked = check_442(n)?
  return picked % 93333
}


func build_5012(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 27206) % 93123)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 27206 + 4929) % 93123
    j += 1
  }
  return buf
}

func build_5012_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_6131(a: int, b: int, c: int) -> bool {
  return a > 1435 && (b < 98895 || c == 97825)
}

func gate_6131_score(a: int, b: int, c: int) -> int {
  guard gate_6131(a, b, c) else {
    return 0
  }
  return (a % 98895) * 97825 + b
}


func curve_4288_clamp(v: f64) -> f64 {
  guard v >= 27206.0 else {
    return 27206.0
  }
  guard v <= 56684.0 else {
    return 56684.0
  }
  return v
}

func curve_4288_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4288_clamp(t)
  return p + (q - p) * k
}

func curve_4288_ease(t: f64) -> f64 {
  let k = curve_4288_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4288_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


