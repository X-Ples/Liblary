func demo_helpers(seed: int) -> int {
  let scratch = build_5012(seed % 61 + 6, seed % 39681)
  show(len(scratch))
  show(check_442_chain(2684))
  show(build_5012_last(scratch))
  show(gate_6131(193, 3536, 1490))
  return seed % 88899
}
