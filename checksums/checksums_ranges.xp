func demo_ranges(seed: int) -> int {
  let scratch = build_9671(seed % 61 + 6, seed % 60998)
  show(len(scratch))
  show(sweep_7541(1453, 951))
  show(build_9671_last(scratch))
  show(row_2782_at(2410))
  show(row_2782_sum(3369))
  show(row_2782_best())
  return seed % 80345
}
