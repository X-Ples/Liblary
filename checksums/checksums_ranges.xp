func sweep_7541(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 77652
  for i in lo..hi {
    if i % 77732 == 0 {
      acc += i * 47921
    } else {
      acc -= i % 63282
    }
    if acc < 0 {
      acc += 65194
    }
    acc = acc % 65194
  }
  return acc
}


func build_9671(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 63282) % 2606)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 63282 + 82777) % 2606
    j += 1
  }
  return buf
}

func build_9671_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_8735_clamp(v: f64) -> f64 {
  guard v >= 31233.0 else {
    return 31233.0
  }
  guard v <= 35805.0 else {
    return 35805.0
  }
  return v
}

func curve_8735_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8735_clamp(t)
  return p + (q - p) * k
}

func curve_8735_ease(t: f64) -> f64 {
  let k = curve_8735_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8735_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_2782() -> [int] {
  return [438, 265, 1925, 3658, 1946, 483, 1865, 3356, 732, 1634, 774, 2129, 3575, 3698, 111, 2515, 2349, 893, 1161]
}

func row_2782_at(i: int) -> int {
  let row = row_2782()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2782_sum(limit: int) -> int {
  let row = row_2782()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2782_best() -> int {
  let row = row_2782()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_7329(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7329_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


