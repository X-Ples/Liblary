func scan_7347(data: [int], seed: int) -> int {
  let acc = seed % 3766
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 37219 + data[i] + i) % 3766
    i += 1
  }
  return acc
}

func scan_7347_span(data: [int], seed: int) -> int {
  let acc = scan_7347(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 37219
}


