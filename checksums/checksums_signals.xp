func text_2661_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 9195
    i += 1
  }
  return acc % 9195
}

func text_2661_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "ridge"
}

func text_2661_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 37219
}


func build_8088(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 47442) % 11098)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 47442 + 55589) % 11098
    j += 1
  }
  return buf
}

func build_8088_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_851_clamp(v: f64) -> f64 {
  guard v >= 39648.0 else {
    return 39648.0
  }
  guard v <= 43707.0 else {
    return 43707.0
  }
  return v
}

func curve_851_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_851_clamp(t)
  return p + (q - p) * k
}

func curve_851_ease(t: f64) -> f64 {
  let k = curve_851_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_851_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_4559_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 2863 + c * 9772 + seed) % 9772)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4559_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 9772 == want {
      total += acc
    }
    r += 1
  }
  return total
}


