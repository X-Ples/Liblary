func demo_signals(seed: int) -> int {
  let scratch = build_8088(seed % 61 + 6, seed % 77273)
  show(len(scratch))
  show(text_2661_weight("bravo"))
  show(text_2661_label(2003))
  show(text_2661_has("gamma"))
  show(build_8088_last(scratch))
  return seed % 94133
}
