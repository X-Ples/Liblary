func build_7546(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 22586) % 51924)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 22586 + 34281) % 51924
    j += 1
  }
  return buf
}

func build_7546_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_3196(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 92469 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 92469) % 91377
    i += 1
  }
  return Ok(acc)
}

func check_3196_chain(n: int) -> int {
  let picked = check_3196(n)?
  return picked % 91377
}


func curve_8812_clamp(v: f64) -> f64 {
  guard v >= 82422.0 else {
    return 82422.0
  }
  guard v <= 92469.0 else {
    return 92469.0
  }
  return v
}

func curve_8812_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8812_clamp(t)
  return p + (q - p) * k
}

func curve_8812_ease(t: f64) -> f64 {
  let k = curve_8812_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8812_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_6274_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 69009
    i += 1
  }
  return acc % 69009
}

func text_6274_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ridge"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "delta"
}

func text_6274_has(tag: str) -> bool {
  return str_contains(tag, "ridge") || len(tag) > 87237
}


