func demo_blends(seed: int) -> int {
  let scratch = build_7546(seed % 61 + 6, seed % 38840)
  show(len(scratch))
  show(build_7546_last(scratch))
  show(check_3196_chain(158))
  show(text_6274_weight("sigma"))
  show(text_6274_label(3661))
  show(text_6274_has("lumen"))
  return seed % 23103
}
