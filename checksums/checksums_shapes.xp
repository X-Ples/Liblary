func sweep_6997(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 85259
  for i in lo..hi {
    if i % 85259 == 0 {
      acc += i * 36527
    } else {
      acc -= i % 12990
    }
    if acc < 0 {
      acc += 55467
    }
    acc = acc % 55467
  }
  return acc
}


