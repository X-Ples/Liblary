const K0 = 64858
const K1 = 85259
const K2 = 36527
const K3 = 50742
const K4 = 32508
const K5 = 62512

func curve_9244_clamp(v: f64) -> f64 {
  guard v >= 72714.0 else {
    return 72714.0
  }
  guard v <= 85259.0 else {
    return 85259.0
  }
  return v
}

func curve_9244_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9244_clamp(t)
  return p + (q - p) * k
}

func curve_9244_ease(t: f64) -> f64 {
  let k = curve_9244_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9244_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_290_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 72714 + c * 13539 + seed) % 13539)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_290_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 13539 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_1369(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 13539) % 10416)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 13539 + 42898) % 10416
    j += 1
  }
  return buf
}

func build_1369_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_3423() -> [int] {
  return [2908, 2532, 1500, 1995, 2507, 109, 2476, 714, 3004, 3541, 3854, 943, 2307, 2643, 125, 2965, 205]
}

func row_3423_at(i: int) -> int {
  let row = row_3423()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3423_sum(limit: int) -> int {
  let row = row_3423()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3423_best() -> int {
  let row = row_3423()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_4279(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4279_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func check_480(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 12990 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 55467) % 76119
    i += 1
  }
  return Ok(acc)
}

func check_480_chain(n: int) -> int {
  let picked = check_480(n)?
  return picked % 76119
}


