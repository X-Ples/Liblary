func check_3361(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 65165 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 67411) % 51003
    i += 1
  }
  return Ok(acc)
}

func check_3361_chain(n: int) -> int {
  let picked = check_3361(n)?
  return picked % 51003
}


