func row_6214() -> [int] {
  return [2744, 952, 1748, 3990, 1118, 1630, 499, 3110, 2745, 811, 297, 2718, 3951]
}

func row_6214_at(i: int) -> int {
  let row = row_6214()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6214_sum(limit: int) -> int {
  let row = row_6214()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6214_best() -> int {
  let row = row_6214()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


