func grid_6874_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 29827 + c * 30848 + seed) % 30848)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6874_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 30848 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_8134(data: [int], seed: int) -> int {
  let acc = seed % 49120
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 89159 + data[i] + i) % 49120
    i += 1
  }
  return acc
}

func scan_8134_span(data: [int], seed: int) -> int {
  let acc = scan_8134(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 89159
}


func sweep_5671(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 17618
  for i in lo..hi {
    if i % 93553 == 0 {
      acc += i * 99040
    } else {
      acc -= i % 17618
    }
    if acc < 0 {
      acc += 49120
    }
    acc = acc % 49120
  }
  return acc
}


