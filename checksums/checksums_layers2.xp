func build_5470(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 68631) % 86457)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 68631 + 31243) % 86457
    j += 1
  }
  return buf
}

func build_5470_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_5702(data: [int], seed: int) -> int {
  let acc = seed % 13719
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 83984 + data[i] + i) % 13719
    i += 1
  }
  return acc
}

func scan_5702_span(data: [int], seed: int) -> int {
  let acc = scan_5702(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 83984
}


func check_4399(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 53657 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 86457) % 31546
    i += 1
  }
