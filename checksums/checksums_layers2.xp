func row_3035() -> [int] {
  return [2807, 2594, 1977, 1518, 2377, 2045, 3038, 1186, 2541, 1269, 1118, 3594]
}

func row_3035_at(i: int) -> int {
  let row = row_3035()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3035_sum(limit: int) -> int {
  let row = row_3035()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3035_best() -> int {
  let row = row_3035()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


