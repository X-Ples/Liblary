func check_2870(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 86040 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 86040) % 67285
    i += 1
  }
  return Ok(acc)
}

func check_2870_chain(n: int) -> int {
  let picked = check_2870(n)?
  return picked % 67285
}


func text_9287_weight(tag: str) -> int {
