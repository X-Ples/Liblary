func build_9614(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 21991) % 49717)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 21991 + 35782) % 49717
    j += 1
  }
  return buf
}

func build_9614_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_3121_clamp(v: f64) -> f64 {
  guard v >= 22021.0 else {
    return 22021.0
  }
  guard v <= 49717.0 else {
    return 49717.0
  }
  return v
}

func curve_3121_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3121_clamp(t)
  return p + (q - p) * k
}

func curve_3121_ease(t: f64) -> f64 {
  let k = curve_3121_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3121_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_1622() -> [int] {
  return [2702, 1157, 2559, 2569, 174, 77, 1297, 1342, 3694, 1706, 2281, 104, 4091, 339, 3262, 3661, 2159, 2427, 2843, 1049, 3275]
}

func row_1622_at(i: int) -> int {
  let row = row_1622()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1622_sum(limit: int) -> int {
  let row = row_1622()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1622_best() -> int {
  let row = row_1622()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


