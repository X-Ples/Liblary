func sweep_4174(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 62730
  for i in lo..hi {
    if i % 91227 == 0 {
      acc += i * 91227
    } else {
      acc -= i % 91227
    }
    if acc < 0 {
      acc += 35782
    }
    acc = acc % 35782
  }
  return acc
}


