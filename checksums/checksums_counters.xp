func demo_counters(seed: int) -> int {
  let scratch = build_9614(seed % 61 + 6, seed % 21671)
  show(len(scratch))
  show(build_9614_last(scratch))
  show(row_1622_at(1935))
  show(row_1622_sum(182))
  show(row_1622_best())
