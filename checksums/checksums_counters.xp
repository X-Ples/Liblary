  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 91227
    i += 1
  }
  return acc % 91227
}

func text_9287_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "gamma"
}

func text_9287_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 70874
}


func grid_7995_fill(rows: int, cols: int, seed: int) -> [int] {
