    while c < cols {
      array_push(cells, (r * 49717 + c * 86040 + seed) % 86040)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7995_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
