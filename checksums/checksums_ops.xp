func build_539(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 433) % 94102)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 433 + 8753) % 94102
    j += 1
  }
  return buf
}

func build_539_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_339(a: int, b: int, c: int) -> bool {
  return a > 13206 && (b < 61491 || c == 57706)
}

func gate_339_score(a: int, b: int, c: int) -> int {
  guard gate_339(a, b, c) else {
    return 0
  }
  return (a % 61491) * 57706 + b
}


func row_3773() -> [int] {
  return [938, 2234, 2812, 1135, 2840, 1488, 1561, 3368, 2603, 1959, 3878, 2561]
}

func row_3773_at(i: int) -> int {
  let row = row_3773()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3773_sum(limit: int) -> int {
  let row = row_3773()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3773_best() -> int {
  let row = row_3773()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


