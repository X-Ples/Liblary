func scan_8242(data: [int], seed: int) -> int {
  let acc = seed % 75443
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 58069 + data[i] + i) % 75443
    i += 1
  }
  return acc
}

func scan_8242_span(data: [int], seed: int) -> int {
  let acc = scan_8242(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 58069
}


