func text_9812_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 13206
    i += 1
  }
  return acc % 13206
}

func text_9812_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "ember"
  }
  return "flint"
}

func text_9812_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 13206
}


func demo_ops(seed: int) -> int {
  let scratch = build_539(seed % 61 + 6, seed % 46920)
  show(len(scratch))
  show(build_539_last(scratch))
  show(gate_339(3768, 1508, 3635))
  show(gate_339_score(2177, 811, 971))
  show(row_3773_at(1323))
  show(row_3773_sum(50))
  show(row_3773_best())
  return seed % 16592
}
