func row_3307() -> [int] {
  return [3807, 3640, 2532, 379, 4062, 1139, 2398, 3873, 431, 702, 3780, 3040, 153, 1294, 316, 810, 3563, 1886, 3424]
}

func row_3307_at(i: int) -> int {
  let row = row_3307()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3307_sum(limit: int) -> int {
  let row = row_3307()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3307_best() -> int {
  let row = row_3307()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func demo_pickers(seed: int) -> int {
