func build_8106(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 76783) % 42934)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 76783 + 35276) % 42934
    j += 1
  }
  return buf
}

func build_8106_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_9122(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 86107 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 42934) % 76783
    i += 1
  }
  return Ok(acc)
}

func check_9122_chain(n: int) -> int {
  let picked = check_9122(n)?
  return picked % 76783
}


func sweep_9658(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 54088
  for i in lo..hi {
    if i % 30819 == 0 {
      acc += i * 77781
    } else {
      acc -= i % 38413
    }
    if acc < 0 {
      acc += 75679
    }
    acc = acc % 75679
  }
  return acc
}


func curve_2218_clamp(v: f64) -> f64 {
  guard v >= 6237.0 else {
    return 6237.0
  }
  guard v <= 39889.0 else {
    return 39889.0
  }
  return v
}

func curve_2218_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2218_clamp(t)
  return p + (q - p) * k
}

func curve_2218_ease(t: f64) -> f64 {
  let k = curve_2218_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2218_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


