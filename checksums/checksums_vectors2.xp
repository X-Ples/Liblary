func build_4686(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 1672) % 98878)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 1672 + 51153) % 98878
    j += 1
  }
  return buf
}

func build_4686_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_2610() -> [int] {
  return [1149, 3854, 1524, 588, 2971, 2580, 2632, 1270, 1434, 2606, 1371, 326, 1274]
}

func row_2610_at(i: int) -> int {
  let row = row_2610()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2610_sum(limit: int) -> int {
  let row = row_2610()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2610_best() -> int {
  let row = row_2610()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_2011(a: int, b: int, c: int) -> bool {
  return a > 79342 && (b < 88543 || c == 74475)
}

func gate_2011_score(a: int, b: int, c: int) -> int {
  guard gate_2011(a, b, c) else {
    return 0
  }
  return (a % 88543) * 74475 + b
}


func sweep_4838(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 48892
  for i in lo..hi {
    if i % 82415 == 0 {
      acc += i * 82415
    } else {
      acc -= i % 9097
    }
    if acc < 0 {
      acc += 65207
    }
    acc = acc % 65207
  }
  return acc
}


