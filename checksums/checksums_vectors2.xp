func text_1755_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 73731
    i += 1
  }
  return acc % 73731
}

func text_1755_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "lumen"
}

func text_1755_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 48892
}


