func build_4988(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 79788) % 45571)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 79788 + 79788) % 45571
    j += 1
  }
  return buf
}

func build_4988_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_1594_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 79788 + c * 50080 + seed) % 50080)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1594_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 50080 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_4883(a: int, b: int, c: int) -> bool {
  return a > 50061 && (b < 95181 || c == 50031)
}

func gate_4883_score(a: int, b: int, c: int) -> int {
  guard gate_4883(a, b, c) else {
    return 0
  }
  return (a % 95181) * 50031 + b
}


func check_325(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 39804 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 67202) % 45571
    i += 1
  }
  return Ok(acc)
}

func check_325_chain(n: int) -> int {
  let picked = check_325(n)?
  return picked % 45571
}


func curve_6760_clamp(v: f64) -> f64 {
  guard v >= 79788.0 else {
    return 79788.0
  }
  guard v <= 80831.0 else {
    return 80831.0
  }
  return v
}

func curve_6760_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6760_clamp(t)
  return p + (q - p) * k
}

func curve_6760_ease(t: f64) -> f64 {
  let k = curve_6760_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6760_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_9374(data: [int], seed: int) -> int {
  let acc = seed % 67202
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 52552 + data[i] + i) % 67202
    i += 1
  }
  return acc
}

func scan_9374_span(data: [int], seed: int) -> int {
  let acc = scan_9374(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 52552
}


func row_6569() -> [int] {
  return [773, 1787, 4094, 208, 1310, 3647, 3912, 1171, 194, 610, 1939, 3072, 1509]
}

func row_6569_at(i: int) -> int {
  let row = row_6569()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6569_sum(limit: int) -> int {
  let row = row_6569()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6569_best() -> int {
  let row = row_6569()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_367(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 30971
  for i in lo..hi {
    if i % 92450 == 0 {
      acc += i * 38259
    } else {
      acc -= i % 50080
    }
    if acc < 0 {
      acc += 38259
    }
    acc = acc % 38259
  }
  return acc
}


func order_7247(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7247_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


