func demo_walkers(seed: int) -> int {
  let scratch = build_4988(seed % 61 + 6, seed % 67202)
  show(len(scratch))
  show(build_4988_last(scratch))
  show(grid_1594_rowsum(scratch, 2224, 1174, 1029))
  show(gate_4883(3742, 623, 350))
  show(gate_4883_score(1197, 176, 1391))
  return seed % 95181
}
