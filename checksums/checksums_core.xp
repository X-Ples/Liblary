func sweep_7142(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 53717
  for i in lo..hi {
    if i % 46477 == 0 {
      acc += i * 17618
    } else {
      acc -= i % 17618
    }
    if acc < 0 {
      acc += 88440
    }
    acc = acc % 88440
  }
  return acc
}


