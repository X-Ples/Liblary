func demo_core(seed: int) -> int {
  let scratch = build_3261(seed % 61 + 6, seed % 88440)
  show(len(scratch))
  show(build_3261_last(scratch))
  show(check_9715_chain(2354))
  show(check_3023_chain(1984))
  show(grid_6765_rowsum(scratch, 3168, 3394, 2645))
  return seed % 2607
}
