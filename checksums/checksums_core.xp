func text_2157_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "flint"
}

func text_2157_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 2607
}


