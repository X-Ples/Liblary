func check_8052(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 75177 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 12457) % 30983
    i += 1
  }
  return Ok(acc)
}

func check_8052_chain(n: int) -> int {
  let picked = check_8052(n)?
  return picked % 30983
}


