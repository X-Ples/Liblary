func build_5396(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 52002) % 40272)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 52002 + 75177) % 40272
    j += 1
  }
  return buf
}

func build_5396_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_7384(data: [int], seed: int) -> int {
  let acc = seed % 12457
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 90548 + data[i] + i) % 12457
    i += 1
  }
  return acc
}

func scan_7384_span(data: [int], seed: int) -> int {
  let acc = scan_7384(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 90548
}


func row_6503() -> [int] {
  return [3903, 4006, 1994, 2247, 3749, 2133, 2928, 798, 979, 1221, 1836, 689, 356, 472, 153, 2777, 1829, 698, 3526, 3385]
}

func row_6503_at(i: int) -> int {
  let row = row_6503()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6503_sum(limit: int) -> int {
  let row = row_6503()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6503_best() -> int {
  let row = row_6503()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


