func grid_3749_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 93696 + c * 12457 + seed) % 12457)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3749_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 12457 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_2573(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 66652
  for i in lo..hi {
    if i % 22242 == 0 {
      acc += i * 57996
    } else {
      acc -= i % 40946
    }
    if acc < 0 {
      acc += 31989
    }
    acc = acc % 31989
  }
  return acc
}


