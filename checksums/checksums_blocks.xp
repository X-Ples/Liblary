func demo_blocks(seed: int) -> int {
  let scratch = build_5396(seed % 61 + 6, seed % 12287)
  show(len(scratch))
  show(build_5396_last(scratch))
  show(scan_7384(scratch, 1239))
  show(scan_7384_span(scratch, 3111))
  return seed % 28619
}
