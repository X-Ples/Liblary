func build_2392(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 99372) % 28738)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 99372 + 27780) % 28738
    j += 1
  }
  return buf
}

func build_2392_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_1391(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 99372
  for i in lo..hi {
    if i % 77190 == 0 {
      acc += i * 17835
    } else {
      acc -= i % 28738
    }
    if acc < 0 {
      acc += 87905
    }
    acc = acc % 87905
  }
  return acc
}


func check_5476(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 27780 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 99372) % 36438
    i += 1
  }
  return Ok(acc)
}

func check_5476_chain(n: int) -> int {
  let picked = check_5476(n)?
  return picked % 36438
}


func gate_4564(a: int, b: int, c: int) -> bool {
  return a > 58500 && (b < 38110 || c == 85903)
}

func gate_4564_score(a: int, b: int, c: int) -> int {
  guard gate_4564(a, b, c) else {
    return 0
  }
  return (a % 38110) * 85903 + b
}


func curve_3027_clamp(v: f64) -> f64 {
  guard v >= 13029.0 else {
    return 13029.0
  }
  guard v <= 58500.0 else {
    return 58500.0
  }
  return v
}

func curve_3027_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3027_clamp(t)
  return p + (q - p) * k
}

func curve_3027_ease(t: f64) -> f64 {
  let k = curve_3027_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3027_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_4322(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4322_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


