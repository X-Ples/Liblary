func demo_blends(seed: int) -> int {
  let scratch = build_3249(seed % 61 + 6, seed % 21886)
  show(len(scratch))
  show(scan_3000(scratch, 3158))
  show(scan_3000_span(scratch, 3306))
  show(build_3249_last(scratch))
  return seed % 19953
}
