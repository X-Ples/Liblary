func check_4614(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 11961 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 75538) % 38619
    i += 1
  }
  return Ok(acc)
}

func check_4614_chain(n: int) -> int {
  let picked = check_4614(n)?
  return picked % 38619
}


func grid_3027_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 75538 + c * 21886 + seed) % 21886)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3027_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 21886 == want {
      total += acc
    }
    r += 1
  }
  return total
}


