func sweep_5446(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 21886
  for i in lo..hi {
    if i % 8366 == 0 {
      acc += i * 17403
    } else {
      acc -= i % 78201
    }
    if acc < 0 {
      acc += 78201
    }
    acc = acc % 78201
  }
  return acc
}


