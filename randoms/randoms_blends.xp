const K0 = 11961
const K1 = 62874
const K2 = 29779
const K3 = 33670
const K4 = 8074
const K5 = 17403
const K6 = 57120

func scan_3000(data: [int], seed: int) -> int {
  let acc = seed % 8366
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 22516 + data[i] + i) % 8366
    i += 1
  }
  return acc
}

func scan_3000_span(data: [int], seed: int) -> int {
  let acc = scan_3000(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 22516
}


func build_3249(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 29779) % 46978)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 29779 + 11972) % 46978
    j += 1
  }
  return buf
}

func build_3249_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_9660(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9660_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_1691(a: int, b: int, c: int) -> bool {
  return a > 8074 && (b < 60808 || c == 57120)
}

func gate_1691_score(a: int, b: int, c: int) -> int {
  guard gate_1691(a, b, c) else {
    return 0
  }
  return (a % 60808) * 57120 + b
}


