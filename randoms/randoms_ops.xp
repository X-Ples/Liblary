func text_1674_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 82458
    i += 1
  }
  return acc % 82458
}

func text_1674_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "ember"
}

func text_1674_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 15658
}


func grid_4912_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 74434 + c * 93290 + seed) % 93290)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4912_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 93290 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_8813(a: int, b: int, c: int) -> bool {
  return a > 15658 && (b < 61604 || c == 82458)
}

func gate_8813_score(a: int, b: int, c: int) -> int {
  guard gate_8813(a, b, c) else {
    return 0
  }
  return (a % 61604) * 82458 + b
}


func check_1600(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 59851 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 57004) % 91751
    i += 1
  }
  return Ok(acc)
}

func check_1600_chain(n: int) -> int {
  let picked = check_1600(n)?
  return picked % 91751
}


func sweep_4016(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 62329
  for i in lo..hi {
    if i % 70432 == 0 {
      acc += i * 81534
    } else {
      acc -= i % 54664
    }
    if acc < 0 {
      acc += 24083
    }
    acc = acc % 24083
  }
  return acc
}


