func demo_ops(seed: int) -> int {
  let scratch = build_7205(seed % 61 + 6, seed % 40897)
  show(len(scratch))
  show(build_7205_last(scratch))
  show(build_4451_last(scratch))
  show(text_1674_weight("nova"))
  show(text_1674_label(1730))
  return seed % 81534
}
