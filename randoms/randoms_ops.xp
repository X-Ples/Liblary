  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2712_sum(limit: int) -> int {
  let row = row_2712()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
