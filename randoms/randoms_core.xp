func sweep_5270(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 67417
  for i in lo..hi {
    if i % 76761 == 0 {
      acc += i * 73455
    } else {
      acc -= i % 37369
    }
    if acc < 0 {
      acc += 25965
    }
    acc = acc % 25965
  }
  return acc
}


