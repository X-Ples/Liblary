func demo_core(seed: int) -> int {
  let scratch = build_4765(seed % 61 + 6, seed % 12962)
  show(len(scratch))
  show(gate_4492(3629, 488, 3626))
  show(gate_4492_score(253, 461, 2028))
  show(build_4765_last(scratch))
  show(grid_3455_rowsum(scratch, 3006, 1950, 2904))
  show(check_1619_chain(129))
  show(order_9015_find(scratch, 3848))
  return seed % 32879
}
