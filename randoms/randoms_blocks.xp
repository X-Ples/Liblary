func scan_2103(data: [int], seed: int) -> int {
  let acc = seed % 743
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 743 + data[i] + i) % 743
    i += 1
  }
  return acc
}

func scan_2103_span(data: [int], seed: int) -> int {
  let acc = scan_2103(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 743
}


