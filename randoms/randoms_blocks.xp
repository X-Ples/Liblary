}

func row_4528_best() -> int {
  let row = row_4528()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_8899(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 94660
  for i in lo..hi {
    if i % 40869 == 0 {
      acc += i * 743
    } else {
      acc -= i % 40329
    }
    if acc < 0 {
      acc += 94660
    }
    acc = acc % 94660
  }
  return acc
}


