func demo_blocks(seed: int) -> int {
  let scratch = build_6155(seed % 61 + 6, seed % 32776)
  show(len(scratch))
  show(build_6155_last(scratch))
  show(grid_3790_rowsum(scratch, 983, 2491, 780))
