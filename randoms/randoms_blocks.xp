func curve_8169_clamp(v: f64) -> f64 {
  guard v >= 18289.0 else {
    return 18289.0
  }
  guard v <= 83488.0 else {
    return 83488.0
  }
  return v
}

func curve_8169_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8169_clamp(t)
  return p + (q - p) * k
}

func curve_8169_ease(t: f64) -> f64 {
  let k = curve_8169_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8169_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_8046(a: int, b: int, c: int) -> bool {
  return a > 37993 && (b < 91870 || c == 91870)
}

func gate_8046_score(a: int, b: int, c: int) -> int {
  guard gate_8046(a, b, c) else {
    return 0
  }
  return (a % 91870) * 91870 + b
}


func row_4528() -> [int] {
