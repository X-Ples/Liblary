func grid_316_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 30154 + c * 76646 + seed) % 76646)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_316_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 76646 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_2656_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 7169
    i += 1
  }
  return acc % 7169
}

func text_2656_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "delta"
}

func text_2656_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 76646
}


func build_3395(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 34107) % 22860)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 34107 + 99675) % 22860
    j += 1
  }
  return buf
}

func build_3395_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_1358(a: int, b: int, c: int) -> bool {
  return a > 90849 && (b < 30154 || c == 53878)
}

func gate_1358_score(a: int, b: int, c: int) -> int {
  guard gate_1358(a, b, c) else {
    return 0
  }
  return (a % 30154) * 53878 + b
}


