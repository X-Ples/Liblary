func sweep_3590(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 17453
  for i in lo..hi {
    if i % 50118 == 0 {
      acc += i * 7169
    } else {
      acc -= i % 47424
    }
    if acc < 0 {
      acc += 47424
    }
    acc = acc % 47424
  }
  return acc
}


