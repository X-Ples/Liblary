func demo_helpers(seed: int) -> int {
  let scratch = build_3395(seed % 61 + 6, seed % 90449)
  show(len(scratch))
  show(grid_316_rowsum(scratch, 98, 3966, 661))
  show(text_2656_weight("nova"))
  show(text_2656_label(830))
  show(text_2656_has("sigma"))
  show(build_3395_last(scratch))
  return seed % 53878
}
