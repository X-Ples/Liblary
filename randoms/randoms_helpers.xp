func check_186(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 76646 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 13041) % 23218
    i += 1
  }
  return Ok(acc)
}

func check_186_chain(n: int) -> int {
  let picked = check_186(n)?
  return picked % 23218
}


