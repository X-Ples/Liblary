func scan_7844(data: [int], seed: int) -> int {
  let acc = seed % 52271
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 83338 + data[i] + i) % 52271
    i += 1
  }
  return acc
}

func scan_7844_span(data: [int], seed: int) -> int {
  let acc = scan_7844(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 83338
}


