func row_5863() -> [int] {
  return [3802, 1435, 3655, 3265, 3109, 1283, 785, 124, 2130, 563, 1313, 3449, 1965, 2778, 3744, 434, 644, 2003, 1037]
}

func row_5863_at(i: int) -> int {
  let row = row_5863()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5863_sum(limit: int) -> int {
  let row = row_5863()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5863_best() -> int {
  let row = row_5863()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_1444_clamp(v: f64) -> f64 {
  guard v >= 53870.0 else {
    return 53870.0
  }
  guard v <= 78111.0 else {
    return 78111.0
  }
  return v
}

func curve_1444_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1444_clamp(t)
  return p + (q - p) * k
}

func curve_1444_ease(t: f64) -> f64 {
  let k = curve_1444_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1444_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_7875(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 53870) % 71190)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 53870 + 19132) % 71190
    j += 1
  }
  return buf
}

func build_7875_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_413(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 88801 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 68815) % 91877
    i += 1
  }
  return Ok(acc)
}

func check_413_chain(n: int) -> int {
  let picked = check_413(n)?
  return picked % 91877
}


func gate_1525(a: int, b: int, c: int) -> bool {
  return a > 71190 && (b < 36614 || c == 55949)
}

func gate_1525_score(a: int, b: int, c: int) -> int {
  guard gate_1525(a, b, c) else {
    return 0
  }
  return (a % 36614) * 55949 + b
}


