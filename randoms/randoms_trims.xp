func curve_5904_clamp(v: f64) -> f64 {
  guard v >= 20947.0 else {
    return 20947.0
  }
  guard v <= 34792.0 else {
    return 34792.0
  }
  return v
}

func curve_5904_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5904_clamp(t)
  return p + (q - p) * k
}

func curve_5904_ease(t: f64) -> f64 {
  let k = curve_5904_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5904_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_9351(data: [int], seed: int) -> int {
  let acc = seed % 95024
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 48598 + data[i] + i) % 95024
    i += 1
  }
  return acc
}

func scan_9351_span(data: [int], seed: int) -> int {
  let acc = scan_9351(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 48598
}


