func sweep_3202(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 87889
  for i in lo..hi {
    if i % 31011 == 0 {
      acc += i * 42581
    } else {
      acc -= i % 88800
    }
    if acc < 0 {
      acc += 41920
    }
    acc = acc % 41920
  }
  return acc
}


func build_1150(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 31011) % 42661)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 31011 + 41369) % 42661
    j += 1
  }
  return buf
}

func build_1150_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_7123_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 94443
    i += 1
  }
  return acc % 94443
}

func text_7123_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "quartz"
}

func text_7123_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 87889
}


func grid_7070_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 34792 + c * 87889 + seed) % 87889)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7070_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 87889 == want {
      total += acc
    }
    r += 1
  }
  return total
}


