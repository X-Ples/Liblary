func demo_trims(seed: int) -> int {
  let scratch = build_1150(seed % 61 + 6, seed % 84599)
  show(len(scratch))
  show(sweep_3202(3429, 2385))
  show(build_1150_last(scratch))
  show(text_7123_weight("harbor"))
  show(text_7123_label(1902))
  show(text_7123_has("kilo"))
  show(grid_7070_rowsum(scratch, 853, 504, 1209))
  return seed % 41920
}
