func check_4134(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 75214 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 86310) % 41681
    i += 1
  }
  return Ok(acc)
}

func check_4134_chain(n: int) -> int {
  let picked = check_4134(n)?
  return picked % 41681
}


func row_1939() -> [int] {
  return [2030, 1558, 1071, 2119, 3600, 1371, 3266, 3202, 3259, 565, 67, 1676, 2904, 2443]
}

func row_1939_at(i: int) -> int {
  let row = row_1939()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1939_sum(limit: int) -> int {
  let row = row_1939()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1939_best() -> int {
  let row = row_1939()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_5920(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 54163) % 1189)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 54163 + 54163) % 1189
    j += 1
  }
  return buf
}

func build_5920_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


