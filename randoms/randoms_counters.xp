func demo_counters(seed: int) -> int {
  let scratch = build_2847(seed % 61 + 6, seed % 31731)
  show(len(scratch))
  show(grid_7932_rowsum(scratch, 3494, 1873, 1878))
  show(build_2847_last(scratch))
  show(order_2133_find(scratch, 1997))
  show(sweep_2709(975, 1954))
  show(text_5614_weight("cargo"))
  show(text_5614_label(3766))
  return seed % 33531
}
