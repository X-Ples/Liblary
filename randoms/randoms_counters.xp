func curve_3238_clamp(v: f64) -> f64 {
  guard v >= 2995.0 else {
    return 2995.0
  }
  guard v <= 31731.0 else {
    return 31731.0
  }
  return v
}

func curve_3238_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3238_clamp(t)
  return p + (q - p) * k
}

func curve_3238_ease(t: f64) -> f64 {
  let k = curve_3238_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3238_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_3829(a: int, b: int, c: int) -> bool {
  return a > 33531 && (b < 78938 || c == 31731)
}

func gate_3829_score(a: int, b: int, c: int) -> int {
  guard gate_3829(a, b, c) else {
    return 0
  }
  return (a % 78938) * 31731 + b
}


