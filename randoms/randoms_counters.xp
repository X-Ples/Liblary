func row_4121() -> [int] {
  return [3124, 385, 2618, 1768, 444, 3592, 3961, 3109, 1197, 3042, 1087, 2198, 90, 1650, 3287, 2629, 38, 203]
}

func row_4121_at(i: int) -> int {
  let row = row_4121()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4121_sum(limit: int) -> int {
  let row = row_4121()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4121_best() -> int {
  let row = row_4121()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


