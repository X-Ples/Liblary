const K0 = 38537
const K1 = 33531
const K2 = 33531
const K3 = 1067
const K4 = 54181
const K5 = 73672
const K6 = 2995
const K7 = 55964
const K8 = 78938
const K9 = 460
const K10 = 24329

func grid_7932_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 74217 + c * 33531 + seed) % 33531)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7932_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 33531 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func build_2847(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 2995) % 460)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 2995 + 30244) % 460
    j += 1
  }
  return buf
}

func build_2847_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_2133(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2133_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_2709(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 1067
  for i in lo..hi {
    if i % 2995 == 0 {
      acc += i * 27363
    } else {
      acc -= i % 10301
    }
    if acc < 0 {
      acc += 2097
    }
    acc = acc % 2097
  }
  return acc
}


func text_5614_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 14913
    i += 1
  }
  return acc % 14913
}

func text_5614_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ridge"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "lumen"
}

func text_5614_has(tag: str) -> bool {
  return str_contains(tag, "ridge") || len(tag) > 460
}


func scan_1305(data: [int], seed: int) -> int {
  let acc = seed % 2995
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 88450 + data[i] + i) % 2995
    i += 1
  }
  return acc
}

func scan_1305_span(data: [int], seed: int) -> int {
  let acc = scan_1305(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 88450
}


func sweep_8978(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 18190
  for i in lo..hi {
    if i % 78938 == 0 {
      acc += i * 460
    } else {
      acc -= i % 78938
    }
    if acc < 0 {
      acc += 77752
    }
    acc = acc % 77752
  }
  return acc
}


func check_2240(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 34789 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 55964) % 18190
    i += 1
  }
  return Ok(acc)
}

func check_2240_chain(n: int) -> int {
  let picked = check_2240(n)?
  return picked % 18190
}


