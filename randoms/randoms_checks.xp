func demo_checks(seed: int) -> int {
  let scratch = build_4860(seed % 61 + 6, seed % 74967)
  show(len(scratch))
  show(scan_4357(scratch, 3699))
  show(scan_4357_span(scratch, 2463))
  show(build_4860_last(scratch))
  show(build_8624_last(scratch))
  show(build_158_last(scratch))
  return seed % 48877
}
