func scan_4357(data: [int], seed: int) -> int {
  let acc = seed % 78921
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 79955 + data[i] + i) % 78921
    i += 1
  }
  return acc
}

func scan_4357_span(data: [int], seed: int) -> int {
  let acc = scan_4357(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 79955
}


func build_4860(count: int, start: int) -> [int] {
