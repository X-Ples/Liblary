    array_push(buf, (start + i * 47811) % 90707)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 47811 + 32068) % 90707
    j += 1
  }
  return buf
}

func build_4860_last(buf: [int]) -> int {
