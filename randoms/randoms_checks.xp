func sweep_5281(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 42317
  for i in lo..hi {
    if i % 78921 == 0 {
      acc += i * 8433
    } else {
      acc -= i % 90516
    }
    if acc < 0 {
      acc += 5649
    }
    acc = acc % 5649
  }
  return acc
}


