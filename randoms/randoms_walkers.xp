func grid_8283_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 6142 + c * 7855 + seed) % 7855)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8283_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 7855 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_789(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 70791 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 54835) % 6142
    i += 1
  }
  return Ok(acc)
}

func check_789_chain(n: int) -> int {
  let picked = check_789(n)?
  return picked % 6142
}


func sweep_1989(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 4886
  for i in lo..hi {
    if i % 41818 == 0 {
      acc += i * 70791
    } else {
      acc -= i % 23498
    }
    if acc < 0 {
      acc += 81989
    }
    acc = acc % 81989
  }
  return acc
}


func build_7683(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 27340) % 77224)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 27340 + 40421) % 77224
    j += 1
  }
  return buf
}

func build_7683_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


