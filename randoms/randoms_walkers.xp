func gate_8942_score(a: int, b: int, c: int) -> int {
  guard gate_8942(a, b, c) else {
    return 0
  }
  return (a % 71066) * 68980 + b
}


func curve_9112_clamp(v: f64) -> f64 {
  guard v >= 51937.0 else {
    return 51937.0
  }
  guard v <= 58691.0 else {
    return 58691.0
  }
  return v
}

func curve_9112_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9112_clamp(t)
  return p + (q - p) * k
}

func curve_9112_ease(t: f64) -> f64 {
  let k = curve_9112_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9112_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


