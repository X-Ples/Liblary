func demo_offsets(seed: int) -> int {
  let scratch = build_9328(seed % 61 + 6, seed % 45291)
  show(len(scratch))
  show(sweep_9646(1561, 3122))
  show(check_6858_chain(2718))
  show(gate_1216(1682, 633, 1015))
  show(gate_1216_score(382, 3551, 1766))
  show(build_9328_last(scratch))
  return seed % 52536
}
