func curve_482_clamp(v: f64) -> f64 {
  guard v >= 19773.0 else {
    return 19773.0
  }
  guard v <= 76259.0 else {
    return 76259.0
  }
  return v
}

func curve_482_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_482_clamp(t)
  return p + (q - p) * k
}

func curve_482_ease(t: f64) -> f64 {
  let k = curve_482_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_482_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_9646(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 91030
  for i in lo..hi {
    if i % 19773 == 0 {
      acc += i * 97489
    } else {
      acc -= i % 39090
    }
    if acc < 0 {
      acc += 35370
    }
    acc = acc % 35370
  }
  return acc
}


func check_6858(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 80177 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 19773) % 80177
    i += 1
  }
  return Ok(acc)
}

func check_6858_chain(n: int) -> int {
  let picked = check_6858(n)?
  return picked % 80177
}


