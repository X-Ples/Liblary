func scan_1640(data: [int], seed: int) -> int {
  let acc = seed % 1194
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 30986 + data[i] + i) % 1194
    i += 1
  }
  return acc
}

func scan_1640_span(data: [int], seed: int) -> int {
  let acc = scan_1640(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 30986
}


