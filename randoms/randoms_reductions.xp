func text_2799_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 97925
    i += 1
  }
  return acc % 97925
}

func text_2799_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "delta"
}

func text_2799_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 22757
}


func build_9572(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 27898) % 76278)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 27898 + 22757) % 76278
    j += 1
  }
  return buf
}

func build_9572_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_2523() -> [int] {
  return [3368, 1477, 782, 3167, 997, 2396, 3382, 1918, 3315, 1156, 3632, 1360, 1773, 3856, 3364]
}

func row_2523_at(i: int) -> int {
  let row = row_2523()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2523_sum(limit: int) -> int {
  let row = row_2523()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2523_best() -> int {
  let row = row_2523()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_2302_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 29277 + c * 10832 + seed) % 10832)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2302_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 10832 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_4729(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 24776 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 30446) % 1801
    i += 1
  }
  return Ok(acc)
}

func check_4729_chain(n: int) -> int {
  let picked = check_4729(n)?
  return picked % 1801
}


func scan_6372(data: [int], seed: int) -> int {
  let acc = seed % 5152
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 24776 + data[i] + i) % 5152
    i += 1
  }
  return acc
}

func scan_6372_span(data: [int], seed: int) -> int {
  let acc = scan_6372(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 24776
}


func sweep_4055(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10832
  for i in lo..hi {
    if i % 33033 == 0 {
      acc += i * 76195
    } else {
      acc -= i % 84153
    }
    if acc < 0 {
      acc += 75523
    }
    acc = acc % 75523
  }
  return acc
}


func gate_6027(a: int, b: int, c: int) -> bool {
  return a > 22757 && (b < 89930 || c == 84153)
