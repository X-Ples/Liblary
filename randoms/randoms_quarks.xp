func row_6104() -> [int] {
  return [962, 2089, 2626, 3562, 3070, 778, 1558, 2360, 2947, 1338, 1578, 2971]
}

func row_6104_at(i: int) -> int {
  let row = row_6104()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6104_sum(limit: int) -> int {
  let row = row_6104()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6104_best() -> int {
  let row = row_6104()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


