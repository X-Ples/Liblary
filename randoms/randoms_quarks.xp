func check_9056(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 93475 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 33405) % 94853
    i += 1
  }
  return Ok(acc)
}

func check_9056_chain(n: int) -> int {
  let picked = check_9056(n)?
  return picked % 94853
}


