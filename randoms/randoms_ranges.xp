func text_8760_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "ember"
}

func text_8760_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 71190
}


func sweep_7254(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 25046
  for i in lo..hi {
    if i % 76723 == 0 {
      acc += i * 10432
    } else {
      acc -= i % 71190
    }
    if acc < 0 {
      acc += 10432
    }
    acc = acc % 10432
  }
  return acc
}


func row_5675() -> [int] {
  return [3954, 3736, 318, 1937, 1490, 2224, 1574, 552, 688, 2280, 2409, 1498, 3169, 544, 2986, 559]
}

func row_5675_at(i: int) -> int {
  let row = row_5675()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5675_sum(limit: int) -> int {
  let row = row_5675()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5675_best() -> int {
  let row = row_5675()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_9189_clamp(v: f64) -> f64 {
  guard v >= 53374.0 else {
    return 53374.0
  }
  guard v <= 76723.0 else {
    return 76723.0
  }
  return v
}

func curve_9189_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9189_clamp(t)
  return p + (q - p) * k
}

func curve_9189_ease(t: f64) -> f64 {
  let k = curve_9189_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9189_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


