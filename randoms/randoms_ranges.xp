func gate_5175(a: int, b: int, c: int) -> bool {
  return a > 25046 && (b < 57839 || c == 97896)
}

func gate_5175_score(a: int, b: int, c: int) -> int {
  guard gate_5175(a, b, c) else {
    return 0
  }
  return (a % 57839) * 97896 + b
}


func build_5851(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 1697) % 20495)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 1697 + 97896) % 20495
    j += 1
  }
  return buf
}

func build_5851_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_5034_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 90925 + c * 375 + seed) % 375)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5034_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 375 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_865(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 5596 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 36202) % 43063
    i += 1
  }
  return Ok(acc)
}

func check_865_chain(n: int) -> int {
  let picked = check_865(n)?
  return picked % 43063
}


