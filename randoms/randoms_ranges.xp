func demo_ranges(seed: int) -> int {
  let scratch = build_5851(seed % 61 + 6, seed % 97896)
  show(len(scratch))
  show(gate_5175(3486, 2060, 3724))
  show(gate_5175_score(3746, 2773, 3308))
  show(build_5851_last(scratch))
  show(grid_5034_rowsum(scratch, 1861, 13, 1398))
  show(check_865_chain(1765))
  return seed % 88635
}
