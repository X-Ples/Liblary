func build_3769(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 10745) % 8741)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 10745 + 54660) % 8741
    j += 1
  }
  return buf
}

func build_3769_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_295_clamp(v: f64) -> f64 {
  guard v >= 5976.0 else {
    return 5976.0
  }
  guard v <= 16427.0 else {
    return 16427.0
  }
  return v
}

func curve_295_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_295_clamp(t)
  return p + (q - p) * k
}

func curve_295_ease(t: f64) -> f64 {
  let k = curve_295_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_295_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_1818(data: [int], seed: int) -> int {
  let acc = seed % 70278
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 72465 + data[i] + i) % 70278
    i += 1
  }
  return acc
}

func scan_1818_span(data: [int], seed: int) -> int {
  let acc = scan_1818(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 72465
}


func check_1214(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 5976 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 47003) % 54660
    i += 1
  }
  return Ok(acc)
}

func check_1214_chain(n: int) -> int {
  let picked = check_1214(n)?
  return picked % 54660
}


