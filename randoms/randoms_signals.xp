func demo_signals(seed: int) -> int {
  let scratch = build_3769(seed % 61 + 6, seed % 72465)
  show(len(scratch))
  show(build_3769_last(scratch))
  show(scan_1818(scratch, 2750))
  show(scan_1818_span(scratch, 566))
