func row_1132() -> [int] {
  return [427, 1109, 2958, 190, 1035, 2671, 1714, 523, 2712, 922, 2179, 3163, 3324, 1366, 873]
}

func row_1132_at(i: int) -> int {
  let row = row_1132()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1132_sum(limit: int) -> int {
  let row = row_1132()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1132_best() -> int {
  let row = row_1132()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_331(a: int, b: int, c: int) -> bool {
  return a > 22923 && (b < 50189 || c == 12008)
}

func gate_331_score(a: int, b: int, c: int) -> int {
  guard gate_331(a, b, c) else {
    return 0
  }
  return (a % 50189) * 12008 + b
}


func order_3581(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3581_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


