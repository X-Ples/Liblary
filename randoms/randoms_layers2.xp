func scan_1049(data: [int], seed: int) -> int {
  let acc = seed % 25653
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 51354 + data[i] + i) % 25653
    i += 1
  }
  return acc
}

func scan_1049_span(data: [int], seed: int) -> int {
  let acc = scan_1049(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 51354
}


