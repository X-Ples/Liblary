const K0 = 85981
const K1 = 34789
const K2 = 79609
const K3 = 34901
const K4 = 81866
const K5 = 79609

func order_6888(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6888_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_8884(a: int, b: int, c: int) -> bool {
  return a > 58284 && (b < 85981 || c == 24911)
}

func gate_8884_score(a: int, b: int, c: int) -> int {
  guard gate_8884(a, b, c) else {
    return 0
  }
  return (a % 85981) * 24911 + b
}


func build_9379(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 25881) % 89474)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 25881 + 13731) % 89474
    j += 1
  }
  return buf
}

func build_9379_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


