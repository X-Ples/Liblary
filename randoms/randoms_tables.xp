func scan_8378(data: [int], seed: int) -> int {
  let acc = seed % 34901
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 24911 + data[i] + i) % 34901
    i += 1
  }
  return acc
}

func scan_8378_span(data: [int], seed: int) -> int {
  let acc = scan_8378(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 24911
}


