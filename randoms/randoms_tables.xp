func grid_8798_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 25620 + c * 12456 + seed) % 12456)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8798_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 12456 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_2110(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 25620
  for i in lo..hi {
    if i % 13731 == 0 {
      acc += i * 14430
    } else {
      acc -= i % 21317
    }
    if acc < 0 {
      acc += 43610
    }
    acc = acc % 43610
  }
  return acc
}


