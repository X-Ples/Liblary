func demo_tables(seed: int) -> int {
  let scratch = build_9379(seed % 61 + 6, seed % 14430)
  show(len(scratch))
  show(order_6888_find(scratch, 3579))
  show(gate_8884(1969, 1405, 845))
  show(gate_8884_score(1886, 2614, 3651))
  show(build_9379_last(scratch))
  return seed % 43610
}
