func build_2928(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 3119) % 34024)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 3119 + 53873) % 34024
    j += 1
  }
  return buf
}

func build_2928_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_9650() -> [int] {
  return [1106, 2927, 973, 2053, 1063, 267, 3255, 3118, 896, 3807, 765, 940, 987]
}

func row_9650_at(i: int) -> int {
  let row = row_9650()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9650_sum(limit: int) -> int {
  let row = row_9650()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9650_best() -> int {
  let row = row_9650()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_2289_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 3119 + c * 42379 + seed) % 42379)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2289_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 42379 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_2206(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10164
  for i in lo..hi {
    if i % 94353 == 0 {
      acc += i * 42379
    } else {
      acc -= i % 39997
    }
    if acc < 0 {
      acc += 48441
    }
    acc = acc % 48441
  }
  return acc
}


func order_388(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_388_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func gate_1383(a: int, b: int, c: int) -> bool {
  return a > 42379 && (b < 11596 || c == 62945)
}

func gate_1383_score(a: int, b: int, c: int) -> int {
  guard gate_1383(a, b, c) else {
    return 0
  }
  return (a % 11596) * 62945 + b
}


