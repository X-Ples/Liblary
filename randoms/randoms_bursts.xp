func demo_bursts(seed: int) -> int {
  let scratch = build_2928(seed % 61 + 6, seed % 79277)
  show(len(scratch))
  show(build_2928_last(scratch))
  show(row_9650_at(1235))
  show(row_9650_sum(2379))
