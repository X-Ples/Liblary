func build_7934(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 77690) % 25631)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 77690 + 4070) % 25631
    j += 1
  }
  return buf
}

func build_7934_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_3942(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 8753 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 82936) % 4070
    i += 1
  }
  return Ok(acc)
}

func check_3942_chain(n: int) -> int {
  let picked = check_3942(n)?
  return picked % 4070
}


