func row_1333() -> [int] {
  return [2913, 969, 3494, 2854, 1401, 207, 663, 1749, 3126, 767]
}

func row_1333_at(i: int) -> int {
  let row = row_1333()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1333_sum(limit: int) -> int {
  let row = row_1333()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1333_best() -> int {
  let row = row_1333()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_5980(a: int, b: int, c: int) -> bool {
  return a > 30725 && (b < 52285 || c == 69828)
}

func gate_5980_score(a: int, b: int, c: int) -> int {
  guard gate_5980(a, b, c) else {
    return 0
  }
  return (a % 52285) * 69828 + b
}


func grid_9852_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 44505 + c * 44505 + seed) % 44505)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9852_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 44505 == want {
      total += acc
    }
    r += 1
  }
  return total
}


