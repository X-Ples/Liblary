func scan_8002(data: [int], seed: int) -> int {
  let acc = seed % 70874
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 68070 + data[i] + i) % 70874
    i += 1
  }
  return acc
}

func scan_8002_span(data: [int], seed: int) -> int {
  let acc = scan_8002(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 68070
}


