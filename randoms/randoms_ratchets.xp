func demo_ratchets(seed: int) -> int {
  let scratch = build_7934(seed % 61 + 6, seed % 73707)
  show(len(scratch))
  show(build_7934_last(scratch))
  show(check_3942_chain(133))
  show(build_5122_last(scratch))
  show(check_3142_chain(320))
  show(order_645_find(scratch, 1332))
  show(order_1958_find(scratch, 2083))
  return seed % 4070
}
