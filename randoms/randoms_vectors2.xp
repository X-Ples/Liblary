func order_2697(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2697_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func scan_2817(data: [int], seed: int) -> int {
  let acc = seed % 38225
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 90696 + data[i] + i) % 38225
    i += 1
  }
  return acc
}

func scan_2817_span(data: [int], seed: int) -> int {
  let acc = scan_2817(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 90696
}


func check_4530(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 33607 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 90696) % 166
    i += 1
  }
  return Ok(acc)
}

func check_4530_chain(n: int) -> int {
  let picked = check_4530(n)?
  return picked % 166
}


func row_5299() -> [int] {
  return [1112, 3842, 2520, 2133, 3941, 2264, 2414, 2389, 370, 998, 3208, 2049, 326, 4077, 3092, 3586]
}

func row_5299_at(i: int) -> int {
  let row = row_5299()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5299_sum(limit: int) -> int {
  let row = row_5299()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5299_best() -> int {
  let row = row_5299()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_7350(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 46251
  for i in lo..hi {
    if i % 20856 == 0 {
      acc += i * 63137
    } else {
      acc -= i % 90446
    }
    if acc < 0 {
      acc += 13093
    }
    acc = acc % 13093
  }
  return acc
}


func curve_7870_clamp(v: f64) -> f64 {
  guard v >= 370.0 else {
    return 370.0
  }
  guard v <= 46251.0 else {
    return 46251.0
  }
  return v
}

func curve_7870_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7870_clamp(t)
  return p + (q - p) * k
}

func curve_7870_ease(t: f64) -> f64 {
  let k = curve_7870_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7870_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


