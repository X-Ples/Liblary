func demo_vectors2(seed: int) -> int {
  let scratch = build_8581(seed % 61 + 6, seed % 17808)
  show(len(scratch))
  show(build_8581_last(scratch))
  show(build_929_last(scratch))
  show(order_2697_find(scratch, 3136))
  show(scan_2817(scratch, 1524))
  show(scan_2817_span(scratch, 2861))
  return seed % 67844
}
