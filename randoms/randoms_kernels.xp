func scan_4535(data: [int], seed: int) -> int {
  let acc = seed % 30607
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 23341 + data[i] + i) % 30607
    i += 1
  }
  return acc
}

func scan_4535_span(data: [int], seed: int) -> int {
  let acc = scan_4535(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 23341
}


func curve_1167_clamp(v: f64) -> f64 {
  guard v >= 19170.0 else {
    return 19170.0
  }
  guard v <= 89858.0 else {
    return 89858.0
  }
  return v
}

func curve_1167_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1167_clamp(t)
  return p + (q - p) * k
}

func curve_1167_ease(t: f64) -> f64 {
  let k = curve_1167_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1167_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


