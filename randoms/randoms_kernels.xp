const K0 = 45506
const K1 = 47431
const K2 = 3416
const K3 = 78685
const K4 = 2993
const K5 = 30607

func build_1705(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 3416) % 30607)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 3416 + 94267) % 30607
    j += 1
  }
  return buf
}

func build_1705_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_1249(a: int, b: int, c: int) -> bool {
  return a > 1447 && (b < 30607 || c == 27343)
}

func gate_1249_score(a: int, b: int, c: int) -> int {
  guard gate_1249(a, b, c) else {
    return 0
  }
  return (a % 30607) * 27343 + b
}


func check_8100(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 54844 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 54844) % 26798
    i += 1
  }
  return Ok(acc)
}

func check_8100_chain(n: int) -> int {
  let picked = check_8100(n)?
  return picked % 26798
}


func grid_9873_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 3896 + c * 88079 + seed) % 88079)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9873_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 88079 == want {
      total += acc
    }
    r += 1
  }
  return total
}


