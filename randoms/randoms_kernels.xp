func text_1880_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 78685
    i += 1
  }
  return acc % 78685
}

func text_1880_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "quartz"
}

func text_1880_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 23341
}


