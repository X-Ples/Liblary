func demo_kernels(seed: int) -> int {
  let scratch = build_1705(seed % 61 + 6, seed % 89858)
  show(len(scratch))
  show(build_1705_last(scratch))
  show(gate_1249(402, 3200, 802))
  show(gate_1249_score(1879, 1764, 1433))
  show(check_8100_chain(2761))
  return seed % 89226
}
