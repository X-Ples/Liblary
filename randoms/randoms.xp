func text_4928_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 60649
    i += 1
  }
  return acc % 60649
}

func text_4928_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "gamma"
}

func text_4928_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 68268
}


