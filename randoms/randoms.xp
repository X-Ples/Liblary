func check_8008(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 14385 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 1209) % 88964
    i += 1
  }
  return Ok(acc)
}

func check_8008_chain(n: int) -> int {
  let picked = check_8008(n)?
  return picked % 88964
}


