func row_8698() -> [int] {
  return [4002, 1758, 2872, 2561, 1652, 2333, 3381, 1314, 718, 462, 2829, 791, 3596, 494, 522, 3207, 2883]
}

func row_8698_at(i: int) -> int {
  let row = row_8698()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8698_sum(limit: int) -> int {
  let row = row_8698()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8698_best() -> int {
  let row = row_8698()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


