func build_3071(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 42761) % 76319)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 42761 + 97433) % 76319
    j += 1
  }
  return buf
}

func build_3071_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_8603(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 42761
  for i in lo..hi {
    if i % 23711 == 0 {
      acc += i * 35638
    } else {
      acc -= i % 39179
    }
    if acc < 0 {
      acc += 64883
    }
    acc = acc % 64883
  }
  return acc
}


func curve_3910_clamp(v: f64) -> f64 {
  guard v >= 29419.0 else {
    return 29419.0
  }
  guard v <= 54388.0 else {
    return 54388.0
  }
  return v
}

func curve_3910_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3910_clamp(t)
  return p + (q - p) * k
}

func curve_3910_ease(t: f64) -> f64 {
  let k = curve_3910_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3910_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_5445() -> [int] {
  return [3644, 3184, 2079, 366, 119, 3474, 13, 2410, 3593, 2027, 200, 2641, 3840, 808, 2312, 778, 415, 315, 793, 3006]
}

func row_5445_at(i: int) -> int {
  let row = row_5445()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5445_sum(limit: int) -> int {
  let row = row_5445()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5445_best() -> int {
  let row = row_5445()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_7559(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7559_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_1320_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 1866
    i += 1
  }
  return acc % 1866
}

func text_1320_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "kilo"
}

func text_1320_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 45249
}


