func demo_windows(seed: int) -> int {
  let scratch = build_3071(seed % 61 + 6, seed % 19476)
  show(len(scratch))
  show(build_3071_last(scratch))
  show(sweep_8603(2791, 794))
  show(row_5445_at(1975))
