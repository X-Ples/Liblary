func scan_4163(data: [int], seed: int) -> int {
  let acc = seed % 23711
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 25212 + data[i] + i) % 23711
    i += 1
  }
  return acc
}

func scan_4163_span(data: [int], seed: int) -> int {
  let acc = scan_4163(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 25212
}


