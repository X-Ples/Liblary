func demo_pickers(seed: int) -> int {
  let scratch = build_1948(seed % 61 + 6, seed % 4454)
  show(len(scratch))
  show(sweep_2271(2330, 1274))
  show(grid_527_rowsum(scratch, 2185, 991, 1593))
  show(build_1948_last(scratch))
  show(build_3321_last(scratch))
  show(gate_9032(3769, 90, 2895))
  return seed % 4080
}
