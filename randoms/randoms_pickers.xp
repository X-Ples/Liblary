func text_2608_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 35302
    i += 1
  }
  return acc % 35302
}

func text_2608_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "harbor"
}

func text_2608_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 41463
}


func row_380() -> [int] {
  return [1871, 1057, 1674, 1186, 3587, 3368, 2643, 860, 2140, 756, 1005, 228, 195, 966, 2673, 1383, 2533, 580, 3183]
}

func row_380_at(i: int) -> int {
  let row = row_380()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_380_sum(limit: int) -> int {
  let row = row_380()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_380_best() -> int {
  let row = row_380()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


