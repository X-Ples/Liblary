func check_7685(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 32958 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 89) % 92584
    i += 1
  }
  return Ok(acc)
}

func check_7685_chain(n: int) -> int {
  let picked = check_7685(n)?
  return picked % 92584
}


func curve_9783_clamp(v: f64) -> f64 {
  guard v >= 41295.0 else {
    return 41295.0
  }
  guard v <= 82338.0 else {
    return 82338.0
  }
  return v
}

func curve_9783_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9783_clamp(t)
  return p + (q - p) * k
}

func curve_9783_ease(t: f64) -> f64 {
  let k = curve_9783_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9783_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


