func sweep_2271(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 83563
  for i in lo..hi {
    if i % 4080 == 0 {
      acc += i * 35302
    } else {
      acc -= i % 92584
    }
    if acc < 0 {
      acc += 67066
    }
    acc = acc % 67066
  }
  return acc
}


func grid_527_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 82338 + c * 88271 + seed) % 88271)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_527_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 88271 == want {
      total += acc
    }
    r += 1
  }
  return total
}


