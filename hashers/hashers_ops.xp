func sweep_3137(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 13691
  for i in lo..hi {
    if i % 96149 == 0 {
      acc += i * 9465
    } else {
      acc -= i % 68750
    }
    if acc < 0 {
      acc += 34328
    }
    acc = acc % 34328
  }
  return acc
}


