func row_185() -> [int] {
  return [1288, 3624, 1589, 326, 238, 177, 3696, 1521, 3063, 2320, 3173, 4053, 1737, 835, 326, 298, 1723, 1813, 3128, 2491, 2651]
}

func row_185_at(i: int) -> int {
  let row = row_185()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_185_sum(limit: int) -> int {
  let row = row_185()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_185_best() -> int {
  let row = row_185()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_5342(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 14640) % 48471)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 14640 + 13691) % 48471
    j += 1
  }
  return buf
}

func build_5342_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_3805(data: [int], seed: int) -> int {
  let acc = seed % 24199
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 96149 + data[i] + i) % 24199
    i += 1
  }
  return acc
}

func scan_3805_span(data: [int], seed: int) -> int {
  let acc = scan_3805(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 96149
}


