func demo_ops(seed: int) -> int {
  let scratch = build_5342(seed % 61 + 6, seed % 96149)
  show(len(scratch))
  show(row_185_at(2649))
  show(row_185_sum(268))
  show(row_185_best())
  show(build_5342_last(scratch))
  show(scan_3805(scratch, 3734))
  return seed % 45043
}
