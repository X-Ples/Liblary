func sweep_8139(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 26401
  for i in lo..hi {
    if i % 32421 == 0 {
      acc += i * 93262
    } else {
      acc -= i % 58038
    }
    if acc < 0 {
      acc += 81775
    }
    acc = acc % 81775
  }
  return acc
}


func check_3918(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 58038 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 84380) % 76913
    i += 1
  }
  return Ok(acc)
}

func check_3918_chain(n: int) -> int {
  let picked = check_3918(n)?
  return picked % 76913
}


