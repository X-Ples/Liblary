func demo_trims(seed: int) -> int {
  let scratch = build_2640(seed % 61 + 6, seed % 28396)
  show(len(scratch))
  show(build_2640_last(scratch))
  show(scan_4923(scratch, 208))
  show(scan_4923_span(scratch, 3443))
  return seed % 93262
}
