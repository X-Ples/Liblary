func build_2640(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 54432) % 99929)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 54432 + 43386) % 99929
    j += 1
  }
  return buf
}

func build_2640_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_4923(data: [int], seed: int) -> int {
  let acc = seed % 77789
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 84380 + data[i] + i) % 77789
    i += 1
  }
  return acc
}

func scan_4923_span(data: [int], seed: int) -> int {
  let acc = scan_4923(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 84380
}


func grid_7931_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 40428 + c * 58038 + seed) % 58038)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7931_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 58038 == want {
      total += acc
    }
    r += 1
  }
  return total
}


