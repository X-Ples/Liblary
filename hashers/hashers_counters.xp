func build_6127(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 98845) % 39945)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 98845 + 18998) % 39945
    j += 1
  }
  return buf
}

func build_6127_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_6144(data: [int], seed: int) -> int {
  let acc = seed % 93504
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 47021 + data[i] + i) % 93504
    i += 1
  }
  return acc
}

func scan_6144_span(data: [int], seed: int) -> int {
  let acc = scan_6144(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 47021
}


func sweep_9170(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 6139
  for i in lo..hi {
    if i % 89629 == 0 {
      acc += i * 78071
    } else {
      acc -= i % 98845
    }
    if acc < 0 {
      acc += 93504
    }
    acc = acc % 93504
  }
  return acc
}


