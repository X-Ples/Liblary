func check_376(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 6438 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 74595) % 71604
    i += 1
  }
  return Ok(acc)
}

func check_376_chain(n: int) -> int {
  let picked = check_376(n)?
  return picked % 71604
}


