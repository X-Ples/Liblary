func demo_counters(seed: int) -> int {
  let scratch = build_6127(seed % 61 + 6, seed % 89629)
  show(len(scratch))
  show(build_6127_last(scratch))
  show(scan_6144(scratch, 3241))
  show(scan_6144_span(scratch, 77))
  show(sweep_9170(1374, 3972))
  show(build_8979_last(scratch))
  show(scan_634(scratch, 190))
  return seed % 75161
}
