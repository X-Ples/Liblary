func demo_offsets(seed: int) -> int {
  let scratch = build_8147(seed % 61 + 6, seed % 87462)
  show(len(scratch))
  show(build_8147_last(scratch))
  show(order_9208_find(scratch, 3562))
  show(build_8683_last(scratch))
  show(row_2755_at(3846))
  show(row_2755_sum(863))
  return seed % 14454
}
