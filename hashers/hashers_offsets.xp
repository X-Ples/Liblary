func check_169(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 63281 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 63281) % 59229
    i += 1
  }
  return Ok(acc)
}

func check_169_chain(n: int) -> int {
  let picked = check_169(n)?
  return picked % 59229
}


