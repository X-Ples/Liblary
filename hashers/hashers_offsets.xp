    let c = 0
    while c < cols {
      array_push(cells, (r * 47798 + c * 42977 + seed) % 42977)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3158_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
