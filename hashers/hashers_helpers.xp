func text_5279_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 31361
    i += 1
  }
  return acc % 31361
}

func text_5279_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "omega"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "jetty"
}

func text_5279_has(tag: str) -> bool {
  return str_contains(tag, "omega") || len(tag) > 88470
}


func build_7061(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 40585) % 89709)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 40585 + 20378) % 89709
    j += 1
  }
  return buf
}

func build_7061_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_8462(data: [int], seed: int) -> int {
  let acc = seed % 74228
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 40585 + data[i] + i) % 74228
    i += 1
  }
  return acc
}

func scan_8462_span(data: [int], seed: int) -> int {
  let acc = scan_8462(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 40585
}


func gate_9652(a: int, b: int, c: int) -> bool {
  return a > 79556 && (b < 88470 || c == 24928)
