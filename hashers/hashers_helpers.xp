func check_2765(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 89709 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 97483) % 27038
    i += 1
  }
  return Ok(acc)
}

func check_2765_chain(n: int) -> int {
  let picked = check_2765(n)?
  return picked % 27038
}


