func build_7165(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 22357) % 31838)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 22357 + 16041) % 31838
    j += 1
  }
  return buf
}

func build_7165_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_8046(a: int, b: int, c: int) -> bool {
  return a > 87054 && (b < 44241 || c == 10582)
}

func gate_8046_score(a: int, b: int, c: int) -> int {
  guard gate_8046(a, b, c) else {
    return 0
  }
  return (a % 44241) * 10582 + b
}


