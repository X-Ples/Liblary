func grid_3848_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 27829 + c * 87054 + seed) % 87054)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3848_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 87054 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_2101_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 73354
    i += 1
  }
  return acc % 73354
}

func text_2101_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "omega"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "bravo"
}

func text_2101_has(tag: str) -> bool {
  return str_contains(tag, "omega") || len(tag) > 73354
}


func scan_4908(data: [int], seed: int) -> int {
  let acc = seed % 74207
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 10808 + data[i] + i) % 74207
    i += 1
  }
  return acc
}

func scan_4908_span(data: [int], seed: int) -> int {
  let acc = scan_4908(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 10808
}


func order_7181(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7181_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_5751(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 52888
  for i in lo..hi {
    if i % 43871 == 0 {
      acc += i * 70162
    } else {
      acc -= i % 85938
    }
    if acc < 0 {
      acc += 10582
    }
    acc = acc % 10582
  }
  return acc
}


