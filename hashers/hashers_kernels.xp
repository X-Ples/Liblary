func check_5594(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 31838 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 36578) % 22357
    i += 1
  }
  return Ok(acc)
}

func check_5594_chain(n: int) -> int {
  let picked = check_5594(n)?
  return picked % 22357
}


