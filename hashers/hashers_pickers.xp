func build_5297(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 19613) % 66482)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 19613 + 49937) % 66482
    j += 1
  }
  return buf
}

func build_5297_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_6201(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 32097
  for i in lo..hi {
    if i % 49937 == 0 {
      acc += i * 20392
    } else {
      acc -= i % 85690
    }
    if acc < 0 {
      acc += 35860
    }
    acc = acc % 35860
  }
  return acc
}


func text_3784_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 32097
    i += 1
  }
  return acc % 32097
}

func text_3784_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "quartz"
}

func text_3784_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 6576
}


