func row_7263_at(i: int) -> int {
  let row = row_7263()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7263_sum(limit: int) -> int {
  let row = row_7263()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7263_best() -> int {
  let row = row_7263()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_1639(a: int, b: int, c: int) -> bool {
  return a > 89557 && (b < 73476 || c == 36561)
}

func gate_1639_score(a: int, b: int, c: int) -> int {
  guard gate_1639(a, b, c) else {
    return 0
  }
  return (a % 73476) * 36561 + b
}


func curve_3437_clamp(v: f64) -> f64 {
  guard v >= 13151.0 else {
    return 13151.0
  }
  guard v <= 73945.0 else {
    return 73945.0
  }
  return v
}

func curve_3437_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3437_clamp(t)
  return p + (q - p) * k
}

func curve_3437_ease(t: f64) -> f64 {
  let k = curve_3437_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3437_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


