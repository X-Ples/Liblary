func check_8731(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 93421 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 48930) % 93577
    i += 1
  }
  return Ok(acc)
}

func check_8731_chain(n: int) -> int {
  let picked = check_8731(n)?
  return picked % 93577
}


