func build_7427(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 68154) % 93421)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 68154 + 17760) % 93421
    j += 1
  }
  return buf
}

func build_7427_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_7263() -> [int] {
