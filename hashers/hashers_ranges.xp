func check_3597(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 3378 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 87472) % 53205
    i += 1
  }
  return Ok(acc)
}

func check_3597_chain(n: int) -> int {
  let picked = check_3597(n)?
  return picked % 53205
}


