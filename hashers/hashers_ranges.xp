const K0 = 74774
const K1 = 12596
const K2 = 38987
const K3 = 87472
const K4 = 55065
const K5 = 20844
const K6 = 3687
const K7 = 12596
const K8 = 71608
const K9 = 91380

func gate_7070(a: int, b: int, c: int) -> bool {
  return a > 35381 && (b < 57550 || c == 36258)
}

func gate_7070_score(a: int, b: int, c: int) -> int {
  guard gate_7070(a, b, c) else {
    return 0
  }
  return (a % 57550) * 36258 + b
}


func text_5365_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 92034
    i += 1
  }
  return acc % 92034
}

func text_5365_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "cargo"
}

func text_5365_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 92034
}


func sweep_2687(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 2106
  for i in lo..hi {
    if i % 75266 == 0 {
      acc += i * 41785
    } else {
      acc -= i % 92101
    }
    if acc < 0 {
      acc += 71608
    }
    acc = acc % 71608
  }
  return acc
}


func curve_7507_clamp(v: f64) -> f64 {
  guard v >= 75266.0 else {
    return 75266.0
  }
  guard v <= 87472.0 else {
    return 87472.0
  }
  return v
}

func curve_7507_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7507_clamp(t)
  return p + (q - p) * k
}

func curve_7507_ease(t: f64) -> f64 {
  let k = curve_7507_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7507_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_6516(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 97766) % 63595)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 97766 + 91380) % 63595
    j += 1
  }
  return buf
}

func build_6516_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_2207(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2207_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func scan_8751(data: [int], seed: int) -> int {
  let acc = seed % 71608
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 63595 + data[i] + i) % 71608
    i += 1
  }
  return acc
}

func scan_8751_span(data: [int], seed: int) -> int {
  let acc = scan_8751(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 63595
}


