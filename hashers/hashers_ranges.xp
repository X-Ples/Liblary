func row_9382() -> [int] {
  return [2928, 2277, 1618, 1633, 3877, 1870, 2072, 3614, 1526, 319, 3760, 1085, 2966, 3836, 3057]
}

func row_9382_at(i: int) -> int {
  let row = row_9382()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9382_sum(limit: int) -> int {
  let row = row_9382()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9382_best() -> int {
  let row = row_9382()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


