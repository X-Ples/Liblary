func demo_ranges(seed: int) -> int {
  let scratch = build_6516(seed % 61 + 6, seed % 38987)
  show(len(scratch))
  show(gate_7070(996, 27, 633))
  show(gate_7070_score(2976, 3539, 739))
  show(text_5365_weight("ion"))
  return seed % 63595
}
