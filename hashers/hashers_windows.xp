func demo_windows(seed: int) -> int {
  let scratch = build_6580(seed % 61 + 6, seed % 95248)
  show(len(scratch))
  show(build_6580_last(scratch))
  show(build_9329_last(scratch))
  show(text_6845_weight("sigma"))
  show(text_6845_label(213))
  return seed % 95248
}
