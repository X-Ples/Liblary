func check_8129(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 95248 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 64960) % 7774
    i += 1
  }
  return Ok(acc)
}

func check_8129_chain(n: int) -> int {
  let picked = check_8129(n)?
  return picked % 7774
}


