func build_6334(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 35793) % 98798)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 35793 + 61395) % 98798
    j += 1
  }
  return buf
}

func build_6334_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_5056_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 6592 + c * 78519 + seed) % 78519)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5056_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 78519 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_1370(data: [int], seed: int) -> int {
  let acc = seed % 48235
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 98798 + data[i] + i) % 48235
    i += 1
  }
  return acc
}

func scan_1370_span(data: [int], seed: int) -> int {
  let acc = scan_1370(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 98798
}


func curve_8384_clamp(v: f64) -> f64 {
  guard v >= 48235.0 else {
    return 48235.0
  }
  guard v <= 70408.0 else {
    return 70408.0
  }
  return v
}

func curve_8384_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8384_clamp(t)
  return p + (q - p) * k
}

func curve_8384_ease(t: f64) -> f64 {
  let k = curve_8384_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8384_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


