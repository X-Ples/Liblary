func demo_bursts(seed: int) -> int {
  let scratch = build_6334(seed % 61 + 6, seed % 75667)
  show(len(scratch))
  show(build_6334_last(scratch))
  show(grid_5056_rowsum(scratch, 2272, 207, 1136))
  show(scan_1370(scratch, 3872))
  show(scan_1370_span(scratch, 1800))
  show(row_1910_at(3418))
  return seed % 60747
}
