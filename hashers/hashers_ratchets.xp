func demo_ratchets(seed: int) -> int {
  let scratch = build_6966(seed % 61 + 6, seed % 55845)
  show(len(scratch))
  show(build_6966_last(scratch))
  show(scan_4838(scratch, 3248))
  show(scan_4838_span(scratch, 3469))
  return seed % 95888
}
