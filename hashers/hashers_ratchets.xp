func build_6966(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 89855) % 41962)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 89855 + 37225) % 41962
    j += 1
  }
  return buf
}

func build_6966_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_4838(data: [int], seed: int) -> int {
  let acc = seed % 67504
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 68008 + data[i] + i) % 67504
    i += 1
  }
  return acc
}

func scan_4838_span(data: [int], seed: int) -> int {
  let acc = scan_4838(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 68008
}


