func check_8738(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 99093 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 12218) % 38397
    i += 1
  }
  return Ok(acc)
}

func check_8738_chain(n: int) -> int {
  let picked = check_8738(n)?
  return picked % 38397
}


