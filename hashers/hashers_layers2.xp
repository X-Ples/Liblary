func sweep_5443(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 70023
  for i in lo..hi {
    if i % 38397 == 0 {
      acc += i * 22449
    } else {
      acc -= i % 96886
    }
    if acc < 0 {
      acc += 32089
    }
    acc = acc % 32089
  }
  return acc
}


