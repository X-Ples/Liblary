func demo_layers2(seed: int) -> int {
  let scratch = build_7168(seed % 61 + 6, seed % 81005)
  show(len(scratch))
  show(build_7168_last(scratch))
  show(order_3391_find(scratch, 3645))
  show(row_9927_at(2684))
  show(row_9927_sum(3890))
  show(row_9927_best())
  show(row_2334_at(133))
  return seed % 94345
}
