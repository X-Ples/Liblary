func check_6331(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 87268 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 66202) % 9893
    i += 1
  }
  return Ok(acc)
}

func check_6331_chain(n: int) -> int {
  let picked = check_6331(n)?
  return picked % 9893
}


