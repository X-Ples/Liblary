func build_4510(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 24259) % 87268)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 24259 + 67060) % 87268
    j += 1
  }
  return buf
}

func build_4510_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_152(data: [int], seed: int) -> int {
  let acc = seed % 24259
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 48492 + data[i] + i) % 24259
    i += 1
  }
  return acc
}

func scan_152_span(data: [int], seed: int) -> int {
  let acc = scan_152(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 48492
}


