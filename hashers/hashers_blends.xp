func row_7244() -> [int] {
  return [85, 3777, 543, 332, 717, 1862, 2827, 2736, 977, 986, 1792, 2325]
}

func row_7244_at(i: int) -> int {
  let row = row_7244()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7244_sum(limit: int) -> int {
  let row = row_7244()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7244_best() -> int {
  let row = row_7244()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


