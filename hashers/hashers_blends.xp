func demo_blends(seed: int) -> int {
  let scratch = build_4510(seed % 61 + 6, seed % 59890)
  show(len(scratch))
  show(build_4510_last(scratch))
  show(scan_152(scratch, 3798))
  show(scan_152_span(scratch, 3053))
  show(text_8544_weight("harbor"))
  show(text_8544_label(1627))
  return seed % 85798
}
