func demo_checks(seed: int) -> int {
  let scratch = build_3726(seed % 61 + 6, seed % 23954)
  show(len(scratch))
  show(build_3726_last(scratch))
  show(build_2118_last(scratch))
  show(order_2240_find(scratch, 2506))
  show(row_5055_at(1498))
