func order_2240(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2240_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func row_5055() -> [int] {
  return [2562, 2537, 646, 2523, 1054, 2487, 3849, 2083, 3095, 2822, 3865, 1690, 1257, 2704, 3815, 225, 3693, 3389, 401]
}

func row_5055_at(i: int) -> int {
  let row = row_5055()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5055_sum(limit: int) -> int {
  let row = row_5055()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5055_best() -> int {
  let row = row_5055()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_6707_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 45225
    i += 1
  }
  return acc % 45225
}

func text_6707_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "ember"
}

func text_6707_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 59435
}


