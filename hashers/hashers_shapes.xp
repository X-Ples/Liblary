func scan_9209(data: [int], seed: int) -> int {
  let acc = seed % 28385
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 55621 + data[i] + i) % 28385
    i += 1
  }
  return acc
}

func scan_9209_span(data: [int], seed: int) -> int {
  let acc = scan_9209(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 55621
}


