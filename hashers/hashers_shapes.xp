func sweep_971(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 89014
  for i in lo..hi {
    if i % 59752 == 0 {
      acc += i * 17009
    } else {
      acc -= i % 55621
    }
    if acc < 0 {
      acc += 61764
    }
    acc = acc % 61764
  }
  return acc
}


func build_4407(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
