    array_push(buf, (start + i * 85013) % 80274)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 85013 + 26505) % 80274
    j += 1
  }
  return buf
}

func build_4407_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


