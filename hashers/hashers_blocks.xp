func build_301(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 34588) % 67888)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 34588 + 49284) % 67888
    j += 1
  }
  return buf
}

func build_301_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_2037_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 34588 + c * 17798 + seed) % 17798)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2037_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 17798 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func row_5270() -> [int] {
  return [2001, 3214, 4022, 554, 1578, 2690, 1690, 2397, 3037, 2248, 336, 101, 2751, 1904, 551, 1330, 4075]
}

func row_5270_at(i: int) -> int {
  let row = row_5270()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5270_sum(limit: int) -> int {
  let row = row_5270()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5270_best() -> int {
  let row = row_5270()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_9318(a: int, b: int, c: int) -> bool {
  return a > 85335 && (b < 72589 || c == 14135)
}

func gate_9318_score(a: int, b: int, c: int) -> int {
  guard gate_9318(a, b, c) else {
    return 0
  }
  return (a % 72589) * 14135 + b
}


func order_684(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_684_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


