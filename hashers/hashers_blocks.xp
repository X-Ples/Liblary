func check_3855(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 16177 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 72589) % 52997
    i += 1
  }
  return Ok(acc)
}

func check_3855_chain(n: int) -> int {
  let picked = check_3855(n)?
  return picked % 52997
}


