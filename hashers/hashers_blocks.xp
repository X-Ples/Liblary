func sweep_9646(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 14135
  for i in lo..hi {
    if i % 66808 == 0 {
      acc += i * 13703
    } else {
      acc -= i % 72589
    }
    if acc < 0 {
      acc += 49284
    }
    acc = acc % 49284
  }
  return acc
}


func curve_1613_clamp(v: f64) -> f64 {
  guard v >= 76939.0 else {
    return 76939.0
  }
  guard v <= 80601.0 else {
    return 80601.0
  }
  return v
}

func curve_1613_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1613_clamp(t)
  return p + (q - p) * k
}

func curve_1613_ease(t: f64) -> f64 {
  let k = curve_1613_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1613_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_4127(data: [int], seed: int) -> int {
  let acc = seed % 66808
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 67888 + data[i] + i) % 66808
    i += 1
  }
  return acc
}

func scan_4127_span(data: [int], seed: int) -> int {
  let acc = scan_4127(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 67888
}


