func demo_blocks(seed: int) -> int {
  let scratch = build_301(seed % 61 + 6, seed % 85335)
  show(len(scratch))
  show(build_301_last(scratch))
  show(grid_2037_rowsum(scratch, 1678, 570, 3523))
  show(row_5270_at(2086))
  show(row_5270_sum(2318))
  return seed % 33955
}
