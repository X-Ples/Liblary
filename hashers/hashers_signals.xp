func demo_signals(seed: int) -> int {
  let scratch = build_2679(seed % 61 + 6, seed % 21713)
  show(len(scratch))
  show(build_2679_last(scratch))
  show(build_9613_last(scratch))
  show(gate_2080(3652, 1276, 1493))
  show(gate_2080_score(551, 3073, 2654))
  return seed % 5028
}
