func sweep_7698(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 21713
  for i in lo..hi {
    if i % 29456 == 0 {
      acc += i * 29456
    } else {
      acc -= i % 25197
    }
    if acc < 0 {
      acc += 90561
    }
    acc = acc % 90561
  }
  return acc
}


