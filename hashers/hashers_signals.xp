func check_9208(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 2795 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 67337) % 29456
    i += 1
  }
  return Ok(acc)
}

func check_9208_chain(n: int) -> int {
  let picked = check_9208(n)?
  return picked % 29456
}


