    return "delta"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "cargo"
}

func text_3470_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 87659
}


func curve_7033_clamp(v: f64) -> f64 {
  guard v >= 34907.0 else {
    return 34907.0
  }
  guard v <= 52600.0 else {
    return 52600.0
  }
  return v
}

func curve_7033_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7033_clamp(t)
  return p + (q - p) * k
}

func curve_7033_ease(t: f64) -> f64 {
  let k = curve_7033_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7033_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_9713(lo: int, hi: int) -> int {
