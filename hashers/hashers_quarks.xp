func demo_quarks(seed: int) -> int {
  let scratch = build_8724(seed % 61 + 6, seed % 87659)
  show(len(scratch))
  show(build_8724_last(scratch))
  show(order_5554_find(scratch, 1065))
  show(check_3263_chain(582))
  show(grid_2014_rowsum(scratch, 3287, 3495, 3821))
  return seed % 71916
}
