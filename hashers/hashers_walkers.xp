func demo_walkers(seed: int) -> int {
  let scratch = build_995(seed % 61 + 6, seed % 46517)
  show(len(scratch))
  show(build_995_last(scratch))
  show(text_1770_weight("cargo"))
  show(text_1770_label(1105))
  show(text_1770_has("lumen"))
  return seed % 8473
}
