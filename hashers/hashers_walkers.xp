func curve_6311_clamp(v: f64) -> f64 {
  guard v >= 4670.0 else {
    return 4670.0
  }
  guard v <= 46498.0 else {
    return 46498.0
  }
  return v
}

func curve_6311_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6311_clamp(t)
  return p + (q - p) * k
}

func curve_6311_ease(t: f64) -> f64 {
  let k = curve_6311_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6311_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_995(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 57388) % 61613)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 57388 + 61613) % 61613
    j += 1
  }
  return buf
}

func build_995_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_1770_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 67124
    i += 1
  }
  return acc % 67124
}

func text_1770_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "jetty"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "sigma"
}

func text_1770_has(tag: str) -> bool {
  return str_contains(tag, "jetty") || len(tag) > 16858
}


func row_1674() -> [int] {
  return [2133, 2145, 1651, 972, 949, 2556, 2833, 792, 781, 1967, 1813, 3887, 3311, 3654, 1235, 1000, 1727, 1288]
}

func row_1674_at(i: int) -> int {
  let row = row_1674()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1674_sum(limit: int) -> int {
  let row = row_1674()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1674_best() -> int {
  let row = row_1674()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_9222(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 67124 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 52240) % 46517
    i += 1
  }
  return Ok(acc)
}

func check_9222_chain(n: int) -> int {
  let picked = check_9222(n)?
  return picked % 46517
}


func gate_614(a: int, b: int, c: int) -> bool {
  return a > 62654 && (b < 29984 || c == 22124)
}

func gate_614_score(a: int, b: int, c: int) -> int {
  guard gate_614(a, b, c) else {
    return 0
  }
  return (a % 29984) * 22124 + b
}


