func build_4421(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 21644) % 53350)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 21644 + 87313) % 53350
    j += 1
  }
  return buf
}

func build_4421_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_721(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 37373 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 8546) % 62752
    i += 1
  }
  return Ok(acc)
}

func check_721_chain(n: int) -> int {
  let picked = check_721(n)?
  return picked % 62752
}


func scan_3568(data: [int], seed: int) -> int {
  let acc = seed % 46884
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 53350 + data[i] + i) % 46884
    i += 1
  }
  return acc
}

func scan_3568_span(data: [int], seed: int) -> int {
  let acc = scan_3568(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 53350
}


func row_8965() -> [int] {
  return [3288, 3272, 1229, 1319, 1481, 182, 438, 3779, 3062, 1462, 1548, 329, 2615, 2756]
}

func row_8965_at(i: int) -> int {
  let row = row_8965()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8965_sum(limit: int) -> int {
  let row = row_8965()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8965_best() -> int {
  let row = row_8965()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_7655(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7655_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func grid_9491_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 21032 + c * 53350 + seed) % 53350)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9491_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 53350 == want {
      total += acc
    }
    r += 1
  }
  return total
}


