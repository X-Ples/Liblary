func sweep_2078(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 4998
  for i in lo..hi {
    if i % 42813 == 0 {
      acc += i * 78387
    } else {
      acc -= i % 42813
    }
    if acc < 0 {
      acc += 48848
    }
    acc = acc % 48848
  }
  return acc
}


