func gate_4258(a: int, b: int, c: int) -> bool {
  return a > 22062 && (b < 79702 || c == 87313)
}

func gate_4258_score(a: int, b: int, c: int) -> int {
  guard gate_4258(a, b, c) else {
    return 0
  }
  return (a % 79702) * 87313 + b
}


