func text_6483_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "harbor"
}

func text_6483_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 37373
}


