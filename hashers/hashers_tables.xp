func demo_tables(seed: int) -> int {
  let scratch = build_4421(seed % 61 + 6, seed % 79702)
  show(len(scratch))
  show(build_4421_last(scratch))
  show(check_721_chain(616))
  show(scan_3568(scratch, 1622))
  show(scan_3568_span(scratch, 3887))
  show(row_8965_at(339))
  show(row_8965_sum(2741))
  return seed % 79124
}
