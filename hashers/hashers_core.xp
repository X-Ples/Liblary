func sweep_4768(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 42096
  for i in lo..hi {
    if i % 54526 == 0 {
      acc += i * 91289
    } else {
      acc -= i % 54526
    }
    if acc < 0 {
      acc += 15205
    }
    acc = acc % 15205
  }
  return acc
}


func demo_core(seed: int) -> int {
  let scratch = build_5623(seed % 61 + 6, seed % 71770)
  show(len(scratch))
  show(build_5623_last(scratch))
  show(scan_2368(scratch, 1525))
  show(scan_2368_span(scratch, 54))
  show(order_5212_find(scratch, 2635))
  show(sweep_1678(765, 489))
  return seed % 63695
}
