func build_7797(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 35949) % 35949)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 35949 + 31134) % 35949
    j += 1
  }
  return buf
}

func build_7797_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_7492() -> [int] {
  return [462, 345, 2788, 405, 3671, 3533, 996, 2789, 3440, 2146, 2102, 3830, 545, 839, 1784, 470, 355, 3071, 2366]
}

func row_7492_at(i: int) -> int {
  let row = row_7492()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7492_sum(limit: int) -> int {
  let row = row_7492()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7492_best() -> int {
  let row = row_7492()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_9522_clamp(v: f64) -> f64 {
  guard v >= 49193.0 else {
    return 49193.0
  }
  guard v <= 89359.0 else {
    return 89359.0
  }
  return v
}

func curve_9522_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9522_clamp(t)
  return p + (q - p) * k
}

func curve_9522_ease(t: f64) -> f64 {
  let k = curve_9522_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9522_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_5525_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 31134
    i += 1
  }
  return acc % 31134
}

func text_5525_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "flint"
}

func text_5525_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 94423
}


