func text_9009_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 23927
    i += 1
  }
  return acc % 23927
}

func text_9009_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ridge"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "prism"
}

func text_9009_has(tag: str) -> bool {
  return str_contains(tag, "ridge") || len(tag) > 73251
}


