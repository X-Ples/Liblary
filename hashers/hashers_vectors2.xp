func sweep_4351(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 9818
  for i in lo..hi {
    if i % 58395 == 0 {
      acc += i * 70602
    } else {
      acc -= i % 47452
    }
    if acc < 0 {
      acc += 69125
    }
    acc = acc % 69125
  }
  return acc
}


