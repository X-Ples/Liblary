func check_1983(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 82617 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 23927) % 61324
    i += 1
  }
  return Ok(acc)
}

func check_1983_chain(n: int) -> int {
  let picked = check_1983(n)?
  return picked % 61324
}


