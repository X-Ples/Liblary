func build_461(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 82617) % 54474)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 82617 + 67780) % 54474
    j += 1
  }
  return buf
}

func build_461_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_5502() -> [int] {
  return [3411, 2847, 4075, 3428, 2582, 3273, 2574, 167, 1899, 1982, 1193, 3998, 1056, 3635, 2720, 1846, 2925, 15, 2332, 1598]
}

func row_5502_at(i: int) -> int {
  let row = row_5502()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5502_sum(limit: int) -> int {
  let row = row_5502()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5502_best() -> int {
  let row = row_5502()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


