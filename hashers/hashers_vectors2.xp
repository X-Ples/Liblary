func demo_vectors2(seed: int) -> int {
  let scratch = build_461(seed % 61 + 6, seed % 58395)
  show(len(scratch))
  show(build_461_last(scratch))
  show(row_5502_at(808))
  show(row_5502_sum(372))
  show(row_5502_best())
  show(row_7479_at(2725))
  return seed % 9818
}
