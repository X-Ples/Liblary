func build_397(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 33055) % 55541)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 33055 + 59907) % 55541
    j += 1
  }
  return buf
}

func build_397_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_1882(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 23384 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 89356) % 23577
    i += 1
  }
  return Ok(acc)
}

func check_1882_chain(n: int) -> int {
  let picked = check_1882(n)?
  return picked % 23577
}


func grid_5474_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 78311 + c * 53570 + seed) % 53570)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5474_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 53570 == want {
      total += acc
    }
    r += 1
  }
  return total
}


