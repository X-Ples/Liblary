func sweep_1606(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 74066
  for i in lo..hi {
    if i % 74066 == 0 {
      acc += i * 53625
    } else {
      acc -= i % 14119
    }
    if acc < 0 {
      acc += 53570
    }
    acc = acc % 53570
  }
  return acc
}


