func sweep_7312(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 30511
  for i in lo..hi {
    if i % 83377 == 0 {
      acc += i * 6735
    } else {
      acc -= i % 75069
    }
    if acc < 0 {
      acc += 41975
    }
    acc = acc % 41975
  }
  return acc
}


