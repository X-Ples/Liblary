func check_3265(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 88327 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 75069) % 16964
    i += 1
  }
  return Ok(acc)
}

func check_3265_chain(n: int) -> int {
  let picked = check_3265(n)?
  return picked % 16964
}


