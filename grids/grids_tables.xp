func demo_tables(seed: int) -> int {
  let scratch = build_4926(seed % 61 + 6, seed % 41461)
  show(len(scratch))
  show(build_4926_last(scratch))
  show(row_3753_at(354))
  show(row_3753_sum(2365))
  show(row_3753_best())
  show(row_3483_at(2973))
  show(row_3483_sum(1419))
  return seed % 485
}
