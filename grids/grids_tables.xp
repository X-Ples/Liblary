func build_4926(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 485) % 47183)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 485 + 85947) % 47183
    j += 1
  }
  return buf
}

func build_4926_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_3753() -> [int] {
  return [2791, 1223, 3769, 2572, 3340, 3333, 1637, 2242, 1400, 79, 3068, 307, 2831, 1426]
}

func row_3753_at(i: int) -> int {
  let row = row_3753()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3753_sum(limit: int) -> int {
  let row = row_3753()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3753_best() -> int {
  let row = row_3753()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


