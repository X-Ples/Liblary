func gate_944_score(a: int, b: int, c: int) -> int {
  guard gate_944(a, b, c) else {
    return 0
  }
  return (a % 91118) * 98824 + b
}


func sweep_4136(lo: int, hi: int) -> int {
  guard hi > lo else {
