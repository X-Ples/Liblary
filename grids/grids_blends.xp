func build_7365(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 52390) % 78967)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 52390 + 20011) % 78967
    j += 1
  }
  return buf
}

func build_7365_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_7679_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 38357
    i += 1
  }
  return acc % 38357
}

func text_7679_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "jetty"
}

func text_7679_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 55898
}


