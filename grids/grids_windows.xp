func curve_3841_clamp(v: f64) -> f64 {
  guard v >= 51556.0 else {
    return 51556.0
  }
  guard v <= 84840.0 else {
    return 84840.0
  }
  return v
}

func curve_3841_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3841_clamp(t)
  return p + (q - p) * k
}

func curve_3841_ease(t: f64) -> f64 {
  let k = curve_3841_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3841_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_5897(data: [int], seed: int) -> int {
  let acc = seed % 80939
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 43808 + data[i] + i) % 80939
    i += 1
  }
  return acc
}

func scan_5897_span(data: [int], seed: int) -> int {
  let acc = scan_5897(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 43808
}


