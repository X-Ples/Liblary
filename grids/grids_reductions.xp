func demo_reductions(seed: int) -> int {
  let scratch = build_5794(seed % 61 + 6, seed % 93428)
  show(len(scratch))
  show(build_5794_last(scratch))
  show(grid_3200_rowsum(scratch, 741, 2415, 3589))
  show(scan_7720(scratch, 1478))
  show(scan_7720_span(scratch, 3405))
  show(scan_1111(scratch, 2976))
  show(scan_1111_span(scratch, 2030))
  return seed % 18084
}
