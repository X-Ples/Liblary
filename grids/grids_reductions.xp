func row_2298() -> [int] {
  return [3495, 106, 1085, 2444, 246, 1601, 3551, 3474, 1026, 3057, 2895, 3754, 1846, 3637, 3886, 2206, 345]
}

func row_2298_at(i: int) -> int {
  let row = row_2298()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2298_sum(limit: int) -> int {
  let row = row_2298()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2298_best() -> int {
  let row = row_2298()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


