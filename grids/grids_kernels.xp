func sweep_5282(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 60484
  for i in lo..hi {
    if i % 41564 == 0 {
      acc += i * 1622
    } else {
      acc -= i % 95252
    }
    if acc < 0 {
      acc += 89828
    }
    acc = acc % 89828
  }
  return acc
}


