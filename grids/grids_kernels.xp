const K0 = 21248
const K1 = 1622
const K2 = 3068
const K3 = 58574
const K4 = 38032
const K5 = 7961

func build_4823(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 84414) % 85923)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 84414 + 21248) % 85923
    j += 1
  }
  return buf
}

func build_4823_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_1031_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 84414 + c * 67799 + seed) % 67799)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1031_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 67799 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func check_2585(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 67799 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 1622) % 95252
    i += 1
  }
  return Ok(acc)
}

func check_2585_chain(n: int) -> int {
  let picked = check_2585(n)?
  return picked % 95252
}


func text_2699_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 55291
    i += 1
  }
  return acc % 55291
}

func text_2699_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "nova"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "kilo"
}

func text_2699_has(tag: str) -> bool {
  return str_contains(tag, "nova") || len(tag) > 92914
}


