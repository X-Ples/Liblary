func scan_5000(data: [int], seed: int) -> int {
  let acc = seed % 7427
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 84414 + data[i] + i) % 7427
    i += 1
  }
  return acc
}

