func curve_8558_clamp(v: f64) -> f64 {
  guard v >= 1622.0 else {
    return 1622.0
  }
  guard v <= 43035.0 else {
    return 43035.0
  }
  return v
}

func curve_8558_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8558_clamp(t)
  return p + (q - p) * k
}

func curve_8558_ease(t: f64) -> f64 {
  let k = curve_8558_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8558_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_kernels(seed: int) -> int {
  let scratch = build_4823(seed % 61 + 6, seed % 85923)
  show(len(scratch))
  show(build_4823_last(scratch))
  show(grid_1031_rowsum(scratch, 309, 2181, 437))
  show(check_2585_chain(3902))
  show(text_2699_weight("nova"))
  return seed % 81715
}
