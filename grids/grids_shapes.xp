func demo_shapes(seed: int) -> int {
  let scratch = build_5236(seed % 61 + 6, seed % 95561)
  show(len(scratch))
  show(build_5236_last(scratch))
  show(scan_1095(scratch, 2890))
  show(scan_1095_span(scratch, 3159))
  show(sweep_4992(3115, 3626))
  show(sweep_5056(3794, 1244))
  return seed % 30476
}
