func build_5236(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 30476) % 95561)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 30476 + 65747) % 95561
    j += 1
  }
  return buf
}

func build_5236_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_1095(data: [int], seed: int) -> int {
  let acc = seed % 46927
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 26105 + data[i] + i) % 46927
    i += 1
  }
  return acc
}

func scan_1095_span(data: [int], seed: int) -> int {
  let acc = scan_1095(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 26105
}


func sweep_4992(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 26105
  for i in lo..hi {
    if i % 64368 == 0 {
      acc += i * 88191
    } else {
      acc -= i % 76477
    }
    if acc < 0 {
      acc += 46927
    }
    acc = acc % 46927
  }
  return acc
}


