func check_8044(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 64368 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 10864) % 94682
    i += 1
  }
  return Ok(acc)
}

func check_8044_chain(n: int) -> int {
  let picked = check_8044(n)?
  return picked % 94682
}


