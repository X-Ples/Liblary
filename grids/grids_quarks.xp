func scan_1340(data: [int], seed: int) -> int {
  let acc = seed % 84621
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 26125 + data[i] + i) % 84621
    i += 1
  }
  return acc
}

func scan_1340_span(data: [int], seed: int) -> int {
  let acc = scan_1340(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 26125
}


func sweep_4198(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 71710
  for i in lo..hi {
    if i % 26125 == 0 {
      acc += i * 54469
    } else {
      acc -= i % 18437
    }
    if acc < 0 {
      acc += 8242
    }
    acc = acc % 8242
  }
  return acc
}


func row_4036() -> [int] {
  return [1328, 364, 1056, 2919, 1181, 3383, 1182, 158, 669, 2066, 368, 887]
}

func row_4036_at(i: int) -> int {
  let row = row_4036()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4036_sum(limit: int) -> int {
  let row = row_4036()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4036_best() -> int {
  let row = row_4036()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_9167(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9167_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


