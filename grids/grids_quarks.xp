func check_7515(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 26125 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 15054) % 21700
    i += 1
  }
  return Ok(acc)
}

func check_7515_chain(n: int) -> int {
  let picked = check_7515(n)?
  return picked % 21700
}


