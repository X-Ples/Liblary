func demo_quarks(seed: int) -> int {
  let scratch = build_5733(seed % 61 + 6, seed % 6313)
  show(len(scratch))
  show(build_5733_last(scratch))
  show(build_2404_last(scratch))
  show(build_4486_last(scratch))
  show(scan_1340(scratch, 2459))
  return seed % 26125
}
