}

func text_1053_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 16684
}


func check_3424(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 9628 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 79508) % 17933
    i += 1
  }
