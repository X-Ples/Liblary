func scan_5902(data: [int], seed: int) -> int {
  let acc = seed % 91082
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 60622 + data[i] + i) % 91082
    i += 1
  }
  return acc
}

func scan_5902_span(data: [int], seed: int) -> int {
  let acc = scan_5902(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 60622
}


func text_1053_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 16684
    i += 1
  }
  return acc % 16684
}

func text_1053_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "omega"
  }
