func row_7265() -> [int] {
  return [433, 1988, 142, 4003, 312, 3359, 3592, 815, 2573, 1199, 3288, 3116, 3354, 2456, 1047, 2018, 2487, 3155, 3806, 3628, 4055]
}

func row_7265_at(i: int) -> int {
  let row = row_7265()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7265_sum(limit: int) -> int {
  let row = row_7265()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7265_best() -> int {
  let row = row_7265()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


