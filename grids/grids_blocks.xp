func text_4800_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 92777
    i += 1
  }
  return acc % 92777
}

func text_4800_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "gamma"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "lumen"
}

func text_4800_has(tag: str) -> bool {
  return str_contains(tag, "gamma") || len(tag) > 35388
}


