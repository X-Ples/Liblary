func build_4801(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 16505) % 2627)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 16505 + 92777) % 2627
    j += 1
  }
  return buf
}

func build_4801_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_8099(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 16505
  for i in lo..hi {
    if i % 21100 == 0 {
      acc += i * 41951
    } else {
      acc -= i % 30728
    }
    if acc < 0 {
      acc += 82171
    }
    acc = acc % 82171
  }
  return acc
}


func scan_9005(data: [int], seed: int) -> int {
  let acc = seed % 90006
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 16505 + data[i] + i) % 90006
    i += 1
  }
  return acc
}

func scan_9005_span(data: [int], seed: int) -> int {
  let acc = scan_9005(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 16505
}


func curve_1805_clamp(v: f64) -> f64 {
  guard v >= 14648.0 else {
    return 14648.0
  }
  guard v <= 69943.0 else {
    return 69943.0
  }
  return v
}

func curve_1805_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1805_clamp(t)
  return p + (q - p) * k
}

func curve_1805_ease(t: f64) -> f64 {
  let k = curve_1805_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1805_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_5214(a: int, b: int, c: int) -> bool {
  return a > 2627 && (b < 26508 || c == 39045)
}

func gate_5214_score(a: int, b: int, c: int) -> int {
  guard gate_5214(a, b, c) else {
    return 0
  }
  return (a % 26508) * 39045 + b
}


func order_4354(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_4354_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


