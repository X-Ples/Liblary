func check_1963(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 17363 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 28879) % 82171
    i += 1
  }
  return Ok(acc)
}

func check_1963_chain(n: int) -> int {
  let picked = check_1963(n)?
  return picked % 82171
}


