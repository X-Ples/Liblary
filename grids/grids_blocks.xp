const K0 = 488
const K1 = 69943
const K2 = 8172
const K3 = 82171
const K4 = 14648
const K5 = 2627

func grid_163_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 6970 + c * 32091 + seed) % 32091)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_163_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 32091 == want {
      total += acc
    }
    r += 1
  }
  return total
}


