func demo_blocks(seed: int) -> int {
  let scratch = build_4801(seed % 61 + 6, seed % 26508)
  show(len(scratch))
  show(grid_163_rowsum(scratch, 3620, 2661, 2839))
  show(grid_3275_rowsum(scratch, 778, 2073, 93))
  show(build_4801_last(scratch))
  show(sweep_8099(2369, 203))
  return seed % 14648
}
