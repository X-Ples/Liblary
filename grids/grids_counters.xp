func scan_9785(data: [int], seed: int) -> int {
  let acc = seed % 99467
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 91370 + data[i] + i) % 99467
    i += 1
  }
  return acc
}

func scan_9785_span(data: [int], seed: int) -> int {
  let acc = scan_9785(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 91370
}


