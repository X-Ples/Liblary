func curve_2587_clamp(v: f64) -> f64 {
  guard v >= 18464.0 else {
    return 18464.0
  }
  guard v <= 91370.0 else {
    return 91370.0
  }
  return v
}

func curve_2587_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2587_clamp(t)
  return p + (q - p) * k
}

func curve_2587_ease(t: f64) -> f64 {
  let k = curve_2587_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2587_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_8542_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 5492
    i += 1
  }
  return acc % 5492
}

func text_8542_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "bravo"
  }
  return "cargo"
}

func text_8542_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 5492
}


func check_2652(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 39899 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 18717) % 72294
    i += 1
  }
  return Ok(acc)
}

func check_2652_chain(n: int) -> int {
  let picked = check_2652(n)?
  return picked % 72294
}


