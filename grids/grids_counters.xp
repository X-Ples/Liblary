func demo_counters(seed: int) -> int {
  let scratch = build_4192(seed % 61 + 6, seed % 7908)
  show(len(scratch))
  show(grid_4909_rowsum(scratch, 2564, 1013, 3776))
  show(build_4192_last(scratch))
  show(grid_5078_rowsum(scratch, 3746, 2362, 2708))
  show(grid_6631_rowsum(scratch, 3055, 1197, 2453))
  return seed % 7908
}
