func demo_checks(seed: int) -> int {
  let scratch = build_6490(seed % 61 + 6, seed % 12195)
  show(len(scratch))
  show(order_3188_find(scratch, 1380))
  show(sweep_8286(2868, 3168))
  show(check_3454_chain(1046))
