const K9 = 27186

func order_3188(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3188_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_8286(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 98784
  for i in lo..hi {
    if i % 41075 == 0 {
      acc += i * 41075
    } else {
      acc -= i % 13382
    }
    if acc < 0 {
      acc += 12195
    }
    acc = acc % 12195
  }
  return acc
}


func curve_2915_clamp(v: f64) -> f64 {
  guard v >= 41075.0 else {
    return 41075.0
  }
  guard v <= 50945.0 else {
    return 50945.0
  }
  return v
}

func curve_2915_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2915_clamp(t)
  return p + (q - p) * k
}

func curve_2915_ease(t: f64) -> f64 {
  let k = curve_2915_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2915_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_3454(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 47598 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 68703) % 23394
    i += 1
  }
  return Ok(acc)
}

func check_3454_chain(n: int) -> int {
  let picked = check_3454(n)?
  return picked % 23394
}


func row_5554() -> [int] {
  return [3684, 3827, 4041, 3072, 218, 1454, 2823, 132, 3498, 45, 2994, 1576]
}

func row_5554_at(i: int) -> int {
  let row = row_5554()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5554_sum(limit: int) -> int {
  let row = row_5554()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5554_best() -> int {
  let row = row_5554()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_1072_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 9196 + c * 21106 + seed) % 21106)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1072_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 21106 == want {
      total += acc
    }
    r += 1
  }
  return total
}


