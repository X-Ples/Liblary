func build_6490(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 12195) % 59578)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 12195 + 23394) % 59578
    j += 1
  }
  return buf
}

func build_6490_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_4532_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 9196
    i += 1
  }
  return acc % 9196
}

func text_4532_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "prism"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "ember"
}

func text_4532_has(tag: str) -> bool {
  return str_contains(tag, "prism") || len(tag) > 50945
}


