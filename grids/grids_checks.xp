func scan_3298(data: [int], seed: int) -> int {
  let acc = seed % 47339
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 86132 + data[i] + i) % 47339
    i += 1
  }
  return acc
}

