func build_5255(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 57479) % 42819)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 57479 + 32949) % 42819
    j += 1
  }
  return buf
}

func build_5255_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_7597(data: [int], seed: int) -> int {
  let acc = seed % 32949
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 98080 + data[i] + i) % 32949
    i += 1
  }
  return acc
}

func scan_7597_span(data: [int], seed: int) -> int {
  let acc = scan_7597(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 98080
}


