func demo_offsets(seed: int) -> int {
  let scratch = build_5255(seed % 61 + 6, seed % 41588)
  show(len(scratch))
  show(grid_9332_rowsum(scratch, 2694, 2612, 1656))
  show(grid_6006_rowsum(scratch, 422, 2571, 1621))
