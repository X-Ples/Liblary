func check_1431(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 57479 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 35047) % 33302
    i += 1
  }
  return Ok(acc)
}

func check_1431_chain(n: int) -> int {
  let picked = check_1431(n)?
  return picked % 33302
}


