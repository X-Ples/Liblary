func text_5261_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 62167
    i += 1
  }
  return acc % 62167
}

func text_5261_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "quartz"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "ember"
}

func text_5261_has(tag: str) -> bool {
  return str_contains(tag, "quartz") || len(tag) > 62167
}


func scan_9391(data: [int], seed: int) -> int {
  let acc = seed % 44848
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 83368 + data[i] + i) % 44848
    i += 1
  }
  return acc
}

func scan_9391_span(data: [int], seed: int) -> int {
  let acc = scan_9391(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 83368
}


func build_2863(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 33309) % 53598)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 33309 + 62167) % 53598
    j += 1
  }
  return buf
}

func build_2863_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_1330_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 33309 + c * 44848 + seed) % 44848)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1330_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 44848 == want {
      total += acc
    }
    r += 1
  }
  return total
}


