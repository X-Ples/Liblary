func sweep_9690(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 76213
  for i in lo..hi {
    if i % 55787 == 0 {
      acc += i * 33309
    } else {
      acc -= i % 92800
    }
    if acc < 0 {
      acc += 92800
    }
    acc = acc % 92800
  }
  return acc
}


func check_3376(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 76213 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 33309) % 98472
    i += 1
  }
  return Ok(acc)
}

func check_3376_chain(n: int) -> int {
  let picked = check_3376(n)?
  return picked % 98472
}


