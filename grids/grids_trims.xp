func gate_3500(a: int, b: int, c: int) -> bool {
  return a > 95287 && (b < 64422 || c == 28756)
}

func gate_3500_score(a: int, b: int, c: int) -> int {
  guard gate_3500(a, b, c) else {
    return 0
  }
  return (a % 64422) * 28756 + b
}


