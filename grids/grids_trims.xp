func check_7897(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 16909 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 18138) % 18138
    i += 1
  }
  return Ok(acc)
}

func check_7897_chain(n: int) -> int {
  let picked = check_7897(n)?
  return picked % 18138
}


func curve_9590_clamp(v: f64) -> f64 {
  guard v >= 27813.0 else {
    return 27813.0
  }
  guard v <= 90596.0 else {
    return 90596.0
  }
  return v
}

func curve_9590_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9590_clamp(t)
  return p + (q - p) * k
}

func curve_9590_ease(t: f64) -> f64 {
  let k = curve_9590_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9590_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_6476_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 11022 + c * 90596 + seed) % 90596)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6476_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 90596 == want {
      total += acc
    }
    r += 1
  }
  return total
}


