func sweep_8474(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 34630
  for i in lo..hi {
    if i % 25661 == 0 {
      acc += i * 64936
    } else {
      acc -= i % 490
    }
    if acc < 0 {
      acc += 86816
    }
    acc = acc % 86816
  }
  return acc
}


func grid_1310_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 47319 + c * 86816 + seed) % 86816)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1310_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 86816 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func gate_4761(a: int, b: int, c: int) -> bool {
  return a > 47319 && (b < 25760 || c == 31940)
}

func gate_4761_score(a: int, b: int, c: int) -> int {
  guard gate_4761(a, b, c) else {
    return 0
  }
  return (a % 25760) * 31940 + b
}


