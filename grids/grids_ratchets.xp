func demo_ratchets(seed: int) -> int {
  let scratch = build_1029(seed % 61 + 6, seed % 25639)
  show(len(scratch))
  show(build_1029_last(scratch))
  show(order_5819_find(scratch, 3656))
  show(order_5607_find(scratch, 2862))
  show(sweep_8474(2952, 3027))
  show(grid_1310_rowsum(scratch, 2115, 145, 2084))
  return seed % 22165
}
