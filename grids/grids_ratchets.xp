func check_5881(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 93722 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 15437) % 37745
    i += 1
  }
  return Ok(acc)
}

func check_5881_chain(n: int) -> int {
  let picked = check_5881(n)?
  return picked % 37745
}


func scan_2142(data: [int], seed: int) -> int {
  let acc = seed % 2813
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 92065 + data[i] + i) % 2813
    i += 1
  }
  return acc
}

func scan_2142_span(data: [int], seed: int) -> int {
  let acc = scan_2142(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 92065
}


func curve_7418_clamp(v: f64) -> f64 {
  guard v >= 34072.0 else {
    return 34072.0
  }
  guard v <= 47319.0 else {
    return 47319.0
  }
  return v
}

func curve_7418_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7418_clamp(t)
  return p + (q - p) * k
}

func curve_7418_ease(t: f64) -> f64 {
  let k = curve_7418_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7418_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


