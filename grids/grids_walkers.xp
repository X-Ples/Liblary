const K0 = 55180
const K1 = 78776
const K2 = 20226
const K3 = 1631
const K4 = 72924
const K5 = 78776
const K6 = 20226

func order_8000(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8000_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_6489(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 9377) % 46081)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 9377 + 78776) % 46081
    j += 1
  }
  return buf
}

func build_6489_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_9611_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 47193
    i += 1
  }
  return acc % 47193
}

func text_9611_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "ember"
}

func text_9611_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 55180
}


func sweep_9542(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 99884
  for i in lo..hi {
    if i % 41455 == 0 {
      acc += i * 86396
    } else {
      acc -= i % 99884
    }
    if acc < 0 {
      acc += 72924
    }
    acc = acc % 72924
  }
  return acc
}


