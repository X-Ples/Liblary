func check_6127(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 56416 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 85079) % 20853
    i += 1
  }
  return Ok(acc)
}

func check_6127_chain(n: int) -> int {
  let picked = check_6127(n)?
  return picked % 20853
}


