func curve_6993_clamp(v: f64) -> f64 {
  guard v >= 26064.0 else {
    return 26064.0
  }
  guard v <= 72924.0 else {
    return 72924.0
  }
  return v
}

func curve_6993_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6993_clamp(t)
  return p + (q - p) * k
}

func curve_6993_ease(t: f64) -> f64 {
  let k = curve_6993_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6993_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_8015() -> [int] {
  return [2049, 3174, 1638, 1595, 3215, 3453, 3192, 1707, 2731, 3377, 2044, 1766, 488, 2109, 2215, 2515, 388, 2781, 1987]
}

func row_8015_at(i: int) -> int {
  let row = row_8015()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8015_sum(limit: int) -> int {
  let row = row_8015()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8015_best() -> int {
  let row = row_8015()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func gate_893(a: int, b: int, c: int) -> bool {
  return a > 7244 && (b < 876 || c == 99884)
}

func gate_893_score(a: int, b: int, c: int) -> int {
  guard gate_893(a, b, c) else {
    return 0
  }
  return (a % 876) * 99884 + b
}


