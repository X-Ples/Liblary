func demo_walkers(seed: int) -> int {
  let scratch = build_6489(seed % 61 + 6, seed % 47193)
  show(len(scratch))
  show(order_8000_find(scratch, 1344))
  show(build_6489_last(scratch))
  show(text_9611_weight("alpha"))
  show(text_9611_label(1182))
  show(text_9611_has("ion"))
  return seed % 876
}
