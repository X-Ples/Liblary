func demo_twists(seed: int) -> int {
  let scratch = build_2980(seed % 61 + 6, seed % 58033)
  show(len(scratch))
  show(build_2980_last(scratch))
  show(scan_3364(scratch, 2574))
  show(scan_3364_span(scratch, 3009))
  show(check_274_chain(312))
  show(order_2924_find(scratch, 3356))
  return seed % 58863
}
