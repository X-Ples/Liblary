func check_5551(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 91805 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 7678) % 23111
    i += 1
  }
  return Ok(acc)
}

func check_5551_chain(n: int) -> int {
  let picked = check_5551(n)?
  return picked % 23111
}


