func scan_8964(data: [int], seed: int) -> int {
  let acc = seed % 53709
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 73137 + data[i] + i) % 53709
    i += 1
