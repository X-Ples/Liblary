func demo_helpers(seed: int) -> int {
  let scratch = build_8162(seed % 61 + 6, seed % 60032)
  show(len(scratch))
  show(order_1638_find(scratch, 1503))
  show(row_7494_at(765))
  show(row_7494_sum(2485))
  show(row_7494_best())
  show(grid_5849_rowsum(scratch, 3744, 685, 1018))
  return seed % 23111
}
