const K0 = 48233
const K1 = 91886
const K2 = 23111
const K3 = 91805
const K4 = 57431
const K5 = 35019

func order_1638(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1638_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func row_7494() -> [int] {
  return [776, 660, 2037, 102, 241, 2619, 2468, 4002, 3231, 3569, 3948, 713, 3302, 108, 1050, 3389, 2498, 1157]
}

func row_7494_at(i: int) -> int {
  let row = row_7494()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7494_sum(limit: int) -> int {
  let row = row_7494()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7494_best() -> int {
  let row = row_7494()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func grid_5849_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 92959 + c * 97194 + seed) % 97194)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5849_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 97194 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func curve_4313_clamp(v: f64) -> f64 {
  guard v >= 45484.0 else {
    return 45484.0
  }
  guard v <= 91886.0 else {
    return 91886.0
  }
  return v
}

func curve_4313_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4313_clamp(t)
  return p + (q - p) * k
}

func curve_4313_ease(t: f64) -> f64 {
  let k = curve_4313_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4313_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


