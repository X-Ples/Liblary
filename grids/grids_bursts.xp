func grid_4833_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 21261 + c * 98633 + seed) % 98633)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4833_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 98633 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_3562_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 15530
    i += 1
  }
  return acc % 15530
}

func text_3562_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "ridge"
}

func text_3562_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 18319
}


