func row_8448() -> [int] {
  return [1368, 2955, 3319, 460, 1314, 3534, 439, 372, 1932, 693, 3486, 2104, 669, 303, 2105]
}

func row_8448_at(i: int) -> int {
  let row = row_8448()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8448_sum(limit: int) -> int {
  let row = row_8448()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8448_best() -> int {
  let row = row_8448()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func build_173(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 52253) % 22497)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 52253 + 29654) % 22497
    j += 1
  }
  return buf
}

func build_173_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_6180_clamp(v: f64) -> f64 {
  guard v >= 76933.0 else {
    return 76933.0
  }
  guard v <= 99712.0 else {
    return 99712.0
  }
  return v
}

func curve_6180_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6180_clamp(t)
  return p + (q - p) * k
}

func curve_6180_ease(t: f64) -> f64 {
  let k = curve_6180_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6180_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_8668(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 6772 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 6772) % 61592
    i += 1
  }
  return Ok(acc)
}

func check_8668_chain(n: int) -> int {
  let picked = check_8668(n)?
  return picked % 61592
}


