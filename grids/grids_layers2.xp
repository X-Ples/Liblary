func demo_layers2(seed: int) -> int {
  let scratch = build_2047(seed % 61 + 6, seed % 94766)
  show(len(scratch))
  show(gate_3250(241, 3026, 3044))
  show(gate_3250_score(1106, 1901, 3298))
  show(build_2047_last(scratch))
  show(check_8727_chain(3654))
