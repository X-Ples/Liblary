func gate_3250(a: int, b: int, c: int) -> bool {
  return a > 94766 && (b < 60987 || c == 5434)
}

func gate_3250_score(a: int, b: int, c: int) -> int {
  guard gate_3250(a, b, c) else {
    return 0
  }
  return (a % 60987) * 5434 + b
}


func build_2047(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 70048) % 37463)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 70048 + 88707) % 37463
    j += 1
  }
  return buf
}

func build_2047_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_8727(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 28710 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 83574) % 81938
    i += 1
  }
  return Ok(acc)
}

func check_8727_chain(n: int) -> int {
  let picked = check_8727(n)?
  return picked % 81938
}


func sweep_5016(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 11960
  for i in lo..hi {
    if i % 81938 == 0 {
      acc += i * 94766
    } else {
      acc -= i % 70585
    }
    if acc < 0 {
      acc += 31222
    }
    acc = acc % 31222
  }
  return acc
}


