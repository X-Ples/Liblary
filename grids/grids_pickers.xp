func row_6301() -> [int] {
  return [791, 2687, 1559, 925, 2660, 2366, 3393, 1154, 2437, 1353, 1807, 3382, 1904, 827, 2861, 2957]
}

func row_6301_at(i: int) -> int {
  let row = row_6301()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6301_sum(limit: int) -> int {
  let row = row_6301()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6301_best() -> int {
  let row = row_6301()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_8223(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 57640 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 88645) % 88036
    i += 1
  }
  return Ok(acc)
}

func check_8223_chain(n: int) -> int {
  let picked = check_8223(n)?
  return picked % 88036
}


