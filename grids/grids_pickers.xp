  let acc = 42807
  for i in lo..hi {
    if i % 47654 == 0 {
      acc += i * 84985
    } else {
      acc -= i % 43078
    }
    if acc < 0 {
      acc += 83530
    }
    acc = acc % 83530
  }
  return acc
}


