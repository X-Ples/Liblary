func check_3949(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 47698 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 60725) % 52858
    i += 1
  }
  return Ok(acc)
}

func check_3949_chain(n: int) -> int {
  let picked = check_3949(n)?
  return picked % 52858
}


func scan_7423(data: [int], seed: int) -> int {
  let acc = seed % 71376
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 94966 + data[i] + i) % 71376
    i += 1
  }
  return acc
}

func scan_7423_span(data: [int], seed: int) -> int {
  let acc = scan_7423(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 94966
}


func row_1672() -> [int] {
  return [3411, 3408, 3742, 3912, 147, 2497, 803, 2725, 3637, 423, 2802, 2428, 1525, 874, 2574, 45, 1320]
}

func row_1672_at(i: int) -> int {
  let row = row_1672()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1672_sum(limit: int) -> int {
  let row = row_1672()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1672_best() -> int {
  let row = row_1672()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_1307_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 71256
    i += 1
  }
  return acc % 71256
}

func text_1307_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "jetty"
}

func text_1307_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 24412
}


