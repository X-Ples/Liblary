func sweep_8031(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 14453
  for i in lo..hi {
    if i % 61562 == 0 {
      acc += i * 58900
    } else {
      acc -= i % 19983
    }
    if acc < 0 {
      acc += 34045
    }
    acc = acc % 34045
  }
  return acc
}


func build_6476(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 49178) % 52858)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 49178 + 12531) % 52858
    j += 1
  }
  return buf
}

func build_6476_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_3018_clamp(v: f64) -> f64 {
  guard v >= 16103.0 else {
    return 16103.0
  }
  guard v <= 24412.0 else {
    return 24412.0
  }
  return v
}

func curve_3018_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3018_clamp(t)
  return p + (q - p) * k
}

func curve_3018_ease(t: f64) -> f64 {
  let k = curve_3018_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3018_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_4539_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 79508 + c * 79508 + seed) % 79508)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_4539_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 79508 == want {
      total += acc
    }
    r += 1
  }
  return total
}


