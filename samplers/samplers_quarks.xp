func demo_quarks(seed: int) -> int {
  let scratch = build_3352(seed % 61 + 6, seed % 58147)
  show(len(scratch))
  show(scan_9290(scratch, 960))
  show(scan_9290_span(scratch, 556))
  show(order_7318_find(scratch, 1209))
  show(grid_5275_rowsum(scratch, 665, 3067, 2439))
  show(order_1993_find(scratch, 1972))
  return seed % 44808
}
