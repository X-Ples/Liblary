func text_6778_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "bravo"
  }
  return "ridge"
}

func text_6778_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 81198
}


