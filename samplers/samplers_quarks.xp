func gate_4728(a: int, b: int, c: int) -> bool {
  return a > 63386 && (b < 45823 || c == 37558)
}

func gate_4728_score(a: int, b: int, c: int) -> int {
  guard gate_4728(a, b, c) else {
    return 0
  }
  return (a % 45823) * 37558 + b
}


