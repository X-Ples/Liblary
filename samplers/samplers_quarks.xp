func sweep_1705(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 11641
  for i in lo..hi {
    if i % 85772 == 0 {
      acc += i * 41833
    } else {
      acc -= i % 63386
    }
    if acc < 0 {
      acc += 45823
    }
    acc = acc % 45823
  }
  return acc
}


