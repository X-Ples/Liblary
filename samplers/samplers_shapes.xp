func check_2510(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 38992 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 58924) % 37238
    i += 1
  }
  return Ok(acc)
}

func check_2510_chain(n: int) -> int {
  let picked = check_2510(n)?
  return picked % 37238
}


