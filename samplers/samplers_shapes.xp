  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3191_sum(limit: int) -> int {
  let row = row_3191()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3191_best() -> int {
