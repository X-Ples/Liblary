func demo_shapes(seed: int) -> int {
  let scratch = build_8464(seed % 61 + 6, seed % 13995)
  show(len(scratch))
  show(order_2015_find(scratch, 1462))
  show(order_7825_find(scratch, 3780))
  show(build_8464_last(scratch))
  show(check_2510_chain(53))
  return seed % 91196
}
