func sweep_7725(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 68037
  for i in lo..hi {
    if i % 58924 == 0 {
      acc += i * 94578
    } else {
      acc -= i % 46914
    }
    if acc < 0 {
      acc += 21226
    }
    acc = acc % 21226
  }
  return acc
}


