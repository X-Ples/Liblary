func gate_8782(a: int, b: int, c: int) -> bool {
  return a > 32212 && (b < 14165 || c == 88248)
}

func gate_8782_score(a: int, b: int, c: int) -> int {
  guard gate_8782(a, b, c) else {
    return 0
  }
  return (a % 14165) * 88248 + b
}


func build_9889(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 88253) % 19662)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 88253 + 19662) % 19662
    j += 1
  }
  return buf
}

func build_9889_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_4480(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 87616 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 52745) % 88253
    i += 1
  }
  return Ok(acc)
}

func check_4480_chain(n: int) -> int {
  let picked = check_4480(n)?
  return picked % 88253
}


func sweep_5693(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 58894
  for i in lo..hi {
    if i % 86714 == 0 {
      acc += i * 73193
    } else {
      acc -= i % 78969
    }
    if acc < 0 {
      acc += 59899
    }
    acc = acc % 59899
  }
  return acc
}


func text_9349_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 32212
    i += 1
  }
  return acc % 32212
}

func text_9349_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "quartz"
}

func text_9349_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 73193
}


func sweep_6776(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 16213
  for i in lo..hi {
    if i % 89003 == 0 {
      acc += i * 52745
    } else {
      acc -= i % 14165
    }
    if acc < 0 {
