func demo_ratchets(seed: int) -> int {
  let scratch = build_9889(seed % 61 + 6, seed % 76888)
  show(len(scratch))
  show(gate_8782(529, 3317, 2562))
  show(gate_8782_score(2131, 1385, 2609))
  show(build_9889_last(scratch))
  show(check_4480_chain(1504))
  show(sweep_5693(1420, 1037))
  return seed % 87616
}
