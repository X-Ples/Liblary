func grid_9961_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 97286 + c * 71550 + seed) % 71550)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9961_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 71550 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func row_662() -> [int] {
  return [644, 1129, 649, 1451, 2007, 1125, 3213, 2587, 3126, 876, 1716, 2597, 1101, 3247, 676, 3400, 2595]
}

func row_662_at(i: int) -> int {
  let row = row_662()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_662_sum(limit: int) -> int {
  let row = row_662()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_662_best() -> int {
  let row = row_662()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


