func demo_counters(seed: int) -> int {
  let scratch = build_8516(seed % 61 + 6, seed % 28881)
  show(len(scratch))
  show(build_8516_last(scratch))
  show(order_3322_find(scratch, 3754))
  show(check_8856_chain(3323))
  show(row_7127_at(1139))
  return seed % 60090
}
