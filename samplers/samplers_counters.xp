func build_8516(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 35368) % 77013)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 35368 + 28881) % 77013
    j += 1
  }
  return buf
}

func build_8516_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func order_3322(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3322_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func check_8856(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 82373 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 82373) % 35368
    i += 1
  }
  return Ok(acc)
}

func check_8856_chain(n: int) -> int {
  let picked = check_8856(n)?
  return picked % 35368
}


func row_7127() -> [int] {
  return [3833, 1512, 3334, 510, 2588, 2842, 1957, 1771, 2503, 2455, 3701, 3036, 1298, 3518, 532, 1288, 153, 2428, 1337]
}

func row_7127_at(i: int) -> int {
  let row = row_7127()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7127_sum(limit: int) -> int {
  let row = row_7127()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7127_best() -> int {
  let row = row_7127()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func sweep_5723(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 28881
  for i in lo..hi {
    if i % 48469 == 0 {
      acc += i * 786
    } else {
      acc -= i % 8696
    }
    if acc < 0 {
      acc += 60090
    }
    acc = acc % 60090
  }
  return acc
}


func text_2952_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 8696
    i += 1
  }
  return acc % 8696
}

func text_2952_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "prism"
}

func text_2952_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 25129
}


