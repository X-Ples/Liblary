func sweep_6992(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 93361
  for i in lo..hi {
    if i % 93361 == 0 {
      acc += i * 84209
    } else {
      acc -= i % 8209
    }
    if acc < 0 {
      acc += 65668
    }
    acc = acc % 65668
  }
  return acc
}


func grid_6873_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 87738 + c * 95276 + seed) % 95276)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_6873_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 95276 == want {
      total += acc
    }
    r += 1
  }
  return total
}


