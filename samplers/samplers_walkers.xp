func demo_walkers(seed: int) -> int {
  let scratch = build_4787(seed % 61 + 6, seed % 43218)
  show(len(scratch))
  show(sweep_6992(2670, 1680))
  show(grid_6873_rowsum(scratch, 3173, 1819, 1995))
  show(build_4787_last(scratch))
  show(build_2516_last(scratch))
  return seed % 94585
}
