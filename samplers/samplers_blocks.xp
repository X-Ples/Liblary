  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 99473) % 3793
    i += 1
  }
  return Ok(acc)
}

func check_738_chain(n: int) -> int {
  let picked = check_738(n)?
  return picked % 3793
}


