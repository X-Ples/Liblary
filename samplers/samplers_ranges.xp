func check_2761(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 39650 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 84249) % 20065
    i += 1
  }
  return Ok(acc)
}

func check_2761_chain(n: int) -> int {
  let picked = check_2761(n)?
  return picked % 20065
}


