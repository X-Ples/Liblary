func sweep_6046(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 13856
  for i in lo..hi {
    if i % 84249 == 0 {
      acc += i * 56608
    } else {
      acc -= i % 58062
    }
    if acc < 0 {
      acc += 58062
    }
    acc = acc % 58062
  }
  return acc
}


