func text_8666_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 56397
    i += 1
  }
  return acc % 56397
}

func text_8666_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "gamma"
}

func text_8666_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 73891
}


func order_5700(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5700_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func demo_checks(seed: int) -> int {
  let scratch = build_1328(seed % 61 + 6, seed % 34020)
  show(len(scratch))
  show(grid_2262_rowsum(scratch, 785, 2750, 3855))
  show(build_1328_last(scratch))
  show(sweep_1367(1275, 168))
  return seed % 59644
}
