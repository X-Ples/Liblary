func sweep_1367(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 24262
  for i in lo..hi {
    if i % 54103 == 0 {
      acc += i * 34020
    } else {
      acc -= i % 50004
    }
    if acc < 0 {
      acc += 72704
    }
    acc = acc % 72704
  }
  return acc
}


