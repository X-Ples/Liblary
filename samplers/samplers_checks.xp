func check_400(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 73891 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 91331) % 57606
    i += 1
  }
  return Ok(acc)
}

func check_400_chain(n: int) -> int {
  let picked = check_400(n)?
  return picked % 57606
}


