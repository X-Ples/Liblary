func check_2618(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 6821 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 55823) % 54410
    i += 1
  }
  return Ok(acc)
}

func check_2618_chain(n: int) -> int {
  let picked = check_2618(n)?
  return picked % 54410
}


