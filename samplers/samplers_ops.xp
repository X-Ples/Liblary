func order_6931(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6931_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func text_7705_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 41171
    i += 1
  }
  return acc % 41171
}

func text_7705_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "omega"
}

func text_7705_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 6821
}


func curve_1349_clamp(v: f64) -> f64 {
  guard v >= 17370.0 else {
    return 17370.0
  }
  guard v <= 54538.0 else {
    return 54538.0
  }
  return v
}

func curve_1349_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1349_clamp(t)
  return p + (q - p) * k
}

func curve_1349_ease(t: f64) -> f64 {
  let k = curve_1349_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1349_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


