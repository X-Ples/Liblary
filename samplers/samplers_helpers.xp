func text_196_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "harbor"
}

func text_196_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 96678
}


func sweep_5174(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 13982
  for i in lo..hi {
    if i % 80556 == 0 {
      acc += i * 41564
    } else {
      acc -= i % 21223
    }
    if acc < 0 {
      acc += 61142
    }
    acc = acc % 61142
  }
  return acc
}


