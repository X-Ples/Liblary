func build_4716(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 80556) % 21223)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 80556 + 2317) % 21223
    j += 1
  }
  return buf
}

func build_4716_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_6397(data: [int], seed: int) -> int {
  let acc = seed % 15130
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 76122 + data[i] + i) % 15130
    i += 1
  }
  return acc
}

func scan_6397_span(data: [int], seed: int) -> int {
  let acc = scan_6397(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 76122
}


func grid_3710_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 12830 + c * 28838 + seed) % 28838)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_3710_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 28838 == want {
      total += acc
    }
    r += 1
  }
  return total
}


