func demo_helpers(seed: int) -> int {
  let scratch = build_4716(seed % 61 + 6, seed % 14713)
  show(len(scratch))
  show(build_4716_last(scratch))
  show(scan_6397(scratch, 2028))
  show(scan_6397_span(scratch, 3159))
  return seed % 13982
}
