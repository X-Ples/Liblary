func build_3960(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 91891) % 67520)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 91891 + 30824) % 67520
    j += 1
  }
  return buf
}

func build_3960_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_828_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 14374
    i += 1
  }
  return acc % 14374
}

func text_828_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "ion"
}

func text_828_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 90339
}


func curve_6116_clamp(v: f64) -> f64 {
  guard v >= 7315.0 else {
    return 7315.0
  }
  guard v <= 18734.0 else {
    return 18734.0
  }
  return v
}

func curve_6116_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6116_clamp(t)
  return p + (q - p) * k
}

func curve_6116_ease(t: f64) -> f64 {
  let k = curve_6116_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6116_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_8900(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 67520 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 34473) % 25313
    i += 1
  }
  return Ok(acc)
}

func check_8900_chain(n: int) -> int {
  let picked = check_8900(n)?
  return picked % 25313
}


