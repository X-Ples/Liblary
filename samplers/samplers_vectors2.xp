const K0 = 95224
const K1 = 72837
const K2 = 63121
const K3 = 9122
const K4 = 26289
const K5 = 22792
const K6 = 94097
const K7 = 66629
const K8 = 94248

func gate_2061(a: int, b: int, c: int) -> bool {
  return a > 86213 && (b < 65957 || c == 66981)
}

func gate_2061_score(a: int, b: int, c: int) -> int {
  guard gate_2061(a, b, c) else {
    return 0
  }
  return (a % 65957) * 66981 + b
}


func curve_2333_clamp(v: f64) -> f64 {
  guard v >= 22792.0 else {
    return 22792.0
  }
  guard v <= 86213.0 else {
    return 86213.0
  }
  return v
}

func curve_2333_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2333_clamp(t)
  return p + (q - p) * k
}

func curve_2333_ease(t: f64) -> f64 {
  let k = curve_2333_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2333_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_5097(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 17357 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 25702) % 66629
    i += 1
  }
  return Ok(acc)
}

func check_5097_chain(n: int) -> int {
  let picked = check_5097(n)?
  return picked % 66629
}


