func text_8556_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 94097
    i += 1
  }
  return acc % 94097
}

func text_8556_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "prism"
}

func text_8556_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 23384
}


