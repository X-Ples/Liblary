func scan_9208(data: [int], seed: int) -> int {
  let acc = seed % 62447
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 65957 + data[i] + i) % 62447
    i += 1
  }
  return acc
}

func scan_9208_span(data: [int], seed: int) -> int {
