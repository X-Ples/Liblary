func check_3165(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 52069 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 70892) % 17132
    i += 1
  }
  return Ok(acc)
}

func check_3165_chain(n: int) -> int {
  let picked = check_3165(n)?
  return picked % 17132
}


func sweep_9733(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 9747
  for i in lo..hi {
    if i % 17132 == 0 {
      acc += i * 56963
    } else {
      acc -= i % 52069
    }
    if acc < 0 {
      acc += 70892
    }
    acc = acc % 70892
  }
  return acc
}


