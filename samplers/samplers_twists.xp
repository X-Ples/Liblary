func order_2159(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2159_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func demo_twists(seed: int) -> int {
  let scratch = build_9724(seed % 61 + 6, seed % 24441)
  show(len(scratch))
  show(build_9724_last(scratch))
  show(grid_8823_rowsum(scratch, 2364, 1886, 507))
  show(grid_6205_rowsum(scratch, 2642, 3884, 3422))
  show(order_6725_find(scratch, 2643))
  return seed % 52069
}
