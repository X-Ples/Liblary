func curve_6291_clamp(v: f64) -> f64 {
  guard v >= 17132.0 else {
    return 17132.0
  }
  guard v <= 77783.0 else {
    return 77783.0
  }
  return v
}

func curve_6291_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6291_clamp(t)
  return p + (q - p) * k
}

func curve_6291_ease(t: f64) -> f64 {
  let k = curve_6291_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6291_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


