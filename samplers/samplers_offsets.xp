const K0 = 91759
const K1 = 42699
const K2 = 20882
const K3 = 67518
const K4 = 60222
const K5 = 33468

func build_6088(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 34018) % 18793)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 34018 + 67518) % 18793
    j += 1
  }
  return buf
}

func build_6088_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_652(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 33468 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 3809) % 10661
    i += 1
  }
  return Ok(acc)
}

func check_652_chain(n: int) -> int {
  let picked = check_652(n)?
  return picked % 10661
}


func curve_9307_clamp(v: f64) -> f64 {
  guard v >= 32750.0 else {
    return 32750.0
  }
  guard v <= 84813.0 else {
    return 84813.0
  }
  return v
}

func curve_9307_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_9307_clamp(t)
  return p + (q - p) * k
}

func curve_9307_ease(t: f64) -> f64 {
  let k = curve_9307_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_9307_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func curve_4359_clamp(v: f64) -> f64 {
  guard v >= 43011.0 else {
    return 43011.0
  }
  guard v <= 43011.0 else {
    return 43011.0
  }
  return v
}

func curve_4359_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4359_clamp(t)
  return p + (q - p) * k
}

func curve_4359_ease(t: f64) -> f64 {
  let k = curve_4359_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4359_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_9252(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9252_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func scan_5838(data: [int], seed: int) -> int {
  let acc = seed % 84618
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 67518 + data[i] + i) % 84618
    i += 1
  }
  return acc
}

func scan_5838_span(data: [int], seed: int) -> int {
  let acc = scan_5838(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 67518
}


