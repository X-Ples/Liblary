func demo_offsets(seed: int) -> int {
  let scratch = build_6088(seed % 61 + 6, seed % 95330)
  show(len(scratch))
  show(build_6088_last(scratch))
  show(check_652_chain(603))
  show(order_9252_find(scratch, 1006))
  show(scan_5838(scratch, 2213))
  show(scan_5838_span(scratch, 988))
  return seed % 15249
}
