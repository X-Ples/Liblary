func build_3245(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 99618) % 51929)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 99618 + 40169) % 51929
    j += 1
  }
  return buf
}

func build_3245_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_7263(a: int, b: int, c: int) -> bool {
  return a > 95389 && (b < 73969 || c == 10929)
}

func gate_7263_score(a: int, b: int, c: int) -> int {
  guard gate_7263(a, b, c) else {
    return 0
  }
  return (a % 73969) * 10929 + b
}


func check_3089(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 64646 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 99618) % 34898
    i += 1
  }
  return Ok(acc)
}

func check_3089_chain(n: int) -> int {
  let picked = check_3089(n)?
  return picked % 34898
}


func scan_1604(data: [int], seed: int) -> int {
  let acc = seed % 33479
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 64646 + data[i] + i) % 33479
    i += 1
  }
  return acc
}

func scan_1604_span(data: [int], seed: int) -> int {
  let acc = scan_1604(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 64646
}


func sweep_2780(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 67252
  for i in lo..hi {
    if i % 64646 == 0 {
      acc += i * 40169
    } else {
      acc -= i % 51762
    }
    if acc < 0 {
      acc += 16671
    }
    acc = acc % 16671
  }
  return acc
}


func text_6089_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 16447
    i += 1
  }
  return acc % 16447
}

func text_6089_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "bravo"
}

func text_6089_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 33479
}


