func demo_reductions(seed: int) -> int {
  let scratch = build_3245(seed % 61 + 6, seed % 73969)
  show(len(scratch))
  show(build_3245_last(scratch))
  show(gate_7263(780, 3130, 2982))
  show(gate_7263_score(620, 736, 3755))
  show(check_3089_chain(2161))
  return seed % 98049
