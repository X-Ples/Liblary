func scan_2085(data: [int], seed: int) -> int {
  let acc = seed % 29958
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 50567 + data[i] + i) % 29958
    i += 1
  }
  return acc
}

func scan_2085_span(data: [int], seed: int) -> int {
  let acc = scan_2085(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 50567
}


