func demo_trims(seed: int) -> int {
  let scratch = build_8381(seed % 61 + 6, seed % 58189)
  show(len(scratch))
  show(build_8381_last(scratch))
  show(order_7385_find(scratch, 2595))
  show(check_7620_chain(3360))
  show(sweep_9764(20, 411))
  show(sweep_7930(1723, 796))
  return seed % 56868
}
