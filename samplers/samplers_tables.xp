func demo_tables(seed: int) -> int {
  let scratch = build_6877(seed % 61 + 6, seed % 2048)
  show(len(scratch))
  show(build_6877_last(scratch))
  show(scan_6575(scratch, 2483))
  show(scan_6575_span(scratch, 2029))
  show(grid_9947_rowsum(scratch, 2142, 2584, 3288))
  return seed % 48830
}
