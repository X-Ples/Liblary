func build_6877(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 2048) % 10636)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 2048 + 90444) % 10636
    j += 1
  }
  return buf
}

func build_6877_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_6575(data: [int], seed: int) -> int {
  let acc = seed % 77026
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 76044 + data[i] + i) % 77026
    i += 1
  }
  return acc
}

func scan_6575_span(data: [int], seed: int) -> int {
  let acc = scan_6575(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 76044
}


func grid_9947_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 8138 + c * 11455 + seed) % 11455)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9947_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 11455 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_8204_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 345
    i += 1
  }
  return acc % 345
}

func text_8204_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "cargo"
}

func text_8204_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 30779
}


func gate_4819(a: int, b: int, c: int) -> bool {
  return a > 10636 && (b < 98336 || c == 90216)
}

func gate_4819_score(a: int, b: int, c: int) -> int {
  guard gate_4819(a, b, c) else {
    return 0
  }
  return (a % 98336) * 90216 + b
}


func sweep_3689(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 48474
  for i in lo..hi {
    if i % 11455 == 0 {
      acc += i * 18484
    } else {
      acc -= i % 2048
    }
    if acc < 0 {
      acc += 30779
    }
    acc = acc % 30779
  }
  return acc
}


