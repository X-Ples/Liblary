func demo_windows(seed: int) -> int {
  let scratch = build_8420(seed % 61 + 6, seed % 41750)
  show(len(scratch))
  show(build_8420_last(scratch))
  show(order_5893_find(scratch, 1397))
  show(scan_4573(scratch, 1791))
