func sweep_9862(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 71589
  for i in lo..hi {
    if i % 84019 == 0 {
      acc += i * 71589
    } else {
      acc -= i % 17449
    }
    if acc < 0 {
      acc += 34387
    }
    acc = acc % 34387
  }
  return acc
}


