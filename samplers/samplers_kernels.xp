func build_637(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 34998) % 38141)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 34998 + 34998) % 38141
    j += 1
  }
  return buf
}

func build_637_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_3516(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 74662 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 47499) % 47499
    i += 1
  }
  return Ok(acc)
}

func check_3516_chain(n: int) -> int {
  let picked = check_3516(n)?
  return picked % 47499
}


