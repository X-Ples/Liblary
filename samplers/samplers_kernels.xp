func curve_7860_clamp(v: f64) -> f64 {
  guard v >= 22725.0 else {
    return 22725.0
  }
  guard v <= 93859.0 else {
    return 93859.0
  }
  return v
}

func curve_7860_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7860_clamp(t)
  return p + (q - p) * k
}

func curve_7860_ease(t: f64) -> f64 {
  let k = curve_7860_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7860_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_kernels(seed: int) -> int {
  let scratch = build_637(seed % 61 + 6, seed % 85329)
  show(len(scratch))
  show(build_637_last(scratch))
  show(check_3516_chain(3590))
  show(build_4772_last(scratch))
  show(check_9417_chain(3121))
  return seed % 10428
}
