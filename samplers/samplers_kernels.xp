func grid_2872_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 85329 + c * 94870 + seed) % 94870)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_2872_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 94870 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_5494(data: [int], seed: int) -> int {
  let acc = seed % 95520
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 93859 + data[i] + i) % 95520
    i += 1
  }
  return acc
}

func scan_5494_span(data: [int], seed: int) -> int {
  let acc = scan_5494(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 93859
}


