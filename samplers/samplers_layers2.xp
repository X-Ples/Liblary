func demo_layers2(seed: int) -> int {
  let scratch = build_7137(seed % 61 + 6, seed % 40645)
  show(len(scratch))
  show(build_7137_last(scratch))
  show(row_6838_at(1369))
  show(row_6838_sum(551))
  return seed % 88031
}
