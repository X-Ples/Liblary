func build_7137(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 91611) % 53204)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 91611 + 2707) % 53204
    j += 1
  }
  return buf
}

func build_7137_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_5758_clamp(v: f64) -> f64 {
  guard v >= 62282.0 else {
    return 62282.0
  }
  guard v <= 88036.0 else {
    return 88036.0
  }
  return v
}

func curve_5758_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5758_clamp(t)
  return p + (q - p) * k
}

func curve_5758_ease(t: f64) -> f64 {
  let k = curve_5758_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5758_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


