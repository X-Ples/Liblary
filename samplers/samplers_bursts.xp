func build_2781(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 20775) % 51671)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 20775 + 52863) % 51671
    j += 1
  }
  return buf
}

func build_2781_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_6854(data: [int], seed: int) -> int {
  let acc = seed % 70541
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 27701 + data[i] + i) % 70541
    i += 1
  }
  return acc
}

func scan_6854_span(data: [int], seed: int) -> int {
  let acc = scan_6854(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 27701
}


func check_7551(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 2994 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 25449) % 35694
    i += 1
  }
  return Ok(acc)
}

func check_7551_chain(n: int) -> int {
  let picked = check_7551(n)?
  return picked % 35694
}


func row_3549() -> [int] {
  return [3585, 142, 1373, 2148, 2268, 3408, 3229, 3938, 2829, 1105]
}

func row_3549_at(i: int) -> int {
  let row = row_3549()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3549_sum(limit: int) -> int {
  let row = row_3549()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3549_best() -> int {
  let row = row_3549()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_4968_clamp(v: f64) -> f64 {
  guard v >= 14496.0 else {
    return 14496.0
  }
  guard v <= 52863.0 else {
    return 52863.0
  }
  return v
}

func curve_4968_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4968_clamp(t)
  return p + (q - p) * k
}

func curve_4968_ease(t: f64) -> f64 {
  let k = curve_4968_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4968_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


