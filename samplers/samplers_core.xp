func demo_core(seed: int) -> int {
  let scratch = build_7051(seed % 61 + 6, seed % 63518)
  show(len(scratch))
  show(build_7051_last(scratch))
  show(check_7088_chain(3519))
  show(gate_8488(119, 2040, 2851))
  return seed % 6519
}
