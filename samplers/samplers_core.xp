func build_7051(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 9825) % 6727)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 9825 + 70119) % 6727
    j += 1
  }
  return buf
}

func build_7051_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_7088(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 81499 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 83435) % 10129
    i += 1
  }
  return Ok(acc)
}

func check_7088_chain(n: int) -> int {
  let picked = check_7088(n)?
  return picked % 10129
}


func curve_5159_clamp(v: f64) -> f64 {
  guard v >= 72526.0 else {
    return 72526.0
  }
  guard v <= 88267.0 else {
    return 88267.0
  }
  return v
}

func curve_5159_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5159_clamp(t)
  return p + (q - p) * k
}

func curve_5159_ease(t: f64) -> f64 {
  let k = curve_5159_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5159_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_8488(a: int, b: int, c: int) -> bool {
  return a > 6727 && (b < 6519 || c == 10129)
}

func gate_8488_score(a: int, b: int, c: int) -> int {
  guard gate_8488(a, b, c) else {
    return 0
  }
  return (a % 6519) * 10129 + b
}


func grid_469_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 51497 + c * 6519 + seed) % 6519)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_469_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 6519 == want {
      total += acc
    }
    r += 1
  }
  return total
}


