func sweep_3675(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 88267
  for i in lo..hi {
    if i % 88267 == 0 {
      acc += i * 46441
    } else {
      acc -= i % 32184
    }
    if acc < 0 {
      acc += 81776
    }
    acc = acc % 81776
  }
  return acc
}


func scan_4441(data: [int], seed: int) -> int {
  let acc = seed % 9825
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 72132 + data[i] + i) % 9825
    i += 1
  }
  return acc
}

func scan_4441_span(data: [int], seed: int) -> int {
  let acc = scan_4441(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 72132
}


