func row_6216() -> [int] {
  return [1280, 3837, 1835, 2503, 3168, 3472, 3553, 726, 1020, 937, 2756, 499, 3204, 965, 921, 2241, 3811, 835, 1800, 3296]
}

func row_6216_at(i: int) -> int {
  let row = row_6216()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6216_sum(limit: int) -> int {
  let row = row_6216()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6216_best() -> int {
  let row = row_6216()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


