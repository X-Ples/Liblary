func check_391(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 21353 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 19030) % 69328
    i += 1
  }
  return Ok(acc)
}

func check_391_chain(n: int) -> int {
  let picked = check_391(n)?
  return picked % 69328
}


func text_4551_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 441
    i += 1
  }
  return acc % 441
}

func text_4551_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "jetty"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "cargo"
}

func text_4551_has(tag: str) -> bool {
  return str_contains(tag, "jetty") || len(tag) > 20196
}


