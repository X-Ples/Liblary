func grid_8323_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 55856 + c * 52917 + seed) % 52917)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8323_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 52917 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_3400(data: [int], seed: int) -> int {
  let acc = seed % 19030
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 93179 + data[i] + i) % 19030
    i += 1
  }
  return acc
}

func scan_3400_span(data: [int], seed: int) -> int {
  let acc = scan_3400(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 93179
}


