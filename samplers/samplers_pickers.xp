func demo_pickers(seed: int) -> int {
  let scratch = build_4694(seed % 61 + 6, seed % 24217)
  show(len(scratch))
  show(gate_5068(357, 1923, 550))
  show(gate_5068_score(2014, 958, 2594))
  show(build_4694_last(scratch))
  show(row_8010_at(2667))
  show(row_8010_sum(1133))
  return seed % 90203
}
