func gate_5068(a: int, b: int, c: int) -> bool {
  return a > 20196 && (b < 17014 || c == 32034)
}

func gate_5068_score(a: int, b: int, c: int) -> int {
  guard gate_5068(a, b, c) else {
    return 0
  }
  return (a % 17014) * 32034 + b
}


func build_4694(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 27133) % 34826)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 27133 + 17014) % 34826
    j += 1
  }
  return buf
}

func build_4694_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_8010() -> [int] {
  return [2654, 2243, 2774, 765, 1234, 2558, 1793, 2030, 300, 2288, 2036]
}

func row_8010_at(i: int) -> int {
  let row = row_8010()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8010_sum(limit: int) -> int {
  let row = row_8010()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8010_best() -> int {
  let row = row_8010()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_643_clamp(v: f64) -> f64 {
  guard v >= 24217.0 else {
    return 24217.0
  }
  guard v <= 91908.0 else {
    return 91908.0
  }
  return v
}

func curve_643_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_643_clamp(t)
  return p + (q - p) * k
}

func curve_643_ease(t: f64) -> f64 {
  let k = curve_643_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_643_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


