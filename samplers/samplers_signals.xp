func check_4376(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 97845 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 45813) % 9641
    i += 1
  }
  return Ok(acc)
}

func check_4376_chain(n: int) -> int {
  let picked = check_4376(n)?
  return picked % 9641
}


