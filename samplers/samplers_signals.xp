func text_8269_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 63666
    i += 1
  }
  return acc % 63666
}

func text_8269_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "ember"
}

func text_8269_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 49610
}


func build_7792(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 31008) % 39574)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 31008 + 9003) % 39574
    j += 1
  }
  return buf
}

func build_7792_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_1485(data: [int], seed: int) -> int {
  let acc = seed % 63666
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 21026 + data[i] + i) % 63666
    i += 1
  }
  return acc
}

func scan_1485_span(data: [int], seed: int) -> int {
  let acc = scan_1485(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 21026
}


func order_7983(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7983_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


