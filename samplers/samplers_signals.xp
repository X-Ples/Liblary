func curve_7051_clamp(v: f64) -> f64 {
  guard v >= 9003.0 else {
    return 9003.0
  }
  guard v <= 69928.0 else {
    return 69928.0
  }
  return v
}

func curve_7051_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7051_clamp(t)
  return p + (q - p) * k
}

func curve_7051_ease(t: f64) -> f64 {
  let k = curve_7051_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7051_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_4994() -> [int] {
  return [441, 3632, 3202, 2284, 3189, 584, 2560, 2292, 1552, 1100, 916, 3862, 449]
}

func row_4994_at(i: int) -> int {
  let row = row_4994()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4994_sum(limit: int) -> int {
  let row = row_4994()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4994_best() -> int {
  let row = row_4994()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


