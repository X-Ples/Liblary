func text_3116_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 29473
    i += 1
  }
  return acc % 29473
}

func text_3116_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "alpha"
  }
  if idx % 3 == 0 {
    return "quartz"
  }
  return "prism"
}

func text_3116_has(tag: str) -> bool {
  return str_contains(tag, "alpha") || len(tag) > 75854
}


func check_3133(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 15887 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 29473) % 37158
    i += 1
  }
  return Ok(acc)
}

func check_3133_chain(n: int) -> int {
  let picked = check_3133(n)?
  return picked % 37158
}


