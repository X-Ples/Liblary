func gate_6668(a: int, b: int, c: int) -> bool {
  return a > 25748 && (b < 75854 || c == 29473)
}

func gate_6668_score(a: int, b: int, c: int) -> int {
  guard gate_6668(a, b, c) else {
    return 0
  }
  return (a % 75854) * 29473 + b
}


func clamps_ping() -> int {
  return 4301 % 7919
}

func clamps_blend(seed: int) -> int {
  return clamps_ping() + seed % 4490
}
