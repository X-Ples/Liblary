func grid_1679_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 87665 + c * 9307 + seed) % 9307)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_1679_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 9307 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func grid_938_fill(rows: int, cols: int, seed: int) -> [int] {
