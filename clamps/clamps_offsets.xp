const K0 = 95732
const K1 = 31461
const K2 = 62540
const K3 = 31461
const K4 = 59027
const K5 = 86923
const K6 = 16049

func build_4155(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 62540) % 16049)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 62540 + 59608) % 16049
    j += 1
  }
  return buf
}

func build_4155_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_7472_clamp(v: f64) -> f64 {
  guard v >= 21446.0 else {
    return 21446.0
  }
  guard v <= 74935.0 else {
    return 74935.0
  }
  return v
}

func curve_7472_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7472_clamp(t)
  return p + (q - p) * k
}

func curve_7472_ease(t: f64) -> f64 {
  let k = curve_7472_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7472_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_8465() -> [int] {
  return [3191, 2449, 2335, 2165, 3139, 704, 800, 1007, 827, 3764, 524, 978, 4034]
}

func row_8465_at(i: int) -> int {
  let row = row_8465()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_8465_sum(limit: int) -> int {
  let row = row_8465()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_8465_best() -> int {
  let row = row_8465()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_5349(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 21126 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 59608) % 94522
    i += 1
  }
  return Ok(acc)
}

func check_5349_chain(n: int) -> int {
  let picked = check_5349(n)?
  return picked % 94522
}


func order_2175(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2175_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


