func sweep_9824(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10838
  for i in lo..hi {
    if i % 16663 == 0 {
      acc += i * 21126
    } else {
      acc -= i % 37568
    }
    if acc < 0 {
      acc += 66928
    }
    acc = acc % 66928
  }
  return acc
}


