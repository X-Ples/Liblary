func grid_9091_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 20202 + c * 61836 + seed) % 61836)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9091_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 61836 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func demo_offsets(seed: int) -> int {
  let scratch = build_4155(seed % 61 + 6, seed % 66928)
  show(len(scratch))
  show(build_4155_last(scratch))
  show(row_8465_at(1301))
  show(row_8465_sum(164))
  show(row_8465_best())
  return seed % 25086
}
