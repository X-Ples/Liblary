func scan_5987(data: [int], seed: int) -> int {
  let acc = seed % 10838
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 38422 + data[i] + i) % 10838
    i += 1
  }
  return acc
}

func scan_5987_span(data: [int], seed: int) -> int {
  let acc = scan_5987(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 38422
}


