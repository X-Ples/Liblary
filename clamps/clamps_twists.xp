func build_7475(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 33145) % 50883)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 33145 + 46067) % 50883
    j += 1
  }
  return buf
}

func build_7475_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_8308(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 46067
  for i in lo..hi {
    if i % 39041 == 0 {
      acc += i * 68824
    } else {
      acc -= i % 82832
    }
    if acc < 0 {
      acc += 78464
    }
    acc = acc % 78464
  }
  return acc
}


func check_5489(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 37233 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 76207) % 32397
    i += 1
  }
  return Ok(acc)
}

func check_5489_chain(n: int) -> int {
  let picked = check_5489(n)?
  return picked % 32397
}


func gate_4749(a: int, b: int, c: int) -> bool {
  return a > 44748 && (b < 11867 || c == 56051)
}

func gate_4749_score(a: int, b: int, c: int) -> int {
  guard gate_4749(a, b, c) else {
    return 0
  }
  return (a % 11867) * 56051 + b
}


