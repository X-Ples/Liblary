func build_9670(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 93362) % 70314)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 93362 + 26720) % 70314
    j += 1
  }
  return buf
}

func build_9670_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_7440_clamp(v: f64) -> f64 {
  guard v >= 10488.0 else {
    return 10488.0
  }
  guard v <= 60028.0 else {
    return 60028.0
  }
  return v
}

func curve_7440_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7440_clamp(t)
  return p + (q - p) * k
}

func curve_7440_ease(t: f64) -> f64 {
  let k = curve_7440_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7440_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_2601(data: [int], seed: int) -> int {
  let acc = seed % 50319
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 7047 + data[i] + i) % 50319
    i += 1
  }
  return acc
}

func scan_2601_span(data: [int], seed: int) -> int {
  let acc = scan_2601(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 7047
}


func text_6445_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 85591
    i += 1
  }
  return acc % 85591
}

func text_6445_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ion"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "flint"
}

func text_6445_has(tag: str) -> bool {
  return str_contains(tag, "ion") || len(tag) > 93952
}


