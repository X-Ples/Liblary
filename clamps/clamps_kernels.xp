func check_8484(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 57366 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 37193) % 10488
    i += 1
  }
  return Ok(acc)
}

func check_8484_chain(n: int) -> int {
  let picked = check_8484(n)?
  return picked % 10488
}


