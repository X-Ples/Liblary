func demo_kernels(seed: int) -> int {
  let scratch = build_9670(seed % 61 + 6, seed % 7047)
  show(len(scratch))
  show(build_9670_last(scratch))
  show(scan_2601(scratch, 504))
  show(scan_2601_span(scratch, 3298))
  show(text_6445_weight("bravo"))
  show(text_6445_label(577))
  return seed % 45979
}
