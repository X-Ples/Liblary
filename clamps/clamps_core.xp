func check_8800(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 94939 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 94939) % 31777
    i += 1
  }
  return Ok(acc)
}

func check_8800_chain(n: int) -> int {
  let picked = check_8800(n)?
  return picked % 31777
}


func scan_9786(data: [int], seed: int) -> int {
  let acc = seed % 57260
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 77900 + data[i] + i) % 57260
    i += 1
  }
  return acc
}

func scan_9786_span(data: [int], seed: int) -> int {
  let acc = scan_9786(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 77900
}


