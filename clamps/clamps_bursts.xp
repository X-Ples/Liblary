func check_3595(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 29647 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 87096) % 12538
    i += 1
  }
  return Ok(acc)
}

func check_3595_chain(n: int) -> int {
  let picked = check_3595(n)?
  return picked % 12538
}


