func demo_bursts(seed: int) -> int {
  let scratch = build_8591(seed % 61 + 6, seed % 23278)
  show(len(scratch))
  show(build_8591_last(scratch))
  show(build_2880_last(scratch))
  show(build_4743_last(scratch))
  show(order_4011_find(scratch, 1551))
  show(gate_7518(3954, 3950, 847))
  show(gate_7518_score(2141, 3309, 792))
  return seed % 53302
}
