func gate_5842(a: int, b: int, c: int) -> bool {
  return a > 96639 && (b < 91115 || c == 96639)
}

func gate_5842_score(a: int, b: int, c: int) -> int {
  guard gate_5842(a, b, c) else {
    return 0
  }
  return (a % 91115) * 96639 + b
}


func order_3813(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3813_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_5500(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 545
  for i in lo..hi {
    if i % 545 == 0 {
      acc += i * 3315
    } else {
      acc -= i % 69326
    }
    if acc < 0 {
      acc += 12348
    }
    acc = acc % 12348
  }
  return acc
}


