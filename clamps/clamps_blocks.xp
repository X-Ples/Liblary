func curve_2000_clamp(v: f64) -> f64 {
  guard v >= 21118.0 else {
    return 21118.0
  }
  guard v <= 34013.0 else {
    return 34013.0
  }
  return v
}

func curve_2000_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_2000_clamp(t)
  return p + (q - p) * k
}

func curve_2000_ease(t: f64) -> f64 {
  let k = curve_2000_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_2000_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func demo_blocks(seed: int) -> int {
  let scratch = build_6743(seed % 61 + 6, seed % 96639)
  show(len(scratch))
  show(build_6743_last(scratch))
  show(row_205_at(1691))
  show(row_205_sum(1874))
  show(row_205_best())
  show(row_7789_at(1524))
  return seed % 69326
}
