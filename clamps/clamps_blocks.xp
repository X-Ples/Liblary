func build_6743(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 84555) % 21118)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 84555 + 74779) % 21118
    j += 1
  }
  return buf
}

func build_6743_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_205() -> [int] {
  return [224, 2441, 231, 2292, 3456, 905, 1902, 3085, 357, 1363, 258, 2956, 3029, 667, 1640, 1968]
}

func row_205_at(i: int) -> int {
  let row = row_205()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_205_sum(limit: int) -> int {
  let row = row_205()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_205_best() -> int {
  let row = row_205()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


