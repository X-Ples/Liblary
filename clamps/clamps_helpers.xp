func scan_1843(data: [int], seed: int) -> int {
  let acc = seed % 19701
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 69126 + data[i] + i) % 19701
    i += 1
  }
  return acc
}

func scan_1843_span(data: [int], seed: int) -> int {
  let acc = scan_1843(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 69126
}


