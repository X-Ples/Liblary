const K0 = 17562
const K1 = 94167
const K2 = 8542
const K3 = 80867
const K4 = 6231
const K5 = 88822
const K6 = 80702

func build_7845(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 72511) % 66763)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 72511 + 47020) % 66763
    j += 1
  }
  return buf
}

func build_7845_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_8850(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 13442
  for i in lo..hi {
    if i % 13442 == 0 {
      acc += i * 99970
    } else {
      acc -= i % 3949
    }
    if acc < 0 {
      acc += 8542
    }
    acc = acc % 8542
  }
  return acc
}


func curve_5837_clamp(v: f64) -> f64 {
  guard v >= 2990.0 else {
    return 2990.0
  }
  guard v <= 9768.0 else {
    return 9768.0
  }
  return v
}

func curve_5837_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5837_clamp(t)
  return p + (q - p) * k
}

func curve_5837_ease(t: f64) -> f64 {
  let k = curve_5837_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5837_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func grid_7853_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 88956 + c * 22650 + seed) % 22650)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7853_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 22650 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_4745(data: [int], seed: int) -> int {
  let acc = seed % 66763
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 62341 + data[i] + i) % 66763
    i += 1
  }
  return acc
}

func scan_4745_span(data: [int], seed: int) -> int {
  let acc = scan_4745(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 62341
}


