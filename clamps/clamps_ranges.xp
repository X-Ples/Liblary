func grid_5884_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 180 + c * 38502 + seed) % 38502)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5884_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 38502 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func demo_ranges(seed: int) -> int {
  let scratch = build_7845(seed % 61 + 6, seed % 6231)
  show(len(scratch))
  show(build_7845_last(scratch))
  show(sweep_8850(2469, 947))
  show(grid_7853_rowsum(scratch, 1455, 2045, 2796))
  show(scan_4745(scratch, 1729))
  return seed % 78176
}
