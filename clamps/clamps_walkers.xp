func demo_walkers(seed: int) -> int {
  let scratch = build_8265(seed % 61 + 6, seed % 32820)
  show(len(scratch))
  show(build_8265_last(scratch))
  show(sweep_2709(2968, 1721))
  show(scan_6461(scratch, 2231))
  return seed % 12044
}
