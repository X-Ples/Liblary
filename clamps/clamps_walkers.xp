func check_7410(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 68712 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 96494) % 32820
    i += 1
  }
  return Ok(acc)
}

func check_7410_chain(n: int) -> int {
  let picked = check_7410(n)?
  return picked % 32820
}


