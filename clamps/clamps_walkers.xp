func build_8265(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 27095) % 96890)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 27095 + 53420) % 96890
    j += 1
  }
  return buf
}

func build_8265_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_2709(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 27119
  for i in lo..hi {
    if i % 96890 == 0 {
      acc += i * 16815
    } else {
      acc -= i % 4750
    }
    if acc < 0 {
      acc += 9845
    }
    acc = acc % 9845
  }
  return acc
}


func scan_6461(data: [int], seed: int) -> int {
  let acc = seed % 45800
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 46067 + data[i] + i) % 45800
    i += 1
  }
  return acc
}

func scan_6461_span(data: [int], seed: int) -> int {
  let acc = scan_6461(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 46067
}


func gate_9782(a: int, b: int, c: int) -> bool {
  return a > 81392 && (b < 11551 || c == 81392)
}

func gate_9782_score(a: int, b: int, c: int) -> int {
  guard gate_9782(a, b, c) else {
    return 0
  }
  return (a % 11551) * 81392 + b
}


func curve_8927_clamp(v: f64) -> f64 {
  guard v >= 75102.0 else {
    return 75102.0
  }
  guard v <= 97711.0 else {
    return 97711.0
  }
  return v
}

func curve_8927_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8927_clamp(t)
  return p + (q - p) * k
}

func curve_8927_ease(t: f64) -> f64 {
  let k = curve_8927_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8927_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_2775_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 25902
    i += 1
  }
  return acc % 25902
}

func text_2775_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "talus"
  }
  if idx % 3 == 0 {
    return "alpha"
  }
  return "quartz"
}

func text_2775_has(tag: str) -> bool {
  return str_contains(tag, "talus") || len(tag) > 80370
}


