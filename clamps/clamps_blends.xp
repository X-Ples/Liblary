func demo_blends(seed: int) -> int {
  let scratch = build_9605(seed % 61 + 6, seed % 99645)
  show(len(scratch))
  show(build_9605_last(scratch))
  show(build_5232_last(scratch))
  show(text_7114_weight("omega"))
  show(text_7114_label(1203))
  return seed % 5995
}
