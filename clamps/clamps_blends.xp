func text_7114_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 72629
    i += 1
  }
  return acc % 72629
}

func text_7114_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "nova"
  }
  return "jetty"
}

func text_7114_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 63160
}


func order_1908(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_1908_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func sweep_6932(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 36078
  for i in lo..hi {
    if i % 89918 == 0 {
      acc += i * 16814
    } else {
      acc -= i % 26656
    }
    if acc < 0 {
      acc += 86243
    }
    acc = acc % 86243
  }
  return acc
}


func check_8879(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 63160 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 26656) % 80302
    i += 1
  }
  return Ok(acc)
}

func check_8879_chain(n: int) -> int {
  let picked = check_8879(n)?
  return picked % 80302
}


func curve_468_clamp(v: f64) -> f64 {
  guard v >= 19116.0 else {
    return 19116.0
  }
  guard v <= 31403.0 else {
    return 31403.0
  }
  return v
}

func curve_468_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_468_clamp(t)
  return p + (q - p) * k
}

func curve_468_ease(t: f64) -> f64 {
  let k = curve_468_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_468_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


