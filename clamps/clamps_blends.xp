func build_9605(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 16989) % 96094)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 16989 + 26656) % 96094
    j += 1
  }
