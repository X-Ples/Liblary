func build_7098(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 98643) % 31069)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 98643 + 83446) % 31069
    j += 1
  }
  return buf
}

func build_7098_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_2087_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 84638
    i += 1
  }
  return acc % 84638
}

func text_2087_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "prism"
  }
  return "delta"
}

func text_2087_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 25816
}


func check_7329(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 64308 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 51643) % 92369
    i += 1
  }
  return Ok(acc)
}

func check_7329_chain(n: int) -> int {
  let picked = check_7329(n)?
  return picked % 92369
}


