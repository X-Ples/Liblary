func scan_3593(data: [int], seed: int) -> int {
  let acc = seed % 80393
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 80671 + data[i] + i) % 80393
    i += 1
  }
  return acc
}

func scan_3593_span(data: [int], seed: int) -> int {
  let acc = scan_3593(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 80671
}


func sweep_1527(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 80393
  for i in lo..hi {
