func check_2344(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 92831 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 61681) % 8645
    i += 1
  }
  return Ok(acc)
}

func check_2344_chain(n: int) -> int {
  let picked = check_2344(n)?
  return picked % 8645
}


