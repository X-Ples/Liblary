func sweep_5191(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 5583
  for i in lo..hi {
    if i % 95399 == 0 {
      acc += i * 8499
    } else {
      acc -= i % 64463
    }
    if acc < 0 {
      acc += 82666
    }
    acc = acc % 82666
  }
  return acc
}


