func demo_tables(seed: int) -> int {
  let scratch = build_7606(seed % 61 + 6, seed % 3990)
  show(len(scratch))
  show(gate_967(401, 1152, 1498))
  show(gate_967_score(2147, 3180, 3311))
  show(gate_5119(3082, 210, 1793))
