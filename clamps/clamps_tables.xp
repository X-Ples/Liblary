func gate_967(a: int, b: int, c: int) -> bool {
  return a > 64463 && (b < 72088 || c == 72088)
}

func gate_967_score(a: int, b: int, c: int) -> int {
  guard gate_967(a, b, c) else {
    return 0
  }
  return (a % 72088) * 72088 + b
}


