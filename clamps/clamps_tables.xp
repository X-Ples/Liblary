func build_7606(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 10915) % 92976)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 10915 + 67207) % 92976
    j += 1
  }
  return buf
}

func build_7606_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_2946_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 67207
    i += 1
  }
  return acc % 67207
}

func text_2946_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ridge"
  }
  if idx % 3 == 0 {
    return "cargo"
  }
  return "ember"
}

func text_2946_has(tag: str) -> bool {
  return str_contains(tag, "ridge") || len(tag) > 8499
}


