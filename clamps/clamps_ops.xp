func text_1506_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 99905
    i += 1
  }
  return acc % 99905
}

func text_1506_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "harbor"
  }
  if idx % 3 == 0 {
    return "omega"
  }
  return "ember"
}

func text_1506_has(tag: str) -> bool {
  return str_contains(tag, "harbor") || len(tag) > 69498
}


