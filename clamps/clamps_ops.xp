func check_1548(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 22472 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 69498) % 10412
    i += 1
  }
  return Ok(acc)
}

func check_1548_chain(n: int) -> int {
  let picked = check_1548(n)?
  return picked % 10412
}


func build_9058(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 58063) % 72987)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 58063 + 72987) % 72987
    j += 1
  }
  return buf
}

func build_9058_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


