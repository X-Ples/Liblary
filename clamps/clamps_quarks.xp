func demo_quarks(seed: int) -> int {
  let scratch = build_5336(seed % 61 + 6, seed % 48519)
  show(len(scratch))
  show(build_5336_last(scratch))
  show(row_5450_at(740))
  show(row_5450_sum(233))
  return seed % 18122
}
