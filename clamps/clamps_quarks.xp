}

func text_3295_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "lumen"
  }
  if idx % 3 == 0 {
    return "jetty"
  }
  return "nova"
}

func text_3295_has(tag: str) -> bool {
  return str_contains(tag, "lumen") || len(tag) > 93696
}


func sweep_3763(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 46851
  for i in lo..hi {
    if i % 86763 == 0 {
      acc += i * 70523
    } else {
      acc -= i % 93696
    }
    if acc < 0 {
      acc += 46851
    }
    acc = acc % 46851
  }
  return acc
}


func grid_8009_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 10968 + c * 64731 + seed) % 64731)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8009_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 64731 == want {
      total += acc
    }
    r += 1
  }
  return total
}


