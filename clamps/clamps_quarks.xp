const K0 = 31585
const K1 = 10968
const K2 = 18122
const K3 = 64987
const K4 = 7052
const K5 = 93696
const K6 = 12313
const K7 = 86046
const K8 = 64987
const K9 = 10968

func build_5336(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 38093) % 12313)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 38093 + 49473) % 12313
    j += 1
  }
  return buf
}

func build_5336_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_5450() -> [int] {
  return [2385, 1535, 2129, 3340, 915, 2616, 2052, 648, 1251, 3511, 2077, 74, 2376, 2007, 3536]
}

func row_5450_at(i: int) -> int {
  let row = row_5450()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5450_sum(limit: int) -> int {
  let row = row_5450()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5450_best() -> int {
  let row = row_5450()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_4073(data: [int], seed: int) -> int {
  let acc = seed % 99272
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 19904 + data[i] + i) % 99272
    i += 1
  }
  return acc
}

func scan_4073_span(data: [int], seed: int) -> int {
  let acc = scan_4073(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 19904
}


func gate_3354(a: int, b: int, c: int) -> bool {
  return a > 10968 && (b < 10968 || c == 18122)
}

func gate_3354_score(a: int, b: int, c: int) -> int {
  guard gate_3354(a, b, c) else {
    return 0
  }
  return (a % 10968) * 18122 + b
}


func curve_5967_clamp(v: f64) -> f64 {
  guard v >= 58702.0 else {
    return 58702.0
  }
  guard v <= 68835.0 else {
    return 68835.0
  }
  return v
}

func curve_5967_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5967_clamp(t)
  return p + (q - p) * k
}

func curve_5967_ease(t: f64) -> f64 {
  let k = curve_5967_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5967_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_1169(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 12313 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 93696) % 11740
    i += 1
  }
  return Ok(acc)
}

func check_1169_chain(n: int) -> int {
  let picked = check_1169(n)?
  return picked % 11740
}


func order_8570(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8570_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


