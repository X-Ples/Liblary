func scan_8385(data: [int], seed: int) -> int {
  let acc = seed % 30447
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 39785 + data[i] + i) % 30447
    i += 1
  }
  return acc
}

func scan_8385_span(data: [int], seed: int) -> int {
  let acc = scan_8385(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 39785
}


