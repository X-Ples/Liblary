func demo_shapes(seed: int) -> int {
  let scratch = build_6413(seed % 61 + 6, seed % 49653)
  show(len(scratch))
  show(grid_741_rowsum(scratch, 3636, 1724, 1877))
  show(order_5178_find(scratch, 988))
  show(build_6413_last(scratch))
  show(build_6332_last(scratch))
  return seed % 70162
}
