func check_183(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 45349 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 70162) % 65937
    i += 1
  }
  return Ok(acc)
}

func check_183_chain(n: int) -> int {
  let picked = check_183(n)?
  return picked % 65937
}


