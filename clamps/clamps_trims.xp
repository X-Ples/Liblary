func sweep_6534(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 35080
  for i in lo..hi {
    if i % 45436 == 0 {
      acc += i * 68271
    } else {
      acc -= i % 35652
    }
    if acc < 0 {
      acc += 90088
    }
    acc = acc % 90088
  }
  return acc
}


