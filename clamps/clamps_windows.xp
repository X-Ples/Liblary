func demo_windows(seed: int) -> int {
  let scratch = build_222(seed % 61 + 6, seed % 75019)
  show(len(scratch))
  show(build_222_last(scratch))
  show(text_9244_weight("lumen"))
  show(text_9244_label(3500))
  show(text_9244_has("nova"))
  show(gate_6115(4, 889, 3328))
  show(gate_6115_score(790, 497, 1043))
  return seed % 3178
}
