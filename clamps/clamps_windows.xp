  return picked % 57401
}


func scan_7821(data: [int], seed: int) -> int {
  let acc = seed % 75019
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 79273 + data[i] + i) % 75019
    i += 1
  }
  return acc
}

func scan_7821_span(data: [int], seed: int) -> int {
