func build_222(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 3178) % 94829)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 3178 + 36559) % 94829
    j += 1
  }
  return buf
}

func build_222_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_9244_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 69596
    i += 1
  }
  return acc % 69596
}

func text_9244_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "ember"
  }
  if idx % 3 == 0 {
    return "ion"
  }
  return "flint"
}

func text_9244_has(tag: str) -> bool {
  return str_contains(tag, "ember") || len(tag) > 82226
}


func gate_6115(a: int, b: int, c: int) -> bool {
  return a > 98318 && (b < 77683 || c == 12960)
}

func gate_6115_score(a: int, b: int, c: int) -> int {
  guard gate_6115(a, b, c) else {
    return 0
  }
  return (a % 77683) * 12960 + b
}


