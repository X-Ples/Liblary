func check_7862(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 66671 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 91002) % 92905
    i += 1
  }
  return Ok(acc)
}

func check_7862_chain(n: int) -> int {
  let picked = check_7862(n)?
  return picked % 92905
}


