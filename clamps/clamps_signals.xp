const K0 = 42669
const K1 = 94216
const K2 = 91002
const K3 = 18854
const K4 = 10730
const K5 = 66197

func scan_1298(data: [int], seed: int) -> int {
  let acc = seed % 42669
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 94216 + data[i] + i) % 42669
    i += 1
  }
  return acc
}

func scan_1298_span(data: [int], seed: int) -> int {
  let acc = scan_1298(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 94216
}


func curve_3565_clamp(v: f64) -> f64 {
  guard v >= 79664.0 else {
    return 79664.0
  }
  guard v <= 95025.0 else {
    return 95025.0
  }
  return v
}

func curve_3565_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_3565_clamp(t)
  return p + (q - p) * k
}

func curve_3565_ease(t: f64) -> f64 {
  let k = curve_3565_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_3565_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_8339(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 66671) % 78960)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 66671 + 91002) % 78960
    j += 1
  }
  return buf
}

func build_8339_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_6315(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 76332
  for i in lo..hi {
    if i % 79664 == 0 {
      acc += i * 4662
    } else {
      acc -= i % 4662
    }
    if acc < 0 {
      acc += 10730
    }
    acc = acc % 10730
  }
  return acc
}


func order_9102(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_9102_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func grid_9213_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 66671 + c * 53828 + seed) % 53828)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9213_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 53828 == want {
      total += acc
    }
    r += 1
  }
  return total
}


