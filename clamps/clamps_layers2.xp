func demo_layers2(seed: int) -> int {
  let scratch = build_351(seed % 61 + 6, seed % 80927)
  show(len(scratch))
  show(text_1933_weight("gamma"))
  show(text_1933_label(1471))
  show(text_1933_has("nova"))
  show(build_351_last(scratch))
  show(text_7312_weight("ridge"))
  show(text_7312_label(2687))
  return seed % 41310
}
