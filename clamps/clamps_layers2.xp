    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 88617 + c * 24314 + seed) % 24314)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5877_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
