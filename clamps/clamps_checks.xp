func check_6463(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 42365 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 79196) % 16230
    i += 1
  }
  return Ok(acc)
}

func check_6463_chain(n: int) -> int {
  let picked = check_6463(n)?
  return picked % 16230
}


