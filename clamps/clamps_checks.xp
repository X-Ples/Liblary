func sweep_5613(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 77688
  for i in lo..hi {
    if i % 21743 == 0 {
      acc += i * 90845
    } else {
      acc -= i % 99692
    }
    if acc < 0 {
      acc += 21743
    }
    acc = acc % 21743
  }
  return acc
}


