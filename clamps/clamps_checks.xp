func build_4713(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 38360) % 66312)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 38360 + 77688) % 66312
    j += 1
  }
  return buf
}

func build_4713_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_2725() -> [int] {
  return [3859, 2119, 969, 3027, 2496, 1116, 3726, 737, 3338, 3754]
}

func row_2725_at(i: int) -> int {
  let row = row_2725()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_2725_sum(limit: int) -> int {
  let row = row_2725()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_2725_best() -> int {
  let row = row_2725()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


