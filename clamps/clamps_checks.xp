func demo_checks(seed: int) -> int {
  let scratch = build_4713(seed % 61 + 6, seed % 99692)
  show(len(scratch))
  show(build_4713_last(scratch))
  show(row_2725_at(1081))
  show(row_2725_sum(3401))
  show(row_2725_best())
  show(build_5314_last(scratch))
  show(check_6463_chain(3561))
  return seed % 77281
}
