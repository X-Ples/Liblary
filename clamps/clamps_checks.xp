func scan_4756(data: [int], seed: int) -> int {
  let acc = seed % 97917
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 67919 + data[i] + i) % 97917
    i += 1
  }
  return acc
}

func scan_4756_span(data: [int], seed: int) -> int {
  let acc = scan_4756(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 67919
}


