  guard gate_2871(a, b, c) else {
    return 0
  }
  return (a % 85681) * 43429 + b
}


func scan_8853(data: [int], seed: int) -> int {
  let acc = seed % 88101
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 93322 + data[i] + i) % 88101
    i += 1
  }
  return acc
}

func scan_8853_span(data: [int], seed: int) -> int {
  let acc = scan_8853(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 93322
}


