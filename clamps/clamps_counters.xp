func sweep_3345(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 14207
  for i in lo..hi {
    if i % 51817 == 0 {
      acc += i * 43429
    } else {
      acc -= i % 93322
    }
    if acc < 0 {
      acc += 31470
    }
    acc = acc % 31470
  }
  return acc
}


func build_2460(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 18359) % 88101)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 18359 + 88101) % 88101
    j += 1
  }
  return buf
}

func build_2460_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


