func check_3851(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 35048 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 83370) % 22402
    i += 1
  }
  return Ok(acc)
}

func check_3851_chain(n: int) -> int {
  let picked = check_3851(n)?
  return picked % 22402
}


