func sweep_5017(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 21163
  for i in lo..hi {
    if i % 71173 == 0 {
      acc += i * 95405
    } else {
      acc -= i % 40128
    }
    if acc < 0 {
      acc += 3718
    }
    acc = acc % 3718
  }
  return acc
}


