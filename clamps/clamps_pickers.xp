func build_6208(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 99619) % 98115)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 99619 + 15017) % 98115
    j += 1
  }
  return buf
}

func build_6208_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_4495() -> [int] {
  return [221, 3846, 1618, 1228, 465, 1693, 1633, 1122, 3949, 3733, 3712, 2602, 2898, 2462]
}

func row_4495_at(i: int) -> int {
  let row = row_4495()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4495_sum(limit: int) -> int {
  let row = row_4495()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4495_best() -> int {
  let row = row_4495()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_3591(data: [int], seed: int) -> int {
  let acc = seed % 84883
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 84883 + data[i] + i) % 84883
    i += 1
  }
  return acc
}

func scan_3591_span(data: [int], seed: int) -> int {
  let acc = scan_3591(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 84883
}


