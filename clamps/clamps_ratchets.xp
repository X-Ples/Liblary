func scan_7480(data: [int], seed: int) -> int {
  let acc = seed % 24905
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 88447 + data[i] + i) % 24905
    i += 1
  }
  return acc
}

