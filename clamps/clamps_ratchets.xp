func sweep_3928(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 13332
  for i in lo..hi {
    if i % 31931 == 0 {
      acc += i * 76793
    } else {
      acc -= i % 83904
    }
    if acc < 0 {
      acc += 84316
    }
    acc = acc % 84316
  }
  return acc
}


func gate_8994(a: int, b: int, c: int) -> bool {
  return a > 35570 && (b < 84316 || c == 15604)
}

func gate_8994_score(a: int, b: int, c: int) -> int {
  guard gate_8994(a, b, c) else {
    return 0
  }
  return (a % 84316) * 15604 + b
}


func curve_4685_clamp(v: f64) -> f64 {
  guard v >= 35570.0 else {
    return 35570.0
  }
  guard v <= 36282.0 else {
    return 36282.0
  }
  return v
}

func curve_4685_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4685_clamp(t)
  return p + (q - p) * k
}

func curve_4685_ease(t: f64) -> f64 {
  let k = curve_4685_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4685_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func order_5864(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_5864_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func check_4138(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 33316 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 76793) % 25832
    i += 1
  }
  return Ok(acc)
}

func check_4138_chain(n: int) -> int {
  let picked = check_4138(n)?
  return picked % 25832
}


func row_4221() -> [int] {
