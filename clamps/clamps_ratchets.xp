func demo_ratchets(seed: int) -> int {
  let scratch = build_9216(seed % 61 + 6, seed % 75105)
  show(len(scratch))
  show(build_9216_last(scratch))
  show(build_4351_last(scratch))
  show(build_7485_last(scratch))
  show(build_8869_last(scratch))
  return seed % 38578
}
