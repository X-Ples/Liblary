func build_8965(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 51379) % 11811)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 51379 + 26522) % 11811
    j += 1
  }
  return buf
}

func build_8965_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_9287(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 26522
  for i in lo..hi {
    if i % 8562 == 0 {
      acc += i * 11811
    } else {
      acc -= i % 11811
    }
    if acc < 0 {
      acc += 363
    }
    acc = acc % 363
  }
  return acc
}


func grid_5012_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 92546 + c * 51379 + seed) % 51379)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5012_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 51379 == want {
      total += acc
    }
    r += 1
  }
  return total
}


