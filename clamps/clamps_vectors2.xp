func row_4396() -> [int] {
  return [3719, 3629, 2251, 373, 2046, 3373, 2301, 3590, 136, 1757, 2215, 2791, 2321, 3884, 803, 3740, 2391, 3037]
}

func row_4396_at(i: int) -> int {
  let row = row_4396()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4396_sum(limit: int) -> int {
  let row = row_4396()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4396_best() -> int {
  let row = row_4396()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func demo_vectors2(seed: int) -> int {
  let scratch = build_8965(seed % 61 + 6, seed % 624)
  show(len(scratch))
  show(build_8965_last(scratch))
  show(sweep_9287(1291, 1241))
  show(grid_5012_rowsum(scratch, 261, 2975, 196))
  show(build_567_last(scratch))
  show(sweep_7574(3733, 1865))
  return seed % 40039
}
