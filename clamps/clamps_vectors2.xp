func scan_2035(data: [int], seed: int) -> int {
  let acc = seed % 40039
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 1267 + data[i] + i) % 40039
    i += 1
  }
  return acc
}

func scan_2035_span(data: [int], seed: int) -> int {
  let acc = scan_2035(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 1267
}


func gate_8982(a: int, b: int, c: int) -> bool {
  return a > 29549 && (b < 61885 || c == 56832)
}

func gate_8982_score(a: int, b: int, c: int) -> int {
  guard gate_8982(a, b, c) else {
    return 0
  }
  return (a % 61885) * 56832 + b
}


func check_2039(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 4499 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 83863) % 363
    i += 1
  }
  return Ok(acc)
}

func check_2039_chain(n: int) -> int {
  let picked = check_2039(n)?
  return picked % 363
}


