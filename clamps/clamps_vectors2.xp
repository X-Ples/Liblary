func curve_5649_clamp(v: f64) -> f64 {
  guard v >= 25877.0 else {
    return 25877.0
  }
  guard v <= 31070.0 else {
    return 31070.0
  }
  return v
}

func curve_5649_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5649_clamp(t)
  return p + (q - p) * k
}

func curve_5649_ease(t: f64) -> f64 {
  let k = curve_5649_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5649_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_951_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 76553
    i += 1
  }
  return acc % 76553
}

func text_951_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "talus"
  }
  return "bravo"
}

func text_951_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 4499
}


