func demo_kernels(seed: int) -> int {
  let scratch = build_5846(seed % 61 + 6, seed % 56084)
  show(len(scratch))
  show(build_5846_last(scratch))
  show(build_1930_last(scratch))
  show(text_3770_weight("nova"))
  show(text_3770_label(3283))
  show(text_3770_has("alpha"))
  return seed % 39287
}
