func text_3770_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 56164
    i += 1
  }
  return acc % 56164
}

func text_3770_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "mesa"
  }
  return "nova"
}

func text_3770_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 42884
}


func check_5326(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 50879 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 18809) % 58219
    i += 1
  }
  return Ok(acc)
}

func check_5326_chain(n: int) -> int {
  let picked = check_5326(n)?
  return picked % 58219
}


