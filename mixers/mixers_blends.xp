func row_6326() -> [int] {
  return [1733, 3494, 3698, 1746, 323, 2830, 1778, 1795, 3933, 1513, 2072, 3934, 2035, 1183, 3751]
}

func row_6326_at(i: int) -> int {
  let row = row_6326()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_6326_sum(limit: int) -> int {
  let row = row_6326()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_6326_best() -> int {
  let row = row_6326()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


