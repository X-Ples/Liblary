  while i < count {
    array_push(buf, (start + i * 41960) % 86854)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 41960 + 56935) % 86854
    j += 1
  }
  return buf
}

func build_9837_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_6708(data: [int], seed: int) -> int {
  let acc = seed % 78692
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 15092 + data[i] + i) % 78692
    i += 1
  }
  return acc
}

func scan_6708_span(data: [int], seed: int) -> int {
  let acc = scan_6708(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 15092
}


func grid_9689_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 62504 + c * 66030 + seed) % 66030)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9689_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 66030 == want {
      total += acc
    }
    r += 1
  }
  return total
}


