func sweep_8628(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 17706
  for i in lo..hi {
    if i % 86854 == 0 {
      acc += i * 83853
    } else {
      acc -= i % 78692
    }
    if acc < 0 {
      acc += 86854
    }
    acc = acc % 86854
  }
  return acc
}


func order_7330(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_7330_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func build_9837(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
