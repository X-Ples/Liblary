func check_3494(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 17264 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 21421) % 98791
    i += 1
  }
  return Ok(acc)
}

func check_3494_chain(n: int) -> int {
  let picked = check_3494(n)?
  return picked % 98791
}


func demo_blocks(seed: int) -> int {
  let scratch = build_9218(seed % 61 + 6, seed % 31404)
  show(len(scratch))
  show(text_7904_weight("talus"))
  show(text_7904_label(1108))
  show(text_7904_has("flint"))
  show(gate_6911(183, 3090, 665))
  show(gate_6911_score(563, 3142, 3930))
  return seed % 14844
}
