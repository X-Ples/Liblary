func text_7904_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 24826
    i += 1
  }
  return acc % 24826
}

func text_7904_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "omega"
  }
  if idx % 3 == 0 {
    return "kilo"
  }
  return "sigma"
}

func text_7904_has(tag: str) -> bool {
  return str_contains(tag, "omega") || len(tag) > 53388
}


func curve_6701_clamp(v: f64) -> f64 {
  guard v >= 58799.0 else {
    return 58799.0
  }
  guard v <= 95506.0 else {
    return 95506.0
  }
  return v
}

func curve_6701_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6701_clamp(t)
  return p + (q - p) * k
}

func curve_6701_ease(t: f64) -> f64 {
  let k = curve_6701_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6701_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func gate_6911(a: int, b: int, c: int) -> bool {
  return a > 75458 && (b < 14844 || c == 91287)
}

func gate_6911_score(a: int, b: int, c: int) -> int {
  guard gate_6911(a, b, c) else {
    return 0
  }
  return (a % 14844) * 91287 + b
}


func order_6940(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_6940_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


