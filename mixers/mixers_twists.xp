func sweep_872(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 48220
  for i in lo..hi {
    if i % 25941 == 0 {
      acc += i * 31096
    } else {
      acc -= i % 84187
    }
    if acc < 0 {
      acc += 20755
    }
    acc = acc % 20755
  }
  return acc
}


