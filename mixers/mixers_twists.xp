func check_8162(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 49046 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 22544) % 73464
    i += 1
  }
  return Ok(acc)
}

func check_8162_chain(n: int) -> int {
  let picked = check_8162(n)?
  return picked % 73464
}


