func text_954_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 98949
    i += 1
  }
  return acc % 98949
}

func text_954_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "omega"
  }
  if idx % 3 == 0 {
    return "ridge"
  }
  return "kilo"
}

func text_954_has(tag: str) -> bool {
  return str_contains(tag, "omega") || len(tag) > 17009
}


func curve_5220_clamp(v: f64) -> f64 {
  guard v >= 49046.0 else {
    return 49046.0
  }
  guard v <= 53465.0 else {
    return 53465.0
  }
  return v
}

func curve_5220_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5220_clamp(t)
  return p + (q - p) * k
}

func curve_5220_ease(t: f64) -> f64 {
  let k = curve_5220_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5220_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


