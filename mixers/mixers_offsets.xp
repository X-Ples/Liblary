func build_6047(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 68667) % 28525)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 68667 + 91431) % 28525
    j += 1
  }
  return buf
}

func build_6047_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func grid_8921_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 91431 + c * 29339 + seed) % 29339)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_8921_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 29339 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func text_5833_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 60844
    i += 1
  }
  return acc % 60844
}

func text_5833_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "sigma"
  }
  if idx % 3 == 0 {
    return "bravo"
  }
  return "prism"
}

func text_5833_has(tag: str) -> bool {
  return str_contains(tag, "sigma") || len(tag) > 63100
}


