func sweep_6705(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 38326
  for i in lo..hi {
    if i % 86827 == 0 {
      acc += i * 77009
    } else {
      acc -= i % 86827
    }
    if acc < 0 {
      acc += 55491
    }
    acc = acc % 55491
  }
  return acc
}


