func build_7480(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 55491) % 51006)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 55491 + 46894) % 51006
    j += 1
  }
  return buf
}

func build_7480_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_4840() -> [int] {
  return [1257, 2144, 1276, 482, 2195, 3690, 1814, 2457, 1125, 1812, 616, 2937, 2044, 43, 2402, 129, 280, 4062]
}

func row_4840_at(i: int) -> int {
  let row = row_4840()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4840_sum(limit: int) -> int {
  let row = row_4840()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4840_best() -> int {
  let row = row_4840()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_6067_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 46286
    i += 1
  }
  return acc % 46286
}

func text_6067_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "bravo"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "jetty"
}

func text_6067_has(tag: str) -> bool {
  return str_contains(tag, "bravo") || len(tag) > 63220
}


