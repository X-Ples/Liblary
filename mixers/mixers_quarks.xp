func demo_quarks(seed: int) -> int {
  let scratch = build_7480(seed % 61 + 6, seed % 51006)
  show(len(scratch))
  show(build_7480_last(scratch))
  show(row_4840_at(3180))
  show(row_4840_sum(1987))
