func check_5278(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 71586 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 92869) % 71029
    i += 1
  }
  return Ok(acc)
}

func check_5278_chain(n: int) -> int {
  let picked = check_5278(n)?
  return picked % 71029
}


