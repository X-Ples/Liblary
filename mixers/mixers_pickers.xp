func scan_6638(data: [int], seed: int) -> int {
  let acc = seed % 10116
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 71029 + data[i] + i) % 10116
    i += 1
  }
  return acc
}

func scan_6638_span(data: [int], seed: int) -> int {
  let acc = scan_6638(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 71029
}


func grid_7310_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 92869 + c * 26748 + seed) % 26748)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_7310_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 26748 == want {
      total += acc
    }
    r += 1
  }
  return total
}


