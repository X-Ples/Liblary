func sweep_8920(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 18530
  for i in lo..hi {
    if i % 79759 == 0 {
      acc += i * 13081
    } else {
      acc -= i % 13943
    }
    if acc < 0 {
      acc += 7666
    }
    acc = acc % 7666
  }
  return acc
}


