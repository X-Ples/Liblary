func gate_2799(a: int, b: int, c: int) -> bool {
  return a > 79759 && (b < 19905 || c == 97256)
}

func gate_2799_score(a: int, b: int, c: int) -> int {
  guard gate_2799(a, b, c) else {
    return 0
  }
  return (a % 19905) * 97256 + b
}


func build_484(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 95578) % 94241)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 95578 + 54369) % 94241
    j += 1
  }
  return buf
}

func build_484_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_6199(data: [int], seed: int) -> int {
  let acc = seed % 65035
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 35054 + data[i] + i) % 65035
    i += 1
  }
  return acc
}

func scan_6199_span(data: [int], seed: int) -> int {
  let acc = scan_6199(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 35054
}


