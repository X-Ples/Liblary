func curve_6567_clamp(v: f64) -> f64 {
  guard v >= 94241.0 else {
    return 94241.0
  }
  guard v <= 95578.0 else {
    return 95578.0
  }
  return v
}

func curve_6567_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_6567_clamp(t)
  return p + (q - p) * k
}

func curve_6567_ease(t: f64) -> f64 {
  let k = curve_6567_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_6567_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func text_2691_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 29057
    i += 1
  }
  return acc % 29057
}

func text_2691_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "mesa"
  }
  if idx % 3 == 0 {
    return "flint"
  }
  return "cargo"
}

func text_2691_has(tag: str) -> bool {
  return str_contains(tag, "mesa") || len(tag) > 40708
}


