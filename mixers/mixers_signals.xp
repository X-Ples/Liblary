func demo_signals(seed: int) -> int {
  let scratch = build_484(seed % 61 + 6, seed % 97040)
  show(len(scratch))
  show(gate_2799(518, 2305, 2869))
  show(gate_2799_score(3324, 3500, 2286))
  show(build_484_last(scratch))
  show(scan_6199(scratch, 723))
  return seed % 29057
}
