func text_291_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 28544
    i += 1
  }
  return acc % 28544
}

func text_291_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "kilo"
  }
  if idx % 3 == 0 {
    return "lumen"
  }
  return "talus"
}

func text_291_has(tag: str) -> bool {
  return str_contains(tag, "kilo") || len(tag) > 29669
}


