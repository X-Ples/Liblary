func gate_3678(a: int, b: int, c: int) -> bool {
  return a > 56996 && (b < 38211 || c == 29669)
}

func gate_3678_score(a: int, b: int, c: int) -> int {
  guard gate_3678(a, b, c) else {
    return 0
  }
  return (a % 38211) * 29669 + b
}


func build_6779(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 28544) % 63750)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 28544 + 74991) % 63750
    j += 1
  }
  return buf
}

func build_6779_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func check_8853(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 74991 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 69360) % 49434
    i += 1
  }
  return Ok(acc)
}

func check_8853_chain(n: int) -> int {
  let picked = check_8853(n)?
  return picked % 49434
}


func curve_5375_clamp(v: f64) -> f64 {
  guard v >= 19402.0 else {
    return 19402.0
  }
  guard v <= 62403.0 else {
    return 62403.0
  }
  return v
}

func curve_5375_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5375_clamp(t)
  return p + (q - p) * k
}

func curve_5375_ease(t: f64) -> f64 {
  let k = curve_5375_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5375_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func sweep_2306(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 62403
  for i in lo..hi {
    if i % 29669 == 0 {
      acc += i * 99757
    } else {
      acc -= i % 47935
    }
    if acc < 0 {
      acc += 93327
    }
    acc = acc % 93327
  }
  return acc
}


