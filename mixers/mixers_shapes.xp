func demo_shapes(seed: int) -> int {
  let scratch = build_6779(seed % 61 + 6, seed % 62403)
  show(len(scratch))
  show(gate_3678(1490, 668, 719))
  show(gate_3678_score(2462, 2492, 415))
  show(build_6779_last(scratch))
  show(check_8853_chain(3919))
