func check_3576(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 34650 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 60306) % 68763
    i += 1
  }
  return Ok(acc)
}

func check_3576_chain(n: int) -> int {
  let picked = check_3576(n)?
  return picked % 68763
}


