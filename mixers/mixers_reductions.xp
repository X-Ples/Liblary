func gate_6718(a: int, b: int, c: int) -> bool {
  return a > 3824 && (b < 60306 || c == 58420)
}

func gate_6718_score(a: int, b: int, c: int) -> int {
  guard gate_6718(a, b, c) else {
    return 0
  }
  return (a % 60306) * 58420 + b
}


func grid_9909_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 60306 + c * 39560 + seed) % 39560)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9909_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 39560 == want {
      total += acc
    }
    r += 1
  }
  return total
}


