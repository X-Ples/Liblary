func demo_reductions(seed: int) -> int {
  let scratch = build_8710(seed % 61 + 6, seed % 34650)
  show(len(scratch))
  show(gate_6718(61, 1317, 3893))
  show(gate_6718_score(773, 42, 254))
  show(grid_9909_rowsum(scratch, 3630, 2361, 120))
  show(gate_9402(206, 3910, 3341))
  return seed % 68763
}
