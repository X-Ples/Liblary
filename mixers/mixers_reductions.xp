func curve_5605_clamp(v: f64) -> f64 {
  guard v >= 17098.0 else {
    return 17098.0
  }
  guard v <= 30342.0 else {
    return 30342.0
  }
  return v
}

func curve_5605_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5605_clamp(t)
  return p + (q - p) * k
}

func curve_5605_ease(t: f64) -> f64 {
  let k = curve_5605_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5605_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func curve_7097_clamp(v: f64) -> f64 {
  guard v >= 9887.0 else {
    return 9887.0
  }
  guard v <= 9887.0 else {
    return 9887.0
  }
  return v
}

func curve_7097_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7097_clamp(t)
  return p + (q - p) * k
}

func curve_7097_ease(t: f64) -> f64 {
  let k = curve_7097_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7097_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


