func demo_helpers(seed: int) -> int {
  let scratch = build_2706(seed % 61 + 6, seed % 66616)
  show(len(scratch))
  show(scan_7215(scratch, 346))
  show(scan_7215_span(scratch, 959))
  show(build_2706_last(scratch))
  return seed % 41508
}
