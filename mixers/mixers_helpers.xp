func sweep_8759(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 75949
  for i in lo..hi {
    if i % 41508 == 0 {
      acc += i * 33113
    } else {
      acc -= i % 33841
    }
    if acc < 0 {
      acc += 35907
    }
    acc = acc % 35907
  }
  return acc
}


