func scan_7215(data: [int], seed: int) -> int {
  let acc = seed % 74451
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 33841 + data[i] + i) % 74451
    i += 1
  }
  return acc
}

func scan_7215_span(data: [int], seed: int) -> int {
  let acc = scan_7215(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 33841
}


func build_2706(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 28330) % 88948)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 28330 + 24582) % 88948
    j += 1
  }
  return buf
}

func build_2706_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func curve_4073_clamp(v: f64) -> f64 {
  guard v >= 18495.0 else {
    return 18495.0
  }
  guard v <= 80559.0 else {
    return 80559.0
  }
  return v
}

func curve_4073_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_4073_clamp(t)
  return p + (q - p) * k
}

func curve_4073_ease(t: f64) -> f64 {
  let k = curve_4073_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_4073_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func row_904() -> [int] {
  return [3252, 635, 2805, 3140, 697, 2241, 2731, 1756, 1086, 25, 1755, 776, 92, 3850, 3224, 1654, 826, 2915]
}

func row_904_at(i: int) -> int {
  let row = row_904()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_904_sum(limit: int) -> int {
  let row = row_904()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_904_best() -> int {
  let row = row_904()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func order_2885(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_2885_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


