func demo_tables(seed: int) -> int {
  let scratch = build_9768(seed % 61 + 6, seed % 54695)
  show(len(scratch))
  show(build_9768_last(scratch))
  show(row_8849_at(3869))
  show(row_8849_sum(1172))
  show(row_8849_best())
  show(grid_7294_rowsum(scratch, 890, 336, 2046))
  show(order_2470_find(scratch, 393))
  return seed % 12934
}
