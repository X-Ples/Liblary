func row_3745() -> [int] {
  return [981, 2615, 3083, 3639, 125, 1192, 2203, 3731, 2703, 1016, 785, 2455, 1549, 3926]
}

func row_3745_at(i: int) -> int {
  let row = row_3745()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3745_sum(limit: int) -> int {
  let row = row_3745()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3745_best() -> int {
  let row = row_3745()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


