    array_push(buf, (start + i * 72149) % 94235)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 72149 + 35077) % 94235
    j += 1
  }
  return buf
}

func build_1383_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
