func build_6611(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 17040) % 44299)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 17040 + 44299) % 44299
    j += 1
  }
  return buf
}

func build_6611_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_5283(data: [int], seed: int) -> int {
  let acc = seed % 40313
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 71800 + data[i] + i) % 40313
    i += 1
  }
  return acc
}

func scan_5283_span(data: [int], seed: int) -> int {
  let acc = scan_5283(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 71800
}


func row_4747() -> [int] {
  return [444, 1881, 2066, 3832, 3736, 2830, 1920, 209, 1855, 2685, 735, 258, 1498, 2575, 4006, 1577, 1580, 2255, 1454, 839]
}

func row_4747_at(i: int) -> int {
  let row = row_4747()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_4747_sum(limit: int) -> int {
  let row = row_4747()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_4747_best() -> int {
  let row = row_4747()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func check_1701(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 27982 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 48209) % 17040
    i += 1
  }
  return Ok(acc)
}

func check_1701_chain(n: int) -> int {
  let picked = check_1701(n)?
  return picked % 17040
}


func gate_5740(a: int, b: int, c: int) -> bool {
  return a > 37167 && (b < 85119 || c == 94603)
}

func gate_5740_score(a: int, b: int, c: int) -> int {
  guard gate_5740(a, b, c) else {
    return 0
  }
  return (a % 85119) * 94603 + b
}


func text_4055_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 34078
    i += 1
  }
  return acc % 34078
}

func text_4055_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "gamma"
  }
  return "prism"
}

func text_4055_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 48209
}


func curve_5384_clamp(v: f64) -> f64 {
  guard v >= 40313.0 else {
    return 40313.0
  }
  guard v <= 74885.0 else {
    return 74885.0
  }
  return v
}

func curve_5384_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_5384_clamp(t)
  return p + (q - p) * k
}

func curve_5384_ease(t: f64) -> f64 {
  let k = curve_5384_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_5384_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


