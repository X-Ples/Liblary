func build_8277(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 45768) % 13344)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 45768 + 7122) % 13344
    j += 1
  }
  return buf
}

func build_8277_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_3340() -> [int] {
  return [919, 871, 3511, 4052, 596, 3991, 3391, 1179, 785, 3011, 4035, 2786, 1696, 1850, 3680, 514]
}

func row_3340_at(i: int) -> int {
  let row = row_3340()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_3340_sum(limit: int) -> int {
  let row = row_3340()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_3340_best() -> int {
  let row = row_3340()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func text_7536_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 13344
    i += 1
  }
  return acc % 13344
}

func text_7536_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "flint"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "ember"
}

func text_7536_has(tag: str) -> bool {
  return str_contains(tag, "flint") || len(tag) > 99158
}


