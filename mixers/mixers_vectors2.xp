func demo_vectors2(seed: int) -> int {
  let scratch = build_3347(seed % 61 + 6, seed % 67220)
  show(len(scratch))
  show(sweep_9317(668, 2694))
  show(sweep_9331(1597, 1253))
  show(build_3347_last(scratch))
  show(gate_2818(3027, 1519, 1702))
  show(gate_2818_score(3390, 880, 2976))
  return seed % 61744
}
