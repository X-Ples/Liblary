func row_7656() -> [int] {
  return [3374, 2039, 870, 646, 3356, 1070, 1113, 2473, 2558, 1382, 3624]
}

func row_7656_at(i: int) -> int {
  let row = row_7656()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7656_sum(limit: int) -> int {
  let row = row_7656()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7656_best() -> int {
  let row = row_7656()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


