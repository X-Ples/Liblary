func build_3347(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 40143) % 92536)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 40143 + 10372) % 92536
    j += 1
  }
  return buf
}

func build_3347_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_2818(a: int, b: int, c: int) -> bool {
  return a > 64305 && (b < 61798 || c == 44719)
}

func gate_2818_score(a: int, b: int, c: int) -> int {
  guard gate_2818(a, b, c) else {
    return 0
  }
  return (a % 61798) * 44719 + b
}


func grid_5692_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 67730 + c * 10372 + seed) % 10372)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_5692_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 10372 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func scan_8493(data: [int], seed: int) -> int {
  let acc = seed % 56917
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 90782 + data[i] + i) % 56917
    i += 1
  }
  return acc
}

func scan_8493_span(data: [int], seed: int) -> int {
  let acc = scan_8493(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 90782
}


