func sweep_9317(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 56881
  for i in lo..hi {
    if i % 42485 == 0 {
      acc += i * 30498
    } else {
      acc -= i % 40143
    }
    if acc < 0 {
      acc += 67730
    }
    acc = acc % 67730
  }
  return acc
}


