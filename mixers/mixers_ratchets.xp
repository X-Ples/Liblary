func demo_ratchets(seed: int) -> int {
  let scratch = build_3690(seed % 61 + 6, seed % 8644)
  show(len(scratch))
  show(build_3690_last(scratch))
  show(sweep_8998(3335, 3736))
  show(scan_4871(scratch, 3466))
  return seed % 67453
}
