func build_3690(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 44822) % 58547)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 44822 + 40641) % 58547
    j += 1
  }
  return buf
}

func build_3690_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func sweep_8998(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 8644
  for i in lo..hi {
    if i % 95917 == 0 {
      acc += i * 53074
    } else {
      acc -= i % 56059
    }
    if acc < 0 {
      acc += 95917
    }
    acc = acc % 95917
  }
  return acc
}


func scan_4871(data: [int], seed: int) -> int {
  let acc = seed % 56355
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 58547 + data[i] + i) % 56355
    i += 1
  }
  return acc
}

func scan_4871_span(data: [int], seed: int) -> int {
  let acc = scan_4871(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 58547
}


func order_8102(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_8102_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func curve_1299_clamp(v: f64) -> f64 {
  guard v >= 35046.0 else {
    return 35046.0
  }
  guard v <= 56059.0 else {
    return 56059.0
  }
  return v
}

func curve_1299_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_1299_clamp(t)
  return p + (q - p) * k
}

func curve_1299_ease(t: f64) -> f64 {
  let k = curve_1299_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_1299_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


