func row_7533() -> [int] {
  return [331, 2247, 3977, 1564, 1093, 1247, 647, 1184, 1065, 245, 3368, 500, 1604, 2468, 2636, 2619, 865, 1835]
}

func row_7533_at(i: int) -> int {
  let row = row_7533()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_7533_sum(limit: int) -> int {
  let row = row_7533()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_7533_best() -> int {
  let row = row_7533()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func curve_7893_clamp(v: f64) -> f64 {
  guard v >= 43670.0 else {
    return 43670.0
  }
  guard v <= 98693.0 else {
    return 98693.0
  }
  return v
}

func curve_7893_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_7893_clamp(t)
  return p + (q - p) * k
}

func curve_7893_ease(t: f64) -> f64 {
  let k = curve_7893_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_7893_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func build_8174(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 95120) % 86026)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 95120 + 97049) % 86026
    j += 1
  }
  return buf
}

func build_8174_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func scan_4406(data: [int], seed: int) -> int {
  let acc = seed % 43670
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 26684 + data[i] + i) % 43670
    i += 1
  }
  return acc
}

func scan_4406_span(data: [int], seed: int) -> int {
  let acc = scan_4406(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 26684
}


func text_1902_weight(tag: str) -> int {
