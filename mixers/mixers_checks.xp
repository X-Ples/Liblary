func check_2568(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 40913 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 32891) % 40969
    i += 1
  }
  return Ok(acc)
}

func check_2568_chain(n: int) -> int {
  let picked = check_2568(n)?
  return picked % 40969
}


