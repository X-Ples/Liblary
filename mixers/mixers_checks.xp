func curve_8846_clamp(v: f64) -> f64 {
  guard v >= 18834.0 else {
    return 18834.0
  }
  guard v <= 30184.0 else {
    return 30184.0
  }
  return v
}

func curve_8846_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_8846_clamp(t)
  return p + (q - p) * k
}

func curve_8846_ease(t: f64) -> f64 {
  let k = curve_8846_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_8846_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func scan_7775(data: [int], seed: int) -> int {
  let acc = seed % 62806
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 69921 + data[i] + i) % 62806
    i += 1
  }
  return acc
}

func scan_7775_span(data: [int], seed: int) -> int {
  let acc = scan_7775(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 69921
}


