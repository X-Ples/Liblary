func sweep_5025(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 40913
  for i in lo..hi {
    if i % 34183 == 0 {
      acc += i * 62806
    } else {
      acc -= i % 10053
    }
    if acc < 0 {
      acc += 34183
    }
    acc = acc % 34183
  }
  return acc
}


func gate_2426(a: int, b: int, c: int) -> bool {
  return a > 18834 && (b < 5804 || c == 69921)
}

func gate_2426_score(a: int, b: int, c: int) -> int {
  guard gate_2426(a, b, c) else {
    return 0
  }
  return (a % 5804) * 69921 + b
}


func build_9416(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 34006) % 41510)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 34006 + 67338) % 41510
    j += 1
  }
  return buf
}

func build_9416_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


