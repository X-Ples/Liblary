func row_5872() -> [int] {
  return [3720, 2235, 159, 3213, 86, 2150, 3943, 3635, 3324, 3239, 1638, 2138, 3164, 3058, 712, 1163, 1868, 2154]
}

func row_5872_at(i: int) -> int {
  let row = row_5872()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_5872_sum(limit: int) -> int {
  let row = row_5872()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_5872_best() -> int {
  let row = row_5872()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


