func check_9045(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 11556 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 3170) % 26183
    i += 1
  }
  return Ok(acc)
}

func check_9045_chain(n: int) -> int {
  let picked = check_9045(n)?
  return picked % 26183
}


