func scan_4912(data: [int], seed: int) -> int {
  let acc = seed % 1538
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 9877 + data[i] + i) % 1538
    i += 1
  }
  return acc
}

func scan_4912_span(data: [int], seed: int) -> int {
  let acc = scan_4912(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 9877
}


func gate_8327(a: int, b: int, c: int) -> bool {
  return a > 43809 && (b < 13120 || c == 9877)
