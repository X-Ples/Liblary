func demo_counters(seed: int) -> int {
  let scratch = build_4054(seed % 61 + 6, seed % 93407)
  show(len(scratch))
  show(scan_4912(scratch, 1451))
  show(scan_4912_span(scratch, 932))
  show(gate_8327(329, 1958, 2258))
  return seed % 97868
}
