func sweep_4897(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 62302
  for i in lo..hi {
    if i % 71217 == 0 {
      acc += i * 1538
    } else {
      acc -= i % 87857
    }
    if acc < 0 {
      acc += 81655
    }
    acc = acc % 81655
  }
  return acc
}


