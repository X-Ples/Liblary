func grid_9587_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 13214 + c * 73005 + seed) % 73005)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9587_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 73005 == want {
      total += acc
    }
    r += 1
  }
  return total
}


func sweep_8454(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 30848
  for i in lo..hi {
    if i % 76248 == 0 {
      acc += i * 48074
    } else {
      acc -= i % 65914
    }
    if acc < 0 {
      acc += 29196
    }
    acc = acc % 29196
  }
  return acc
}


