func row_9796() -> [int] {
  return [3717, 2044, 3504, 681, 2204, 1612, 3484, 1459, 2976, 2268, 1802, 3776, 552, 565, 954, 417, 2377]
}

func row_9796_at(i: int) -> int {
  let row = row_9796()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9796_sum(limit: int) -> int {
  let row = row_9796()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9796_best() -> int {
  let row = row_9796()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


