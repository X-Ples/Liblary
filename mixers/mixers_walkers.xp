func demo_walkers(seed: int) -> int {
  let scratch = build_9923(seed % 61 + 6, seed % 58030)
  show(len(scratch))
  show(build_9923_last(scratch))
  show(text_5534_weight("lumen"))
  show(text_5534_label(2903))
  show(text_5534_has("sigma"))
