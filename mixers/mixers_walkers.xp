func build_9923(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 35731) % 35731)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 35731 + 73005) % 35731
    j += 1
  }
  return buf
}

func build_9923_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_5534_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 73005
    i += 1
  }
  return acc % 73005
}

func text_5534_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "cargo"
  }
  if idx % 3 == 0 {
    return "harbor"
  }
  return "delta"
}

func text_5534_has(tag: str) -> bool {
  return str_contains(tag, "cargo") || len(tag) > 48074
}


func gate_9688(a: int, b: int, c: int) -> bool {
  return a > 36723 && (b < 3823 || c == 73005)
}

func gate_9688_score(a: int, b: int, c: int) -> int {
  guard gate_9688(a, b, c) else {
    return 0
  }
  return (a % 3823) * 73005 + b
}


func curve_407_clamp(v: f64) -> f64 {
  guard v >= 85969.0 else {
    return 85969.0
  }
  guard v <= 92907.0 else {
    return 92907.0
  }
  return v
}

func curve_407_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_407_clamp(t)
  return p + (q - p) * k
}

func curve_407_ease(t: f64) -> f64 {
  let k = curve_407_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_407_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


func check_8339(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 92907 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 35731) % 69217
    i += 1
  }
  return Ok(acc)
}

func check_8339_chain(n: int) -> int {
  let picked = check_8339(n)?
  return picked % 69217
}


