func sweep_1460(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 99471
  for i in lo..hi {
    if i % 65078 == 0 {
      acc += i * 40577
    } else {
      acc -= i % 96010
    }
    if acc < 0 {
      acc += 56317
    }
    acc = acc % 56317
  }
  return acc
}


func order_3171(items: [int]) -> [int] {
  let out = []
  let n = len(items)
  guard n > 0 else {
    return out
  }
  let k = 0
  while k < n {
    array_push(out, items[k])
    k += 1
  }
  let i = 0
  while i < n {
    let j = 0
    while j < n - 1 - i {
      if out[j] > out[j + 1] {
        let tmp = out[j]
        out[j] = out[j + 1]
        out[j + 1] = tmp
      }
      j += 1
    }
    i += 1
  }
  return out
}

func order_3171_find(sorted: [int], want: int) -> int {
  let n = len(sorted)
  guard n > 0 else {
    return 0 - 1
  }
  let lo = 0
  let hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if sorted[mid] == want {
      return mid
    }
    if sorted[mid] < want {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return 0 - 1
}


func check_4253(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 28909 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 96010) % 17525
    i += 1
  }
  return Ok(acc)
}

func check_4253_chain(n: int) -> int {
  let picked = check_4253(n)?
  return picked % 17525
}


func grid_9339_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 5706 + c * 40577 + seed) % 40577)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_9339_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 40577 == want {
      total += acc
    }
    r += 1
  }
  return total
}


