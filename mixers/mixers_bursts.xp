func gate_9180(a: int, b: int, c: int) -> bool {
  return a > 17525 && (b < 65078 || c == 99471)
}

func gate_9180_score(a: int, b: int, c: int) -> int {
  guard gate_9180(a, b, c) else {
    return 0
  }
  return (a % 65078) * 99471 + b
}


func scan_1485(data: [int], seed: int) -> int {
  let acc = seed % 47571
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 77847 + data[i] + i) % 47571
    i += 1
  }
  return acc
}

func scan_1485_span(data: [int], seed: int) -> int {
  let acc = scan_1485(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 77847
}


func build_7475(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 24851) % 49746)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 24851 + 63440) % 49746
    j += 1
  }
  return buf
}

func build_7475_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


