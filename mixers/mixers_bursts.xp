func demo_bursts(seed: int) -> int {
  let scratch = build_7475(seed % 61 + 6, seed % 40577)
  show(len(scratch))
  show(gate_9180(318, 879, 839))
  show(gate_9180_score(363, 1808, 1488))
  show(scan_1485(scratch, 1293))
  show(scan_1485_span(scratch, 3743))
  show(build_7475_last(scratch))
  return seed % 6023
}
