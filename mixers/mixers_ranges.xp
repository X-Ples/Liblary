func scan_3259(data: [int], seed: int) -> int {
  let acc = seed % 27836
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 48063 + data[i] + i) % 27836
    i += 1
  }
  return acc
}

func scan_3259_span(data: [int], seed: int) -> int {
  let acc = scan_3259(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 48063
}


func check_7868(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 83656 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 27836) % 74885
    i += 1
  }
  return Ok(acc)
}

func check_7868_chain(n: int) -> int {
  let picked = check_7868(n)?
  return picked % 74885
}


