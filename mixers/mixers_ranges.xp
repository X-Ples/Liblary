func sweep_3680(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 1232
  for i in lo..hi {
    if i % 52006 == 0 {
      acc += i * 46856
    } else {
      acc -= i % 20732
    }
    if acc < 0 {
      acc += 20732
    }
    acc = acc % 20732
  }
  return acc
}


func build_1800(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 21487) % 83656)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 21487 + 46856) % 83656
    j += 1
  }
  return buf
}

func build_1800_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func gate_482(a: int, b: int, c: int) -> bool {
  return a > 67580 && (b < 21487 || c == 50548)
}

func gate_482_score(a: int, b: int, c: int) -> int {
  guard gate_482(a, b, c) else {
    return 0
  }
  return (a % 21487) * 50548 + b
}


func curve_428_clamp(v: f64) -> f64 {
  guard v >= 29173.0 else {
    return 29173.0
  }
  guard v <= 43282.0 else {
    return 43282.0
  }
  return v
}

func curve_428_mix(p: f64, q: f64, t: f64) -> f64 {
  let k = curve_428_clamp(t)
  return p + (q - p) * k
}

func curve_428_ease(t: f64) -> f64 {
  let k = curve_428_clamp(t)
  return k * k * (3.0 - 2.0 * k)
}

func curve_428_step(t: f64, period: f64) -> f64 {
  guard period > 0.0 else {
    return 0.0
  }
  let phase = t - (t / period) * period
  if phase < 0.0 {
    return 0.0 - phase
  }
  return phase
}


