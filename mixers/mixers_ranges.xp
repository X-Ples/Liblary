func demo_ranges(seed: int) -> int {
  let scratch = build_1800(seed % 61 + 6, seed % 35867)
  show(len(scratch))
  show(sweep_3680(1151, 2966))
  show(build_1800_last(scratch))
  show(gate_482(388, 1995, 625))
  return seed % 21487
}
