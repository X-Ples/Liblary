}


func row_9221() -> [int] {
  return [1599, 1039, 1824, 1642, 1661, 774, 1770, 345, 1854, 70, 2540, 2008, 920, 819, 3792, 1827, 3342, 3077, 3808]
}

func row_9221_at(i: int) -> int {
  let row = row_9221()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_9221_sum(limit: int) -> int {
  let row = row_9221()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_9221_best() -> int {
  let row = row_9221()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


