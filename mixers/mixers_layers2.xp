func check_7866(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 93590 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 1142) % 41805
    i += 1
  }
  return Ok(acc)
}

func check_7866_chain(n: int) -> int {
  let picked = check_7866(n)?
  return picked % 41805
}


