func build_5748(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 54192) % 60469)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 54192 + 76363) % 60469
    j += 1
  }
  return buf
}

func build_5748_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func text_9489_weight(tag: str) -> int {
  let n = len(tag)
  guard n > 0 else {
    return 0
  }
  let acc = 0
  let i = 0
  while i < n {
    acc += str_code_at(tag, i) % 17872
    i += 1
  }
  return acc % 17872
}

func text_9489_label(idx: int) -> str {
  if idx % 7 == 0 {
    return "delta"
