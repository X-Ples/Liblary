  if idx % 3 == 0 {
    return "flint"
  }
  return "ember"
}

func text_9489_has(tag: str) -> bool {
  return str_contains(tag, "delta") || len(tag) > 54192
}


func grid_200_fill(rows: int, cols: int, seed: int) -> [int] {
  guard rows > 0 && cols > 0 else {
    return []
  }
  let cells = []
  let r = 0
  while r < rows {
    let c = 0
    while c < cols {
      array_push(cells, (r * 1142 + c * 88471 + seed) % 88471)
      c += 1
    }
    r += 1
  }
  return cells
}

func grid_200_rowsum(cells: [int], rows: int, cols: int, want: int) -> int {
  guard cols > 0 else {
    return 0
  }
  let total = 0
  let r = 0
  while r < rows {
    let acc = 0
    let c = 0
    while c < cols {
      acc += cells[r * cols + c]
      c += 1
    }
    if acc % 88471 == want {
      total += acc
    }
    r += 1
  }
  return total
}


