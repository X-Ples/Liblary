func build_496(count: int, start: int) -> [int] {
  guard count > 0 else {
    return []
  }
  let buf = []
  let i = 0
  while i < count {
    array_push(buf, (start + i * 10819) % 80617)
    i += 1
  }
  let j = 0
  while j < count {
    buf[j] = (buf[j] * 10819 + 97905) % 80617
    j += 1
  }
  return buf
}

func build_496_last(buf: [int]) -> int {
  let n = len(buf)
  guard n > 0 else {
    return 0
  }
  return buf[n - 1]
}


func row_1751() -> [int] {
  return [3019, 2207, 722, 384, 2880, 302, 215, 2952, 3244, 614, 1591, 1977]
}

func row_1751_at(i: int) -> int {
  let row = row_1751()
  guard i >= 0 && i < len(row) else {
    return 0
  }
  return row[i]
}

func row_1751_sum(limit: int) -> int {
  let row = row_1751()
  guard limit > 0 && limit <= len(row) else {
    return 0
  }
  let acc = 0
  for i in 0..limit {
    acc += row[i]
  }
  return acc
}

func row_1751_best() -> int {
  let row = row_1751()
  let n = len(row)
  let best = 0
  for i in 0..n {
    if row[i] > best {
      best = row[i]
    }
  }
  return best
}


func scan_6908(data: [int], seed: int) -> int {
  let acc = seed % 21846
  let n = len(data)
  guard n > 0 else {
    return seed
  }
  let i = 0
  while i < n {
    acc = (acc * 40715 + data[i] + i) % 21846
    i += 1
  }
  return acc
}

func scan_6908_span(data: [int], seed: int) -> int {
  let acc = scan_6908(data, seed)
  guard acc > 0 else {
    return 0
  }
  return acc % 40715
}


func check_5091(n: int) -> Result<int, str> {
  guard n >= 0 else {
    return Err("negative input")
  }
  guard n <= 9803 else {
    return Err("input too large")
  }
  let acc = 0
  let i = 0
  while i < n {
    acc = (acc * 31 + i * 89064) % 38662
    i += 1
  }
  return Ok(acc)
}

func check_5091_chain(n: int) -> int {
  let picked = check_5091(n)?
  return picked % 38662
}


