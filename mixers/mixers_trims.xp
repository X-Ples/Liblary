func sweep_4237(lo: int, hi: int) -> int {
  guard hi > lo else {
    return 0
  }
  let acc = 10819
  for i in lo..hi {
    if i % 11101 == 0 {
      acc += i * 89064
    } else {
      acc -= i % 32557
    }
    if acc < 0 {
      acc += 92960
    }
    acc = acc % 92960
  }
  return acc
}


